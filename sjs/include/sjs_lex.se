;; SJS の字句解析（docs/consh/dev/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。conma.js の jsTokens と同じ区切り方。
;; sjs_rt.se（Sjs_chars）と、言語キットの字句解析の部品（include/lang/lex.se。Kit_lex_ で始まる名前）を使う
(include "lang/lex.se")

;; 字句は LList (種類 テキスト 改行 行 桁) で、種類は "id"（名前とキーワード）、"num"、"str"（テキストは逃がしを解いた中身）、
;; "punct"、"eof"、テンプレート文字列の部分（テキストは逃がしを解いた中身）の "template"（`...` 全体）、
;; "tmplhead"（` から ${ まで）、"tmplmid"（} から ${ まで）、"tmpltail"（} から ` まで）。テンプレートの部分の字句は、
;; 5 番目に、逃がしを解かない中身（タグ付きテンプレートの raw）を持つ。改行は、前に改行
;; （コメントの中も）があったか（真偽値）、行と桁は、字句の始まりの行と桁の番号（String。1 から）。正規表現は読まない（SJS の範囲の外）
(define Sjs_lex ,(text)
  ;; キットの字句解析のエラーは、SJS の SyntaxError にする（Kit_lex_error）
  __PDict_put__ "kit_error" (,(name msg) Sjs_throw name msg) ,()
  Sjs_chars text ,(chars)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  ;; 桁を求めるため：文字の数と、行ごとの始まりの位置（Kit_lex_col）
  __LList_length__ chars ,(n)
  __PDict_put__ "kit_lex_n" n ,()
  __Dict_new__ ,(starts)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Kit_lex_line_starts text starts one zero ,()
  __PDict_put__ "kit_lex_starts" starts ,()
  Sjs_lex_loop chars __NULL__ __FALSE__ __NULL__ one)

(define Sjs_lex_error ,(msg)
  Sjs_throw "SyntaxError" msg)

;; acc は逆順の字句。nl は、次の字句の前に改行があったか。stack は、開いている { と、テンプレートの ${（"T"）の LList
(define Sjs_lex_loop ,(chars acc nl stack line)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__
    (,()
      __is_null__ stack ,(test__) __unless__ test__ (,() Sjs_lex_error "unterminated template literal or block") ,()
      Kit_lex_tok "eof" "" __TRUE__ line "1" ,(eof)
      __LList_cons__ eof acc ,(acc)
      Kit_lex_reverse acc ,(toks)
      return toks) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Kit_lex_peek rest ,(d)
  ;; 1 つの字句を足して続ける
  ;; lines は、字句の中の改行の数（テンプレート文字列）
  __NULL__ (,(kind text rest stack lines)
    Kit_lex_col chars line ,(col)
    Kit_lex_tok kind text nl line col ,(tok)
    __LList_cons__ tok acc ,(acc)
    __Number_add__ line lines ,(next)
    Sjs_lex_loop rest acc __FALSE__ stack next ,(t)
    return t) ,(emit)
  ;; テンプレートの部分の字句を足して続ける（start は ` か } の後の文字）
  __NULL__ (,(kind text start rest stack lines)
    Sjs_lex_raw start "" ,(raw)
    __Number_toString__ line ,(ls)
    Kit_lex_col chars line ,(col)
    __LList_cons__ raw __NULL__ ,(tok)
    __LList_cons__ col tok ,(tok)
    __LList_cons__ ls tok ,(tok)
    __LList_cons__ nl tok ,(tok)
    __LList_cons__ text tok ,(tok)
    __LList_cons__ kind tok ,(tok)
    __LList_cons__ tok acc ,(acc)
    __Number_add__ line lines ,(next)
    Sjs_lex_loop rest acc __FALSE__ stack next ,(t)
    return t) ,(emitT)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  ;; 空白と改行
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() __Number_add__ line one ,(l) Sjs_lex_loop rest acc __TRUE__ stack l ,(t) return t) ,()
  Kit_lex_in c " \t\r" ,(test__) __if__ test__ (,() Sjs_lex_loop rest acc nl stack line ,(t) return t) ,()
  ;; コメント
  __String_equal__ c "/" ,(slash)
  __String_equal__ d "/" ,(slash2)
  __and__ slash slash2 ,(test__) __if__ test__
    (,() Kit_lex_skip_line rest ,(rest) Sjs_lex_loop rest acc nl stack line ,(t) return t) ,()
  __String_equal__ d "*" ,(star)
  __and__ slash star ,(test__) __if__ test__
    (,()
      Kit_lex_rest rest ,(rest)
      Kit_lex_skip_block rest nl zero ,(rest nl lines)
      __Number_add__ line lines ,(l)
      Sjs_lex_loop rest acc nl stack l ,(t)
      return t) ,()
  ;; 数
  Kit_lex_is_digit c ,(digit)
  __String_equal__ c "." ,(dot)
  Kit_lex_is_digit d ,(digitNext)
  __and__ dot digitNext ,(dotNumber)
  __or__ digit dotNumber ,(test__) __if__ test__
    (,() Kit_lex_number chars "" "_$" ,(text rest) emit "num" text rest stack zero) ,()
  ;; 文字列
  Kit_lex_in c "'\"" ,(test__) __if__ test__
    (,() Kit_lex_string rest c "" ,(text rest) emit "str" text rest stack zero) ,()
  ;; テンプレート文字列：` から、` か ${ まで
  __String_equal__ c "`" ,(test__) __if__ test__
    (,()
      __NULL__ rest ,(start)
      Sjs_lex_template rest "" zero ,(text open rest lines)
      __if_then_else__ open (,() __LList_cons__ "T" stack ,(s) __NULL__ "tmplhead" s) (,() __NULL__ "template" stack) ,(kind stack)
      emitT kind text start rest stack lines) ,()
  ;; { と }。テンプレートの ${ を閉じる } なら、テンプレートの続きを読む
  __String_equal__ c "{" ,(test__) __if__ test__
    (,() __LList_cons__ "{" stack ,(stack) emit "punct" "{" rest stack zero) ,()
  __String_equal__ c "}" ,(test__) __if__ test__
    (,()
      __is_null__ stack ,(test__) __if__ test__ (,() emit "punct" "}" rest stack zero) ,()
      __LList_uncons__ __print_exit_error__ stack ,(top below)
      __String_equal__ top "T" ,(inTemplate)
      __unless__ inTemplate (,() emit "punct" "}" rest below zero) ,()
      __NULL__ rest ,(start)
      Sjs_lex_template rest "" zero ,(text open rest lines)
      __if_then_else__ open (,() __NULL__ "tmplmid" stack) (,() __NULL__ "tmpltail" below) ,(kind stack)
      emitT kind text start rest stack lines) ,()
  ;; 名前
  Kit_lex_is_ident_start c "_$" ,(test__) __if__ test__
    (,() Kit_lex_ident chars "" "_$" ,(text rest) emit "id" text rest stack zero) ,()
  ;; 記号（長いものから）
  Sjs_puncts ,(list)
  Kit_lex_punct chars "{}()[];,<>+-*/%&|^!~?:=." list ,(text rest)
  __is_null__ text ,(test__) __if__ test__
    (,() __String_concat__ "unexpected character: " c ,(msg) Sjs_lex_error msg) ,()
  emit "punct" text rest stack zero)

;; テンプレート文字列の部分：` か } の後から、` の後か ${ の後まで。中身（逃がしを解いたもの）、${ で終わったか、残り、
;; 中の改行の数（lines に足していく）
(define Sjs_lex_template ,(chars acc lines)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() Sjs_lex_error "unterminated template literal") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "`" ,(test__) __if__ test__ (,() return acc __FALSE__ rest lines) ,()
  Kit_lex_peek rest ,(d)
  __String_equal__ c "$" ,(dollar)
  __String_equal__ d "{" ,(brace)
  __and__ dollar brace ,(test__) __if__ test__ (,() Kit_lex_rest rest ,(rest) return acc __TRUE__ rest lines) ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      __is_null__ rest ,(test__) __if__ test__ (,() Sjs_lex_error "unterminated template literal") ,()
      __LList_uncons__ __print_exit_error__ rest ,(e rest)
      Kit_lex_escape e rest ,(s rest)
      __String_concat__ acc s ,(acc)
      Sjs_lex_template rest acc lines ,(t o r n)
      return t o r n) ,()
  __String_concat__ acc c ,(acc)
  __String_equal__ c "\n" ,(newline)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __if_then_else__ newline (,() __Number_add__ lines one) (,() __NULL__ lines) ,(lines)
  Sjs_lex_template rest acc lines)

;; テンプレートの部分の逃がしを解かない中身（` か ${ の前まで。\r\n と \r は \n にする）
(define Sjs_lex_raw ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "`" ,(test__) __if__ test__ (,() return acc) ,()
  Kit_lex_peek rest ,(d)
  __String_equal__ c "$" ,(dollar)
  __String_equal__ d "{" ,(brace)
  __and__ dollar brace ,(test__) __if__ test__ (,() return acc) ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      __is_null__ rest ,(test__) __if__ test__ (,() return acc) ,()
      __LList_uncons__ __print_exit_error__ rest ,(e more)
      __String_concat__ acc c ,(acc)
      Sjs_lex_raw_cr e more acc ,(more acc)
      Sjs_lex_raw more acc ,(r)
      return r) ,()
  Sjs_lex_raw_cr c rest acc ,(rest acc)
  Sjs_lex_raw rest acc)

;; c を足す。\r なら \n にし、続く \n を飛ばす
(define Sjs_lex_raw_cr ,(c rest acc)
  __Cont_get__ ,(return)
  __String_equal__ c "\r" ,(cr)
  __unless__ cr (,() __String_concat__ acc c ,(acc) return rest acc) ,()
  __String_concat__ acc "\n" ,(acc)
  Kit_lex_peek rest ,(d)
  __String_equal__ d "\n" ,(test__) __if__ test__ (,() Kit_lex_rest rest ,(rest) return rest acc) ,()
  __NULL__ rest acc)

;; 記号の候補（長いものから。conma.js の PUNCTS と同じ）
(define Sjs_puncts ,()
  __NULL__ ">>>= ... === !== **= <<= >>= >>> &&= ||= ??= => == != <= >= += -= *= /= %= &= |= ^= && || ?? ?. ++ -- ** << >>")
