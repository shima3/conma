;; ── 段階 B5：ジェネレータ ──

;; 関数の本体のブロック。isGen ならジェネレータの本体（yield を書ける）、isAsync なら async 関数の本体（await を書ける）
(define P_body ,(p isGen isAsync)
  P_in_fn p isGen isAsync (,() P_block p))

;; p の "gen"（ジェネレータの本体の中か）と "async"（async 関数の本体の中か）を変えて thunk を読み、戻す
(define P_in_fn ,(p isGen isAsync thunk)
