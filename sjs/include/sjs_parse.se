;; SJS の構文解析（docs/consh/dev/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。conma.js の sjsParse と同じ形の再帰下降。
;; 節は Dict で、"t" に種類を持つ。式：
;;   num（"text"）、str（"value"）、lit（"text" が true、false、null）、id（"name"）、paren（"expr"）、
;;   binary（"op" "left" "right"。&&、||、?? も）、unary（"op" "arg"）、update（"op" "prefix" "target"）、
;;   assign（"op" "target" "value"）、cond（"test" "yes" "no"）、call（"callee" "args" "optional"）、
;;   member（"object" と、"name"（.名前）か "key"（[式]）、"optional"（?.））、
;;   arrow と function（"params" は名前の LList、"body" はブロックか、"expr" は式。function は "name" も）、
;;   array（"items"）、object（"props"。各要素は "key"（String）か "computed"（式）、"value"）、
;;   template（"parts" は文字列の LList、"raws" は逃がしを解かない文字列の LList、"exprs" は式の LList。parts は exprs より
;;   1 つ多い）、tagged（"tag" と "quasi"（template））
;; 文：block（"body"）、empty、decl（"kind" "decls"。decls は "name" と "init" を持つ Dict の LList）、
;;   if（"test" "yes" "no"）、while（"test" "body"）、for（"init" "test" "update" "body"）、
;;   forof（"kind"（let、const、var か null）"name" "of"（of か in）"right" "body"、for await なら "await"）、break、continue、
;;   return（"value"）、throw（"value"）、try（"body" "param" "handler" "finalizer"）、expr（"expr"）、program（"body"）。
;;   文の節は "line" と "col"（始まりの行と桁の String）も持つ。式の節も、P_assign などが返すものは持つ（Kit_parse_at）
;; まだ読まない書き方は、「not yet translated」のエラーにする。
;; sjs_lex.se と、言語キットの構文解析の部品（include/lang/parse.se。Kit_parse_ で始まる名前）を使う
(include "lang/parse.se")

(define Sjs_parse ,(text)
  Sjs_lex text ,(toks)
  Sjs_check_tokens toks __NULL__ ,()
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_statements p "" __NULL__ ,(body)
  Kit_parse_node "program" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

;; SJS式だけのテキスト（ConSh の (( )) と $(( ))）を読む
(define Sjs_parse_expression ,(text)
  Sjs_lex text ,(toks)
  Sjs_check_tokens toks __NULL__ ,()
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_expression p ,(e)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(end)
  __unless__ end (,() Kit_parse_fail p) ,()
  __NULL__ e)

;; 構文解析の前に、字句を見て SJS の範囲を確かめる（段階 A の sjsCheck と同じ順で、同じメッセージ）：名前、. の後の名前、
;; == と !=。prev は前の字句（なければ null）
(define Sjs_check_tokens ,(toks prev)
  __Cont_get__ ,(return)
  __is_null__ toks ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  __is_null__ prev ,(first)
  __if_then_else__ first (,() __NULL__ __FALSE__) (,() Kit_parse_tok_is prev "." ,(a) Kit_parse_tok_is prev "?." ,(b) __or__ a b) ,(afterDot)
  __String_equal__ kind "id" ,(test__) __if__ test__
    (,()
      __if__ afterDot (,() P_check_property text ,() Sjs_check_tokens rest tok ,() return) ,()
      ;; オブジェクトのキー（{ か , の後で、: の前）は、ConJS で足した名前を確かめない（{ async: 1 } は書ける。
      ;; M2 の PR shima3/conma#4 のレビューの 1）。SJS の範囲の名前は、今までどおり確かめる
      Sjs_tokens_key prev rest ,(isKey)
      __if_then_else__ isKey (,() P_check_name_sjs text) (,() P_check_name text) ,()
      Sjs_check_tokens rest tok ,()
      return) ,()
  __String_equal__ kind "punct" ,(punct)
  Kit_lex_in_words text "== !=" ,(loose)
  __and__ punct loose ,(test__) __if__ test__
    (,() __String_concat__ "not in SJS: " text ,(m) __String_concat__ m " (use " ,(m) __String_concat__ m text ,(m) __String_concat__ m "=)" ,(m) Sjs_not_in m) ,()
  Sjs_check_tokens rest tok)

;; 「not in SJS」のエラー（段階 A と同じく、エラーの名前を付けない）。ConJS では「not in ConJS」
(define Sjs_not_in ,(msg)
  Sjs_is_conjs ,(conjs)
  Kit_lex_starts_with msg "not in SJS" ,(sjs)
  __and__ conjs sjs ,(test__)
  __if__ test__
    (,()
      __String_length__ msg ,(len)
      __Number_fromString__ __print_exit_error__ "10" ,(ten)
      __String_substring__ __print_exit_error__ msg ten len ,(rest)
      __String_concat__ "not in ConJS" rest ,(m)
      Sjs_uncaught m) ,()
  Sjs_uncaught msg)

;; SJS の範囲の外の名前（段階 A の SJS_NAMES と、__ で始まる名前）なら、「not in SJS」のエラー
;; 名前の字句が、オブジェクトのキーの位置にあるか：前の字句が { か , で、次の字句が :
(define Sjs_tokens_key ,(prev rest)
  __Cont_get__ ,(return)
  __is_null__ prev ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __is_null__ rest ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Kit_parse_tok_is prev "{" ,(a) Kit_parse_tok_is prev "," ,(b) __or__ a b ,(open)
  __unless__ open (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ rest ,(next more)
  Kit_parse_tok_is next ":")

(define P_check_name ,(name)
  __Cont_get__ ,(return)
  ;; ConJS（言語の印 "sjs_lang" が "conjs"。conjs/conjsc.se）は、async、await、Promise も受け付けない
  ;; （docs/dev/PLATFORM-PLAN-ja.md の 4.2 節）
  Sjs_is_conjs ,(conjs)
  __if__ conjs
    (,()
      Kit_lex_in_words name "async await Promise" ,(test__)
      __if__ test__ (,() __String_concat__ "not in ConJS: " name ,(msg) Sjs_not_in msg) ,()
      ;; ConJS のクラス（4.5 節。段階 P5b）の名前と、import と export（4.12 節。段階 P9。P_import、P_export）は通す
      Kit_lex_in_words name "this new class super import export" ,(test__)
      __if__ test__ return ,()) ,()
  P_check_name_sjs name)

;; SJS の範囲の外の名前だけを確かめる（ConJS で足した名前は確かめない）
(define P_check_name_sjs ,(name)
  __Cont_get__ ,(return)
  Kit_lex_in_words name "this new class super import export with eval arguments debugger globalThis window self document Function" ,(bad)
  Kit_lex_starts_with name "__" ,(under)
  __or__ bad under ,(test__) __unless__ test__ return ,()
  __String_concat__ "not in SJS: " name ,(msg)
  Sjs_not_in msg)

;; . の後の名前（段階 A の sjsBadProperty）
(define P_check_property ,(name)
  __Cont_get__ ,(return)
  Kit_lex_in_words name "constructor prototype caller callee arguments" ,(bad)
  Kit_lex_starts_with name "__" ,(under)
  __or__ bad under ,(test__) __unless__ test__ return ,()
  __String_concat__ "not in SJS: ." name ,(msg)
  Sjs_not_in msg)

;; ── 字句を読む ──

(define P_not_yet ,(what)
  __String_concat__ "not yet translated to ConMa: " what ,(msg)
  Sjs_throw "SyntaxError" msg)

;; 名前（キーワードでない）
(define Sjs_keywords ,()
  __NULL__ " break case catch class const continue default delete do else false finally for function if in instanceof let new null of return switch this throw true try typeof var void while yield async await ")

(define Sjs_is_keyword ,(name)
  Sjs_keywords ,(kws)
  __String_concat__ " " name ,(s)
  __String_concat__ s " " ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ kws s zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define Tok_is_name ,(tok)
  __Cont_get__ ,(return)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(id)
  __unless__ id (,() return __FALSE__) ,()
  Kit_lex_tok_text tok ,(t)
  Sjs_is_keyword t ,(kw)
  __not__ kw)

(define P_name ,(p)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Tok_is_name tok ,(ok)
  __unless__ ok
    (,() Kit_parse_describe tok ,(d) __String_concat__ "expected a name but found " d ,(msg) Sjs_throw "SyntaxError" msg) ,()
  Kit_parse_next p ,(tok)
  Kit_lex_tok_text tok)

;; 文の終わり：; か、} か入力の終わりの前か、改行の前
(define P_semi ,(p)
  __Cont_get__ ,(return)
  Kit_parse_eat p ";" ,(test__) __if__ test__ return ,()
  Kit_parse_is p "}" ,(test__) __if__ test__ return ,()
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ return ,()
  Kit_lex_tok_nl tok ,(test__) __if__ test__ return ,()
  Kit_parse_fail p)

;; ── 文 ──

;; end（"}" か、入力の終わりなら ""）までの文の LList
(define P_statements ,(p end acc)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(atEof)
  __String_equal__ end "" ,(toEof)
  __and__ atEof toEof ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(body) return body) ,()
  __if__ atEof (,() Kit_parse_expect p end) ,()
  Kit_parse_is p end ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(body) return body) ,()
  P_statement p ,(s)
  __LList_cons__ s acc ,(acc)
  P_statements p end acc)

(define P_block ,(p)
  Kit_parse_expect p "{" ,()
  P_statements p "}" __NULL__ ,(body)
  Kit_parse_expect p "}" ,()
  Kit_parse_node "block" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

;; 文。節の "line" と "col" に、文の始まりの位置を入れる（変換器が SInfo にする）
(define P_statement ,(p)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_line tok ,(line)
  Kit_lex_tok_col tok ,(col)
  P_statement_body p ,(n)
  __Dict_put__ n "line" line ,()
  __Dict_put__ n "col" col ,()
  __NULL__ n)

(define P_statement_body ,(p)
  __Cont_get__ ,(return)
  Kit_parse_is p "{" ,(test__) __if__ test__ (,() P_block p ,(n) return n) ,()
  ;; ラベル：名前 : 文
  Kit_parse_peek p ,(lt)
  Tok_is_name lt ,(lname)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Kit_parse_peek_at p one ,(colon)
  Kit_parse_tok_is colon ":" ,(isColon)
  __and__ lname isColon ,(test__) __if__ test__
    (,()
      Kit_parse_next p ,(t)
      Kit_lex_tok_text t ,(label)
      Kit_parse_next p ,(c)
      P_statement p ,(body)
      Kit_parse_node "labeled" ,(n)
      __Dict_put__ n "label" label ,()
      __Dict_put__ n "body" body ,()
      return n) ,()
  Kit_parse_eat p ";" ,(test__) __if__ test__ (,() Kit_parse_node "empty" ,(n) return n) ,()
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(isId)
  __if__ isId
    (,()
      Kit_lex_tok_text tok ,(word)
      __String_equal__ word "let" ,(isLet)
      __String_equal__ word "const" ,(isConst)
      __String_equal__ word "var" ,(isVar)
      __or__ isLet isConst ,(decl)
      __or__ decl isVar ,(test__) __if__ test__ (,() P_decl p ,(n) P_semi p ,() return n) ,()
      __String_equal__ word "if" ,(test__) __if__ test__ (,() P_if p ,(n) return n) ,()
      __String_equal__ word "while" ,(test__) __if__ test__ (,() P_while p ,(n) return n) ,()
      __String_equal__ word "return" ,(test__) __if__ test__ (,() P_return p ,(n) return n) ,()
      __String_equal__ word "for" ,(test__) __if__ test__ (,() P_for p ,(n) return n) ,()
      __String_equal__ word "throw" ,(test__) __if__ test__
        (,()
          Kit_parse_next p ,(t)
          Kit_parse_peek p ,(next)
          Kit_lex_tok_nl next ,(nl)
          __if__ nl (,() Sjs_throw "SyntaxError" "a new line after throw") ,()
          P_expression p ,(value)
          P_semi p ,()
          Kit_parse_node "throw" ,(n)
          __Dict_put__ n "value" value ,()
          return n) ,()
      __String_equal__ word "try" ,(test__) __if__ test__ (,() P_try p ,(n) return n) ,()
      ;; 関数の宣言（ブロックの始めで値を入れる）。async function も
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      Kit_parse_peek_at p one ,(after)
      Kit_parse_tok_is after "function" ,(afterFn)
      Kit_lex_tok_nl after ,(afterNl)
      __not__ afterNl ,(sameLine)
      __String_equal__ word "async" ,(isAsyncWord)
      __and__ isAsyncWord afterFn ,(x) __and__ x sameLine ,(asyncDecl)
      __String_equal__ word "function" ,(fnDecl)
      __or__ fnDecl asyncDecl ,(test__) __if__ test__
        (,()
          __if__ asyncDecl (,() Kit_parse_next p ,(t) __nop__) ,()
          P_function_as p asyncDecl ,(fn)
          Kit_parse_get fn "name" ,(name)
          __String_equal__ name "" ,(test__) __if__ test__ (,() Kit_parse_fail p) ,()
          Kit_parse_node "funcdecl" ,(n)
          __Dict_put__ n "name" name ,()
          __Dict_put__ n "fn" fn ,()
          return n) ,()
      __String_equal__ word "do" ,(test__) __if__ test__
        (,()
          Kit_parse_next p ,(t)
          P_statement p ,(body)
          Kit_parse_expect p "while" ,()
          Kit_parse_expect p "(" ,()
          P_expression p ,(test)
          Kit_parse_expect p ")" ,()
          Kit_parse_eat p ";" ,(semi)
          Kit_parse_node "dowhile" ,(n)
          __Dict_put__ n "body" body ,()
          __Dict_put__ n "test" test ,()
          return n) ,()
      __String_equal__ word "switch" ,(test__) __if__ test__ (,() P_switch p ,(n) return n) ,()
      ;; class 宣言（ConJS だけ。SJS は、字句の名前の検査で先に止まる）
      __String_equal__ word "class" ,(test__) __if__ test__ (,() P_class_decl p ,(n) return n) ,()
      ;; import と export（ConJS だけ。4.12 節。段階 P9。SJS は、字句の名前の検査で先に止まる）
      __String_equal__ word "import" ,(test__) __if__ test__ (,() P_import p ,(n) return n) ,()
      __String_equal__ word "export" ,(test__) __if__ test__ (,() P_export p ,(n) return n) ,()
      __String_equal__ word "break" ,(isBreak)
      __String_equal__ word "continue" ,(isContinue)
      __or__ isBreak isContinue ,(test__) __if__ test__
        (,()
          Kit_parse_next p ,(t)
          Kit_parse_peek p ,(next)
          Tok_is_name next ,(named)
          Kit_lex_tok_nl next ,(nl)
          __not__ nl ,(same)
          __and__ named same ,(labeled)
          __if_then_else__ labeled (,() Kit_parse_next p ,(lt) Kit_lex_tok_text lt) (,() __NULL__ "") ,(label)
          P_semi p ,()
          Kit_parse_node word ,(n)
          __Dict_put__ n "label" label ,()
          return n) ,()
      P_unsupported_statement word ,()) ,()
  P_expression p ,(e)
  P_semi p ,()
  Kit_parse_node "expr" ,(n)
  __Dict_put__ n "expr" e ,()
  __NULL__ n)

(define P_unsupported_statement ,(word)
  __Cont_get__ ,(return)
  Kit_lex_in_words word "function" ,(test__)
  __unless__ test__ return ,()
  __String_concat__ word " statements" ,(what)
  P_not_yet what)

(define P_decl ,(p)
  Kit_parse_next p ,(tok)
  Kit_lex_tok_text tok ,(kind)
  P_declarators p __NULL__ ,(decls)
  Kit_parse_node "decl" ,(n)
  __Dict_put__ n "kind" kind ,()
  __Dict_put__ n "decls" decls ,()
  __NULL__ n)

(define P_declarators ,(p acc)
  __Cont_get__ ,(return)
  P_binding_target p ,(target)
  Kit_parse_eat p "=" ,(hasInit)
  __if_then_else__ hasInit (,() P_assign p) (,() __NULL__ __NULL__) ,(init)
  Kit_parse_node "declarator" ,(d)
  __Dict_put__ d "target" target ,()
  __Dict_put__ d "init" init ,()
  __LList_cons__ d acc ,(acc)
  Kit_parse_eat p "," ,(more)
  __if__ more (,() P_declarators p acc ,(decls) return decls) ,()
  Kit_lex_reverse acc)

;; 束縛の形：名前、[ ... ]（配列の形）、{ ... }（オブジェクトの形）。節は id、arrayPattern（"items"。要素は形か、
;; default（"target" "value"）か、rest（"target"）か、穴の null）、objectPattern（"props"。要素は "key"（String）か
;; "computed"（式）と "value"（形か default）、または rest）
(define P_binding_target ,(p)
  __Cont_get__ ,(return)
  Kit_parse_eat p "[" ,(test__) __if__ test__ (,() P_array_pattern p __NULL__ ,(n) return n) ,()
  Kit_parse_eat p "{" ,(test__) __if__ test__ (,() P_object_pattern p __NULL__ ,(n) return n) ,()
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_text tok ,(text)
  P_check_name text ,()
  P_name p ,(name)
  Str_has_dollar name ,(test__) __if__ test__
    (,() __String_concat__ "not in SJS: a declaration of " name ,(m) __String_concat__ m " (a name that begins with $ is a shell variable)" ,(m) Sjs_not_in m) ,()
  Kit_parse_node "id" ,(n)
  __Dict_put__ n "name" name ,()
  __NULL__ n)

;; 形と、= の後の既定値
(define P_binding_element ,(p)
  __Cont_get__ ,(return)
  P_binding_target p ,(target)
  Kit_parse_eat p "=" ,(hasDefault)
  __unless__ hasDefault (,() return target) ,()
  P_assign p ,(value)
  Kit_parse_node "default" ,(n)
  __Dict_put__ n "target" target ,()
  __Dict_put__ n "value" value ,()
  __NULL__ n)

(define P_array_pattern ,(p acc)
  __Cont_get__ ,(return)
  __NULL__ (,(acc) Kit_lex_reverse acc ,(items) Kit_parse_node "arrayPattern" ,(n) __Dict_put__ n "items" items ,() return n) ,(finish)
  Kit_parse_eat p "]" ,(test__) __if__ test__ (,() finish acc) ,()
  Kit_parse_eat p "," ,(test__) __if__ test__ (,() __LList_cons__ __NULL__ acc ,(acc) P_array_pattern p acc ,(n) return n) ,()
  Kit_parse_eat p "..." ,(test__) __if__ test__
    (,()
      P_binding_target p ,(t)
      Kit_parse_node "rest" ,(r)
      __Dict_put__ r "target" t ,()
      __LList_cons__ r acc ,(acc)
      Kit_parse_expect p "]" ,()
      finish acc) ,()
  P_binding_element p ,(e)
  __LList_cons__ e acc ,(acc)
  Kit_parse_eat p "," ,(comma)
  __unless__ comma (,() Kit_parse_expect p "]" ,() finish acc) ,()
  P_array_pattern p acc)

(define P_object_pattern ,(p acc)
  __Cont_get__ ,(return)
  __NULL__ (,(acc) Kit_lex_reverse acc ,(props) Kit_parse_node "objectPattern" ,(n) __Dict_put__ n "props" props ,() return n) ,(finish)
  Kit_parse_eat p "}" ,(test__) __if__ test__ (,() finish acc) ,()
  Kit_parse_eat p "..." ,(test__) __if__ test__
    (,()
      P_binding_target p ,(t)
      Kit_parse_node "rest" ,(r)
      __Dict_put__ r "target" t ,()
      __LList_cons__ r acc ,(acc)
      Kit_parse_expect p "}" ,()
      finish acc) ,()
  Kit_parse_node "prop" ,(prop)
  Kit_parse_eat p "[" ,(computed)
  __if__ computed (,() P_assign p ,(k) Kit_parse_expect p "]" ,() __Dict_put__ prop "computed" k ,() __Dict_put__ prop "key" "") ,()
  __unless__ computed
    (,()
      Kit_parse_next p ,(tok)
      Kit_lex_tok_kind tok ,(kind)
      Kit_lex_tok_text tok ,(text)
      Kit_lex_in_words kind "id str num" ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected a property name in a pattern") ,()
      __Dict_put__ prop "key" text ,()
      __Dict_put__ prop "computed" __NULL__ ,()
      __String_equal__ kind "id" ,(isId)
      __Dict_put__ prop "shorthandOk" isId) ,()
  Kit_parse_eat p ":" ,(hasValue)
  __if_then_else__ hasValue
    (,() P_binding_element p)
    (,()
      __Dict_lookup_or__ prop "shorthandOk" (,(k) __NULL__ __FALSE__) ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected ':' in a pattern") ,()
      Kit_parse_get prop "key" ,(name)
      P_check_name name ,()
      Kit_parse_node "id" ,(id)
      __Dict_put__ id "name" name ,()
      Kit_parse_eat p "=" ,(hasDefault)
      __if_then_else__ hasDefault
        (,()
          P_assign p ,(dv)
          Kit_parse_node "default" ,(d)
          __Dict_put__ d "target" id ,()
          __Dict_put__ d "value" dv ,()
          __NULL__ d)
        (,() __NULL__ id)) ,(value)
  __Dict_put__ prop "value" value ,()
  __LList_cons__ prop acc ,(acc)
  Kit_parse_eat p "," ,(comma)
  __unless__ comma (,() Kit_parse_expect p "}" ,() finish acc) ,()
  P_object_pattern p acc)

;; switch (式) { case 式: 文 ... default: 文 ... }。"cases" は、"test"（default なら null）と "body"（文の LList）の Dict の LList
(define P_switch ,(p)
  Kit_parse_next p ,(t)
  Kit_parse_expect p "(" ,()
