  __NULL__ n)

;; async function、async (引数) => 本体、async 名前 => 本体（async の後に改行はない）
(define P_async ,(p)
  __Cont_get__ ,(return)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Kit_parse_peek_at p one ,(after)
  Kit_lex_tok_nl after ,(nl)
  __if__ nl (,() Sjs_not_in "not in SJS: async") ,()
  Kit_parse_tok_is after "function" ,(test__) __if__ test__ (,() Kit_parse_next p ,(t) P_function_as p __TRUE__ ,(n) return n) ,()
  Tok_is_name after ,(named)
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  Kit_parse_peek_at p two ,(after2)
  Kit_parse_tok_is after2 "=>" ,(arrow)
  __and__ named arrow ,(test__) __if__ test__
    (,()
      Kit_parse_next p ,(t)
      Kit_parse_next p ,(tok)
      Kit_lex_tok_text tok ,(name)
      Kit_parse_next p ,(t)
      Kit_parse_node "id" ,(param)
      __Dict_put__ param "name" name ,()
      __LList_cons__ param __NULL__ ,(params)
      P_arrow_body_as p params __TRUE__ ,(n)
      return n) ,()
  Kit_parse_tok_is after "(" ,(test__) __if__ test__
    (,()
      Kit_parse_next p ,(t)
      P_paren_arrow p ,(isArrow)
      __if__ isArrow
        (,()
          Kit_parse_next p ,(tok)
          P_params p __NULL__ ,(params)
          Kit_parse_expect p "=>" ,()
          P_arrow_body_as p params __TRUE__ ,(n)
          return n) ,()) ,()
  Sjs_not_in "not in SJS: async")

;; yield [式] と yield* 式。式がないのは、次の字句が閉じる括弧、コンマ、;、:、終わりか、改行の後のとき
(define P_yield ,(p)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "gen" (,(k) __NULL__ __FALSE__) ,(inGen)
  __unless__ inGen (,() Sjs_not_in "not in SJS: yield outside a generator function") ,()
  Kit_parse_next p ,(tok)
  Kit_parse_node "yield" ,(n)
  Kit_parse_eat p "*" ,(delegate)
  __Dict_put__ n "delegate" delegate ,()
  __if__ delegate (,() P_assign p ,(arg) __Dict_put__ n "arg" arg ,() return n) ,()
  Kit_parse_peek p ,(next)
  Kit_lex_tok_nl next ,(nl)
  Kit_lex_tok_kind next ,(kind)
  __String_equal__ kind "eof" ,(eof)
  Kit_lex_tok_text next ,(text)
  __String_equal__ kind "punct" ,(punct)
  Kit_lex_in_words text ") ] } , ; :" ,(closing)
  __and__ punct closing ,(closing)
  __or__ nl eof ,(none)
  __or__ none closing ,(none)
  __if_then_else__ none (,() __NULL__ __NULL__) (,() P_assign p) ,(arg)
  __Dict_put__ n "arg" arg ,()
  __NULL__ n)

;; ── ConJS のクラス（docs/dev/PLATFORM-PLAN-ja.md の 4.5 節。段階 P5b）──
;; SJS では、字句の名前の検査（Sjs_check_tokens）が class、new、this、super を先に止めるので、ここには来ない

;; class 宣言：let 名前 = class 名前 { ... } と同じ宣言の節にする（JavaScript の class 宣言も、let と同じく
;; 宣言より前には使えない）
(define P_class_decl ,(p)
  P_class p ,(c)
  Kit_parse_get c "name" ,(name)
  __String_equal__ name "" ,(test__) __if__ test__ (,() Sjs_throw "SyntaxError" "A class declaration requires a name") ,()
  Kit_parse_node "id" ,(id)
  __Dict_put__ id "name" name ,()
  Kit_parse_node "declarator" ,(d)
  __Dict_put__ d "target" id ,()
  __Dict_put__ d "init" c ,()
  __LList_cons__ d __NULL__ ,(decls)
  Kit_parse_node "decl" ,(n)
  __Dict_put__ n "kind" "let" ,()
  __Dict_put__ n "decls" decls ,()
  __NULL__ n)

;; ── import と export（ConJS だけ。docs/dev/PLATFORM-PLAN-ja.md の 4.12 節。段階 P9）──
;; import { 名前 [as 名前], ... } from "指定"。節は import（"specs" は "imported" と "local" を持つ Dict の LList、"from" は指定）。
;; ほかの形（import x from、import * as m、import "x"、import()、import.meta）は「not in ConJS」
(define P_import ,(p)
  __Cont_get__ ,(return)
  Kit_parse_next p ,(t)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  Kit_lex_in_words text "( ." ,(test__) __if__ test__ (,() P_import_not "import() and import.meta") ,()
  __String_equal__ kind "str" ,(test__) __if__ test__ (,() P_import_not "import without names (import \"...\")") ,()
  __String_equal__ text "*" ,(test__) __if__ test__ (,() P_import_not "import * as") ,()
  Tok_is_name tok ,(test__) __if__ test__ (,() P_import_not "a default import (import x from)") ,()
  Kit_parse_expect p "{" ,()
  P_import_specs p __NULL__ ,(specs)
  P_from p ,(from)
  P_semi p ,()
  Kit_parse_node "import" ,(n)
  __Dict_put__ n "specs" specs ,()
  __Dict_put__ n "from" from ,()
  return n)

(define P_import_not ,(what)
  __String_concat__ "not in SJS: " what ,(m)
  Sjs_not_in m)

;; { の後の、名前 [as 名前] の並びと }
(define P_import_specs ,(p acc)
  __Cont_get__ ,(return)
  Kit_parse_eat p "}" ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(l) return l) ,()
  P_name p ,(imported)
  P_as p imported ,(local)
  Kit_parse_node "spec" ,(s)
  __Dict_put__ s "imported" imported ,()
  __Dict_put__ s "local" local ,()
  __LList_cons__ s acc ,(acc)
  Kit_parse_eat p "," ,(more)
  __unless__ more (,() Kit_parse_expect p "}" ,() Kit_lex_reverse acc ,(l) return l) ,()
  P_import_specs p acc)

;; [as 名前]。なければ name
(define P_as ,(p name)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  __String_equal__ kind "id" ,(isId)
  __String_equal__ text "as" ,(isAs)
  __and__ isId isAs ,(test__) __unless__ test__ (,() return name) ,()
  Kit_parse_next p ,(t)
  P_name p)

;; from "指定"。指定の文字列を返す
(define P_from ,(p)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  __String_equal__ kind "id" ,(isId)
  __String_equal__ text "from" ,(isFrom)
  __and__ isId isFrom ,(test__) __unless__ test__ (,() Kit_parse_fail p) ,()
  Kit_parse_next p ,(t)
  Kit_parse_peek p ,(s)
  Kit_lex_tok_kind s ,(skind)
  __String_equal__ skind "str" ,(test__) __unless__ test__ (,() Kit_parse_fail p) ,()
  Kit_parse_next p ,(t)
  Kit_lex_tok_text s)

;; export const/let/var 宣言、export function、export class（節は export。"decl" に宣言の節）、
;; export { 名前 [as 名前], ... }（節は exportlist。"specs" は "local" と "exported" を持つ Dict の LList）。
;; ほかの形（export default、export *、export { } from）は「not in ConJS」
(define P_export ,(p)
  __Cont_get__ ,(return)
  Kit_parse_next p ,(t)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_text tok ,(text)
  Kit_lex_tok_line tok ,(line)
  Kit_lex_tok_col tok ,(col)
  __String_equal__ text "default" ,(test__) __if__ test__ (,() P_import_not "export default") ,()
  __String_equal__ text "*" ,(test__) __if__ test__ (,() P_import_not "export *") ,()
  __String_equal__ text "{" ,(test__) __if__ test__
    (,()
      Kit_parse_next p ,(t)
      P_export_specs p __NULL__ ,(specs)
      Kit_parse_peek p ,(next)
      Kit_lex_tok_text next ,(ntext)
      __String_equal__ ntext "from" ,(test__) __if__ test__ (,() P_import_not "export ... from") ,()
      P_semi p ,()
      Kit_parse_node "exportlist" ,(n)
      __Dict_put__ n "specs" specs ,()
      return n) ,()
  Kit_lex_in_words text "let const var" ,(isDecl)
  __String_equal__ text "function" ,(isFn)
  __String_equal__ text "class" ,(isClass)
  __if_then_else__ isDecl (,() P_decl p ,(d) P_semi p ,() __NULL__ d)
    (,()
      __if_then_else__ isClass (,() P_class_decl p)
        (,()
          __unless__ isFn (,() Kit_parse_fail p) ,()
          P_function_as p __FALSE__ ,(fn)
          Kit_parse_get fn "name" ,(name)
          __String_equal__ name "" ,(test__) __if__ test__ (,() Kit_parse_fail p) ,()
          Kit_parse_node "funcdecl" ,(d)
          __Dict_put__ d "name" name ,()
          __Dict_put__ d "fn" fn ,()
          __NULL__ d)) ,(decl)
  __Dict_put__ decl "line" line ,()
  __Dict_put__ decl "col" col ,()
  Kit_parse_node "export" ,(n)
  __Dict_put__ n "decl" decl ,()
  return n)

;; { の後の、名前 [as 名前] の並びと }
(define P_export_specs ,(p acc)
  __Cont_get__ ,(return)
  Kit_parse_eat p "}" ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(l) return l) ,()
  P_name p ,(local)
  P_as p local ,(exported)
  Kit_parse_node "spec" ,(s)
  __Dict_put__ s "local" local ,()
  __Dict_put__ s "exported" exported ,()
  __LList_cons__ s acc ,(acc)
  Kit_parse_eat p "," ,(more)
  __unless__ more (,() Kit_parse_expect p "}" ,() Kit_lex_reverse acc ,(l) return l) ,()
  P_export_specs p acc)

;; class [名前] [extends 式] { メンバー }。節は class（"name"（なければ ""）、"parent"（なければ null）、"members"）。
;; メンバーは member（"kind" は "method"、"static"、"ctor"、"field"。"key" は名前。メソッドは "fn"（function の節で、
;; "method" の印を持つ）、フィールドは "value"（初期化の式か null））
(define P_class ,(p)
  Kit_parse_next p ,(t)
  Kit_parse_peek p ,(tok)
  Tok_is_name tok ,(isName)
  Kit_parse_tok_is tok "extends" ,(isExtends)
  __not__ isExtends ,(notExtends)
  __and__ isName notExtends ,(named)
  __if_then_else__ named (,() Kit_lex_tok_text tok ,(text) P_check_name text ,() Kit_parse_next p ,(t) __NULL__ text) (,() __NULL__ "") ,(name)
  Kit_parse_eat p "extends" ,(hasParent)
  __if_then_else__ hasParent (,() P_postfix p) (,() __NULL__ __NULL__) ,(parent)
  Kit_parse_expect p "{" ,()
  P_class_members p __NULL__ ,(members)
  Kit_parse_node "class" ,(n)
  __Dict_put__ n "name" name ,()
  __Dict_put__ n "parent" parent ,()
  __Dict_put__ n "members" members ,()
  __NULL__ n)

(define P_class_members ,(p acc)
  __Cont_get__ ,(return)
  Kit_parse_eat p "}" ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(l) return l) ,()
  Kit_parse_eat p ";" ,(test__) __if__ test__ (,() P_class_members p acc ,(l) return l) ,()
  P_class_member p ,(m)
  __LList_cons__ m acc ,(acc)
  P_class_members p acc)

;; 字句 tok が、メンバーの名前の後に来るもの（( = ; }）か
(define P_class_after_name ,(tok)
  Kit_parse_tok_is tok "(" ,(a1)
  Kit_parse_tok_is tok "=" ,(a2)
  Kit_parse_tok_is tok ";" ,(a3)
  Kit_parse_tok_is tok "}" ,(a4)
  __or__ a1 a2 ,(x)
  __or__ x a3 ,(x)
  __or__ x a4)

(define P_class_member ,(p)
  __Cont_get__ ,(return)
  Kit_parse_node "member" ,(m)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  ;; static（static という名前のメンバーでなければ）
  Kit_parse_peek p ,(tok)
  Kit_parse_peek_at p one ,(after)
  Kit_parse_tok_is tok "static" ,(s1)
  P_class_after_name after ,(plain)
  __not__ plain ,(notPlain)
  __and__ s1 notPlain ,(isStatic)
  __if__ isStatic (,() Kit_parse_next p ,(t) __nop__) ,()
  Kit_parse_is p "{" ,(test__) __if__ test__ (,() Sjs_not_in "not in SJS: a static block") ,()
  Kit_parse_eat p "*" ,(isGen)
  Kit_parse_peek p ,(tok)
  Kit_parse_peek_at p one ,(after)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  ;; get と set（getter と setter）、計算した名前は、足さないもの
  P_class_after_name after ,(plainAfter)
  __String_equal__ kind "id" ,(isId)
  Kit_lex_in_words text "get set" ,(accessor)
  __and__ isId accessor ,(y)
  __not__ plainAfter ,(z)
  __and__ y z ,(test__) __if__ test__ (,() Sjs_not_in "not in SJS: a getter or a setter") ,()
  Kit_parse_is p "[" ,(test__) __if__ test__ (,() Sjs_not_in "not in SJS: a computed method name") ,()
  __String_equal__ kind "str" ,(isStr)
  __String_equal__ kind "num" ,(isNum)
  __or__ isId isStr ,(ok)
  __or__ ok isNum ,(ok)
  __unless__ ok (,() Kit_parse_fail p) ,()
  Kit_parse_next p ,(t)
  __Dict_put__ m "key" text ,()
  Kit_parse_eat p "(" ,(test__) __if__ test__
    (,()
      __String_equal__ text "constructor" ,(ctorName)
      __not__ isStatic ,(inst)
      __and__ ctorName inst ,(isCtor)
      __unless__ isCtor (,() P_check_property text) ,()
      __and__ isCtor isGen ,(test__) __if__ test__ (,() Sjs_throw "SyntaxError" "Class constructor may not be a generator") ,()
      P_params p __NULL__ ,(params)
      P_body p isGen __FALSE__ ,(body)
      Kit_parse_node "function" ,(f)
      __Dict_put__ f "gen" isGen ,()
      __Dict_put__ f "async" __FALSE__ ,()
      __Dict_put__ f "params" params ,()
      __Dict_put__ f "body" body ,()
      __Dict_put__ f "expr" __NULL__ ,()
      __Dict_put__ f "name" text ,()
      __Dict_put__ f "method" __TRUE__ ,()
      __if_then_else__ isCtor (,() __NULL__ "ctor") (,() __if_then_else__ isStatic (,() __NULL__ "static") (,() __NULL__ "method")) ,(k)
      __Dict_put__ m "kind" k ,()
      __Dict_put__ m "fn" f ,()
      return m) ,()
  __if__ isGen (,() Kit_parse_fail p) ,()
  __if__ isStatic (,() Sjs_not_in "not in SJS: a static field") ,()
  P_check_property text ,()
  Kit_parse_eat p "=" ,(hasValue)
  __if_then_else__ hasValue (,() P_in_fn p __FALSE__ __FALSE__ (,() P_assign p)) (,() __NULL__ __NULL__) ,(value)
  P_semi p ,()
  __Dict_put__ m "kind" "field" ,()
  __Dict_put__ m "value" value ,()
  __NULL__ m)

;; new 式(引数)。節は new（"callee" "args"）。式は、名前か括弧の式に、. と [ ] のメンバーだけが続くもの。
;; 引数がなければ（new C）、空
(define P_new ,(p)
  Kit_parse_next p ,(t)
  Kit_parse_is p "new" ,(nested)
  __if_then_else__ nested (,() P_new p) (,() P_primary p) ,(callee)
  P_new_members p callee ,(callee)
  Kit_parse_eat p "(" ,(hasArgs)
  __if_then_else__ hasArgs (,() P_allow_in p (,() P_args p __NULL__)) (,() __NULL__ __NULL__) ,(args)
  Kit_parse_node "new" ,(n)
  __Dict_put__ n "callee" callee ,()
  __Dict_put__ n "args" args ,()
  __NULL__ n)

(define P_new_members ,(p e)
  __Cont_get__ ,(return)
  Kit_parse_eat p "." ,(test__) __if__ test__
    (,()
      Kit_parse_next p ,(tok)
      Kit_lex_tok_kind tok ,(kind)
      __String_equal__ kind "id" ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected a property name after '.'") ,()
      Kit_lex_tok_text tok ,(name)
      P_check_property name ,()
      Kit_parse_node "member" ,(n)
      Kit_parse_at n tok ,()
      __Dict_put__ n "object" e ,()
      __Dict_put__ n "name" name ,()
      P_new_members p n ,(r)
      return r) ,()
  Kit_parse_eat p "[" ,(test__) __if__ test__
    (,()
      Kit_parse_peek p ,(ktok)
      P_allow_in p (,() P_expression p) ,(key)
      Kit_parse_expect p "]" ,()
      Kit_parse_node "member" ,(n)
      Kit_parse_at n ktok ,()
      __Dict_put__ n "object" e ,()
      __Dict_put__ n "key" key ,()
      P_new_members p n ,(r)
      return r) ,()
  __NULL__ e)
