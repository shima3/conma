  __String_equal__ how "w" ,(already)
  __if_then_else__ write (,() __NULL__ "w") (,() __if_then_else__ already (,() __NULL__ "w") (,() __NULL__ "r")) ,(how2)
  __Dict_put__ used name how2 ,()
  __String_concat__ "g_" name ,(c)
  __NULL__ __TRUE__ c)

;; 文の関数の JavaScript：function s_N(g_a, ...) { 文; return [g_書いた変数, ...]; }
(define Hx_stmt_func ,(E H info)
  __Cont_get__ ,(fail)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fail" fail ,()
  __Dict_put__ cx "E" E ,()
  __Dict_put__ cx "H" H ,()
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(loops)
