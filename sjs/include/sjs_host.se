    (,() Kit_code_cat5 "(" lc " " op " " ,(c) Kit_code_cat3 c rc ")" ,(c) return c) ,()
  Kit_lex_in_words op "+ - * / % < > <= >=" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
  Kit_code_cat5 "($n(" lc ") " op " $n(" ,(c)
  Kit_code_cat3 c rc "))" ,(c)
  __NULL__ c)

;; 呼び出し：ほかのホストの関数（名前で）か、文字列のメソッド
(define Hx_call ,(cx e)
