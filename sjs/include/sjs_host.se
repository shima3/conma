      Hx_template cx parts exprs "(" ,(c)
      __String_concat__ c ")" ,(c)
      return c) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Hx_binary cx e ,(c) return c) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "op" ,(op)
