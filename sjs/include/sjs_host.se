      Hx_expr cx arg ,(ac)
      __String_equal__ op "!" ,(test__) __if__ test__ (,() Kit_code_cat3 "(!" ac ")" ,(c) return c) ,()
      __String_equal__ op "-" ,(test__) __if__ test__ (,() Kit_code_cat3 "(-$n(" ac "))" ,(c) return c) ,()
      __String_equal__ op "+" ,(test__) __if__ test__ (,() Kit_code_cat3 "$n(" ac ")" ,(c) return c) ,()
      Hx_fail cx) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "test" ,(test)
