  __String_equal__ s "Infinity" ,(test__) __if__ test__ (,() return "Infinity") ,()
  Kit_code_cat3 "(" s ")")

;; テンプレート：parts と exprs を順に。式の値は $S で文字列にする
(define Hx_template ,(cx parts exprs acc)
  __Cont_get__ ,(return)
