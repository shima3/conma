  __if_then_else__ waits (,() __NULL__ "function* ") (,() __NULL__ "function ") ,(head)
  Kit_code_cat5 head fname "(" ps ") {" ,(js)
  ;; 一番外の変数を VM と合わせる $gio（使う変数があるとき）
  __String_equal__ ps "" ,(noVars)
  __if_then_else__ noVars (,() __NULL__ "")
    (,() Kit_code_cat4 "$gio = { get: () => [" ws "], set: ($v) => { [" ps ,(g) __String_concat__ g "] = $v; } }; ") ,(gio)
  __String_concat__ js gio ,(js)
  Kit_code_cat4 js code "return [" ws ,(js)
  __String_concat__ js "];}\n" ,(js)
  __Ref_get__ callees ,(cs)
  __NULL__ __TRUE__ js cs)

;; reads のうち、書いた名前（reads の順を逆にした LList）
(define Hx_stmt_writes ,(used names acc)
  __Cont_get__ ,(return)
