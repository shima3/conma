;; この関数が待つ印を付ける。関数式の中や、待てない関数（フィールドなど）では、ホストの関数にしない
(define Hx_wait ,(cx)
  __Dict_lookup_or__ cx "closure" (,(k) __NULL__ __FALSE__) ,(inClosure)
  __if__ inClosure (,() Hx_fail cx) ,()
  __Dict_lookup_or__ cx "waits" (,(k) Hx_fail cx) ,(waitsRef)
  __Ref_set__ waitsRef __TRUE__)

;; ジェネレータの本体（関数式の中でない）を書いているか
(define Hx_genmode ,(cx)
  __Dict_lookup_or__ cx "gen" (,(k) __NULL__ __FALSE__) ,(gen)
  __Dict_lookup_or__ cx "closure" (,(k) __NULL__ __FALSE__) ,(inClosure)
  __not__ inClosure ,(out)
  __and__ gen out)

;; e が、一番外で宣言されず代入されない組み込みの名前 name か
(define Hx_builtin ,(cx e name)
  __Cont_get__ ,(return)
  Wx_is_id e name ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ E "declared" __print_exit_error__ ,(declared)
  __Dict_lookup_or__ declared name (,(k) __NULL__ __NULL__) ,(d)
  __is_null__ d)

;; ホストで呼べるメソッド（文字列と配列。$m_名前 が、受け手の種類で分ける）
(define Hx_methods ,()
  __NULL__ "charAt at indexOf includes startsWith endsWith slice trim toUpperCase toLowerCase repeat replace replaceAll split push pop join map filter forEach some every find findIndex reduce concat reverse sort")

;; Math の関数の引数：どれも数（$n）
(define Hx_num_args ,(cx args acc)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_t a ,(t)
  __String_equal__ t "spread" ,(test__) __if__ test__ (,() Hx_fail cx) ,()
  Hx_expr cx a ,(c)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ "") (,() __NULL__ ", ") ,(sep)
  Kit_code_cat4 acc sep "$n(" c ,(acc)
  __String_concat__ acc ")" ,(acc)
  Hx_num_args cx rest acc)

(define Hx_args ,(cx args acc)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_t a ,(t)
  ;; ...（スプレッド）は扱わない
  __String_equal__ t "spread" ,(test__) __if__ test__ (,() Hx_fail cx) ,()
  Hx_expr cx a ,(c)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ "") (,() __NULL__ ", ") ,(sep)
  Kit_code_cat3 acc sep c ,(acc)
  Hx_args cx rest acc)

;; 補助の関数。ConJS と同じになると確かめられない所では、呼び返しの前なら rt.Escape を投げ（呼んだ Conjs_hostfn が ConMa 版を始めから
;; 動かす）、呼び返しの後なら、その 1 つの演算を VM に頼む（$slow、$vm。段階 H4c）。呼び返しの後は、ConMa 版でやり直すと、呼び返した
;; 関数のしたことが 2 度起きるため。VM に頼めない所（$no）は、呼び返しか待った後なら、$NoHost を投げる。文字列と配列のメソッド（$m）は、
;; それを受けて、メソッドを VM で動かす。ほかの所では、プログラムを止める（$Fatal）。$committed は、やり直せなくなったわけ
;; （'calling back' か 'waiting'。止めるときのメッセージに出す）
;; 値の受け渡し（段階 H3b）：__JS_fn_call__ が渡す VM の値の写し（rt.dict のオブジェクトと rt.VmRef。vm/wasm/conma.js）を、$in が
;; JavaScript の値にする（SJS の配列は配列、オブジェクトはプロトタイプのないオブジェクト、null の Ref は null、ほかの Dict は
;; $Opaque。同じものは同じ値）。終わったら、$outv が返す値を、$sync が変わった配列とオブジェクトを、VM の形に戻す（新しい配列と
;; オブジェクトの "id" は、Conjs_hostfn が最初の引数に渡す、値の番号を数える Ref で数える。sjs_rt.se の Sjs_new_id と同じ）。
;; VM に頼むときは、前に $sync でホストの変更を写しに書き、後で $refresh で VM の変更を JavaScript の値に読み直す。
;; $P は、演算の位置（"ファイル:行:桁"）の表で、変換器が作る（Hx_pos）。p はその番号
(define Hx_helpers ,()
  __String_join_lines__
    "'use strict';"
    "class $Fatal extends Error {}"
    "class $NoHost extends $Fatal {}"
    "let $committed = false, $tramp = null;"
    "const $no = () => { throw $committed ? new $NoHost('not on the host') : new rt.Escape('not on the host'); };"
    "const $slow = (p, op, ...a) => $committed ? $vm(op, p, ...a) : $no();"
    "const $n = (x) => typeof x === 'number' ? x : $no();"
    "const $str = (s) => typeof s === 'string' ? s : $no();"
    "const $isAscii = (s) => { for (let i = 0; i < s.length; i++) if (s.charCodeAt(i) > 127) return false; return true; };"
    "const $ascii = (s) => typeof s === 'string' && $isAscii(s) ? s : $no();"
    "const $opt = (x) => x === undefined || typeof x === 'number' ? x : $no();"
    "const $int = (k) => /^(0|[1-9][0-9]*)$/.test(k);"
    ;; 算術と比べること：数どうしはその場で、ほかは VM（Sjs_add など。ConJS の TypeError も）
    "const $add = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a + b : $slow(p, 'add', a, b);"
    "const $sub = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a - b : $slow(p, 'sub', a, b);"
    "const $mul = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a * b : $slow(p, 'mul', a, b);"
    "const $div = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a / b : $slow(p, 'div', a, b);"
    "const $mod = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a % b : $slow(p, 'mod', a, b);"
    "const $lt = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a < b : $slow(p, 'lt', a, b);"
    "const $le = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a <= b : $slow(p, 'le', a, b);"
    "const $gt = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a > b : $slow(p, 'gt', a, b);"
    "const $ge = (a, b, p) => typeof a === 'number' && typeof b === 'number' ? a >= b : $slow(p, 'ge', a, b);"
    "const $neg = (a, p) => typeof a === 'number' ? -a : $slow(p, 'neg', a);"
    "const $pos = (a, p) => typeof a === 'number' ? a : $slow(p, 'pos', a);"
    "const $step = (a, d, p) => typeof a === 'number' ? a + d : $slow(p, 'step', a, d);"
    "const $protos = new Set(), $classes = new Map();"
    ;; $K：ホストのオブジェクトとインスタンスの印（オブジェクトの自分の、クラスならプロトタイプの、記号のキー。Object.keys には出ない）
    "const $K = Symbol('conjs'), $N = Symbol('class');"
    ;; throw した値。p は throw の位置（呼び返しの後、外へ出たとき、VM がそこで投げ直す）。vm は VM から来た例外（位置を持つ）
    "class $Thrown { constructor(v, p, vm) { this.v = v; this.p = p; this.vm = vm; } }"
    ;; ジェネレータ関数（段階 H8）：$Give は、本体の yield が出す値 v（読み手に渡すもの。VM への頼みの配列と区別する）、$Ret は、
    ;; return(v) で止まる印（catch は受けず、finally は動く）、$HG は、ホストの関数の中で呼んだジェネレータ関数の値（イテレータ it）
    "class $Give { constructor(v, p) { this.v = v; this.p = p; } }"
    "class $Ret { constructor(v) { this.v = v; } }"
    "class $HG { constructor(it) { this.it = it; this.msg = undefined; this.done = false; } }"
    "let $clsR = null;"
    "const $new = (name, I, a) => { const o = Object.create($classes.get(name)); const r = I(o, a); return (typeof r === 'object' && r !== null) || typeof r === 'function' ? r : o; };"
    "const $instof = (x, P, name, p) => { if (x instanceof $Opaque) return $slow(p, 'instof', x, name); return typeof x === 'object' && x !== null && !Array.isArray(x) && Object.prototype.isPrototypeOf.call(P, x); };"
    "const $isObj = (o) => typeof o === 'object' && o !== null && o[$K] === true;"
    ;; JSON（段階 H5e）：ConJS の JSON.stringify（sjs_rt.se の Sjs_json）と同じになると確かめられる値だけ、エンジンの JSON で。
    ;; 確かめられる値：null、undefined、真偽値、文字列、$S と同じ字句の数（整数）か NaN と無限大（どちらも null）、配列、toJSON の
    ;; ないホストのオブジェクト、関数（書かない）で、輪のないもの。ほかは VM（引数が 2 つ以上のときも。ConJS は使わない）
    "const $jsonOk = (x, seen) => { if (x === null || x === undefined || typeof x === 'boolean' || typeof x === 'string' || typeof x === 'function') return true; if (typeof x === 'number') return !Number.isFinite(x) || (Number.isInteger(x) && !Object.is(x, -0) && Math.abs(x) < 1e21); if (typeof x !== 'object' || seen.has(x)) return false; if (Array.isArray(x)) { seen.add(x); const ok = x.every((v) => $jsonOk(v, seen)); seen.delete(x); return ok; } if (!$isObj(x) || 'toJSON' in x) return false; seen.add(x); const ok = Object.keys(x).every((k) => $jsonOk(x[k], seen)); seen.delete(x); return ok; };"
    "const $jsonS = (p, x, ...more) => more.length === 0 && $jsonOk(x, new Set()) ? JSON.stringify(x) : $slow(p, 'json', x);"
    ;; JSON.parse：エンジンの JSON で読み、オブジェクトをホストのオブジェクトにする。整数のような名前や __proto__ のあるもの、読めない文字列
    ;; （エラーを ConJS と同じにするため）、reviver は VM で
    "const $jsonIn = (v) => { if (Array.isArray(v)) return v.map($jsonIn); if (v === null || typeof v !== 'object') return v; const o = $plain(); for (const k of Object.keys(v)) { if ($int(k) || k === '__proto__') throw $noJson; o[k] = $jsonIn(v[k]); } return o; };"
    "const $noJson = {};"
    "const $jsonP = (p, text, ...more) => { if (more.length === 0 && typeof text === 'string') { let v; try { v = $jsonIn(JSON.parse(text)); } catch (e) { v = $noJson; } if (v !== $noJson) return v; } return $slow(p, 'jsonp', text); };"
    ;; typeof と、組み込みのエラーの instanceof（段階 H5e）
    "const $typeof = (x, p) => x === null ? 'object' : x instanceof $Opaque ? $slow(p, 'typeof', x) : typeof x;"
    "const $instofE = (x, name, p) => x instanceof $Opaque ? $slow(p, 'instofg', x, name) : false;"
    "const $plain = () => { const o = Object.create(null); o[$K] = true; return o; };"
    "const $own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);"
    "const $nom = function () { $no(); };"
    "const $o = (kv) => { const o = $plain(); for (let i = 0; i < kv.length; i += 2) { if ($int(kv[i])) $no(); o[kv[i]] = kv[i + 1]; } return o; };"
    "const $S = (x, p) => typeof x === 'string' ? x : typeof x === 'boolean' ? String(x) : x === undefined ? 'undefined' : typeof x === 'number' && Number.isInteger(x) && !Object.is(x, -0) && Math.abs(x) < 1e21 ? String(x) : $slow(p, 'str', x);"
    "const $len = (s, p) => { if (Array.isArray(s)) return s.length; if (typeof s !== 'string') return $slow(p, 'get', s, 'length'); let n = 0; for (const c of s) n++; return n; };"
    ;; メンバーを読む：自分のプロパティか undefined（メソッドを値として読むのは、this を結ぶ ConJS と違うので VM）
    "const $getn = (o, k, p) => { if (typeof o === 'object' && o !== null && o[$K] === true) { if (Object.hasOwn(o, k)) return o[k]; if (!(k in o)) return undefined; } return $get(o, k, p); };"
    "const $get = (o, k, p) => { if ($isObj(o) && typeof k === 'string') { if ($own(o, k)) return o[k]; if (!(k in o)) return undefined; } else if (Array.isArray(o) && Number.isInteger(k) && k >= 0) return k < o.length ? o[k] : undefined; else if (typeof o === 'string' && Number.isInteger(k) && k >= 0 && $isAscii(o)) return k < o.length ? o[k] : undefined; return $slow(p, 'get', o, k); };"
    "const $idx = $get;"
    ;; メンバーに書く
    "const $putn = (o, k, v, p) => { if (typeof o === 'object' && o !== null && o[$K] === true) { o[k] = v; return v; } return $put(o, k, v, p); };"
    "const $put = (o, k, v, p) => { if ($isObj(o) && typeof k === 'string' && !$int(k)) { o[k] = v; return v; } if (Array.isArray(o) && Number.isInteger(k) && k >= 0 && k <= o.length) { o[k] = v; return v; } return $slow(p, 'set', o, k, v); };"
    ;; o.k(...)：$mc は、呼ぶ関数（自分のプロパティの関数か、クラスのメソッド）を返し、呼ぶ側が .call(o, ...) で呼ぶ。ほかは VM で呼ぶ
    "const $mc = (o, k, p) => { if (typeof o === 'object' && o !== null && o[$K] === true) { const f = o[k]; if (typeof f === 'function' && (Object.hasOwn(o, k) || f !== $nom)) return f; } return function (...a) { return $mcall(o, k, p, ...a); }; };"
    "const $mcall = (o, k, p, ...a) => { if ($isObj(o)) { if ($own(o, k) && typeof o[k] === 'function') return o[k](...a); if (k in o && o[k] !== $nom) return o[k].call(o, ...a); } return $vm('callm', p, o, k, a); };"
    "const $call = (f, p, ...a) => typeof f === 'function' ? f(...a) : $vm('call', p, f, a);"
    ;; 配列のメソッドに渡す関数：VM の関数（$Opaque）なら、VM を呼び返す JavaScript の関数にする
    "const $fn = (f, p) => typeof f === 'function' ? f : f instanceof $Opaque ? (...a) => $vm('call', p, f, a) : $no();"
    ;; for...of：配列は写し、文字列はそのまま、VM の値（ジェネレータ、ファイルの readLines など）は、VM の手順（Sjs_iter_open、more、
    ;; take、close。ConMa 版の for...of と同じ）を 1 つずつ VM に頼む。途中で抜ければ、JavaScript が return を呼ぶ（close）
    ;; ふつうのホストの関数（ジェネレータでない。ジェネレータの本体は $iterG）で VM の値を回すのは、呼び返しの後だけ：前なら
    ;; ConMa 版に替える（次の値が待つことがあり、入れ子の呼び返しは待てないので。M1 の shima3/conma#84 のレビュー）
    "const $iter = (a, p) => Array.isArray(a) ? a.slice() : typeof a === 'string' ? a : a instanceof $HG ? $hgIter(a) : $committed ? $vmIter(a, p) : $no();"
    "const $vmIter = (a, p) => { const it = $vm('iter_open', p, a); return { [Symbol.iterator]() { return this; }, next() { return $vm('iter_more', p, it) ? { value: $vm('iter_take', p, it), done: false } : { value: undefined, done: true }; }, return() { $vm('iter_close', p, it); return { value: undefined, done: true }; } }; };"
    ;; ホストのジェネレータを、ふつうのホストの関数の中で回す（段階 H8）：本体の $Give の値を出し、ほかの頼み（VM の関数の呼び出しなど）
    ;; は、その場で VM に頼む（入れ子の実行。待てば止める。待つジェネレータ関数を呼ぶ関数は、ジェネレータとして書くので、ここには
    ;; 来ない）。途中で抜ければ return で閉じる（finally の頼みも動かし、そこの yield で止まる。ConMa 版の Sjs_iter_close と同じ）
    "const $vmReq = (q) => { $cr++; try { return rt.callVm($tramp, q[3], q[0], q[1], q[2], q[4]); } catch (e) { if (e instanceof rt.Escape) throw new $Fatal(`a call back could not finish: ${e.message}`); throw e; } };"
    "const $hgNext = (h) => { for (;;) { const s = h.it.next(h.msg); h.msg = undefined; if (s.done) { h.done = true; return { value: undefined, done: true }; } if (s.value instanceof $Give) return { value: s.value.v, done: false }; h.msg = $vmReq(s.value); } };"
    "const $hgClose = (h) => { if (h.done) return; h.done = true; let s = h.it.return(undefined); while (!s.done && !(s.value instanceof $Give)) s = h.it.next($vmReq(s.value)); };"
    "const $hgIter = (h) => ({ [Symbol.iterator]() { return this; }, next() { return h.done ? { value: undefined, done: true } : $hgNext(h); }, return() { $hgClose(h); return { value: undefined, done: true }; } });"
    "const $arr = (a) => Array.isArray(a) ? a : $no();"
    "const $keys = (o, p) => $isObj(o) ? Object.keys(o) : $slow(p, 'keys', o);"
    ;; Math：数どうしはホストで、ほかは VM の Math（Sjs の Math は、数でない引数を数にする）
    "const $math = (name, p, ...a) => { for (const x of a) if (typeof x !== 'number') return $slow(p, 'math', name, a); return Math[name](...a); };"
    "const $M_floor = (x, p) => typeof x === 'number' ? Math.floor(x) : $slow(p, 'math', 'floor', [x]), $M_ceil = (x, p) => typeof x === 'number' ? Math.ceil(x) : $slow(p, 'math', 'ceil', [x]), $M_round = (x, p) => typeof x === 'number' ? Math.round(x) : $slow(p, 'math', 'round', [x]), $M_trunc = (x, p) => typeof x === 'number' ? Math.trunc(x) : $slow(p, 'math', 'trunc', [x]);"
    "const $M_abs = (x, p) => typeof x === 'number' ? Math.abs(x) : $slow(p, 'math', 'abs', [x]), $M_sqrt = (x, p) => typeof x === 'number' ? Math.sqrt(x) : $slow(p, 'math', 'sqrt', [x]), $M_sign = (x, p) => typeof x === 'number' ? Math.sign(x) : $slow(p, 'math', 'sign', [x]);"
    "const $text = (x, p) => x === null ? 'null' : typeof x === 'string' ? x : $committed ? $vm('console', p, x) : $S(x, p);"
    "let $out = [];"
    ;; 行を作ってから足す（$text が VM に頼むと、$vm がためた行を渡して $out を新しくするので、先に $out を読むと、渡した後の古い
    ;; 配列に足してしまう）
    "const $log = (p, ...a) => { const line = a.map((x) => $text(x, p)).join(' '); $out.push(line); };"
    "const $join = (a, sep, p) => a.map((x) => x === undefined || x === null ? '' : $S(x, p)).join(sep === undefined ? ',' : $str(sep));"
    ;; 併合ソート：sjs_rt.se の Sjs_msort と同じ手順（同じ順で比べる関数を呼ぶ）。undefined は後ろ
    "const $msort = (l, after) => { if (l.length < 2) return l; const h = Math.floor(l.length / 2); const a = $msort(l.slice(0, h), after), b = $msort(l.slice(h), after); const r = []; let i = 0, j = 0; while (i < a.length && j < b.length) { if (after(a[i], b[j])) r.push(b[j++]); else r.push(a[i++]); } while (i < a.length) r.push(a[i++]); while (j < b.length) r.push(b[j++]); return r; };"
    "const $sort = (a, f) => { if (typeof f !== 'function') $no(); const vals = a.filter((x) => x !== undefined), undefs = a.filter((x) => x === undefined); const s = $msort(vals, (x, y) => $n(f(x, y)) > 0).concat(undefs); for (let i = 0; i < s.length; i++) a[i] = s[i]; return a; };"
    "const $A = {"
    "  push: (a, ...x) => a.push(...x), pop: (a) => a.pop(), join: (a, sep) => $join(a, sep, $p0),"
    "  slice: (a, s, e) => a.slice($opt(s), $opt(e)), at: (a, i) => a.at($opt(i)),"
    "  indexOf: (a, x) => a.indexOf(x), includes: (a, x) => a.includes(x),"
    "  map: (a, f) => a.map(f), filter: (a, f) => a.filter(f), forEach: (a, f) => { a.forEach(f); },"
    "  some: (a, f) => a.some(f), every: (a, f) => a.every(f), find: (a, f) => a.find(f), findIndex: (a, f) => a.findIndex(f),"
    "  reduce: (a, f, ...init) => { if (init.length > 1) $no(); if (init.length === 1) return a.reduce(f, init[0]); if (a.length === 0) $no(); return a.reduce(f); },"
    "  concat: (a, ...x) => { for (const y of x) if (!Array.isArray(y)) $no(); return a.concat(...x); },"
    "  reverse: (a) => a.reverse(), sort: (a, f) => $sort(a, f),"
    "};"
    "const $Sm = {"
    "  charAt: (s, i) => $ascii(s).charAt($opt(i)), at: (s, i) => $ascii(s).at($opt(i)),"
    "  indexOf: (s, t, i) => $ascii(s).indexOf($ascii(t), $opt(i)), includes: (s, t, i) => $ascii(s).includes($ascii(t), $opt(i)),"
    "  startsWith: (s, t, i) => $ascii(s).startsWith($ascii(t), $opt(i)), endsWith: (s, t, i) => $ascii(s).endsWith($ascii(t), $opt(i)),"
    "  slice: (s, a, b) => $ascii(s).slice($opt(a), $opt(b)), trim: (s) => $ascii(s).trim(),"
    "  toUpperCase: (s) => $ascii(s).toUpperCase(), toLowerCase: (s) => $ascii(s).toLowerCase(), repeat: (s, n) => $ascii(s).repeat($n(n)),"
    "  replace: (s, p, r) => $ascii(s).replace($ascii(p), $ascii(r).includes('$') ? $no() : r),"
    "  replaceAll: (s, p, r) => $ascii(s).replaceAll($ascii(p), $ascii(r).includes('$') ? $no() : r),"
    "  split: (s, sep, ...more) => { if (more.length > 0) $no(); return $ascii(s).split($ascii(sep)); },"
    "};"
    ;; r.name(...a)：配列と文字列はホストで（関数の引数は $fn で JavaScript の関数にして）、確かめに通らなければ VM（Sjs_call_member）。
    ;; ほかの値は $mcall
    "let $p0 = null;"
    "const $m = (name) => (p, r, ...a) => {"
    "  const t = Array.isArray(r) ? $A : typeof r === 'string' ? $Sm : null;"
    "  $ops += t === $A ? r.length + 1 : 1;"
    "  if (t === null) return $mcall(r, name, p, ...a);"
    "  const f = t[name]; if (f === undefined) return $vm('method', p, r, name, a);"
    "  const args = t === $A ? a.map((x) => typeof x === 'function' || x instanceof $Opaque ? $fn(x, p) : x) : a;"
    "  const saved = $p0; $p0 = p;"
    "  try { return f(r, ...args); }"
    "  catch (e) { if (!(e instanceof rt.Escape || e instanceof $NoHost) || !$committed || args.some((x) => typeof x === 'function')) throw e; return $vm('method', p, r, name, a); }"
    "  finally { $p0 = saved; }"
    "};"
    "const $m_charAt = $m('charAt'), $m_at = $m('at'), $m_indexOf = $m('indexOf'), $m_includes = $m('includes'), $m_startsWith = $m('startsWith'), $m_endsWith = $m('endsWith'), $m_slice = $m('slice'), $m_trim = $m('trim'), $m_toUpperCase = $m('toUpperCase'), $m_toLowerCase = $m('toLowerCase'), $m_repeat = $m('repeat'), $m_replace = $m('replace'), $m_replaceAll = $m('replaceAll'), $m_split = $m('split');"
    "const $m_push = $m('push'), $m_pop = $m('pop'), $m_join = $m('join'), $m_map = $m('map'), $m_filter = $m('filter'), $m_forEach = $m('forEach'), $m_some = $m('some'), $m_every = $m('every'), $m_find = $m('find'), $m_findIndex = $m('findIndex'), $m_reduce = $m('reduce'), $m_concat = $m('concat'), $m_reverse = $m('reverse'), $m_sort = $m('sort');"
    ;; VM の値の写しと JavaScript の値
    "class $Opaque { constructor(m) { this.m = m; } }"
    "let $ids = null, $nullRef = null;"
    ;; 費用の数え（段階 H5d）：仕事（$ops：ループの 1 回、関数の始め、配列のメソッドの要素）、写した配列とオブジェクト（$cp）、
    ;; VM へ渡った回数（$cr：呼び返し、遅い道、待つ頼み）。呼び出しの答えに付けて、Conjs_hostfn がホストを使い続けるか決める
    "let $ops = 0, $cp = 0, $cr = 0;"
    "let $memo = new Map(), $back = new Map();"
    "const $newId = () => { $ids.value = $ids.value + 1; return $ids.value; };"
    "const $fromArray = (v, a) => { $cp++; a.length = 0; const n = v.length.value; for (let i = 0; i < n; i++) { const k = String(i); if (!(k in v.items)) $no(); a.push($in(v.items[k])); } };"
    "const $fromObject = (v, o) => { $cp++; for (const k of Object.keys(o)) delete o[k]; const names = (v.keys.value || []).slice().reverse(); if (names.length !== Object.keys(v.props).length) $no(); for (const k of names) { if ($int(k) || !(k in v.props)) $no(); o[k] = $in(v.props[k]); } };"
    "const $in = (v) => {"
    "  if (v === null || v === undefined || typeof v !== 'object') return v;"
    "  if (v instanceof rt.VmRef) { if ($nullRef === null) $nullRef = v; return null; }"
    "  if (Array.isArray(v) || v instanceof rt.VmHandle) $no();"
    "  if ($memo.has(v)) return $memo.get(v);"
    "  if (v.t === 'array' && !('holes' in v) && !('frozen' in v) && !('cls' in v)) {"
    "    const a = []; $memo.set(v, a); $fromArray(v, a); $back.set(a, { m: v, snap: a.slice() }); return a;"
    "  }"
    "  const proto = v.t !== 'object' ? undefined : !('cls' in v) ? null : $classes.get(v.cls.name);"
    "  if (proto !== undefined && !(proto !== null && 'builtin' in v.cls)) {"
    "    const o = proto === null ? $plain() : Object.create(proto); $memo.set(v, o); $fromObject(v, o);"
    "    $back.set(o, { m: v, snap: Object.entries(o) }); return o;"
    "  }"
    "  const op = new $Opaque(v); $memo.set(v, op); return op;"
    "};"
    "const $fillArray = (m, a) => { $cp++; for (const k of Object.keys(m.items)) delete m.items[k]; for (let i = 0; i < a.length; i++) { if (!(i in a)) $no(); m.items[String(i)] = $outv(a[i]); } m.length.value = a.length; };"
    "const $fillObject = (m, o) => { $cp++; const names = Object.keys(o); for (const k of Object.keys(m.props)) delete m.props[k]; for (const k of names) { if ($int(k)) $no(); m.props[k] = $outv(o[k]); } m.keys.value = names.slice().reverse(); };"
    "const $outv = (x) => {"
    "  if (x === undefined) return undefined;"
    "  if (x === null) { if ($nullRef === null) $nullRef = rt.ref(undefined); return $nullRef; }"
    "  if (typeof x !== 'object') return typeof x === 'function' ? $no() : x;"
    "  if (x instanceof $Opaque) return x.m;"
    "  const b = $back.get(x); if (b) return b.m;"
    "  if (Array.isArray(x)) { const m = rt.dict({ t: 'array', id: $newId(), items: rt.dict(), length: rt.ref(0) }); $back.set(x, { m, snap: null }); $fillArray(m, x); return m; }"
    "  if ($isObj(x)) {"
    "    const pr = Object.getPrototypeOf(x);"
    "    if (pr !== null) { const R = $clsR === null ? undefined : $clsR[pr[$N]]; if (R === undefined) $no(); const m = rt.dict({ t: 'object', id: $newId(), props: rt.dict(), keys: rt.ref([]), cls: R }); $back.set(x, { m, snap: null }); $fillObject(m, x); return m; }"
    "    const m = rt.dict({ t: 'object', id: $newId(), props: rt.dict(), keys: rt.ref([]) }); $back.set(x, { m, snap: null }); $fillObject(m, x); return m;"
    "  }"
    "  return $no();"
    "};"
    ;; ホストの配列とオブジェクトのうち、変わったものを写しに書く（後で比べるために、今の中身を覚える）
    "const $sync = () => { for (const [x, b] of [...$back]) { if (Array.isArray(x)) { if (b.snap === null || x.length !== b.snap.length || x.some((v, i) => v !== b.snap[i])) $fillArray(b.m, x); b.snap = x.slice(); } else { const now = Object.entries(x); if (b.snap === null || now.length !== b.snap.length || now.some(([k, v], i) => k !== b.snap[i][0] || v !== b.snap[i][1])) $fillObject(b.m, x); b.snap = Object.entries(x); } } };"
    ;; 写しを、ホストの配列とオブジェクトに読み直す（VM が変えたもの）
    "const $refresh = () => { for (const [x, b] of [...$back]) { if (Array.isArray(x)) { $fromArray(b.m, x); b.snap = x.slice(); } else { $fromObject(b.m, x); b.snap = Object.entries(x); } } };"
    ;; VM に op を頼む（Conjs_hostfn_vm）：ためた console.log の行を先に出させ、値を写しにして渡し、変わったものを読み直す。
    ;; 呼び返し（call、callm）の後は、やり直せない（$committed）。VM で投げられた例外は、$Thrown にして投げる
    ;; 一番外の文（段階 H6c）：$gio は、文の関数が置く { get: 書いた一番外の変数の値の配列, set: 使う一番外の変数に新しい値を
    ;; 入れる関数 }。VM へ渡るたびに、書いた変数を VM に送り（ConMa が代入する）、戻ったら、使う変数を読み直す（その間にほかの処理や
    ;; ConMa の関数が変えたもの）
    "let $gio = null;"
    ;; 値の配列を、もう 1 つの配列に包んで送る（書いた変数がないとき、空の配列は VM で null になり、「文でない」と区別できないので）
    "const $gout = () => $gio === null ? null : [$gio.get().map($outv)];"
    "const $gin = (r) => { if ($gio !== null && r.length > 2) $gio.set(r[2].map($in)); };"
    "const $vm = (op, p, ...args) => {"
    "  $cr++; const calls = op === 'call' || op === 'callm' || op === 'new' || op.startsWith('iter_');"
    "  if (!calls && !$committed) $no();"
    "  $sync(); const margs = args.map((x, i) => x instanceof $Opaque ? x.m : Array.isArray(x) && (op === 'call' || op === 'callm' || op === 'method' || op === 'math' || op === 'new') && i === args.length - 1 ? x.map($outv) : $outv(x));"
    "  const lines = $out; $out = [];"
    "  let r;"
    "  const gl = $gout();"
    "  try { r = rt.callVm($tramp, lines, p === null || p === undefined ? null : $P[p], op, margs, gl); }"
    "  catch (e) { if (e instanceof rt.Escape && (calls || $committed)) throw new $Fatal(`a call back could not finish: ${e.message}`); throw e; }"
    "  if (calls) $committed = $committed || 'calling back';"
    "  $refresh(); $gin(r);"
    "  const v = $in(r[1]);"
    "  if (r[0] === 'threw') throw new $Thrown(v, null, true);"
    "  return v;"
    "};"
    ;; ホストの関数の入口：引数を JavaScript の値にして呼び、値と console.log の行を返す。Conjs_hostfn が、値の番号の Ref、VM に頼む
    ;; Closure、（new を使うなら）クラスの記録の表を、引数の前に渡す
    "const $run = (f) => (ids, tramp, ...rest) => { const args = $withClasses ? rest.slice(1) : rest; return $enter(ids, tramp, $withClasses ? rest[0] : null, () => f(...args.map($in))); };"
    ;; メソッド：Conjs_hostfn_method が、this を引数の前に渡す
    "const $runm = (P, k) => (ids, tramp, ...rest) => { const r = $withClasses ? rest.slice(1) : rest; const self = r[0], args = r.slice(1); return $enter(ids, tramp, $withClasses ? rest[0] : null, () => { const o = $in(self); if (!$isObj(o) || !(k in o)) $no(); return P[k].call(o, ...args.map($in)); }); };"
    ;; 呼び返しの中から、またホストの関数が呼ばれることがあり、待つホストの関数（ジェネレータ）は、待つ間に、ほかの処理がホストの
    ;; 関数を呼ぶので、状態は呼び出しごとに st に持ち、動かす間だけ大域の変数に置く（$go）
    "const $fresh = (ids, tramp, cls) => ({ ids, tramp, cls: cls === undefined ? null : cls, nullRef: null, memo: new Map(), back: new Map(), out: [], committed: false, p0: null, ops: 0, cp: 0, cr: 0, gio: null });"
    ;; body を st で動かす。body は、イテレータの next の答え（{ done, value }）を返す。done でなければ、value（VM への頼み）を返す。
    ;; done なら、値か、外へ出た例外か、止めるわけ（呼び返しの後）を、console.log の行と返す。呼び返しの前の rt.Escape は投げる
    "const $go = (st, body) => {"
    "  const saved = [$ids, $tramp, $clsR, $nullRef, $memo, $back, $out, $committed, $p0, $ops, $cp, $cr, $gio];"
    "  [$ids, $tramp, $clsR, $nullRef, $memo, $back, $out, $committed, $p0, $ops, $cp, $cr, $gio] = [st.ids, st.tramp, st.cls, st.nullRef, st.memo, st.back, st.out, st.committed, st.p0, st.ops, st.cp, st.cr, st.gio];"
    "  try {"
    "    let r, thrown = null;"
    "    try { const s = body(); if (!s.done) return s.value; r = s.value; } catch (e) { if (e instanceof $Ret) r = e.v; else { if (!(e instanceof $Thrown) || !$committed) throw e; thrown = e; } }"
    "    if (thrown !== null) { const tv = $outv(thrown.v); $sync(); return { thrown: tv, tpos: thrown.vm || thrown.p === null ? null : $P[thrown.p], out: $out, cost: [$ops, $cp, $cr] }; }"
    "    const v = $outv(r); $sync(); return { v: v, out: $out, cost: [$ops, $cp, $cr] };"
    "  } catch (e) {"
    "    if ($committed || e instanceof $Fatal) return { fatal: String(e && e.message || e), after: $committed || 'calling back', out: $out };"
    "    throw e instanceof rt.Escape ? e : new rt.Escape(String(e && e.message || e));"
    "  } finally {"
    "    Object.assign(st, { ids: $ids, tramp: $tramp, cls: $clsR, nullRef: $nullRef, memo: $memo, back: $back, out: $out, committed: $committed, p0: $p0, ops: $ops, cp: $cp, cr: $cr, gio: $gio });"
    "    [$ids, $tramp, $clsR, $nullRef, $memo, $back, $out, $committed, $p0, $ops, $cp, $cr, $gio] = saved;"
    "  }"
    "};"
    "const $enter = (ids, tramp, cls, body) => $go($fresh(ids, tramp, cls), () => ({ done: true, value: body() }));"
    ;; 待つホストの関数の入口（段階 H4c の B3）：f のイテレータを動かし、待つ所（$Yq）で、頼み [位置, op, 引数, 行] を yield する
    ;; （配列は、セッションの表に節を作らずに渡る。オブジェクトにすると、yield のたびに表が育ち、渡すたびに表のすべてを比べる）。Conjs_hostfn が VProc で頼みを動かし（待ってよい）、("ok" 値) か ("threw" 例外) で __JS_fn_resume__ する
    "const $runG = (f) => function* (ids, tramp, ...rest) {"
    "  const args = $withClasses ? rest.slice(1) : rest;"
    "  const st = $fresh(ids, tramp, $withClasses ? rest[0] : null);"
    "  let it = null, msg;"
    "  for (;;) {"
    "    const r = $go(st, () => { if (it === null) it = f(...args.map($in)); return it.next(msg); });"
    "    if (!Array.isArray(r)) return r;"
    "    msg = yield r;"
    "  }"
    "};"
    ;; VM への頼み：ホストの変更を写しに書き、ためた行と渡す。頼んだ後は、やり直せない（ほかの処理が、ホストの変更を見る）
    "const $Yq = (p, op, ...args) => {"
    "  $cr++; $sync(); const margs = args.map((x, i) => x instanceof $Opaque ? x.m : Array.isArray(x) && i === args.length - 1 && (op === 'call' || op === 'callm' || op === 'callg') ? x.map($outv) : $outv(x));"
    "  const lines = $out; $out = []; $committed = $committed || 'waiting';"
    "  return [p === null || p === undefined ? null : $P[p], op, margs, lines, $gout()];"
    "};"
    ;; 頼みの答え：VM の変更を読み直し、値を返すか、VM の例外を投げる
    "const $Yr = (r) => { $refresh(); $gin(r); const v = $in(r[1]); if (r[0] === 'threw') throw new $Thrown(v, null, true); return v; };"
    ;; ジェネレータの中の呼び出し：ホストの関数はその場で、VM の関数とメソッドは VProc で（待ってよい）
    ;; ホストのジェネレータ（$HG。段階 H8）は、ホストで 1 つずつ動かし、本体のほかの頼みは、そのまま上へ渡す（待ってよい）
    "const $iterG = function* (a, p) { if (Array.isArray(a)) return { h: a.slice(), i: 0 }; if (typeof a === 'string') return { h: [...a], i: 0 }; if (a instanceof $HG) return { g: a, val: undefined }; if (a instanceof $Opaque || $committed) return { v: $Yr(yield $Yq(p, 'iter_open', a)), p, done: false }; return $no(); };"
    "const $moreG = function* (it) { if (it.h) return it.i < it.h.length; if (it.g) { const h = it.g; if (h.done) return false; for (;;) { const s = h.it.next(h.msg); h.msg = undefined; if (s.done) { h.done = true; return false; } if (s.value instanceof $Give) { it.val = s.value.v; return true; } h.msg = yield s.value; } } if (it.done) return false; const m = $Yr(yield $Yq(it.p, 'iter_more', it.v)); if (!m) it.done = true; return m; };"
    "const $takeG = function* (it) { if (it.h) return it.h[it.i++]; if (it.g) return it.val; return $Yr(yield $Yq(it.p, 'iter_take', it.v)); };"
    "const $closeG = function* (it) { if (it.g) { const h = it.g; if (h.done) return; h.done = true; let s = h.it.return(undefined); while (!s.done && !(s.value instanceof $Give)) s = h.it.next(yield s.value); return; } if (it.h || it.done) return; it.done = true; $Yr(yield $Yq(it.p, 'iter_close', it.v)); };"
    ;; yield の答え（段階 H8）：ホストの中の読み手（for...of、yield*）は何も渡さない（undefined）。VM の読み手（Conjs_hostgen）は、
    ;; next(x)、throw(x)、return(x) を ['ok', x]、['threw', x]、['ret', x] で渡す
    "const $Gr = (r) => { if (r === undefined) return undefined; $refresh(); const v = $in(r[1]); if (r[0] === 'threw') throw new $Thrown(v, null, true); if (r[0] === 'ret') throw new $Ret(v); return v; };"
    ;; yield*（段階 H8）：値を 1 つずつ、この本体の yield として出す（ConMa 版の Sjs_yield_star と同じく、next の値は渡さず、throw と
    ;; return は、この本体で起きる）。ジェネレータなら、その戻り値を返す（VM の値は iter_ret で）
    "const $star = function* (a, p) {"
    "  if (a instanceof $HG) { const h = a; if (h.done) return undefined; for (;;) { const s = h.it.next(h.msg); h.msg = undefined; if (s.done) { h.done = true; return s.value; } if (s.value instanceof $Give) $Gr(yield s.value); else h.msg = yield s.value; } }"
    "  const t = yield* $iterG(a, p);"
    "  while (yield* $moreG(t)) $Gr(yield new $Give(yield* $takeG(t), p));"
    "  return t.v === undefined ? undefined : $Yr(yield $Yq(p, 'iter_ret', t.v));"
    "};"
    ;; ジェネレータ関数の入口（段階 H8）：$runG と同じく本体を動かし、本体の $Give を、頼み [位置, 'give', [値], 行, $gout()] にして
    ;; Conjs_hostgen に渡す。値を出した後は、やり直せない（読み手が値を見た）
    "const $giveOut = (g) => { $cr++; const v = $outv(g.v); $sync(); const lines = $out; $out = []; $committed = $committed || 'yielding'; return [g.p === null || g.p === undefined ? null : $P[g.p], 'give', [v], lines, $gout()]; };"
    "const $runGen = (f) => function* (ids, tramp, ...rest) {"
    "  const args = $withClasses ? rest.slice(1) : rest;"
    "  const st = $fresh(ids, tramp, $withClasses ? rest[0] : null);"
    "  let it = null, msg;"
    "  for (;;) {"
    "    const r = $go(st, () => { if (it === null) it = f(...args.map($in)); const s = it.next(msg); return !s.done && s.value instanceof $Give ? { done: false, value: $giveOut(s.value) } : s; });"
    "    if (!Array.isArray(r)) return r;"
    "    msg = yield r;"
    "  }"
    "};"
    "const $callG = function* (f, p, ...a) { if (typeof f === 'function') return f(...a); return $Yr(yield $Yq(p, 'call', f, a)); };"
    "const $mcallG = function* (o, k, p, ...a) { if ($isObj(o)) return $mcall(o, k, p, ...a); return $Yr(yield $Yq(p, 'callm', o, k, a)); };"
    ,(h)
  __String_concat__ h "\n")
