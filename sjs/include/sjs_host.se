  __unless__ pok (,() Hx_fail cx) ,()
  Kit_parse_get body "body" ,(stmts)
  __if_then_else__ isCtor (,() Hx_ctor_body cx info stmts) (,() Hx_stmts cx stmts "") ,(code)
  Kit_parse_get info "name" ,(name)
  __if_then_else__ isCtor
    (,() Kit_parse_get info "class" ,(cname) Kit_code_cat5 "function C_ctor_" cname "(" ps ") {")
    (,() __if_then_else__ notMethod
      (,() Kit_code_cat5 "function f_" name "(" ps ") {")
      (,() Kit_parse_get info "class" ,(cname) Sjs_json_string mkey ,(mq) Kit_code_cat5 "P_" cname "[" mq "] = function (" ,(h) Kit_code_cat3 h ps ") {")) ,(js)
