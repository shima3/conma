  __if_then_else__ isDict (,() __Dict_lookup_or__ node "line" (,(k) __NULL__ __NULL__)) (,() __NULL__ __NULL__) ,(line)
  __if_then_else__ isDict (,() __Dict_lookup_or__ node "col" (,(k) __NULL__ __NULL__)) (,() __NULL__ __NULL__) ,(col)
  __is_null__ line ,(noLine)
  __if_then_else__ noLine (,() __Dict_lookup_or__ cx "line" (,(k) __NULL__ "0")) (,() __NULL__ line) ,(line)
  __if_then_else__ noLine (,() __Dict_lookup_or__ cx "col" (,(k) __NULL__ "0")) (,() __NULL__ col) ,(col)
  __Dict_lookup_or__ cx "H" __print_exit_error__ ,(H)
