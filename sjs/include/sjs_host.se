;; ConJS の関数を、wasm 版の VM のとき、ホストの JavaScript で動かす（docs/dev/CONJS-HOST-PLAN.md の段階 H3a と H3b）。
;; Host_prepare が、プログラムの一番外の function 宣言のうち、ホストの JavaScript に書けるもの（ホストの関数）を見つけて、
;; その fn の節に "host"（名前）を付け、それらをまとめた JavaScript の文（__JS_fn_compile__ に渡すもの）を返す（なければ ""）。
;; 変換器（sjs_gen.se）は、印の付いた関数を Conjs_hostfn で包み（conjs/include/conjs_host.se）、呼ばれたとき、ホストの版を呼ぶ。
;; ホストの版が値を返せなければ（下の「確かめ」）、ConMa 版を始めから動かす。
;;
;; ホストの関数の条件：
;; * 一番外の function 宣言で、async でなく、引数は名前だけ（重ならない）。ジェネレータ関数は、段階 H8 から（下の「ジェネレータ関数」）。その名前は、一番外で 1 回だけ
;;   宣言され、プログラムのどこでも代入されない（数の関数と同じ。sjs_wasm.se の Wx_env）。
;; * 本体は、let と const（名前だけ）、式の文（局所の変数、オブジェクトのメンバー、配列の要素への代入と複合の代入、++、--、
;;   呼び出し）、if、while、do...while、for、for...of（let か const で名前を宣言するものだけ）、ラベルのない break と continue、return、ブロック、
;;   空の文だけ。
;; * 式は、数と文字列のリテラル、true、false、null、引数と局所の変数、NaN、Infinity、undefined（一番外で宣言されず、代入されない
;;   もの）、テンプレート、+ - * / %、< > <= >=、=== と !==、&& と ||、単項の ! - +、条件演算子、配列とオブジェクトの
;;   リテラル（要素とメンバーの式だけ。名前の省略はよい）、関数式とアロー関数（ジェネレータでも async でもなく、引数は名前だけ）、
;;   メンバーと要素を読むこと、ほかのホストの関数と局所の変数の関数の呼び出し、console.log、Object.keys、文字列と配列の
;;   メソッド（Hx_methods）。
;; * 外の変数（一番外の変数も）を読み書きしない。だから、ホストの関数が変えるのは、引数から届く配列とオブジェクトだけで、
;;   それはホストの版が値を返したときにだけ VM に書き戻される（ホストの版は、VM の値の写しを JavaScript の配列とオブジェクトに
;;   して動き、終わったときに、変わったものだけを VM の形に戻す。下の補助の関数の $in、$outv、$sync）。console.log も、
;;   ためておいて、値を返したときにだけ出す。だから、ホストの版を途中でやめて、ConMa 版を始めから動かしてよい（段階 H3b）。
;;
;; 確かめ：ConJS の意味が JavaScript と同じと確かめられる所だけをホストで計算し、そうでない所では rt.Escape を投げる（ConMa 版に
;; 替わる）。算術と比べるのは数どうしだけ（+ は ConJS でも数だけ）。文字列のメソッドは、ASCII の文字列と、数か undefined の
;; 引数だけ（ASCII でない文字列は、文字の数え方が違う。replace と replaceAll は、置き換える文字列に $ のないときだけ）。length は
;; 文字（コードポイント）で数える。テンプレートと console.log と join に入れる数は、整数（-0 を除く）で絶対値が 10^21 より
;; 小さいものだけ。配列は穴のないものだけで、長さより後には書かない。オブジェクトは、整数のような名前のないものだけ（JavaScript は、
;; その名前を先に並べる）。sort は ConJS と同じ手順の併合ソート（sjs_rt.se の Sjs_msort）で、比べる関数は数を返すものだけ。
;; ConJS のクラスのインスタンス、関数、処理などの VM の値は、ホストでは中身の見えない値（$Opaque）で、渡すことと比べることだけが
;; できる。JavaScript の名前は、引数と局所の変数が v_名前、ホストの関数が f_名前、補助の関数が $ で始まる名前

;; プログラムの JavaScript（ホストの関数がなければ ""）。ホストの関数の fn の節に "host" を付ける。数の関数（"wasm" の印。
;; Wasm_prepare の後に呼ぶ）もホストの版を作り、"hostAlso" を付ける：wasm 版が先で、引数が数でなく wasm 版が動かないとき
;; （文字列の s.length と s[i] を使う関数は、数の配列の関数としても印が付く）、ConMa 版の前にホストの版を試す
(define Host_prepare ,(program file)
  __Dict_new__ ,(other)
  Host_prepare_with program file __NULL__ other)

;; import と export のあるプログラムの、1 つのファイル（段階 H6b。conjs/include/conjs_modules.se の Gen_unit）：imported は、
;; import した名前の LList（宣言した名前に数える。組み込みの名前と取り違えないため）、other は、ほかのファイルで宣言したクラスの
;; 名前の Dict（その名前のクラスは、ホストのクラスにしない。インスタンスのクラスを名前で探すので、プログラムの中で 1 つだけのもの）
(define Host_prepare_with ,(program file imported other)
  Kit_parse_get program "body" ,(stmts)
  Wx_env stmts ,(E)
  __Dict_lookup_or__ E "declared" __print_exit_error__ ,(declared)
  Hx_declare_names declared imported ,()
  __Dict_new__ ,(H)
  __Dict_put__ H "#otherClasses" other ,()
  __Dict_put__ H "#file" file ,()
  __Dict_new__ ,(posIndex)
  __Dict_put__ H "#posIndex" posIndex ,()
  __Ref_new__ __NULL__ ,(posList)
  __Dict_put__ H "#posList" posList ,()
  __Ref_new__ __NULL__ ,(order)
  Hx_candidates E H order stmts ,()
  ;; クラス（段階 H4a）：一番外の class 宣言のメソッドも、名前 "クラス.メソッド" で候補にする
  __Ref_new__ __NULL__ ,(classes)
  Hx_classes E H order classes program stmts ,()
  ;; 一番外のループ（段階 H6a）：名前 "$s番号" の候補にする
  __Dict_new__ ,(before)
  Wx_num "0" ,(zeroS)
  __Ref_new__ zeroS ,(stmtN)
  Hx_stmt_candidates E H order before stmtN stmts ,()
  __Ref_get__ order ,(rev)
  Wx_reverse rev __NULL__ ,(names)
  __Dict_new__ ,(waits)
  __Dict_put__ H "#waits" waits ,()
  Hx_wait_loop E H names ,()
  Hx_fixpoint H names ,()
  __Ref_get__ classes ,(crev)
  Wx_reverse crev __NULL__ ,(cs)
  Hx_module H names cs)

;; ── クラス（段階 H4a）──
;; 一番外の let C = class C [extends P] { ... }（class 宣言は、P_class_decl が、この形の let にする）で、C が一番外で 1 回だけ
;; 宣言され、代入されず、プログラムの中に同じ名前のクラスがほかにないもの。親は、なしか、前に宣言した同じ形のクラス。
;; ホストでは、プロトタイプ P_C（親の P_ か null を親にする）を作り、static でないメソッドを P_C に置く（ホストに書けない
;; メソッドは、呼ぶと rt.Escape を投げる $nom）。ホストでは new しないので、コンストラクタとフィールドは書かない。
;; インスタンスは、ホストで $in が、クラスの記録の名前から P_C を探して、それをプロトタイプにしたオブジェクトにする。
;; ConMa からメソッドを呼ぶと、メソッドの関数（Conjs_hostfn_method が包む）が、this をホストに渡す
(define Hx_classes ,(E H order classes program stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Hx_class_decl E s ,(ok name cls)
  __if__ ok (,() Hx_class E H order classes program name cls) ,()
  Hx_classes E H order classes program rest)

;; s が let C = class C ... の宣言なら、真と名前とクラスの節
(define Hx_class_decl ,(E s)
  __Cont_get__ ,(return)
  Wx_t s ,(t)
  __String_equal__ t "decl" ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  Kit_parse_get s "decls" ,(ds)
  __LList_uncons__ (,(e) return __FALSE__ "" __NULL__) ds ,(d rest)
  __is_null__ rest ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  Kit_parse_get d "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  Kit_parse_get target "name" ,(name)
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  __is_null__ init ,(test__) __if__ test__ (,() return __FALSE__ "" __NULL__) ,()
  Wx_t init ,(it)
  __String_equal__ it "class" ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  __Dict_lookup_or__ init "name" (,(k) __NULL__ "") ,(own)
  __String_equal__ own name ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  Wx_once E name ,(test__) __unless__ test__ (,() return __FALSE__ "" __NULL__) ,()
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ (,() return __FALSE__ "" __NULL__) ,()
  __NULL__ __TRUE__ name init)

(define Hx_declare_names ,(declared names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ declared nm (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_add__ c one ,(c)
  __Dict_put__ declared nm c ,()
  Hx_declare_names declared rest)

(define Hx_class ,(E H order classes program name cls)
  __Cont_get__ ,(return)
  ;; ほかのファイルに同じ名前のクラスがあれば、ホストのクラスにしない（段階 H6b）
  __Dict_lookup_or__ H "#otherClasses" (,(k) __NULL__ __NULL__) ,(other)
  __is_null__ other ,(noOther)
  __if_then_else__ noOther (,() __NULL__ __FALSE__) (,() __Dict_lookup_or__ other name (,(k) __NULL__ __FALSE__)) ,(elsewhere)
  __if__ elsewhere return ,()
  ;; プログラムの中で、この名前のクラスは 1 つだけ（インスタンスのクラスを名前で探すので）
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(count)
  Wx_walk program (,(n) Wx_t n ,(t) __String_equal__ t "class" ,(isClass) __if__ isClass (,() __Dict_lookup_or__ n "name" (,(k) __NULL__ "") ,(nm) __String_equal__ nm name ,(same) __if__ same (,() Wx_inc count) ,()) ,()) ,()
  __Ref_get__ count ,(c)
  Wx_num "1" ,(one)
  __Number_subtract__ c one ,(d)
  __Number_is_zero__ d ,(test__) __unless__ test__ return ,()
  ;; 親：なしか、前に受け付けたクラスの名前
  Kit_parse_get cls "parent" ,(parent)
  __is_null__ parent ,(base)
  __Ref_get__ classes ,(known)
  __if_then_else__ base (,() __NULL__ "") (,()
    Wx_t parent ,(pt)
    __String_equal__ pt "id" ,(test__) __unless__ test__ return ,()
    Kit_parse_get parent "name" ,(pn)
    Hx_class_known known pn ,(test__) __unless__ test__ return ,()
    __NULL__ pn) ,(parentName)
  __Dict_new__ ,(cinfo)
  __Dict_put__ cinfo "name" name ,()
  __Dict_put__ cinfo "parent" parentName ,()
  Kit_parse_get cls "members" ,(members)
  Hx_class_methods H order name members __NULL__ ,(methods)
  __Dict_put__ cinfo "methods" methods ,()
  Hx_class_init H order name parentName members ,(hasCtor)
  __Dict_put__ cinfo "ctor" hasCtor ,()
  __Dict_put__ cls "hostClass" name ,()
  __LList_cons__ cinfo known ,(known)
  __Ref_set__ classes known)

;; new のための候補（段階 H4b）："C:fields"（フィールドを入れる関数 F_C）、"C:ctor"（コンストラクタ C_ctor_C。書いたときだけ）、
;; "C:init"（JavaScript を持たない、作り方の印：F_C、C_ctor_C、親の "P:init" がどれもホストに書けたときだけ ok）。
;; コンストラクタがあるか
(define Hx_class_init ,(H order cname parentName members)
  Hx_class_fields members __NULL__ ,(fields)
  Hx_class_ctor members ,(ctor)
  __String_equal__ parentName "" ,(base)
  __Dict_new__ ,(fi)
  Kit_code_cat3 cname ":" "fields" ,(fname)
  __Dict_put__ fi "name" fname ,()
  __Dict_put__ fi "kind" "fields" ,()
  __Dict_put__ fi "class" cname ,()
  __Dict_put__ fi "fields" fields ,()
  __Dict_put__ fi "ok" __FALSE__ ,()
  __Dict_put__ H fname fi ,()
  Hx_push order fname ,()
  __is_null__ ctor ,(noCtor)
  Kit_code_cat3 cname ":" "ctor" ,(cn)
  __unless__ noCtor
    (,()
      __Dict_new__ ,(ci)
      __Dict_put__ ci "name" cn ,()
      __Dict_put__ ci "kind" "ctor" ,()
      __Dict_put__ ci "class" cname ,()
      __Dict_put__ ci "parent" parentName ,()
      __Dict_put__ ci "fn" ctor ,()
      Kit_parse_get ctor "params" ,(params)
      Wx_param_names params __NULL__ ,(pok names)
      __Dict_put__ ci "params" names ,()
      __Dict_put__ ci "ok" __FALSE__ ,()
      __Dict_put__ ci "badParams" pok ,()
      __Dict_put__ H cn ci ,()
      Hx_push order cn) ,()
  ;; 作り方の印
  __Dict_new__ ,(ii)
  Kit_code_cat3 cname ":" "init" ,(iname)
  __Dict_put__ ii "name" iname ,()
  __Dict_put__ ii "kind" "pseudo" ,()
  __LList_cons__ fname __NULL__ ,(cs)
  __if_then_else__ noCtor (,() __NULL__ cs) (,() __LList_cons__ cn cs) ,(cs)
  __if_then_else__ base (,() __NULL__ cs) (,() Kit_code_cat3 parentName ":" "init" ,(pi) __LList_cons__ pi cs) ,(cs)
  __Dict_put__ ii "callees" cs ,()
  __Dict_put__ ii "ok" __FALSE__ ,()
  __Dict_put__ H iname ii ,()
  Hx_push order iname ,()
  __not__ noCtor)

;; 文字列の LList の JavaScript の配列の中身
(define Hx_json_list ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Sjs_json_string x ,(q)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ q) (,() Kit_code_cat3 acc ", " q) ,(acc)
  Hx_json_list rest acc)

(define Hx_push ,(order name)
  __Ref_get__ order ,(o)
  __LList_cons__ name o ,(o)
  __Ref_set__ order o)

;; フィールドのメンバー（書いた順）
(define Hx_class_fields ,(members acc)
  __Cont_get__ ,(return)
  __is_null__ members ,(test__) __if__ test__ (,() Wx_reverse acc __NULL__ ,(l) return l) ,()
  __LList_uncons__ __print_exit_error__ members ,(m rest)
  Kit_parse_get m "kind" ,(kind)
  __String_equal__ kind "field" ,(isField)
  __if_then_else__ isField (,() __LList_cons__ m acc) (,() __NULL__ acc) ,(acc)
  Hx_class_fields rest acc)

;; コンストラクタの function の節（なければ null）
(define Hx_class_ctor ,(members)
  __Cont_get__ ,(return)
  __is_null__ members ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ members ,(m rest)
  Kit_parse_get m "kind" ,(kind)
  __String_equal__ kind "ctor" ,(test__) __if__ test__ (,() Kit_parse_get m "fn" ,(fn) return fn) ,()
  Hx_class_ctor rest)

(define Hx_class_known ,(known name)
  __Cont_get__ ,(return)
  __is_null__ known ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ known ,(c rest)
  Kit_parse_get c "name" ,(nm)
  __String_equal__ nm name ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Hx_class_known rest name)

;; static でないメソッドの名前の LList（書いた順）。ジェネレータでも async でもなく、引数が名前だけのものを、候補 "C.m" にする
(define Hx_class_methods ,(H order cname members acc)
  __Cont_get__ ,(return)
  __is_null__ members ,(test__) __if__ test__ (,() Wx_reverse acc __NULL__ ,(l) return l) ,()
  __LList_uncons__ __print_exit_error__ members ,(m rest)
  Kit_parse_get m "kind" ,(kind)
  __String_equal__ kind "method" ,(test__) __unless__ test__ (,() Hx_class_methods H order cname rest acc ,(l) return l) ,()
  Kit_parse_get m "key" ,(key)
  Kit_parse_get m "fn" ,(fn)
  Kit_code_cat3 cname "." key ,(full)
  __LList_cons__ key acc ,(acc)
  __Dict_lookup_or__ fn "gen" (,(k) __NULL__ __FALSE__) ,(gen)
  __Dict_lookup_or__ fn "async" (,(k) __NULL__ __FALSE__) ,(async)
  __or__ gen async ,(test__) __if__ test__ (,() Hx_class_methods H order cname rest acc ,(l) return l) ,()
  Kit_parse_get fn "params" ,(params)
  Wx_param_names params __NULL__ ,(ok names)
  __unless__ ok (,() Hx_class_methods H order cname rest acc ,(l) return l) ,()
  __Dict_new__ ,(info)
  __Dict_put__ info "name" full ,()
  __Dict_put__ info "fn" fn ,()
  __Dict_put__ info "params" names ,()
  __Dict_put__ info "ok" __FALSE__ ,()
  __Dict_put__ info "class" cname ,()
  __Dict_put__ info "method" key ,()
  __Dict_put__ H full info ,()
  __Ref_get__ order ,(o)
  __LList_cons__ full o ,(o)
  __Ref_set__ order o ,()
  Hx_class_methods H order cname rest acc)

(define Hx_candidates ,(E H order stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Hx_candidate E H order s) ,()
  Hx_candidates E H order rest)

(define Hx_candidate ,(E H order s)
  __Cont_get__ ,(return)
  Kit_parse_get s "name" ,(name)
  Kit_parse_get s "fn" ,(fn)
  Wx_once E name ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ return ,()
  __Dict_lookup_or__ H name (,(k) __NULL__ __NULL__) ,(dup)
  __is_null__ dup ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ fn "gen" (,(k) __NULL__ __FALSE__) ,(gen)
  __Dict_lookup_or__ fn "async" (,(k) __NULL__ __FALSE__) ,(async)
  __if__ async return ,()
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body)
  __is_null__ body ,(test__) __if__ test__ return ,()
  Kit_parse_get fn "params" ,(params)
  Wx_param_names params __NULL__ ,(ok names)
  __unless__ ok return ,()
  __Dict_new__ ,(info)
  __Dict_put__ info "name" name ,()
  ;; ジェネレータ関数（段階 H8）
  __Dict_put__ info "genfn" gen ,()
  __Dict_put__ info "fn" fn ,()
  __Dict_put__ info "params" names ,()
  __Dict_put__ info "ok" __FALSE__ ,()
  __Dict_put__ H name info ,()
  __Ref_get__ order ,(o)
  __LList_cons__ name o ,(o)
  __Ref_set__ order o)

;; ── 一番外の文（段階 H6a、H6c。docs/dev/CONJS-HOST-PLAN.md の 26 節と 28 節）──
;; 一番外のループ（for、for...of、while、do...while）で、ホストに書けるものを「文の関数」にする。前に let、const、var で宣言した
;; 一番外の変数を、読むなら引数 g_名前 にし、書くなら、終わりに配列で返す（sjs_gen.se が、ConMa で代入する）。VM へ渡るとき
;; （呼び返し、遅い道、待つ頼み）は、$gio で、書いた変数を VM に送り、戻ったら使う変数を読み直す（ConMa の関数や、待つ間に動いた
;; ほかの処理が、一番外の変数を読み書きするため。段階 H6c）。sleep、join、nextEvent を呼ぶ文は、ジェネレータにする

;; 一番外の文を順に見て、ループを候補にし、宣言した名前を before（名前 → const か）に足す
(define Hx_stmt_candidates ,(E H order before stmtN stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  Kit_lex_in_words t "for forof while dowhile" ,(isLoop0)
  ;; 段階 H6d：中にループのある if、ブロック、try も（ループのない文は、1 度しか動かず、写す費用のほうが大きくなりうるので
  ;; ConMa のまま）
  Kit_lex_in_words t "if block try" ,(isCompound)
  __if_then_else__ isCompound (,() Hx_has_loop s) (,() __NULL__ __FALSE__) ,(hasLoop)
  __or__ isLoop0 hasLoop ,(isLoop)
  __if__ isLoop
    (,()
      __Ref_get__ stmtN ,(n)
      Wx_num "1" ,(one)
      __Number_add__ n one ,(n)
      __Ref_set__ stmtN n ,()
      Wx_str n ,(ns)
      __String_concat__ "$s" ns ,(name)
      __String_concat__ "s_" ns ,(fname)
      __Dict_new__ ,(info)
      __Dict_put__ info "name" name ,()
      __Dict_put__ info "fname" fname ,()
      __Dict_put__ info "kind" "stmt" ,()
      __Dict_put__ info "stmt" s ,()
      ;; 今までに宣言した名前（後で足す名前は入れない）
      __Dict_copy__ before ,(seen)
      __Dict_put__ info "outer" seen ,()
      __Dict_put__ info "ok" __FALSE__ ,()
      __Dict_put__ H name info ,()
      __Ref_get__ order ,(o)
      __LList_cons__ name o ,(o)
      __Ref_set__ order o) ,()
  __String_equal__ t "decl" ,(isDecl)
  __if__ isDecl
    (,()
      Kit_parse_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      Kit_parse_get s "decls" ,(ds)
      Hx_note_decls before ds isConst) ,()
  Hx_stmt_candidates E H order before stmtN rest)

;; 節 s の中に、ループ（for、for...of、while、do...while）があるか
(define Hx_has_loop ,(s)
