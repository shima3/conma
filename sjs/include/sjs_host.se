  __Dict_lookup_or__ index text (,(k) __NULL__ __NULL__) ,(known)
  __is_null__ known ,(test__) __unless__ test__ (,() return known) ,()
  __Dict_lookup_or__ H "#posList" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(list)
  Wx_num "0" ,(zero)
  Wx_length list zero ,(n)
  Wx_str n ,(ns)
  __Dict_put__ index text ns ,()
  __LList_cons__ text list ,(list)
  __Ref_set__ listRef list ,()
  __NULL__ ns)

;; 2 項の演算子の補助の関数の名前（$add など）。なければ ""
(define Hx_op_helper ,(op)
  __Cont_get__ ,(return)
  __String_equal__ op "+" ,(test__) __if__ test__ (,() return "$add") ,()
  __String_equal__ op "-" ,(test__) __if__ test__ (,() return "$sub") ,()
  __String_equal__ op "*" ,(test__) __if__ test__ (,() return "$mul") ,()
  __String_equal__ op "/" ,(test__) __if__ test__ (,() return "$div") ,()
  __String_equal__ op "%" ,(test__) __if__ test__ (,() return "$mod") ,()
  __String_equal__ op "<" ,(test__) __if__ test__ (,() return "$lt") ,()
  __String_equal__ op "<=" ,(test__) __if__ test__ (,() return "$le") ,()
  __String_equal__ op ">" ,(test__) __if__ test__ (,() return "$gt") ,()
  __String_equal__ op ">=" ,(test__) __if__ test__ (,() return "$ge") ,()
  __NULL__ "")

;; $add(a, b, p) などの呼び出し
