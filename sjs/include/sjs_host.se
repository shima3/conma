  __Dict_lookup_or__ H "#waits" (,(k) __NULL__ __NULL__) ,(waits0)
  __is_null__ waits0 ,(noWaits)
  __if_then_else__ noWaits (,() __NULL__ __FALSE__) (,() __Dict_lookup_or__ waits0 sname (,(k) __NULL__ __FALSE__)) ,(gen)
  __Dict_put__ cx "gen" gen ,()
  __Dict_put__ cx "method" __FALSE__ ,()
  Kit_parse_get info "outer" ,(outer)
  __Dict_put__ cx "outer" outer ,()
  __Dict_new__ ,(used)
  __Dict_put__ cx "used" used ,()
  __Ref_new__ __NULL__ ,(usedList)
  __Dict_put__ cx "usedList" usedList ,()
  __Dict_new__ ,(locals)
  __Dict_put__ cx "locals" locals ,()
  Kit_parse_get info "stmt" ,(s)
  Hx_collect_locals cx s ,()
  Hx_stmt cx s ,(code)
