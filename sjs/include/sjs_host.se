  __String_concat__ decl code ,(code)
  ;; 引数（使った順）と、書いた変数
  __Ref_get__ usedList ,(ulr)
  Wx_reverse ulr __NULL__ ,(reads)
  Hx_stmt_writes used reads __NULL__ ,(wrev)
  Wx_reverse wrev __NULL__ ,(writes)
