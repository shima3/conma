      __is_null__ key ,(test__) __unless__ test__
        (,() Hx_expr cx key ,(kc) Kit_code_cat5 "$idx(" oc ", " kc ")" ,(c) return c) ,()
      Kit_parse_get e "name" ,(name)
      __String_equal__ name "length" ,(test__) __if__ test__ (,() Kit_code_cat3 "$len(" oc ")" ,(c) return c) ,()
      Sjs_json_string name ,(q)
      Kit_code_cat5 "$get(" oc ", " q ")" ,(c)
      return c) ,()
  __String_equal__ t "array" ,(test__) __if__ test__
    (,()
