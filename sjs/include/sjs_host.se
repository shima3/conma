      Kit_parse_get e "yes" ,(yes)
      Hx_expr cx yes ,(yc)
      Kit_parse_get e "no" ,(no)
      Hx_expr cx no ,(nc)
      Kit_code_cat5 "(" tc " ? " yc " : " ,(c)
      Kit_code_cat3 c nc ")" ,(c)
      return c) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Hx_call cx e ,(c) return c) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(opt)
