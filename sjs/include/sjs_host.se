  Hx_fail cx)

;; 配列のリテラルの要素（穴とスプレッドは扱わない）
(define Hx_items ,(cx items acc)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() return acc) ,()
