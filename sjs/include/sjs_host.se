  Wx_num "0" ,(zero)
  __Ref_set__ loops zero ,()
  __Dict_lookup_or__ e "body" (,(k) __NULL__ __NULL__) ,(body)
  __is_null__ body ,(concise)
  __if_then_else__ concise
    (,() Kit_parse_get e "expr" ,(x) Hx_expr cx x ,(xc) Kit_code_cat3 "(" xc ")")
    (,() Kit_parse_get body "body" ,(stmts) Hx_stmts cx stmts "" ,(bc) Kit_code_cat3 "{" bc "}") ,(bc)
  __Ref_set__ loops outer ,()
