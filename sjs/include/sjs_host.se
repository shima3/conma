;; 関数式とアロー関数：JavaScript のアロー関数（this と arguments を使わないので、どちらでも同じ）。本体の break と continue は、
;; 外のループには届かない
(define Hx_closure ,(cx e)
  Kit_parse_get e "params" ,(params)
