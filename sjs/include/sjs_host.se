  __Dict_lookup_or__ cx "opsUsed" (,(k) __NULL__ __NULL__) ,(used)
  __is_null__ used ,(test__) __if__ test__ (,() __NULL__ c) ,()
  __Ref_set__ used __TRUE__ ,()
  Kit_code_cat3 "{$loops++; " c "}")

;; ループのあった関数か関数式の本体 code を、局所の数え $loops で包む（数えを、共通の $ops でなく、エンジンがレジスタに置ける局所の変数に
;; する：ループの 1 回ごとに共通の変数に書くと、速いループでは目に見えて遅い）
(define Hx_ops_wrap ,(used code)
  __Ref_get__ used ,(u)
  __if_then_else__ u (,() Kit_code_cat3 "let $loops = 0; try { " code " } finally { $ops += $loops; }") (,() __NULL__ code))

(define Hx_stmt ,(cx s)
