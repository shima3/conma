(define Hx_compile_all ,(E H names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ H nm __print_exit_error__ ,(info)
  __Dict_lookup_or__ info "kind" (,(k) __NULL__ "") ,(kind)
  __String_equal__ kind "pseudo" ,(isPseudo)
  __String_equal__ kind "fields" ,(isFields)
  __String_equal__ kind "stmt" ,(isStmt)
  __if_then_else__ isPseudo
    (,() Kit_parse_get info "callees" ,(cs) __NULL__ __TRUE__ "" cs)
    (,() __if_then_else__ isFields (,() Hx_fields_func E H info)
      (,() __if_then_else__ isStmt (,() Hx_stmt_func E H info) (,() Hx_func E H info))) ,(ok js callees)
  __Dict_put__ info "ok" ok ,()
  __Dict_put__ info "js" js ,()
  __Dict_put__ info "callees" callees ,()
  Hx_compile_all E H rest)

;; 待つホストの関数（段階 H4c の B3）：待つ呼び出し（sleep、join、nextEvent）か、待つホストの関数の呼び出しのある関数は、
;; JavaScript のジェネレータにする。どの関数が待つかは、呼ぶ関数が待つかによるので、H の "#waits"（待つ関数の名前）が
;; 増えなくなるまで、すべての関数を書き直す。"#waits" にある関数は、ジェネレータとして書く（Hx_func の "gen"）
(define Hx_wait_loop ,(E H names)
  Hx_compile_all E H names ,()
  __Ref_new__ __FALSE__ ,(grew)
  Hx_wait_new H names grew ,()
  __Ref_get__ grew ,(again)
  __if_then_else__ again (,() Hx_wait_loop E H names) (,() __nop__))

(define Hx_wait_new ,(H names grew)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ H nm __print_exit_error__ ,(info)
  Kit_parse_get info "ok" ,(ok)
  __Dict_lookup_or__ info "waits" (,(k) __NULL__ __FALSE__) ,(w)
  __Dict_lookup_or__ H "#waits" __print_exit_error__ ,(waits)
  __Dict_lookup_or__ waits nm (,(k) __NULL__ __FALSE__) ,(known)
  __not__ known ,(fresh)
  __and__ ok w ,(x) __and__ x fresh ,(test__)
  __if__ test__ (,() __Dict_put__ waits nm __TRUE__ ,() __Ref_set__ grew __TRUE__) ,()
  Hx_wait_new H rest grew)

;; ほかのホストの関数でなくなった関数を呼ぶ関数を、ホストの関数でなくする（変わらなくなるまで）
(define Hx_fixpoint ,(H names)
  __Ref_new__ __FALSE__ ,(changed)
  Hx_fixpoint_pass H names changed ,()
  __Ref_get__ changed ,(again)
  __if_then_else__ again (,() Hx_fixpoint H names) (,() __nop__))

(define Hx_fixpoint_pass ,(H names changed)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ H nm __print_exit_error__ ,(info)
  Kit_parse_get info "ok" ,(ok)
  __if__ ok
    (,()
      Kit_parse_get info "callees" ,(cs)
      Hx_all_ok H cs ,(test__)
      __unless__ test__ (,() __Dict_put__ info "ok" __FALSE__ ,() __Ref_set__ changed __TRUE__) ,()) ,()
  Hx_fixpoint_pass H rest changed)

(define Hx_all_ok ,(H names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ H nm __print_exit_error__ ,(info)
  Kit_parse_get info "ok" ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Hx_all_ok H rest)

;; JavaScript の文：補助の関数、ホストの関数、名前から関数への表を返す文。ホストの関数がなければ ""
(define Hx_module ,(H names classes)
  Hx_funcs H names "" "" ,(fs table)
  Hx_class_code H classes "" table ,(cs table)
  __String_equal__ table "" ,(none)
  ;; new を使う関数があれば、ホストの関数は、値の番号の Ref の次に、クラスの記録の表を受け取る（Conjs_hostfn_call_with）
  __Dict_lookup_or__ H "#new" (,(k) __NULL__ __FALSE__) ,(usesNew)
  __if_then_else__ usesNew (,() __NULL__ "const $withClasses = true;\n") (,() __NULL__ "const $withClasses = false;\n") ,(wc)
  ;; 位置の表 $P
  __Dict_lookup_or__ H "#posList" __print_exit_error__ ,(posRef)
  __Ref_get__ posRef ,(prev)
  Wx_reverse prev __NULL__ ,(ps)
  Hx_json_list ps "" ,(pj)
  Kit_code_cat4 wc "const $P = [" pj "];\n" ,(wc)
  __if_then_else__ none (,() __NULL__ "")
    (,() Hx_helpers ,(h) Kit_code_cat5 h wc cs fs "return {" ,(m) Kit_code_cat3 m table "};"))

;; クラスのプロトタイプとメソッドの JavaScript、と表に足す "C.m": $runm(P_C, "m")
(define Hx_class_code ,(H classes acc table)
  __Cont_get__ ,(return)
  __is_null__ classes ,(test__) __if__ test__ (,() return acc table) ,()
  __LList_uncons__ __print_exit_error__ classes ,(c rest)
  Kit_parse_get c "name" ,(cname)
  Kit_parse_get c "parent" ,(pn)
  __String_equal__ pn "" ,(base)
  __if_then_else__ base (,() __NULL__ "null") (,() __String_concat__ "P_" pn) ,(pp)
  Sjs_json_string cname ,(cq)
  Kit_code_cat5 "const P_" cname " = Object.create(" pp ");\n" ,(h)
  Kit_code_cat5 h "P_" cname "[$K] = true; $protos.add(P_" cname ,(h)
  Kit_code_cat5 h "); $classes.set(" cq ", P_" cname ,(h)
  __String_concat__ h ");\n" ,(h)
  __String_concat__ acc h ,(acc)
  Kit_parse_get c "methods" ,(ms)
  Hx_method_code H cname ms acc table ,(acc table)
  Kit_code_cat5 acc "P_" cname "[$N] = " cq ,(acc)
  __String_concat__ acc ";\n" ,(acc)
  Hx_init_code H cname pn base acc ,(acc)
  Hx_class_code H rest acc table)

;; F_C、C_ctor_C と、作り方 I_C（o を、引数の配列 a で初めにする。conjs_class.se の Conjs_init と同じ順。返すのはコンストラクタの値）
(define Hx_init_code ,(H cname pn base acc)
  __Cont_get__ ,(return)
  Kit_code_cat3 cname ":" "init" ,(iname)
  __Dict_lookup_or__ H iname __print_exit_error__ ,(ii)
  Kit_parse_get ii "ok" ,(ok)
  __unless__ ok (,() return acc) ,()
  Kit_code_cat3 cname ":" "fields" ,(fname)
  __Dict_lookup_or__ H fname __print_exit_error__ ,(fi)
  Kit_parse_get fi "js" ,(fjs)
  __String_concat__ acc fjs ,(acc)
  Kit_code_cat3 cname ":" "ctor" ,(cn)
  __Dict_lookup_or__ H cn (,(k) __NULL__ __NULL__) ,(ci)
  __is_null__ ci ,(noCtor)
  __if_then_else__ noCtor (,() __NULL__ acc) (,() Kit_parse_get ci "js" ,(cjs) __String_concat__ acc cjs) ,(acc)
  Kit_code_cat3 "return C_ctor_" cname ".call(o, ...a);" ,(callCtor)
  __if_then_else__ base
    (,() Kit_code_cat3 "F_" cname ".call(o); " ,(f) __if_then_else__ noCtor (,() __String_concat__ f "return null;") (,() __String_concat__ f callCtor))
    (,() __if_then_else__ noCtor
      (,() Kit_code_cat5 "I_" pn "(o, a); F_" cname ".call(o); return null;")
      (,() __NULL__ callCtor)) ,(body)
  Kit_code_cat5 acc "function I_" cname "(o, a) { " body ,(acc)
  __String_concat__ acc " }\n")

(define Hx_method_code ,(H cname ms acc table)
  __Cont_get__ ,(return)
  __is_null__ ms ,(test__) __if__ test__ (,() return acc table) ,()
  __LList_uncons__ __print_exit_error__ ms ,(key rest)
  Kit_code_cat3 cname "." key ,(full)
  Sjs_json_string key ,(kq)
  __Dict_lookup_or__ H full (,(k) __NULL__ __NULL__) ,(info)
  __is_null__ info ,(none)
  __if_then_else__ none (,() __NULL__ __FALSE__) (,() Kit_parse_get info "ok") ,(ok)
  __unless__ ok
    (,()
      Kit_code_cat5 acc "P_" cname "[" kq ,(acc)
      __String_concat__ acc "] = $nom;\n" ,(acc)
      Hx_method_code H cname rest acc table ,(a t)
      return a t) ,()
  Kit_parse_get info "js" ,(js)
  __String_concat__ acc js ,(acc)
  Kit_parse_get info "fn" ,(fn)
  __Dict_put__ fn "hostMethod" full ,()
  Sjs_json_string full ,(fq)
  Kit_code_cat5 table fq ": $runm(P_" cname ", " ,(table)
  Kit_code_cat3 table kq "), " ,(table)
  Hx_method_code H cname rest acc table)

(define Hx_funcs ,(H names acc table)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc table) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ H nm __print_exit_error__ ,(info)
  Kit_parse_get info "ok" ,(ok)
  __Dict_lookup_or__ info "method" (,(k) __NULL__ "") ,(mkey)
  __String_equal__ mkey "" ,(notMethod)
  __Dict_lookup_or__ info "kind" (,(k) __NULL__ "") ,(kind)
  __String_equal__ kind "" ,(plainFn)
  ;; 一番外の文（段階 H6a）：文の節に、名前と、読む変数と書く変数の名前を付ける（sjs_gen.se の Gen_stmt が使う）
  __String_equal__ kind "stmt" ,(isStmt)
  __and__ ok isStmt ,(test__) __if__ test__
    (,()
      Kit_parse_get info "js" ,(js)
      __String_concat__ acc js ,(acc)
      Kit_parse_get info "stmt" ,(node)
      __Dict_put__ node "hostStmt" nm ,()
      Kit_parse_get info "reads" ,(rs)
      __Dict_put__ node "hostReads" rs ,()
      Kit_parse_get info "writes" ,(ws)
      __Dict_put__ node "hostWrites" ws ,()
      Sjs_json_string nm ,(q)
      Kit_parse_get info "fname" ,(fname)
      __Dict_lookup_or__ info "waits" (,(k) __NULL__ __FALSE__) ,(w)
      __if_then_else__ w (,() __NULL__ ": $runG(") (,() __NULL__ ": $run(") ,(runner)
      Kit_code_cat5 table q runner fname "), " ,(table)
      Hx_funcs H rest acc table ,(a t) return a t) ,()
  __and__ ok notMethod ,(x) __and__ x plainFn ,(test__) __unless__ test__ (,() Hx_funcs H rest acc table ,(a t) return a t) ,()
  Kit_parse_get info "js" ,(js)
  __String_concat__ acc js ,(acc)
  Kit_parse_get info "fn" ,(fn)
  ;; 数の関数は wasm 版を使う（印を付けない）
  __Dict_lookup_or__ fn "wasm" (,(k) __NULL__ "") ,(w)
  __String_equal__ w "" ,(notWasm)
  __if_then_else__ notWasm (,() __Dict_put__ fn "host" nm) (,() __Dict_put__ fn "hostAlso" nm) ,()
  Sjs_json_string nm ,(q)
  __Dict_lookup_or__ info "waits" (,(k) __NULL__ __FALSE__) ,(w)
  __Dict_lookup_or__ info "genfn" (,(k) __NULL__ __FALSE__) ,(genfn)
  __if_then_else__ w (,() __NULL__ ": $runG(f_") (,() __NULL__ ": $run(f_") ,(runner)
  __if_then_else__ genfn (,() __NULL__ ": $runGen(f_") (,() __NULL__ runner) ,(runner)
  Kit_code_cat5 table q runner nm "), " ,(table)
  Hx_funcs H rest acc table)

;; ── 関数ごとの JavaScript ──

;; info の関数の JavaScript。ホストの関数の条件を満たさなければ偽
(define Hx_func ,(E H info)
  __Cont_get__ ,(fail)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fail" fail ,()
  __Dict_put__ cx "E" E ,()
  __Dict_put__ cx "H" H ,()
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(loops)
  __Dict_put__ cx "loops" loops ,()
  __Ref_new__ __NULL__ ,(callees)
  __Dict_put__ cx "callees" callees ,()
  ;; その場に書く読み書きの一時の変数（段階 H5b。Hx_temp）
  __Ref_new__ __NULL__ ,(temps)
  __Dict_put__ cx "temps" temps ,()
  ;; ループがあったか（段階 H5d。Hx_ops_wrap）
  __Ref_new__ __FALSE__ ,(opsUsed)
  __Dict_put__ cx "opsUsed" opsUsed ,()
  Wx_num "0" ,(zeroT)
  __Ref_new__ zeroT ,(tempN)
  __Dict_put__ cx "tempN" tempN ,()
  ;; 待つか（Hx_call が、待つ呼び出しで真にする）と、ジェネレータとして書くか（前に書いたとき待った関数。Hx_wait_loop）
  __Ref_new__ __FALSE__ ,(waitsRef)
  __Dict_put__ cx "waits" waitsRef ,()
  __Dict_put__ cx "closure" __FALSE__ ,()
  Kit_parse_get info "name" ,(name0)
  __Dict_lookup_or__ H "#waits" (,(k) __NULL__ __NULL__) ,(waits0)
  __is_null__ waits0 ,(noWaits)
  __if_then_else__ noWaits (,() __NULL__ __FALSE__) (,() __Dict_lookup_or__ waits0 name0 (,(k) __NULL__ __FALSE__)) ,(gen0)
  __Dict_lookup_or__ info "method" (,(k) __NULL__ "") ,(mkey0)
  __String_equal__ mkey0 "" ,(notMethod0)
  __and__ gen0 notMethod0 ,(gen1)
  ;; ジェネレータ関数（段階 H8）は、いつもジェネレータとして書く（本体の yield と、VM への頼みを、どちらも yield で出す）
  __Dict_lookup_or__ info "genfn" (,(k) __NULL__ __FALSE__) ,(genfn)
  __or__ gen1 genfn ,(gen)
  __Dict_put__ cx "gen" gen ,()
  ;; 局所の名前：引数と、関数の中で宣言した名前（どのブロックでも。読む所が正しいかは JavaScript の有効範囲に任せる）
  __Dict_new__ ,(locals)
  __Dict_put__ cx "locals" locals ,()
  Kit_parse_get info "params" ,(params)
  Hx_put_names locals params ,()
  Kit_parse_get info "fn" ,(fn)
  Kit_parse_get fn "body" ,(body)
  Hx_collect_locals cx body ,()
  Hx_param_list params "" ,(ps)
  __Dict_lookup_or__ info "method" (,(k) __NULL__ "") ,(mkey)
  __String_equal__ mkey "" ,(notMethod)
  __Dict_lookup_or__ info "kind" (,(k) __NULL__ "") ,(kind)
  __String_equal__ kind "ctor" ,(isCtor)
  __not__ notMethod ,(isMethod)
  __or__ isMethod isCtor ,(usesThis)
  __Dict_put__ cx "method" usesThis ,()
  __Dict_lookup_or__ info "badParams" (,(k) __NULL__ __TRUE__) ,(pok)
  __unless__ pok (,() Hx_fail cx) ,()
  Kit_parse_get body "body" ,(stmts)
  __if_then_else__ isCtor (,() Hx_ctor_body cx info stmts) (,() Hx_stmts cx stmts "") ,(code)
  Hx_temp_decl temps ,(decl)
  Hx_ops_wrap opsUsed code ,(code)
  __String_concat__ decl code ,(code)
  Kit_parse_get info "name" ,(name)
  ;; 待つのは、一番外の関数だけ（メソッドとコンストラクタは、待てばホストの関数にしない）
  __Ref_get__ waitsRef ,(waits)
  __Dict_put__ info "waits" waits ,()
  __and__ waits usesThis ,(test__) __if__ test__ (,() Hx_fail cx) ,()
  __or__ waits genfn ,(star)
