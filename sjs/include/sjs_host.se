  __Dict_put__ cx "closure" __FALSE__ ,()
  ;; 待つ文（段階 H6c）：前に書いたとき待った文は、ジェネレータとして書く（Hx_wait_loop）
  __Ref_new__ __FALSE__ ,(waitsRef)
  __Dict_put__ cx "waits" waitsRef ,()
