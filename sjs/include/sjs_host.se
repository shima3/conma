      __and__ isConsole isLog ,(test__) __if__ test__ (,() Kit_code_cat3 "$log(" ac ")" ,(c) return c) ,()
      Hx_builtin cx object "Object" ,(isObject)
      __String_equal__ name "keys" ,(isKeys)
      __and__ isObject isKeys ,(test__) __if__ test__ (,() Kit_code_cat3 "$keys(" ac ")" ,(c) return c) ,()
      Hx_methods ,(methods)
      Kit_lex_in_words name methods ,(test__)
      __unless__ test__ (,() Hx_fail cx) ,()
      Hx_expr cx object ,(oc)
      __String_equal__ ac "" ,(noArgs)
      __if_then_else__ noArgs (,() __NULL__ "") (,() __String_concat__ ", " ac) ,(rest)
      Kit_code_cat5 "$m_" name "(" oc rest ,(c)
      __String_concat__ c ")" ,(c)
      return c) ,()
  __String_equal__ ct "id" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
  Kit_parse_get callee "name" ,(nm)
