;; 文の JavaScript。if やループの本体は、いつもブロックにする（JavaScript は、本体が宣言だけの文を受け付けない）
(define Hx_body ,(cx s)
  Hx_stmt cx s ,(c)
  Kit_code_cat3 "{" c "}")

(define Hx_loop_body ,(cx s)
  __Dict_lookup_or__ cx "loops" __print_exit_error__ ,(loops)
  __Ref_get__ loops ,(n)
