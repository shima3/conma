  __String_equal__ tt "id" ,(test__) __if__ test__ (,() Kit_parse_get target "name" ,(nm) __Dict_put__ before nm isConst) ,()
  Hx_note_decls before rest isConst)

;; 一番外の文の中で、name が前に宣言した一番外の変数なら、真と g_name（write なら、書く印も付ける。const なら、ホストに書かない）
(define Hx_outer ,(cx name write)
  __Cont_get__ ,(return)
