(define Hx_declarators ,(cx ds acc)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Kit_parse_get d "target" ,(target)
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  __is_null__ init ,(noInit)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ "") (,() __NULL__ ", ") ,(sep)
  Hx_pattern_names target ,(isPat pnames)
  __if__ isPat
    (,()
      __if__ noInit (,() Hx_fail cx) ,()
      Hx_expr cx init ,(ic)
      Hx_pattern_code pnames ,(pc)
      Kit_code_cat5 acc sep pc " = $arr(" ic ,(acc)
      __String_concat__ acc ")" ,(acc)
      Hx_declarators cx rest acc ,(a)
      return a) ,()
  Kit_parse_get target "name" ,(nm)
  __if_then_else__ noInit (,() __NULL__ "") (,() Hx_expr cx init ,(ic) __String_concat__ " = " ic) ,(ic)
  Kit_code_cat5 acc sep "v_" nm ic ,(acc)
  Hx_declarators cx rest acc)

;; 式の文（; なし）：局所の変数への代入と複合の代入、++、--。ほかの式はそのまま
(define Hx_effect ,(cx e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Kit_parse_get e "expr" ,(inner) Hx_effect cx inner ,(c) return c) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "target" ,(target)
      Wx_t target ,(tt)
      __String_equal__ tt "member" ,(test__) __if__ test__ (,() Hx_member_assign cx e ,(c) return c) ,()
      Hx_local cx target ,(l)
      Kit_parse_get e "op" ,(op)
      Kit_parse_get e "value" ,(value)
      Hx_expr cx value ,(vc)
      __String_equal__ op "=" ,(test__) __if__ test__ (,() Kit_code_cat3 l " = " vc ,(c) return c) ,()
      Kit_lex_in_words op "+= -= *= /= %=" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
      __String_length__ op ,(len)
      Wx_num "1" ,(one)
      __Number_subtract__ len one ,(m)
      Wx_num "0" ,(zero)
      __String_substring__ __print_exit_error__ op zero m ,(bop)
      Hx_op_call cx bop l vc e ,(oc)
      Kit_code_cat3 l " = " oc ,(c)
      return c) ,()
  __String_equal__ t "update" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "target" ,(target)
      Wx_t target ,(tt)
      __String_equal__ tt "member" ,(test__) __if__ test__ (,() Hx_member_assign cx e ,(c) return c) ,()
      Hx_local cx target ,(l)
      Kit_parse_get e "op" ,(op)
      __String_equal__ op "++" ,(inc)
      __if_then_else__ inc (,() __NULL__ "1") (,() __NULL__ "-1") ,(d)
      Hx_pos cx e ,(p)
      Kit_code_cat5 l " = $step(" l ", " d ,(c)
      Kit_code_cat3 c ", " p ,(c)
      __String_concat__ c ")" ,(c)
      return c) ,()
  Hx_expr cx e)

;; メンバーか要素への代入（assign か update の節 e）。複合の代入と ++、-- は、オブジェクトと添字が名前かリテラルのときだけ
;; （2 度読むので）。$put が、オブジェクトのメンバーと、配列の要素（長さまで）を確かめて書く
(define Hx_member_assign ,(cx e)
  __Cont_get__ ,(return)
  Kit_parse_get e "target" ,(target)
  __Dict_lookup_or__ target "optional" (,(k) __NULL__ __FALSE__) ,(opt)
  __if__ opt (,() Hx_fail cx) ,()
  Kit_parse_get target "object" ,(object)
  Hx_expr cx object ,(oc)
  Hx_key cx target ,(kc)
  __Dict_lookup_or__ target "key" (,(k) __NULL__ __NULL__) ,(key0)
  __is_null__ key0 ,(named0)
  __if_then_else__ named0 (,() __NULL__ "$putn(" "$getn(") (,() __NULL__ "$put(" "$get(") ,(putf getf)
  Hx_pos cx target ,(p)
  Kit_code_cat3 ", " p ")" ,(pend)
  Wx_t e ,(t)
  __String_equal__ t "update" ,(isUpdate)
  __if_then_else__ isUpdate (,() __NULL__ "update") (,() Kit_parse_get e "op") ,(op)
  __Dict_lookup_or__ target "name" (,(k) __NULL__ "") ,(tname)
  __String_equal__ op "=" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "value" ,(value) Hx_expr cx value ,(vc)
      __if__ named0 (,() Hx_write_named cx oc tname vc p ,(c) return c) ,()
      Hx_write_index cx oc kc vc p ,(c) return c) ,()
  ;; 複合の代入と ++、--：オブジェクトと添字は、名前かリテラル
  Hx_simple object ,(so)
  __Dict_lookup_or__ target "key" (,(k) __NULL__ __NULL__) ,(key)
  __is_null__ key ,(named)
  __if_then_else__ named (,() __NULL__ __TRUE__) (,() Hx_simple key) ,(sk)
  __and__ so sk ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
  __if_then_else__ named0 (,() Hx_read_named cx oc tname p) (,() Hx_read_index cx oc kc p) ,(cur)
  __if_then_else__ isUpdate
    (,()
      Kit_parse_get e "op" ,(uop)
      __String_equal__ uop "++" ,(inc)
      __if_then_else__ inc (,() __NULL__ "1") (,() __NULL__ "-1") ,(d)
      Kit_code_cat5 "$step(" cur ", " d pend)
    (,()
      Kit_lex_in_words op "+= -= *= /= %=" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
      __String_length__ op ,(len)
      Wx_num "1" ,(one)
      __Number_subtract__ len one ,(m)
      Wx_num "0" ,(zero)
      __String_substring__ __print_exit_error__ op zero m ,(bop)
      Kit_parse_get e "value" ,(value)
      Hx_expr cx value ,(vc)
      Hx_op_call cx bop cur vc e) ,(nv)
  __if__ named0 (,() Hx_write_named cx oc tname nv p ,(c) return c) ,()
  Hx_write_index cx oc kc nv p)

;; ── その場に書く読み書き（段階 H5b）──
;; 共通の補助の関数（$getn など）は名前を変数で受けるので、エンジンが名前ごとの速い読み方を使えない。名前の決まったメンバーの
;; 読み書きとメソッドの呼び出しは、ホストのオブジェクト（$K が真）の自分のプロパティなら、その場で読み書きし、ほかは補助の関数に
;; 任せる（意味は同じ）。値は一時の変数（関数と関数式ごと。Hx_temp）に置き、式を 2 度動かさない

;; 新しい一時の変数の名前。一時の変数を持たない所（フィールドの関数）なら偽
(define Hx_temp ,(cx)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ cx "temps" (,(k) return __FALSE__ "") ,(temps)
  __is_null__ temps ,(test__) __if__ test__ (,() return __FALSE__ "") ,()
  __Dict_lookup_or__ cx "tempN" (,(k) return __FALSE__ "") ,(tempN)
  __Ref_get__ tempN ,(n)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ tempN n ,()
  Wx_str n ,(ns)
  __String_concat__ "$t" ns ,(name)
  __Ref_get__ temps ,(l)
  __LList_cons__ name l ,(l)
  __Ref_set__ temps l ,()
  __NULL__ __TRUE__ name)

;; 一時の変数の宣言（なければ ""）
(define Hx_temp_decl ,(temps)
  __Cont_get__ ,(return)
  __Ref_get__ temps ,(l)
  __is_null__ l ,(test__) __if__ test__ (,() return "") ,()
  Hx_join_names l "" ,(names)
  Kit_code_cat3 "let " names "; ")

(define Hx_join_names ,(l acc)
  __Cont_get__ ,(return)
  __is_null__ l ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ l ,(h t)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ h) (,() Kit_code_cat3 acc ", " h) ,(acc)
  Hx_join_names t acc)

;; その場に書いてよい名前か（__proto__ は、プロトタイプを読み書きするので、補助の関数で）
(define Hx_inline_name ,(name)
  __String_equal__ name "__proto__" ,(proto)
  __not__ proto)

;; o.name を読む：ホストのオブジェクトの、関数でも undefined でもない値ならその場で、ほかは $getn
(define Hx_read_named ,(cx oc name p)
  __Cont_get__ ,(return)
  Sjs_json_string name ,(q)
  Hx_inline_name name ,(inl)
  Hx_temp cx ,(ok1 t)
  Hx_temp cx ,(ok2 v)
  __and__ ok1 ok2 ,(x) __and__ x inl ,(test__)
  __unless__ test__ (,() Kit_code_cat5 "$getn(" oc ", " q ", " ,(c) Kit_code_cat3 c p ")" ,(c) return c) ,()
  Kit_code_cat4 "((" t " = " oc ,(c)
  Kit_code_cat4 c ") != null && " t "[$K] === true && (" ,(c)
  Kit_code_cat5 c v " = " t "." ,(c)
  Kit_code_cat4 c name ") !== undefined && typeof " v ,(c)
  Kit_code_cat4 c " !== 'function' ? " v " : $getn(" ,(c)
  Kit_code_cat5 c t ", " q ", " ,(c)
  Kit_code_cat3 c p "))")

;; o.name = vc：ホストのオブジェクトならその場で、ほかは $putn（vc は、どちらか一方でだけ動く）
(define Hx_write_named ,(cx oc name vc p)
  __Cont_get__ ,(return)
  Sjs_json_string name ,(q)
  Hx_inline_name name ,(inl)
  Hx_temp cx ,(ok t)
  __and__ ok inl ,(test__)
  __unless__ test__ (,() Kit_code_cat5 "$putn(" oc ", " q ", " ,(c) Kit_code_cat5 c vc ", " p ")" ,(c) return c) ,()
  Kit_code_cat4 "((" t " = " oc ,(c)
  Kit_code_cat4 c ") != null && " t "[$K] === true ? (" ,(c)
  Kit_code_cat5 c t "." name " = " ,(c)
  Kit_code_cat5 c vc ") : $putn(" t ", " ,(c)
  Kit_code_cat5 c q ", " vc ", " ,(c)
  Kit_code_cat3 c p "))")

;; o.name(args)（rest は ", 引数" か ""）：ホストのオブジェクトのメソッドか関数のプロパティならその場で呼び、ほかは $mcall。
;; 偽なら、その場に書かない（Hx_call が $mc か $mcall で）
(define Hx_call_named ,(cx oc name p rest)
  __Cont_get__ ,(return)
  Sjs_json_string name ,(q)
  Hx_inline_name name ,(inl)
  Hx_temp cx ,(ok1 t)
  Hx_temp cx ,(ok2 v)
  __and__ ok1 ok2 ,(x) __and__ x inl ,(test__)
  __unless__ test__ (,() return __FALSE__ "") ,()
  Kit_code_cat4 "((" t " = " oc ,(c)
  Kit_code_cat4 c ") != null && " t "[$K] === true && typeof (" ,(c)
  Kit_code_cat5 c v " = " t "." ,(c)
  Kit_code_cat4 c name ") === 'function' && " v ,(c)
  Kit_code_cat4 c " !== $nom ? " v ".call(" ,(c)
  Kit_code_cat4 c t rest ") : $mcall(" ,(c)
  Kit_code_cat5 c t ", " q ", " ,(c)
  Kit_code_cat4 c p rest "))" ,(c)
  __NULL__ __TRUE__ c)

;; 配列の要素（段階 H5c）：配列と、長さより小さい整数の添字ならその場で、ほかは $idx（$get）。配列と添字を先に一時の変数に置く
;; （確かめに通らなくても、JavaScript と同じ順に 1 度だけ動く）
(define Hx_read_index ,(cx oc kc p)
  __Cont_get__ ,(return)
  Hx_temp cx ,(ok1 t)
  Hx_temp cx ,(ok2 u)
  __and__ ok1 ok2 ,(test__)
  __unless__ test__ (,() Kit_code_cat5 "$idx(" oc ", " kc ", " ,(c) Kit_code_cat3 c p ")" ,(c) return c) ,()
  Kit_code_cat4 "((" t " = " oc ,(c)
  Kit_code_cat4 c "), (" u " = " ,(c)
  Kit_code_cat4 c kc "), Array.isArray(" t ,(c)
  Kit_code_cat4 c ") && typeof " u " === 'number' && (" ,(c)
  Kit_code_cat4 c u " >>> 0) === " u ,(c)
  Kit_code_cat5 c " && " u " < " t ,(c)
  Kit_code_cat4 c ".length ? " t "[" ,(c)
  Kit_code_cat5 c u "] : $idx(" t ", " ,(c)
  Kit_code_cat5 c u ", " p "))")

;; 配列の要素に書く：配列と、長さまでの整数の添字ならその場で（長さのときは足す）、ほかは $put。値 vc は、どちらか一方でだけ動く
(define Hx_write_index ,(cx oc kc vc p)
  __Cont_get__ ,(return)
  Hx_temp cx ,(ok1 t)
  Hx_temp cx ,(ok2 u)
  __and__ ok1 ok2 ,(test__)
  __unless__ test__ (,() Kit_code_cat5 "$put(" oc ", " kc ", " ,(c) Kit_code_cat5 c vc ", " p ")" ,(c) return c) ,()
  Kit_code_cat4 "((" t " = " oc ,(c)
  Kit_code_cat4 c "), (" u " = " ,(c)
  Kit_code_cat4 c kc "), Array.isArray(" t ,(c)
  Kit_code_cat4 c ") && typeof " u " === 'number' && (" ,(c)
  Kit_code_cat4 c u " >>> 0) === " u ,(c)
  Kit_code_cat5 c " && " u " <= " t ,(c)
  Kit_code_cat4 c ".length ? (" t "[" ,(c)
  Kit_code_cat4 c u "] = " vc ,(c)
  Kit_code_cat4 c ") : $put(" t ", " ,(c)
  Kit_code_cat5 c u ", " vc ", " ,(c)
  Kit_code_cat3 c p "))")

;; o.length：配列ならその場で、ほかは $len（文字列は文字の数）
(define Hx_length ,(cx oc p)
  __Cont_get__ ,(return)
  Hx_temp cx ,(ok t)
  __unless__ ok (,() Kit_code_cat5 "$len(" oc ", " p ")" ,(c) return c) ,()
  Kit_code_cat4 "(Array.isArray(" t " = " oc ,(c)
  Kit_code_cat5 c ") ? " t ".length : $len(" t ,(c)
  Kit_code_cat4 c ", " p "))")

;; 一番外の文の中（関数式の中でない）の for...of なら、文が待つ印を付ける（Hx_wait。次に書くとき、ジェネレータになる）
(define Hx_stmt_forof_waits ,(cx)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ cx "outer" (,(k) return) ,(outer)
  __Dict_lookup_or__ cx "closure" (,(k) __NULL__ __FALSE__) ,(inClosure)
  __if__ inClosure return ,()
  Hx_wait cx)

;; ジェネレータの中の for...of：{ $t = yield* $iterG(右辺, 位置); try { while (yield* $moreG($t)) { kind 名前 = yield* $takeG($t);
;; 本体 } } finally { yield* $closeG($t); } }。ホストの配列と文字列は、ホストで 1 つずつ（頼みなし）、VM の値は、ConMa 版の for...of
;; と同じ手順（Sjs_iter_open、more、take、close）を頼みで（待ってよい）。途中で抜ければ閉じる
(define Hx_forof_gen ,(cx s kind target isPat pnames rc bc)
  __Cont_get__ ,(return)
  Hx_temp cx ,(ok t)
  __unless__ ok (,() Hx_fail cx) ,()
  Hx_pos cx s ,(p)
  __if_then_else__ isPat
    (,() Hx_pattern_code pnames ,(pc) Kit_code_cat4 pc " = $arr(yield* $takeG(" t ")); ")
    (,() Kit_parse_get target "name" ,(nm) Kit_code_cat4 "v_" nm " = yield* $takeG(" t ,(x) __String_concat__ x "); ") ,(bind)
  Kit_code_cat5 "{" t " = yield* $iterG(" rc ", " ,(c)
  Kit_code_cat4 c p "); try { while (yield* $moreG(" t ,(c)
  Kit_code_cat5 c ")) { " kind " " bind ,(c)
  Kit_code_cat4 c bc " } } finally { yield* $closeG(" t ,(c)
  __String_concat__ c "); } }")

;; 名前かリテラル（2 度読んでよい式）か
(define Hx_simple ,(e)
  Wx_t e ,(t)
  Kit_lex_in_words t "id num str this")

;; 名前の配列の分割代入（[a, b]。穴、既定値、残りのないもの）なら、真と名前の LList（書いた順）
(define Hx_pattern_names ,(pat)
  __Cont_get__ ,(return)
  Wx_t pat ,(t)
  __String_equal__ t "arrayPattern" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Kit_parse_get pat "items" ,(items)
  Hx_pattern_items items __NULL__)

(define Hx_pattern_items ,(items acc)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() Wx_reverse acc __NULL__ ,(l) return __TRUE__ l) ,()
  __LList_uncons__ __print_exit_error__ items ,(x rest)
  __is_null__ x ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  Wx_t x ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Kit_parse_get x "name" ,(nm)
  __LList_cons__ nm acc ,(acc)
  Hx_pattern_items rest acc)

;; 名前の配列の分割代入の JavaScript（[v_a, v_b]）
(define Hx_pattern_code ,(names)
  Hx_param_list names "" ,(ps)
  Kit_code_cat3 "[" ps "]")

;; メンバーの節の名前（.名前 なら文字列のリテラル）か、要素の添字の式
(define Hx_key ,(cx m)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ m "key" (,(k) __NULL__ __NULL__) ,(key)
  __is_null__ key ,(test__) __unless__ test__ (,() Hx_expr cx key ,(c) return c) ,()
  Kit_parse_get m "name" ,(name)
  Sjs_json_string name)

;; 代入の先：局所の変数（引数も）の名前だけ
(define Hx_local ,(cx target)
  __Cont_get__ ,(return)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
  Kit_parse_get target "name" ,(nm)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __FALSE__) ,(isLocal)
  __if__ isLocal (,() __String_concat__ "v_" nm ,(c) return c) ,()
  Hx_outer cx nm __TRUE__ ,(isOuter oc)
  __unless__ isOuter (,() Hx_fail cx) ,()
  __NULL__ oc)

;; ── 式 ──

(define Hx_expr ,(cx e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "text" ,(text)
      ;; 数の字句を ConMa と同じ値にする（BigInt の n などは、ここで外れる）
      __Number_fromString__ (,(msg) Hx_fail cx) text ,(v)
      Hx_number cx v ,(c)
      return c) ,()
  __String_equal__ t "str" ,(test__) __if__ test__ (,() Kit_parse_get e "value" ,(v) Sjs_json_string v ,(c) return c) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "text" ,(text)
      Kit_lex_in_words text "true false null" ,(test__) __unless__ test__ (,() Hx_fail cx) ,()
      return text) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__
    (,() Kit_parse_get e "expr" ,(inner) Hx_expr cx inner ,(c) Kit_code_cat3 "(" c ")" ,(c) return c) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Hx_id cx e ,(c) return c) ,()
  __String_equal__ t "template" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "parts" ,(parts)
      Kit_parse_get e "exprs" ,(exprs)
      Hx_template cx parts exprs "(" ,(c)
      __String_concat__ c ")" ,(c)
      return c) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Hx_binary cx e ,(c) return c) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "op" ,(op)
      Kit_parse_get e "arg" ,(arg)
      Hx_expr cx arg ,(ac)
      __String_equal__ op "!" ,(test__) __if__ test__ (,() Kit_code_cat3 "(!" ac ")" ,(c) return c) ,()
      Hx_pos cx e ,(p)
      __String_equal__ op "-" ,(test__) __if__ test__ (,() Kit_code_cat5 "$neg(" ac ", " p ")" ,(c) return c) ,()
      __String_equal__ op "+" ,(test__) __if__ test__ (,() Kit_code_cat5 "$pos(" ac ", " p ")" ,(c) return c) ,()
      ;; typeof（段階 H5e）：ホストの値はその場で、VM の値は VM で
      __String_equal__ op "typeof" ,(test__) __if__ test__ (,() Kit_code_cat5 "$typeof(" ac ", " p ")" ,(c) return c) ,()
      Hx_fail cx) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "test" ,(test)
      Hx_expr cx test ,(tc)
      Kit_parse_get e "yes" ,(yes)
      Hx_expr cx yes ,(yc)
      Kit_parse_get e "no" ,(no)
      Hx_expr cx no ,(nc)
      Kit_code_cat5 "(" tc " ? " yc " : " ,(c)
      Kit_code_cat3 c nc ")" ,(c)
      return c) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Hx_call cx e ,(c) return c) ,()
  ;; yield と yield*（ジェネレータ関数の本体。段階 H8）：yield は値を $Give に包んで出し、答えを $Gr で受ける。関数を出すことは
  ;; しない（VM に渡せないので、値を出した後なら止まる）
  __String_equal__ t "yield" ,(test__) __if__ test__
    (,()
      Hx_genmode cx ,(gm)
      __unless__ gm (,() Hx_fail cx) ,()
      Hx_pos cx e ,(p)
      __Dict_lookup_or__ e "delegate" (,(k) __NULL__ __FALSE__) ,(delegate)
      __Dict_lookup_or__ e "arg" (,(k) __NULL__ __NULL__) ,(arg)
      __is_null__ arg ,(noArg)
      __if_then_else__ noArg (,() __NULL__ "") (,() Wx_t arg) ,(at)
      Kit_lex_in_words at "function arrow" ,(test__) __if__ test__ (,() Hx_fail cx) ,()
