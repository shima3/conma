  Sjs_json_string p ,(pc)
  __String_concat__ acc pc ,(acc)
  __is_null__ exprs ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ exprs ,(x xs)
  Hx_expr cx x ,(xc)
  Kit_code_cat4 acc " + $S(" xc ") + " ,(acc)
  Hx_template cx rest xs acc)

(define Hx_id ,(cx e)
  __Cont_get__ ,(return)
  Kit_parse_get e "name" ,(nm)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ (,() __String_concat__ "v_" nm ,(c) return c) ,()
  ;; NaN、Infinity、undefined：一番外で宣言されず、代入されないもの
