;; 端末の入力（docs/dev/PLATFORM-PLAN-ja.md の 4.7 節、段階 P6a）：ホストに機能 "input" がないとき、ConJS の nextEvent と
;; pollEvent（conjs_lib.se）は、標準入力からキーを読む。VM は変えず、今のプリミティブだけで書く。
;;
;; 列を受け持つ VProc（Conjs_term_owner）だけが、キーの列、待ちの列、持ち越した ESC の並びを読み書きする（ConMa の
;; スケジューラは、どの 2 つのステップの間でも VProc を切り替え、Ref をまとめて書き換えるプリミティブはないため）。
;; ほかの VProc は、受け持つ VProc のチャネルに、知らせ（LList）を送る：
;;   ("wait" task w ms)   nextEvent（ConJS の処理の VProc）：キーを、スケジューラの Kit_sched_put で、処理 task に渡す
;;   ("poll" w)           pollEvent：キーか null を、チャネルの書き手 w に書く
;;   ("data" text)        読み手（Conjs_term_reader）：読んだ文字列のまま
;;   ("end")              読み手：標準入力の終わり
;;   ("timeout" id)       時間切れの VProc：待ち id の時間が来た（待ちがもう終わっていれば、何もしない）
;;   ("esc" id)           時間切れの VProc：持ち越した ESC の並び id の 40 ミリ秒が来た
;; 待ちが受け取る結果は、(真 キーの名前)、(真 null)（時間切れ）、(偽 メッセージ)（標準入力の終わり）。
;; 受け持つ VProc と読み手は、スケジューラの "pending" に数えない。プログラムの終わり（Conjs_term_cleanup）に、端末の
;; モードを戻してから、ライブラリが始めた VProc を止める。
;;
;; 状態 T（main の VProc の PDict の "conjs_term"）は Dict："w"（main の VProc が知らせを送る書き手）、"saved"（stty -g が
;; 出した前の設定。端末でなければ null）、"owner" "reader" "sigint"（VProc か null）、"timers"（時間切れの VProc の
;; LList の Ref。受け持つ VProc が足し、外す）、"done"（片付けたかの Ref）

(define Conjs_term_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

;; 端末の道を使う状態（初めて呼んだときに始める）
(define Conjs_term ,()
  __Cont_get__ ,(return)
  __PDict_lookup_or__ "conjs_term" (,(k) __NULL__ __NULL__) ,(T)
  __is_null__ T ,(test__) __unless__ test__ (,() return T) ,()
  __Dict_new__ ,(T)
  __Ref_new__ __NULL__ ,(timers)
  __Dict_put__ T "timers" timers ,()
  __Ref_new__ __FALSE__ ,(done)
  __Dict_put__ T "done" done ,()
  Conjs_term_raw ,(saved)
  __Dict_put__ T "saved" saved ,()
  Conjs_term_num "1" ,(one)
  __Chan_new__ one __NULL__ ,(chan)
  __Chan_writer__ chan ,(w)
  __Dict_put__ T "w" w ,()
  __Chan_writer__ chan ,(rw)
  __Chan_reader__ chan ,(r)
  __PDict_put__ "conjs_term" T ,()
  __PDict_put__ "sjs_cleanup" (,() Conjs_term_cleanup T) ,()
  __VProc_start__ (,() Conjs_term_owner T chan r) ,(owner)
  __Dict_put__ T "owner" owner ,()
  __OS_get_stdin__ ,(stdin)
  __Dict_put__ T "stdin" stdin ,()
  __VProc_start__ (,() Conjs_term_reader stdin rw) ,(reader)
  __Dict_put__ T "reader" reader ,()
  ;; 端末なら Ctrl-C を受け取り、モードを戻してから終了ステータス 130 で終える（-icanon だけなので、SIGINT のまま届く）
  __is_null__ saved ,(notTty)
  __if_then_else__ notTty (,() __NULL__ __NULL__)
    (,()
      Conjs_term_num "0" ,(zero)
      __Ref_new__ zero ,(count)
      __OS_trap_interrupt__ count ,()
      __VProc_start__ (,() __Ref_wait_change__ count zero ,() Conjs_term_interrupted T)) ,(sigint)
  __Dict_put__ T "sigint" sigint ,()
  __NULL__ T)

;; Ctrl-C：端末のモードを戻して終える（Conjs_term_cleanup は、この VProc も止めるので使わない。終えれば、ほかの VProc も
;; 止まる）
(define Conjs_term_interrupted ,(T)
  __Dict_lookup_or__ T "done" __print_exit_error__ ,(done)
  __Ref_set__ done __TRUE__ ,()
  Conjs_term_restore T ,()
  Conjs_term_num "130" ,(code)
  __OS_exit__ __print_exit_error__ code)

;; 覚えた設定に戻す。wasm 版の VM（Node.js。機能 "js"）では、stty を始めるだけで、終わるのを待たない：Node.js は、標準入力の
;; 読みをスレッドで待ったままなので、設定を戻した stty が終わらず、待つと VM も終わらない（2026-11-21 に見つけた）
(define Conjs_term_restore ,(T)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ T "saved" __print_exit_error__ ,(saved)
  __is_null__ saved ,(test__) __if__ test__ return ,()
  __LList_cons__ saved __NULL__ ,(args)
  __Feature_available__ "js" ,(node)
  __unless__ node (,() Conjs_term_stty args ,(r) return) ,()
  __MSeq_new__ ,(argv)
  Conjs_term_add_args argv "stty" args ,()
  __OS_get_envDict__ ,(env)
  __OS_spawn__ (,(msg) return) argv __NULL__ __NULL__ __NULL__ env ,(proc)
  __nop__)

;; stty を、標準入力を受け継いで動かす：成功したら、出したもの。失敗したら（端末でない、stty がない、ブラウザ）null
(define Conjs_term_stty ,(args)
  __Cont_get__ ,(ret)
  __NULL__ (,(msg) ret __NULL__) ,(fail)
  __MSeq_new__ ,(argv)
  Conjs_term_add_args argv "stty" args ,()
  __OS_pipe__ ,(outR outW)
  __OS_pipe__ ,(errR errW)
  __OS_get_envDict__ ,(env)
  __OS_spawn__ (,(msg) __OS_close__ fail outW ,() __OS_close__ fail errW ,() fail msg) argv __NULL__ outW errW env ,(proc)
  __OS_close__ fail outW ,()
  __OS_close__ fail errW ,()
  Conjs_read_all fail outR "" ,(text)
  Conjs_read_all fail errR "" ,(err)
  __OS_close__ fail outR ,()
  __OS_close__ fail errR ,()
  __OS_wait__ fail proc ,(exit)
  __Number_is_zero__ exit ,(ok)
  __unless__ ok (,() ret __NULL__) ,()
  __NULL__ text)

;; MSeq argv に、first と LList args の文字列を足す
(define Conjs_term_add_args ,(argv first args)
  __Cont_get__ ,(return)
  __MSeq_append__ __print_exit_error__ argv first ,()
  __is_null__ args ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ args ,(x rest)
  Conjs_term_add_args argv x rest)

;; 端末なら、前の設定を覚えて、1 文字ずつ読み、打った文字を出さないモードにする。覚えた設定（端末でなければ null）
(define Conjs_term_raw ,()
  __Cont_get__ ,(return)
  __LList_cons__ "-g" __NULL__ ,(args)
  Conjs_term_stty args ,(saved)
  __is_null__ saved ,(test__) __if__ test__ (,() return __NULL__) ,()
  Conjs_term_num "0" ,(zero)
  __String_find_any__ __print_exit_error__ saved "\n" zero ,(at)
  __is_null__ at ,(noNl)
  __String_length__ saved ,(n)
  __if_then_else__ noNl (,() __NULL__ n) (,() __NULL__ at) ,(end)
  __String_substring__ __print_exit_error__ saved zero end ,(saved)
  __LList_cons__ "-echo" __NULL__ ,(args)
  __LList_cons__ "-icanon" args ,(args)
  Conjs_term_stty args ,(r)
  __NULL__ saved)

;; 片付け（何度呼んでもよい）：端末のモードを戻してから、受け持つ VProc、時間切れの VProc、読み手、Ctrl-C を待つ
;; VProc を止める（今の VProc は、最後に止まる）
(define Conjs_term_cleanup ,(T)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ T "done" __print_exit_error__ ,(done)
  __Ref_get__ done ,(was)
  __if__ was return ,()
  __Ref_set__ done __TRUE__ ,()
  Conjs_term_restore T ,()
  __Dict_lookup_or__ T "owner" __print_exit_error__ ,(owner)
  __VProc_kill__ owner ,()
  __Dict_lookup_or__ T "timers" __print_exit_error__ ,(timers)
  __Ref_get__ timers ,(list)
  Conjs_term_kill_all list ,()
  ;; 読み手は、標準入力を閉じて起こしてから止める（wasm 版の VM は、標準入力を待つ VProc を止めただけでは、まだ待っている
  ;; ものとして数え、終わらない）
  __Dict_lookup_or__ T "stdin" __print_exit_error__ ,(stdin)
  __OS_close__ (,(msg) __nop__) stdin ,()
  __Dict_lookup_or__ T "reader" __print_exit_error__ ,(reader)
  __VProc_kill__ reader ,()
  __Dict_lookup_or__ T "sigint" __print_exit_error__ ,(sigint)
  __is_null__ sigint ,(test__) __unless__ test__ (,() __VProc_kill__ sigint) ,()
  __nop__)

;; (id VProc) の LList の VProc を、すべて止める
(define Conjs_term_kill_all ,(list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(id more)
  __LList_uncons__ __print_exit_error__ more ,(vp more)
  __VProc_kill__ vp ,()
  Conjs_term_kill_all rest)

;; 読み手：読めた分を ("data" 文字列) で、終わりなら ("end") で送る
(define Conjs_term_reader ,(stdin w)
  __Cont_get__ ,(exit)
  __NULL__ (,(msg) __LList_cons__ "end" __NULL__ ,(m) __Chan_put__ (,() __nop__) w m ,() __Chan_close__ w ,() exit) ,(fail)
  __OS_wait_readable__ fail stdin ,()
  __OS_read__ fail stdin ,(data)
  __is_null__ data ,(test__) __if__ test__ (,() fail "end") ,()
  __String_equal__ data "" ,(test__) __unless__ test__
    (,() __LList_cons__ data __NULL__ ,(m) __LList_cons__ "data" m ,(m) __Chan_put__ (,() __nop__) w m) ,()
  Conjs_term_reader stdin w)

;; ── 受け持つ VProc ──
;; 状態 O は Dict（どれも Ref）："keys"（キーの名前の LList。古い順）、"waits"（(id task w) の LList。古い順）、"carry"
;; （持ち越した ESC の並び）、"esc"（その時間切れの番号）、"ended"、"ids"（番号を数える）

(define Conjs_term_owner ,(T chan r)
  __Dict_new__ ,(O)
  Conjs_term_num "0" ,(zero)
  __Ref_new__ __NULL__ ,(keys)
  __Dict_put__ O "keys" keys ,()
  __Ref_new__ __NULL__ ,(waits)
  __Dict_put__ O "waits" waits ,()
  __Ref_new__ "" ,(carry)
  __Dict_put__ O "carry" carry ,()
  __Ref_new__ zero ,(esc)
  __Dict_put__ O "esc" esc ,()
  __Ref_new__ __FALSE__ ,(ended)
  __Dict_put__ O "ended" ended ,()
  __Ref_new__ zero ,(ids)
  __Dict_put__ O "ids" ids ,()
  __Dict_put__ O "chan" chan ,()
  __Dict_lookup_or__ T "timers" __print_exit_error__ ,(timers)
  __Dict_put__ O "timers" timers ,()
  Conjs_term_loop O r)

(define Conjs_term_loop ,(O r)
  __Chan_take__ r ,(m found)
  __if__ found (,() Conjs_term_handle O m) ,()
  Conjs_term_loop O r)

(define Conjs_term_get ,(O key)
  __Dict_lookup_or__ O key __print_exit_error__ ,(ref)
  __Ref_get__ ref)

(define Conjs_term_set ,(O key v)
  __Dict_lookup_or__ O key __print_exit_error__ ,(ref)
  __Ref_set__ ref v)

(define Conjs_term_handle ,(O m)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ m ,(kind rest)
  __String_equal__ kind "wait" ,(test__) __if__ test__ (,() Conjs_term_on_wait O rest ,() return) ,()
  __String_equal__ kind "poll" ,(test__) __if__ test__
    (,()
      __LList_uncons__ __print_exit_error__ rest ,(w more)
      Conjs_term_pop O ,(key)
      __Chan_put__ (,() __nop__) w key ,()
      __Chan_close__ w ,()
      return) ,()
  __String_equal__ kind "data" ,(test__) __if__ test__
    (,()
      __LList_uncons__ __print_exit_error__ rest ,(text more)
      Conjs_term_get O "carry" ,(carry)
      __String_concat__ carry text ,(text)
      Conjs_term_keys text __FALSE__ ,(names left)
      Conjs_term_set O "carry" left ,()
      Conjs_term_deliver_all O names ,()
      __String_equal__ left "" ,(none)
      __unless__ none (,() Conjs_term_esc_timer O) ,()
      return) ,()
  __String_equal__ kind "end" ,(test__) __if__ test__ (,() Conjs_term_on_end O ,() return) ,()
  __String_equal__ kind "timeout" ,(test__) __if__ test__
    (,()
      __LList_uncons__ __print_exit_error__ rest ,(id more)
      Conjs_term_take_wait O id ,(item)
      __is_null__ item ,(test__) __if__ test__ return ,()
      __LList_uncons__ __print_exit_error__ item ,(i more)
      __LList_uncons__ __print_exit_error__ more ,(task more)
      __LList_uncons__ __print_exit_error__ more ,(w more)
      Conjs_term_untimer O id ,()
      Kit_sched_put w task __TRUE__ __NULL__ ,()
      return) ,()
  __String_equal__ kind "esc" ,(test__) __if__ test__
    (,()
      __LList_uncons__ __print_exit_error__ rest ,(id more)
      Conjs_term_untimer O id ,()
      Conjs_term_get O "esc" ,(cur)
      __Number_subtract__ cur id ,(d)
      __Number_is_zero__ d ,(same)
      __unless__ same return ,()
      Conjs_term_flush O ,()
      return) ,()
  __nop__)

;; ("wait" task w ms)
(define Conjs_term_on_wait ,(O rest)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ rest ,(task more)
  __LList_uncons__ __print_exit_error__ more ,(w more)
  __LList_uncons__ __print_exit_error__ more ,(ms more)
  Conjs_term_pop O ,(key)
  __is_null__ key ,(test__) __unless__ test__ (,() Kit_sched_put w task __TRUE__ key ,() return) ,()
  Conjs_term_get O "ended" ,(ended)
  __if__ ended (,() Kit_sched_put w task __FALSE__ "nextEvent: the input has ended" ,() return) ,()
  __Number_is_zero__ ms ,(test__) __if__ test__ (,() Kit_sched_put w task __TRUE__ __NULL__ ,() return) ,()
  Conjs_term_new_id O ,(id)
  __LList_cons__ w __NULL__ ,(item)
  __LList_cons__ task item ,(item)
  __LList_cons__ id item ,(item)
  Conjs_term_get O "waits" ,(waits)
  __LList_cons__ item __NULL__ ,(one)
  Conjs_term_append waits one ,(waits)
  Conjs_term_set O "waits" waits ,()
  __Number_is_negative__ ms ,(forever)
  __unless__ forever (,() Conjs_term_timer O "timeout" id ms) ,()
  __nop__)

(define Conjs_term_new_id ,(O)
  Conjs_term_get O "ids" ,(n)
  Conjs_term_num "1" ,(one)
  __Number_add__ n one ,(n)
  Conjs_term_set O "ids" n ,()
  __NULL__ n)

;; ms ミリ秒の後に (kind id) を送る、時間切れの VProc を始め、(id VProc) を "timers" に足す
(define Conjs_term_timer ,(O kind id ms)
  __Dict_lookup_or__ O "chan" __print_exit_error__ ,(chan)
  __Chan_writer__ chan ,(w)
  __VProc_start__ (,() Conjs_term_sleeper w kind id ms) ,(vp)
  __LList_cons__ vp __NULL__ ,(pair)
  __LList_cons__ id pair ,(pair)
  Conjs_term_get O "timers" ,(timers)
  __LList_cons__ pair timers ,(timers)
  Conjs_term_set O "timers" timers)

(define Conjs_term_sleeper ,(w kind id ms)
  __Cont_get__ ,(exit)
  __NULL__ (,(msg) __Chan_close__ w ,() exit) ,(fail)
  __LList_cons__ ms __NULL__ ,(args)
  __Host_start__ fail "time.sleep" args ,(s)
  __OS_wait_readable__ fail s ,()
  __Host_result__ fail s ,(v)
  __LList_cons__ id __NULL__ ,(m)
  __LList_cons__ kind m ,(m)
  __Chan_put__ (,() __nop__) w m ,()
  __Chan_close__ w)

;; 時間切れの VProc id を止めて（もう終わっていれば何もしない）、"timers" から外す
(define Conjs_term_untimer ,(O id)
  Conjs_term_get O "timers" ,(timers)
  Conjs_term_remove_timer timers id __NULL__ ,(timers)
  Conjs_term_set O "timers" timers)

(define Conjs_term_remove_timer ,(list id acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(i more)
  __LList_uncons__ __print_exit_error__ more ,(vp more)
  __Number_subtract__ i id ,(d)
  __Number_is_zero__ d ,(same)
  __unless__ same (,() __LList_cons__ pair acc ,(acc) Conjs_term_remove_timer rest id acc ,(l) return l) ,()
  __VProc_kill__ vp ,()
  Conjs_term_append acc rest)

;; 持ち越した並びに、40 ミリ秒の時間切れを付ける（前の時間切れは、番号が変わるので働かない）
(define Conjs_term_esc_timer ,(O)
  Conjs_term_get O "esc" ,(old)
  Conjs_term_untimer O old ,()
  Conjs_term_new_id O ,(id)
  Conjs_term_set O "esc" id ,()
  Conjs_term_num "40" ,(ms)
  Conjs_term_timer O "esc" id ms)

;; 持ち越した並びを、キーにして渡す（40 ミリ秒、続きが来なかったか、標準入力が終わった）
(define Conjs_term_flush ,(O)
  Conjs_term_get O "carry" ,(carry)
  Conjs_term_set O "carry" "" ,()
  Conjs_term_keys carry __TRUE__ ,(names left)
  Conjs_term_deliver_all O names)

(define Conjs_term_on_end ,(O)
  Conjs_term_flush O ,()
  Conjs_term_set O "ended" __TRUE__ ,()
  Conjs_term_get O "waits" ,(waits)
  Conjs_term_set O "waits" __NULL__ ,()
  Conjs_term_fail_waits O waits)

(define Conjs_term_fail_waits ,(O waits)
  __Cont_get__ ,(return)
  __is_null__ waits ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ waits ,(item rest)
  __LList_uncons__ __print_exit_error__ item ,(id more)
  __LList_uncons__ __print_exit_error__ more ,(task more)
  __LList_uncons__ __print_exit_error__ more ,(w more)
  Conjs_term_untimer O id ,()
  Kit_sched_put w task __FALSE__ "nextEvent: the input has ended" ,()
  Conjs_term_fail_waits O rest)

;; キーの名前を、待ちの列の先頭に渡すか、キーの列にためる
(define Conjs_term_deliver_all ,(O names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Conjs_term_get O "waits" ,(waits)
  __is_null__ waits ,(test__) __if__ test__
    (,()
      Conjs_term_get O "keys" ,(keys)
      __LList_cons__ name __NULL__ ,(one)
      Conjs_term_append keys one ,(keys)
      Conjs_term_set O "keys" keys ,()
      Conjs_term_deliver_all O rest ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ waits ,(item more)
  Conjs_term_set O "waits" more ,()
  __LList_uncons__ __print_exit_error__ item ,(id m2)
  __LList_uncons__ __print_exit_error__ m2 ,(task m3)
  __LList_uncons__ __print_exit_error__ m3 ,(w m4)
  Conjs_term_untimer O id ,()
  Kit_sched_put w task __TRUE__ name ,()
  Conjs_term_deliver_all O rest)

;; キーの列の先頭（なければ null）
(define Conjs_term_pop ,(O)
  __Cont_get__ ,(return)
  Conjs_term_get O "keys" ,(keys)
  __is_null__ keys ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ keys ,(name rest)
  Conjs_term_set O "keys" rest ,()
  __NULL__ name)

;; 待ちの列から番号 id の待ちを外して返す（なければ null）
(define Conjs_term_take_wait ,(O id)
  __Cont_get__ ,(return)
  Conjs_term_get O "waits" ,(waits)
  Conjs_term_find_wait waits id __NULL__ ,(item rest)
  __is_null__ item ,(test__) __if__ test__ (,() return __NULL__) ,()
  Conjs_term_set O "waits" rest ,()
  __NULL__ item)

(define Conjs_term_find_wait ,(list id acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ list ,(item rest)
  __LList_uncons__ __print_exit_error__ item ,(i more)
  __Number_subtract__ i id ,(d)
  __Number_is_zero__ d ,(same)
  __unless__ same (,() __LList_cons__ item acc ,(acc) Conjs_term_find_wait rest id acc ,(x l) return x l) ,()
  Conjs_term_reverse_onto acc rest ,(l)
  __NULL__ item l)

;; acc（新しい順）を、逆にして rest の前に付ける
(define Conjs_term_reverse_onto ,(acc rest)
  __Cont_get__ ,(return)
  __is_null__ acc ,(test__) __if__ test__ (,() return rest) ,()
  __LList_uncons__ __print_exit_error__ acc ,(x more)
  __LList_cons__ x rest ,(rest)
  Conjs_term_reverse_onto more rest)

(define Conjs_term_append ,(a b)
  Kit_sched_reverse a __NULL__ ,(ra)
  Conjs_term_reverse_onto ra b)

;; ── キーに分ける（test/fast18 が直に確かめる）──
;; 文字列 text を、キーの名前（ブラウザの KeyboardEvent.key に合わせる）の LList（古い順）と、終わりで持ち越す並び
;; （終わっていない ESC の並び。なければ ""）に分ける。final が真なら（40 ミリ秒、続きが来なかったか、標準入力の終わり）、
;; 持ち越さずに、ESC だけを "Escape"、終わっていない並びを "Unidentified" にする
(define Conjs_term_keys ,(text final)
  __String_length__ text ,(n)
  Conjs_term_num "0" ,(zero)
  Conjs_term_keys_from text n zero final __NULL__)

(define Conjs_term_keys_from ,(text n i final acc)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ (,() Kit_sched_reverse acc __NULL__ ,(l) return l "") ,()
  Conjs_term_char text i ,(c)
  Conjs_term_num "1" ,(one)
  __Number_add__ i one ,(i1)
  __String_toCode__ __print_exit_error__ c ,(code)
  Conjs_term_num "27" ,(escCode)
  __Number_subtract__ code escCode ,(d)
  __Number_is_zero__ d ,(isEsc)
  __if__ isEsc
    (,()
      Conjs_term_escape text n i final ,(name next)
      __is_null__ name ,(test__) __if__ test__
        (,() Kit_sched_reverse acc __NULL__ ,(l) __String_substring__ __print_exit_error__ text i n ,(rest) return l rest) ,()
      __LList_cons__ name acc ,(acc)
      Conjs_term_keys_from text n next final acc ,(l rest)
      return l rest) ,()
  ;; \r\n は 1 つの Enter
  __String_equal__ c "\r" ,(cr)
  __if__ cr
    (,()
      __Number_subtract__ n i1 ,(more)
      __Number_is_zero__ more ,(atEnd)
      __if_then_else__ atEnd (,() __NULL__ "") (,() Conjs_term_char text i1) ,(c2)
      __String_equal__ c2 "\n" ,(crlf)
      __if_then_else__ crlf (,() __Number_add__ i1 one) (,() __NULL__ i1) ,(next)
      __LList_cons__ "Enter" acc ,(acc)
      Conjs_term_keys_from text n next final acc ,(l rest)
      return l rest) ,()
  Conjs_term_name c code ,(name)
  __LList_cons__ name acc ,(acc)
  Conjs_term_keys_from text n i1 final acc)

(define Conjs_term_char ,(text i)
  Conjs_term_num "1" ,(one)
  __Number_add__ i one ,(j)
  __String_substring__ __print_exit_error__ text i j)

;; ESC でない 1 文字の名前
(define Conjs_term_name ,(c code)
  __Cont_get__ ,(return)
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() return "Enter") ,()
  __String_equal__ c "\t" ,(test__) __if__ test__ (,() return "Tab") ,()
  Conjs_term_num "127" ,(del)
  Conjs_term_num "8" ,(bs)
  __Number_subtract__ code del ,(d1)
  __Number_subtract__ code bs ,(d2)
  __Number_is_zero__ d1 ,(isDel)
  __Number_is_zero__ d2 ,(isBs)
  __or__ isDel isBs ,(test__) __if__ test__ (,() return "Backspace") ,()
  Conjs_term_num "32" ,(space)
  __Number_subtract__ code space ,(d)
  __Number_is_negative__ d ,(control)
  __if__ control (,() return "Unidentified") ,()
  __NULL__ c)

;; 位置 i の ESC から始まる並び：(名前 次の位置)。並びが終わっていなければ、final が偽なら (null i)（持ち越す）
(define Conjs_term_escape ,(text n i final)
  __Cont_get__ ,(return)
  Conjs_term_num "1" ,(one)
  Conjs_term_num "2" ,(two)
  __Number_add__ i one ,(i1)
  __Number_add__ i two ,(i2)
  __Number_subtract__ n i1 ,(left)
  __Number_is_zero__ left ,(alone)
  __if__ alone (,() __if__ final (,() return "Escape" i1) ,() return __NULL__ i) ,()
  Conjs_term_char text i1 ,(c1)
  __String_equal__ c1 "[" ,(csi)
  __String_equal__ c1 "O" ,(ss3)
  __or__ csi ss3 ,(seq)
  ;; ESC の後に、並びでない文字（Alt を押したとき）：Escape と、その文字
  __unless__ seq (,() return "Escape" i1) ,()
  ;; ESC [ と ESC O の後：終わりの文字（@ から ~。ESC O は、次の 1 文字）まで
  Conjs_term_seq_end text n i2 ss3 ,(end)
  __is_null__ end ,(open)
  __if__ open (,() __if__ final (,() return "Unidentified" n) ,() return __NULL__ i) ,()
  Conjs_term_char text end ,(last)
  __Number_add__ end one ,(next)
  __Number_subtract__ end i2 ,(params)
  __Number_is_zero__ params ,(plain)
  __unless__ plain (,() return "Unidentified" next) ,()
  __String_equal__ last "A" ,(test__) __if__ test__ (,() return "ArrowUp" next) ,()
  __String_equal__ last "B" ,(test__) __if__ test__ (,() return "ArrowDown" next) ,()
  __String_equal__ last "C" ,(test__) __if__ test__ (,() return "ArrowRight" next) ,()
  __String_equal__ last "D" ,(test__) __if__ test__ (,() return "ArrowLeft" next) ,()
  __NULL__ "Unidentified" next)

;; 並びの終わりの文字の位置（なければ null）。one なら、j の 1 文字が終わり
(define Conjs_term_seq_end ,(text n j one)
  __Cont_get__ ,(return)
  __Number_subtract__ n j ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ (,() return __NULL__) ,()
  __if__ one (,() return j) ,()
  Conjs_term_char text j ,(c)
  __String_toCode__ __print_exit_error__ c ,(code)
  Conjs_term_num "64" ,(lo)
  Conjs_term_num "127" ,(hi)
  __Number_subtract__ code lo ,(a)
  __Number_subtract__ code hi ,(b)
  __Number_is_negative__ a ,(below)
  __Number_is_negative__ b ,(under)
  __not__ below ,(atLeast)
  __and__ atLeast under ,(final)
  __if__ final (,() return j) ,()
  Conjs_term_num "1" ,(k)
  __Number_add__ j k ,(j)
  Conjs_term_seq_end text n j one)
