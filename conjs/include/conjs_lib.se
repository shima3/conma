;; ConJS の待つ呼び出しのライブラリ（docs/dev/PLATFORM-PLAN-ja.md の 4.4 節。段階 P5）：sleep、setTimeout、Date.now、
;; fs.readFile、fs.writeFile、fetch。名前は JavaScript にならうが、Promise を返さず、結果が届くまで、呼んだ処理だけが待つ。
;; SJS が除くホストのもの（docs/consh/dev/SAFEJS-PLAN-ja.md の 3.2）なので、ConJS だけに置き、SJS には移さない。
;; conjs_rt.se の Conjs_builtins が Conjs_lib_builtins を呼んで、大域に置く。
;;   sleep(ms)            ホストの関数 time.sleep（待つ呼び出し）
;;   setTimeout(f, ms, ...args)  spawn(() => { sleep(ms); return f(...args); }) と同じ。処理を返す
;;   Date.now()           ホストの関数 time.now（1970 年からのミリ秒。整数にする）
;;   fs.readFile(path)、fs.writeFile(path, text)  ConMa の __OS_open__ などで読み書きする（処理は切り替わらない）
;;   fetch(url, options)  ホストに http.fetch（機能 "fetch"）があればそれで、なければ curl を待つための VProc で動かす。
;;                        Response のようなオブジェクト（status、ok、text()、json()）を返す

(define Conjs_lib_builtins ,(G)
  Sjs_function G "sleep" (,(args) Sjs_arg args ,(ms rest) Conjs_ms "sleep" ms ,(ms) Conjs_sleep ms) ,(sleep)
  __Dict_put__ G "sleep" sleep ,()
  Sjs_function G "setTimeout" (,(args) Conjs_set_timeout G args) ,(st)
  __Dict_put__ G "setTimeout" st ,()
  Sjs_object_new G ,(date)
  Sjs_def G date "now" (,(args) Conjs_date_now) ,()
  __Dict_put__ G "Date" date ,()
  Sjs_object_new G ,(fs)
  Sjs_def G fs "readFile" (,(args) Conjs_fs_read args) ,()
  Sjs_def G fs "writeFile" (,(args) Conjs_fs_write args) ,()
  __Dict_put__ G "fs" fs ,()
  Sjs_function G "fetch" (,(args) Conjs_fetch G args) ,(fetch)
  __Dict_put__ G "fetch" fetch)

(define Conjs_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

;; 文字 c が chars の中にある位置（なければ null）
(define Conjs_find ,(chars c)
  Conjs_num "0" ,(zero)
  __String_find__ __print_exit_error__ chars c zero)

;; 待つホストの呼び出し name（引数はホストの値の LList）。失敗は、その名前の例外にする
(define Conjs_wait_host ,(errName name list)
  Kit_sched_wait (,(msg) Sjs_throw errName msg) name list ,(ok payload)
  __unless__ ok (,() Sjs_throw errName payload) ,()
  __NULL__ payload)

;; ミリ秒の引数：undefined、負の数、NaN、無限は 0（JavaScript の setTimeout と同じ）。数でなければ TypeError
(define Conjs_ms ,(what v)
  __Cont_get__ ,(return)
  Conjs_num "0" ,(zero)
  Sjs_kind v ,(kind)
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return zero) ,()
  __String_equal__ kind "number" ,(ok)
  __unless__ ok
    (,()
      Sjs_describe v ,(d)
      __String_concat__ what ": expected milliseconds (a number), got " ,(m)
      __String_concat__ m d ,(m)
      Sjs_type_error m) ,()
  ;; NaN と無限は、v - v が 0 にならない
  __Number_subtract__ v v ,(z)
  __Number_is_zero__ z ,(finite)
  __unless__ finite (,() return zero) ,()
  __Number_is_negative__ v ,(test__) __if__ test__ (,() return zero) ,()
  __NULL__ v)

(define Conjs_sleep ,(ms)
  __LList_cons__ ms __NULL__ ,(l)
  Conjs_wait_host "Error" "time.sleep" l ,(r)
  __NULL__ __NULL__)

;; setTimeout(f, ms, ...args)
(define Conjs_set_timeout ,(G args)
  Sjs_arg args ,(f rest)
  Sjs_kind f ,(kind)
  __String_equal__ kind "function" ,(ok)
  __unless__ ok (,() Sjs_describe f ,(d) __String_concat__ "setTimeout: " d ,(m) __String_concat__ m " is not a function" ,(m) Sjs_type_error m) ,()
  Sjs_arg rest ,(ms more)
  Conjs_ms "setTimeout" ms ,(ms)
  Sjs_function G "" (,(a) Conjs_sleep ms ,(u) Sjs_call f more) ,(g)
  Conjs_spawn G g)

;; Date.now()
(define Conjs_date_now ,()
  __Host_call__ (,(msg) Sjs_throw "Error" msg) "time.now" __NULL__ ,(t)
  __Number_floor__ t)

(define Conjs_string_arg ,(what v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__ return ,()
  Sjs_describe v ,(d)
  __String_concat__ what ": expected a string, got " ,(m)
  __String_concat__ m d ,(m)
  Sjs_type_error m)

;; Stream s を終わりまで読んだ文字列
(define Conjs_read_all ,(onError s acc)
  __Cont_get__ ,(return)
  __OS_wait_readable__ onError s ,()
  __OS_read__ onError s ,(data)
  __is_null__ data ,(test__) __if__ test__ (,() return acc) ,()
  __String_concat__ acc data ,(acc)
  Conjs_read_all onError s acc)

;; fs.readFile(path)
(define Conjs_fs_read ,(args)
  Sjs_arg args ,(path rest)
  Conjs_string_arg "fs.readFile: path" path ,()
  __NULL__ (,(msg) __String_concat__ "fs.readFile: " msg ,(m) Sjs_throw "Error" m) ,(fail)
  __OS_open__ fail path "r" ,(s)
  Conjs_read_all fail s "" ,(text)
  __OS_close__ fail s ,()
  __NULL__ text)

;; fs.writeFile(path, text)
(define Conjs_fs_write ,(args)
  Sjs_arg args ,(path rest)
  Sjs_arg rest ,(text more)
  Conjs_string_arg "fs.writeFile: path" path ,()
  Conjs_string_arg "fs.writeFile: data" text ,()
  __NULL__ (,(msg) __String_concat__ "fs.writeFile: " msg ,(m) Sjs_throw "Error" m) ,(fail)
  __OS_open__ fail path "w" ,(s)
  __OS_write__ fail s text ,()
  __OS_close__ fail s ,()
  __NULL__ __NULL__)

;; fetch(url, options)
(define Conjs_fetch ,(G args)
  Sjs_arg args ,(url rest)
  Conjs_string_arg "fetch: url" url ,()
  Sjs_arg rest ,(opts more)
  Conjs_fetch_options G opts ,(method headers body)
  __Feature_available__ "fetch" ,(host)
  __if_then_else__ host
    (,()
      __LList_cons__ body __NULL__ ,(l)
      __LList_cons__ headers l ,(l)
      __LList_cons__ method l ,(l)
      __LList_cons__ url l ,(l)
      Conjs_wait_host "TypeError" "http.fetch" l ,(r)
      __LList_uncons__ __print_exit_error__ r ,(status more)
      __LList_uncons__ __print_exit_error__ more ,(text more)
      __NULL__ status text)
    (,() Conjs_fetch_curl url method headers body) ,(status text)
  Conjs_response G status text)

;; options の method（なければ "GET"）、headers（(名前 値) の LList）、body（なければ ""）
(define Conjs_fetch_options ,(G opts)
  __Cont_get__ ,(return)
  Sjs_is_nullish opts ,(test__) __if__ test__ (,() return "GET" __NULL__ "") ,()
  Sjs_get_member G opts "method" ,(method)
  Sjs_is_undefined method ,(test__)
  __if_then_else__ test__ (,() __NULL__ "GET") (,() Conjs_string_arg "fetch: method" method ,() __NULL__ method) ,(method)
  Sjs_get_member G opts "headers" ,(h)
  Sjs_is_nullish h ,(noHeaders)
  __if_then_else__ noHeaders (,() __NULL__ __NULL__) (,() Conjs_fetch_headers G h) ,(headers)
  Sjs_get_member G opts "body" ,(body)
  Sjs_is_undefined body ,(test__)
  __if_then_else__ test__ (,() __NULL__ "") (,() Conjs_string_arg "fetch: body" body ,() __NULL__ body) ,(body)
  __NULL__ method headers body)

(define Conjs_fetch_headers ,(G h)
  Sjs_kind h ,(kind)
  __String_equal__ kind "object" ,(ok)
  __unless__ ok (,() Sjs_describe h ,(d) __String_concat__ "fetch: headers must be an object, got " d ,(m) Sjs_type_error m) ,()
  Sjs_obj_keys h ,(keys)
  Conjs_fetch_headers_list G h keys)

(define Conjs_fetch_headers_list ,(G h keys)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_get_member G h k ,(v)
  Sjs_to_string v ,(v)
  __LList_cons__ v __NULL__ ,(pair)
  __LList_cons__ k pair ,(pair)
  Conjs_fetch_headers_list G h rest ,(more)
  __LList_cons__ pair more)

;; ホストに http.fetch がないとき：curl を、待つための VProc で動かす。本体は標準出力、状態の番号は標準エラー
;; （-w の %{stderr}）で受け取る。curl を動かせないか、curl が 0 でない終了コードで終わったら（つながらないなど）、
;; JavaScript と同じく TypeError にする。HTTP のエラーの状態（404 など）は、例外にせず、Response の ok を偽にする
(define Conjs_fetch_curl ,(url method headers body)
  __Cont_get__ ,(return)
  __MSeq_new__ ,(argv)
  __NULL__ (,(x) __MSeq_append__ __print_exit_error__ argv x) ,(add)
  add "curl" ,() add "-s" ,() add "-X" ,() add method ,() add "-w" ,() add "%{stderr}%{http_code}" ,()
  Conjs_curl_headers add headers ,()
  __String_equal__ body "" ,(noBody)
  __unless__ noBody (,() add "--data-raw" ,() add body) ,()
  add "--url" ,() add url ,()
  Kit_sched_wait_work (,() Conjs_curl_run argv) ,(ok payload)
  __unless__ ok (,() __String_concat__ "fetch failed: " payload ,(m) Sjs_throw "TypeError" m) ,()
  __LList_uncons__ __print_exit_error__ payload ,(exit more)
  __LList_uncons__ __print_exit_error__ more ,(text more)
  __LList_uncons__ __print_exit_error__ more ,(code more)
  __Number_is_zero__ exit ,(test__) __unless__ test__ (,() Sjs_throw "TypeError" "fetch failed") ,()
  __Number_fromString__ (,(msg) Sjs_throw "TypeError" "fetch failed") code ,(status)
  return status text)

(define Conjs_curl_headers ,(add headers)
  __Cont_get__ ,(return)
  __is_null__ headers ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ headers ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(k more)
  __LList_uncons__ __print_exit_error__ more ,(v more)
  __String_concat__ k ": " ,(line)
  __String_concat__ line v ,(line)
  add "-H" ,() add line ,()
  Conjs_curl_headers add rest)

;; 待つための VProc の中：curl を動かし、（成否、(終了コード 本体 状態の番号)）を返す
(define Conjs_curl_run ,(argv)
  __Cont_get__ ,(ret)
  __NULL__ (,(msg) ret __FALSE__ msg) ,(fail)
  __OS_pipe__ ,(outR outW)
  __OS_pipe__ ,(errR errW)
  __OS_get_envDict__ ,(env)
  __OS_spawn__ (,(msg) __OS_close__ fail outW ,() __OS_close__ fail errW ,() fail msg) argv __NULL__ outW errW env ,(proc)
  __OS_close__ fail outW ,()
  __OS_close__ fail errW ,()
  Conjs_read_all fail outR "" ,(text)
  Conjs_read_all fail errR "" ,(code)
  __OS_close__ fail outR ,()
  __OS_close__ fail errR ,()
  __OS_wait__ fail proc ,(exit)
  __LList_cons__ code __NULL__ ,(p)
  __LList_cons__ text p ,(p)
  __LList_cons__ exit p ,(p)
  ret __TRUE__ p)

;; Response のようなオブジェクト：status、ok（状態が 200〜299）、text()、json()
(define Conjs_response ,(G status text)
  Sjs_object_new G ,(r)
  Sjs_obj_set r "status" status ,()
  Conjs_num "200" ,(lo)
  Conjs_num "300" ,(hi)
  __Number_subtract__ status lo ,(a)
  __Number_subtract__ status hi ,(b)
  __Number_is_negative__ a ,(below)
  __Number_is_negative__ b ,(under)
  __not__ below ,(atLeast)
  __and__ atLeast under ,(ok)
  Sjs_obj_set r "ok" ok ,()
  Sjs_def G r "text" (,(args) __NULL__ text) ,()
  Sjs_def G r "json" (,(args) Conjs_json_parse G text) ,()
  __NULL__ r)

;; ── Response の json() のための JSON の読み手（SJS には JSON.parse がない。ConJS に JSON.parse を足すのは、受け付ける
;; JavaScript を広げる段階で決める）。読めないときは SyntaxError ──

(define Conjs_json_parse ,(G text)
  __String_length__ text ,(n)
  Conjs_num "0" ,(zero)
  __Ref_new__ zero ,(pos)
  Conjs_json_value G text n pos ,(v)
  Conjs_json_ws text n pos ,()
  __Ref_get__ pos ,(i)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __unless__ test__ (,() Conjs_json_error pos) ,()
  __NULL__ v)

(define Conjs_json_error ,(pos)
  __Ref_get__ pos ,(i)
  Sjs_num_str i ,(at)
  __String_concat__ "JSON: unexpected text at position " at ,(m)
  Sjs_throw "SyntaxError" m)

;; 位置の文字（終わりなら ""）
(define Conjs_json_peek ,(text n pos)
  __Cont_get__ ,(return)
  __Ref_get__ pos ,(i)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ (,() return "") ,()
  Conjs_num "1" ,(one)
  __Number_add__ i one ,(j)
  __String_substring__ __print_exit_error__ text i j)

(define Conjs_json_skip ,(pos k)
  __Ref_get__ pos ,(i)
  __Number_add__ i k ,(j)
  __Ref_set__ pos j)

(define Conjs_json_ws ,(text n pos)
  __Cont_get__ ,(return)
  Conjs_json_peek text n pos ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ return ,()
  Conjs_find " \t\n\r" c ,(at)
  __is_null__ at ,(test__) __if__ test__ return ,()
  Conjs_num "1" ,(one)
  Conjs_json_skip pos one ,()
  Conjs_json_ws text n pos)

(define Conjs_json_value ,(G text n pos)
  __Cont_get__ ,(return)
  Conjs_json_ws text n pos ,()
  Conjs_json_peek text n pos ,(c)
  Conjs_num "1" ,(one)
  __String_equal__ c "{" ,(test__) __if__ test__ (,() Conjs_json_skip pos one ,() Sjs_object_new G ,(o) Conjs_json_members G text n pos o __TRUE__ ,(v) return v) ,()
  __String_equal__ c "[" ,(test__) __if__ test__ (,() Conjs_json_skip pos one ,() Conjs_json_items G text n pos __NULL__ __TRUE__ ,(l) Sjs_array G l ,(a) return a) ,()
  __String_equal__ c "\"" ,(test__) __if__ test__ (,() Conjs_json_skip pos one ,() Conjs_json_string text n pos "" ,(str) return str) ,()
  Conjs_json_word text n pos "true" __TRUE__ ,(found v) __if__ found (,() return v) ,()
  Conjs_json_word text n pos "false" __FALSE__ ,(found v) __if__ found (,() return v) ,()
  __Ref_new__ __NULL__ ,(jsNull)
  Conjs_json_word text n pos "null" jsNull ,(found v) __if__ found (,() return v) ,()
  Conjs_json_number text n pos)

;; 位置に word があれば、読み進めて（真、v）
(define Conjs_json_word ,(text n pos word v)
  __Cont_get__ ,(return)
  __Ref_get__ pos ,(i)
  __String_length__ word ,(k)
  __Number_add__ i k ,(j)
  __Number_subtract__ n j ,(left)
  __Number_is_negative__ left ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  __String_substring__ __print_exit_error__ text i j ,(w)
  __String_equal__ w word ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  __Ref_set__ pos j ,()
  __NULL__ __TRUE__ v)

(define Conjs_json_number ,(text n pos)
  __Ref_get__ pos ,(start)
  Conjs_json_number_end text n pos ,()
  __Ref_get__ pos ,(end)
  __Number_subtract__ end start ,(len)
  __Number_is_zero__ len ,(test__) __if__ test__ (,() Conjs_json_error pos) ,()
  __String_substring__ __print_exit_error__ text start end ,(digits)
  __Number_fromString__ (,(msg) __Ref_set__ pos start ,() Conjs_json_error pos) digits)

(define Conjs_json_number_end ,(text n pos)
  __Cont_get__ ,(return)
  Conjs_json_peek text n pos ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ return ,()
  Conjs_find "-+0123456789.eE" c ,(at)
  __is_null__ at ,(test__) __if__ test__ return ,()
  Conjs_num "1" ,(one)
  Conjs_json_skip pos one ,()
  Conjs_json_number_end text n pos)

;; 文字列の中身（最初の " の後から）。acc は読んだ分
(define Conjs_json_string ,(text n pos acc)
  __Cont_get__ ,(return)
  __Ref_get__ pos ,(i)
  __String_find_any__ __print_exit_error__ text "\"\\" i ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() __Ref_set__ pos n ,() Conjs_json_error pos) ,()
  __String_substring__ __print_exit_error__ text i at ,(part)
  __String_concat__ acc part ,(acc)
  __Ref_set__ pos at ,()
  Conjs_json_peek text n pos ,(c)
  Conjs_num "1" ,(one)
  Conjs_json_skip pos one ,()
  __String_equal__ c "\"" ,(test__) __if__ test__ (,() return acc) ,()
  Conjs_json_escape text n pos ,(e)
  __String_concat__ acc e ,(acc)
  Conjs_json_string text n pos acc)

(define Conjs_json_escape ,(text n pos)
  __Cont_get__ ,(return)
  Conjs_json_peek text n pos ,(c)
  Conjs_num "1" ,(one)
  Conjs_json_skip pos one ,()
  __String_equal__ c "n" ,(test__) __if__ test__ (,() Conjs_num "10" ,(k) __String_fromCode__ __print_exit_error__ k ,(s) return s) ,()
  __String_equal__ c "t" ,(test__) __if__ test__ (,() Conjs_num "9" ,(k) __String_fromCode__ __print_exit_error__ k ,(s) return s) ,()
  __String_equal__ c "r" ,(test__) __if__ test__ (,() Conjs_num "13" ,(k) __String_fromCode__ __print_exit_error__ k ,(s) return s) ,()
  __String_equal__ c "b" ,(test__) __if__ test__ (,() Conjs_num "8" ,(k) __String_fromCode__ __print_exit_error__ k ,(s) return s) ,()
  __String_equal__ c "f" ,(test__) __if__ test__ (,() Conjs_num "12" ,(k) __String_fromCode__ __print_exit_error__ k ,(s) return s) ,()
  __String_equal__ c "u" ,(test__) __if__ test__ (,() Conjs_json_unicode text n pos ,(s) return s) ,()
  Conjs_find "\"\\/" c ,(at)
  __is_null__ at ,(bad)
  __String_equal__ c "" ,(end)
  __or__ bad end ,(test__) __if__ test__ (,() Conjs_json_error pos) ,()
  __NULL__ c)

;; \uXXXX（と、続く下位のサロゲート）
(define Conjs_json_unicode ,(text n pos)
  __Cont_get__ ,(return)
  Conjs_json_hex4 text n pos ,(hi)
  Conjs_num "55296" ,(d800)
  Conjs_num "56320" ,(dc00)
  __Number_subtract__ hi d800 ,(a)
  __Number_subtract__ hi dc00 ,(b)
  __Number_is_negative__ a ,(below)
  __Number_is_negative__ b ,(under)
  __not__ below ,(atLeast)
  __and__ atLeast under ,(lead)
  __unless__ lead (,() __String_fromCode__ (,(m) Conjs_json_error pos) hi ,(s) return s) ,()
  Conjs_json_word text n pos "\\u" __TRUE__ ,(found v)
  __unless__ found (,() Conjs_json_error pos) ,()
  Conjs_json_hex4 text n pos ,(lo)
  ;; 0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00)
  Conjs_num "1024" ,(k400)
  Conjs_num "65536" ,(k10000)
  __Number_multiply__ a k400 ,(x)
  __Number_subtract__ lo dc00 ,(y)
  __Number_add__ x y ,(x)
  __Number_add__ x k10000 ,(code)
  __String_fromCode__ (,(m) Conjs_json_error pos) code)

(define Conjs_json_hex4 ,(text n pos)
  Conjs_num "0" ,(zero)
  Conjs_json_hex text n pos zero zero)

(define Conjs_json_hex ,(text n pos k acc)
  __Cont_get__ ,(return)
  Conjs_num "4" ,(four)
  __Number_subtract__ k four ,(d)
  __Number_is_zero__ d ,(test__) __if__ test__ (,() return acc) ,()
  Conjs_json_peek text n pos ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ (,() Conjs_json_error pos) ,()
  Conjs_find "0123456789abcdef0123456789ABCDEF" c ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() Conjs_json_error pos) ,()
  Conjs_num "16" ,(sixteen)
  __Number_divide__ __print_exit_error__ at sixteen ,(q)
  __Number_floor__ q ,(q)
  __Number_multiply__ q sixteen ,(q)
  __Number_subtract__ at q ,(digit)
  __Number_multiply__ acc sixteen ,(acc)
  __Number_add__ acc digit ,(acc)
  Conjs_num "1" ,(one)
  Conjs_json_skip pos one ,()
  __Number_add__ k one ,(k)
  Conjs_json_hex text n pos k acc)

;; 配列の要素（最初の [ の後から）。acc は逆順の LList
(define Conjs_json_items ,(G text n pos acc first)
  __Cont_get__ ,(return)
  Conjs_json_ws text n pos ,()
  Conjs_json_peek text n pos ,(c)
  Conjs_num "1" ,(one)
  __String_equal__ c "]" ,(close)
  __and__ close first ,(test__) __if__ test__ (,() Conjs_json_skip pos one ,() return __NULL__) ,()
  Conjs_json_value G text n pos ,(v)
  __LList_cons__ v acc ,(acc)
  Conjs_json_ws text n pos ,()
  Conjs_json_peek text n pos ,(c)
  Conjs_json_skip pos one ,()
  __String_equal__ c "]" ,(test__) __if__ test__ (,() Sjs_reverse_list acc ,(l) return l) ,()
  __String_equal__ c "," ,(test__) __unless__ test__ (,() Conjs_json_error pos) ,()
  Conjs_json_items G text n pos acc __FALSE__)

;; オブジェクトのメンバー（最初の { の後から）
(define Conjs_json_members ,(G text n pos o first)
  __Cont_get__ ,(return)
  Conjs_json_ws text n pos ,()
  Conjs_json_peek text n pos ,(c)
  Conjs_num "1" ,(one)
  __String_equal__ c "}" ,(close)
  __and__ close first ,(test__) __if__ test__ (,() Conjs_json_skip pos one ,() return o) ,()
  __String_equal__ c "\"" ,(test__) __unless__ test__ (,() Conjs_json_error pos) ,()
  Conjs_json_skip pos one ,()
  Conjs_json_string text n pos "" ,(key)
