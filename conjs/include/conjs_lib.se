      __String_equal__ hk "object" ,(ok)
      __unless__ ok (,() Sjs_describe headers ,(d) __String_concat__ "respond: headers must be an object, got " d ,(m) Sjs_type_error m) ,()
      Conjs_to_host "respond" headers __NULL__) ,(h)
  Sjs_is_undefined body ,(test__)
  __if_then_else__ test__ (,() __NULL__ "") (,() Conjs_string_arg "respond: body" body ,() __NULL__ body) ,(body)
  __LList_cons__ body __NULL__ ,(l)
