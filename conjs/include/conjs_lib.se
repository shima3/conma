  __unless__ ok (,() Sjs_describe status ,(d) __String_concat__ "respond: expected a status (a number), got " d ,(m) Sjs_type_error m) ,()
  ;; respond(status, body)
  Sjs_kind headers ,(hkind)
  __String_equal__ hkind "string" ,(short)
  Sjs_is_undefined body ,(noBody)
