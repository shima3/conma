;; ConJS のスケジューラ（docs/dev/PLATFORM-PLAN-ja.md の 4.1 節と 4.2 節。段階 P3b）。ConJS の構文にも、SJS の名前にも
;; よらない部分で、P4 で言語キットに移す。1 つの VProc の中で、いくつもの処理（task）を、継続で協調的に切り替える。
;; 切り替わるのは、待つ呼び出し（Sched_wait と Sched_join）の所だけである。
;;
;;   Sched_run save restore body ,(blocked failed)
;;       body（main。thunk）を最初の処理として動かし、すべての処理が終わるか、動かせる処理も待っている呼び出しも
;;       なくなるまで、処理を動かす。blocked は、そのとき join で待ったまま残った処理の数（0 でなければ行き詰まり）、
;;       failed は、例外で終わったまま join されなかった処理の、終わった順の LList（Sched_payload で中身を取る）。
;;       save ,(local) と restore local ,() は、切り替えるときに、処理だけの状態を取り出し、戻す関数。新しい処理には
;;       restore __NULL__ を呼ぶ。
;;   Sched_spawn body ,(task)
;;       body（thunk。返す値は ok と payload の 2 つ）を新しい処理として列の最後に入れる。呼んだ側は動き続ける。
;;       ok が偽なら、例外で終わった処理とする。
;;   Sched_wait onError name args ,(ok payload)
;;       ホストの関数を待つ呼び出し（__Host_start__）。結果が届くまで、この処理だけが待ち、ほかの処理が動く。
;;       呼び始めるときのエラーは、すぐに onError に行く（切り替わらない）。関数の失敗は、ok が偽で、payload がメッセージ。
;;   Sched_join task ,(ok payload)
;;       処理 task が終わるまで待ち、その body が返した ok と payload を返す。終わっていれば、待たずに返る。
;;       自分自身の join は呼ばないこと（呼ぶ側が確かめる。Sched_is_current）。
;;
;; 状態 S（PDict の "conjs_sched"）は Dict：
;;   "in" "out"   動かせる処理の列（FIFO）。2 つの LList の Ref（in は新しい順、out は古い順）。要素は LList (task k value)
;;   "pending"    待っている呼び出しの数の Ref
;;   "blocked"    join で待っている処理の数の Ref
;;   "chan"       待つための VProc が結果を入れるチャネル。この VProc は書かない書き手 "self" を 1 つ閉じずに持つので、
;;                読み始めた後でも書き手を足せ、チャネルが終わることもない。"reader" は、その読み手
;;   "current"    動いている処理の Ref
;;   "failed"     例外で終わった処理の LList の Ref（新しい順）
;;   "loop"       列から次の処理を選ぶ所の継続（Sched_run の浅い所。どの処理も、ここから動かすので、CChain は伸びない）
;;   "save" "restore"
;; 処理は Dict："state"（"ready"、"waiting"、"done"）、"ok" "payload"、"joiners"（join で待っている処理の LList。
;; 新しい順）、"joined"（join されたか）、"local"（処理だけの状態）、"k"（待っている所の継続）。どれも Ref

(define Sched_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

(define Sched_ref ,(S key)
  __Dict_lookup_or__ S key __print_exit_error__)

(define Sched_get ,(S key)
  __Dict_lookup_or__ S key __print_exit_error__ ,(r)
  __Ref_get__ r)

(define Sched_set ,(S key v)
  __Dict_lookup_or__ S key __print_exit_error__ ,(r)
  __Ref_set__ r v)

(define Sched_add ,(S key d)
  __Dict_lookup_or__ S key __print_exit_error__ ,(r)
  __Ref_get__ r ,(n)
  Sched_num d ,(d)
  __Number_add__ n d ,(n)
  __Ref_set__ r n)

(define Sched_state ,()
  __PDict_lookup_or__ "conjs_sched" __print_exit_error__)

(define Sched_reverse ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __LList_cons__ x acc ,(acc)
  Sched_reverse rest acc)

(define Sched_new_ref ,(D key v)
  __Ref_new__ v ,(r)
  __Dict_put__ D key r)

;; 新しい処理。"id" は作った順の番号（同じ処理かを比べる）
(define Sched_new_task ,(S)
  Sched_add S "ids" "1" ,()
  Sched_get S "ids" ,(id)
  __Dict_new__ ,(t)
  __Dict_put__ t "id" id ,()
  Sched_new_ref t "state" "ready" ,()
  Sched_new_ref t "ok" __NULL__ ,()
  Sched_new_ref t "payload" __NULL__ ,()
  Sched_new_ref t "joiners" __NULL__ ,()
  Sched_new_ref t "joined" __FALSE__ ,()
  Sched_new_ref t "local" __NULL__ ,()
  Sched_new_ref t "k" __NULL__ ,()
  __NULL__ t)

;; 列の最後に (task k value) を入れる
(define Sched_enqueue ,(S task k value)
  __LList_cons__ value __NULL__ ,(item)
  __LList_cons__ k item ,(item)
  __LList_cons__ task item ,(item)
  Sched_get S "in" ,(l)
  __LList_cons__ item l ,(l)
  Sched_set S "in" l)

;; 列の先頭（なければ null）
(define Sched_dequeue ,(S)
  __Cont_get__ ,(return)
  Sched_get S "out" ,(l)
  __is_null__ l ,(test__) __unless__ test__
    (,() __LList_uncons__ __print_exit_error__ l ,(item rest) Sched_set S "out" rest ,() return item) ,()
  Sched_get S "in" ,(rev)
  __is_null__ rev ,(test__) __if__ test__ (,() return __NULL__) ,()
  Sched_set S "in" __NULL__ ,()
  Sched_reverse rev __NULL__ ,(l)
  __LList_uncons__ __print_exit_error__ l ,(item rest)
  Sched_set S "out" rest ,()
  __NULL__ item)

(define Sched_run ,(save restore body)
  __Cont_get__ ,(return)
  __Dict_new__ ,(S)
  Sched_num "0" ,(zero)
  Sched_new_ref S "in" __NULL__ ,()
  Sched_new_ref S "out" __NULL__ ,()
  Sched_new_ref S "pending" zero ,()
  Sched_new_ref S "blocked" zero ,()
  Sched_new_ref S "ids" zero ,()
  Sched_new_ref S "current" __NULL__ ,()
  Sched_new_ref S "failed" __NULL__ ,()
  __Dict_put__ S "save" save ,()
  __Dict_put__ S "restore" restore ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Chan_new__ one __NULL__ ,(chan)
  __Dict_put__ S "chan" chan ,()
  __Chan_writer__ chan ,(self)
  __Dict_put__ S "self" self ,()
  __Chan_reader__ chan ,(reader)
  __Dict_put__ S "reader" reader ,()
  __PDict_put__ "conjs_sched" S ,()
  ;; main を最初の処理にする（終われば、ほかの処理と同じく Sched_finish）
  Sched_new_task S ,(main)
  Sched_starter S main (,() body ,() __NULL__ __TRUE__ __NULL__) ,(start)
  Sched_enqueue S main start __NULL__ ,()
  (,() __Cont_get__ ,(loop) __Dict_put__ S "loop" loop ,() __NULL__ __NULL__) ,(ignored)
  ;; ここが "loop"：次の処理を動かす
  Sched_dequeue S ,(item)
  __is_null__ item ,(test__) __unless__ test__
    (,()
      __LList_uncons__ __print_exit_error__ item ,(task more)
      __LList_uncons__ __print_exit_error__ more ,(k more)
      __LList_uncons__ __print_exit_error__ more ,(value more)
      Sched_set S "current" task ,()
      Sched_get task "local" ,(local)
      restore local ,()
      k value) ,()
  ;; 動かせる処理がない：待っている呼び出しがあれば、結果を 1 つ待って、その処理を列に入れる
  Sched_get S "pending" ,(pending)
  __Number_is_zero__ pending ,(none)
  __unless__ none
    (,()
      Sched_ref S "reader" ,(reader)
      __Chan_take__ reader ,(r found)
      __LList_uncons__ __print_exit_error__ r ,(task more)
      __LList_uncons__ __print_exit_error__ more ,(ok more)
      __LList_uncons__ __print_exit_error__ more ,(payload more)
      Sched_add S "pending" "-1" ,()
      Sched_get task "k" ,(k)
      __LList_cons__ payload __NULL__ ,(v)
      __LList_cons__ ok v ,(v)
      Sched_enqueue S task k v ,()
      Sched_next S) ,()
  Sched_get S "blocked" ,(blocked)
  Sched_get S "failed" ,(failed)
  Sched_failed_unjoined failed __NULL__ ,(failed)
  return blocked failed)

;; 次の処理を動かす（戻らない）
(define Sched_next ,(S)
  __Dict_lookup_or__ S "loop" __print_exit_error__ ,(loop)
  loop __NULL__)

;; 新しい処理の始め：処理だけの状態を新しくし、body を動かし、返した ok と payload で終える
(define Sched_starter ,(S task body)
  __NULL__ (,(ignored)
    body ,(ok payload)
    Sched_finish S task ok payload))

;; 処理が終わった：結果を置き、join で待っている処理を（join した順に）列に入れ、次の処理へ
(define Sched_finish ,(S task ok payload)
  Sched_set task "ok" ok ,()
  Sched_set task "payload" payload ,()
  Sched_set task "state" "done" ,()
  Sched_get task "joiners" ,(joiners)
  __is_null__ joiners ,(nobody)
  __if_then_else__ nobody (,() __NULL__ __FALSE__) (,() Sched_set task "joined" __TRUE__ ,() __NULL__ __TRUE__) ,(joined)
  __not__ ok ,(failed)
  __not__ joined ,(unjoined)
  __and__ failed unjoined ,(test__) __if__ test__
    (,() Sched_get S "failed" ,(l) __LList_cons__ task l ,(l) Sched_set S "failed" l) ,()
  Sched_reverse joiners __NULL__ ,(joiners)
  __LList_cons__ payload __NULL__ ,(v)
  __LList_cons__ ok v ,(v)
  Sched_wake S joiners v ,()
  Sched_next S)

(define Sched_wake ,(S joiners v)
  __Cont_get__ ,(return)
  __is_null__ joiners ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ joiners ,(j rest)
  Sched_add S "blocked" "-1" ,()
  Sched_get j "k" ,(k)
  Sched_enqueue S j k v ,()
  Sched_wake S rest v)

;; 例外で終わり、最後まで join されなかった処理（終わった順）
(define Sched_failed_unjoined ,(failed acc)
  __Cont_get__ ,(return)
  __is_null__ failed ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ failed ,(t rest)
  Sched_get t "joined" ,(joined)
  __if_then_else__ joined (,() __NULL__ acc) (,() __LList_cons__ t acc) ,(acc)
  Sched_failed_unjoined rest acc)

(define Sched_spawn ,(body)
  Sched_state ,(S)
  Sched_new_task S ,(task)
  Sched_starter S task body ,(start)
  Sched_enqueue S task start __NULL__ ,()
  __NULL__ task)

(define Sched_current ,()
  Sched_state ,(S)
  Sched_get S "current")

(define Sched_is_current ,(task)
  Sched_current ,(cur)
  __Dict_lookup_or__ cur "id" __print_exit_error__ ,(a)
  __Dict_lookup_or__ task "id" __print_exit_error__ ,(b)
  __Number_subtract__ a b ,(d)
  __Number_is_zero__ d)

;; 今の処理を止める：継続 k と処理だけの状態を覚える
(define Sched_suspend ,(S k state)
  Sched_get S "current" ,(task)
  __Dict_lookup_or__ S "save" __print_exit_error__ ,(save)
  save ,(local)
  Sched_set task "local" local ,()
  Sched_set task "k" k ,()
  Sched_set task "state" state ,()
  __NULL__ task)

(define Sched_wait ,(onError name args)
  Sched_state ,(S)
  __Host_start__ onError name args ,(s)
  (,()
    __Cont_get__ ,(k)
    Sched_suspend S k "waiting" ,(task)
    Sched_add S "pending" "1" ,()
    __Dict_lookup_or__ S "self" __print_exit_error__ ,(self)
    __Chan_of__ self ,(chan)
    __Chan_writer__ chan ,(w)
    __VProc_start__ (,() Sched_waiter task s w) ,(vp)
    Sched_next S) ,(r)
  __LList_uncons__ __print_exit_error__ r ,(ok more)
  __LList_uncons__ __print_exit_error__ more ,(payload more)
  Sched_set_running S ,()
  __NULL__ ok payload)

(define Sched_set_running ,(S)
  Sched_get S "current" ,(task)
  Sched_set task "state" "ready")

;; 待つための VProc：Stream s が読めるようになるのを待ち、結果を（処理、成否、値）でチャネルに入れる
(define Sched_waiter ,(task s w)
  __Cont_get__ ,(exit)
  __OS_wait_readable__ (,(msg) Sched_put w task __FALSE__ msg ,() exit) s ,()
  __Host_result__ (,(msg) Sched_put w task __FALSE__ msg ,() exit) s ,(v)
  Sched_put w task __TRUE__ v)

(define Sched_put ,(w task ok v)
  __LList_cons__ v __NULL__ ,(item)
  __LList_cons__ ok item ,(item)
  __LList_cons__ task item ,(item)
  __Chan_put__ (,() __nop__) w item ,()
  __Chan_close__ w)

(define Sched_join ,(task)
  __Cont_get__ ,(return)
  Sched_get task "state" ,(state)
  __String_equal__ state "done" ,(test__) __if__ test__
    (,()
      Sched_set task "joined" __TRUE__ ,()
      Sched_get task "ok" ,(ok)
      Sched_get task "payload" ,(payload)
      return ok payload) ,()
  Sched_state ,(S)
  (,()
    __Cont_get__ ,(k)
    Sched_suspend S k "waiting" ,(me)
    Sched_add S "blocked" "1" ,()
    Sched_get task "joiners" ,(l)
    __LList_cons__ me l ,(l)
    Sched_set task "joiners" l ,()
    Sched_next S) ,(r)
  __LList_uncons__ __print_exit_error__ r ,(ok more)
  __LList_uncons__ __print_exit_error__ more ,(payload more)
  Sched_set_running S ,()
  __NULL__ ok payload)

;; 処理が返した payload（Sched_run の failed の要素から）
(define Sched_payload ,(task)
  Sched_get task "payload")
