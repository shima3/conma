;; ConJS のランタイム（docs/dev/PLATFORM-PLAN-ja.md の 4.2 節。段階 P3b）。SJS のランタイム（sjs_rt.se）と
;; スケジューラ（include/lang/sched.se）をつなぎ、ConJS の大域の名前（spawn、join、host）を置く。変換したプログラムは、
;;   Sjs_init ,(G)
;;   Conjs_run G (,() 文の並び __nop__) ,()
;; の形で、ファイルの文の並び（main）を最初の処理として動かす。
;;
;; 処理（task）の SJS の値は Dict：「"t" は "task"、"id" は値の番号、"sched" はスケジューラの処理」
(include "sjs_rt.se")
(include "lang/sched.se")
(include "conjs_term.se")
(include "conjs_file.se")
(include "conjs_lib.se")
(include "conjs_class.se")
(include "conjs_host.se")

;; 処理だけの状態にする PDict の名前（sjs_rt.se）。try の受け手のスタック、動いているジェネレータ、投げた所の位置。
;; sjs_rt.se が処理ごとに持つべき名前を足したら、Conjs_save と Conjs_restore の両方に足す（M2 の PR shima3/conma#3 のレビューの 2）。
;; 処理が切り替わるたびに動くので、名前の LList を回さず、3 つを並べて書く（2026-11-25。それまでは、名前の LList を再帰で回し、
;; 値を Ref の箱に入れていて、切り替え 1 回に約 80 ステップかかっていた。tasks の 1 回のステップの約 6%）。
;; 取り出した状態は LList (sjs_handlers sjs_gen sjs_pos)。新しい処理（local が null）では、どれも null にする

(define Conjs_save ,()
  __PDict_lookup_or__ "sjs_pos" (,(x) __NULL__ __NULL__) ,(pos)
  __PDict_lookup_or__ "sjs_gen" (,(x) __NULL__ __NULL__) ,(gen)
  __PDict_lookup_or__ "sjs_handlers" (,(x) __NULL__ __NULL__) ,(handlers)
  __LList_cons__ pos __NULL__ ,(l)
  __LList_cons__ gen l ,(l)
  __LList_cons__ handlers l)

(define Conjs_restore ,(local)
  __Cont_get__ ,(return)
  __is_null__ local ,(fresh)
  __if__ fresh
    (,()
      __PDict_put__ "sjs_handlers" __NULL__ ,()
      __PDict_put__ "sjs_gen" __NULL__ ,()
      __PDict_put__ "sjs_pos" __NULL__ ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ local ,(handlers l)
  __LList_uncons__ __print_exit_error__ l ,(gen l)
  __LList_uncons__ __print_exit_error__ l ,(pos l)
  __PDict_put__ "sjs_handlers" handlers ,()
  __PDict_put__ "sjs_gen" gen ,()
  __PDict_put__ "sjs_pos" pos)

;; main（文の並びの thunk）を動かし、すべての処理が終わったら、join されなかった例外と行き詰まりを報告する
(define Conjs_run ,(G body)
  __Cont_get__ ,(return)
  __PDict_put__ "sjs_lang" "conjs" ,()
  Conjs_builtins G ,()
  Kit_sched_run (,() Conjs_save) (,(local) Conjs_restore local) body ,(blocked failed)
  ;; 端末の入力の道（conjs_term.se）を使ったなら、端末のモードを戻し、その VProc を止める
  __PDict_lookup_or__ "sjs_cleanup" (,(k) __NULL__ __NULL__) ,(cleanup)
  __is_null__ cleanup ,(test__) __unless__ test__ cleanup ,()
  Conjs_report failed __FALSE__ ,(bad)
  __Number_is_zero__ blocked ,(noDeadlock)
  __unless__ noDeadlock
    (,()
      Sjs_num_str blocked ,(n)
      __String_concat__ "conjs: Deadlock: tasks waiting in join: " n ,(msg)
      __String_concat__ msg "\n" ,(msg)
      __OS_print_error__ msg) ,()
  __not__ noDeadlock ,(dead)
  __or__ bad dead ,(test__) __unless__ test__ return ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __OS_exit__ __print_exit_error__ two)

;; 例外で終わり、join されなかった処理を、終わった順に「位置: Uncaught (in task) メッセージ」で出す。出したか
(define Conjs_report ,(failed bad)
  __Cont_get__ ,(return)
  __is_null__ failed ,(test__) __if__ test__ (,() return bad) ,()
  __LList_uncons__ __print_exit_error__ failed ,(t rest)
  Kit_sched_payload t ,(p)
  __LList_uncons__ __print_exit_error__ p ,(e more)
  __LList_uncons__ __print_exit_error__ more ,(pos more)
  Sjs_error_text e ,(text)
  __is_null__ pos ,(noPos)
  __if_then_else__ noPos (,() __NULL__ "conjs: ") (,() __String_concat__ pos ": ") ,(s)
  __String_concat__ s "Uncaught (in task) " ,(s)
  __String_concat__ s text ,(s)
  __String_concat__ s "\n" ,(s)
  __OS_print_error__ s ,()
  Conjs_report rest __TRUE__)

(define Conjs_builtins ,(G)
  Conjs_class_builtins G ,()
  Sjs_function G "spawn" (,(args) Sjs_arg args ,(f rest) Conjs_spawn G f) ,(spawn)
  __Dict_put__ G "spawn" spawn ,()
  Sjs_function G "join" (,(args) Sjs_arg args ,(t rest) Conjs_join t) ,(join)
  __Dict_put__ G "join" join ,()
  Sjs_object_new G ,(host)
  Sjs_def G host "call" (,(args) Conjs_host_call G args) ,()
  Sjs_def G host "wait" (,(args) Conjs_host_wait G args) ,()
  Sjs_def G host "available" (,(args) Sjs_arg args ,(f rest) Conjs_host_name "host.available" f ,() __Feature_available__ f) ,()
  __Dict_put__ G "host" host ,()
  Conjs_lib_builtins G ,()
  __Dict_remove__ G "Promise")

;; spawn(f)
(define Conjs_spawn ,(G f)
  Sjs_kind f ,(kind)
  __String_equal__ kind "function" ,(ok)
  __unless__ ok (,() Sjs_describe f ,(d) __String_concat__ "spawn: " d ,(m) __String_concat__ m " is not a function" ,(m) Sjs_type_error m) ,()
  Kit_sched_spawn (,() Conjs_task_body f) ,(st)
  Sjs_new_id G ,(id)
  __Dict_new__ ,(t)
  __Dict_put__ t "t" "task" ,()
  __Dict_put__ t "id" id ,()
  __Dict_put__ t "sched" st ,()
  __NULL__ t)

;; 処理の本体：f() を動かし、返した値か、投げた例外とその位置（LList (例外 位置)）を返す
(define Conjs_task_body ,(f)
  __Cont_get__ ,(return)
  Sjs_try
    (,() Sjs_call f __NULL__ ,(v) return __TRUE__ v)
    (,(e)
      __PDict_lookup_or__ "sjs_pos" (,(k) __NULL__ __NULL__) ,(pos)
      __LList_cons__ pos __NULL__ ,(p)
      __LList_cons__ e p ,(p)
      return __FALSE__ p))

;; join(t)
(define Conjs_join ,(t)
  __Cont_get__ ,(return)
  Sjs_kind t ,(kind)
  __String_equal__ kind "task" ,(ok)
  __unless__ ok (,() Sjs_describe t ,(d) __String_concat__ "join: " d ,(m) __String_concat__ m " is not a task" ,(m) Sjs_type_error m) ,()
  __Dict_lookup_or__ t "sched" __print_exit_error__ ,(st)
  Kit_sched_is_current st ,(self)
  __if__ self (,() Sjs_type_error "join: a task cannot join itself") ,()
  Kit_sched_join st ,(ok payload)
  __if__ ok (,() return payload) ,()
  __LList_uncons__ __print_exit_error__ payload ,(e more)
  __LList_uncons__ __print_exit_error__ more ,(pos more)
  __PDict_put__ "sjs_pos" pos ,()
  Sjs_reraise e)

;; ── ホスト ──

(define Conjs_host_name ,(what name)
  __Cont_get__ ,(return)
  Sjs_kind name ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__ return ,()
  Sjs_describe name ,(d)
  __String_concat__ what ": expected a string name, got " ,(m)
  __String_concat__ m d ,(m)
  Sjs_type_error m)

;; host.call(name, ...args)
(define Conjs_host_call ,(G args)
  Sjs_arg args ,(name rest)
  Conjs_host_name "host.call" name ,()
  Conjs_to_host_list "host.call" rest __NULL__ ,(list)
  __Host_call__ (,(msg) Sjs_throw "Error" msg) name list ,(r)
  Conjs_from_host G r)

;; host.wait(name, ...args)：結果が届くまで、この処理だけが待つ
(define Conjs_host_wait ,(G args)
  __Cont_get__ ,(return)
  Sjs_arg args ,(name rest)
  Conjs_host_name "host.wait" name ,()
  Conjs_to_host_list "host.wait" rest __NULL__ ,(list)
  Kit_sched_wait (,(msg) Sjs_throw "Error" msg) name list ,(ok payload)
  __unless__ ok (,() Sjs_throw "Error" payload) ,()
  Conjs_from_host G payload)

;; SJS の値の LList を、ホストに渡す値（数、文字列、真偽、Dict、それらの LList）の LList にする
;; （真偽と Dict は段階 P7。docs/dev/PLATFORM-PLAN-ja.md の 4.9 節）。path は、今たどっているオブジェクトと配列の id の LList
;; （自分を含む値は、たどり終わらないので TypeError にする。M2 の PR shima3/conma#26 のレビューの 1）
(define Conjs_to_host_list ,(what vs path)
  __Cont_get__ ,(return)
  __is_null__ vs ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ vs ,(v rest)
  Conjs_to_host what v path ,(h)
  Conjs_to_host_list what rest path ,(hs)
  __LList_cons__ h hs)

(define Conjs_to_host ,(what v path)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "number" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "string" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "boolean" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "array" ,(isArray)
  __String_equal__ kind "object" ,(isObject)
  __or__ isArray isObject ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ v "id" __print_exit_error__ ,(id)
      Conjs_host_seen id path ,(seen)
      __if__ seen
        (,()
          __String_concat__ what ": cannot pass an object that contains itself to the host" ,(m)
          Sjs_type_error m) ,()
      __LList_cons__ id path ,(inner)
      __if__ isArray (,() Sjs_array_list v ,(items) Conjs_to_host_list what items inner ,(l) return l) ,()
      ;; オブジェクトは、自分のプロパティだけ（Object.keys と同じ）の Dict にする。隠したキー（クラスの記録など）は渡さない
      Sjs_obj_keys v ,(keys) __Dict_new__ ,(d) Conjs_to_host_props what v keys d inner ,() return d) ,()
  Sjs_describe v ,(d)
  __String_concat__ what ": cannot pass " ,(m)
  __String_concat__ m d ,(m)
  __String_concat__ m " to the host (only numbers, strings, booleans, objects and arrays of them)" ,(m)
  Sjs_type_error m)

(define Conjs_host_seen ,(id path)
  __Cont_get__ ,(return)
  __is_null__ path ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ path ,(p rest)
  __Number_subtract__ p id ,(diff) __Number_is_zero__ diff ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Conjs_host_seen id rest)

(define Conjs_to_host_props ,(what o keys d path)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_obj_get o k ,(v)
  Conjs_to_host what v path ,(h)
  __Dict_put__ d k h ,()
  Conjs_to_host_props what o rest d path)

;; ホストが返した値を SJS の値にする：LList は配列、null は undefined、Dict はオブジェクト（数、文字列、真偽はそのまま）
(define Conjs_from_host ,(G r)
  __Cont_get__ ,(return)
  __type_name__ r ,(type)
  __String_equal__ type "Dict" ,(test__) __if__ test__
    (,()
      __Dict_keys__ r ,(keys)
      __Ref_new__ __NULL__ ,(acc)
      Sjs_collect acc ,(sink)
      keys sink ,(x)
      __Ref_get__ acc ,(ks)
      Sjs_reverse_list ks ,(ks)
      Sjs_object_new G ,(o)
      Conjs_from_host_props G r ks o ,()
      return o) ,()
  __String_equal__ type "LList" ,(test__) __unless__ test__ (,() return r) ,()
  Conjs_from_host_list G r ,(items)
  Sjs_array G items)

(define Conjs_from_host_props ,(G d keys o)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  __Dict_lookup_or__ d k __print_exit_error__ ,(h)
  Conjs_from_host G h ,(v)
  Sjs_obj_set o k v ,()
  Conjs_from_host_props G d rest o)

(define Conjs_from_host_list ,(G l)
  __Cont_get__ ,(return)
  __is_null__ l ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ l ,(x rest)
  Conjs_from_host G x ,(v)
  Conjs_from_host_list G rest ,(vs)
  __LList_cons__ v vs)
