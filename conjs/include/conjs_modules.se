;; ConJS の import と export（docs/dev/PLATFORM-PLAN-ja.md の 4.12 節。段階 P9）。変換器（conjs/conjsc.se）だけが include する。
;; sjs_gen.se の Sjs_translate_file は、ConJS のファイルの最上位に import か export があれば Gen_conjs_modules を呼ぶ。
;;
;; 作るもの：読み込まれるファイルごとに、関数 (define Conjs_mod_番号 ,(G X番号 ...) ...) を 1 つ。引数は大域のオブジェクト G と、
;; そのファイルが読み込むファイルの export の Dict（名前 → Ref）。関数は、ファイルの文を動かしてから、自分の export の Dict を
;; 返す。main は、読み込まれるファイルの関数を、深さ優先の帰りがけの順（JavaScript の ES Modules と同じ）に 1 度ずつ呼び、
;; そのあとで main のファイルの文を動かす。
;; * 名前はファイルごと：最上位の名前は、今の変換器でも Ref（関数の中の変数）なので、ファイルごとの関数にすれば分かれる。
;; * ライブバインディング：export は名前の Ref そのものを出し、import した名前は同じ Ref を指す。出した側が後で値を変えると、
;;   読み込んだ側にも見える。import した名前は const（代入すると、変換するときの「Assignment to constant variable.」）。
;; * 同じファイル：指定を読み込む側の realpath のディレクトリにつないだパスの realpath（__OS_realpath__）で見分ける。SInfo に書く名前は、
;;   main のファイルの名前のディレクトリに、たどった指定をつないだもの（realpath ではない）で、最初にたどった指定のもの。
;; * 循環、ないファイル、ない名前、2 度の export は、変換するときのエラー。

;; 最上位の文の LList に、import か export があるか
(define Gen_has_modules ,(stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Kit_parse_get s "t" ,(t)
  Kit_lex_in_words t "import export exportlist" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Gen_has_modules rest)

;; main のファイル（構文木 program、名前 file）を、読み込むファイルと合わせて ConMa のソースにする
(define Gen_conjs_modules ,(program file)
  __Dict_new__ ,(m)
  __Dict_new__ ,(mods)
  __Dict_put__ m "mods" mods ,()
  __Dict_new__ ,(visiting)
  __Dict_put__ m "visiting" visiting ,()
  __Ref_new__ __NULL__ ,(list)
  __Dict_put__ m "list" list ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(count)
  __Dict_put__ m "count" count ,()
  __Ref_new__ __NULL__ ,(path)
  __Dict_put__ m "path" path ,()
  __OS_realpath__ (,(msg) __NULL__ file) file ,(real)
  Gen_mod_visit m program file real ,()
  __Ref_get__ list ,(recs)
  Kit_lex_reverse recs ,(order)
  ;; 読み込まれるファイルの関数（深さ優先の帰りがけの順なので、読み込む先は先に作ってある）
  Gen_mod_defines order "" ,(defines)
  ;; main：読み込まれるファイルの関数を順に呼んでから、main のファイルの文
  Gen_mod_calls order "" ,(calls)
  Gen_unit program file ,(code params exports names)
  __String_concat__ calls code ,(code)
  Gen_conjs_program code ,(s)
  Kit_code_cat3 s "\n" defines)

;; program（名前 name、realpath real）の import をたどる。読み込まれるファイルを読み、構文木にし、先にたどってから、
;; 記録（Dict："id"、"name"、"program"）を m の "list" に足す。import の節の "rec" に、読み込む先の記録を入れる
(define Gen_mod_visit ,(m program name real)
  __Dict_lookup_or__ m "visiting" __print_exit_error__ ,(visiting)
  __Dict_put__ visiting real name ,()
  __Dict_lookup_or__ m "path" __print_exit_error__ ,(path)
  __Ref_get__ path ,(stack)
  __LList_cons__ name stack ,(stack2)
  __Ref_set__ path stack2 ,()
  Kit_parse_get program "body" ,(stmts)
  Gen_mod_imports m stmts name real ,()
  __Dict_put__ visiting real __NULL__ ,()
  __Ref_set__ path stack ,()
  __nop__)

(define Gen_mod_imports ,(m stmts name real)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Kit_parse_get s "t" ,(t)
  __String_equal__ t "import" ,(test__) __unless__ test__ (,() Gen_mod_imports m rest name real ,() return) ,()
  Kit_parse_get s "from" ,(spec)
  Gen_mod_find m spec name real ,(rec)
  __Dict_put__ s "rec" rec ,()
  Gen_mod_imports m rest name real)

;; name のファイル（realpath は base）の import の指定 spec が指すファイルの記録（なければ読んで、たどってから作る）。
;; 指定は、読み込む側の realpath のディレクトリにつないで探す（Node.js の ES Modules と同じ。読み込む側がシンボリックリンクでも、
;; 本物の隣のファイルを読む。M4 の shima3/conma#61 のレビューの 1）。SInfo に書く名前 target は、name のディレクトリにつないだもの
(define Gen_mod_find ,(m spec name base)
  __Cont_get__ ,(return)
  Kit_lex_starts_with spec "./" ,(a)
  Kit_lex_starts_with spec "../" ,(b)
  __or__ a b ,(test__) __unless__ test__
    (,() Kit_code_cat3 "Cannot import '" spec "': only a path that begins with './' or '../' can be imported in ConJS" ,(msg) Gen_error msg) ,()
  Gen_dirname name ,(dir)
  Gen_path_join dir spec ,(target)
  Gen_dirname base ,(rdir)
  Gen_path_join rdir spec ,(path)
  Kit_code_cat4 "Cannot find module '" spec "' imported from " name ,(missing)
  __OS_realpath__ (,(msg) Gen_error missing) path ,(real)
  __Dict_lookup_or__ m "visiting" __print_exit_error__ ,(visiting)
  __Dict_lookup_or__ visiting real (,(k) __NULL__ __NULL__) ,(cyc)
  __is_null__ cyc ,(test__) __unless__ test__
    (,()
      __Dict_lookup_or__ m "path" __print_exit_error__ ,(path)
      __Ref_get__ path ,(stack)
      Kit_lex_reverse stack ,(names)
      Gen_cycle_from names cyc ,(from)
      Gen_join_arrows from "" ,(chain)
      Kit_code_cat4 "import cycle: " chain " -> " target ,(msg)
      Gen_error msg) ,()
  __Dict_lookup_or__ m "mods" __print_exit_error__ ,(mods)
  __Dict_lookup_or__ mods real (,(k) __NULL__ __NULL__) ,(known)
  __is_null__ known ,(test__) __unless__ test__ (,() return known) ,()
  Gen_read_file real (,(msg) Gen_error missing) ,(text)
  Sjs_parse text ,(program)
  Gen_mod_visit m program target real ,()
  __Dict_lookup_or__ m "count" __print_exit_error__ ,(count)
  __Ref_get__ count ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ count n ,()
  __Number_toString__ n ,(id)
  __Dict_new__ ,(rec)
  __Dict_put__ rec "id" id ,()
  __Dict_put__ rec "name" target ,()
  __Dict_put__ rec "program" program ,()
  __Dict_put__ rec "spec" spec ,()
  __Dict_put__ mods real rec ,()
  __Dict_lookup_or__ m "list" __print_exit_error__ ,(list)
  __Ref_get__ list ,(recs)
  __LList_cons__ rec recs ,(recs)
  __Ref_set__ list recs ,()
  __NULL__ rec)

;; names（main から今のファイルまで）の、名前 first から後
(define Gen_cycle_from ,(names first)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  __String_equal__ n first ,(test__) __if__ test__ (,() return names) ,()
  Gen_cycle_from rest first)

(define Gen_join_arrows ,(names acc)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ n) (,() Kit_code_cat3 acc " -> " n) ,(acc)
  Gen_join_arrows rest acc)

;; ファイル path の中身（開けなければ onError）
(define Gen_read_file ,(path onError)
  __OS_open__ onError path "r" ,(stream)
  __LazyList_lines__ stream ,(lines)
  Gen_join_lines lines "" ,(text)
  __OS_close__ __print_exit_error__ stream ,()
  __NULL__ text)

(define Gen_join_lines ,(lines acc)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return acc) lines ,(line rest)
  __String_concat__ acc line ,(acc)
  Gen_join_lines rest acc)

;; ── パス ──

;; name の最後の / より前（/ がなければ ""）
(define Gen_dirname ,(name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Gen_last_slash name zero __NULL__ ,(at)
  __is_null__ at ,(test__) __if_then_else__ test__ (,() __NULL__ "") (,() __String_substring__ __print_exit_error__ name zero at))

(define Gen_last_slash ,(s from last)
  __Cont_get__ ,(return)
  __String_find__ __print_exit_error__ s "/" from ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() return last) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ at one ,(next)
  Gen_last_slash s next at)

;; dir（"" なら今のディレクトリ）に spec をつなぎ、. と .. の部分を除いたパス（文字の上だけで。realpath ではない）
(define Gen_path_join ,(dir spec)
  __String_equal__ dir "" ,(noDir)
  __if_then_else__ noDir (,() __NULL__ spec) (,() Kit_code_cat3 dir "/" spec) ,(p)
  Gen_split_slash p ,(parts)
  Gen_path_parts parts __NULL__ ,(stack)
  Kit_lex_reverse stack ,(kept)
  Gen_join_slash kept "" __TRUE__)

(define Gen_split_slash ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Gen_split_from s zero __NULL__ ,(acc)
  Kit_lex_reverse acc)

(define Gen_split_from ,(s from acc)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __String_find__ __print_exit_error__ s "/" from ,(at)
  __is_null__ at ,(test__) __if__ test__
    (,() __String_substring__ __print_exit_error__ s from len ,(part) __LList_cons__ part acc ,(acc) return acc) ,()
  __String_substring__ __print_exit_error__ s from at ,(part)
  __LList_cons__ part acc ,(acc)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ at one ,(next)
  Gen_split_from s next acc)

;; stack は、残す部分（後のものが先）
(define Gen_path_parts ,(parts stack)
  __Cont_get__ ,(return)
  __is_null__ parts ,(test__) __if__ test__ (,() return stack) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  __String_equal__ part "." ,(test__) __if__ test__ (,() Gen_path_parts rest stack ,(s) return s) ,()
  __String_equal__ part ".." ,(up)
  __unless__ up (,() __LList_cons__ part stack ,(stack) Gen_path_parts rest stack ,(s) return s) ,()
  ;; .. は、前の部分を消す。前がない、..、""（/ で始まるパスの頭）なら残す
  __is_null__ stack ,(empty)
  __if_then_else__ empty (,() __NULL__ __TRUE__)
    (,() __LList_uncons__ __print_exit_error__ stack ,(top more) __String_equal__ top ".." ,(a) __String_equal__ top "" ,(b) __or__ a b) ,(keep)
  __if_then_else__ keep (,() __LList_cons__ part stack) (,() __LList_uncons__ __print_exit_error__ stack ,(top more) __NULL__ more) ,(stack)
  Gen_path_parts rest stack)

(define Gen_join_slash ,(parts acc first)
  __Cont_get__ ,(return)
  __is_null__ parts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  __if_then_else__ first (,() __NULL__ part) (,() Kit_code_cat3 acc "/" part) ,(acc)
  Gen_join_slash rest acc __FALSE__)

;; ── 作るもの ──

;; 読み込まれるファイルの関数の定義
(define Gen_mod_defines ,(order acc)
  __Cont_get__ ,(return)
  __is_null__ order ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ order ,(rec rest)
  Kit_parse_get rec "program" ,(program)
  Kit_parse_get rec "name" ,(name)
  Kit_parse_get rec "id" ,(id)
  Gen_unit program name ,(code params exports names)
  __Dict_put__ rec "exports" names ,()
  __Dict_put__ rec "params" params ,()
  Kit_code_cat5 acc "(define Conjs_mod_" id " ,(G" params ,(acc)
  Kit_code_cat5 acc ")\n  " code exports ")\n" ,(acc)
  Gen_mod_defines rest acc)

;; main の始めに、読み込まれるファイルの関数を呼ぶ手順
(define Gen_mod_calls ,(order acc)
  __Cont_get__ ,(return)
  __is_null__ order ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ order ,(rec rest)
  Kit_parse_get rec "id" ,(id)
  Kit_parse_get rec "params" ,(params)
  Kit_code_cat5 acc "Conjs_mod_" id " G" params ,(acc)
  Kit_code_cat3 acc " ,(Xm" id ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_mod_calls rest acc)

;; 1 つのファイル（構文木 program、SInfo の名前 name）の、文の手順の並び code と、関数の引数の並び params（" Xm1 Xm2"）と、
;; export の Dict を作って返す手順 exports（main では使わない）。最上位の import と export を取り除き、import した名前を
;; 引数の Dict から取り、export する名前の Ref を Dict に入れる
(define Gen_unit ,(program name)
  Kit_parse_get program "body" ,(stmts)
  __Dict_new__ ,(seen)
  Gen_unit_strip stmts seen __NULL__ __NULL__ __NULL__ ,(body imports exports)
  ;; 取り除いた文の並びで、今の変換器と同じ手順（Sjs_translate_file）
  Kit_parse_node "program" ,(prog)
  __Dict_put__ prog "body" body ,()
  Wasm_prepare prog ,(wat)
  Gen_state prog ,(g)
  Kit_code_quote name ,(fq)
  __Dict_put__ g "file" fq ,()
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  __Dict_new__ ,(deps)
  Gen_unit_imports g scope imports deps "" "" ,(bind params)
  Gen_plain_marks scope body ,()
  Gen_unit_unplain top exports ,()
  Gen_cx __FALSE__ "" "" ,(cx)
  Gen_block_code_refs g scope body cx ,(code)
  Gen_const_code g ,(consts)
  __String_concat__ consts code ,(code)
  __String_equal__ wat "" ,(noWasm)
  __if_then_else__ noWasm (,() __NULL__ "") (,() Kit_code_quote wat ,(q) Kit_code_cat3 "\tSjs_wasm_module " q " ,(Wsjs) ") ,(wc)
  __String_concat__ wc code ,(code)
  Kit_code_replace_marks code "" ,(code)
  __String_concat__ bind code ,(code)
  Gen_unit_exports scope exports "__Dict_new__ ,(EX) " ,(ex)
  __String_concat__ ex "__NULL__ EX" ,(ex)
  __NULL__ code params ex seen)

;; 文から import と exportlist を除き、export の宣言を宣言にする。imports は import の節、exports は（出す名前、中の名前）の LList
(define Gen_unit_strip ,(stmts seen body imports exports)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__
    (,() Kit_lex_reverse body ,(b) Kit_lex_reverse imports ,(i) Kit_lex_reverse exports ,(e) return b i e) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Kit_parse_get s "t" ,(t)
  __String_equal__ t "import" ,(test__) __if__ test__
    (,() __LList_cons__ s imports ,(imports) Gen_unit_strip rest seen body imports exports ,(b i e) return b i e) ,()
  __String_equal__ t "exportlist" ,(test__) __if__ test__
    (,()
      Kit_parse_get s "specs" ,(specs)
      Gen_unit_export_specs specs seen exports ,(exports)
      Gen_unit_strip rest seen body imports exports ,(b i e)
      return b i e) ,()
  __String_equal__ t "export" ,(test__) __if__ test__
    (,()
      Kit_parse_get s "decl" ,(decl)
      Gen_decl_names decl ,(names)
      Gen_unit_export_names names seen exports ,(exports)
      __LList_cons__ decl body ,(body)
      Gen_unit_strip rest seen body imports exports ,(b i e)
      return b i e) ,()
  __LList_cons__ s body ,(body)
  Gen_unit_strip rest seen body imports exports)

;; 宣言（decl か funcdecl）の名前の LList
(define Gen_decl_names ,(decl)
  __Cont_get__ ,(return)
  Kit_parse_get decl "t" ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__
    (,() Kit_parse_get decl "name" ,(name) __LList_cons__ name __NULL__ ,(l) return l) ,()
  Kit_parse_get decl "decls" ,(decls)
  Gen_declarator_names decls __NULL__)

(define Gen_declarator_names ,(decls acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Kit_parse_get d "target" ,(target)
  Gen_pattern_names target acc ,(acc)
  Gen_declarator_names rest acc)

(define Gen_unit_export_names ,(names seen exports)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return exports) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Gen_unit_export_one name name seen exports ,(exports)
  Gen_unit_export_names rest seen exports)

(define Gen_unit_export_specs ,(specs seen exports)
  __Cont_get__ ,(return)
  __is_null__ specs ,(test__) __if__ test__ (,() return exports) ,()
  __LList_uncons__ __print_exit_error__ specs ,(sp rest)
  Kit_parse_get sp "local" ,(local)
  Kit_parse_get sp "exported" ,(exported)
  Gen_unit_export_one exported local seen exports ,(exports)
  Gen_unit_export_specs rest seen exports)

(define Gen_unit_export_one ,(exported local seen exports)
  __Dict_lookup_or__ seen exported (,(k) __NULL__ __FALSE__) ,(dup)
  __if__ dup (,() Kit_code_cat3 "Duplicate export of '" exported "'" ,(msg) Gen_error msg) ,()
  __Dict_put__ seen exported __TRUE__ ,()
  __LList_cons__ local __NULL__ ,(pair)
  __LList_cons__ exported pair ,(pair)
  __LList_cons__ pair exports)

;; import した名前を、読み込む先の export の Dict（引数 Xm番号）から取る手順と、引数の並び
(define Gen_unit_imports ,(g scope imports deps bind params)
  __Cont_get__ ,(return)
  __is_null__ imports ,(test__) __if__ test__ (,() return bind params) ,()
  __LList_uncons__ __print_exit_error__ imports ,(node rest)
  Kit_parse_get node "rec" ,(rec)
  Kit_parse_get rec "id" ,(id)
  __String_concat__ "Xm" id ,(x)
  __Dict_lookup_or__ deps x (,(k) __NULL__ __FALSE__) ,(had)
  __if_then_else__ had (,() __NULL__ params) (,() __Dict_put__ deps x __TRUE__ ,() Kit_code_cat3 params " " x) ,(params)
  Kit_parse_get node "specs" ,(specs)
  Kit_parse_get node "from" ,(spec)
  Gen_unit_import_specs g scope rec spec x specs bind ,(bind)
  Gen_unit_imports g scope rest deps bind params)

(define Gen_unit_import_specs ,(g scope rec spec x specs bind)
  __Cont_get__ ,(return)
  __is_null__ specs ,(test__) __if__ test__ (,() return bind) ,()
  __LList_uncons__ __print_exit_error__ specs ,(sp rest)
  Kit_parse_get sp "imported" ,(imported)
  Kit_parse_get sp "local" ,(local)
  Kit_parse_get rec "exports" ,(exported)
  __Dict_lookup_or__ exported imported (,(k) __NULL__ __FALSE__) ,(has)
  __unless__ has
    (,() Kit_code_cat5 "The requested module '" spec "' does not provide an export named '" imported "'" ,(msg) Gen_error msg) ,()
  __LList_cons__ local __NULL__ ,(names)
  Gen_check_redeclare scope names __TRUE__ ,()
  Kit_code_temp g "i" ,(t)
  Kit_code_cat3 t "_" local ,(var)
  __LList_uncons__ __print_exit_error__ scope ,(top outer)
  __Dict_put__ top local var ,()
  __String_concat__ "const:" local ,(ck)
  __Dict_put__ top ck __TRUE__ ,()
  Kit_code_quote imported ,(q)
  Kit_code_cat5 bind "__Dict_lookup_or__ " x " " q ,(bind)
  Kit_code_cat3 bind " __print_exit_error__ ,(" var ,(bind)
  __String_concat__ bind ") " ,(bind)
  Gen_unit_import_specs g scope rec spec x rest bind)

;; export する名前は、Ref のない const（Gen_plain_marks）にしない（Ref を出すため）
(define Gen_unit_unplain ,(top exports)
  __Cont_get__ ,(return)
  __is_null__ exports ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ exports ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(exported more)
  __LList_uncons__ __print_exit_error__ more ,(local none)
  __String_concat__ "plain:" local ,(pk)
  __Dict_put__ top pk __FALSE__ ,()
  Gen_unit_unplain top rest)

;; export の Dict に、出す名前と Ref を入れる手順
(define Gen_unit_exports ,(scope exports acc)
  __Cont_get__ ,(return)
  __is_null__ exports ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ exports ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(exported more)
  __LList_uncons__ __print_exit_error__ more ,(local none)
  Kit_code_lookup scope local ,(var isConst)
  __is_null__ var ,(test__) __if__ test__
    (,() Kit_code_cat3 "Export '" local "' is not defined in module" ,(msg) Gen_error msg) ,()
  Kit_code_quote exported ,(q)
  Kit_code_cat5 acc "__Dict_put__ EX " q " " var ,(acc)
  __String_concat__ acc " ,() " ,(acc)
  Gen_unit_exports scope rest acc)
