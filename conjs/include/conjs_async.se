;; ConJS の async 関数（docs/dev/CONJS-HOST-PLAN.md の 34 節。2026-11-26）：ファイルの一番外の async function の宣言は、
;; ConJS ではなく JavaScript で、ホスト（Node.js かブラウザ）で動く。変換器（conjs/conjsc.se だけが include する）の部分。
;; * Conjs_async_split（Sjs_parse_file が、字句を読んだ後に呼ぶ）：宣言を字句の段階で切り出し、ホストの関数を host.wait で
;;   呼ぶ ConJS の関数 function 名前(...args) { return host.wait("conjs.async:ファイル:名前", ...args); } の字句に置き換える。
;;   呼び出し、値としての使い方、export と import は、ふつうの ConJS の関数と同じになる。
;; * Conjs_async_finish（構文木ができた後）：本体を、名前を確かめない構文解析で読み、大域の名前（本体の自由な名前）を
;;   sjs_gen.se の生成で集め（Gen_note_free）、プログラムの名前と ConJS の名前を使っていないか確かめる。ソースの文字列を、
;;   行と桁がソースと同じになるように並べた JavaScript を作り、PDict の "conjs_async_js" に足す。
;; * Conjs_async_code（Gen_conjs_program）：プログラムの始めに、ファイルごとに Conjs_async_define（conjs/include/conjs_host.se）
;;   を呼ぶ手順。ホストは、テキストを __JS_fn_compile__ で作り、関数を rt.defineHost でホストの関数に足す（vm/wasm/conma.js）

;; ConJS の名前のうち、ホストにないもの（本体で使えば誤り）。setTimeout、Date、fetch、console はホストにもあり、本体では
;; ホストのものになる
(define Conjs_async_conjs_names ,()
  __NULL__ "spawn join host sleep nextEvent pollEvent http argv fs")

;; toks（Sjs_lex の字句）から、一番外の async function の宣言を切り出す。返すのは、置き換えた字句と、宣言の記録の LList
;; （現れた順。なければ null）。file はファイルの名前で、realpath を、ホストの関数の名前と require の基にする
(define Conjs_async_split ,(toks text file)
  __OS_realpath__ (,(msg) __NULL__ file) file ,(real)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Conjs_async_scan toks __NULL__ zero __NULL__ __NULL__ text real ,(acc regions)
  Kit_lex_reverse acc ,(out)
  Kit_lex_reverse regions ,(regions)
  __NULL__ out regions)

;; acc は逆順の字句、regions は逆順の記録、depth は ( [ { の深さ、prev は前の字句
(define Conjs_async_scan ,(toks prev depth acc regions text real)
  __Cont_get__ ,(return)
  __is_null__ toks ,(test__) __if__ test__ (,() return acc regions) ,()
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  Conjs_async_at tok rest prev depth ,(isDecl)
  __if__ isDecl
    (,()
      __Number_fromString__ __print_exit_error__ "0" ,(zero)
      Conjs_async_take toks zero __NULL__ ,(region after)
      Conjs_async_record region text real ,(rec)
      Conjs_async_stub rec ,(stub)
      Kit_lex_reverse_onto stub acc ,(acc)
      __LList_cons__ rec regions ,(regions)
      Kit_lex_reverse region ,(back)
      __LList_uncons__ __print_exit_error__ back ,(last more)
      Conjs_async_scan after last depth acc regions text real ,(a r)
      return a r) ,()
  Conjs_async_depth tok depth ,(depth)
  __LList_cons__ tok acc ,(acc)
  Conjs_async_scan rest tok depth acc regions text real)

;; tok が、一番外の文の始めの async function 名前 か（async と function は同じ行。async function* は違う）
(define Conjs_async_at ,(tok rest prev depth)
  __Cont_get__ ,(return)
  __Number_is_zero__ depth ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Kit_lex_tok_text tok ,(text)
  __String_equal__ text "async" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __is_null__ rest ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ rest ,(next more)
  Kit_parse_tok_is next "function" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Kit_lex_tok_nl next ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __is_null__ more ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ more ,(nameTok more2)
  Kit_lex_tok_kind nameTok ,(nk)
  __String_equal__ nk "id" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __is_null__ prev ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Kit_parse_tok_is prev ";" ,(a)
  Kit_parse_tok_is prev "}" ,(b)
  Kit_parse_tok_is prev "export" ,(c)
  __or__ a b ,(ab)
  __or__ ab c)

(define Conjs_async_depth ,(tok depth)
  __Cont_get__ ,(return)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "punct" ,(test__) __unless__ test__ (,() return depth) ,()
  Kit_lex_tok_text tok ,(t)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Kit_lex_in_words t "( [ {" ,(test__) __if__ test__ (,() __Number_add__ depth one ,(d) return d) ,()
  Kit_lex_in_words t ") ] }" ,(test__) __if__ test__ (,() __Number_subtract__ depth one ,(d) return d) ,()
  __NULL__ depth)

;; 宣言の字句（async から、本体を閉じる } まで。順に）と、その後の字句。本体が閉じなければ、eof の前まで（構文解析が誤りにする）
(define Conjs_async_take ,(toks depth acc)
  __Cont_get__ ,(return)
  __is_null__ toks ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(r) return r __NULL__) ,()
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(r) return r toks) ,()
  __LList_cons__ tok acc ,(acc)
  Conjs_async_depth tok depth ,(d)
  Kit_parse_tok_is tok "}" ,(close)
  __Number_is_zero__ d ,(zero)
  __and__ close zero ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(r) return r rest) ,()
  Conjs_async_take rest d acc)

;; 宣言の記録（Dict）："name"、"key"（ホストの関数の名前）、"file"（realpath）、"tok"（async の字句）、"toks"（構文解析する字句。
;; eof を足したもの）、"js"（ソースの文字列）、"line" と "col"（async の行と桁。Number）
(define Conjs_async_record ,(region text real)
  __LList_uncons__ __print_exit_error__ region ,(asyncTok r1)
  __LList_uncons__ __print_exit_error__ r1 ,(fnTok r2)
  __LList_uncons__ __print_exit_error__ r2 ,(nameTok r3)
  Kit_lex_tok_text nameTok ,(name)
  Kit_lex_reverse region ,(back)
  __LList_uncons__ __print_exit_error__ back ,(last more)
  Kit_lex_tok_line asyncTok ,(ls)
  Kit_lex_tok_col asyncTok ,(cs)
  Conjs_async_offset ls cs ,(start)
  Kit_lex_tok_line last ,(els)
  Kit_lex_tok_col last ,(ecs)
  Conjs_async_offset els ecs ,(endAt)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ endAt one ,(endAt)
  __String_substring__ __print_exit_error__ text start endAt ,(js)
  __Number_fromString__ __print_exit_error__ els ,(eline)
  Kit_lex_tok "eof" "" __TRUE__ eline "1" ,(eof)
  __LList_cons__ eof __NULL__ ,(tail)
  Kit_lex_reverse_onto back tail ,(toks)
  Conjs_async_key real name ,(key)
  __Number_fromString__ __print_exit_error__ ls ,(line)
  __Number_fromString__ __print_exit_error__ cs ,(col)
  __Dict_new__ ,(rec)
  __Dict_put__ rec "name" name ,()
  __Dict_put__ rec "key" key ,()
  __Dict_put__ rec "file" real ,()
  __Dict_put__ rec "tok" asyncTok ,()
  __Dict_put__ rec "toks" toks ,()
  __Dict_put__ rec "js" js ,()
  __Dict_put__ rec "line" line ,()
  __Dict_put__ rec "col" col ,()
  __NULL__ rec)

(define Conjs_async_key ,(real name)
  __String_concat__ "conjs.async:" real ,(k)
  __String_concat__ k ":" ,(k)
  __String_concat__ k name)

;; 行 ls と桁 cs（String。1 から）の、テキストの中の位置（Sjs_lex が PDict に置く行の始まりの位置から）
(define Conjs_async_offset ,(ls cs)
  __PDict_lookup_or__ "kit_lex_starts" __print_exit_error__ ,(starts)
  __Dict_lookup_or__ starts ls (,(k) __Number_fromString__ __print_exit_error__ "0") ,(lineStart)
  __Number_fromString__ __print_exit_error__ cs ,(c)
  __Number_add__ lineStart c ,(at)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ at one)

;; 置き換える字句：function 名前(...args) { return host.wait("キー", ...args); }。位置は、どれも async の字句の位置
;; （拒否のエラーの位置は、この行になる）
(define Conjs_async_stub ,(rec)
  Kit_parse_get rec "name" ,(name)
  Kit_parse_get rec "key" ,(key)
  Kit_parse_get rec "tok" ,(at)
  Kit_lex_tok_nl at ,(nl)
  Kit_lex_tok_line at ,(ls)
  __Number_fromString__ __print_exit_error__ ls ,(line)
  Kit_lex_tok_col at ,(col)
  Kit_lex_tok "id" "function" nl line col ,(t1)
  __NULL__ (,(kind text) Kit_lex_tok kind text __FALSE__ line col) ,(mk)
  mk "id" name ,(t2)
  mk "punct" "(" ,(t3)
  mk "punct" "..." ,(t4)
  mk "id" "args" ,(t5)
  mk "punct" ")" ,(t6)
  mk "punct" "{" ,(t7)
  mk "id" "return" ,(t8)
  mk "id" "host" ,(t9)
  mk "punct" "." ,(t10)
  mk "id" "wait" ,(t11)
  mk "punct" "(" ,(t12)
  mk "str" key ,(t13)
  mk "punct" "," ,(t14)
  mk "punct" "..." ,(t15)
  mk "id" "args" ,(t16)
  mk "punct" ")" ,(t17)
  mk "punct" ";" ,(t18)
  mk "punct" "}" ,(t19)
  __LList_cons__ t19 __NULL__ ,(l)
  __LList_cons__ t18 l ,(l) __LList_cons__ t17 l ,(l) __LList_cons__ t16 l ,(l) __LList_cons__ t15 l ,(l)
  __LList_cons__ t14 l ,(l) __LList_cons__ t13 l ,(l) __LList_cons__ t12 l ,(l) __LList_cons__ t11 l ,(l)
  __LList_cons__ t10 l ,(l) __LList_cons__ t9 l ,(l) __LList_cons__ t8 l ,(l) __LList_cons__ t7 l ,(l)
  __LList_cons__ t6 l ,(l) __LList_cons__ t5 l ,(l) __LList_cons__ t4 l ,(l) __LList_cons__ t3 l ,(l)
  __LList_cons__ t2 l ,(l) __LList_cons__ t1 l)

;; 構文木 program ができた後：宣言ごとに本体の名前を確かめ、ファイルの JavaScript を "conjs_async_js" に足す
(define Conjs_async_finish ,(program regions)
  Kit_parse_get program "body" ,(top)
  __Dict_new__ ,(names)
  Conjs_async_top_names top names ,()
  __Dict_new__ ,(own)
  Conjs_async_own regions own ,()
  Conjs_async_check_all regions names own ,()
  __LList_uncons__ __print_exit_error__ regions ,(first more)
  Kit_parse_get first "file" ,(real)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Conjs_async_text regions one "" ,(js)
  Kit_code_quote real ,(rq)
  Kit_code_cat3 js "\n;const { require, console } = rt.asyncScope(" rq ,(js)
  __String_concat__ js ");\n" ,(js)
  Conjs_async_defines regions js ,(js)
  Kit_code_cat3 js "return {};\n//# sourceURL=" real ,(js)
  __String_concat__ js "\n" ,(js)
  __Dict_new__ ,(d)
  __Dict_put__ d "file" real ,()
  __Dict_put__ d "js" js ,()
  __PDict_lookup_or__ "conjs_async_js" (,(k) __NULL__ __NULL__) ,(all)
  __LList_cons__ d all ,(all)
  __PDict_put__ "conjs_async_js" all)

;; 一番外で宣言した名前（変数、関数、クラス、import した名前、export した宣言の名前）を names に入れる
(define Conjs_async_top_names ,(stmts names)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Kit_parse_get s "t" ,(t)
  Kit_lex_in_words t "decl funcdecl" ,(test__) __if__ test__ (,() Gen_decl_names s ,(l) Conjs_async_put_all l names) ,()
  __String_equal__ t "export" ,(test__) __if__ test__ (,() Kit_parse_get s "decl" ,(d) Gen_decl_names d ,(l) Conjs_async_put_all l names) ,()
  __String_equal__ t "import" ,(test__) __if__ test__ (,() __LList_cons__ s __NULL__ ,(one) Gen_import_locals one __NULL__ ,(l) Conjs_async_put_all l names) ,()
  Conjs_async_top_names rest names)

(define Conjs_async_put_all ,(list names)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __Dict_put__ names x __TRUE__ ,()
  Conjs_async_put_all rest names)

;; このファイルの async 関数の名前（本体から呼べる）
(define Conjs_async_own ,(regions own)
  __Cont_get__ ,(return)
  __is_null__ regions ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ regions ,(rec rest)
  Kit_parse_get rec "name" ,(name)
  __Dict_put__ own name __TRUE__ ,()
  Conjs_async_own rest own)

(define Conjs_async_check_all ,(regions names own)
  __Cont_get__ ,(return)
  __is_null__ regions ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ regions ,(rec rest)
  Conjs_async_free_names rec ,(free)
  Kit_parse_get rec "name" ,(fname)
  Conjs_async_check fname free names own ,()
  Conjs_async_check_all rest names own)

;; 宣言の本体を、名前を確かめずに読み、その生成で現れる大域の名前（本体の自由な名前）の LList
(define Conjs_async_free_names ,(rec)
  Kit_parse_get rec "toks" ,(toks)
  __PDict_put__ "sjs_js_body" __TRUE__ ,()
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_statements p "" __NULL__ ,(body)
  __PDict_put__ "sjs_js_body" __FALSE__ ,()
  Kit_parse_node "program" ,(prog)
  __Dict_put__ prog "body" body ,()
  Gen_state prog ,(g)
  __Dict_put__ g "file" "\"\"" ,()
  __Dict_new__ ,(free)
  __Dict_put__ g "free" free ,()
  __Dict_new__ ,(topScope)
  __LList_cons__ topScope __NULL__ ,(scope)
  Gen_cx __FALSE__ "" "" ,(cx)
  Gen_block_code g scope body cx ,(code)
  __Dict_keys__ free ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  Gen_collect acc ,(sink)
  keys sink ,(s)
  __Ref_get__ acc)

(define Conjs_async_check ,(fname free names own)
  __Cont_get__ ,(return)
  __is_null__ free ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ free ,(name rest)
  __Dict_lookup_or__ own name (,(k) __NULL__ __FALSE__) ,(isOwn)
  __Dict_lookup_or__ names name (,(k) __NULL__ __FALSE__) ,(isTop)
  Conjs_async_conjs_names ,(cn)
  Kit_lex_in_words name cn ,(isConjs)
  __or__ isTop isConjs ,(bad)
  __not__ isOwn ,(notOwn)
  __and__ bad notOwn ,(test__) __if__ test__
    (,()
      Kit_code_cat4 "the async function " fname " runs on the host and cannot use " name ,(msg)
      __String_concat__ msg " of the program" ,(msg)
      Sjs_uncaught msg) ,()
  Conjs_async_check fname rest names own)

;; 宣言のソースの文字列を、行と桁がソースと同じになるように並べる。テキストは new Function の本体になり、その前に
;; 2 行（function anonymous(rt と ) {）がつくので、ソースの行 L の宣言は、テキストの行 L - 2 に置く（ソースの 1、2 行目の
;; 宣言は、テキストの 1 行目に置くので、行がずれる）。at は、次に書くテキストの行
(define Conjs_async_text ,(regions at acc)
  __Cont_get__ ,(return)
  __is_null__ regions ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ regions ,(rec rest)
  Kit_parse_get rec "line" ,(line)
  Kit_parse_get rec "col" ,(col)
  Kit_parse_get rec "js" ,(js)
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ line two ,(want)
  __Number_subtract__ want at ,(diff)
  __Number_is_negative__ diff ,(early)
  __if_then_else__ early (,() __NULL__ at) (,() __NULL__ want) ,(target)
  __Number_subtract__ target at ,(nls)
  Conjs_async_repeat "\n" nls acc ,(acc)
  __Number_subtract__ col one ,(spaces)
  Conjs_async_repeat " " spaces acc ,(acc)
  __String_concat__ acc js ,(acc)
  Conjs_async_count_nl js ,(n)
  __Number_add__ target n ,(at)
  ;; 次の宣言は、改行してから
  __String_concat__ acc "\n" ,(acc)
  __Number_add__ at one ,(at)
  Conjs_async_text rest at acc)

(define Conjs_async_repeat ,(s n acc)
  __Cont_get__ ,(return)
  __Number_is_positive__ n ,(test__) __unless__ test__ (,() return acc) ,()
  __String_concat__ acc s ,(acc)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  Conjs_async_repeat s n acc)

(define Conjs_async_count_nl ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Conjs_async_count_from s zero zero)

(define Conjs_async_count_from ,(s i n)
  __Cont_get__ ,(return)
  __String_find__ __print_exit_error__ s "\n" i ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() return n) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ at one ,(i)
  __Number_add__ n one ,(n)
  Conjs_async_count_from s i n)

;; rt.defineHost("キー", 名前); を宣言ごとに
(define Conjs_async_defines ,(regions acc)
  __Cont_get__ ,(return)
  __is_null__ regions ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ regions ,(rec rest)
  Kit_parse_get rec "key" ,(key)
  Kit_parse_get rec "name" ,(name)
  Kit_code_quote key ,(kq)
  Kit_code_cat5 acc "rt.defineHost(" kq ", " name ,(acc)
  __String_concat__ acc ");\n" ,(acc)
  Conjs_async_defines rest acc)

;; プログラムの始めの手順：async 関数のあるファイルごとに Conjs_async_define ファイル テキスト
(define Conjs_async_code ,()
  __PDict_lookup_or__ "conjs_async_js" (,(k) __NULL__ __NULL__) ,(all)
  Kit_lex_reverse all ,(all)
  Conjs_async_code_from all "")

(define Conjs_async_code_from ,(all acc)
  __Cont_get__ ,(return)
  __is_null__ all ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ all ,(d rest)
  Kit_parse_get d "file" ,(file)
  Kit_parse_get d "js" ,(js)
  Kit_code_quote file ,(fq)
  Kit_code_quote js ,(jq)
  Kit_code_cat5 acc "\tConjs_async_define " fq " " jq ,(acc)
  __String_concat__ acc " ,() " ,(acc)
  Conjs_async_code_from rest acc)
