  __is_null__ s ,(test__) __if__ test__ (,() return __NULL__) ,()
  Conjs_shell_zero ,(zero) Conjs_shell_one ,(one)
  __String_length__ s ,(len)
  __Number_if_greater__ one len (,() return __NULL__) ,()
  __String_substring__ __print_exit_error__ s zero one ,(c)
  __String_equal__ c "$" ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __String_substring__ __print_exit_error__ s one len ,(name)
  Conjs_shell_is_name name ,(ok)
  __unless__ ok (,() return __NULL__) ,()
  __NULL__ name)

;; 文字だけの語（部分が "s" の 1 つ）の文字。そうでなければ null
(define Conjs_shell_plain ,(parts)
  __Cont_get__ ,(return)
  __is_null__ parts ,(test__) __if__ test__ (,() return "") ,()
  __LList_uncons__ __print_exit_error__ parts ,(p more)
  __is_null__ more ,(one)
  __unless__ one (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ p ,(kind rest)
  __String_equal__ kind "s" ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ rest ,(s x)
  __NULL__ s)

;; 引数の語と、リダイレクト。返すのは、引数のコード（", " で区切る）、入力、出力、出力の用意
(define Conjs_shell_args ,(words n col list input output err setup finish)
  __Cont_get__ ,(return)
  __is_null__ words ,(test__) __if__ test__ (,() return list input output err setup finish) ,()
  __LList_uncons__ __print_exit_error__ words ,(w rest)
  __LList_uncons__ __print_exit_error__ w ,(parts more)
  __LList_uncons__ __print_exit_error__ more ,(quoted x)
  Conjs_shell_plain parts ,(plain)
  __is_null__ plain ,(notPlain)
  __if_then_else__ notPlain (,() __NULL__ "") (,() __NULL__ plain) ,(plain)
  __String_equal__ plain "<$" ,(isIn) __String_equal__ plain ">$" ,(isOut) __String_equal__ plain ">>$" ,(isAppend)
  __String_equal__ plain "2>$" ,(isErr)
  __or__ isIn isOut ,(isRedir) __or__ isRedir isAppend ,(isRedir) __or__ isRedir isErr ,(isRedir)
  __not__ quoted ,(unq)
  __and__ isRedir unq ,(isRedir)
  __if__ isRedir
    (,()
      __is_null__ rest ,(test__) __if__ test__ (,() Kit_code_cat3 plain " needs the name of a variable" "" ,(m) Conjs_shell_error n col m) ,()
      __LList_uncons__ __print_exit_error__ rest ,(nw rest2)
      __LList_uncons__ __print_exit_error__ nw ,(nparts nmore)
      __LList_uncons__ __print_exit_error__ nmore ,(nquoted x)
      Conjs_shell_plain nparts ,(name)
      __is_null__ name ,(test__) __if_then_else__ test__ (,() __NULL__ "") (,() __NULL__ name) ,(name)
      ;; >$ [a, b, ...r] と 2>$ [...]：コマンドが終わったら、行の配列を分割代入する（20 節）。行の間は、形の初めの名前に
      ;; キューを入れ、後で [a, b, ...r] = [...a]; とする（右辺を先に読むので、一時の名前は要らない）
      Conjs_shell_zero ,(zero) Conjs_shell_one ,(one)
      __String_length__ name ,(nlen) __Number_is_zero__ nlen ,(empty)
      __if_then_else__ empty (,() __NULL__ "") (,() __String_substring__ __print_exit_error__ name zero one) ,(c0)
      __String_equal__ c0 "[" ,(isPat) __not__ nquoted ,(nunq) __and__ isPat nunq ,(isPat)
      __or__ isOut isErr ,(canPat) __and__ isPat canPat ,(isPat)
      __if_then_else__ isPat
        (,()
          Conjs_shell_pattern_words rest "" n col ,(text rest)
          Conjs_shell_pattern text n col ,(code first)
          Kit_code_cat5 finish code " = [..." first "]; " ,(finish)
          __NULL__ first rest finish)
        (,()
          Conjs_shell_is_name name ,(ok)
          __unless__ ok (,() Kit_code_cat3 plain " needs the name of a variable, not " name ,(m) Conjs_shell_error n col m) ,()
          __NULL__ name rest2 finish) ,(name rest finish)
      __if__ isIn
        (,()
          __String_equal__ input "false" ,(free) __unless__ free (,() Conjs_shell_error n col "more than one <$") ,()
          Conjs_shell_args rest n col list name output err setup finish ,(a b c d e f) return a b c d e f) ,()
      ;; 2>$：標準エラーの行を、新しいキューに（段階 S3）
      __if__ isErr
        (,()
          __String_equal__ err "false" ,(free) __unless__ free (,() Conjs_shell_error n col "more than one 2>$") ,()
          Kit_code_cat3 setup name " = new Queue(); " ,(setup)
          Conjs_shell_args rest n col list input output name setup finish ,(a b c d e f) return a b c d e f) ,()
      __String_equal__ output "false" ,(free) __unless__ free (,() Conjs_shell_error n col "more than one >$ or >>$") ,()
      __if_then_else__ isOut
        (,() Kit_code_cat3 setup name " = new Queue(); ")
        (,() Kit_code_cat5 setup name " = new Queue(" name "); ") ,(setup)
      Conjs_shell_args rest n col list input name err setup finish ,(a b c d e f)
      return a b c d e f) ,()
  ;; 引用符の外の < と > は、<$ >$ >>$ のほかは誤り（ファイルへのリダイレクトはない）
  __unless__ quoted
    (,()
      Conjs_shell_zero ,(zero)
      __String_find_any__ __print_exit_error__ plain "<>" zero ,(lt)
      __is_null__ lt ,(test__) __unless__ test__
        (,() __String_concat__ plain ": only <$, >$, >>$ and 2>$ redirect, to and from variables" ,(m) Conjs_shell_error n col m) ,()) ,()
  Conjs_shell_word_code parts ,(code)
  __String_equal__ list "" ,(firstArg)
  __if_then_else__ firstArg (,() __NULL__ code) (,() Kit_code_cat3 list ", " code) ,(list)
  Conjs_shell_args rest n col list input output err setup finish)

;; >$ と 2>$ の後の [ から ] まで（空白で分かれた語をつなぐ）：返すのは、その文字と、残りの語
(define Conjs_shell_pattern_words ,(words text n col)
  __Cont_get__ ,(return)
  __is_null__ words ,(test__) __if__ test__ (,() Conjs_shell_error n col "[ without ] after >$ or 2>$") ,()
  __LList_uncons__ __print_exit_error__ words ,(w rest)
  __LList_uncons__ __print_exit_error__ w ,(parts more)
  __LList_uncons__ __print_exit_error__ more ,(quoted x)
  Conjs_shell_plain parts ,(plain)
  __is_null__ plain ,(bad) __or__ bad quoted ,(bad)
  __if__ bad (,() Conjs_shell_error n col "the pattern after >$ or 2>$ has names, commas and ... only") ,()
  __String_equal__ text "" ,(first)
  __if_then_else__ first (,() __NULL__ plain) (,() Kit_code_cat3 text " " plain) ,(text)
  __String_length__ plain ,(len)
  Conjs_shell_one ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ plain last len ,(c)
  __String_equal__ c "]" ,(done)
  __if__ done (,() return text rest) ,()
  Conjs_shell_pattern_words rest text n col)

;; [a, , b, ...r] を確かめる：要素は、空、名前、または最後の ...名前。返すのは、ConJS のコードと、初めの名前
(define Conjs_shell_pattern ,(text n col)
  __Cont_get__ ,(return)
  __String_length__ text ,(len)
  Conjs_shell_one ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ text one last ,(inner)
  Conjs_shell_pattern_items inner n col __NULL__ __NULL__ ,(code first)
  __is_null__ first ,(test__) __if__ test__ (,() Conjs_shell_error n col "the pattern after >$ or 2>$ needs a name") ,()
  Kit_code_cat3 "[" code "]" ,(code)
  __NULL__ code first)

(define Conjs_shell_pattern_items ,(inner n col code first)
  ;; code は、まだ要素がなければ null（初めの要素が穴の空文字でも、区切りを落とさない）
  __Cont_get__ ,(return)
  Conjs_shell_zero ,(zero)
  Conjs_shell_one ,(one)
  __String_length__ inner ,(len)
  __String_find_any__ __print_exit_error__ inner "," zero ,(comma)
  __is_null__ comma ,(isLast)
  __if_then_else__ isLast (,() __NULL__ len) (,() __NULL__ comma) ,(end)
  __String_substring__ __print_exit_error__ inner zero end ,(item)
  Conjs_shell_trim item ,(item)
  __String_length__ item ,(ilen)
  __Number_is_zero__ ilen ,(hole)
  __String_find__ __print_exit_error__ item "..." zero ,(dots)
  __is_null__ dots ,(test__) __not__ test__ ,(hasDots)
  __if_then_else__ hasDots
    (,()
      Conjs_shell_zero ,(z) __Number_subtract__ dots z ,(d) __Number_is_zero__ d ,(atStart)
      __unless__ atStart (,() Conjs_shell_error n col "the pattern after >$ or 2>$ has names, commas and ... only") ,()
      __unless__ isLast (,() Conjs_shell_error n col "... is only for the last name of the pattern after >$ or 2>$") ,()
      Conjs_shell_three ,(three)
      __String_substring__ __print_exit_error__ item three ilen)
    (,() __NULL__ item) ,(name)
  __unless__ hole
    (,()
      Conjs_shell_is_name name ,(ok)
      __unless__ ok (,() Kit_code_cat3 "the pattern after >$ or 2>$ has names, commas and ... only, not " item "" ,(m) Conjs_shell_error n col m) ,()) ,()
  __is_null__ first ,(noFirst) __not__ hole ,(isName) __and__ noFirst isName ,(take)
  __if_then_else__ take (,() __NULL__ name) (,() __NULL__ first) ,(first)
  __is_null__ code ,(none)
  __if_then_else__ none (,() __NULL__ item) (,() Kit_code_cat3 code ", " item) ,(code)
  __if__ isLast (,() return code first) ,()
  __Number_add__ comma one ,(next)
  __String_substring__ __print_exit_error__ inner next len ,(inner)
  Conjs_shell_pattern_items inner n col code first)

;; 語のコード："文字"、String(名前)、または [..].join("")（4 節：値は String(x) と同じく文字列にする。D2）
(define Conjs_shell_word_code ,(parts)
  __Cont_get__ ,(return)
  __is_null__ parts ,(test__) __if__ test__ (,() return "\"\"") ,()
  __LList_uncons__ __print_exit_error__ parts ,(p more)
  __is_null__ more ,(single)
  __if__ single (,() Conjs_shell_part_code p ,(c) return c) ,()
  Conjs_shell_parts_code parts "" ,(inner)
  Kit_code_cat3 "[" inner "].join(\"\")")

(define Conjs_shell_parts_code ,(parts acc)
  __Cont_get__ ,(return)
  __is_null__ parts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ parts ,(p rest)
  Conjs_shell_part_code p ,(c)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ c) (,() Kit_code_cat3 acc ", " c) ,(acc)
  Conjs_shell_parts_code rest acc)

(define Conjs_shell_part_code ,(p)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ p ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(s x)
  __String_equal__ kind "s" ,(test__) __if__ test__ (,() Kit_code_quote s ,(q) return q) ,()
  Kit_code_cat3 "String(" s ")")

;; ── ファイルの終わりに足す関数（ConJS）──
(define Conjs_shell_prelude ,()
  __String_join_lines__
    "// the command lines of this file (conjs/include/conjs_shell.se)"
    "// The input of a command: false (the standard input), an array or an object of the host as it is, else"
    "// (a generator of the VM) a Queue that a task fills, waiting while 64 are in it and stopping when the"
    "// queue is closed (M1's review of shima3/conma#96)"
    "function conjs_sh_input(input) {"
    "  if (input === false || conjs_sh_direct(input)) return input;"
    "  const src = input;"
    "  const q = new Queue();"
    "  spawn(() => {"
    "    try {"
    "      for (const x of src) {"
    "        if (q.closed) break;"
    "        q.push(x);"
    "        q.room();"
    "      }"
    "    } finally {"
    "      q.close();"
    "    }"
    "  });"
    "  return q;"
    "}"
    "// An error that the line does not throw (one that || takes, or one before the last command of a pipeline) goes"
    "// to the standard error, as Bash writes \"command not found\" and a function writes its own; a CommandError"
    "// does not, since its command has written to the standard error itself (section 18)"
    "function conjs_sh_report(e) {"
    "  if (e instanceof Error && e.name === \"CommandError\") return;"
    "  conjs_sh_stderr(e instanceof Error ? (e.name === \"Error\" ? e.message : `${e.name}: ${e.message}`) : String(e));"
    "}"
    "function conjs_sh_error(r, cmd) {"
    "  if (r.status === 0) return undefined;"
    "  const e = new Error(r.signal ? `Command killed by ${r.signal}: ${cmd}` : `Command failed with exit status ${r.status}: ${cmd}`);"
    "  e.name = \"CommandError\";"
    "  e.status = r.status;"
    "  e.signal = r.signal;"
    "  e.command = cmd;"
    "  return e;"
    "}"
    "function conjs_sh_run(argv, input, output, cmd, err) {"
    "  const inq = conjs_sh_input(input);"
    "  let r;"
    "  try {"
    "    r = host.wait(\"conma.sh.run\", argv, inq, output, [err]);"
    "  } catch (e) {"
    "    if (output !== false) output.close();"
    "    if (err !== false) err.close();"
    "    return e;"
    "  } finally {"
    "    if (inq !== input) inq.close();"
    "  }"
    "  return conjs_sh_error(r, cmd);"
    "}"
    "// A pipeline (stage S3): the external commands next to each other run as one pipeline of the OS; a"
    "// command function and what is next to it are joined by a Queue with a limit of 64. Each group runs in a"
    "// task; when a group ends, the queue it read from is abandoned, so that the one before it stops (a push"
    "// throw, or the command gets SIGPIPE). The result is that of the last group, as in Bash without pipefail; an"
    "// Error of a group before it (a command that cannot start, an exception of a function) is reported, not thrown."
    "function conjs_sh_pipe(stages, input, output, cmd) {"
    "  const groups = [];"
    "  for (const s of stages) {"
    "    const last = groups.length > 0 ? groups[groups.length - 1] : undefined;"
    "    if (s.f === undefined && last !== undefined && last.f === undefined) {"
    "      last.argvs.push(s.args);"
    "      last.errs.push(s.err);"
    "    } else if (s.f === undefined) {"
    "      groups.push({ f: undefined, argvs: [s.args], errs: [s.err] });"
    "    } else {"
    "      groups.push(s);"
    "    }"
    "  }"
    "  const first = conjs_sh_input(input);"
    "  let inq = first;"
    "  const tasks = [];"
    "  for (let i = 0; i < groups.length; i++) {"
    "    const g = groups[i];"
    "    const out = i === groups.length - 1 ? output : new Queue(undefined, 64);"
    "    const inp = inq;"
    "    const between = i > 0;"
    "    tasks.push(spawn(() => {"
    "      try {"
    "        if (g.f === undefined) return { r: host.wait(\"conma.sh.run\", g.argvs, inp, out, g.errs) };"
    "        const c = conjs_sh_begin(inp, out);"
    "        try {"
    "          g.f(g.args, c.input, c.output);"
    "        } finally {"
    "          conjs_sh_end(c);"
    "        }"
    "        return { r: undefined };"
    "      } catch (e) {"
    "        if (out !== false) out.close();"
    "        for (const q of g.errs || []) if (q !== false) q.close();"
    "        // the reader after it has gone: as a command that gets SIGPIPE, not an error of the line"
    "        if (e instanceof Error && e.message === \"Queue: the reader has gone\") return { r: undefined };"
    "        return { e: e };"
    "      } finally {"
    "        if (between) inp.abandon();"
    "      }"
    "    }));"
    "    inq = out;"
    "  }"
    "  const results = [];"
    "  for (const t of tasks) results.push(join(t));"
    "  if (first !== input) first.close();"
    "  // as Bash without pipefail: the result is that of the last group; an error before it is reported, not thrown"
    "  for (let i = 0; i < results.length - 1; i++) if (results[i].e !== undefined) conjs_sh_report(results[i].e);"
    "  const last = results[results.length - 1];"
    "  if (last.e !== undefined) return last.e;"
    "  return last.r === undefined ? undefined : conjs_sh_error(last.r, cmd);"
    "}"
    "function conjs_sh_begin(input, output) {"
    "  const inp = input === false ? fs.stdin.readLines() : input;"
    "  if (output !== false) return { input: inp, output: output, task: undefined };"
    "  const out = new Queue();"
    "  const task = spawn(() => { for (const x of out) console.log(String(x)); });"
    "  return { input: inp, output: out, task: task };"
    "}"
    "function conjs_sh_end(c) {"
    "  c.output.close();"
    "  if (c.task !== undefined) join(c.task);"
    "}")

;; Gen_conjs_program：コマンド行か new Queue があれば、プログラムの始めに、ホストの JavaScript があるかを確かめる（D15）
(define Conjs_shell_code ,()
  __Cont_get__ ,(return)
  __PDict_lookup_or__ "conjs_shell_at" (,(k) __NULL__ __NULL__) ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() return "") ,()
  Kit_code_quote at ,(q)
  Kit_code_cat3 "\tConjs_shell_check " q " ,() ")
