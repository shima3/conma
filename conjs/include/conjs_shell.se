  __Cont_get__ ,(return)
  __PDict_lookup_or__ "conjs_shell_at" (,(k) __NULL__ __NULL__) ,(at)
  __is_null__ at ,(test__) __if__ test__ (,() return "") ,()
  Kit_code_quote at ,(q)
  Kit_code_cat3 "\tConjs_shell_check " q " ,() ")
