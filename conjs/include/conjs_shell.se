          __LList_uncons__ __print_exit_error__ rest ,(old x)
          __String_concat__ old s ,(t)
          __LList_cons__ t __NULL__ ,(q) __LList_cons__ "s" q ,(q)
          __LList_cons__ q more ,(parts)
          return parts) ,()) ,()
  __LList_cons__ s __NULL__ ,(q) __LList_cons__ "s" q ,(q)
  __LList_cons__ q parts)

;; 前後の空白を除く（CommandError の command に出すテキスト）
(define Conjs_shell_trim ,(s)
  Conjs_shell_zero ,(zero)
  Conjs_shell_indent s zero ,(i)
  __String_length__ s ,(len)
  __String_substring__ __print_exit_error__ s i len ,(s)
  Conjs_shell_trim_end s)

(define Conjs_shell_trim_end ,(s)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __Number_is_zero__ len ,(test__) __if__ test__ (,() return s) ,()
  Conjs_shell_one ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ s last len ,(c)
  __String_equal__ c " " ,(sp) __String_equal__ c "\t" ,(tab) __or__ sp tab ,(ws)
  __unless__ ws (,() return s) ,()
  Conjs_shell_zero ,(zero)
  __String_substring__ __print_exit_error__ s zero last ,(s)
  Conjs_shell_trim_end s)

;; ── ConJS のコードを作る（6 節、8 節、9 節）──
;; 外部コマンド：{ let conjs_command_line; 出力の用意 conjs_command_line = conjs_sh_run([語...], 入力, 出力, "テキスト");
;;   if (conjs_command_line !== undefined) throw conjs_command_line; }
;; コマンド型関数：{ let conjs_command_line; 出力の用意 conjs_command_line = conjs_sh_begin(入力, 出力);
;;   try { 名前([語...], conjs_command_line.input, conjs_command_line.output); } finally { conjs_sh_end(conjs_command_line); } }
;; conjs_command_line と、conjs_sh_ で始まる名前は、プログラムで使わない
;; 入力と出力は、変数の名前か false。出力の用意は、>$ なら 名前 = new Queue();、>>$ なら 名前 = new Queue(名前);
;; 1 行のコード：{ let conjs_command_line; パイプ && や || のつながり if (conjs_command_line !== undefined) throw conjs_command_line; }
;; conjs_command_line は、パイプの結果（undefined か、投げる Error）。&& の次は undefined のとき、|| の次は Error のときだけ
;; 動かし、最後に動いたものの Error を投げる（段階 S3。シェルの set -e と同じく、途中の失敗は投げない）。|| が受けた
;; Error は、標準エラーに出す（conjs_sh_report。18 節）
(define Conjs_shell_gen ,(words shown n col)
  __Cont_get__ ,(return)
  Kit_code_quote shown ,(q)
  Conjs_shell_split words "&& ||" __NULL__ "" __NULL__ ,(items)
  Conjs_shell_gen_list items q n col "{ let conjs_command_line; " ,(code)
  __String_concat__ code "if (conjs_command_line !== undefined) throw conjs_command_line; }")

(define Conjs_shell_gen_list ,(items q n col code)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() return code) ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  __LList_uncons__ __print_exit_error__ item ,(op more)
  __LList_uncons__ __print_exit_error__ more ,(seg x)
  Conjs_shell_gen_pipe seg q n col ,(pc)
  __String_equal__ op "" ,(first)
  __String_equal__ op "&&" ,(andThen)
  __if_then_else__ first
    (,() __String_concat__ code pc)
    (,()
      ;; || が受けた誤りは、標準エラーに出す（conjs_sh_report。CommandError は、コマンドが自分で出すので出さない）
      __if_then_else__ andThen (,() __NULL__ "===") (,() __NULL__ "!==") ,(cmp)
      __if_then_else__ andThen (,() __NULL__ "") (,() __NULL__ "conjs_sh_report(conjs_command_line); ") ,(report)
      __String_concat__ report pc ,(pc)
      Kit_code_cat5 code "if (conjs_command_line " cmp " undefined) { " pc ,(c)
      __String_concat__ c "} ") ,(code)
  Conjs_shell_gen_list rest q n col code)

;; 1 つのパイプ（| で分けた語）：conjs_command_line に結果を入れるコード
(define Conjs_shell_gen_pipe ,(seg q n col)
  __Cont_get__ ,(return)
  Conjs_shell_split seg "|" __NULL__ "" __NULL__ ,(stages)
  __LList_length__ stages ,(count)
  Conjs_shell_one ,(one)
  __Number_subtract__ count one ,(lastIndex)
  Conjs_shell_zero ,(zero)
  Conjs_shell_gen_stages stages zero lastIndex n col "" "false" "false" "" __NULL__ "" ,(scode input output setup single finish)
  ;; <$ の変数は、出力の用意（>$ v の v = new Queue(); など）より先に読む：<$ n >$ n や <$ n >$ [...n] は、もとの n を
  ;; 入力にして、出力を n に入れる（Bash の x=$(sort <<< "$x") と同じ。M1 のレビュー、shima3/conma#99）
  __String_equal__ input "false" ,(noIn)
  __if_then_else__ noIn
    (,() __NULL__ setup input)
    (,()
      Kit_code_cat4 "const conjs_sh_in = " input "; " setup ,(setup)
      __NULL__ setup "conjs_sh_in") ,(setup input)
  __LList_uncons__ __print_exit_error__ single ,(fname more)
  __LList_uncons__ __print_exit_error__ more ,(argv more)
  __LList_uncons__ __print_exit_error__ more ,(err x)
  __Number_is_zero__ lastIndex ,(one1)
  __unless__ one1
    (,()
      Kit_code_cat5 setup "conjs_command_line = conjs_sh_pipe([" scode "], " input ,(c)
      Kit_code_cat5 c ", " output ", " q ,(c)
      Kit_code_cat3 c "); " finish ,(c)
      return c) ,()
  __is_null__ fname ,(external)
  __if__ external
    (,()
      Kit_code_cat5 setup "conjs_command_line = conjs_sh_run(" argv ", " input ,(c)
      Kit_code_cat5 c ", " output ", " q ,(c)
      Kit_code_cat3 c ", " err ,(c)
      Kit_code_cat3 c "); " finish ,(c)
      return c) ,()
  ;; コマンド型関数 1 つ：その行で呼ぶ（関数でない値の TypeError も、その行の位置になる）
  ;; その例外は、パイプのときと同じく、この行の結果にする（Bash の関数の失敗と同じく、|| が受ける。M1 のレビュー、
  ;; shima3/conma#97）
  Kit_code_cat5 setup "{ const conjs_sh_c = conjs_sh_begin(" input ", " output ,(c)
  Kit_code_cat5 c "); try { " fname "(" argv ,(c)
  Kit_code_cat3 c ", conjs_sh_c.input, conjs_sh_c.output); conjs_command_line = undefined; } catch (conjs_sh_e) { conjs_command_line = conjs_sh_e; } finally { conjs_sh_end(conjs_sh_c); } } " finish)

;; パイプのコマンドを順に：返すのは、段のコード（", " で区切る）、初めの段の入力、最後の段の出力、すべての出力の用意、
;; 1 段だけのときに使う (関数の名前か null  引数の配列のコード  2>$ の変数か false)
(define Conjs_shell_gen_stages ,(stages i lastIndex n col scode input output setup single finish)
  __Cont_get__ ,(return)
  __is_null__ stages ,(test__) __if__ test__ (,() return scode input output setup single finish) ,()
  __LList_uncons__ __print_exit_error__ stages ,(item rest)
  __LList_uncons__ __print_exit_error__ item ,(op more)
  __LList_uncons__ __print_exit_error__ more ,(words x)
  __is_null__ words ,(test__) __if__ test__ (,() Conjs_shell_error n col "no command") ,()
  __LList_uncons__ __print_exit_error__ words ,(firstWord others)
  Conjs_shell_check_dollar firstWord n col ,()
  Conjs_shell_fn_name firstWord ,(fname)
  __is_null__ fname ,(external)
  __if_then_else__ external (,() __NULL__ words) (,() __NULL__ others) ,(args)
  Conjs_shell_args args n col "" "false" "false" "false" "" finish ,(list in out err set finish)
  __String_equal__ list "" ,(noArgs)
  __and__ external noArgs ,(test__) __if__ test__ (,() Conjs_shell_error n col "no command") ,()
  Conjs_shell_zero ,(zero)
  __Number_subtract__ i zero ,(d0) __Number_is_zero__ d0 ,(isFirst)
  __Number_subtract__ i lastIndex ,(dl) __Number_is_zero__ dl ,(isLast)
  __String_equal__ in "false" ,(noIn)
  __String_equal__ out "false" ,(noOut)
  __String_equal__ err "false" ,(noErr)
  __not__ noIn ,(hasIn) __not__ isFirst ,(notFirst) __and__ hasIn notFirst ,(test__)
  __if__ test__ (,() Conjs_shell_error n col "<$ is only for the first command of a pipeline") ,()
  __not__ noOut ,(hasOut) __not__ isLast ,(notLast) __and__ hasOut notLast ,(test__)
  __if__ test__ (,() Conjs_shell_error n col ">$ and >>$ are only for the last command of a pipeline") ,()
  __not__ noErr ,(hasErr) __not__ external ,(isFn) __and__ hasErr isFn ,(test__)
  __if__ test__ (,() Conjs_shell_error n col "2>$ is only for external commands") ,()
  __String_concat__ "[" list ,(arr) __String_concat__ arr "]" ,(arr)
  __if_then_else__ external
    (,() Kit_code_cat4 "{ args: " arr ", err: " err ,(s) __String_concat__ s " }")
    (,() Kit_code_cat4 "{ f: " fname ", args: " arr ,(s) __String_concat__ s " }") ,(stageCode)
  __String_equal__ scode "" ,(none)
  __if_then_else__ none (,() __NULL__ stageCode) (,() Kit_code_cat3 scode ", " stageCode) ,(scode)
  __if_then_else__ isFirst (,() __NULL__ in) (,() __NULL__ input) ,(input)
  __if_then_else__ isLast (,() __NULL__ out) (,() __NULL__ output) ,(output)
  __String_concat__ setup set ,(setup)
  __LList_cons__ err __NULL__ ,(s1) __LList_cons__ arr s1 ,(s1) __LList_cons__ fname s1 ,(single)
  Conjs_shell_one ,(one)
  __Number_add__ i one ,(i)
  Conjs_shell_gen_stages rest i lastIndex n col scode input output setup single finish)

;; 語の記号（|、||、&&）。記号でなければ null
(define Conjs_shell_op ,(w)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ w ,(parts more)
  __is_null__ parts ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ parts ,(p rest)
  __LList_uncons__ __print_exit_error__ p ,(kind r)
  __String_equal__ kind "o" ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ r ,(op x)
  __NULL__ op)

;; 語を、ops（空白で区切った記号）で分ける。返すのは (前の記号 語の LList) の LList（初めの記号は ""）。seg は今の語（逆順）
(define Conjs_shell_split ,(words ops seg op acc)
  __Cont_get__ ,(return)
  __NULL__ (,() Kit_lex_reverse seg ,(s) __LList_cons__ s __NULL__ ,(item) __LList_cons__ op item ,(item) __LList_cons__ item acc) ,(push)
  __is_null__ words ,(test__) __if__ test__ (,() push ,(acc) Kit_lex_reverse acc ,(items) return items) ,()
  __LList_uncons__ __print_exit_error__ words ,(w rest)
  Conjs_shell_op w ,(o)
  __is_null__ o ,(test__) __if__ test__ (,() __LList_cons__ w seg ,(seg) Conjs_shell_split rest ops seg op acc ,(r) return r) ,()
  Kit_lex_in_words o ops ,(isSplit)
  __if__ isSplit (,() push ,(acc) Conjs_shell_split rest ops __NULL__ o acc ,(r) return r) ,()
  __LList_cons__ w seg ,(seg)
  Conjs_shell_split rest ops seg op acc)

;; 引用符なしの初めの語が $ で始まるのに、$ の後が変数の名前でなければ（$fs.readLines、$ だけ）、その行の SyntaxError
;; （黙って外部コマンドにしない。ユーザーの決めたこと、2026-11-27）
(define Conjs_shell_check_dollar ,(w n col)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ w ,(parts more)
  __LList_uncons__ __print_exit_error__ more ,(quoted x)
  __if__ quoted return ,()
  ;; 初めの部分が、$ で始まる文字か（$fn${s} のように、後に ${...} が続く語も。M1 のレビュー、shima3/conma#98）
  __is_null__ parts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ parts ,(p rest)
  __LList_uncons__ __print_exit_error__ p ,(kind pr)
  __String_equal__ kind "s" ,(test__) __unless__ test__ return ,()
  __LList_uncons__ __print_exit_error__ pr ,(s y)
  Conjs_shell_zero ,(zero) Conjs_shell_one ,(one)
  __String_length__ s ,(len)
  __Number_is_zero__ len ,(test__) __if__ test__ return ,()
  __String_substring__ __print_exit_error__ s zero one ,(c)
  __String_equal__ c "$" ,(test__) __unless__ test__ return ,()
  __String_substring__ __print_exit_error__ s one len ,(name)
  Conjs_shell_is_name name ,(ok)
  __is_null__ rest ,(single)
  __and__ ok single ,(test__) __if__ test__ return ,()
  __if_then_else__ single (,() __NULL__ s) (,() __String_concat__ s "${...}") ,(shown)
  __String_concat__ shown ": a command function is $ and the name of a variable" ,(m)
  Conjs_shell_error n col m)

;; 初めの語が $名前（引用符なし）なら、その名前（コマンド型関数。D3）。そうでなければ null
(define Conjs_shell_fn_name ,(w)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ w ,(parts more)
  __LList_uncons__ __print_exit_error__ more ,(quoted x)
