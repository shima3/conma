;; resolver: Program の LList から1つの Module を作る（RESOLVER.md, SELFHOST.md）
;;
;; __Resolver_main__ programs ,(Module)
;;   programs は includer が返す Program の LList。
;;   各 Variable に (L n)（de Bruijn index）か (G n)（グローバル変数の番号）を加え、
;;   (Module (F file ...) (G id "name" Function) ... (G id "name" Undefined) ...) を返す。
;;
;; ノードは書き換えられないので、注釈を加えた新しいノードを作る。
;; グローバル変数の番号は、すべての Program を前順にたどり、ローカルでない名前に初めて出会った順に振る。
;; Definition の名前もその1つ。同じ名前の Definition が複数あれば、最初のものの Function を使う。
;; 名前が __NULL__ の Variable は、番号を振ったうえで (Null pos) として出力する（bin/resolver と同じ）。
;;
;; 状態（どの関数も最初の4つの引数として受け取る）:
;;   globals  名前から番号への Dict
;;   values   名前から、注釈を加えた Function への Dict（最初の Definition のもの）
;;   count    次に振る番号を持つ Ref
;;   order    番号を振った名前の LList（新しいものが先頭）を持つ Ref
;; ローカル変数のスコープは、内側のものが先頭の LList。
;; 各スコープは Head のパラメータ名の LList で、右のパラメータが先頭（index 0 に近い）。
(include "ast.se")

(define __Resolver_main__ ,(programs)
  __Dict_new__ ,(globals)
  __Dict_new__ ,(values)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(count)
  __Ref_new__ __NULL__ ,(order)
  __Resolver_nodes__ globals values count order __NULL__ programs ,(resolved)
  __Resolver_files__ programs ,(files)
  __AST_new__ "F" __NULL__ files ,(f)
  __Ref_get__ order ,(names)
  __Resolver_reverse__ names __NULL__ ,(names)
  __Resolver_entries__ globals values names ,(entries)
  __Resolver_uses__ globals values entries ,(children)
  __LList_cons__ f children ,(children)
  __AST_new__ "Module" __NULL__ children)

;; 高速版 ConMa の機能（docs/FAST-PLAN-ja.md の 3.4）：その組み込みを定義のない大域の名前として使うモジュールは、
;; (F ...) の後に (Uses ...) を置く（bin/resolver と同じ）。entries の前に足す。
;; "bitwise32" はビット演算のプリミティブ（docs/BITWISE-PLAN-ja.md）、"boolean" は __TRUE__ と __FALSE__、
;; "control" は __if_then_else__、__if__、__unless__、__Cont_get__ と、値を自分で確かめる 6 つの条件分岐
;; （__if_null_then_else__ など）、"wasm" は __Wasm_compile__、__Wasm_call__、__Wasm_call_memory__、__Dict_numbers__、__Dict_put_numbers__
(define __Resolver_uses__ ,(globals values entries)
  __Resolver_features__ globals values ,(features)
  __is_null__ features ,(none)
  __if_then_else__ none
    (,() __NULL__ entries)
    (,()
      __AST_new__ "Uses" __NULL__ features ,(uses)
      __LList_cons__ uses entries))

;; 使う機能の名前の列（bin/resolver の FAST_PRIMITIVES の順）
(define __Resolver_features__ ,(globals values)
  __LList_cons__ "__Dict_put_numbers__" __NULL__ ,(wasms)
  __LList_cons__ "__Dict_numbers__" wasms ,(wasms)
  __LList_cons__ "__Wasm_call_memory__" wasms ,(wasms)
  __LList_cons__ "__Wasm_call__" wasms ,(wasms)
  __LList_cons__ "__Wasm_compile__" wasms ,(wasms)
  __Resolver_uses_prim__ globals values wasms ,(usesWasm)
  __if_then_else__ usesWasm
    (,() __LList_cons__ "wasm" __NULL__)
    (,() __NULL__ __NULL__) ,(features)
  __LList_cons__ "__Number_if_greater_then_else__" __NULL__ ,(controls)
  __LList_cons__ "__Number_if_greater__" controls ,(controls)
  __LList_cons__ "__Number_unless_zero__" controls ,(controls)
  __LList_cons__ "__Number_if_zero_then_else__" controls ,(controls)
  __LList_cons__ "__unless_null__" controls ,(controls)
  __LList_cons__ "__if_null_then_else__" controls ,(controls)
  __LList_cons__ "__Cont_get__" controls ,(controls)
  __LList_cons__ "__unless__" controls ,(controls)
  __LList_cons__ "__if__" controls ,(controls)
  __LList_cons__ "__if_then_else__" controls ,(controls)
  __Resolver_uses_prim__ globals values controls ,(usesControl)
  __if_then_else__ usesControl
    (,() __LList_cons__ "control" features)
    (,() __NULL__ features) ,(features)
  __LList_cons__ "__FALSE__" __NULL__ ,(bools)
  __LList_cons__ "__TRUE__" bools ,(bools)
  __Resolver_uses_prim__ globals values bools ,(usesBoolean)
  __if_then_else__ usesBoolean
    (,() __LList_cons__ "boolean" features)
    (,() __NULL__ features) ,(features)
  __LList_cons__ "__Number_ushr32__" __NULL__ ,(prims)
  __LList_cons__ "__Number_shr32__" prims ,(prims)
  __LList_cons__ "__Number_shl32__" prims ,(prims)
  __LList_cons__ "__Number_not32__" prims ,(prims)
  __LList_cons__ "__Number_xor32__" prims ,(prims)
  __LList_cons__ "__Number_or32__" prims ,(prims)
  __LList_cons__ "__Number_and32__" prims ,(prims)
  __Resolver_uses_prim__ globals values prims ,(usesBitwise)
  __if_then_else__ usesBitwise
    (,() __LList_cons__ "bitwise32" features)
    (,() __NULL__ features))

;; prims のどれかが、定義のない大域の名前か
(define __Resolver_uses_prim__ ,(globals values prims)
  __is_null__ prims ,(test__) __if_then_else__ test__
    (,() __NULL__ __FALSE__)
    (,()
      __LList_uncons__ __print_exit_error__ prims ,(name rest)
      __Dict_lookup_or__ globals name (,(key) __NULL__ __NULL__) ,(id)
      __is_null__ id ,(unused)
      __Dict_lookup_or__ values name (,(key) __NULL__ __NULL__) ,(value)
      __is_null__ value ,(undefined)
      __not__ unused ,(used)
      __and__ used undefined ,(prim)
      __if_then_else__ prim
        (,() __NULL__ __TRUE__)
        (,() __Resolver_uses_prim__ globals values rest)))

;; ── 注釈 ──

;; node に注釈を加えた新しいノードを返す
(define __Resolver_node__ ,(globals values count order scopes node)
  __AST_get_kind__ node ,(kind)
  __if_then_else__ (,() __String_equal__ kind "Variable")
    (,() __Resolver_variable__ globals values count order scopes node) (,()
  __if_then_else__ (,() __String_equal__ kind "Function")
    (,() __Resolver_function__ globals values count order scopes node) (,()
  __if_then_else__ (,() __String_equal__ kind "Definition")
    (,() __Resolver_definition__ globals values count order scopes node) (,()
  __String_equal__ kind "String" ,(isString)
  __String_equal__ kind "SInfo" ,(isSInfo)
  __String_equal__ kind "Null" ,(isNull)
  __or__ isString isSInfo ,(b)
  __if_then_else__ (,() __or__ b isNull)
    (,() __NULL__ node)
    (,() __Resolver_children__ globals values count order scopes node)))))

;; 子ノードに注釈を加えた、同じ kind と位置のノードを返す
(define __Resolver_children__ ,(globals values count order scopes node)
  __AST_get_kind__ node ,(kind)
  __AST_get_pos__ node ,(pos)
  __AST_get_children__ node ,(children)
  __Resolver_nodes__ globals values count order scopes children ,(children)
  __AST_new__ kind pos children)

;; ノードの LList のそれぞれに注釈を加える（前から順に）
(define __Resolver_nodes__ ,(globals values count order scopes nodes)
  __if_then_else__ (,() __is_null__ nodes)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ nodes ,(node rest)
      __Resolver_node__ globals values count order scopes node ,(node)
      __Resolver_nodes__ globals values count order scopes rest ,(rest)
      __LList_cons__ node rest))

;; Function: Head のパラメータを新しいスコープにして、子ノード（Head も含む）に注釈を加える
(define __Resolver_function__ ,(globals values count order scopes node)
  __AST_get_children__ node ,(children)
  __Resolver_find__ children "Head" ,(head)
  __if_then_else__ (,() __is_null__ head)
    (,() __NULL__ scopes)
    (,()
      __AST_get_children__ head ,(params)
      __Resolver_param_names__ params __NULL__ ,(scope)
      __LList_cons__ scope scopes) ,(scopes)
  __Resolver_children__ globals values count order scopes node)

;; パラメータの Variable の名前を、右のものが先頭になるように acc の前に加える。
;; 可変長引数の Head の Rest は Variable でないので、名前は1つになる
(define __Resolver_param_names__ ,(params acc)
  __if_then_else__ (,() __is_null__ params)
    (,() __NULL__ acc)
    (,()
      __LList_uncons__ __print_exit_error__ params ,(param rest)
      __AST_get_kind__ param ,(kind)
      __if_then_else__ (,() __String_equal__ kind "Variable")
        (,()
          __Resolver_name__ param ,(name)
          __LList_cons__ name acc)
        (,() __NULL__ acc) ,(acc)
      __Resolver_param_names__ rest acc))

;; Definition: 子ノードに注釈を加える。その名前の最初の Definition なら、Function を values に入れる。
;; 名前は注釈を加える前に取り出す（__NULL__ という名前の Variable は注釈で Null ノードに変わるため）
(define __Resolver_definition__ ,(globals values count order scopes node)
  __AST_get_children__ node ,(children)
  __Resolver_find__ children "Variable" ,(var)
  __Resolver_name_of__ var ,(name)
  __Resolver_children__ globals values count order scopes node ,(node)
  __AST_get_children__ node ,(children)
  __LList_uncons__ __print_exit_error__ children ,(first rest)
  __unless__ (,() __is_null__ rest)
    (,()
      __LList_uncons__ __print_exit_error__ rest ,(value rest)
      __Dict_lookup_or__ values name (,(key) __NULL__ __NULL__) ,(old)
      __if__ (,() __is_null__ old)
        (,() __Dict_put__ values name value)) ,()
  __NULL__ node)

;; Variable: ローカルなら (L index)、そうでなければ (G 番号) を加える。__NULL__ は Null にする
(define __Resolver_variable__ ,(globals values count order scopes node)
  __Resolver_name__ node ,(name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Resolver_local__ scopes name zero ,(index)
  __if_then_else__ (,() __is_null__ index)
    (,()
      __Resolver_global__ globals count order name ,(id)
      __NULL__ "G" id)
    (,() __NULL__ "L" index) ,(tag index)
  __AST_get_pos__ node ,(pos)
  __if_then_else__ (,() __String_equal__ name "__NULL__")
    (,() __AST_new__ "Null" pos __NULL__)
    (,()
      __LList_cons__ index __NULL__ ,(annotation)
      __AST_new__ tag __NULL__ annotation ,(annotation)
      __AST_get_children__ node ,(children)
      __Resolver_append__ children annotation ,(children)
      __AST_new__ "Variable" pos children))

;; scopes の中の name の de Bruijn index。見つからなければ null。
;; acc は、それまでに調べた（外側でない）スコープのパラメータの数
(define __Resolver_local__ ,(scopes name acc)
  __if_then_else__ (,() __is_null__ scopes)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ scopes ,(scope rest)
      __Resolver_position__ scope name acc ,(index size)
      __if_then_else__ (,() __is_null__ index)
        (,()
          __Number_add__ acc size ,(acc)
          __Resolver_local__ rest name acc)
        (,() __NULL__ index)))

;; scope の中の name の位置に acc を足したもの（なければ null）と、scope のパラメータの数
(define __Resolver_position__ ,(scope name acc)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Resolver_position_loop__ scope name acc zero __NULL__)

(define __Resolver_position_loop__ ,(scope name acc i found)
  __if_then_else__ (,() __is_null__ scope)
    (,() __NULL__ found i)
    (,()
      __LList_uncons__ __print_exit_error__ scope ,(param rest)
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __if_then_else__ (,() __is_null__ found)
        (,()
          __if_then_else__ (,() __String_equal__ param name)
            (,() __Number_add__ acc i)
            (,() __NULL__ __NULL__))
        (,() __NULL__ found) ,(found)
      __Resolver_position_loop__ rest name acc next found))

;; name のグローバル変数の番号。まだなければ次の番号を振る
(define __Resolver_global__ ,(globals count order name)
  __Dict_lookup_or__ globals name (,(key) __NULL__ __NULL__) ,(id)
  __if_then_else__ (,() __is_null__ id)
    (,()
      __Ref_get__ count ,(id)
      __Dict_put__ globals name id ,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ id one ,(next)
      __Ref_set__ count next ,()
      __Ref_get__ order ,(names)
      __LList_cons__ name names ,(names)
      __Ref_set__ order names ,()
      __NULL__ id)
    (,() __NULL__ id))

;; ── Module ──

;; Program の位置にあるファイル名の LList
(define __Resolver_files__ ,(programs)
  __if_then_else__ (,() __is_null__ programs)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ programs ,(program rest)
      __Resolver_files__ rest ,(files)
      __AST_get_pos__ program ,(pos)
      __LList_uncons__ __print_exit_error__ pos ,(line pos)
      __LList_uncons__ __print_exit_error__ pos ,(col pos)
      __if_then_else__ (,() __is_null__ pos)
        (,() __NULL__ files)
        (,()
          __LList_uncons__ __print_exit_error__ pos ,(file pos)
          __LList_cons__ file files)))

;; names の順に (G id "name" Function) か (G id "name" Undefined) を作る
(define __Resolver_entries__ ,(globals values names)
  __if_then_else__ (,() __is_null__ names)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ names ,(name rest)
      __Resolver_entries__ globals values rest ,(entries)
      __Dict_lookup_or__ globals name __print_exit_error__ ,(id)
      __Dict_lookup_or__ values name (,(key) __AST_new__ "Undefined" __NULL__ __NULL__) ,(value)
      __LList_cons__ value __NULL__ ,(children)
      __LList_cons__ name children ,(children)
      __LList_cons__ id children ,(children)
      __AST_new__ "G" __NULL__ children ,(entry)
      __LList_cons__ entry entries))

;; ── 引数の個数の警告 ──

;; __Resolver_warnings__ module ,(messages)
;;   大域の define の関数（Head のパラメータが k 個で、可変長でない）を、0 < m < k 個の引数で呼ぶ所の、
;;   警告のメッセージ（改行なし）の LList。そのような呼び出しは部分適用で、結果は関数になる。
;;   意図したものでなければ誤りなので、警告にとどめる。引数が多いとき（Sink を返す関数）と、
;;   ないとき（関数を値として渡す）は警告しない。
;;   関数は Module にあるもの（各名前の最初の Definition）で、番号の順に、それぞれを前順にたどる（bin/resolver と同じ）
(define __Resolver_warnings__ ,(module)
  __AST_get_children__ module ,(children)
  __LList_uncons__ __print_exit_error__ children ,(f entries)
  ;; (Uses ...) があれば飛ばす（__Resolver_uses__）
  __Resolver_skip_uses__ entries ,(entries)
  __Dict_new__ ,(arities)
  __Resolver_arities__ arities entries ,()
  __Ref_new__ __NULL__ ,(acc)
  __Resolver_warn_entries__ arities acc entries ,()
  __Ref_get__ acc ,(messages)
  __Resolver_reverse__ messages __NULL__)

;; entries の最初が (Uses ...) なら、それを除いたもの
(define __Resolver_skip_uses__ ,(entries)
  __is_null__ entries ,(test__) __if_then_else__ test__
    (,() __NULL__ entries)
    (,()
      __LList_uncons__ __print_exit_error__ entries ,(first rest)
      __LList_uncons__ __print_exit_error__ first ,(kind more)
      __String_equal__ kind "Uses" ,(test__) __if_then_else__ test__
        (,() __NULL__ rest)
        (,() __NULL__ entries)))

;; 各 entry (G id "name" value) の value が可変長でない Function なら、name に Head のパラメータの数を入れる
(define __Resolver_arities__ ,(arities entries)
  __unless__ (,() __is_null__ entries)
    (,()
      __LList_uncons__ __print_exit_error__ entries ,(entry rest)
      __AST_get_children__ entry ,(children)
      __LList_uncons__ __print_exit_error__ children ,(id children)
      __LList_uncons__ __print_exit_error__ children ,(name children)
      __LList_uncons__ __print_exit_error__ children ,(value children)
      __AST_get_kind__ value ,(kind)
      __if__ (,() __String_equal__ kind "Function")
        (,()
          __AST_get_children__ value ,(parts)
          __Resolver_find__ parts "Head" ,(head)
          __unless__ (,() __is_null__ head)
            (,()
              __AST_get_children__ head ,(params)
              __Resolver_all_variables__ params ,(fixed)
              __if__ fixed
                (,()
                  __LList_length__ params ,(k)
                  __Dict_put__ arities name k))) ,()
      __Resolver_arities__ arities rest))

;; nodes がすべて Variable なら __TRUE__（可変長の Head の Rest は Variable でない）
(define __Resolver_all_variables__ ,(nodes)
  __if_then_else__ (,() __is_null__ nodes)
    (,() __NULL__ __TRUE__)
    (,()
      __LList_uncons__ __print_exit_error__ nodes ,(node rest)
      __AST_get_kind__ node ,(kind)
      __if_then_else__ (,() __String_equal__ kind "Variable")
        (,() __Resolver_all_variables__ rest)
        (,() __NULL__ __FALSE__)))

(define __Resolver_warn_entries__ ,(arities acc entries)
  __unless__ (,() __is_null__ entries)
    (,()
      __LList_uncons__ __print_exit_error__ entries ,(entry rest)
      __AST_get_children__ entry ,(children)
      __LList_uncons__ __print_exit_error__ children ,(id children)
      __LList_uncons__ __print_exit_error__ children ,(name children)
      __LList_uncons__ __print_exit_error__ children ,(value children)
      __Resolver_warn_node__ arities acc value ,()
      __Resolver_warn_entries__ arities acc rest))

;; node を前順にたどり、Body ごとに __Resolver_check_call__ を呼ぶ。ノードでない子（String、Number）は飛ばす
(define __Resolver_warn_node__ ,(arities acc node)
  __AST_get_kind__ node ,(kind)
  __if__ (,() __String_equal__ kind "Body")
    (,() __Resolver_check_call__ arities acc node) ,()
  __AST_get_children__ node ,(children)
  __Resolver_warn_nodes__ arities acc children)

(define __Resolver_warn_nodes__ ,(arities acc nodes)
  __unless__ (,() __is_null__ nodes)
    (,()
      __LList_uncons__ __print_exit_error__ nodes ,(node rest)
      __type_name__ node ,(type)
      __if__ (,() __String_equal__ type "LList")
        (,() __Resolver_warn_node__ arities acc node) ,()
      __Resolver_warn_nodes__ arities acc rest))

;; Body の Operator が、arities にある名前の大域変数で、OList の数 m が 0 < m < k なら、警告を acc に加える
(define __Resolver_check_call__ ,(arities acc body)
  __AST_get_children__ body ,(children)
  __Resolver_find__ children "Operator" ,(op)
  __Resolver_find__ children "OList" ,(olist)
  __Resolver_global_operator__ op ,(name)
  __is_null__ name ,(noName)
  __is_null__ olist ,(noOList)
  __unless__ (,() __or__ noName noOList)
    (,()
      __Dict_lookup_or__ arities name (,(key) __NULL__ __NULL__) ,(k)
      __unless__ (,() __is_null__ k)
        (,()
          __AST_get_children__ olist ,(operands)
          __LList_length__ operands ,(m)
          __Number_is_zero__ m ,(none)
          __Number_subtract__ m k ,(d)
          __Number_is_negative__ d ,(fewer)
          __not__ none ,(some)
          __if__ (,() __and__ fewer some)
            (,()
              __Resolver_location__ children op ,(loc)
              __Number_toString__ m ,(mStr)
              __Number_toString__ k ,(kStr)
              __String_concat__ "Warning: " loc ,(msg)
              __String_concat__ msg ": too few arguments to " ,(msg)
              __String_concat__ msg name ,(msg)
              __String_concat__ msg ": " ,(msg)
              __String_concat__ msg mStr ,(msg)
              __String_concat__ msg " of " ,(msg)
              __String_concat__ msg kStr ,(msg)
              __String_concat__ msg " (partial application)" ,(msg)
              __Ref_get__ acc ,(messages)
              __LList_cons__ msg messages ,(messages)
              __Ref_set__ acc messages))))

;; Operator の子が (G n) の Variable なら、その名前。そうでなければ null
(define __Resolver_global_operator__ ,(op)
  __if_then_else__ (,() __is_null__ op)
    (,() __NULL__ __NULL__)
    (,()
      __AST_get_children__ op ,(children)
      __LList_uncons__ (,(msg) __NULL__ __NULL__) children ,(var rest)
      __AST_get_kind__ var ,(kind)
      __if_then_else__ (,() __String_equal__ kind "Variable")
        (,()
          __AST_get_children__ var ,(parts)
          __LList_uncons__ __print_exit_error__ parts ,(name parts)
          __LList_uncons__ __print_exit_error__ parts ,(annotation parts)
          __AST_get_kind__ annotation ,(tag)
          __if_then_else__ (,() __String_equal__ tag "G")
            (,() __NULL__ name)
            (,() __NULL__ __NULL__))
        (,() __NULL__ __NULL__)))

;; 位置: Body の SInfo の String の最初の 3 つを ":" でつないだもの。なければ Operator の "行:列"
(define __Resolver_location__ ,(children op)
  __Resolver_find__ children "SInfo" ,(sinfo)
  __if_then_else__ (,() __is_null__ sinfo)
    (,() __NULL__ __NULL__)
    (,() __AST_get_children__ sinfo) ,(parts)
  __Number_fromString__ __print_exit_error__ "3" ,(three)
  __Resolver_strings__ parts three __NULL__ ,(strings)
  __if_then_else__ (,() __is_null__ strings)
    (,()
      __AST_get_pos__ op ,(pos)
      __LList_uncons__ __print_exit_error__ pos ,(line pos)
      __LList_uncons__ __print_exit_error__ pos ,(col pos)
      __Number_toString__ line ,(lineStr)
      __Number_toString__ col ,(colStr)
      __String_concat__ lineStr ":" ,(s)
      __String_concat__ s colStr)
    (,() __Resolver_join__ strings ""))

;; values の中の String を、前から n 個まで、逆順に acc の前に加えて返す（結果は前からの順）
(define __Resolver_strings__ ,(values n acc)
  __is_null__ values ,(empty)
  __Number_is_zero__ n ,(full)
  __if_then_else__ (,() __or__ empty full)
    (,() __Resolver_reverse__ acc __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ values ,(value rest)
      __type_name__ value ,(type)
      __if_then_else__ (,() __String_equal__ type "String")
        (,()
          __Number_fromString__ __print_exit_error__ "1" ,(one)
          __Number_subtract__ n one ,(n)
          __LList_cons__ value acc ,(acc)
          __Resolver_strings__ rest n acc)
        (,() __Resolver_strings__ rest n acc)))

;; strings を ":" でつなぐ。sep は最初の要素の前に置くもの
(define __Resolver_join__ ,(strings sep)
  __if_then_else__ (,() __is_null__ strings)
    (,() __NULL__ "")
    (,()
      __LList_uncons__ __print_exit_error__ strings ,(first rest)
      __Resolver_join__ rest ":" ,(tail)
      __String_concat__ sep first ,(s)
      __String_concat__ s tail))

;; ── 補助 ──

;; nodes の中で最初の kind のノード。なければ null
(define __Resolver_find__ ,(nodes kind)
  __if_then_else__ (,() __is_null__ nodes)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ nodes ,(node rest)
      __AST_get_kind__ node ,(k)
      __if_then_else__ (,() __String_equal__ k kind)
        (,() __NULL__ node)
        (,() __Resolver_find__ rest kind)))

;; Variable の名前（最初の子）
(define __Resolver_name__ ,(var)
  __AST_get_children__ var ,(children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __NULL__ name)

;; var が null でなければその名前、null なら null
(define __Resolver_name_of__ ,(var)
  __if_then_else__ (,() __is_null__ var)
    (,() __NULL__ __NULL__)
    (,() __Resolver_name__ var))

(define __Resolver_append__ ,(list x)
  __LList_cons__ x __NULL__ ,(last)
  __Resolver_reverse__ list __NULL__ ,(reversed)
  __Resolver_reverse__ reversed last)

(define __Resolver_reverse__ ,(list acc)
  __if_then_else__ (,() __is_null__ list)
    (,() __NULL__ acc)
    (,()
      __LList_uncons__ __print_exit_error__ list ,(head rest)
      __LList_cons__ head acc ,(acc)
      __Resolver_reverse__ rest acc))
