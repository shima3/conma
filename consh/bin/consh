#!/bin/bash
# ConSh を起動する。
#   consh [--conma-parser] [--dump] <script> [<arg> ...]
#   consh                 対話モード（標準入力から1行ずつ読んで実行する）
# 環境変数 CONSH_IMPL で版を選ぶ。
#   rust（既定）  Rust 版（consh/rust の consh-rs）。構文解析も Rust 版で行い、--dump は Rust 版の構文解析の構文木を出す。
#                 consh/rust で cargo build --release して作っておく（Rust 1.87 以降。std::io::pipe を使う）。
#                 作っていなければ、そう出して ConMa 版で実行する
#   conma         ConMa 版（仕様の参照実装）。スクリプトを consh_parse --pos で構文木にして渡す。VM は環境変数 CONMA_VM で選ぶ
#                 （test/vm.sh。既定は Python 版。rust なら Rust 版、transpiled なら変換したコードを組み込んだ Rust 版）
# --conma-parser と CONSH_CONMA_DATA は ConMa 版にしかないので、付ければ CONSH_IMPL に関係なく ConMa 版で実行する
# 対話モードで、標準入力が端末で rlwrap があれば、rlwrap を通して起動する（行の編集と履歴。履歴は ~/.consh_history）。
# 環境変数 CONSH_NO_RLWRAP を空でない値にすると、rlwrap を使わない
# --dump を付けると、実行せず、読んだ構文木を S 式に書き戻して出す。
# --conma-parser を付けると、Python の consh_parse を使わず、ConMa 版の構文解析（consh_parser.se）でスクリプトを読む
# 環境変数 CONSH_CONMA_DATA を空でない値にすると、データの組み込み（__Dict_copy__ など）の代わりに ConMa 版
# （include/data.se）を使う。組み込みと同じ結果になることを確かめるためで、モジュールは別に作る
# 環境変数 CONSH_MODULE_DIR は、ConMa のモジュールを作るディレクトリ（既定は /tmp）
set -o pipefail
consh="$(cd ${0%/*}/..; pwd)"
root="${consh%/*}"
mode=run
src=
if [ "$1" = --conma-parser ]; then
  src=-src
  shift
fi
if [ "$1" = --dump ]; then
  mode=dump
  shift
fi
interactive=
if [ $# -eq 0 ] && [ -z "$src" ] && [ $mode = run ]; then
  interactive=yes
elif [ $# -lt 1 ]; then
  echo "usage: consh [--conma-parser] [--dump] <script> [<arg> ...]" >&2
  exit 1
fi
impl="${CONSH_IMPL:-rust}"
case "$impl" in
  rust|conma) ;;
  *) echo "consh: CONSH_IMPL must be rust or conma, not \"$impl\"" >&2; exit 2 ;;
esac
rust="$consh/rust/target/release/consh-rs"
if [ $impl = rust ] && { [ -n "$src" ] || [ -n "$CONSH_CONMA_DATA" ]; }; then
  impl=conma
fi
if [ $impl = rust ] && [ ! -x "$rust" ]; then
  echo "consh: $rust is not built (cargo build --release in consh/rust, Rust 1.87 or later); running the ConMa version" >&2
  impl=conma
fi
[ $impl = rust ] || rust=
if [ -n "$rust" ] && [ -z "$interactive" ]; then
  [ $mode = dump ] && exec "$rust" dump "$1"
  exec "$rust" run "$@"
fi
if [ -n "$interactive" ] && [ -z "$CONSH_NO_RLWRAP" ] && [ -z "$CONSH_RLWRAPPED" ] && [ -t 0 ] && command -v rlwrap > /dev/null; then
  # rlwrap が起動する consh は、もう一度 rlwrap を通さない。CONSH_RLWRAPPED は、ConSh が起動時に環境変数から除くので、
  # 中で起動するコマンドには渡らない（中で対話モードの consh を起動すれば、それも rlwrap を使う）
  CONSH_RLWRAPPED=1 exec rlwrap -C consh "$0"
fi
if [ -n "$interactive" ] && [ -n "$rust" ]; then
  exec "$rust" interactive
fi
# ConMa のモジュールは、ソースが変わったときだけ作り直す。作るディレクトリは環境変数 CONSH_MODULE_DIR（既定は /tmp）。
# 一時ファイルに作ってから mv で置き換えるので、同時に起動した consh が作りかけのモジュールを読むことはない
dir="${CONSH_MODULE_DIR:-/tmp}"
module="$dir/consh.module.se"
main="$consh/include/consh_main.se"
if [ -n "$CONSH_CONMA_DATA" ]; then
  module="$dir/consh.data.module.se"
  main="$dir/consh_data_main.se"
  if [ ! -s "$main" ]; then
    t=$(mktemp "$main.XXXXXX") || exit 1
    printf '(include "data.se")\n(include "consh_main.se")\n' > "$t" && mv -f "$t" "$main"
  fi
fi
if [ ! -s "$module" ] || [ -n "$(find "$root/include" "$consh/include" -name '*.se' -newer "$module")" ]; then
  ast_tmp=$(mktemp "${module%.module.se}.ast.XXXXXX") || exit 1
  module_tmp=$(mktemp "$module.XXXXXX") || { rm -f "$ast_tmp"; exit 1; }
  if ! "$root/bin/includer" --include "$root/include" --include "$consh/include" "$main" \
      | sed -e 's/"\/.*\/conma/"conma/' > "$ast_tmp" ||
     ! "$root/bin/resolver" < "$ast_tmp" > "$module_tmp"
  then rm -f "$ast_tmp" "$module_tmp"; exit 1
  fi
  rm -f "$ast_tmp"
  mv -f "$module_tmp" "$module"
fi
if [ -n "$interactive" ]; then
  exec "$root/test/vm.sh" --main "$module" interactive - stdin
fi
if [ -n "$src" ]; then
  exec "$root/test/vm.sh" --main "$module" $mode$src "$1" "$@"
fi
ast=$(mktemp /tmp/consh.XXXXXX)
trap 'rm -f "$ast"' EXIT
if ! python3 "$consh/bin/consh_parse" --pos "$1" > "$ast"
then exit 1
fi
"$root/test/vm.sh" --main "$module" $mode "$ast" "$@"
