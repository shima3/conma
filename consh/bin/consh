#!/bin/bash
# ConSh を起動する。
#   consh [--conma-parser | --python-parser] [--dump] <script> [<arg> ...]
#   consh                 対話モード（標準入力から1行ずつ読んで実行する）
# 環境変数 CONSH_IMPL で版を選ぶ。
#   rust（既定）  Rust 版（consh/rust の consh-rs）。構文解析も Rust 版で行い、--dump は Rust 版の構文解析の構文木を出す。
#                 consh/rust で cargo build --release して作っておく（Rust 1.87 以降。std::io::pipe を使う）。
#                 作っていなければ、そう出して ConMa 版で実行する
#   conma         ConMa 版の高速版（consh/include と、標準ライブラリの include）。スクリプトは ConMa 版の構文解析
#                 （consh_parser.se）で読む。VM は環境変数 CONMA_VM で選ぶ
#                 （test/vm.sh。既定は Python 版。rust なら Rust 版、transpiled なら変換したコードを組み込んだ Rust 版）。
#                 モジュールは、Rust 版の VM（vm/target/release/conma）があれば、その conma build（ConMa 版のフロントエンド）で作る。
#                 そのため、CONMA_VM=rust（か transpiled）なら Python を使わない
#   reference     ConMa 版の参照版（仕様の参照実装）。速くするために書き直す前のファイル（consh/reference と、標準ライブラリの
#                 reference）を、高速版の同じ名前のファイルの代わりに使う（consh/reference/README-ja.md）。ほかは conma と同じ
# --conma-parser、--python-parser と CONSH_CONMA_DATA は ConMa 版にしかないので、付ければ CONSH_IMPL が rust でも ConMa 版（高速版）で実行する
# 対話モードで、標準入力が端末で rlwrap があれば、rlwrap を通して起動する（行の編集と履歴。履歴は ~/.consh_history）。
# Tab でファイル名を補完する（rlwrap -c。Rust 版は cd した先を、rlwrap が見るプロセスのカレントディレクトリにもする）
# 環境変数 CONSH_NO_RLWRAP を空でない値にすると、rlwrap を使わない
# --dump を付けると、実行せず、読んだ構文木を S 式に書き戻して出す。
# ConMa 版は、スクリプトを ConMa 版の構文解析（consh_parser.se）で読む（--conma-parser は、その既定を明示するだけ）。
# --python-parser を付けると、Python の参照実装 consh_parse --pos で構文木にして渡す（両者が同じになることは test/parse3）
# 環境変数 CONSH_CONMA_DATA を空でない値にすると、データの組み込み（__Dict_copy__ など）の代わりに ConMa 版
# （include/data.se）を使う。組み込みと同じ結果になることを確かめるためで、モジュールは別に作る
# 環境変数 CONSH_MODULE_DIR は、ConMa のモジュールを作るディレクトリ（既定は /tmp）
set -o pipefail
consh="$(cd ${0%/*}/..; pwd)"
root="${consh%/*}"
mode=run
# 構文解析：ConMa 版（-src のモード）か、Python の consh_parse（py）。parser は、どちらかを明示したか
src=-src
parser=
if [ "$1" = --conma-parser ]; then
  parser=yes
  shift
elif [ "$1" = --python-parser ]; then
  src=
  parser=yes
  shift
fi
if [ "$1" = --dump ]; then
  mode=dump
  shift
fi
interactive=
if [ $# -eq 0 ] && [ -z "$parser" ] && [ $mode = run ]; then
  interactive=yes
elif [ $# -lt 1 ]; then
  echo "usage: consh [--conma-parser | --python-parser] [--dump] <script> [<arg> ...]" >&2
  exit 1
fi
impl="${CONSH_IMPL:-rust}"
case "$impl" in
  rust|conma|reference) ;;
  *) echo "consh: CONSH_IMPL must be rust, conma or reference, not \"$impl\"" >&2; exit 2 ;;
esac
rust="$consh/rust/target/release/consh-rs"
if [ $impl = rust ] && { [ -n "$parser" ] || [ -n "$CONSH_CONMA_DATA" ]; }; then
  impl=conma
fi
if [ $impl = rust ] && [ ! -x "$rust" ]; then
  echo "consh: $rust is not built (cargo build --release in consh/rust, Rust 1.87 or later); running the ConMa version" >&2
  impl=conma
fi
[ $impl = rust ] || rust=
if [ -n "$rust" ] && [ -z "$interactive" ]; then
  [ $mode = dump ] && exec "$rust" dump "$1"
  exec "$rust" run "$@"
fi
if [ -n "$interactive" ] && [ -z "$CONSH_NO_RLWRAP" ] && [ -z "$CONSH_RLWRAPPED" ] && [ -t 0 ] && command -v rlwrap > /dev/null; then
  # rlwrap が起動する consh は、もう一度 rlwrap を通さない。CONSH_RLWRAPPED は、ConSh が起動時に環境変数から除くので、
  # 中で起動するコマンドには渡らない（中で対話モードの consh を起動すれば、それも rlwrap を使う）
  CONSH_RLWRAPPED=1 exec rlwrap -c -C consh "$0"
fi
if [ -n "$interactive" ] && [ -n "$rust" ]; then
  exec "$rust" interactive
fi
# ConMa のモジュールは、ソースかフロントエンドが変わったときだけ作り直す。作るディレクトリは環境変数 CONSH_MODULE_DIR（既定は /tmp）。
# 一時ファイルに作ってから mv で置き換えるので、同時に起動した consh が作りかけのモジュールを読むことはない
# include ディレクトリ：高速版は consh/include と標準ライブラリの include。参照版は、consh/reference と標準ライブラリの
# reference を先に探す（そこにある、書き直す前のファイルが、同じ名前のファイルの代わりになる）。
# 最初のファイル consh_main.se も、参照版は consh/reference にあればそれを使う
dir="${CONSH_MODULE_DIR:-/tmp}"
if [ $impl = reference ]; then
  dirs=("$consh/reference" "$consh/include" "$root/reference" "$root/include")
  name=consh.reference
else
  dirs=("$consh/include" "$root/include")
  name=consh
fi
module="$dir/$name.module.se"
main="$consh/include/consh_main.se"
[ $impl = reference ] && [ -f "$consh/reference/consh_main.se" ] && main="$consh/reference/consh_main.se"
if [ -n "$CONSH_CONMA_DATA" ]; then
  module="$dir/$name.data.module.se"
  main="$dir/${name}_data_main.se"
  if [ ! -s "$main" ]; then
    t=$(mktemp "$main.XXXXXX") || exit 1
    printf '(include "data.se")\n(include "consh_main.se")\n' > "$t" && mv -f "$t" "$main"
  fi
fi
# モジュールは、Rust 版の VM があれば conma build（ConMa 版のフロントエンド。Python を使わない）で、なければ
# bin/includer と bin/resolver（Python）で作る。SInfo のファイル名は、リポジトリの上のディレクトリからの相対パスにする
conma="$root/vm/target/release/conma"
# リポジトリの上のディレクトリ（実際のパス。フロントエンドはファイル名を実際のパスで書く）
above="$(cd "$root/.."; pwd -P)"
incs=()
for d in "${dirs[@]}"; do incs+=(--include "$d"); done
# モジュールを作るもの（conma か、bin/ の Python 版のフロントエンド）。これが新しくなっても作り直す
# （フロントエンドが変わると、同じソースから違うモジュールができる。インクルードディレクトリを探す順など）
if [ -x "$conma" ]; then frontend=("$conma"); else frontend=("$root/bin"); fi
# ソースかフロントエンドがモジュールより新しければ、作り直す
# （フォルダも見るのは、ファイルを足したり消したり移したりすると、フォルダの時刻が変わるから）
if [ ! -s "$module" ] || [ -n "$(find "${dirs[@]}" \( -name '*.se' -o -type d \) -newer "$module")" ] ||
   [ -n "$(find "${frontend[@]}" -type f -newer "$module")" ]; then
  ast_tmp=$(mktemp "${module%.module.se}.ast.XXXXXX") || exit 1
  module_tmp=$(mktemp "$module.XXXXXX") || { rm -f "$ast_tmp"; exit 1; }
  if [ -x "$conma" ]; then
    if ! "$conma" build "${incs[@]}" "$main" \
        | sed -e "s|\"$above/|\"|g" > "$module_tmp"
    then rm -f "$ast_tmp" "$module_tmp"; exit 1
    fi
  elif ! "$root/bin/includer" "${incs[@]}" "$main" \
      | sed -e "s|\"$above/|\"|g" > "$ast_tmp" ||
     ! "$root/bin/resolver" < "$ast_tmp" > "$module_tmp"
  then rm -f "$ast_tmp" "$module_tmp"; exit 1
  fi
  rm -f "$ast_tmp"
  mv -f "$module_tmp" "$module"
fi
if [ -n "$interactive" ]; then
  exec "$root/test/vm.sh" --main "$module" interactive - stdin
fi
if [ -n "$src" ]; then
  exec "$root/test/vm.sh" --main "$module" $mode$src "$1" "$@"
fi
ast=$(mktemp /tmp/consh.XXXXXX)
trap 'rm -f "$ast"' EXIT
if ! python3 "$consh/bin/consh_parse" --pos "$1" > "$ast"
then exit 1
fi
"$root/test/vm.sh" --main "$module" $mode "$ast" "$@"
