#!/usr/bin/env python3
"""
consh_parse -- ConSh の構文解析と語の展開の参照実装

ConMa 版の結果と比べるために、構文木と展開の結果をテキストで出力する。
文法は PLAN-ja.md の 1.1、展開は 1.2 と 1.3 のうち語の展開に関わる項目に従う。

Usage:
    consh_parse [--pos] <script_file>
    consh_parse --expand <script_file> [<arg> ...]

構文解析（第1の形式）
    コマンド行ごとに、1行の S 式で構文木を出力する。形式は AST.md に書いてある。
    --pos を付けると、各節の種類の後に (行 桁) を入れる。

展開（第2の形式、--expand）
    トップレベルの文を順に実行する。ただし、コマンドは起動せず、展開した結果を1行の S 式で出力する。
    <arg> はスクリプトの引数（$@, $1, $# など）になる。

        (assign ("名前" 値) ...)     値 = "文字列" | (list "要素" ...)
        (export ("名前" "文字列") ...)
        (function "名前")
        (cmd [(env ("名前" "文字列") ...)] (words 値 ...) [(redirs (">" "語") (">" (params ...)) ("2>&1") ...)])
        (pipe ...), (list ...), (bg ...) は構文解析と同じ形

    * 変数定義、export は実行し、その後の展開に反映する。関数は定義しても呼び出さない。
    * if 文はエラーとする（$? がないので、どちらを実行するか決められない）。
    * for 文は実行し、繰り返しごとに (for "変数名" 値) を出力してから、本体の文を出力する。
      break と continue も実行する。リダイレクト付きの for 文はエラーとする。
    * 先頭の語を先に展開してコマンドの名前を決め、残りの語を、外部コマンドなら葉ごとの文字列に、
      関数（それまでに定義した名前）と組み込みコマンド（echo、cd、defined、builtin、command）なら
      値のまま展開する。値は "文字列" か (list 値 ...) で書く。
    * 前置の変数定義は、同じ文の語の展開に反映する。前置の変数定義どうしは影響しない。
    * コマンド置換 $( ) の中は、局所変数、環境変数、関数の名前をコピーして実行する。
      中で使えるコマンドは echo だけで、echo の出力の要素を並べた LazyList が値になる。
      echo は、引数が1つならその値、2つ以上なら文字列化してスペースで連結した文字列、なければ空文字列を出す。
      パイプ、&、リダイレクトはエラーとする。
    * 環境変数は空から始める（実際の環境変数は取り込まない）。
    * $? は "0"、$! は ""、$$ は "1" とする。$0 はスクリプトのファイル名とする。
    * 未定義の変数と、足りない位置パラメータの参照はエラーとする。
    * glob はカレントディレクトリで適用し、一致した名前を文字コード順に並べる。
      一致しなければ、語をそのまま残す（Bash の既定と同じ）。
      リダイレクト先の語にも適用し、2つ以上の語になればエラーとする。
      関数と組み込みコマンドの引数、for 文の語にも適用する（一致した名前ごとに1つの引数）。変数定義の右辺には適用しない。
    * ${-語} は、語に glob を適用した結果の LazyList になる。一致しなければ空の LazyList。
      ${x} の LazyList と同じく、関数と組み込みコマンドには1つの値として渡し、外部コマンドには葉ごとの語にする。
      その葉には、もう一度 glob を適用しない。

エラー
    標準エラー出力に「consh_parse: ファイル:行:桁: メッセージ」を出力し、終了ステータス 1 で終わる。
"""

import glob
import re
import sys


class ConShError(Exception):
    def __init__(self, msg, pos):
        super().__init__(msg)
        self.msg = msg
        self.pos = pos


# ----------------------------------------------------------------------
# 構文解析
# ----------------------------------------------------------------------

class Node(tuple):
    """構文木の節。(種類, 子, ...) のタプルで、pos に元の文字列での位置を持つ"""


class NodeList(list):
    """コマンド行（文の並び）とスクリプト（コマンド行の並び）。pos に位置を持つ"""


def node(pos, *fields):
    n = Node(fields)
    n.pos = pos
    return n

SPACES = (' ', '\t')
SPECIALS = (';', "'", '(', ')', '{', '}', '|', '&', '>', '<', '"', '$', '\\')
# 文の先頭でスクリプトを終えるキーワード
TERMINATORS = ('then', 'elif', 'else', 'fi', 'do', 'done')
KEYWORDS = ('function', 'export', 'return', 'if', 'for', 'break', 'continue') + TERMINATORS


def is_ident_start(c):
    return c == '_' or ('a' <= c <= 'z') or ('A' <= c <= 'Z')


def is_digit(c):
    return '0' <= c <= '9' and c != ''


def is_ident_char(c):
    return is_ident_start(c) or is_digit(c)


class Parser:
    """文字単位の再帰下降で構文木を作る。

    行継続（\\ と改行）は、引用符 '...' とコメントの中を除き、読む前に読み飛ばす。
    sep_end は、行頭、空白、;、|、& の直後の位置で、ここにある # はコメントの開始になる。
    """

    def __init__(self, text):
        self.text = text
        self.pos = 0
        self.sep_end = 0

    def error(self, msg, pos=None):
        raise ConShError(msg, self.pos if pos is None else pos)

    # -- 文字の読み出し --

    def _cont_len(self, i):
        t = self.text
        if i < len(t) and t[i] == '\\':
            if t.startswith('\n', i + 1):
                return 2
            if t.startswith('\r\n', i + 1):
                return 3
        return 0

    def _skip(self):
        while True:
            n = self._cont_len(self.pos)
            if n == 0:
                return
            self.pos += n

    def _index(self, k):
        # 行継続を除いて k 文字先の位置
        i = self.pos
        while True:
            while True:
                n = self._cont_len(i)
                if n == 0:
                    break
                i += n
            if k == 0 or i >= len(self.text):
                return i
            i += 1
            k -= 1

    def peek(self, k=0):
        i = self._index(k)
        return self.text[i] if i < len(self.text) else ''

    def peek_str(self, n):
        return ''.join(self.peek(k) for k in range(n))

    def advance(self, n=1):
        for _ in range(n):
            self._skip()
            self.pos += 1

    def at_newline(self, k=0):
        c = self.peek(k)
        return c == '\n' or (c == '\r' and self.peek(k + 1) == '\n')

    def consume_newline(self):
        self.advance(2 if self.peek() == '\r' else 1)
        self._mark_sep()

    def _mark_sep(self):
        self._skip()
        self.sep_end = self.pos

    def skip_spaces(self):
        n = 0
        while self.peek() in SPACES and self.peek() != '':
            self.advance()
            n += 1
        if n:
            self._mark_sep()
        return n

    def at_comment(self):
        self._skip()
        return self.peek() == '#' and self.pos == self.sep_end

    def skip_comment(self):
        # コメントの中では行継続を取り除かない
        t = self.text
        while self.pos < len(t) and t[self.pos] != '\n' and not t.startswith('\r\n', self.pos):
            self.pos += 1

    def is_word_start(self):
        c = self.peek()
        return not (c == '' or c in SPACES or self.at_newline()
                    or (c in SPECIALS and c not in ('"', "'", '$', '\\')))

    def is_bare(self):
        return self.is_word_start() and self.peek() not in ('"', "'", '$', '\\')

    def at_stmt_end(self, term):
        c = self.peek()
        return c == '' or self.at_newline() or c == ';' or c == term or self.at_comment()

    def describe(self):
        c = self.peek()
        if c == '':
            return 'end of input'
        if self.at_terminator():
            return self.keyword()
        if self.at_newline():
            return 'newline'
        return repr(c)

    def expect(self, c):
        if self.peek() != c:
            self.error(f'expected {c!r}, but found {self.describe()}')
        self.advance()

    # -- スクリプトとコマンド行 --

    def parse_program(self):
        self._mark_sep()
        script = self.parse_script(None)
        if self.peek() != '':
            self.error(f'unexpected {self.describe()}')
        return script

    def parse_script(self, term):
        lines = NodeList()
        lines.pos = self._index(0)
        while True:
            stmts = self.parse_command_line(term)
            if stmts:
                lines.append(stmts)
            if not self.at_newline():
                break
            self.consume_newline()
        if term is not None and self.peek() != term:
            self.error(f'expected {term!r}, but found {self.describe()}')
        return lines

    def parse_command_line(self, term):
        stmts = NodeList()
        while True:
            self.skip_spaces()
            if self.at_comment():
                self.skip_comment()
                break
            c = self.peek()
            if c == '' or self.at_newline() or c == term or self.at_terminator():
                break
            s = self.parse_statement(term)
            if not stmts:
                stmts.pos = s.pos
            stmts.append(s)
            self.skip_spaces()
            if self.peek() == ';':
                self.advance()
                self._mark_sep()
                continue
            if self.at_comment():
                self.skip_comment()
                break
            c = self.peek()
            if c == '' or self.at_newline() or c == term or self.at_terminator():
                break
            self.error(f'unexpected {self.describe()}')
        return stmts

    # -- 文 --

    def keyword(self):
        # 直後が空白、改行、;、|、&、入力の終わりのときだけキーワードになる
        for kw in KEYWORDS:
            n = len(kw)
            if self.peek_str(n) == kw:
                c = self.peek(n)
                if c == '' or c in SPACES or c in (';', '|', '&') or self.at_newline(n):
                    return kw
        return None

    def at_terminator(self):
        return self.keyword() in TERMINATORS

    def expect_keyword(self, kw):
        if self.keyword() != kw:
            self.error(f'expected {kw}, but found {self.describe()}')
        pos = self._index(0)
        self.advance(len(kw))
        return pos

    def parse_statement(self, term):
        pos = self._index(0)
        kw = self.keyword()
        if kw == 'return':
            self.advance(len(kw))
            if self.skip_spaces() == 0 or not self.is_word_start() or self.at_comment():
                self.error('expected a word after return')
            return node(pos, 'return', self.parse_word())
        if kw in ('break', 'continue'):
            # break [変数名]、continue [変数名]
            self.advance(len(kw))
            name = None
            if self.skip_spaces() and not self.at_comment() and not self.at_stmt_end(term):
                if not is_ident_start(self.peek()):
                    self.error(f'expected a variable name after {kw}, but found {self.describe()}')
                name = self.parse_ident()
            return node(pos, kw, name)
        if kw == 'export':
            self.advance(len(kw))
            if self.peek() == '' or self.at_newline():
                self.error('export followed by a newline')
            items = []
            while self.skip_spaces() and is_ident_start(self.peek()):
                ipos = self._index(0)
                name = self.parse_ident()
                if self.peek() == '=':
                    self.advance()
                    items.append(node(ipos, 'def', name, self.parse_value()))
                else:
                    items.append(node(ipos, 'name', name))
            return node(pos, 'export', items)
        if kw == 'function':
            self.advance(len(kw))
            if self.peek() == '' or self.at_newline():
                self.error('function followed by a newline')
            self.skip_spaces()
            if not is_ident_start(self.peek()):
                self.error(f'expected a function name, but found {self.describe()}')
            name = self.parse_ident()
            self.skip_spaces()
            if self.peek() != '(':
                self.error(f"expected '(', but found {self.describe()}")
            params = self.parse_params()
            self.skip_spaces()
            self.expect('{')
            body = self.parse_script('}')
            self.advance()
            return node(pos, 'function', name, params, body)

        defs = []
        while self.at_def():
            defs.append(self.parse_def())
            if self.skip_spaces() == 0 or not self.at_def():
                break
        if defs and self.at_stmt_end(term):
            return node(defs[0].pos, 'assign', defs)
        return self.parse_command_list(defs)

    def at_def(self):
        if not is_ident_start(self.peek()):
            return False
        k = 1
        while is_ident_char(self.peek(k)):
            k += 1
        return self.peek(k) == '='

    def parse_def(self):
        pos = self._index(0)
        name = self.parse_ident()
        self.advance()  # =
        return node(pos, 'def', name, self.parse_value())

    def parse_value(self):
        # 値 = [語] | "(" {スペース} [語 {スペース+ 語}] {スペース} ")"。空なら None
        if self.peek() == '(':
            pos = self._index(0)
            self.advance()
            self.skip_spaces()
            words = []
            while self.peek() != ')':
                if not self.is_word_start():
                    self.error(f"expected a word or ')', but found {self.describe()}")
                words.append(self.parse_word())
                if self.skip_spaces() == 0 and self.peek() != ')':
                    self.error(f"expected ')', but found {self.describe()}")
            self.advance()
            if self.is_word_start():
                self.error(f"unexpected {self.describe()} after ')'")
            return node(pos, 'array', words)
        return self.parse_word() if self.is_word_start() else None

    def parse_ident(self):
        name = ''
        while is_ident_char(self.peek()):
            name += self.peek()
            self.advance()
        return name

    def parse_params(self):
        pos = self._index(0)
        self.advance()  # (
        self.skip_spaces()
        names = []
        rest = None
        if is_ident_start(self.peek()):
            names.append(self.parse_ident())
            while self.skip_spaces() and is_ident_start(self.peek()):
                names.append(self.parse_ident())
        if self.peek() == '.':
            self.advance()
            self.skip_spaces()
            if not is_ident_start(self.peek()):
                self.error(f'expected a variable name after ., but found {self.describe()}')
            rest = self.parse_ident()
            self.skip_spaces()
        self.expect(')')
        return node(pos, 'params', names, rest)

    # -- コマンド列、パイプライン、単純文 --

    def parse_command_list(self, defs):
        items = []
        while True:
            p = self.parse_pipeline(defs)
            defs = None
            self.skip_spaces()
            if self.peek() != '&':
                items.append(p)
                break
            self.advance()
            self._mark_sep()
            items.append(node(p.pos, 'bg', p))
            self.skip_spaces()
            if not self.is_word_start() or self.at_comment() or self.at_terminator():
                break
        if len(items) == 1 and items[0][0] != 'bg':
            return items[0]
        return node(items[0].pos, 'list', items)

    def parse_pipeline(self, defs):
        cmds = [self.parse_simple(defs)]
        while True:
            self.skip_spaces()
            if self.peek() != '|':
                break
            self.advance()
            self._mark_sep()
            # | の後には、空白と改行を混ぜて置ける。改行の前には行コメントを置ける
            while True:
                if self.at_comment():
                    self.skip_comment()
                if self.at_newline():
                    self.consume_newline()
                elif self.skip_spaces() == 0:
                    break
            cmds.append(self.parse_simple(None))
        return cmds[0] if len(cmds) == 1 else node(cmds[0].pos, 'pipe', cmds)

    def parse_simple(self, defs):
        # 文の先頭で読んだ前置の変数定義があれば、単純文はそこから始まる
        pos = defs[0].pos if defs else self._index(0)
        if defs is None:
            defs = []
            while self.at_def():
                defs.append(self.parse_def())
                if self.skip_spaces() == 0:
                    break
        # 単純文の先頭のキーワード。前置の変数定義の後ではキーワードにならない
        kw = None if defs else self.keyword()
        if kw == 'if':
            clauses, else_body = self.parse_if()
            redirs = []
            if self.skip_spaces() and not self.at_comment() and self.at_redirect():
                self.parse_redirects(redirs)
            return node(pos, 'if', clauses, else_body, redirs)
        if kw == 'for':
            name, words, body = self.parse_for()
            redirs = []
            if self.skip_spaces() and not self.at_comment() and self.at_redirect():
                self.parse_redirects(redirs)
            return node(pos, 'for', name, words, body, redirs)
        if kw is not None:
            self.error(f'unexpected {kw}')
        if not self.is_word_start() or self.at_redirect() or self.at_comment():
            self.error(f'expected a command, but found {self.describe()}')
        words = [self.parse_word()]
        redirs = []
        while True:
            if self.skip_spaces() == 0 or self.at_comment():
                return node(pos, 'cmd', defs, words, redirs)
            if self.at_redirect():
                break
            if not self.is_word_start():
                return node(pos, 'cmd', defs, words, redirs)
            words.append(self.parse_word())
        self.parse_redirects(redirs)
        return node(pos, 'cmd', defs, words, redirs)

    def parse_redirects(self, redirs):
        while True:
            redirs.append(self.parse_redirect())
            if self.skip_spaces() == 0 or self.at_comment():
                break
            if self.at_redirect():
                continue
            if self.is_word_start():
                self.error('a word after a redirection')
            break

    def parse_for(self):
        # "for" スペース+ 変数名 スペース+ "in" {スペース+ 語} {スペース} (";" | 行末) {空白} "do" スクリプト "done"
        self.advance(3)
        if self.skip_spaces() == 0 or not is_ident_start(self.peek()):
            self.error(f'expected a variable name after for, but found {self.describe()}')
        name = self.parse_ident()
        spaced = self.skip_spaces() > 0
        c = self.peek(2)
        if (not spaced or self.peek_str(2) != 'in'
                or not (c == '' or c in SPACES or c == ';' or self.at_newline(2))):
            self.error(f'expected in, but found {self.describe()}')
        ipos = self._index(0)
        self.advance(2)
        words = []
        while True:
            n = self.skip_spaces()
            if self.peek() in ('', ';') or self.at_newline() or self.at_comment():
                break
            if n == 0 or not self.is_word_start():
                self.error(f"expected a word, ';' or a newline, but found {self.describe()}")
            words.append(self.parse_word())
        if self.peek() == ';':
            self.advance()
            self._mark_sep()
        else:
            if self.at_comment():
                self.skip_comment()
            if not self.at_newline():
                self.error(f"expected ';' or a newline, but found {self.describe()}")
            self.consume_newline()
        # do の前には、スペース、改行、行コメントを置ける
        while True:
            self.skip_spaces()
            if self.at_comment():
                self.skip_comment()
            if not self.at_newline():
                break
            self.consume_newline()
        self.expect_keyword('do')
        body = self.parse_script(None)
        self.expect_keyword('done')
        return name, node(ipos, 'in', words), body

    def parse_if(self):
        # if、elif ごとに条件と本体のスクリプトを読む。スクリプトはキーワードの直後から始まる
        clauses = []
        kw = 'if'
        while kw in ('if', 'elif'):
            pos = self.expect_keyword(kw)
            cond = self.parse_script(None)
            self.expect_keyword('then')
            body = self.parse_script(None)
            clauses.append(node(pos, 'clause', cond, body))
            kw = self.keyword()
        else_body = None
        if kw == 'else':
            pos = self.expect_keyword('else')
            else_body = node(pos, 'else', self.parse_script(None))
        self.expect_keyword('fi')
        return clauses, else_body

    def at_redirect(self):
        s = self.peek_str(4)
        return s[:1] in ('<', '>') or s.startswith('2>') or s == '1>&2'

    def parse_redirect(self):
        pos = self._index(0)
        s = self.peek_str(4)
        if s in ('1>&2', '2>&1'):
            self.advance(4)
            return node(pos, 'redir', s, None)
        if s.startswith('>>'):
            op = '>>'
        elif s.startswith('2>'):
            op = '2>'
        else:
            op = s[0]
        self.advance(len(op))
        self.skip_spaces()
        if op != '>>' and self.peek() == '(':
            return node(pos, 'redir', op, self.parse_params())
        if not self.is_word_start() or self.at_comment():
            self.error(f'expected a redirection target, but found {self.describe()}')
        return node(pos, 'redir', op, self.parse_word())

    # -- 語 --

    def parse_word(self):
        pos = self._index(0)
        elems = []
        while True:
            self._skip()
            epos = self.pos
            c = self.peek()
            if c == "'":
                start = self.pos
                end = self.text.find("'", self.pos + 1)
                if end < 0:
                    self.error("unterminated '", start)
                elems.append(node(epos, 'sq', self.text[self.pos + 1:end]))
                self.pos = end + 1
            elif c == '"':
                elems.append(self.parse_dq())
            elif c == '$' and self.peek(1) == "'":
                elems.append(self.parse_ansi_c())
            elif c == '$':
                e = self.parse_dollar()
                if e is None:
                    add_lit(elems, '$', epos)
                    self.advance()
                else:
                    elems.append(e)
            elif c == '\\':
                self.advance()
                if self.pos >= len(self.text):
                    self.error('\\ at the end of input')
                elems.append(node(epos, 'esc', self.text[self.pos]))
                self.pos += 1
            elif self.is_bare():
                add_lit(elems, c, epos)
                self.advance()
            else:
                break
        return node(pos, 'word', elems)

    def parse_ansi_c(self):
        # $'...' を読み、エスケープを文字にした sq の節を返す。中では行継続を取り除かない
        start = self.pos
        t = self.text
        i = start + 2
        out = []
        raw = bytearray()  # \xHH の続き。まとめて UTF-8 として読む

        def flush():
            if raw:
                out.append(raw.decode('utf-8', 'replace'))
                raw.clear()

        while True:
            if i >= len(t):
                self.error("unterminated $'", start)
            c = t[i]
            if c == "'":
                break
            if c != '\\' or i + 1 >= len(t):
                flush()
                out.append(c)
                i += 1
                continue
            d = t[i + 1]
            if d in 'xu':
                n = 2 if d == 'x' else 4
                j = i + 2
                while j < len(t) and j < i + 2 + n and t[j] in '0123456789abcdefABCDEF':
                    j += 1
                if j > i + 2:
                    code = int(t[i + 2:j], 16)
                    if d == 'x':
                        raw.append(code)
                    else:
                        flush()
                        out.append(chr(code))
                    i = j
                    continue
            flush()
            out.append(ANSI_C_ESCAPES.get(d, '\\' + d))
            i += 2
        flush()
        self.pos = i + 1
        return node(start, 'sq', ''.join(out))

    def parse_dq(self):
        start = self.pos
        self.advance()  # "
        elems = []
        while True:
            self._skip()
            epos = self.pos
            if self.pos >= len(self.text):
                self.error('unterminated "', start)
            c = self.peek()
            if c == '"':
                self.advance()
                return node(start, 'dq', elems)
            if c == '$':
                e = self.parse_dollar()
                if e is None:
                    add_lit(elems, '$', epos)
                    self.advance()
                else:
                    elems.append(e)
            elif c == '\\':
                self.advance()
                if self.pos >= len(self.text):
                    self.error('unterminated "', start)
                ch = self.text[self.pos]
                self.pos += 1
                add_lit(elems, ch if ch in ('"', '$', '\\') else '\\' + ch, epos)
            else:
                add_lit(elems, c, epos)
                self.advance()

    def parse_dollar(self):
        # 変数参照かコマンド置換を作れなければ None を返し、$ は読まない
        pos = self._index(0)
        c = self.peek(1)
        if c == '(':
            self.advance(2)
            script = self.parse_script(')')
            self.advance()
            return node(pos, 'subst', script)
        if c == '{' and self.peek(2) == '-':
            # ${-語}：語の glob の結果の LazyList。二重引用符の中でも語として読む
            self.advance(3)
            if not self.is_word_start():
                self.error(f"expected a pattern after '${{-', but found {self.describe()}")
            word = self.parse_word()
            if self.peek() != '}':
                self.error(f"expected '}}', but found {self.describe()}")
            self.advance()
            return node(pos, 'glob', word)
        if c == '{':
            k = 2
            if is_ident_start(self.peek(k)):
                while is_ident_char(self.peek(k)):
                    k += 1
            elif is_digit(self.peek(k)):
                while is_digit(self.peek(k)):
                    k += 1
            elif self.peek(k) == '@':
                k += 1
            if k == 2 or self.peek(k) not in ('}', '-'):
                return None
            name = ''.join(self.peek(i) for i in range(2, k))
            self.advance(k)
            default = None
            if self.peek() == '-':
                # 既定値。二重引用符の中でも語として読む
                dpos = self._index(0)
                self.advance()
                default = node(dpos, 'default', self.parse_value())
                if self.peek() != '}':
                    self.error(f"expected '}}', but found {self.describe()}")
            self.advance()
            return node(pos, 'bvar', name, default)
        if is_ident_start(c):
            self.advance()
            return node(pos, 'var', self.parse_ident())
        if is_digit(c) or (c != '' and c in '@#?!$'):
            self.advance(2)
            return node(pos, 'var', c)
        return None


ANSI_C_ESCAPES = {'n': '\n', 't': '\t', 'r': '\r', '\\': '\\', "'": "'", '"': '"'}


def add_lit(elems, s, pos):
    if elems and elems[-1][0] == 'lit':
        elems[-1] = node(elems[-1].pos, 'lit', elems[-1][1] + s)
    else:
        elems.append(node(pos, 'lit', s))


# ----------------------------------------------------------------------
# 構文木の出力
# ----------------------------------------------------------------------

def q(s):
    s = (s.replace('\\', '\\\\').replace('"', '\\"')
         .replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t'))
    return f'"{s}"'


# --pos のとき、出力する元の文字列。各節の種類の後に (行 桁) を入れる
POS_TEXT = None


def sx(kind, pos, *parts):
    head = [kind]
    if POS_TEXT is not None:
        line, col = line_col(POS_TEXT, pos)
        head.append(f'({line} {col})')
    return '(' + ' '.join(head + list(parts)) + ')'


def sx_line(stmts):
    return sx('line', stmts.pos, *(sx_stmt(s) for s in stmts))


def sx_script(lines):
    return sx('script', lines.pos, *(sx_line(l) for l in lines))


def sx_stmt(s):
    kind = s[0]
    if kind == 'return':
        return sx(kind, s.pos, sx_word(s[1]))
    if kind in ('break', 'continue'):
        return sx(kind, s.pos) if s[1] is None else sx(kind, s.pos, q(s[1]))
    if kind == 'for':
        _, name, words, body, redirs = s
        parts = [q(name), sx('in', words.pos, *(sx_word(w) for w in words[1])), sx_script(body)]
        if redirs:
            parts.append(sx('redirs', redirs[0].pos, *(sx_redir(r) for r in redirs)))
        return sx(kind, s.pos, *parts)
    if kind in ('export', 'assign'):
        return sx(kind, s.pos, *(sx_item(i) for i in s[1]))
    if kind == 'function':
        return sx(kind, s.pos, q(s[1]), sx_params(s[2]), sx_script(s[3]))
    if kind in ('list', 'pipe'):
        return sx(kind, s.pos, *(sx_stmt(x) for x in s[1]))
    if kind == 'bg':
        return sx(kind, s.pos, sx_stmt(s[1]))
    if kind == 'if':
        _, clauses, else_body, redirs = s
        parts = [sx('clause', c.pos, sx_script(c[1]), sx_script(c[2])) for c in clauses]
        if else_body is not None:
            parts.append(sx('else', else_body.pos, sx_script(else_body[1])))
        if redirs:
            parts.append(sx('redirs', redirs[0].pos, *(sx_redir(r) for r in redirs)))
        return sx(kind, s.pos, *parts)
    if kind == 'cmd':
        _, defs, words, redirs = s
        parts = []
        if defs:
            parts.append(sx('env', defs[0].pos, *(sx_item(d) for d in defs)))
        parts.append(sx('words', words[0].pos, *(sx_word(w) for w in words)))
        if redirs:
            parts.append(sx('redirs', redirs[0].pos, *(sx_redir(r) for r in redirs)))
        return sx(kind, s.pos, *parts)
    raise ValueError(kind)


def sx_item(i):
    if i[0] == 'name' or i[2] is None:
        return sx(i[0], i.pos, q(i[1]))
    return sx(i[0], i.pos, q(i[1]), sx_def_value(i[2]))


def sx_def_value(v):
    # 値。語か (array 語 ...)
    if v[0] == 'array':
        return sx('array', v.pos, *(sx_word(w) for w in v[1]))
    return sx_word(v)


def sx_params(p):
    _, names, rest = p
    parts = ['(' + ' '.join(q(n) for n in names) + ')']
    if rest is not None:
        parts.append(q(rest))
    return sx('params', p.pos, *parts)


def sx_redir(r):
    _, op, target = r
    if target is None:
        return sx('redir', r.pos, q(op))
    if target[0] == 'params':
        return sx('redir', r.pos, q(op), sx_params(target))
    return sx('redir', r.pos, q(op), sx_word(target))


def sx_word(w):
    return sx('word', w.pos, *(sx_elem(e) for e in w[1]))


def sx_elem(e):
    kind = e[0]
    if kind in ('lit', 'esc', 'sq', 'var'):
        return sx(kind, e.pos, q(e[1]))
    if kind == 'bvar':
        _, name, default = e
        if default is None:
            return sx(kind, e.pos, q(name))
        if default[1] is None:
            return sx(kind, e.pos, q(name), sx('default', default.pos))
        return sx(kind, e.pos, q(name), sx('default', default.pos, sx_def_value(default[1])))
    if kind == 'dq':
        return sx(kind, e.pos, *(sx_elem(x) for x in e[1]))
    if kind == 'subst':
        return sx(kind, e.pos, sx_script(e[1]))
    if kind == 'glob':
        return sx(kind, e.pos, sx_word(e[1]))
    raise ValueError(kind)


# ----------------------------------------------------------------------
# 展開
# ----------------------------------------------------------------------

class LazyList(list):
    """局所変数の LazyList の値。文字列と区別するために list と別の型にする"""


class GlobList(LazyList):
    """${-語} の値。葉は glob の結果のファイル名なので、外部コマンドの語でもう一度 glob を適用しない"""


GLOB_META = re.compile(r'[*?[]')


BUILTINS = ('echo', 'cd', 'defined', 'builtin', 'command')


class Context:
    def __init__(self, local, env, funcs):
        self.local = local
        self.env = env
        self.funcs = funcs  # それまでに定義した関数の名前

    def copy(self):
        return Context(dict(self.local), dict(self.env), set(self.funcs))


def leaves(v):
    # 入れ子の LazyList を再帰的にたどった文字列の並び
    if isinstance(v, LazyList):
        return [x for e in v for x in leaves(e)]
    return [v]


def map_leaves(v, f):
    # 入れ子の形を保ったまま、葉の文字列に f を適用する
    if isinstance(v, LazyList):
        return LazyList(map_leaves(e, f) for e in v)
    return f(v)


def sx_value(v):
    if isinstance(v, LazyList):
        return '(list' + ''.join(' ' + sx_value(e) for e in v) + ')'
    return q(v)


class LoopJump(Exception):
    """break と continue。name はループ変数の名前（省略なら None）"""

    def __init__(self, kind, name):
        super().__init__(kind)
        self.kind = kind
        self.name = name


class Expander:
    def __init__(self, script_name, args):
        self.script_name = script_name
        self.args = args
        self.loops = []  # 実行中の for 文のループ変数の名前。内側が後

    def run(self, lines):
        ctx = Context({}, {}, set())
        self.exec_lines(lines, ctx, None)

    def exec_lines(self, lines, ctx, out):
        for stmts in lines:
            for s in stmts:
                r = self.exec_stmt(s, ctx, out)
                if out is None and r is not None:
                    print(r)

    def exec_stmt(self, s, ctx, out):
        """文を実行する。out が None ならトップレベルで、展開した結果の S 式を返す。
        out がリストなら $( ) の中で、echo の出力を out に加える。"""
        kind = s[0]
        if kind == 'return':
            raise ConShError('return outside a function', s.pos)
        if kind in ('break', 'continue'):
            name = s[1]
            if not self.loops:
                raise ConShError(f'{kind} outside a loop', s.pos)
            if name is not None and name not in self.loops:
                raise ConShError(f'{kind}: no loop for {name}', s.pos)
            raise LoopJump(kind, name)
        if kind == 'for':
            return self.exec_for(s, ctx, out)
        if kind == 'export':
            result = []
            for item in s[1]:
                if item[0] == 'name':
                    name = item[1]
                    if name not in ctx.local:
                        raise ConShError(f'export of an undefined local variable: {name}', item.pos)
                    value = self.to_string(ctx.local[name], ctx, item.pos)
                else:
                    name = item[1]
                    value = self.to_string(self.def_value(item[2], ctx), ctx, item.pos)
                ctx.env[name] = value
                result.append(f'({q(name)} {q(value)})')
            return '(export' + ''.join(' ' + r for r in result) + ')'
        if kind == 'function':
            ctx.funcs.add(s[1])
            return f'(function {q(s[1])})'
        if kind == 'assign':
            result = []
            for _, name, v in s[1]:
                value = self.def_value(v, ctx)
                ctx.local[name] = value
                result.append(f'({q(name)} {sx_value(value)})')
            return '(assign' + ''.join(' ' + r for r in result) + ')'
        if kind in ('list', 'pipe', 'bg'):
            if out is not None:
                raise ConShError('pipes and & are not supported in $( ) of the expand mode', s.pos)
            if kind == 'bg':
                return f'(bg {self.exec_part(s[1], ctx)})'
            return f'({kind} ' + ' '.join(self.exec_part(x, ctx) for x in s[1]) + ')'
        if kind == 'cmd':
            return self.exec_cmd(s, ctx, out)
        if kind == 'if':
            raise ConShError('if is not supported in the expand mode', s.pos)
        raise ValueError(kind)

    def exec_part(self, s, ctx):
        # パイプラインと & の要素。for 文は別の VProc で回すことになるので、展開のモードでは扱わない
        if s[0] == 'for':
            raise ConShError('for in a pipeline or with & is not supported in the expand mode', s.pos)
        return self.exec_stmt(s, ctx, None)

    def exec_for(self, s, ctx, out):
        """for 文を実行する。語は関数の引数と同じ規則で展開し、LazyList の値は1階層だけ開く"""
        _, name, words, body, redirs = s
        if redirs:
            raise ConShError('redirections of for are not supported in the expand mode', s.pos)
        values = [v for w in words[1] for v in self.arg_values(w, ctx)]
        items = [x for v in values for x in (v if isinstance(v, LazyList) else [v])]
        self.loops.append(name)
        try:
            for item in items:
                ctx.local[name] = item
                if out is None:
                    print(f'(for {q(name)} {sx_value(item)})')
                try:
                    self.exec_lines(body, ctx, out)
                except LoopJump as jump:
                    if jump.name is not None and jump.name != name:
                        raise
                    if jump.kind == 'break':
                        break
        finally:
            self.loops.pop()
        return None

    def exec_cmd(self, s, ctx, out):
        _, defs, words, redirs = s
        pos = s.pos
        # 前置の変数定義は、どれも呼び出し側の値で展開し、同じ文の語の展開に反映する
        env = [(name, self.to_string(self.def_value(v, ctx), ctx, d.pos)) for d in defs for _, name, v in [d]]
        if env:
            ctx = Context(ctx.local, dict(ctx.env), ctx.funcs)
            ctx.env.update(env)
        name, more, rest = self.head(words, ctx)
        external = name is not None and name not in ctx.funcs and name not in BUILTINS
        values = [] if name is None else [name]
        values += [x for v in more for x in leaves(v)] if external else more
        for w in rest:
            values.extend(self.fields(w, ctx) if external else self.arg_values(w, ctx))
        rs = [self.redir(r, ctx) for r in redirs]
        if out is not None:
            if rs:
                raise ConShError('redirections are not supported in $( ) of the expand mode', pos)
            if name is None:
                return None
            if name != 'echo':
                raise ConShError(f'only echo can run in $( ) of the expand mode: {name}', pos)
            args = values[1:]
            if len(args) == 1:
                out.append(args[0])
            else:
                out.append(' '.join(self.to_string(a, ctx, pos) for a in args))
            return None
        parts = []
        if env:
            parts.append('(env ' + ' '.join(f'({q(n)} {q(v)})' for n, v in env) + ')')
        parts.append('(words' + ''.join(' ' + sx_value(v) for v in values) + ')')
        if rs:
            parts.append('(redirs ' + ' '.join(rs) + ')')
        return '(cmd ' + ' '.join(parts) + ')'

    def redir(self, r, ctx):
        _, op, target = r
        if target is None:
            return f'({q(op)})'
        if target[0] == 'params':
            return f'({q(op)} {sx_params(target)})'
        fields = self.fields(target, ctx)
        if len(fields) != 1:
            raise ConShError(f'ambiguous redirect: {len(fields)} words', target.pos)
        return f'({q(op)} {q(fields[0])})'

    # -- 変数参照 --

    def lookup(self, name, ctx, pos):
        if not self.defined(name, ctx):
            if is_digit(name[0]):
                raise ConShError(f'missing positional parameter: ${name}', pos)
            raise ConShError(f'undefined variable: {name}', pos)
        if name == '@':
            return LazyList(self.args)
        if is_digit(name[0]):
            n = int(name)
            return self.script_name if n == 0 else self.args[n - 1]
        if name == '#':
            return str(len(self.args))
        if name == '?':
            return '0'
        if name == '!':
            return ''
        if name == '$':
            return '1'
        if name in ctx.local:
            return ctx.local[name]
        return ctx.env[name]

    def defined(self, name, ctx):
        if is_digit(name[0]):
            return int(name) <= len(self.args)
        if name in ('@', '#', '?', '!', '$'):
            return True
        return name in ctx.local or name in ctx.env

    def to_string(self, v, ctx, pos):
        """値を文字列化する。LazyList は葉を OFS で区切って連結する"""
        if not isinstance(v, LazyList):
            return v
        ofs = ctx.local.get('OFS', ctx.env.get('OFS', ' '))
        if isinstance(ofs, LazyList):
            raise ConShError('OFS is a LazyList', pos)
        return ofs.join(leaves(v))

    def subst(self, lines, ctx):
        sub = ctx.copy()
        out = []
        # $( ) の中から外のループに break や continue はできない
        loops, self.loops = self.loops, []
        try:
            self.exec_lines(lines, sub, out)
        finally:
            self.loops = loops
        return LazyList(out)

    # -- 語の展開 --
    #
    # 語は語要素ごとの部分に分けてから展開する。部分は (種類, 値) で、種類は次のどれか。
    #   'plain'  引用符のない文字列（glob を適用する）
    #   'quoted' 引用符の中の文字列
    #   'braced' ${x} の文字列の値。外部コマンド以外には、空文字列でも1つの語として渡す
    #   'leaves' $x の LazyList の値。葉ごとの語になる
    #   'list'   ${x} とコマンド置換の LazyList の値。外部コマンド以外には値のまま渡す

    def parts(self, word, ctx):
        result = []
        for e in word[1]:
            kind = e[0]
            if kind in ('lit', 'esc'):
                result.append(('plain' if kind == 'lit' else 'quoted', e[1]))
            elif kind == 'sq':
                result.append(('quoted', e[1]))
            elif kind == 'dq':
                result.append(('quoted', self.expand_dq(e[1], ctx)))
            else:
                v = self.ref(e, ctx)
                if isinstance(v, LazyList):
                    # ${-語} は ${x} と同じく、外部コマンド以外には1つの LazyList として渡す
                    result.append(('leaves' if kind == 'var' else 'list', v))
                else:
                    result.append(('plain' if kind == 'var' else 'braced', v))
        return result

    def ref(self, e, ctx):
        # 変数参照かコマンド置換の値。${x-値} は、x が未定義のときだけ値を作る
        if e[0] == 'subst':
            return self.subst(e[1], ctx)
        if e[0] == 'glob':
            return self.glob_value(e[1], ctx)
        if e[0] == 'bvar' and e[2] is not None and not self.defined(e[1], ctx):
            return self.def_value(e[2][1], ctx)
        return self.lookup(e[1], ctx, e.pos)

    def expand_dq(self, elems, ctx):
        # "..." は1つの文字列になる。LazyList は文字列化する
        out = ''
        for e in elems:
            out += e[1] if e[0] == 'lit' else self.to_string(self.ref(e, ctx), ctx, e.pos)
        return out

    def fields(self, word, ctx):
        """外部コマンドの語として展開する。
        LazyList を含まない引用符のない語が空になれば消す。LazyList の葉は、空文字列でも語として残す"""
        return self.glob_fields(word, ctx, False)

    def glob_fields(self, word, ctx, null_glob):
        """語を外部コマンドの語として展開し、glob を適用する。引用符の中と ${-語} の葉には適用しない。
        一致しなければ、null_glob が偽なら語をそのまま残し、真なら消す"""
        alts = [[]]
        quoted = False
        has_list = False
        for kind, v in self.parts(word, ctx):
            if kind in ('leaves', 'list'):
                has_list = True
                active = not isinstance(v, GlobList)
                options = [(x, active) for x in leaves(v)]
            elif kind == 'quoted':
                quoted = True
                options = [(v, False)]
            else:
                options = [(v, True)]
            alts = [a + [o] for a in alts for o in options]
        result = []
        for alt in alts:
            text = ''.join(t for t, _ in alt)
            if text == '' and not quoted and not has_list:
                continue
            if any(active and GLOB_META.search(t) for t, active in alt):
                pattern = ''.join(t if active else glob.escape(t) for t, active in alt)
                matches = sorted(glob.glob(pattern))
                if matches or null_glob:
                    result.extend(matches)
                    continue
            result.append(text)
        return result

    def glob_value(self, word, ctx):
        """${-語} の値。語を外部コマンドの語として展開して glob を適用し、一致した名前の LazyList にする。
        一致しなければ空の LazyList。glob の記号がなければ、展開した語をそのまま要素にする"""
        return GlobList(self.glob_fields(word, ctx, True))

    def arg_values(self, word, ctx):
        """外部コマンド以外（関数と組み込みコマンド）の語として展開した値の並び。
        $x の LazyList を含めば葉ごとの文字列。そうでなく ${x} の LazyList を含めば、1つの LazyList。
        どちらも含まなければ外部コマンドの語と同じ。ただし ${x} を含む語は、空文字列でも消さない"""
        parts = self.parts(word, ctx)
        kinds = [k for k, _ in parts]
        if 'leaves' in kinds:
            return self.fields(word, ctx)
        if 'list' in kinds:
            return [self.list_value(parts)]
        if 'braced' in kinds and ''.join(v for _, v in parts) == '':
            return ['']
        return self.fields(word, ctx)

    def list_value(self, parts):
        # ${x} の LazyList を含む部分の値。1つなら前後の文字列を葉に付け、2つ以上なら葉の直積
        kinds = [k for k, _ in parts]
        if kinds.count('list') == 1:
            i = kinds.index('list')
            left = ''.join(v for _, v in parts[:i])
            right = ''.join(v for _, v in parts[i + 1:])
            return map_leaves(parts[i][1], lambda x: left + x + right)
        alts = ['']
        for kind, v in parts:
            options = leaves(v) if kind == 'list' else [v]
            alts = [a + o for a in alts for o in options]
        return LazyList(alts)

    def head(self, words, ctx):
        """先頭の語を展開して、コマンドの名前、先頭の語から出た残りの値、残りの語を返す。
        ${x} とコマンド置換の LazyList なら、要素を順に値にし、先頭の要素だけを再帰的に展開して名前を取る。
        そうでなければ外部コマンドの語として展開する。LazyList を含む語が空になればエラー。
        LazyList を含まない語が消えれば、次の語を見る。語がすべて消えたら、名前は None"""
        for i, word in enumerate(words):
            parts = self.parts(word, ctx)
            kinds = [k for k, _ in parts]
            if 'leaves' not in kinds and 'list' in kinds:
                v = self.list_value(parts)
                more = []
                while isinstance(v, LazyList):
                    if not v:
                        raise ConShError('the command name is an empty LazyList', word.pos)
                    more[0:0] = v[1:]
                    v = v[0]
                return v, more, words[i + 1:]
            fields = self.fields(word, ctx)
            if fields:
                return fields[0], fields[1:], words[i + 1:]
            if 'leaves' in kinds or 'list' in kinds:
                raise ConShError('the command name is an empty LazyList', word.pos)
        return None, [], []

    def def_value(self, v, ctx):
        """変数定義の右辺の値。v は None（空）、語、または (array 語 ...)"""
        if v is None:
            return ''
        if v[0] == 'array':
            return LazyList(f for w in v[1] for f in self.fields(w, ctx))
        return self.value(v, ctx)

    def value(self, word, ctx):
        """変数定義の右辺の語の値。
        $x の LazyList を含めば、葉の語が1つならその文字列、なければ空文字列、2つ以上ならエラー。
        そうでなく ${x} かコマンド置換の LazyList を含めば LazyList。どちらでもなければ文字列"""
        parts = self.parts(word, ctx)
        kinds = [k for k, _ in parts]
        if 'leaves' in kinds:
            alts = ['']
            for kind, v in parts:
                options = leaves(v) if kind in ('leaves', 'list') else [v]
                alts = [a + o for a in alts for o in options]
            if len(alts) > 1:
                raise ConShError(f'{len(alts)} words in a variable definition', word.pos)
            return alts[0] if alts else ''
        if kinds.count('list') == 1:
            # 前後の文字列を、入れ子の形を保ったまま葉に付ける
            i = kinds.index('list')
            left = ''.join(v for _, v in parts[:i])
            right = ''.join(v for _, v in parts[i + 1:])
            return map_leaves(parts[i][1], lambda x: left + x + right)
        if 'list' in kinds:
            alts = ['']
            for kind, v in parts:
                options = leaves(v) if kind == 'list' else [v]
                alts = [a + o for a in alts for o in options]
            return LazyList(alts)
        return ''.join(v for _, v in parts)


# ----------------------------------------------------------------------

def line_col(text, pos):
    line = text.count('\n', 0, pos) + 1
    return line, pos - (text.rfind('\n', 0, pos) + 1) + 1


def main():
    global POS_TEXT
    argv = sys.argv[1:]
    mode = argv[0] if argv and argv[0] in ('--expand', '--pos') else None
    if mode:
        argv = argv[1:]
    if not argv or (mode != '--expand' and len(argv) != 1):
        print('Usage: consh_parse [--pos] <script_file>\n'
              '       consh_parse --expand <script_file> [<arg> ...]', file=sys.stderr)
        sys.exit(1)
    filename = argv[0]
    with open(filename, 'r', encoding='utf-8', newline='') as f:
        text = f.read()
    try:
        lines = Parser(text).parse_program()
        if mode == '--expand':
            Expander(filename, argv[1:]).run(lines)
        else:
            if mode == '--pos':
                POS_TEXT = text
            for stmts in lines:
                print(sx_line(stmts))
    except ConShError as e:
        sys.stdout.flush()
        line, col = line_col(text, e.pos)
        print(f'consh_parse: {filename}:{line}:{col}: {e.msg}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
