#!/usr/bin/env python3
"""
consh_parse -- ConSh の構文解析と語の展開の参照実装

ConMa 版の結果と比べるために、構文木と展開の結果をテキストで出力する。
文法は PLAN-ja.md の 1.1 に従う。

Usage:
    consh_parse <script_file>
"""

import sys


def main():
    if len(sys.argv) != 2:
        print('Usage: consh_parse <script_file>', file=sys.stderr)
        sys.exit(1)
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        f.read()
    print('consh_parse: not implemented yet', file=sys.stderr)
    sys.exit(1)


if __name__ == '__main__':
    main()
