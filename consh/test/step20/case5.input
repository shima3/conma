shift k { echo never; }
function s () { shift k { echo in-s; }; }
s
x=$(reset { echo a; }; shift k { echo b; })
reset { x=$(shift k { echo b; }); echo "x=[$x]"; }
reset { s > /dev/null; }
reset { for i in a; do s; done 2> /dev/null; }
reset { s > (v); }
reset { s 2>&1; }
reset { s; } > /dev/null
echo "after redirect reset $?"
reset { echo $(reset { shift k { echo $k; }; }) > (k1); }
reset { shift k { echo $k; }; echo resumed; } > (kk)
reset { return 1; }
for i in a b; do reset { break; }; done
for i in a b; do reset { continue i; }; done
function f () { reset { return 2; }; }
f
reset { shift k { break; }; }
reset { shift k (a b . r) { $k 1 2 3 4; }; echo "a=$a b=$b r=${r}"; }
reset { shift k { $k; $k; }; echo twice; }
echo end
reset { shift k { echo $k; }; echo resumed; } > (kk)
$kk
echo end
function y () { for i in $(seq 1 100); do echo $i; done; }
reset { y; } > (a b); echo "a=$a b=$b"; shift k { echo stale; }
reset { shift k (v) { $k 1 2; }; echo "v=$v"; }
reset { shift k (a . r) { $k; }; echo "a=$a"; }
reset { shift k { $k 1 2; }; echo "no params"; }
echo end
