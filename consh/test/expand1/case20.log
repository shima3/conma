(function "f")
(assign ("l" (list "a" "" "b")) ("s" ""))
(cmd (words "f" (list "a" "" "b") "a" "" "b" (list "xay" "xy" "xby") "" ""))
(cmd (words "cmd" "a" "" "b" "a" "" "b" "xay" "xy" "xby" ""))
(cmd (words "echo" (list "a" "" "b")))
(cmd (words "command" "printf" (list "a" "" "b")))
(cmd (words "builtin" "echo" (list "a" "" "b")))
(cmd (env ("OFS" ",")) (words "f" "a,,b" ","))
(cmd (env ("OFS" ",")) (words "cmd" "a,,b"))
(assign ("x" "5"))
(cmd (env ("x" "1")) (words "cmd" "5"))
(cmd (env ("y" "1")) (words "cmd" "1"))
(cmd (env ("a" "1") ("b" "none")) (words "cmd" "none"))
exit: 0
