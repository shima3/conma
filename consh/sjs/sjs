#!/bin/bash
# SJS のファイルを ConMa に変換して動かす（consh/SAFEJS-PLAN-ja.md の段階 B1）。Rust 版の VM（vm/target/release/conma）を使う。
#   consh/sjs/sjs [--emit] file.safe.js
# --emit を付けると、動かさずに、変換した ConMa のソースを出す。CONMA_VM=wasm なら wasm 版の VM で動かす
sjs="$(cd "$(dirname "$0")"; pwd)"
consh="${sjs%/*}"
root="${consh%/*}"
conma="$root/vm/target/release/conma"
emit=
if [ "$1" = --emit ]; then emit=yes; shift; fi
if [ $# -ne 1 ]; then echo "usage: sjs [--emit] file.safe.js" >&2; exit 2; fi
tmp="$(mktemp -d "${TMPDIR:-/tmp}/sjs.XXXXXX")" || exit 1
trap 'rm -rf "$tmp"' EXIT
# 変換器（sjsc.se と include するもの）のモジュールは、ソースか VM（フロントエンドを持つ）が新しくなったときだけ作り直す
# （作るのに約 4 秒、動かすのは 0.2 秒ほど）。置き場所は $TMPDIR（なければ /tmp）で、名前にこのリポジトリのパスの
# チェックサムを入れて、別のチェックアウトと分ける。一時ファイルに作ってから mv で置き換えるので、同時に動く sjs が
# 作りかけのモジュールを読むことはない
module="${TMPDIR:-/tmp}"
module="${module%/}/sjsc-$(printf '%s' "$sjs" | cksum | cut -d ' ' -f 1).module.se"
dirs=("$consh/include" "$root/include/fast" "$root/include")
if [ ! -s "$module" ] || [ -n "$(find "${dirs[@]}" "$sjs/sjsc.se" \( -name '*.se' -o -type d \) -newer "$module")" ] ||
   [ "$conma" -nt "$module" ]; then
  module_tmp=$(mktemp "$module.XXXXXX") || exit 1
  if ! "$conma" build --include "$consh/include" "$sjs/sjsc.se" > "$module_tmp"; then rm -f "$module_tmp"; exit 1; fi
  mv -f "$module_tmp" "$module"
fi
"$conma" --main "$module" "$1" > "$tmp/prog.se" || exit $?
if [ -n "$emit" ]; then cat "$tmp/prog.se"; exit 0; fi
# CONMA_VM=wasm：変換したプログラムを wasm 版の VM（consh/js/vm-wasm.sh。Node.js）で動かす。数の関数は wasm 版で動く
# （consh/SJS-WASM-PLAN-ja.md の段階 2）。ほかの VM では、数の関数も ConMa 版で動く
if [ "$CONMA_VM" = wasm ]; then
  "$conma" build --include "$consh/include" "$tmp/prog.se" > "$tmp/prog.module.se" || exit $?
  exec "$consh/js/vm-wasm.sh" --main "$tmp/prog.module.se"
fi
"$conma" run --include "$consh/include" "$tmp/prog.se"
