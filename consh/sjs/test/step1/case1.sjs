// 数：算術、/ と % の端、JavaScript と同じ数の書き方
console.log(1 + 2 * 3, (1 + 2) * 3, 10 / 4, 2 - 5)
console.log(0.1 + 0.2, 1 / 3, 100 / 3)
console.log(1 / 0, -1 / 0, 0 / 0)
console.log(7 % 3, -7 % 3, 7 % -3, 5.5 % 2, 1 % 0)
console.log(1e21, 1e20, 123456789 * 1000, 1e-7, 0.000001, 1.5e-10)
console.log(-(3), +4, -(-2.5))
