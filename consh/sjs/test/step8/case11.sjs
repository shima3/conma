// 数の文字列は JavaScript と同じ。ConMa の __Number_toString__ は整数の値の正確な桁を出す（85715430223118336）が、
// SJS は読み戻せる最短の桁にする（Sjs_num_str の Sjs_num_shortest）。17 桁目がちょうど真ん中の数も、近い方の桁
const xs = [85715430223118340, -85715430223118340, 9007199254740992, 9007199254740993, 9007199254740994, 123456789012345678,
  999999999999999999, 99999999999999990000, 100000000000000000000, 999999999999999999999, 2 ** 64, -(2 ** 63), 2 ** 70, 1e17 + 2,
  -126.48391723632812, 0.0023775100708007812, 0.30000000000000004]
for (const x of xs) console.log(String(x), `${x}`, JSON.stringify([x]))
console.log(xs.join(" "))
