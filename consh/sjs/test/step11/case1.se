;; 配列の計画（consh/SJS-WASM-ARRAY-PLAN-ja.md）の段階 A2：実行時の支えが、SJS の配列を wasm のモジュールのメモリに写し、
;; "ok" なら数の配列の要素を書き戻す（配列に書かない関数は書き戻さない）。手で書いた WAT のモジュールと、ConMa 版（"[ConMa]" を出す）を Sjs_wasm_fn で包んで呼ぶ。
;; wasm 版の VM では wasm 版が、ほかの VM では ConMa 版が動き、配列の結果は同じになる
(include "util.se")
(include "sjs_rt.se")

(define num ,(t) __Number_fromString__ __print_exit_error__ t)
(define log1 ,(a) __LList_cons__ a __NULL__ ,(l) Sjs_log l)
(define log2 ,(a b) __LList_cons__ b __NULL__ ,(t) __LList_cons__ a t ,(l) Sjs_log l)
(define list2 ,(a b) __LList_cons__ b __NULL__ ,(t) __LList_cons__ a t)
(define list3 ,(a b c) list2 b c ,(t) __LList_cons__ a t)

;; メモリの語 a（f64）の WAT：(f64.load (i32.mul (i32.trunc_f64_u a) (i32.const 8)))
(define wat ,()
  __NULL__ "(module (memory 1) (func $len (param $a f64) (result f64) (f64.load (i32.mul (i32.trunc_f64_u (local.get $a)) (i32.const 8)))) (func $at (param $a f64) (param $i f64) (result f64) (f64.load (i32.mul (i32.trunc_f64_u (f64.add (f64.add (local.get $a) (f64.const 1)) (local.get $i))) (i32.const 8)))) (func $set (param $a f64) (param $i f64) (param $v f64) (result f64) (f64.store (i32.mul (i32.trunc_f64_u (f64.add (f64.add (local.get $a) (f64.const 1)) (local.get $i))) (i32.const 8)) (local.get $v)) (f64.const 0)) " ,(s)
  __String_concat__ s "(func (export \"sum\") (param $a f64) (result f64) (local $i f64) (local $s f64) block $d loop $l (br_if $d (f64.ge (local.get $i) (call $len (local.get $a)))) (local.set $s (f64.add (local.get $s) (call $at (local.get $a) (local.get $i)))) (local.set $i (f64.add (local.get $i) (f64.const 1))) br $l end end local.get $s) " ,(s)
  __String_concat__ s "(func (export \"scale\") (param $a f64) (param $k f64) (result f64) (local $i f64) block $d loop $l (br_if $d (f64.ge (local.get $i) (call $len (local.get $a)))) (drop (call $set (local.get $a) (local.get $i) (f64.mul (local.get $k) (call $at (local.get $a) (local.get $i))))) (local.set $i (f64.add (local.get $i) (f64.const 1))) br $l end end f64.const 0) " ,(s)
  __String_concat__ s "(func (export \"bump\") (param $p f64) (result f64) (local $i f64) (local $c f64) block $d loop $l (br_if $d (f64.ge (local.get $i) (call $len (local.get $p)))) (local.set $c (call $at (local.get $p) (local.get $i))) (drop (call $set (local.get $c) (f64.const 0) (f64.add (call $at (local.get $c) (f64.const 0)) (f64.const 10)))) (local.set $i (f64.add (local.get $i) (f64.const 1))) br $l end end f64.const 0) " ,(s)
  __String_concat__ s "(func (export \"oob\") (param $a f64) (result f64) (drop (call $set (local.get $a) (f64.const 0) (f64.const 99))) (f64.load (i32.const 1000000))))")

;; ConMa 版：印を出してから、同じことをする
(define conma_sum ,(args)
  log1 "[ConMa]" ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Sjs_array_length a ,(n)
  num "0" ,(zero)
  sum_loop a zero n zero)
(define sum_loop ,(a i n s)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ (,() return s) ,()
  Sjs_array_get a i ,(x)
  __Number_add__ s x ,(s)
  Sjs_inc i ,(i)
  sum_loop a i n s)
(define conma_scale ,(args)
  log1 "[ConMa]" ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  __LList_uncons__ __print_exit_error__ rest ,(k r2)
  Sjs_array_length a ,(n)
  num "0" ,(zero)
  scale_loop a k zero n ,()
  __NULL__ __NULL__)
(define scale_loop ,(a k i n)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ return ,()
  Sjs_array_get a i ,(x)
  __Number_multiply__ k x ,(y)
  Sjs_array_set a i y ,()
  Sjs_inc i ,(i)
  scale_loop a k i n)
(define conma_bump ,(args)
  log1 "[ConMa]" ,()
  __LList_uncons__ __print_exit_error__ args ,(p rest)
  Sjs_array_length p ,(n)
  num "0" ,(zero)
  bump_loop p zero n ,()
  __NULL__ __NULL__)
(define bump_loop ,(p i n)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ return ,()
  Sjs_array_get p i ,(c)
  num "0" ,(zero)
  Sjs_array_get c zero ,(x)
  num "10" ,(ten)
  __Number_add__ x ten ,(y)
  Sjs_array_set c zero y ,()
  Sjs_inc i ,(i)
  bump_loop p i n)
(define conma_oob ,(args)
  log1 "[ConMa]" ,()
  num "0" ,(zero)
  __NULL__ zero)

;; 形が違う引数を確かめる ConMa 版：印を出して "fallback" を返す
(define conma_marker ,(args)
  log1 "[ConMa]" ,()
  __NULL__ "fallback")

(define main ,(argv)
  Sjs_init ,(G)
  wat ,(text)
  Sjs_wasm_module text ,(W)
  Sjs_wasm_fn W "sum" "1" __FALSE__ __FALSE__ conma_sum ,(sum)
  Sjs_wasm_fn W "scale" "1 0" __TRUE__ __TRUE__ conma_scale ,(scale)
  Sjs_wasm_fn W "bump" "2" __TRUE__ __TRUE__ conma_bump ,(bump)
  Sjs_wasm_fn W "oob" "1" __TRUE__ __FALSE__ conma_oob ,(oob)
  Sjs_wasm_fn W "sum" "1" __FALSE__ __FALSE__ conma_marker ,(sumM)
  Sjs_wasm_fn W "bump" "2" __TRUE__ __FALSE__ conma_marker ,(bumpM)
  num "1" ,(n1) num "2" ,(n2) num "3" ,(n3) num "-0" ,(nz) num "0.5" ,(half)
  list3 n1 n2 n3 ,(l123) Sjs_array G l123 ,(a)
  ;; 読む
  __LList_cons__ a __NULL__ ,(args) sum args ,(s) log2 "sum" s ,()
  ;; 書く（値を返さない関数）
  list2 a n2 ,(args) scale args ,(r) log2 "scale" r ,() log2 "after scale" a ,()
  ;; 別名：同じ配列 x を 2 回入れた配列を渡すと、x[0] に 10 を 2 回足す
  list2 n1 nz ,(lx) Sjs_array G lx ,(x)
  list2 n3 n3 ,(ly) Sjs_array G ly ,(y)
  list3 x y x ,(lp) Sjs_array G lp ,(p)
  __LList_cons__ p __NULL__ ,(args) bump args ,(r) log2 "bump" r ,() log2 "after bump" p ,()
  ;; 長い配列（燃料 2^16 では足りず、写し直してやり直す）
  num "100000" ,(big) make_list big __NULL__ ,(lb) Sjs_array G lb ,(b)
  __LList_cons__ b __NULL__ ,(args) sum args ,(s) log2 "sum 100000" s ,()
  ;; メモリの外の trap：書き戻さずに ConMa 版で動く（a は変わらない）
  __LList_cons__ a __NULL__ ,(args) oob args ,(r) log2 "oob" r ,() log2 "after oob" a ,()
  ;; 写さないもの（どれも ConMa 版で動く）：配列の代わりに数、穴のある配列、数でない要素、引数が足りない、
  ;; 数の配列の代わりに配列の配列、配列の配列の代わりに数の配列。wasm 版の VM でも "[ConMa]" が出る
  __LList_cons__ n3 __NULL__ ,(args) sumM args ,(r) log2 "number" r ,()
  Sjs_array G __NULL__ ,(h) num "2" ,(i2) Sjs_array_set h i2 n1 ,() __LList_cons__ h __NULL__ ,(args) sumM args ,(r) log2 "holes" r ,()
  list2 n1 "two" ,(ls) Sjs_array G ls ,(sa) __LList_cons__ sa __NULL__ ,(args) sumM args ,(r) log2 "string" r ,()
  sumM __NULL__ ,(r) log2 "no argument" r ,()
  __LList_cons__ p __NULL__ ,(args) sumM args ,(r) log2 "deeper" r ,()
  __LList_cons__ a __NULL__ ,(args) bumpM args ,(r) log2 "shallower" r ,()
  ;; 数の配列の要素の -0 も、そのまま写して書き戻す
  __LList_cons__ nz __NULL__ ,(lz) Sjs_array G lz ,(z) list2 z half ,(args) scale args ,(r) num "1" ,(one) num "0" ,(zero) Sjs_array_get z zero ,(z0) __Number_is_negative_zero__ z0 ,(isNZ) __if_then_else__ isNZ (,() __NULL__ "-0") (,() __NULL__ "not -0") ,(t) log2 "scaled -0" t ,()
  __nop__)
(define make_list ,(n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __LList_cons__ n acc ,(acc)
  Sjs_dec n ,(m)
  make_list m acc)
