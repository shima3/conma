      __String_equal__ text "false" ,(test__) __if__ test__ (,() return "(i32.const 0)" "B") ,()
      Wx_fail cx) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__ (,() Wx_unary cx e ,(c ty) return c ty) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Wx_binary cx e ,(c ty) return c ty) ,()
