;; 値を使わない式：代入、複合の代入、++、--
(define Wy_effect ,(F e)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  Wx_num "1" ,(one)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wy_effect F inner ,() return) ,()
  Sjs_in_words t "assign update" ,(test__) __unless__ test__ (,() Wy_expr F e ,(b k) return) ,()
  Sjs_get e "target" ,(target)
  __String_equal__ t "assign" ,(isAssign)
  __if_then_else__ isAssign (,() Sjs_get e "value" ,(value) Wy_expr F value) (,() __NULL__ "" zero) ,(vb vk)
  __if_then_else__ isAssign (,() Sjs_get e "op" ,(op) __NULL__ op) (,() __NULL__ "++") ,(op)
  __String_equal__ op "=" ,(plain)
  ;; 複合の代入と ++、-- は数
