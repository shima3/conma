  Cat3 acc c " " ,(acc)
  Wx_typed_args cx rest prest pdepths acc)

;; 引数（どれも数の式）の WAT と数
(define Wx_args ,(cx args acc)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  __is_null__ args ,(test__) __if__ test__ (,() return acc zero) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_t a ,(at)
  __String_equal__ at "spread" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  Wx_num_expr cx a ,(c)
  Cat3 acc c " " ,(acc)
  Wx_args cx rest acc ,(acc n)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(n)
  __NULL__ acc n)

;; Math の関数
(define Wx_math ,(cx name args)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  Wx_length args zero ,(n)
  Wx_num "1" ,(one)
  __Number_subtract__ n one ,(d)
  __Number_is_zero__ d ,(single)
  Sjs_in_words name "floor ceil trunc abs sqrt" ,(test__) __if__ test__
    (,()
      __unless__ single (,() Wx_fail cx) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Cat5 "(f64." name " " ac ")" ,(c)
      return c) ,()
  Sjs_in_words name "round sign" ,(test__) __if__ test__
    (,()
      __unless__ single (,() Wx_fail cx) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Cat5 "(call $__" name " " ac ")" ,(c)
      return c) ,()
  Sjs_in_words name "max min" ,(test__) __if__ test__
    (,()
      __is_null__ args ,(test__) __if__ test__
        (,() __String_equal__ name "max" ,(isMax) __if_then_else__ isMax (,() __NULL__ "(f64.const -inf)") (,() __NULL__ "(f64.const inf)") ,(c) return c) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Wx_fold cx name rest ac ,(c)
      return c) ,()
  Wx_fail cx)

(define Wx_fold ,(cx name args acc)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_num_expr cx a ,(ac)
  Cat5 "(f64." name " " acc " " ,(acc)
  Cat3 acc ac ")" ,(acc)
  Wx_fold cx name rest acc)

;; n 個の "0" を空白で区切ったもの
(define Wx_zeros ,(n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  Wx_num "1" ,(one)
  __Number_subtract__ n one ,(m)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ "0") (,() __String_concat__ acc " 0") ,(acc)
  Wx_zeros m acc)

;; ── モジュール ──

;; 呼ぶ関数が数の関数でなくなった関数を、変わらなくなるまで外す
(define Wx_fixpoint ,(E infos)
  __Ref_new__ __FALSE__ ,(changed)
  Wx_fixpoint_pass E infos changed ,()
  __Ref_get__ changed ,(again)
  __if_then_else__ again (,() Wx_fixpoint E infos) (,() __nop__))

(define Wx_fixpoint_pass ,(E infos changed)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      Sjs_get info "callees" ,(cs)
      Wx_all_ok E cs ,(test__)
      __unless__ test__ (,() __Dict_put__ info "ok" __FALSE__ ,() __Ref_set__ changed __TRUE__) ,()) ,()
  Wx_fixpoint_pass E rest changed)

(define Wx_all_ok ,(E names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "ok" ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Wx_all_ok E rest)

;; (( )) の数の関数の fn に、呼ぶときに確かめる名前（呼ぶ数の関数を、呼ぶものの呼ぶものまでたどった名前）と、
;; そのどれかが Math を使うかを付ける
(define Wx_mark_checks ,(E infos)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      __Dict_new__ ,(seen)
      Sjs_get info "callees" ,(cs)
      Wx_reach E cs seen ,()
      Sjs_get info "math" ,(m0)
      __Ref_new__ m0 ,(mathRef)
      __Dict_keys__ seen ,(keys)
      __Ref_new__ __NULL__ ,(acc)
      Gen_collect acc ,(sink)
      keys sink ,(sk)
      __Ref_get__ acc ,(names)
      Wx_names_text E names "" mathRef ,(text)
      __Ref_get__ mathRef ,(usesMath)
      Sjs_get info "fn" ,(fn)
      __Dict_put__ fn "wasmCheck" text ,()
      __Dict_put__ fn "wasmMath" usesMath) ,()
  Wx_mark_checks E rest)

(define Wx_reach ,(E names seen)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ seen nm (,(k) __NULL__ __FALSE__) ,(was)
  __if__ was (,() Wx_reach E rest seen ,() return) ,()
  __Dict_put__ seen nm __TRUE__ ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "callees" ,(cs)
  Wx_reach E cs seen ,()
  Wx_reach E rest seen)

;; 名前を空白で区切った文字列。どれかが Math を使えば mathRef を真にする
(define Wx_names_text ,(E names acc mathRef)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "math" ,(m)
  __if__ m (,() __Ref_set__ mathRef __TRUE__) ,()
  Cat3 acc nm " " ,(acc)
  Wx_names_text E rest acc mathRef)

;; 数の関数のモジュールの WAT（なければ ""）。数の関数の fn に "wasm" を付ける。配列を使う関数があれば
;; （E の "arrays"）、メモリと配列の補助の関数を入れる
(define Wx_module ,(E infos)
  Wx_funcs infos "" ,(fs)
  __String_equal__ fs "" ,(none)
  __Dict_lookup_or__ E "arrays" (,(k) __NULL__ __FALSE__) ,(arrays)
  __if_then_else__ arrays (,() Wx_array_helpers) (,() __NULL__ "") ,(ah)
  __if_then_else__ none (,() __NULL__ "") (,() Wx_helpers ,(h) Cat5 "(module " ah h fs ")"))

;; 配列の補助の関数（配列の計画の段階 A3）：メモリの語 a が配列の長さ、a + 1 から要素。$__get と $__set は、添字が整数で
;; 0 以上、長さより小さいことを確かめ、違えば trap（ConMa 版で動かす）
(define Wx_array_helpers ,()
  Cat5
    "(memory 1) (func $__len (param $a f64) (result f64) (f64.load (i32.mul (i32.trunc_f64_u (local.get $a)) (i32.const 8)))) "
    "(func $__check (param $a f64) (param $i f64) (result f64) (if (i32.or (f64.ne (local.get $i) (f64.trunc (local.get $i))) (i32.or (f64.lt (local.get $i) (f64.const 0)) (f64.ge (local.get $i) (call $__len (local.get $a))))) (then unreachable)) (f64.mul (f64.add (f64.add (local.get $a) (f64.const 1)) (local.get $i)) (f64.const 8))) "
    "(func $__get (param $a f64) (param $i f64) (result f64) (f64.load (i32.trunc_f64_u (call $__check (local.get $a) (local.get $i))))) "
    "(func $__set (param $a f64) (param $i f64) (param $v f64) (result f64) (f64.store (i32.trunc_f64_u (call $__check (local.get $a) (local.get $i))) (local.get $v)) (f64.const 0)) "
    "")

(define Wx_funcs ,(infos acc)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      Sjs_get info "fn" ,(fn)
      Sjs_get info "name" ,(name)
      __Dict_put__ fn "wasm" name ,()
      Sjs_get info "n" ,(n)
      __Dict_put__ fn "wasmParams" n ,()
      ;; 引数の形（深さ。0 は数、1 は数の配列、…）を空白で区切ったもの。配列の計画の段階 A3 まで、どれも 0
      __Dict_lookup_or__ info "shapes" (,(k) Wx_zeros n "") ,(shapes)
      __Dict_put__ fn "wasmShapes" shapes ,()
      Sjs_get info "void" ,(isVoid)
      __Dict_put__ fn "wasmVoid" isVoid) ,()
  __if_then_else__ ok (,() Sjs_get info "wat" ,(w) __String_concat__ acc w) (,() __NULL__ acc) ,(acc)
  Wx_funcs rest acc)

;; 補助の関数（sjs_rt.se の Sjs_mod、ToUint32、Sjs_round、Math.sign と同じ手順）
(define Wx_helpers ,()
  Cat5
    "(func $__mod (param $a f64) (param $b f64) (result f64) (local $r f64) (if (i32.or (f64.eq (local.get $b) (f64.const 0)) (f64.ne (local.get $b) (local.get $b))) (then (return (f64.const nan)))) (if (f64.eq (local.get $a) (f64.const 0)) (then (return (local.get $a)))) (if (f64.eq (f64.abs (local.get $b)) (f64.const inf)) (then (return (select (local.get $a) (f64.const nan) (f64.eq (f64.sub (local.get $a) (local.get $a)) (f64.const 0)))))) (local.set $r (f64.sub (local.get $a) (f64.mul (local.get $b) (f64.trunc (f64.div (local.get $a) (local.get $b)))))) (if (result f64) (f64.eq (local.get $r) (f64.const 0)) (then (f64.copysign (f64.const 0) (local.get $a))) (else (local.get $r)))) "
    "(func $__u32 (param $x f64) (result f64) (if (f64.ne (f64.sub (local.get $x) (local.get $x)) (f64.const 0)) (then (return (f64.const 0)))) (local.set $x (f64.trunc (local.get $x))) (f64.sub (local.get $x) (f64.mul (f64.const 4294967296) (f64.floor (f64.div (local.get $x) (f64.const 4294967296)))))) "
    "(func $__round (param $x f64) (result f64) (local $r f64) (if (f64.ne (f64.sub (local.get $x) (local.get $x)) (f64.const 0)) (then (return (local.get $x)))) (local.set $r (f64.floor (local.get $x))) (if (f64.ge (f64.sub (local.get $x) (local.get $r)) (f64.const 0.5)) (then (local.set $r (f64.add (local.get $r) (f64.const 1))))) (if (result f64) (f64.eq (local.get $r) (f64.const 0)) (then (f64.copysign (f64.const 0) (local.get $x))) (else (local.get $r)))) "
    "(func $__sign (param $x f64) (result f64) (if (f64.gt (local.get $x) (f64.const 0)) (then (return (f64.const 1)))) (if (f64.lt (local.get $x) (f64.const 0)) (then (return (f64.const -1)))) (local.get $x)) "
    "")
