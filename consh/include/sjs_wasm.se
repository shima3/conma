  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_expr cx inner ,(c ty) return c ty) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Wx_id cx e ,(c ty) return c ty) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
