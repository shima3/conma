  __is_null__ info ,(test__) __if__ test__ (,() Wy_args_any F args ,() return "?" zero) ,()
  Sjs_get info "label" ,(label)
  __String_concat__ label ":" ,(gprefix)
  Sjs_get info "params" ,(params)
  Wy_args_params F args params gprefix ,()
  Sjs_get info "void" ,(isVoid)
  __if__ isVoid (,() return "?" zero) ,()
  __NULL__ "" zero)

(define Wy_args_num ,(F args)
  __Cont_get__ ,(return)
