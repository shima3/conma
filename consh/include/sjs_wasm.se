;; 等式を解く：変数 → 深さの Dict。食い違えば、その等式を作った関数を "conflicts" に入れる
(define Wy_solve ,(E)
  __Dict_lookup_or__ E "eqs" __print_exit_error__ ,(eqsRef)
  __Ref_get__ eqsRef ,(rev)
  Wx_reverse rev __NULL__ ,(eqs)
  __Dict_new__ ,(depths)
  Wy_solve_loop E eqs depths ,()
  __NULL__ depths)

(define Wy_solve_loop ,(E eqs depths)
  __Cont_get__ ,(return)
  __Ref_new__ __FALSE__ ,(changed)
  Wy_propagate E eqs depths changed ,()
  __Ref_get__ changed ,(again)
  __if__ again (,() Wy_solve_loop E eqs depths ,() return) ,()
  ;; 決まらないものが残れば、最初の等式で、右辺を 0 以上で最も浅くして、また広げる
  ;; o.length の o で、深さが決まらないものは 1（ほかの変数との差を保つ）、決まったものは 1 以上か確かめる
  __Dict_lookup_or__ E "atleast" (,(x) __NULL__ __NULL__) ,(atleast)
  Wy_apply_atleast E atleast depths __FALSE__ ,(set)
  __if__ set (,() Wy_solve_loop E eqs depths ,() return) ,()
  Wy_default eqs depths ,(chose)
  __if__ chose (,() Wy_solve_loop E eqs depths) ,())

(define Wy_apply_atleast ,(E list depths set)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return set) ,()
  __LList_uncons__ __print_exit_error__ list ,(item rest)
  __LList_uncons__ __print_exit_error__ item ,(owner i1)
  __LList_uncons__ __print_exit_error__ i1 ,(b i2)
  __LList_uncons__ __print_exit_error__ i2 ,(k i3)
  Wy_known depths b ,(db)
  __is_null__ db ,(unknown)
  Wx_num "1" ,(one)
  __if__ unknown
    (,()
      ;; 深さ(b) + k = 1
      __Number_subtract__ one k ,(v)
      __Number_is_negative__ v ,(neg)
      __if_then_else__ neg (,() Wx_num "0" ,(z) __NULL__ z) (,() __NULL__ v) ,(v)
      __Dict_put__ depths b v ,()
      Wy_apply_atleast E rest depths __TRUE__ ,(r)
      return r) ,()
  __Number_add__ db k ,(d)
  __Number_is_positive__ d ,(ok)
  __unless__ ok (,() Wy_conflict E owner) ,()
  Wy_apply_atleast E rest depths set)

(define Wy_known ,(depths key)
  __Dict_lookup_or__ depths key (,(k) __NULL__ __NULL__))

(define Wy_propagate ,(E eqs depths changed)
  __Cont_get__ ,(return)
  __is_null__ eqs ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ eqs ,(eq rest)
  __LList_uncons__ __print_exit_error__ eq ,(owner e1)
  __LList_uncons__ __print_exit_error__ e1 ,(a e2)
  __LList_uncons__ __print_exit_error__ e2 ,(b e3)
  __LList_uncons__ __print_exit_error__ e3 ,(k e4)
  Wy_known depths a ,(da)
  __String_equal__ b "" ,(constant)
  __if_then_else__ constant (,() Wx_num "0" ,(z) __NULL__ z) (,() Wy_known depths b) ,(db)
  __is_null__ da ,(ua)
  __is_null__ db ,(ub)
  ;; 求める値：a は db + k、b は da - k
  __if__ ua
    (,() __unless__ ub (,() __Number_add__ db k ,(v) Wy_set E owner depths a v changed) ,()) ,()
  __if__ ub
    (,() __unless__ ua (,() __Number_subtract__ da k ,(v) Wy_set E owner depths b v changed) ,()) ,()
  __not__ ua ,(ka)
  __not__ ub ,(kb)
  __and__ ka kb ,(both)
  __if__ both
    (,()
      __Number_add__ db k ,(want)
      __Number_subtract__ da want ,(d)
      __Number_is_zero__ d ,(same)
      __unless__ same (,() Wy_conflict E owner) ,()) ,()
  Wy_propagate E rest depths changed)

(define Wy_set ,(E owner depths key v changed)
  __Number_is_negative__ v ,(test__) __if__ test__ (,() Wy_conflict E owner) ,()
  __Dict_put__ depths key v ,()
  __Ref_set__ changed __TRUE__)

;; 両辺が決まらない最初の等式 a = b + k で、b を max(0, -k) にする。そうしたら真
(define Wy_default ,(eqs depths)
  __Cont_get__ ,(return)
  __is_null__ eqs ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ eqs ,(eq rest)
  __LList_uncons__ __print_exit_error__ eq ,(owner e1)
  __LList_uncons__ __print_exit_error__ e1 ,(a e2)
  __LList_uncons__ __print_exit_error__ e2 ,(b e3)
  __LList_uncons__ __print_exit_error__ e3 ,(k e4)
  __String_equal__ b "" ,(constant)
  __if__ constant (,() Wy_default rest depths ,(r) return r) ,()
  Wy_known depths a ,(da)
  Wy_known depths b ,(db)
  __is_null__ da ,(ua)
  __is_null__ db ,(ub)
  __and__ ua ub ,(both)
  __unless__ both (,() Wy_default rest depths ,(r) return r) ,()
  __Number_is_negative__ k ,(neg)
  Wx_num "0" ,(zero)
  __if_then_else__ neg (,() __Number_subtract__ zero k) (,() __NULL__ zero) ,(v)
  __Dict_put__ depths b v ,()
  __NULL__ __TRUE__)

;; 解いた深さを関数ごとに入れる：info の "pdepths"（引数の名前 → 深さ）と "shapes"（深さを空白で区切ったもの）。
;; 食い違った関数は "conflict"
(define Wy_assign ,(E infos depths)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "label" ,(label)
  __String_concat__ label ":" ,(prefix)
  __Dict_new__ ,(pdepths)
  __Dict_put__ info "pdepths" pdepths ,()
  __Dict_put__ info "ldepths" depths ,()
  __Dict_put__ info "prefix" prefix ,()
  Sjs_get info "params" ,(params)
  Wy_param_depths depths prefix params pdepths "" ,(shapes)
  __Dict_put__ info "shapes" shapes ,()
  __Dict_lookup_or__ E "conflicts" __print_exit_error__ ,(conflicts)
  __Dict_lookup_or__ conflicts label (,(k) __NULL__ __FALSE__) ,(c)
  __Dict_put__ info "conflict" c ,()
  Wy_assign E rest depths)

(define Wy_param_depths ,(depths prefix params pdepths acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(p rest)
  __String_concat__ prefix p ,(key)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ depths key (,(k) __NULL__ zero) ,(d)
  __Dict_put__ pdepths p d ,()
  Wx_str d ,(ds)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ ds) (,() Cat3 acc " " ds) ,(acc)
  Wy_param_depths depths prefix rest pdepths acc)

;; ── 関数ごとの WAT ──

(define Wx_compile_all ,(E infos)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Wx_compile E info ,()
  Wx_compile_all E rest)

;; info の関数の WAT を作り、"wat"、"callees"、"ok" を入れる。数の関数の条件を満たさなければ "ok" は偽
(define Wx_compile ,(E info)
  Wx_func E info ,(ok wat callees)
  __Dict_put__ info "ok" ok ,()
  __Dict_put__ info "wat" wat ,()
  __Dict_put__ info "callees" callees)

(define Wx_func ,(E info)
  __Cont_get__ ,(fail)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fail" fail ,()
  __Dict_put__ cx "info" info ,()
  ;; 配列の深さが食い違った関数（Wy_assign）は、数の関数にしない
  __Dict_lookup_or__ info "conflict" (,(k) __NULL__ __FALSE__) ,(conflict)
  __if__ conflict (,() Wx_fail cx) ,()
  __Dict_put__ cx "E" E ,()
  __Dict_new__ ,(locals)
  __Dict_put__ cx "locals" locals ,()
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(nloc)
  __Dict_put__ cx "nloc" nloc ,()
  __Ref_new__ zero ,(nlab)
  __Dict_put__ cx "nlab" nlab ,()
  __Ref_new__ "" ,(decls)
  __Dict_put__ cx "decls" decls ,()
  __Ref_new__ __NULL__ ,(loop)
  __Dict_put__ cx "loop" loop ,()
  __Ref_new__ __NULL__ ,(callees)
  __Dict_put__ cx "callees" callees ,()
  __Ref_new__ __FALSE__ ,(usesMath)
  __Dict_put__ cx "usesMath" usesMath ,()
  Sjs_get info "void" ,(isVoid)
  __Dict_put__ cx "void" isVoid ,()
  Sjs_get info "params" ,(params)
  Wx_bind_params cx params "" ,(head)
  Sjs_get info "fn" ,(fn)
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body)
  __is_null__ body ,(concise)
  ;; アロー関数の本体が式なら、それを返す
  __if_then_else__ concise
    (,()
      __Dict_lookup_or__ fn "expr" (,(k) __NULL__ __NULL__) ,(expr)
      __is_null__ expr ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      Wx_num_expr cx expr ,(c)
      Cat3 "(return " c ") ")
    (,()
      Sjs_get body "body" ,(stmts)
      ;; 値を返す関数は、最後の文で必ず return する。値を返さない関数は、最後まで来てもよい
      Wx_ends_list stmts ,(ends)
      __or__ ends isVoid ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      Wx_stmts cx stmts "") ,(code)
  __Ref_get__ usesMath ,(um)
  __Dict_put__ info "math" um ,()
  Sjs_get info "label" ,(label)
  Sjs_get info "name" ,(name)
  Gen_quote name ,(qn)
  __Ref_get__ decls ,(ld)
  Cat5 "(func " label " (export " qn ") " ,(s)
  Cat5 s head "(result f64) (local $tmp f64) " ld code ,(s)
  ;; 値を返さない関数は、最後まで来たら 0 を返す（Sjs_wasm_fn が undefined にする）
  __if_then_else__ isVoid (,() __NULL__ "(f64.const 0)) ") (,() __NULL__ "(unreachable)) ") ,(tail)
  __String_concat__ s tail ,(wat)
  __Ref_get__ callees ,(cs)
  __NULL__ __TRUE__ wat cs)

(define Wx_fail ,(cx)
  __Dict_lookup_or__ cx "fail" __print_exit_error__ ,(fail)
  fail __FALSE__ "" __NULL__)

;; 引数を $l0 から順に局所の変数にする。(param $l0 f64) ... を返す
(define Wx_bind_params ,(cx params acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(nm rest)
  Wx_new_local cx nm __FALSE__ ,(l)
  ;; 引数の型：Wy_assign が決めた深さ
  __Dict_lookup_or__ cx "info" __print_exit_error__ ,(info)
  __Dict_lookup_or__ info "pdepths" __print_exit_error__ ,(pdepths)
  __Dict_lookup_or__ pdepths nm __print_exit_error__ ,(d)
  Wx_atype d ,(ty)
  Wx_set_type cx nm ty ,()
  Cat3 acc "(param " l ,(acc)
  __String_concat__ acc " f64) " ,(acc)
  Wx_bind_params cx rest acc)

;; 名前 nm の新しい局所の変数（$l番号）。名前が局所の変数、一番外の数の定数、数の関数の候補と重なれば、数の関数にしない
(define Wx_new_local ,(cx nm isConst)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __NULL__) ,(old)
  __is_null__ old ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ E "consts" __print_exit_error__ ,(consts)
  __Dict_lookup_or__ consts nm (,(k) __NULL__ __NULL__) ,(c)
  __is_null__ c ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm (,(k) __NULL__ __NULL__) ,(f)
  __is_null__ f ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  Sjs_in_words nm "Math NaN Infinity undefined" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ cx "nloc" __print_exit_error__ ,(nloc)
  __Ref_get__ nloc ,(k)
  Wx_inc nloc ,()
  Wx_str k ,(ks)
  __String_concat__ "$l" ks ,(l)
  __Dict_put__ locals nm l ,()
  __String_concat__ "const:" nm ,(ck)
  __Dict_put__ locals ck isConst ,()
  __NULL__ l)

;; 深さ d の型（0 なら "N"、ほかは "A" と深さ）
(define Wx_atype ,(d)
  __Cont_get__ ,(return)
  __Number_is_zero__ d ,(test__) __if__ test__ (,() return "N") ,()
  Wx_str d ,(ds)
  __String_concat__ "A" ds)

;; 型の深さ（"N" は 0、"A" と深さはその深さ、ほかは -1）
(define Wx_tdepth ,(ty)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  __String_equal__ ty "N" ,(test__) __if__ test__ (,() return zero) ,()
  __String_length__ ty ,(len)
  Wx_num "1" ,(one)
  __Number_subtract__ len one ,(rest)
  __Number_is_positive__ rest ,(long)
  __unless__ long (,() __Number_subtract__ zero one ,(m) return m) ,()
  __String_substring__ __print_exit_error__ ty zero one ,(head)
  __String_equal__ head "A" ,(test__) __unless__ test__ (,() __Number_subtract__ zero one ,(m) return m) ,()
  __String_substring__ __print_exit_error__ ty one len ,(ds)
  __Number_fromString__ __print_exit_error__ ds)

(define Wx_is_array ,(ty)
  Wx_tdepth ty ,(d)
  __Number_is_positive__ d)

(define Wx_set_type ,(cx nm ty)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __String_concat__ "type:" nm ,(tk)
  __Dict_put__ locals tk ty ,()
  ;; 配列を使う関数があれば、モジュールにメモリと配列の補助の関数を入れる
  Wx_is_array ty ,(isArray)
  __if__ isArray (,() Wx_uses_arrays cx) ,())

(define Wx_uses_arrays ,(cx)
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  __Dict_put__ E "arrays" __TRUE__)

;; 局所の変数を宣言する（引数でない局所の変数）
(define Wx_declare ,(cx nm isConst)
  Wx_new_local cx nm isConst ,(l)
  __Dict_lookup_or__ cx "decls" __print_exit_error__ ,(decls)
  __Ref_get__ decls ,(d)
  Cat4 d "(local " l " f64) " ,(d)
  __Ref_set__ decls d ,()
  __NULL__ l)

(define Wx_label ,(cx prefix)
  __Dict_lookup_or__ cx "nlab" __print_exit_error__ ,(nlab)
  __Ref_get__ nlab ,(k)
  Wx_inc nlab ,()
  Wx_str k ,(ks)
  __String_concat__ prefix ks)

;; 最後の文で必ず return するか
(define Wx_ends_list ,(stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  __is_null__ rest ,(test__) __if__ test__ (,() Wx_ends s ,(e) return e) ,()
  Wx_ends_list rest)

(define Wx_ends ,(s)
  __Cont_get__ ,(return)
  __is_null__ s ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Wx_t s ,(t)
  __String_equal__ t "return" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ t "block" ,(test__) __if__ test__ (,() Sjs_get s "body" ,(b) Wx_ends_list b ,(e) return e) ,()
  __String_equal__ t "if" ,(test__) __if__ test__
    (,()
      Sjs_get s "yes" ,(yes)
      __Dict_lookup_or__ s "no" (,(k) __NULL__ __NULL__) ,(no)
      Wx_ends yes ,(a)
      Wx_ends no ,(b)
      __and__ a b ,(e)
      return e) ,()
  __NULL__ __FALSE__)

;; ── 文 ──

(define Wx_stmts ,(cx stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_stmt cx s ,(c)
  __String_concat__ acc c ,(acc)
  Wx_stmts cx rest acc)

(define Wx_stmt ,(cx s)
  __Cont_get__ ,(return)
  __is_null__ s ,(test__) __if__ test__ (,() return "") ,()
  Wx_t s ,(t)
  __String_equal__ t "empty" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "block" ,(test__) __if__ test__ (,() Sjs_get s "body" ,(b) Wx_stmts cx b "" ,(c) return c) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__ (,() Wx_decl cx s ,(c) return c) ,()
  __String_equal__ t "expr" ,(test__) __if__ test__ (,() Sjs_get s "expr" ,(e) Wx_effect cx e ,(c) return c) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ s "value" (,(k) __NULL__ __NULL__) ,(v)
      __Dict_lookup_or__ cx "void" __print_exit_error__ ,(isVoid)
      __is_null__ v ,(none)
      __and__ none isVoid ,(test__) __if__ test__ (,() return "(return (f64.const 0)) ") ,()
      __if__ none (,() Wx_fail cx) ,()
      Wx_num_expr cx v ,(c)
      Cat3 "(return " c ") " ,(c)
      return c) ,()
  __String_equal__ t "if" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Wx_cond cx test ,(tc)
      Sjs_get s "yes" ,(yes)
      __Dict_lookup_or__ s "no" (,(k) __NULL__ __NULL__) ,(no)
      Wx_stmt cx yes ,(yc)
      Wx_stmt cx no ,(nc)
      Cat5 "(if " tc " (then " yc ") (else " ,(c)
      Cat3 c nc ")) " ,(c)
      return c) ,()
  __String_equal__ t "while" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Sjs_get s "body" ,(body)
      Wx_loop cx "" test body __NULL__ ,(c)
      return c) ,()
  __String_equal__ t "for" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ s "init" (,(k) __NULL__ __NULL__) ,(init)
      Wx_stmt cx init ,(ic)
      __Dict_lookup_or__ s "test" (,(k) __NULL__ __NULL__) ,(test)
      __Dict_lookup_or__ s "update" (,(k) __NULL__ __NULL__) ,(update)
      Sjs_get s "body" ,(body)
      Wx_loop cx ic test body update ,(c)
      return c) ,()
  __String_equal__ t "dowhile" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Sjs_get s "body" ,(body)
      Wx_dowhile cx test body ,(c)
      return c) ,()
  __String_equal__ t "forof" ,(test__) __if__ test__ (,() Wx_forof cx s ,(c) return c) ,()
  Sjs_in_words t "break continue" ,(test__) __if__ test__
    (,()
      Sjs_get s "label" ,(lab)
      __String_equal__ lab "" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      __Dict_lookup_or__ cx "loop" __print_exit_error__ ,(loopRef)
      __Ref_get__ loopRef ,(lp)
      __is_null__ lp ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      __String_equal__ t "break" ,(isBreak)
      __if_then_else__ isBreak (,() Sjs_get lp "brk") (,() Sjs_get lp "cnt") ,(target)
      Cat3 "(br " target ") " ,(c)
      return c) ,()
  Wx_fail cx)

;; let と const の宣言：名前と初期値（数）
(define Wx_decl ,(cx s)
  Sjs_get s "kind" ,(kind)
  Sjs_in_words kind "let const" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "decls" ,(ds)
  Wx_declarators cx ds isConst "")

(define Wx_declarators ,(cx ds isConst acc)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  __is_null__ init ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  ;; 局所の変数の型は初期値の型（数か配列）
  Wx_value_expr cx init ,(ic ty)
  Sjs_get target "name" ,(nm)
  Wx_declare cx nm isConst ,(l)
  Wx_set_type cx nm ty ,()
  Cat5 acc "(local.set " l " " ic ,(acc)
  __String_concat__ acc ") " ,(acc)
  Wx_declarators cx rest isConst acc)

;; while と for（ic は初期化の WAT、update は更新の式か null）：
;; (block $b (loop $k (br_if $b (i32.eqz test)) (block $c body) update (br $k)))
(define Wx_loop ,(cx ic test body update)
  Wx_label cx "$b" ,(b)
  Wx_label cx "$k" ,(k)
  Wx_label cx "$c" ,(c)
  __is_null__ test ,(noTest)
  __if_then_else__ noTest (,() __NULL__ "")
    (,() Wx_cond cx test ,(tc) Cat5 "(br_if " b " (i32.eqz " tc ")) ") ,(testCode)
  Wx_in_loop cx b c body ,(bc)
  __is_null__ update ,(noUpdate)
  __if_then_else__ noUpdate (,() __NULL__ "") (,() Wx_effect cx update) ,(uc)
  Cat5 ic "(block " b " (loop " k ,(s)
  Cat5 s " " testCode "(block " c ,(s)
  Cat5 s " " bc ") " uc ,(s)
  Cat3 s "(br " k ,(s)
  __String_concat__ s "))) ")

;; do...while：(block $b (loop $k (block $c body) (br_if $k test)))
(define Wx_dowhile ,(cx test body)
  Wx_label cx "$b" ,(b)
  Wx_label cx "$k" ,(k)
  Wx_label cx "$c" ,(c)
  Wx_in_loop cx b c body ,(bc)
  Wx_cond cx test ,(tc)
  Cat4 "(block " b " (loop " k ,(s)
  Cat5 s " (block " c " " bc ,(s)
  Cat5 s ") (br_if " k " " tc ,(s)
  __String_concat__ s "))) ")

;; for (const x of a) と for (const [x, y] of a)（配列の計画の段階 A3）：添字のループにする。
;; (local.set $arr a) (local.set $idx 0) (block $b (loop $k (br_if $b (i32.eqz (f64.lt idx (call $__len arr))))
;;   名前に (call $__get arr idx) を入れる (block $c 本体) (local.set $idx (f64.add idx 1)) (br $k)))
;; 分ける要素が足りなければ、$__get が trap にする（ConMa 版で動かす）
(define Wx_forof ,(cx s)
  __Cont_get__ ,(return)
  Sjs_get s "of" ,(word)
  __type_name__ word ,(wt)
  __String_equal__ wt "String" ,(isWord)
  __if_then_else__ isWord (,() __String_equal__ word "of") (,() __NULL__ word) ,(isOf)
  __unless__ isOf (,() Wx_fail cx) ,()
  __Dict_lookup_or__ s "kind" (,(k) __NULL__ __NULL__) ,(kind)
  __is_null__ kind ,(noKind)
  __if__ noKind (,() Wx_fail cx) ,()
  Sjs_in_words kind "let const" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "right" ,(right)
  Wx_expr cx right ,(rc rty)
  Wx_tdepth rty ,(d)
  __Number_is_positive__ d ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  ;; 配列と添字の一時の変数（名前は SJS の名前にならない）
  Wx_label cx "%arr" ,(arrName)
  Wx_label cx "%idx" ,(idxName)
  Wx_declare cx arrName __FALSE__ ,(arr)
  Wx_declare cx idxName __FALSE__ ,(idx)
  Cat3 "(call $__get (local.get " arr ")" ,(g)
  Cat5 g " (local.get " idx ")) " "" ,(elem)
  Sjs_dec d ,(ed)
  Wx_atype ed ,(ety)
  Sjs_get s "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(isId)
  __String_equal__ tt "arrayPattern" ,(isPattern)
  __if_then_else__ isId
    (,()
      Sjs_get target "name" ,(nm)
      Wx_declare cx nm isConst ,(l)
      Wx_set_type cx nm ety ,()
      Cat5 "(local.set " l " " elem ") " ,(c)
      __NULL__ c)
    (,()
      __unless__ isPattern (,() Wx_fail cx) ,()
      ;; 要素も配列で、その要素を名前に入れる
      Wx_tdepth ety ,(ed2)
      __Number_is_positive__ ed2 ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      Sjs_dec ed2 ,(eed)
      Wx_atype eed ,(eety)
      Wx_label cx "%elem" ,(elemName)
      Wx_declare cx elemName __FALSE__ ,(el)
      Cat5 "(local.set " el " " elem ") " ,(c0)
      Sjs_get target "items" ,(items)
      Wx_num "0" ,(zero)
      Wx_pattern_bind cx items el eety isConst zero c0) ,(bind)
