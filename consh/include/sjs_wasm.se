      Cat5 "(call $__get " oc " " kc ")" ,(cur)
      Wx_arith cx bop cur vc) ,(nv)
  Cat5 "(drop (call $__set " oc " " kc " " ,(c)
  Cat3 c nv ")) ")

;; 代入できる名前（const でない局所の変数か引数）の WAT の名前と型
(define Wx_target ,(cx target)
