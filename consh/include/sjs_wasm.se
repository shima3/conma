      Sjs_get e "yes" ,(yes)
      Sjs_get e "no" ,(no)
      Wx_expr cx yes ,(yc yt)
      Wx_expr cx no ,(nc nt)
      __String_equal__ yt nt ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      __String_equal__ yt "V" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      __String_equal__ yt "B" ,(isBool)
      __if_then_else__ isBool (,() __NULL__ "i32") (,() __NULL__ "f64") ,(rt)
      Cat5 "(if (result " rt ") " tc " (then " ,(c)
      Cat5 c yc ") (else " nc ")) " ,(c)
      return c yt) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Wx_call cx e ,(c ty) return c ty) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      ;; 配列：o[i] と o.length（$__get が範囲と整数を確かめる）
      Wx_is_math_member e ,(isMath0)
