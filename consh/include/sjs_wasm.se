      __Dict_lookup_or__ s "no" (,(k2) __NULL__ __NULL__) ,(no) Wy_stmt F no ,()
      return) ,()
  Sjs_in_words t "while dowhile" ,(test__) __if__ test__
    (,() Sjs_get s "test" ,(test) Wy_expr F test ,(b k) Sjs_get s "body" ,(body) Wy_stmt F body ,() return) ,()
  __String_equal__ t "for" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ s "init" (,(k2) __NULL__ __NULL__) ,(init) Wy_stmt F init ,()
      __Dict_lookup_or__ s "test" (,(k2) __NULL__ __NULL__) ,(test) Wy_expr F test ,(b k)
