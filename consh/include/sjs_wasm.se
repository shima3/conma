      Sjs_get s "target" ,(target)
      Wx_t target ,(tt)
      __Number_subtract__ rk one ,(ek)
      __Number_subtract__ rk two ,(eek)
      __String_equal__ tt "id" ,(isId)
      __if__ isId (,() Sjs_get target "name" ,(nm) Wy_var F nm ,(v) Wy_unify F v zero rb ek) ,()
      __String_equal__ tt "arrayPattern" ,(isPattern)
