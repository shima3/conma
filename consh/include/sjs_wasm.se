;; SJS の数の関数を WebAssembly のテキスト（WAT）にする（consh/SJS-WASM-PLAN-ja.md の段階 2）。
;; Wasm_prepare が、プログラムの一番外の function 宣言のうち、数だけを扱うもの（数の関数）を見つけて、
;; その fn の節に "wasm"（export の名前）を付け、それらをまとめた 1 つのモジュールの WAT を返す（なければ ""）。
;; 変換器（sjs_gen.se）は、印の付いた関数を Sjs_wasm_fn で包み、呼ばれたとき、実行時の支え（sjs_rt.se）が、引数が
;; 数なら wasm 版を、そうでなければ ConMa 版を動かす。2 つの版の結果は同じになる（f64 の演算は IEEE 754 のとおり）。
;;
;; 数の関数の条件（計画の 3。段階 2 は単独の SJS のファイルだけ）：
;; * 一番外の function 宣言で、ジェネレータでも async でもなく、引数は名前だけ（重ならない）。その名前は、一番外で
;;   1 回だけ宣言され、プログラムのどこでも代入されない。
;; * 本体は、let と const（名前だけで初期値のあるもの。名前は関数の中で重ならず、引数、一番外の数の定数、数の関数の
;;   名前とも違う）、式の文（局所の変数への代入、複合の代入、++、--、呼び出し）、if、while、do...while、for、ラベルの
;;   ない break と continue、値のある return、ブロック、空の文だけで、最後の文で必ず return する。
;; * 式は数（f64）か真偽値（i32）で、数のリテラル、引数と局所の変数、一番外の数の定数（数のリテラルの const で、
;;   一番外の最初の呼び出しより前に宣言したもの）、NaN、Infinity、算術（** を除く）、比較、ビット演算、単項の - + ~ !、
;;   条件演算子、真偽値どうしの && と ||、ほかの数の関数の呼び出し（引数の数が同じ）、Math.floor、ceil、trunc、
;;   abs、sqrt、round、sign、max、min、Math.PI（Math がプログラムで Math.名前 の形でしか使われず、書き換えられないとき）。
;;   算術と代入と戻り値は数だけ（真偽値を数として使うと、SJS では TypeError なので、数の関数にしない）。条件は、
;;   数なら JavaScript と同じ真偽（0、-0、NaN が偽）。
;; ConSh の (( )) と $(( ))（段階 4。Wasm_prepare_expr）：式の中の「名前 = 関数式（function かアロー関数）」を候補にする。
;; 名前は SJS変数で、後の (( )) で書き換えられ、Math のメンバーも書き換えられるので、呼ぶとき、呼ぶ数の関数の名前が作った
;; ときと同じ関数を指し、Math を使うなら Math のメンバーが元のままかを確かめる（sjs_rt.se の Sjs_wasm_fn_checked）。
;; 外の名前で読めるのは、NaN と Infinity だけ（組み込みは書き換えられない）。アロー関数の本体が式なら、それを返す。
;; WAT の関数は $f番号、局所の変数は $l番号（引数が先）、ラベルは $b番号（break）、$c番号（continue）、$k番号（ループ）。
;; % は $__mod、ToUint32 は $__u32、Math.round は $__round、Math.sign は $__sign（sjs_rt.se の Sjs_mod などと同じ手順）

;; ConSh の (( )) の式 e の WAT（数の関数がなければ ""）。数の関数の fn の節に "wasm"、"wasmCheck"（呼ぶときに確かめる
;; 名前を空白で区切ったもの）、"wasmMath"（Math を使うか）を付ける
(define Wasm_prepare_expr ,(e)
  Wx_env_module e ,(E)
  Wx_candidates_expr E e ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(infos)
  Wy_infer_all E infos ,()
  Wx_compile_all E infos ,()
  Wx_fixpoint E infos ,()
  Wx_mark_checks E infos ,()
  Wx_module E infos)

;; プログラムの WAT（数の関数がなければ ""）。数の関数の fn の節に "wasm" を付ける
(define Wasm_prepare ,(program)
  Sjs_get program "body" ,(stmts)
  Wx_env stmts ,(E)
  Wx_candidates E stmts ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(infos)
  Wy_infer_all E infos ,()
  Wx_compile_all E infos ,()
  Wx_fixpoint E infos ,()
  Wx_module E infos)

(define Wx_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

(define Wx_str ,(n)
  __Number_toString__ n)

;; ── 構文木をなめる ──

;; node（Dict の節か、その LList）の中のすべての節に f を適用する（f は値を返さない）
(define Wx_walk ,(node f)
  __Cont_get__ ,(return)
  __type_name__ node ,(type)
  __String_equal__ type "LList" ,(test__) __if__ test__ (,() Wx_walk_list node f ,() return) ,()
  __String_equal__ type "Dict" ,(test__) __unless__ test__ return ,()
  f node ,()
  __Dict_keys__ node ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  Gen_collect acc ,(sink)
  keys sink ,(s)
  __Ref_get__ acc ,(ks)
  Wx_walk_fields node ks f)

(define Wx_walk_list ,(list f)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Wx_walk x f ,()
  Wx_walk_list rest f)

(define Wx_walk_fields ,(node keys f)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  __Dict_lookup_or__ node k __print_exit_error__ ,(v)
  Wx_walk v f ,()
  Wx_walk_fields node rest f)

(define Wx_t ,(n)
  __Dict_lookup_or__ n "t" (,(k) __NULL__ ""))

;; n が名前 name の id の節か
(define Wx_is_id ,(n name)
  __Cont_get__ ,(return)
  __type_name__ n ,(type)
  __String_equal__ type "Dict" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Wx_t n ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Sjs_get n "name" ,(nm)
  __String_equal__ nm name)

;; n が Math.名前（計算したキーでも ?. でもない）か
(define Wx_is_math_member ,(n)
  __Cont_get__ ,(return)
  Wx_t n ,(t)
  __String_equal__ t "member" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ n "name" (,(k) __NULL__ __NULL__) ,(name)
  __is_null__ name ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ n "optional" (,(k) __NULL__ __FALSE__) ,(opt)
  __if__ opt (,() return __FALSE__) ,()
  Sjs_get n "object" ,(o)
  Wx_is_id o "Math")

(define Wx_inc ,(ref)
  __Ref_get__ ref ,(n)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(m)
  __Ref_set__ ref m)

;; ── プログラム全体の情報 E ──
;; "assigned"：代入される名前、"math"：Math を Math.名前 の形でしか使わず、書き換えないか、"consts"：一番外の数の定数
;; （名前 → WAT の数）、"declared"：一番外で宣言した名前 → 回数、"funcs"：数の関数の候補（名前 → 情報）、"list"：候補の LList

(define Wx_env ,(stmts)
  __Dict_new__ ,(E)
  __Dict_new__ ,(assigned)
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(mathIds)
  __Ref_new__ zero ,(mathMembers)
  __Ref_new__ __FALSE__ ,(mathWritten)
  Wx_walk stmts (,(n) Wx_env_node n assigned mathIds mathMembers mathWritten) ,()
  __Dict_put__ E "assigned" assigned ,()
  __Ref_get__ mathIds ,(ids)
  __Ref_get__ mathMembers ,(members)
  __Ref_get__ mathWritten ,(written)
  __Number_subtract__ ids members ,(d)
  __Number_is_zero__ d ,(onlyMembers)
  __not__ written ,(unwritten)
  __and__ onlyMembers unwritten ,(mathOk)
  __Dict_put__ E "math" mathOk ,()
  __Dict_new__ ,(consts)
  __Dict_put__ E "consts" consts ,()
  __Dict_new__ ,(declared)
  __Dict_put__ E "declared" declared ,()
  Wx_declared stmts declared ,()
  Wx_consts stmts consts declared ,()
  __Dict_new__ ,(funcs)
  __Dict_put__ E "funcs" funcs ,()
  __Ref_new__ __NULL__ ,(list)
  __Dict_put__ E "list" list ,()
  __NULL__ E)

(define Wx_env_node ,(n assigned mathIds mathMembers mathWritten)
  __Cont_get__ ,(return)
  Wx_t n ,(t)
  __String_equal__ t "id" ,(test__) __if__ test__
    (,() Wx_is_id n "Math" ,(m) __if__ m (,() Wx_inc mathIds) ,() return) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,() Wx_is_math_member n ,(m) __if__ m (,() Wx_inc mathMembers) ,() return) ,()
  Sjs_in_words t "assign update forof forin" ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ n "target" (,(k) __NULL__ __NULL__) ,(target)
  __is_null__ target ,(test__) __if__ test__ return ,()
  Wx_t target ,(tt)
  __String_equal__ tt "member" ,(test__) __if__ test__
    (,() Sjs_get target "object" ,(o) Wx_is_id o "Math" ,(m) __if__ m (,() __Ref_set__ mathWritten __TRUE__) ,() return) ,()
  ;; 代入の先の形（名前、分割代入、for の宣言）のすべての名前
  Wx_walk target (,(x) Wx_t x ,(xt) __String_equal__ xt "id" ,(isId) __if__ isId (,() Sjs_get x "name" ,(nm) __Dict_put__ assigned nm __TRUE__) ,()))

;; (( )) の式の E：Math は呼ぶときに確かめるので使ってよく、一番外の宣言と数の定数はない。"counts" は代入の回数
(define Wx_env_module ,(e)
  __Dict_new__ ,(E)
  __Dict_new__ ,(assigned)
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(r1)
  __Ref_new__ zero ,(r2)
  __Ref_new__ __FALSE__ ,(r3)
  Wx_walk e (,(n) Wx_env_node n assigned r1 r2 r3) ,()
  __Dict_put__ E "assigned" assigned ,()
  __Dict_put__ E "math" __TRUE__ ,()
  __Dict_put__ E "module" __TRUE__ ,()
  __Dict_new__ ,(consts)
  __Dict_put__ E "consts" consts ,()
  __Dict_new__ ,(declared)
  __Dict_put__ E "declared" declared ,()
  __Dict_new__ ,(counts)
  Wx_walk e (,(n) Wx_t n ,(t) __String_equal__ t "assign" ,(isAssign) __if__ isAssign (,() Sjs_get n "target" ,(target) Wx_t target ,(tt) __String_equal__ tt "id" ,(isId) __if__ isId (,() Sjs_get target "name" ,(nm) Wx_count counts nm) ,()) ,()) ,()
  __Dict_put__ E "counts" counts ,()
  __Dict_new__ ,(funcs)
  __Dict_put__ E "funcs" funcs ,()
  __Ref_new__ __NULL__ ,(list)
  __Dict_put__ E "list" list ,()
  __NULL__ E)

;; (( )) の式の候補：一番外の（コンマ演算子で並べたものも）「名前 = 関数式」で、名前はこの式で 1 回だけ代入される
(define Wx_candidates_expr ,(E e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_candidates_expr E inner ,() return) ,()
  __String_equal__ t "seq" ,(test__) __if__ test__ (,() Sjs_get e "exprs" ,(es) Wx_candidates_list E es ,() return) ,()
  __String_equal__ t "assign" ,(test__) __unless__ test__ return ,()
  Sjs_get e "op" ,(op)
  __String_equal__ op "=" ,(test__) __unless__ test__ return ,()
  Sjs_get e "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ return ,()
  Sjs_get target "name" ,(name)
  Sjs_get e "value" ,(value)
  Wx_unparen value ,(fn)
  Wx_t fn ,(ft)
  Sjs_in_words ft "function arrow" ,(test__) __unless__ test__ return ,()
  ;; 名前の付いた function 式は、その名前が代入する名前と同じときだけ
  __Dict_lookup_or__ fn "name" (,(k) __NULL__ "") ,(own)
  __is_null__ own ,(noOwn)
  __if_then_else__ noOwn (,() __NULL__ "") (,() __NULL__ own) ,(own)
  __String_equal__ own "" ,(anonymous)
  __String_equal__ own name ,(same)
  __or__ anonymous same ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ E "counts" __print_exit_error__ ,(counts)
  Wx_once_in counts name ,(test__) __unless__ test__ return ,()
  Wx_candidate_fn E name fn)

(define Wx_candidates_list ,(E es)
  __Cont_get__ ,(return)
  __is_null__ es ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ es ,(e rest)
  Wx_candidates_expr E e ,()
  Wx_candidates_list E rest)

(define Wx_unparen ,(e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_unparen inner ,(r) return r) ,()
  __NULL__ e)

(define Wx_once_in ,(dict name)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ dict name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_subtract__ c one ,(d)
  __Number_is_zero__ d)

;; 一番外で宣言した名前の回数
(define Wx_declared ,(stmts declared)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Sjs_get s "name" ,(nm) Wx_count declared nm) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,() Sjs_get s "decls" ,(ds) Wx_decl_names ds __NULL__ ,(names) Wx_count_all declared names) ,()
  Wx_declared rest declared)

(define Wx_decl_names ,(ds acc)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  Gen_pattern_names target acc ,(acc)
  Wx_decl_names rest acc)

(define Wx_count ,(dict name)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ dict name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_add__ c one ,(c)
  __Dict_put__ dict name c)

(define Wx_count_all ,(dict names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  Wx_count dict nm ,()
  Wx_count_all dict rest)

(define Wx_once ,(E name)
  __Dict_lookup_or__ E "declared" __print_exit_error__ ,(declared)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ declared name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_subtract__ c one ,(d)
  __Number_is_zero__ d)

;; node の中に呼び出し（タグ付きテンプレートも）があるか
(define Wx_has_call ,(node)
  __Ref_new__ __FALSE__ ,(found)
  Wx_walk node (,(x) Wx_t x ,(t) Sjs_in_words t "call tagged" ,(c) __if__ c (,() __Ref_set__ found __TRUE__) ,()) ,()
  __Ref_get__ found)

;; 一番外の数の定数：最初の呼び出しのある文より前の const で、名前と、数の定数の式（Wx_const_expr。配列の計画の段階 A0）
(define Wx_consts ,(stmts consts declared)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_has_call s ,(test__) __if__ test__ return ,()
  Wx_t s ,(t)
  __String_equal__ t "decl" ,(isDecl)
  __if__ isDecl
    (,()
      Sjs_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      __if__ isConst (,() Sjs_get s "decls" ,(ds) Wx_const_decls ds consts) ,()) ,()
  Wx_consts rest consts declared)

(define Wx_const_decls ,(ds consts)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(isId)
  __is_null__ init ,(none)
  __not__ none ,(hasInit)
  __and__ isId hasInit ,(test__) __if__ test__
    (,()
      Sjs_get target "name" ,(nm)
      Wx_const_expr consts init ,(ok c)
      __if__ ok (,() __Dict_put__ consts nm c) ,()) ,()
  Wx_const_decls rest consts)

;; 数の定数の式 e の WAT：数のリテラル、それまでの一番外の数の定数、括弧、単項の - と +、+ - * / %（配列の計画の段階 A0）。
;; WAT では、使う所に同じ順の算術を書くので、ConMa 版（実行のときに求める）と同じ丸めになる。式でなければ偽
(define Wx_const_expr ,(consts e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __Number_fromString__ (,(msg) return __FALSE__ "") text ,(v)
      Wx_f64 v ,(c)
      return __TRUE__ c) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_const_expr consts inner ,(ok c) return ok c) ,()
  __String_equal__ t "id" ,(test__) __if__ test__
    (,()
      Sjs_get e "name" ,(nm)
      __Dict_lookup_or__ consts nm (,(k) return __FALSE__ "") ,(c)
      return __TRUE__ c) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__
    (,()
      Sjs_get e "op" ,(op)
      Sjs_get e "arg" ,(arg)
      Wx_const_expr consts arg ,(ok c)
      __unless__ ok (,() return __FALSE__ "") ,()
      __String_equal__ op "+" ,(test__) __if__ test__ (,() return __TRUE__ c) ,()
      __String_equal__ op "-" ,(test__) __if__ test__ (,() Cat3 "(f64.neg " c ")" ,(n) return __TRUE__ n) ,()
      return __FALSE__ "") ,()
  __String_equal__ t "binary" ,(test__) __unless__ test__ (,() return __FALSE__ "") ,()
  Sjs_get e "op" ,(op)
  Sjs_get e "left" ,(left)
  Sjs_get e "right" ,(right)
  Wx_const_expr consts left ,(lok lc)
  Wx_const_expr consts right ,(rok rc)
  __and__ lok rok ,(test__) __unless__ test__ (,() return __FALSE__ "") ,()
  __String_equal__ op "%" ,(test__) __if__ test__ (,() Cat5 "(call $__mod " lc " " rc ")" ,(c) return __TRUE__ c) ,()
  Wx_f64_op op ,(ins)
  __String_equal__ ins "" ,(test__) __if__ test__ (,() return __FALSE__ "") ,()
  Cat5 "(" ins " " lc " " ,(c)
  Cat3 c rc ")" ,(c)
  __NULL__ __TRUE__ c)

;; 数 v の WAT の定数
(define Wx_f64 ,(v)
  Wx_str v ,(s)
  Cat3 "(f64.const " s ")")

;; ── 候補 ──

(define Wx_candidates ,(E stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Wx_candidate E s) ,()
  Wx_candidates E rest)

(define Wx_candidate ,(E s)
  __Cont_get__ ,(return)
  Sjs_get s "name" ,(name)
  Sjs_get s "fn" ,(fn)
  Wx_once E name ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ return ,()
  Wx_candidate_fn E name fn)

;; 関数式 fn（名前 name）を候補にする：ジェネレータでも async でもなく、引数は名前だけ
(define Wx_candidate_fn ,(E name fn)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs0)
  __Dict_lookup_or__ funcs0 name (,(k) __NULL__ __NULL__) ,(dup)
  __is_null__ dup ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ fn "gen" (,(k) __NULL__ __FALSE__) ,(gen)
  __Dict_lookup_or__ fn "async" (,(k) __NULL__ __FALSE__) ,(async)
  __or__ gen async ,(test__) __if__ test__ return ,()
  ;; 値を返さない関数（値のある return がない。配列の計画の段階 A0）。値のある return とない return が混ざれば候補にしない
  Wx_returns fn ,(withValue bare)
  __Number_is_zero__ withValue ,(noValue)
  __Number_is_zero__ bare ,(noBare)
  __or__ noValue noBare ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body0)
  __is_null__ body0 ,(concise0)
  __not__ concise0 ,(block0)
  __and__ block0 noValue ,(isVoid)
  Sjs_get fn "params" ,(params)
  Wx_param_names params __NULL__ ,(ok names)
  __unless__ ok return ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(list)
  Wx_num "0" ,(zero)
  Wx_length list zero ,(idx)
  Wx_length names zero ,(n)
  __Dict_new__ ,(info)
  __Dict_put__ info "name" name ,()
  __Dict_put__ info "fn" fn ,()
  __Dict_put__ info "params" names ,()
  __Dict_put__ info "n" n ,()
  Wx_str idx ,(is)
  __String_concat__ "$f" is ,(label)
  __Dict_put__ info "label" label ,()
  __Dict_put__ info "ok" __FALSE__ ,()
  __Dict_put__ info "void" isVoid ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_put__ funcs name info ,()
  ;; list は宣言の順（後ろに足す）
  __LList_cons__ info __NULL__ ,(one)
  __LList_append__ list one ,(list)
  __Ref_set__ listRef list)

(define Wx_length ,(list n)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return n) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(m)
  Wx_length rest m)

;; 関数 fn の本体の、値のある return と、値のない return の数
(define Wx_returns ,(fn)
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(withValue)
  __Ref_new__ zero ,(bare)
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body)
  Wx_walk body (,(n)
    Wx_t n ,(t)
    __String_equal__ t "return" ,(isReturn)
    __if__ isReturn
      (,()
        __Dict_lookup_or__ n "value" (,(k) __NULL__ __NULL__) ,(v)
        __is_null__ v ,(none)
        __if_then_else__ none (,() Wx_inc bare) (,() Wx_inc withValue)) ,()) ,()
  __Ref_get__ withValue ,(w)
  __Ref_get__ bare ,(b)
  __NULL__ w b)

;; 引数がすべて名前で重ならなければ、真と名前の LList（順のとおり）
(define Wx_param_names ,(params acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() Wx_reverse acc __NULL__ ,(l) return __TRUE__ l) ,()
  __LList_uncons__ __print_exit_error__ params ,(p rest)
  Wx_t p ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Sjs_get p "name" ,(nm)
  Wx_member nm acc ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  __LList_cons__ nm acc ,(acc)
  Wx_param_names rest acc)

(define Wx_reverse ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __LList_cons__ x acc ,(acc)
