(define Wx_member ,(s list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __String_equal__ x s ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Wx_member s rest)

;; ── 配列の深さ（配列の計画の段階 A3）──
;; 引数と局所の変数の深さ（0 は数、1 は数の配列、2 は数の配列の配列、…）を、関数の本体から集めた等式で決める。
;; 項 (b k) は「変数 b の深さ + k」（b が "" なら深さ k）で、b が "?" なら深さに関わらない値（真偽値、値を返さない関数の値）。
;; 変数の名前は、関数の $f番号 と元の名前を ":" でつないだもの（関数の中で名前は重ならない）。等式は、数の関数の候補すべてで
;; 1 つの列にし（呼び出しの引数と、呼ばれる関数の引数を結ぶ）、食い違えば、その等式を作った関数を数の関数にしない。
;; 決まらない深さは、等式の右辺を 0 以上で最も浅くし、どの等式にも出ない引数は数にする。

(define Wy_infer_all ,(E infos)
  __Ref_new__ __NULL__ ,(eqs)
  __Dict_put__ E "eqs" eqs ,()
  __Dict_new__ ,(conflicts)
  __Dict_put__ E "conflicts" conflicts ,()
  Wy_collect_all E infos ,()
  Wy_solve E ,(depths)
  Wy_assign E infos depths)

(define Wy_collect_all ,(E infos)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  __Dict_new__ ,(F)
  __Dict_put__ F "E" E ,()
  Sjs_get info "label" ,(label)
  __Dict_put__ F "owner" label ,()
  __String_concat__ label ":" ,(prefix)
  __Dict_put__ F "prefix" prefix ,()
  Sjs_get info "fn" ,(fn)
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body)
  __is_null__ body ,(concise)
  __if_then_else__ concise
    (,() __Dict_lookup_or__ fn "expr" (,(k) __NULL__ __NULL__) ,(expr) Wy_expr F expr ,(b k) Wy_num F b k)
    (,() Sjs_get body "body" ,(stmts) Wy_stmts F stmts) ,()
  Wy_collect_all E rest)

(define Wy_eqs_put ,(F a b k)
  __Dict_lookup_or__ F "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ E "eqs" __print_exit_error__ ,(eqs)
  __Ref_get__ eqs ,(list)
  __Dict_lookup_or__ F "owner" __print_exit_error__ ,(owner)
  __LList_cons__ k __NULL__ ,(eq)
  __LList_cons__ b eq ,(eq)
  __LList_cons__ a eq ,(eq)
  __LList_cons__ owner eq ,(eq)
  __LList_cons__ eq list ,(list)
  __Ref_set__ eqs list)

(define Wy_conflict ,(E owner)
  __Dict_lookup_or__ E "conflicts" __print_exit_error__ ,(conflicts)
  __Dict_put__ conflicts owner __TRUE__)

;; 項 (b k) の深さが 1 以上（o.length の o）
(define Wy_atleast ,(F b k)
  __Cont_get__ ,(return)
  __String_equal__ b "?" ,(test__) __if__ test__ return ,()
  __Dict_lookup_or__ F "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ F "owner" __print_exit_error__ ,(owner)
  __String_equal__ b "" ,(test__) __if__ test__
    (,() __Number_is_positive__ k ,(ok) __unless__ ok (,() Wy_conflict E owner) ,() return) ,()
  __Dict_lookup_or__ E "atleast" (,(x) __NULL__ __NULL__) ,(list)
  __LList_cons__ k __NULL__ ,(item)
  __LList_cons__ b item ,(item)
  __LList_cons__ owner item ,(item)
  __LList_cons__ item list ,(list)
  __Dict_put__ E "atleast" list)

;; 項 (b1 k1) と (b2 k2) が同じ深さ
(define Wy_unify ,(F b1 k1 b2 k2)
  __Cont_get__ ,(return)
  __String_equal__ b1 "?" ,(u1)
  __String_equal__ b2 "?" ,(u2)
  __or__ u1 u2 ,(test__) __if__ test__ return ,()
  __String_equal__ b1 "" ,(c1)
  __String_equal__ b2 "" ,(c2)
  __and__ c1 c2 ,(test__) __if__ test__
    (,()
      __Number_subtract__ k1 k2 ,(d)
      __Number_is_zero__ d ,(same)
      __unless__ same (,() __Dict_lookup_or__ F "E" __print_exit_error__ ,(E) __Dict_lookup_or__ F "owner" __print_exit_error__ ,(o) Wy_conflict E o) ,()
      return) ,()
  __if__ c1 (,() Wy_unify F b2 k2 b1 k1 ,() return) ,()
  ;; depth(b1) + k1 = depth(b2) + k2：depth(b1) = depth(b2) + (k2 - k1)
  __Number_subtract__ k2 k1 ,(k)
  Wy_eqs_put F b1 b2 k)

;; 項が数（深さ 0）
(define Wy_num ,(F b k)
  Wx_num "0" ,(zero)
  Wy_unify F b k "" zero)

(define Wy_var ,(F name)
  __Dict_lookup_or__ F "prefix" __print_exit_error__ ,(prefix)
  __String_concat__ prefix name)

;; 式 e の項
(define Wy_expr ,(F e)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  Wx_num "1" ,(one)
  __is_null__ e ,(test__) __if__ test__ (,() return "?" zero) ,()
  Wx_t e ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__ (,() return "" zero) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wy_expr F inner ,(b k) return b k) ,()
  __String_equal__ t "id" ,(test__) __if__ test__
    (,()
      Sjs_get e "name" ,(nm)
      __Dict_lookup_or__ F "E" __print_exit_error__ ,(E)
      __Dict_lookup_or__ E "consts" __print_exit_error__ ,(consts)
      __Dict_lookup_or__ consts nm (,(k) __NULL__ __NULL__) ,(c)
      __is_null__ c ,(test__) __unless__ test__ (,() return "" zero) ,()
      Sjs_in_words nm "NaN Infinity" ,(test__) __if__ test__ (,() return "" zero) ,()
      Wy_var F nm ,(v)
      return v zero) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__
    (,()
      Sjs_get e "op" ,(op)
      Sjs_get e "arg" ,(arg)
      Wy_expr F arg ,(b k)
      __String_equal__ op "!" ,(test__) __if__ test__ (,() return "?" zero) ,()
      Wy_num F b k ,()
      return "" zero) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__
    (,()
      Sjs_get e "op" ,(op)
      Sjs_get e "left" ,(left)
      Sjs_get e "right" ,(right)
      Wy_expr F left ,(lb lk)
      Wy_expr F right ,(rb rk)
      Sjs_in_words op "&& ||" ,(test__) __if__ test__ (,() return "?" zero) ,()
      Wy_num F lb lk ,()
      Wy_num F rb rk ,()
      Sjs_in_words op "< > <= >= === !==" ,(test__) __if__ test__ (,() return "?" zero) ,()
      return "" zero) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__
    (,()
      Sjs_get e "test" ,(test)
      Wy_expr F test ,(tb tk)
      Sjs_get e "yes" ,(yes)
      Sjs_get e "no" ,(no)
      Wy_expr F yes ,(yb yk)
      Wy_expr F no ,(nb nk)
      Wy_unify F yb yk nb nk ,()
      return yb yk) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Wy_call F e ,(b k) return b k) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      Wx_is_math_member e ,(isMath)
      __if__ isMath (,() return "" zero) ,()
      Sjs_get e "object" ,(object)
      Wy_expr F object ,(ob ok)
      __Dict_lookup_or__ e "key" (,(k) __NULL__ __NULL__) ,(key)
      ;; o.length：o は配列（深さ 1 以上）
      __is_null__ key ,(test__) __if__ test__ (,() Wy_atleast F ob ok ,() return "" zero) ,()
      Wy_expr F key ,(kb kk)
      Wy_num F kb kk ,()
      __Number_subtract__ ok one ,(ek)
      return ob ek) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__ (,() Wy_effect F e ,() return "?" zero) ,()
  __String_equal__ t "update" ,(test__) __if__ test__ (,() Wy_effect F e ,() return "?" zero) ,()
  __NULL__ "?" zero)

(define Wy_call ,(F e)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  Sjs_get e "callee" ,(callee)
  Sjs_get e "args" ,(args)
