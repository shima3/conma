;; SJS の数の関数を WebAssembly のテキスト（WAT）にする（consh/SJS-WASM-PLAN-ja.md の段階 2）。
;; Wasm_prepare が、プログラムの一番外の function 宣言のうち、数だけを扱うもの（数の関数）を見つけて、
;; その fn の節に "wasm"（export の名前）を付け、それらをまとめた 1 つのモジュールの WAT を返す（なければ ""）。
;; 変換器（sjs_gen.se）は、印の付いた関数を Sjs_wasm_fn で包み、呼ばれたとき、実行時の支え（sjs_rt.se）が、引数が
;; 数なら wasm 版を、そうでなければ ConMa 版を動かす。2 つの版の結果は同じになる（f64 の演算は IEEE 754 のとおり）。
;;
;; 数の関数の条件（計画の 3。段階 2 は単独の SJS のファイルだけ）：
;; * 一番外の function 宣言で、ジェネレータでも async でもなく、引数は名前だけ（重ならない）。その名前は、一番外で
;;   1 回だけ宣言され、プログラムのどこでも代入されない。
;; * 本体は、let と const（名前だけで初期値のあるもの。名前は関数の中で重ならず、引数、一番外の数の定数、数の関数の
;;   名前とも違う）、式の文（局所の変数への代入、複合の代入、++、--、呼び出し）、if、while、do...while、for、ラベルの
;;   ない break と continue、値のある return、ブロック、空の文だけで、最後の文で必ず return する。
;; * 式は数（f64）か真偽値（i32）で、数のリテラル、引数と局所の変数、一番外の数の定数（数のリテラルの const で、
;;   一番外の最初の呼び出しより前に宣言したもの）、NaN、Infinity、算術（** を除く）、比較、ビット演算、単項の - + ~ !、
;;   条件演算子、真偽値どうしの && と ||、ほかの数の関数の呼び出し（引数の数が同じ）、Math.floor、ceil、trunc、
;;   abs、sqrt、round、sign、max、min、Math.PI（Math がプログラムで Math.名前 の形でしか使われず、書き換えられないとき）。
;;   算術と代入と戻り値は数だけ（真偽値を数として使うと、SJS では TypeError なので、数の関数にしない）。条件は、
;;   数なら JavaScript と同じ真偽（0、-0、NaN が偽）。
;; ConSh の (( )) と $(( ))（段階 4。Wasm_prepare_expr）：式の中の「名前 = 関数式（function かアロー関数）」を候補にする。
;; 名前は SJS変数で、後の (( )) で書き換えられ、Math のメンバーも書き換えられるので、呼ぶとき、呼ぶ数の関数の名前が作った
;; ときと同じ関数を指し、Math を使うなら Math のメンバーが元のままかを確かめる（sjs_rt.se の Sjs_wasm_fn_checked）。
;; 外の名前で読めるのは、NaN と Infinity だけ（組み込みは書き換えられない）。アロー関数の本体が式なら、それを返す。
;; WAT の関数は $f番号、局所の変数は $l番号（引数が先）、ラベルは $b番号（break）、$c番号（continue）、$k番号（ループ）。
;; % は $__mod、ToUint32 は $__u32、Math.round は $__round、Math.sign は $__sign（sjs_rt.se の Sjs_mod などと同じ手順）

;; ConSh の (( )) の式 e の WAT（数の関数がなければ ""）。数の関数の fn の節に "wasm"、"wasmCheck"（呼ぶときに確かめる
;; 名前を空白で区切ったもの）、"wasmMath"（Math を使うか）を付ける
(define Wasm_prepare_expr ,(e)
  Wx_env_module e ,(E)
  Wx_candidates_expr E e ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(infos)
  Wx_compile_all E infos ,()
  Wx_fixpoint E infos ,()
  Wx_mark_checks E infos ,()
  Wx_module infos)

;; プログラムの WAT（数の関数がなければ ""）。数の関数の fn の節に "wasm" を付ける
(define Wasm_prepare ,(program)
  Sjs_get program "body" ,(stmts)
  Wx_env stmts ,(E)
  Wx_candidates E stmts ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(infos)
  Wx_compile_all E infos ,()
  Wx_fixpoint E infos ,()
  Wx_module infos)

(define Wx_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

(define Wx_str ,(n)
  __Number_toString__ n)

;; ── 構文木をなめる ──

;; node（Dict の節か、その LList）の中のすべての節に f を適用する（f は値を返さない）
(define Wx_walk ,(node f)
  __Cont_get__ ,(return)
  __type_name__ node ,(type)
  __String_equal__ type "LList" ,(test__) __if__ test__ (,() Wx_walk_list node f ,() return) ,()
  __String_equal__ type "Dict" ,(test__) __unless__ test__ return ,()
  f node ,()
  __Dict_keys__ node ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  Gen_collect acc ,(sink)
  keys sink ,(s)
  __Ref_get__ acc ,(ks)
  Wx_walk_fields node ks f)

(define Wx_walk_list ,(list f)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Wx_walk x f ,()
  Wx_walk_list rest f)

(define Wx_walk_fields ,(node keys f)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  __Dict_lookup_or__ node k __print_exit_error__ ,(v)
  Wx_walk v f ,()
  Wx_walk_fields node rest f)

(define Wx_t ,(n)
  __Dict_lookup_or__ n "t" (,(k) __NULL__ ""))

;; n が名前 name の id の節か
(define Wx_is_id ,(n name)
  __Cont_get__ ,(return)
  __type_name__ n ,(type)
  __String_equal__ type "Dict" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Wx_t n ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Sjs_get n "name" ,(nm)
  __String_equal__ nm name)

;; n が Math.名前（計算したキーでも ?. でもない）か
(define Wx_is_math_member ,(n)
  __Cont_get__ ,(return)
  Wx_t n ,(t)
  __String_equal__ t "member" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ n "name" (,(k) __NULL__ __NULL__) ,(name)
  __is_null__ name ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ n "optional" (,(k) __NULL__ __FALSE__) ,(opt)
  __if__ opt (,() return __FALSE__) ,()
  Sjs_get n "object" ,(o)
  Wx_is_id o "Math")

(define Wx_inc ,(ref)
  __Ref_get__ ref ,(n)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(m)
  __Ref_set__ ref m)

;; ── プログラム全体の情報 E ──
;; "assigned"：代入される名前、"math"：Math を Math.名前 の形でしか使わず、書き換えないか、"consts"：一番外の数の定数
;; （名前 → WAT の数）、"declared"：一番外で宣言した名前 → 回数、"funcs"：数の関数の候補（名前 → 情報）、"list"：候補の LList

(define Wx_env ,(stmts)
  __Dict_new__ ,(E)
  __Dict_new__ ,(assigned)
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(mathIds)
  __Ref_new__ zero ,(mathMembers)
  __Ref_new__ __FALSE__ ,(mathWritten)
  Wx_walk stmts (,(n) Wx_env_node n assigned mathIds mathMembers mathWritten) ,()
  __Dict_put__ E "assigned" assigned ,()
  __Ref_get__ mathIds ,(ids)
  __Ref_get__ mathMembers ,(members)
  __Ref_get__ mathWritten ,(written)
  __Number_subtract__ ids members ,(d)
  __Number_is_zero__ d ,(onlyMembers)
  __not__ written ,(unwritten)
  __and__ onlyMembers unwritten ,(mathOk)
  __Dict_put__ E "math" mathOk ,()
  __Dict_new__ ,(consts)
  __Dict_put__ E "consts" consts ,()
  __Dict_new__ ,(declared)
  __Dict_put__ E "declared" declared ,()
  Wx_declared stmts declared ,()
  Wx_consts stmts consts declared ,()
  __Dict_new__ ,(funcs)
  __Dict_put__ E "funcs" funcs ,()
  __Ref_new__ __NULL__ ,(list)
  __Dict_put__ E "list" list ,()
  __NULL__ E)

(define Wx_env_node ,(n assigned mathIds mathMembers mathWritten)
  __Cont_get__ ,(return)
  Wx_t n ,(t)
  __String_equal__ t "id" ,(test__) __if__ test__
    (,() Wx_is_id n "Math" ,(m) __if__ m (,() Wx_inc mathIds) ,() return) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,() Wx_is_math_member n ,(m) __if__ m (,() Wx_inc mathMembers) ,() return) ,()
  Sjs_in_words t "assign update forof forin" ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ n "target" (,(k) __NULL__ __NULL__) ,(target)
  __is_null__ target ,(test__) __if__ test__ return ,()
  Wx_t target ,(tt)
  __String_equal__ tt "member" ,(test__) __if__ test__
    (,() Sjs_get target "object" ,(o) Wx_is_id o "Math" ,(m) __if__ m (,() __Ref_set__ mathWritten __TRUE__) ,() return) ,()
  ;; 代入の先の形（名前、分割代入、for の宣言）のすべての名前
  Wx_walk target (,(x) Wx_t x ,(xt) __String_equal__ xt "id" ,(isId) __if__ isId (,() Sjs_get x "name" ,(nm) __Dict_put__ assigned nm __TRUE__) ,()))

;; (( )) の式の E：Math は呼ぶときに確かめるので使ってよく、一番外の宣言と数の定数はない。"counts" は代入の回数
(define Wx_env_module ,(e)
  __Dict_new__ ,(E)
  __Dict_new__ ,(assigned)
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(r1)
  __Ref_new__ zero ,(r2)
  __Ref_new__ __FALSE__ ,(r3)
  Wx_walk e (,(n) Wx_env_node n assigned r1 r2 r3) ,()
  __Dict_put__ E "assigned" assigned ,()
  __Dict_put__ E "math" __TRUE__ ,()
  __Dict_put__ E "module" __TRUE__ ,()
  __Dict_new__ ,(consts)
  __Dict_put__ E "consts" consts ,()
  __Dict_new__ ,(declared)
  __Dict_put__ E "declared" declared ,()
  __Dict_new__ ,(counts)
  Wx_walk e (,(n) Wx_t n ,(t) __String_equal__ t "assign" ,(isAssign) __if__ isAssign (,() Sjs_get n "target" ,(target) Wx_t target ,(tt) __String_equal__ tt "id" ,(isId) __if__ isId (,() Sjs_get target "name" ,(nm) Wx_count counts nm) ,()) ,()) ,()
  __Dict_put__ E "counts" counts ,()
  __Dict_new__ ,(funcs)
  __Dict_put__ E "funcs" funcs ,()
  __Ref_new__ __NULL__ ,(list)
  __Dict_put__ E "list" list ,()
  __NULL__ E)

;; (( )) の式の候補：一番外の（コンマ演算子で並べたものも）「名前 = 関数式」で、名前はこの式で 1 回だけ代入される
(define Wx_candidates_expr ,(E e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_candidates_expr E inner ,() return) ,()
  __String_equal__ t "seq" ,(test__) __if__ test__ (,() Sjs_get e "exprs" ,(es) Wx_candidates_list E es ,() return) ,()
  __String_equal__ t "assign" ,(test__) __unless__ test__ return ,()
  Sjs_get e "op" ,(op)
  __String_equal__ op "=" ,(test__) __unless__ test__ return ,()
  Sjs_get e "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ return ,()
  Sjs_get target "name" ,(name)
  Sjs_get e "value" ,(value)
  Wx_unparen value ,(fn)
  Wx_t fn ,(ft)
  Sjs_in_words ft "function arrow" ,(test__) __unless__ test__ return ,()
  ;; 名前の付いた function 式は、その名前が代入する名前と同じときだけ
  __Dict_lookup_or__ fn "name" (,(k) __NULL__ "") ,(own)
  __is_null__ own ,(noOwn)
  __if_then_else__ noOwn (,() __NULL__ "") (,() __NULL__ own) ,(own)
  __String_equal__ own "" ,(anonymous)
  __String_equal__ own name ,(same)
  __or__ anonymous same ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ E "counts" __print_exit_error__ ,(counts)
  Wx_once_in counts name ,(test__) __unless__ test__ return ,()
  Wx_candidate_fn E name fn)

(define Wx_candidates_list ,(E es)
  __Cont_get__ ,(return)
  __is_null__ es ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ es ,(e rest)
  Wx_candidates_expr E e ,()
  Wx_candidates_list E rest)

(define Wx_unparen ,(e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_unparen inner ,(r) return r) ,()
  __NULL__ e)

(define Wx_once_in ,(dict name)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ dict name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_subtract__ c one ,(d)
  __Number_is_zero__ d)

;; 一番外で宣言した名前の回数
(define Wx_declared ,(stmts declared)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Sjs_get s "name" ,(nm) Wx_count declared nm) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,() Sjs_get s "decls" ,(ds) Wx_decl_names ds __NULL__ ,(names) Wx_count_all declared names) ,()
  Wx_declared rest declared)

(define Wx_decl_names ,(ds acc)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  Gen_pattern_names target acc ,(acc)
  Wx_decl_names rest acc)

(define Wx_count ,(dict name)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ dict name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_add__ c one ,(c)
  __Dict_put__ dict name c)

(define Wx_count_all ,(dict names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  Wx_count dict nm ,()
  Wx_count_all dict rest)

(define Wx_once ,(E name)
  __Dict_lookup_or__ E "declared" __print_exit_error__ ,(declared)
  Wx_num "0" ,(zero)
  __Dict_lookup_or__ declared name (,(k) __NULL__ zero) ,(c)
  Wx_num "1" ,(one)
  __Number_subtract__ c one ,(d)
  __Number_is_zero__ d)

;; node の中に呼び出し（タグ付きテンプレートも）があるか
(define Wx_has_call ,(node)
  __Ref_new__ __FALSE__ ,(found)
  Wx_walk node (,(x) Wx_t x ,(t) Sjs_in_words t "call tagged" ,(c) __if__ c (,() __Ref_set__ found __TRUE__) ,()) ,()
  __Ref_get__ found)

;; 一番外の数の定数：最初の呼び出しのある文より前の const で、名前と数のリテラル
(define Wx_consts ,(stmts consts declared)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_has_call s ,(test__) __if__ test__ return ,()
  Wx_t s ,(t)
  __String_equal__ t "decl" ,(isDecl)
  __if__ isDecl
    (,()
      Sjs_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      __if__ isConst (,() Sjs_get s "decls" ,(ds) Wx_const_decls ds consts) ,()) ,()
  Wx_consts rest consts declared)

(define Wx_const_decls ,(ds consts)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(isId)
  __is_null__ init ,(none)
  __if_then_else__ none (,() __NULL__ "") (,() Wx_t init) ,(it)
  __String_equal__ it "num" ,(isNum)
  __and__ isId isNum ,(test__) __if__ test__
    (,()
      Sjs_get target "name" ,(nm)
      Sjs_get init "text" ,(text)
      __Number_fromString__ (,(msg) __NULL__ __NULL__) text ,(v)
      __is_null__ v ,(bad)
      __unless__ bad (,() Wx_f64 v ,(c) __Dict_put__ consts nm c) ,()) ,()
  Wx_const_decls rest consts)

;; 数 v の WAT の定数
(define Wx_f64 ,(v)
  Wx_str v ,(s)
  Cat3 "(f64.const " s ")")

;; ── 候補 ──

(define Wx_candidates ,(E stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_t s ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Wx_candidate E s) ,()
  Wx_candidates E rest)

(define Wx_candidate ,(E s)
  __Cont_get__ ,(return)
  Sjs_get s "name" ,(name)
  Sjs_get s "fn" ,(fn)
  Wx_once E name ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned name (,(k) __NULL__ __FALSE__) ,(test__) __if__ test__ return ,()
  Wx_candidate_fn E name fn)

;; 関数式 fn（名前 name）を候補にする：ジェネレータでも async でもなく、引数は名前だけ
(define Wx_candidate_fn ,(E name fn)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs0)
  __Dict_lookup_or__ funcs0 name (,(k) __NULL__ __NULL__) ,(dup)
  __is_null__ dup ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ fn "gen" (,(k) __NULL__ __FALSE__) ,(gen)
  __Dict_lookup_or__ fn "async" (,(k) __NULL__ __FALSE__) ,(async)
  __or__ gen async ,(test__) __if__ test__ return ,()
  Sjs_get fn "params" ,(params)
  Wx_param_names params __NULL__ ,(ok names)
  __unless__ ok return ,()
  __Dict_lookup_or__ E "list" __print_exit_error__ ,(listRef)
  __Ref_get__ listRef ,(list)
  Wx_num "0" ,(zero)
  Wx_length list zero ,(idx)
  Wx_length names zero ,(n)
  __Dict_new__ ,(info)
  __Dict_put__ info "name" name ,()
  __Dict_put__ info "fn" fn ,()
  __Dict_put__ info "params" names ,()
  __Dict_put__ info "n" n ,()
  Wx_str idx ,(is)
  __String_concat__ "$f" is ,(label)
  __Dict_put__ info "label" label ,()
  __Dict_put__ info "ok" __FALSE__ ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_put__ funcs name info ,()
  ;; list は宣言の順（後ろに足す）
  __LList_cons__ info __NULL__ ,(one)
  __LList_append__ list one ,(list)
  __Ref_set__ listRef list)

(define Wx_length ,(list n)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return n) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(m)
  Wx_length rest m)

;; 引数がすべて名前で重ならなければ、真と名前の LList（順のとおり）
(define Wx_param_names ,(params acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() Wx_reverse acc __NULL__ ,(l) return __TRUE__ l) ,()
  __LList_uncons__ __print_exit_error__ params ,(p rest)
  Wx_t p ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Sjs_get p "name" ,(nm)
  Wx_member nm acc ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  __LList_cons__ nm acc ,(acc)
  Wx_param_names rest acc)

(define Wx_reverse ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __LList_cons__ x acc ,(acc)
  Wx_reverse rest acc)

(define Wx_member ,(s list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __String_equal__ x s ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Wx_member s rest)

;; ── 関数ごとの WAT ──

(define Wx_compile_all ,(E infos)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Wx_compile E info ,()
  Wx_compile_all E rest)

;; info の関数の WAT を作り、"wat"、"callees"、"ok" を入れる。数の関数の条件を満たさなければ "ok" は偽
(define Wx_compile ,(E info)
  Wx_func E info ,(ok wat callees)
  __Dict_put__ info "ok" ok ,()
  __Dict_put__ info "wat" wat ,()
  __Dict_put__ info "callees" callees)

(define Wx_func ,(E info)
  __Cont_get__ ,(fail)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fail" fail ,()
  __Dict_put__ cx "E" E ,()
  __Dict_new__ ,(locals)
  __Dict_put__ cx "locals" locals ,()
  Wx_num "0" ,(zero)
  __Ref_new__ zero ,(nloc)
  __Dict_put__ cx "nloc" nloc ,()
  __Ref_new__ zero ,(nlab)
  __Dict_put__ cx "nlab" nlab ,()
  __Ref_new__ "" ,(decls)
  __Dict_put__ cx "decls" decls ,()
  __Ref_new__ __NULL__ ,(loop)
  __Dict_put__ cx "loop" loop ,()
  __Ref_new__ __NULL__ ,(callees)
  __Dict_put__ cx "callees" callees ,()
  __Ref_new__ __FALSE__ ,(usesMath)
  __Dict_put__ cx "usesMath" usesMath ,()
  Sjs_get info "params" ,(params)
  Wx_bind_params cx params "" ,(head)
  Sjs_get info "fn" ,(fn)
  __Dict_lookup_or__ fn "body" (,(k) __NULL__ __NULL__) ,(body)
  __is_null__ body ,(concise)
  ;; アロー関数の本体が式なら、それを返す
  __if_then_else__ concise
    (,()
      __Dict_lookup_or__ fn "expr" (,(k) __NULL__ __NULL__) ,(expr)
      __is_null__ expr ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      Wx_num_expr cx expr ,(c)
      Cat3 "(return " c ") ")
    (,()
      Sjs_get body "body" ,(stmts)
      Wx_ends_list stmts ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      Wx_stmts cx stmts "") ,(code)
  __Ref_get__ usesMath ,(um)
  __Dict_put__ info "math" um ,()
  Sjs_get info "label" ,(label)
  Sjs_get info "name" ,(name)
  Gen_quote name ,(qn)
  __Ref_get__ decls ,(ld)
  Cat5 "(func " label " (export " qn ") " ,(s)
  Cat5 s head "(result f64) (local $tmp f64) " ld code ,(s)
  __String_concat__ s "(unreachable)) " ,(wat)
  __Ref_get__ callees ,(cs)
  __NULL__ __TRUE__ wat cs)

(define Wx_fail ,(cx)
  __Dict_lookup_or__ cx "fail" __print_exit_error__ ,(fail)
  fail __FALSE__ "" __NULL__)

;; 引数を $l0 から順に局所の変数にする。(param $l0 f64) ... を返す
(define Wx_bind_params ,(cx params acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(nm rest)
  Wx_new_local cx nm __FALSE__ ,(l)
  Cat3 acc "(param " l ,(acc)
  __String_concat__ acc " f64) " ,(acc)
  Wx_bind_params cx rest acc)

;; 名前 nm の新しい局所の変数（$l番号）。名前が局所の変数、一番外の数の定数、数の関数の候補と重なれば、数の関数にしない
(define Wx_new_local ,(cx nm isConst)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __NULL__) ,(old)
  __is_null__ old ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ E "consts" __print_exit_error__ ,(consts)
  __Dict_lookup_or__ consts nm (,(k) __NULL__ __NULL__) ,(c)
  __is_null__ c ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm (,(k) __NULL__ __NULL__) ,(f)
  __is_null__ f ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  Sjs_in_words nm "Math NaN Infinity undefined" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ cx "nloc" __print_exit_error__ ,(nloc)
  __Ref_get__ nloc ,(k)
  Wx_inc nloc ,()
  Wx_str k ,(ks)
  __String_concat__ "$l" ks ,(l)
  __Dict_put__ locals nm l ,()
  __String_concat__ "const:" nm ,(ck)
  __Dict_put__ locals ck isConst ,()
  __NULL__ l)

;; 局所の変数を宣言する（引数でない局所の変数）
(define Wx_declare ,(cx nm isConst)
  Wx_new_local cx nm isConst ,(l)
  __Dict_lookup_or__ cx "decls" __print_exit_error__ ,(decls)
  __Ref_get__ decls ,(d)
  Cat4 d "(local " l " f64) " ,(d)
  __Ref_set__ decls d ,()
  __NULL__ l)

(define Wx_label ,(cx prefix)
  __Dict_lookup_or__ cx "nlab" __print_exit_error__ ,(nlab)
  __Ref_get__ nlab ,(k)
  Wx_inc nlab ,()
  Wx_str k ,(ks)
  __String_concat__ prefix ks)

;; 最後の文で必ず return するか
(define Wx_ends_list ,(stmts)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  __is_null__ rest ,(test__) __if__ test__ (,() Wx_ends s ,(e) return e) ,()
  Wx_ends_list rest)

(define Wx_ends ,(s)
  __Cont_get__ ,(return)
  __is_null__ s ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Wx_t s ,(t)
  __String_equal__ t "return" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ t "block" ,(test__) __if__ test__ (,() Sjs_get s "body" ,(b) Wx_ends_list b ,(e) return e) ,()
  __String_equal__ t "if" ,(test__) __if__ test__
    (,()
      Sjs_get s "yes" ,(yes)
      __Dict_lookup_or__ s "no" (,(k) __NULL__ __NULL__) ,(no)
      Wx_ends yes ,(a)
      Wx_ends no ,(b)
      __and__ a b ,(e)
      return e) ,()
  __NULL__ __FALSE__)

;; ── 文 ──

(define Wx_stmts ,(cx stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Wx_stmt cx s ,(c)
  __String_concat__ acc c ,(acc)
  Wx_stmts cx rest acc)

(define Wx_stmt ,(cx s)
  __Cont_get__ ,(return)
  __is_null__ s ,(test__) __if__ test__ (,() return "") ,()
  Wx_t s ,(t)
  __String_equal__ t "empty" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "block" ,(test__) __if__ test__ (,() Sjs_get s "body" ,(b) Wx_stmts cx b "" ,(c) return c) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__ (,() Wx_decl cx s ,(c) return c) ,()
  __String_equal__ t "expr" ,(test__) __if__ test__ (,() Sjs_get s "expr" ,(e) Wx_effect cx e ,(c) return c) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ s "value" (,(k) __NULL__ __NULL__) ,(v)
      __is_null__ v ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      Wx_num_expr cx v ,(c)
      Cat3 "(return " c ") " ,(c)
      return c) ,()
  __String_equal__ t "if" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Wx_cond cx test ,(tc)
      Sjs_get s "yes" ,(yes)
      __Dict_lookup_or__ s "no" (,(k) __NULL__ __NULL__) ,(no)
      Wx_stmt cx yes ,(yc)
      Wx_stmt cx no ,(nc)
      Cat5 "(if " tc " (then " yc ") (else " ,(c)
      Cat3 c nc ")) " ,(c)
      return c) ,()
  __String_equal__ t "while" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Sjs_get s "body" ,(body)
      Wx_loop cx "" test body __NULL__ ,(c)
      return c) ,()
  __String_equal__ t "for" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ s "init" (,(k) __NULL__ __NULL__) ,(init)
      Wx_stmt cx init ,(ic)
      __Dict_lookup_or__ s "test" (,(k) __NULL__ __NULL__) ,(test)
      __Dict_lookup_or__ s "update" (,(k) __NULL__ __NULL__) ,(update)
      Sjs_get s "body" ,(body)
      Wx_loop cx ic test body update ,(c)
      return c) ,()
  __String_equal__ t "dowhile" ,(test__) __if__ test__
    (,()
      Sjs_get s "test" ,(test)
      Sjs_get s "body" ,(body)
      Wx_dowhile cx test body ,(c)
      return c) ,()
  Sjs_in_words t "break continue" ,(test__) __if__ test__
    (,()
      Sjs_get s "label" ,(lab)
      __String_equal__ lab "" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      __Dict_lookup_or__ cx "loop" __print_exit_error__ ,(loopRef)
      __Ref_get__ loopRef ,(lp)
      __is_null__ lp ,(test__) __if__ test__ (,() Wx_fail cx) ,()
      __String_equal__ t "break" ,(isBreak)
      __if_then_else__ isBreak (,() Sjs_get lp "brk") (,() Sjs_get lp "cnt") ,(target)
      Cat3 "(br " target ") " ,(c)
      return c) ,()
  Wx_fail cx)

;; let と const の宣言：名前と初期値（数）
(define Wx_decl ,(cx s)
  Sjs_get s "kind" ,(kind)
  Sjs_in_words kind "let const" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "decls" ,(ds)
  Wx_declarators cx ds isConst "")

(define Wx_declarators ,(cx ds isConst acc)
  __Cont_get__ ,(return)
  __is_null__ ds ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ ds ,(d rest)
  Sjs_get d "target" ,(target)
  Wx_t target ,(tt)
  __String_equal__ tt "id" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  __is_null__ init ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  Wx_num_expr cx init ,(ic)
  Sjs_get target "name" ,(nm)
  Wx_declare cx nm isConst ,(l)
  Cat5 acc "(local.set " l " " ic ,(acc)
  __String_concat__ acc ") " ,(acc)
  Wx_declarators cx rest isConst acc)

;; while と for（ic は初期化の WAT、update は更新の式か null）：
;; (block $b (loop $k (br_if $b (i32.eqz test)) (block $c body) update (br $k)))
(define Wx_loop ,(cx ic test body update)
  Wx_label cx "$b" ,(b)
  Wx_label cx "$k" ,(k)
  Wx_label cx "$c" ,(c)
  __is_null__ test ,(noTest)
  __if_then_else__ noTest (,() __NULL__ "")
    (,() Wx_cond cx test ,(tc) Cat5 "(br_if " b " (i32.eqz " tc ")) ") ,(testCode)
  Wx_in_loop cx b c body ,(bc)
  __is_null__ update ,(noUpdate)
  __if_then_else__ noUpdate (,() __NULL__ "") (,() Wx_effect cx update) ,(uc)
  Cat5 ic "(block " b " (loop " k ,(s)
  Cat5 s " " testCode "(block " c ,(s)
  Cat5 s " " bc ") " uc ,(s)
  Cat3 s "(br " k ,(s)
  __String_concat__ s "))) ")

;; do...while：(block $b (loop $k (block $c body) (br_if $k test)))
(define Wx_dowhile ,(cx test body)
  Wx_label cx "$b" ,(b)
  Wx_label cx "$k" ,(k)
  Wx_label cx "$c" ,(c)
  Wx_in_loop cx b c body ,(bc)
  Wx_cond cx test ,(tc)
  Cat4 "(block " b " (loop " k ,(s)
  Cat5 s " (block " c " " bc ,(s)
  Cat5 s ") (br_if " k " " tc ,(s)
  __String_concat__ s "))) ")

;; ループの本体（break は b、continue は c へ）
(define Wx_in_loop ,(cx b c body)
  __Dict_lookup_or__ cx "loop" __print_exit_error__ ,(loopRef)
  __Ref_get__ loopRef ,(saved)
  __Dict_new__ ,(lp)
  __Dict_put__ lp "brk" b ,()
  __Dict_put__ lp "cnt" c ,()
  __Ref_set__ loopRef lp ,()
  Wx_stmt cx body ,(code)
  __Ref_set__ loopRef saved ,()
  __NULL__ code)

;; 値を使わない式（式の文と for の更新）：代入、複合の代入、++、--、ほかは drop する
(define Wx_effect ,(cx e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_effect cx inner ,(c) return c) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__
    (,()
      Sjs_get e "target" ,(target)
      Sjs_get e "op" ,(op)
      Sjs_get e "value" ,(value)
      Wx_target cx target ,(l)
      Wx_num_expr cx value ,(vc)
      __String_equal__ op "=" ,(test__) __if__ test__ (,() Cat5 "(local.set " l " " vc ") " ,(c) return c) ,()
      __String_length__ op ,(len)
      Wx_num "1" ,(one)
      __Number_subtract__ len one ,(m)
      Wx_num "0" ,(zero)
      __String_substring__ __print_exit_error__ op zero m ,(bop)
      Cat3 "(local.get " l ")" ,(lc)
      Wx_arith cx bop lc vc ,(rc)
      Cat5 "(local.set " l " " rc ") " ,(c)
      return c) ,()
  __String_equal__ t "update" ,(test__) __if__ test__
    (,()
      Sjs_get e "target" ,(target)
      Sjs_get e "op" ,(op)
      Wx_target cx target ,(l)
      __String_equal__ op "++" ,(inc)
      __if_then_else__ inc (,() __NULL__ "f64.add") (,() __NULL__ "f64.sub") ,(ins)
      Cat5 "(local.set " l " (" ins " (local.get " ,(c)
      Cat3 c l ") (f64.const 1))) " ,(c)
      return c) ,()
  Wx_expr cx e ,(c type)
  Cat3 "(drop " c ") ")

;; 代入できる名前（const でない局所の変数か引数）の WAT の名前
(define Wx_target ,(cx target)
  Wx_t target ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  Sjs_get target "name" ,(nm)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __NULL__) ,(l)
  __is_null__ l ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  __String_concat__ "const:" nm ,(ck)
  __Dict_lookup_or__ locals ck (,(k) __NULL__ __FALSE__) ,(isConst)
  __if__ isConst (,() Wx_fail cx) ,()
  __NULL__ l)

;; ── 式 ──

;; 数の式の WAT（真偽値なら数の関数にしない）
(define Wx_num_expr ,(cx e)
  Wx_expr cx e ,(c type)
  __String_equal__ type "N" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __NULL__ c)

;; 条件の WAT（i32）：真偽値はそのまま、数は JavaScript の真偽（0、-0、NaN が偽）
(define Wx_cond ,(cx e)
  Wx_expr cx e ,(c type)
  Wx_truth c type)

(define Wx_truth ,(c type)
  __Cont_get__ ,(return)
  __String_equal__ type "B" ,(test__) __if__ test__ (,() return c) ,()
  Cat3 "(i32.and (f64.ne (local.tee $tmp " c ") (f64.const 0)) (f64.eq (local.get $tmp) (local.get $tmp)))")

;; 式の WAT と型（"N" は f64、"B" は i32 の真偽値）
(define Wx_expr ,(cx e)
  __Cont_get__ ,(return)
  Wx_t e ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __Number_fromString__ (,(msg) Wx_fail cx) text ,(v)
      Wx_f64 v ,(c)
      return c "N") ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Wx_expr cx inner ,(c ty) return c ty) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Wx_id cx e ,(c) return c "N") ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __String_equal__ text "true" ,(test__) __if__ test__ (,() return "(i32.const 1)" "B") ,()
      __String_equal__ text "false" ,(test__) __if__ test__ (,() return "(i32.const 0)" "B") ,()
      Wx_fail cx) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__ (,() Wx_unary cx e ,(c ty) return c ty) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Wx_binary cx e ,(c ty) return c ty) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__
    (,()
      Sjs_get e "test" ,(test)
      Wx_cond cx test ,(tc)
      Sjs_get e "yes" ,(yes)
      Sjs_get e "no" ,(no)
      Wx_expr cx yes ,(yc yt)
      Wx_expr cx no ,(nc nt)
      __String_equal__ yt nt ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      __String_equal__ yt "N" ,(isNum)
      __if_then_else__ isNum (,() __NULL__ "f64") (,() __NULL__ "i32") ,(rt)
      Cat5 "(if (result " rt ") " tc " (then " ,(c)
      Cat5 c yc ") (else " nc ")) " ,(c)
      return c yt) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Wx_call cx e ,(c) return c "N") ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
      __Dict_lookup_or__ E "math" __print_exit_error__ ,(mathOk)
      Wx_is_math_member e ,(isMath)
      __and__ mathOk isMath ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      Sjs_get e "name" ,(name)
      __String_equal__ name "PI" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      Wx_uses_math cx ,()
      return "(f64.const 3.141592653589793)" "N") ,()
  Wx_fail cx)

;; 名前を読む：局所の変数、一番外の数の定数、NaN、Infinity
(define Wx_id ,(cx e)
  __Cont_get__ ,(return)
  Sjs_get e "name" ,(nm)
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __NULL__) ,(l)
  __is_null__ l ,(test__) __unless__ test__ (,() Cat3 "(local.get " l ")" ,(c) return c) ,()
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  __Dict_lookup_or__ E "consts" __print_exit_error__ ,(consts)
  __Dict_lookup_or__ consts nm (,(k) __NULL__ __NULL__) ,(k)
  __is_null__ k ,(test__) __unless__ test__ (,() return k) ,()
  ;; NaN と Infinity：一番外で宣言されず、代入されないもの
  __Dict_lookup_or__ E "assigned" __print_exit_error__ ,(assigned)
  __Dict_lookup_or__ assigned nm (,(k) __NULL__ __FALSE__) ,(written)
  __Dict_lookup_or__ E "declared" __print_exit_error__ ,(declared)
  __Dict_lookup_or__ declared nm (,(k) __NULL__ __NULL__) ,(d)
  __is_null__ d ,(undeclared)
  __not__ written ,(unwritten)
  __and__ undeclared unwritten ,(builtin)
  __String_equal__ nm "NaN" ,(isNaN)
  __String_equal__ nm "Infinity" ,(isInf)
  __and__ builtin isNaN ,(test__) __if__ test__ (,() return "(f64.const nan)") ,()
  __and__ builtin isInf ,(test__) __if__ test__ (,() return "(f64.const inf)") ,()
  Wx_fail cx)

(define Wx_unary ,(cx e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "arg" ,(arg)
  __String_equal__ op "!" ,(test__) __if__ test__
    (,() Wx_cond cx arg ,(tc) Cat3 "(i32.eqz " tc ")" ,(c) return c "B") ,()
  Wx_num_expr cx arg ,(ac)
  __String_equal__ op "-" ,(test__) __if__ test__ (,() Cat3 "(f64.neg " ac ")" ,(c) return c "N") ,()
  __String_equal__ op "+" ,(test__) __if__ test__ (,() return ac "N") ,()
  __String_equal__ op "~" ,(test__) __if__ test__
    (,() Wx_i32 ac ,(ic) Cat3 "(f64.convert_i32_s (i32.xor " ic " (i32.const -1)))" ,(c) return c "N") ,()
  Wx_fail cx)

;; f64 の WAT の ToInt32（i32）
(define Wx_i32 ,(c)
  Cat3 "(i32.wrap_i64 (i64.trunc_f64_s (call $__u32 " c ")))")

(define Wx_binary ,(cx e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "left" ,(left)
  Sjs_get e "right" ,(right)
  Sjs_in_words op "&& ||" ,(test__) __if__ test__
    (,()
      Wx_expr cx left ,(lc lt)
      Wx_expr cx right ,(rc rt)
      __String_equal__ lt "B" ,(lb)
      __String_equal__ rt "B" ,(rb)
      __and__ lb rb ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
      __String_equal__ op "&&" ,(isAnd)
      __if_then_else__ isAnd
        (,() Cat5 "(if (result i32) " lc " (then " rc ") (else (i32.const 0)))")
        (,() Cat5 "(if (result i32) " lc " (then (i32.const 1)) (else " rc "))") ,(c)
      return c "B") ,()
  Wx_num_expr cx left ,(lc)
  Wx_num_expr cx right ,(rc)
  Sjs_in_words op "< > <= >= === !==" ,(test__) __if__ test__
    (,()
      Wx_cmp op ,(ins)
      Cat5 "(" ins " " lc " " ,(c)
      Cat3 c rc ")" ,(c)
      return c "B") ,()
  Wx_arith cx op lc rc ,(c)
  __NULL__ c "N")

(define Wx_cmp ,(op)
  __Cont_get__ ,(return)
  __String_equal__ op "<" ,(test__) __if__ test__ (,() return "f64.lt") ,()
  __String_equal__ op ">" ,(test__) __if__ test__ (,() return "f64.gt") ,()
  __String_equal__ op "<=" ,(test__) __if__ test__ (,() return "f64.le") ,()
  __String_equal__ op ">=" ,(test__) __if__ test__ (,() return "f64.ge") ,()
  __String_equal__ op "===" ,(test__) __if__ test__ (,() return "f64.eq") ,()
  __NULL__ "f64.ne")

;; 数の 2 項演算 op（算術かビット演算）の WAT
(define Wx_arith ,(cx op lc rc)
  __Cont_get__ ,(return)
  Wx_f64_op op ,(ins)
  __String_equal__ ins "" ,(test__) __unless__ test__
    (,() Cat5 "(" ins " " lc " " ,(c) Cat3 c rc ")" ,(c) return c) ,()
  __String_equal__ op "%" ,(test__) __if__ test__
    (,() Cat5 "(call $__mod " lc " " rc ")" ,(c) return c) ,()
  Wx_i32_op op ,(ins)
  __String_equal__ ins "" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  Wx_i32 lc ,(li)
  Wx_i32 rc ,(ri)
  __String_equal__ op ">>>" ,(unsigned)
  __if_then_else__ unsigned (,() __NULL__ "(f64.convert_i32_u (") (,() __NULL__ "(f64.convert_i32_s (") ,(head)
  Cat5 head ins " " li " " ,(c)
  Cat3 c ri "))")

(define Wx_f64_op ,(op)
  __Cont_get__ ,(return)
  __String_equal__ op "+" ,(test__) __if__ test__ (,() return "f64.add") ,()
  __String_equal__ op "-" ,(test__) __if__ test__ (,() return "f64.sub") ,()
  __String_equal__ op "*" ,(test__) __if__ test__ (,() return "f64.mul") ,()
  __String_equal__ op "/" ,(test__) __if__ test__ (,() return "f64.div") ,()
  __NULL__ "")

(define Wx_i32_op ,(op)
  __Cont_get__ ,(return)
  __String_equal__ op "&" ,(test__) __if__ test__ (,() return "i32.and") ,()
  __String_equal__ op "|" ,(test__) __if__ test__ (,() return "i32.or") ,()
  __String_equal__ op "^" ,(test__) __if__ test__ (,() return "i32.xor") ,()
  __String_equal__ op "<<" ,(test__) __if__ test__ (,() return "i32.shl") ,()
  __String_equal__ op ">>" ,(test__) __if__ test__ (,() return "i32.shr_s") ,()
  __String_equal__ op ">>>" ,(test__) __if__ test__ (,() return "i32.shr_u") ,()
  __NULL__ "")

;; 呼び出し：数の関数か Math の関数
(define Wx_call ,(cx e)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(opt)
  __if__ opt (,() Wx_fail cx) ,()
  Sjs_get e "callee" ,(callee)
  Sjs_get e "args" ,(args)
  Wx_args cx args "" ,(ac n)
  __Dict_lookup_or__ cx "E" __print_exit_error__ ,(E)
  Wx_is_math_member callee ,(isMath)
  __if__ isMath
    (,()
      __Dict_lookup_or__ E "math" __print_exit_error__ ,(mathOk)
      __unless__ mathOk (,() Wx_fail cx) ,()
      Wx_uses_math cx ,()
      Sjs_get callee "name" ,(name)
      Wx_math cx name args ,(c)
      return c) ,()
  Wx_t callee ,(ct)
  __String_equal__ ct "id" ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  Sjs_get callee "name" ,(nm)
  ;; 局所の変数の名前なら、数の関数ではない
  __Dict_lookup_or__ cx "locals" __print_exit_error__ ,(locals)
  __Dict_lookup_or__ locals nm (,(k) __NULL__ __NULL__) ,(l)
  __is_null__ l ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm (,(k) __NULL__ __NULL__) ,(info)
  __is_null__ info ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  Sjs_get info "n" ,(np)
  __Number_subtract__ np n ,(d)
  __Number_is_zero__ d ,(test__) __unless__ test__ (,() Wx_fail cx) ,()
  __Dict_lookup_or__ cx "callees" __print_exit_error__ ,(callees)
  __Ref_get__ callees ,(cs)
  __LList_cons__ nm cs ,(cs)
  __Ref_set__ callees cs ,()
  Sjs_get info "label" ,(label)
  Cat5 "(call " label " " ac ")")

;; この関数が Math を使う（(( )) では、呼ぶときに Math のメンバーを確かめる）
(define Wx_uses_math ,(cx)
  __Dict_lookup_or__ cx "usesMath" __print_exit_error__ ,(r)
  __Ref_set__ r __TRUE__)

;; 引数（どれも数の式）の WAT と数
(define Wx_args ,(cx args acc)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  __is_null__ args ,(test__) __if__ test__ (,() return acc zero) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_t a ,(at)
  __String_equal__ at "spread" ,(test__) __if__ test__ (,() Wx_fail cx) ,()
  Wx_num_expr cx a ,(c)
  Cat3 acc c " " ,(acc)
  Wx_args cx rest acc ,(acc n)
  Wx_num "1" ,(one)
  __Number_add__ n one ,(n)
  __NULL__ acc n)

;; Math の関数
(define Wx_math ,(cx name args)
  __Cont_get__ ,(return)
  Wx_num "0" ,(zero)
  Wx_length args zero ,(n)
  Wx_num "1" ,(one)
  __Number_subtract__ n one ,(d)
  __Number_is_zero__ d ,(single)
  Sjs_in_words name "floor ceil trunc abs sqrt" ,(test__) __if__ test__
    (,()
      __unless__ single (,() Wx_fail cx) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Cat5 "(f64." name " " ac ")" ,(c)
      return c) ,()
  Sjs_in_words name "round sign" ,(test__) __if__ test__
    (,()
      __unless__ single (,() Wx_fail cx) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Cat5 "(call $__" name " " ac ")" ,(c)
      return c) ,()
  Sjs_in_words name "max min" ,(test__) __if__ test__
    (,()
      __is_null__ args ,(test__) __if__ test__
        (,() __String_equal__ name "max" ,(isMax) __if_then_else__ isMax (,() __NULL__ "(f64.const -inf)") (,() __NULL__ "(f64.const inf)") ,(c) return c) ,()
      __LList_uncons__ __print_exit_error__ args ,(a rest)
      Wx_num_expr cx a ,(ac)
      Wx_fold cx name rest ac ,(c)
      return c) ,()
  Wx_fail cx)

(define Wx_fold ,(cx name args acc)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Wx_num_expr cx a ,(ac)
  Cat5 "(f64." name " " acc " " ,(acc)
  Cat3 acc ac ")" ,(acc)
  Wx_fold cx name rest acc)

;; ── モジュール ──

;; 呼ぶ関数が数の関数でなくなった関数を、変わらなくなるまで外す
(define Wx_fixpoint ,(E infos)
  __Ref_new__ __FALSE__ ,(changed)
  Wx_fixpoint_pass E infos changed ,()
  __Ref_get__ changed ,(again)
  __if_then_else__ again (,() Wx_fixpoint E infos) (,() __nop__))

(define Wx_fixpoint_pass ,(E infos changed)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      Sjs_get info "callees" ,(cs)
      Wx_all_ok E cs ,(test__)
      __unless__ test__ (,() __Dict_put__ info "ok" __FALSE__ ,() __Ref_set__ changed __TRUE__) ,()) ,()
  Wx_fixpoint_pass E rest changed)

(define Wx_all_ok ,(E names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "ok" ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Wx_all_ok E rest)

;; (( )) の数の関数の fn に、呼ぶときに確かめる名前（呼ぶ数の関数を、呼ぶものの呼ぶものまでたどった名前）と、
;; そのどれかが Math を使うかを付ける
(define Wx_mark_checks ,(E infos)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      __Dict_new__ ,(seen)
      Sjs_get info "callees" ,(cs)
      Wx_reach E cs seen ,()
      Sjs_get info "math" ,(m0)
      __Ref_new__ m0 ,(mathRef)
      __Dict_keys__ seen ,(keys)
      __Ref_new__ __NULL__ ,(acc)
      Gen_collect acc ,(sink)
      keys sink ,(sk)
      __Ref_get__ acc ,(names)
      Wx_names_text E names "" mathRef ,(text)
      __Ref_get__ mathRef ,(usesMath)
      Sjs_get info "fn" ,(fn)
      __Dict_put__ fn "wasmCheck" text ,()
      __Dict_put__ fn "wasmMath" usesMath) ,()
  Wx_mark_checks E rest)

(define Wx_reach ,(E names seen)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ seen nm (,(k) __NULL__ __FALSE__) ,(was)
  __if__ was (,() Wx_reach E rest seen ,() return) ,()
  __Dict_put__ seen nm __TRUE__ ,()
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "callees" ,(cs)
  Wx_reach E cs seen ,()
  Wx_reach E rest seen)

;; 名前を空白で区切った文字列。どれかが Math を使えば mathRef を真にする
(define Wx_names_text ,(E names acc mathRef)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ E "funcs" __print_exit_error__ ,(funcs)
  __Dict_lookup_or__ funcs nm __print_exit_error__ ,(info)
  Sjs_get info "math" ,(m)
  __if__ m (,() __Ref_set__ mathRef __TRUE__) ,()
  Cat3 acc nm " " ,(acc)
  Wx_names_text E rest acc mathRef)

;; 数の関数のモジュールの WAT（なければ ""）。数の関数の fn に "wasm" を付ける
(define Wx_module ,(infos)
  Wx_funcs infos "" ,(fs)
  __String_equal__ fs "" ,(none)
  __if_then_else__ none (,() __NULL__ "") (,() Wx_helpers ,(h) Cat4 "(module " h fs ")"))

(define Wx_funcs ,(infos acc)
  __Cont_get__ ,(return)
  __is_null__ infos ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ infos ,(info rest)
  Sjs_get info "ok" ,(ok)
  __if__ ok
    (,()
      Sjs_get info "fn" ,(fn)
      Sjs_get info "name" ,(name)
      __Dict_put__ fn "wasm" name ,()
      Sjs_get info "n" ,(n)
      __Dict_put__ fn "wasmParams" n) ,()
  __if_then_else__ ok (,() Sjs_get info "wat" ,(w) __String_concat__ acc w) (,() __NULL__ acc) ,(acc)
  Wx_funcs rest acc)

;; 補助の関数（sjs_rt.se の Sjs_mod、ToUint32、Sjs_round、Math.sign と同じ手順）
(define Wx_helpers ,()
  Cat5
    "(func $__mod (param $a f64) (param $b f64) (result f64) (local $r f64) (if (i32.or (f64.eq (local.get $b) (f64.const 0)) (f64.ne (local.get $b) (local.get $b))) (then (return (f64.const nan)))) (if (f64.eq (local.get $a) (f64.const 0)) (then (return (local.get $a)))) (if (f64.eq (f64.abs (local.get $b)) (f64.const inf)) (then (return (select (local.get $a) (f64.const nan) (f64.eq (f64.sub (local.get $a) (local.get $a)) (f64.const 0)))))) (local.set $r (f64.sub (local.get $a) (f64.mul (local.get $b) (f64.trunc (f64.div (local.get $a) (local.get $b)))))) (if (result f64) (f64.eq (local.get $r) (f64.const 0)) (then (f64.copysign (f64.const 0) (local.get $a))) (else (local.get $r)))) "
    "(func $__u32 (param $x f64) (result f64) (if (f64.ne (f64.sub (local.get $x) (local.get $x)) (f64.const 0)) (then (return (f64.const 0)))) (local.set $x (f64.trunc (local.get $x))) (f64.sub (local.get $x) (f64.mul (f64.const 4294967296) (f64.floor (f64.div (local.get $x) (f64.const 4294967296)))))) "
    "(func $__round (param $x f64) (result f64) (local $r f64) (if (f64.ne (f64.sub (local.get $x) (local.get $x)) (f64.const 0)) (then (return (local.get $x)))) (local.set $r (f64.floor (local.get $x))) (if (f64.ge (f64.sub (local.get $x) (local.get $r)) (f64.const 0.5)) (then (local.set $r (f64.add (local.get $r) (f64.const 1))))) (if (result f64) (f64.eq (local.get $r) (f64.const 0)) (then (f64.copysign (f64.const 0) (local.get $x))) (else (local.get $r)))) "
    "(func $__sign (param $x f64) (result f64) (if (f64.gt (local.get $x) (f64.const 0)) (then (return (f64.const 1)))) (if (f64.lt (local.get $x) (f64.const 0)) (then (return (f64.const -1)))) (local.get $x)) "
    "")
