  __String_equal__ t "expr" ,(test__) __if__ test__ (,() Sjs_get s "expr" ,(e) Wy_effect F e ,() return) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,() __Dict_lookup_or__ s "value" (,(k) __NULL__ __NULL__) ,(v) __is_null__ v ,(none) __unless__ none (,() Wy_expr F v ,(b k) Wy_num F b k) ,() return) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__ (,() Sjs_get s "decls" ,(ds) Wy_decls F ds ,() return) ,()
