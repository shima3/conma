;; ConSh の語の展開（PLAN-ja.md の 1.2 と 1.3）。consh_parse --expand と同じ規則に従う。
;;
;; 語を展開した結果は、語の候補の LList（alts）になる。LazyList の値は、ほかの語要素との直積になる。
;;   quoted : 引用符を含む語か。引用符のない語が空になれば消す
;;   isList : LazyList の値を含むか。変数定義の右辺なら、値を LazyList にする
;; コマンド置換と glob はまだない。
(include "consh_util.se")
(include "consh_ast.se")

;; コマンドの語として展開した String の LList。引用符のない空の語は消す
(define Expand_fields ,(sh word)
  Expand_word sh word ,(alts quoted isList)
  __if_then_else__ (,() __NULL__ quoted)
    (,() __NULL__ alts)
    (,() Expand_drop_empty alts))

(define Expand_drop_empty ,(alts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ alts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ alts ,(head tail)
  Expand_drop_empty tail ,(rest)
  __if_then_else__ (,() __String_equal__ head "")
    (,() __NULL__ rest)
    (,() __LList_cons__ head rest))

;; 変数定義の右辺として展開した値。LazyList の値を含めば LazyList、そうでなければ String
(define Expand_value ,(sh word)
  Expand_word sh word ,(alts quoted isList)
  __if_then_else__ (,() __NULL__ isList)
    (,() LazyList_fromList alts)
    (,() __LList_uncons__ __print_exit_error__ alts ,(head tail) __NULL__ head))

;; 語の節を展開し、alts quoted isList を返す
(define Expand_word ,(sh word)
  Node_split word ,(tag pos elems)
  __LList_cons__ "" __NULL__ ,(alts)
  Expand_elems sh elems alts __FALSE__ __FALSE__)

(define Expand_elems ,(sh elems alts quoted isList)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) (,() return alts quoted isList) ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Node_split elem ,(kind pos children)
  List_first children ,(value)
  __String_equal__ kind "sq" ,(isSq)
  __String_equal__ kind "dq" ,(isDq)
  __String_equal__ kind "var" ,(isVar)
  __String_equal__ kind "subst" ,(isSubst)
  __or__ isSq isDq ,(isQuote)
  __or__ quoted isQuote ,(quoted)
  __if_then_else__ (,() __NULL__ isDq)
    (,()
      Expand_dq sh children ,(strs many)
      __NULL__ strs many) (,()
  __if_then_else__ (,() __NULL__ isVar)
    (,()
      Sh_lookup sh pos value ,(v)
      Value_options v) (,()
  __if_then_else__ (,() __NULL__ isSubst)
    (,() Sh_error sh pos "command substitution is not implemented yet")
    (,()
      __LList_cons__ value __NULL__ ,(opts)
      __NULL__ opts __FALSE__))) ,(opts many)
  __or__ isList many ,(isList)
  Product alts opts ,(alts)
  Expand_elems sh rest alts quoted isList)

;; 変数の値を、直積の選択肢の LList にする。LazyList なら、その要素
(define Value_options ,(v)
  __type_name__ v ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,()
      __LList_cons__ v __NULL__ ,(opts)
      __NULL__ opts __FALSE__)
    (,()
      List_fromLazyList v ,(opts)
      __NULL__ opts __TRUE__))

;; "..." の中身を展開し、String の LList と、$@ を含むかを返す。$@ だけは要素ごとに別の語になる
(define Expand_dq ,(sh elems)
  __LList_cons__ "" __NULL__ ,(strs)
  Expand_dq_elems sh elems strs __FALSE__)

(define Expand_dq_elems ,(sh elems strs many)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) (,() return strs many) ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Node_split elem ,(kind pos children)
  List_first children ,(value)
  __String_equal__ kind "var" ,(isVar)
  __String_equal__ kind "subst" ,(isSubst)
  __if_then_else__ (,() __NULL__ isSubst)
    (,() Sh_error sh pos "command substitution is not implemented yet") (,()
  __if_then_else__ (,() __NULL__ isVar)
    (,()
      __if_then_else__ (,() __String_equal__ value "@")
        (,()
          Sh_args sh pos ,(args)
          __NULL__ args __TRUE__)
        (,()
          Sh_lookup sh pos value ,(v)
          Value_toString v ,(s)
          __LList_cons__ s __NULL__ ,(opts)
          __NULL__ opts __FALSE__))
    (,()
      __LList_cons__ value __NULL__ ,(opts)
      __NULL__ opts __FALSE__)) ,(opts isAt)
  __or__ many isAt ,(many)
  Product strs opts ,(strs)
  Expand_dq_elems sh rest strs many)

;; alts の各候補の後ろに opts の各選択肢をつないだ LList。候補ごとに、選択肢の順に並べる
(define Product ,(alts opts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ alts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ alts ,(alt rest)
  Product_prefix alt opts ,(front)
  Product rest opts ,(back)
  List_append front back)

(define Product_prefix ,(alt opts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ opts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ opts ,(opt rest)
  __String_concat__ alt opt ,(s)
  Product_prefix alt rest ,(tail)
  __LList_cons__ s tail)

;; 値を1つの String にする。LazyList は、要素を改行で区切って連結し、末尾には付けない
(define Value_toString ,(v)
  __type_name__ v ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() __NULL__ v)
    (,()
      List_fromLazyList v ,(list)
      List_join list "\n"))
