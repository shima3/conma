;; ConSh の語の展開（PLAN-ja.md の 1.2 と 1.3）。consh_parse --expand と同じ規則に従う。
;;
;; 語は、語要素ごとの部分（Part）の LList に分けてから展開する。部分は (種類 値) の LList で、種類は次のどれか。
;;   "plain"  引用符のない String
;;   "quoted" 引用符の中の String
;;   "braced" ${x} の String の値。外部コマンド以外には、空文字列でも1つの語として渡す
;;   "leaves" $x の LazyList の値。葉ごとの語になる
;;   "list"   ${x} の LazyList の値。外部コマンド以外には値のまま渡す（段階 3）
;; 値は String か LazyList で、LazyList の要素も String か LazyList（入れ子）。
;; 葉は、入れ子の LazyList を再帰的にたどったときの String の要素である。
;; コマンドの語は、外部コマンドの語（Expand_fields）か、外部コマンド以外の語（Expand_args）として展開する。
;; glob はまだない。
;;
;; 外部コマンドの語を展開するときは、引数のバイト数の上限（limit、consh_eval.se の Arg_limit_new）を渡す。
;; 葉を1つ作るたびに、その文字数 + 1 を limit から引き、足りなくなれば展開の途中でエラーにする。
;; 文字数は UTF-8 のバイト数以下で、葉は語のどれかに含まれるので、引く数は実際のバイト数を超えない。
;; そのため、無限の LazyList を外部コマンドの引数に展開しても止まる。正確なバイト数は起動の前に調べる（Arg_check）
(include "consh_util.se")
(include "consh_ast.se")

;; ── 外部コマンドの語 ──

;; 外部コマンドの語として展開した String の LList。
;; LazyList を含まない引用符のない語が空になれば消す。LazyList の葉は、空文字列でも語として残す
(define Expand_fields ,(sh word)
  Expand_fields_in sh word __NULL__)

;; 外部コマンドの引数の語として展開する。limit が null でなければ、葉ごとに引数のバイト数の上限から引く
(define Expand_fields_in ,(sh word limit)
  Expand_parts sh word ,(parts)
  Parts_fields_in parts limit)

(define Parts_fields ,(parts)
  Parts_fields_in parts __NULL__)

(define Parts_fields_in ,(parts limit)
  __LList_cons__ "" __NULL__ ,(alts)
  Expand_fields_from parts alts __FALSE__ __FALSE__ limit)

(define Expand_fields_from ,(parts alts quoted hasList limit)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ parts)
    (,()
      __or__ quoted hasList ,(keep)
      __if__ (,() __NULL__ keep) (,() return alts) ,()
      Expand_drop_empty alts ,(alts)
      return alts) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  Part_split part ,(kind value)
  __String_equal__ kind "quoted" ,(isQuoted)
  Part_is_list kind ,(isList)
  __or__ quoted isQuoted ,(quoted)
  __or__ hasList isList ,(hasList)
  Part_options_in part limit ,(opts)
  Product alts opts ,(alts)
  Expand_fields_from rest alts quoted hasList limit)

(define Expand_drop_empty ,(alts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ alts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ alts ,(head tail)
  Expand_drop_empty tail ,(rest)
  __if_then_else__ (,() __String_equal__ head "")
    (,() __NULL__ rest)
    (,() __LList_cons__ head rest))

;; ── 外部コマンド以外の語 ──

;; 外部コマンド以外（関数と組み込みコマンド）の語として展開した値の LList。
;; $x の LazyList を含めば、葉ごとの String。そうでなく ${x} の LazyList を含めば、1つの LazyList。
;; どちらも含まなければ、引用符か ${x} を含む語は1つの String。それ以外は、空になれば消える
(define Expand_args ,(sh word)
  __Cont_get__ ,(return)
  Expand_parts sh word ,(parts)
  Parts_count parts "leaves" ,(nLeaves)
  __unless__ (,() __Number_is_zero__ nLeaves) (,() Parts_fields parts ,(fields) return fields) ,()
  Parts_count parts "list" ,(nList)
  __unless__ (,() __Number_is_zero__ nList)
    (,()
      Parts_list_value parts nList ,(value)
      __LList_cons__ value __NULL__ ,(values)
      return values) ,()
  Parts_count parts "quoted" ,(nQuoted)
  Parts_count parts "braced" ,(nBraced)
  __Number_add__ nQuoted nBraced ,(n)
  __if__ (,() __Number_is_zero__ n) (,() Parts_fields parts ,(fields) return fields) ,()
  Parts_concat parts ,(s)
  __LList_cons__ s __NULL__)

;; ── 変数定義の右辺 ──

;; 変数定義の右辺の値。values は値の節（語か array）の LList で、空なら空文字列
(define Expand_def_value ,(sh values)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ values) (,() return "") ,()
  __LList_uncons__ __print_exit_error__ values ,(v others)
  Node_split v ,(tag pos children)
  __if__ (,() __String_equal__ tag "array")
    (,()
      Expand_array sh children ,(fields)
      LazyList_fromList fields ,(list)
      return list) ,()
  Expand_value sh v)

;; (語 ...) の各語を外部コマンドの語として展開した String の LList
(define Expand_array ,(sh words)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  Expand_fields sh word ,(fields)
  Expand_array sh rest ,(more)
  List_append fields more)

;; 変数定義の右辺の語の値。
;; $x の LazyList を含めば、葉の語が1つならその String、なければ空文字列、2つ以上ならエラー。
;; そうでなく ${x} の LazyList を含めば LazyList。どちらでもなければ String
(define Expand_value ,(sh word)
  __Cont_get__ ,(return)
  Node_split word ,(tag pos elems)
  Expand_parts sh word ,(parts)
  Parts_count parts "leaves" ,(nLeaves)
  Parts_count parts "list" ,(nList)
  __unless__ (,() __Number_is_zero__ nLeaves)
    (,()
      __LList_cons__ "" __NULL__ ,(alts)
      Parts_product parts alts ,(alts)
      __if__ (,() __is_null__ alts) (,() return "") ,()
      __LList_uncons__ __print_exit_error__ alts ,(first others)
      __unless__ (,() __is_null__ others)
        (,()
          List_length alts ,(n)
          __Number_toString__ n ,(s)
          __String_concat__ s " words in a variable definition" ,(msg)
          Sh_error sh pos msg) ,()
      return first) ,()
  __if__ (,() __Number_is_zero__ nList)
    (,()
      Parts_concat parts ,(s)
      return s) ,()
  Parts_list_value parts nList)

;; ${x} の LazyList を nList 個含む部分の値。1つなら、前後の String を葉に付けた LazyList。
;; 2つ以上なら、葉の直積の LazyList
(define Parts_list_value ,(parts nList)
  __Cont_get__ ,(return)
  num "1" ,(one)
  __Number_subtract__ nList one ,(more)
  __if__ (,() __Number_is_zero__ more)
    (,()
      Parts_affix parts "" ,(value)
      return value) ,()
  __LList_cons__ "" __NULL__ ,(alts)
  Parts_product parts alts ,(alts)
  LazyList_fromList alts)

;; ── 語の部分 ──

(define Part_make ,(kind value)
  __LList_cons__ value __NULL__ ,(tail)
  __LList_cons__ kind tail)

(define Part_split ,(part)
  __LList_uncons__ __print_exit_error__ part ,(kind rest)
  List_first rest ,(value)
  __NULL__ kind value)

(define Part_is_list ,(kind)
  __String_equal__ kind "leaves" ,(isLeaves)
  __String_equal__ kind "list" ,(isList)
  __or__ isLeaves isList)

;; 部分が語にもたらす String の選択肢の LList。LazyList なら葉
(define Part_options ,(part)
  Part_options_in part __NULL__)

(define Part_options_in ,(part limit)
  Part_split part ,(kind value)
  Part_is_list kind ,(isList)
  __if_then_else__ (,() __NULL__ isList)
    (,() Value_leaves_in value limit)
    (,() __LList_cons__ value __NULL__))

;; 語の節を部分の LList にする
(define Expand_parts ,(sh word)
  Node_split word ,(tag pos elems)
  Expand_parts_from sh elems)

(define Expand_parts_from ,(sh elems)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Expand_part sh elem ,(part)
  Expand_parts_from sh rest ,(parts)
  __LList_cons__ part parts)

(define Expand_part ,(sh elem)
  __Cont_get__ ,(return)
  Node_split elem ,(kind pos children)
  List_first children ,(text)
  __if__ (,() __String_equal__ kind "lit") (,() Part_make "plain" text ,(part) return part) ,()
  __String_equal__ kind "esc" ,(isEsc)
  __String_equal__ kind "sq" ,(isSq)
  __or__ isEsc isSq ,(isQuoted)
  __if__ (,() __NULL__ isQuoted) (,() Part_make "quoted" text ,(part) return part) ,()
  __if__ (,() __String_equal__ kind "dq")
    (,()
      Expand_dq sh children ,(s)
      Part_make "quoted" s ,(part)
      return part) ,()
  Expand_ref sh elem ,(value)
  __type_name__ value ,(type)
  __String_equal__ kind "var" ,(isVar)
  __if__ (,() __String_equal__ type "String")
    (,()
      __if_then_else__ (,() __NULL__ isVar)
        (,() Part_make "plain" value)
        (,() Part_make "braced" value) ,(part)
      return part) ,()
  __if_then_else__ (,() __NULL__ isVar)
    (,() Part_make "leaves" value)
    (,() Part_make "list" value))

;; 変数参照かコマンド置換の値。${x-値} は、x が未定義のときだけ値を作る
(define Expand_ref ,(sh elem)
  __Cont_get__ ,(return)
  Node_split elem ,(kind pos children)
  __if__ (,() __String_equal__ kind "subst")
    (,()
      List_first children ,(script)
      Eval_subst sh pos script ,(value)
      return value) ,()
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __if__ (,() __is_null__ rest) (,() Sh_lookup sh pos name ,(value) return value) ,()
  Sh_defined sh pos name ,(defined)
  __if__ (,() __NULL__ defined) (,() Sh_lookup sh pos name ,(value) return value) ,()
  __LList_uncons__ __print_exit_error__ rest ,(default others)
  Node_split default ,(dtag dpos values)
  Expand_def_value sh values)

;; "..." の中身を1つの String にする。LazyList の値は文字列化する
(define Expand_dq ,(sh elems)
  Expand_dq_from sh elems "")

(define Expand_dq_from ,(sh elems acc)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Node_split elem ,(kind pos children)
  __if_then_else__ (,() __String_equal__ kind "lit")
    (,() List_first children)
    (,()
      Expand_ref sh elem ,(value)
      Value_toString sh pos value) ,(s)
  __String_concat__ acc s ,(acc)
  Expand_dq_from sh rest acc)

;; ── 部分の LList の操作 ──

;; 種類が kind の部分の数
(define Parts_count ,(parts kind)
  num "0" ,(zero)
  Parts_count_from parts kind zero)

(define Parts_count_from ,(parts kind n)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ parts) (,() return n) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  Part_split part ,(k v)
  __if_then_else__ (,() __String_equal__ k kind)
    (,()
      num "1" ,(one)
      __Number_add__ n one)
    (,() __NULL__ n) ,(n)
  Parts_count_from rest kind n)

;; alts の各候補の後ろに、部分の選択肢を順に直積でつないだ String の LList
(define Parts_product ,(parts alts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ parts) (,() return alts) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  Part_options part ,(opts)
  Product alts opts ,(alts)
  Parts_product rest alts)

;; String だけの部分を連結した String
(define Parts_concat ,(parts)
  Parts_concat_from parts "")

(define Parts_concat_from ,(parts acc)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ parts) (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  Part_split part ,(k v)
  __String_concat__ acc v ,(acc)
  Parts_concat_from rest acc)

;; LazyList の部分が1つだけのとき、その前後の String を、入れ子の形を保ったまま葉に付けた値
(define Parts_affix ,(parts left)
  __LList_uncons__ __print_exit_error__ parts ,(part rest)
  Part_split part ,(k v)
  __if_then_else__ (,() __String_equal__ k "list")
    (,()
      Parts_concat rest ,(right)
      Value_affix v left right)
    (,()
      __String_concat__ left v ,(left)
      Parts_affix rest left))

;; alts の各候補の後ろに opts の各選択肢をつないだ LList。候補ごとに、選択肢の順に並べる
(define Product ,(alts opts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ alts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ alts ,(alt rest)
  Product_prefix alt opts ,(front)
  Product rest opts ,(back)
  List_append front back)

(define Product_prefix ,(alt opts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ opts) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ opts ,(opt rest)
  __String_concat__ alt opt ,(s)
  Product_prefix alt rest ,(tail)
  __LList_cons__ s tail)

;; ── 値 ──

;; 値の葉の LList
(define Value_leaves ,(v)
  Value_leaves_in v __NULL__)

;; limit が null でなければ、葉を1つ作るたびに引数のバイト数の上限から引く。
;; LazyList は要素を1つずつ取り出しながらたどるので、無限の LazyList でも上限を超えたところで止まる
(define Value_leaves_in ,(v limit)
  __Cont_get__ ,(return)
  __type_name__ v ,(type)
  __if__ (,() __String_equal__ type "String")
    (,()
      Arg_charge limit v ,()
      __LList_cons__ v __NULL__ ,(leaves)
      return leaves) ,()
  Value_leaves_lazy v limit)

(define Value_leaves_lazy ,(list limit)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return __NULL__) list ,(item rest)
  Value_leaves_in item limit ,(front)
  Value_leaves_lazy rest limit ,(back)
  List_append front back)

;; 葉 s の文字数 + 1（NUL）を、引数のバイト数の上限 limit の残りから引く。足りなければ limit の "onOver" を呼ぶ
(define Arg_charge ,(limit s)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ limit) return ,()
  __String_length__ s ,(n)
  num "1" ,(one)
  __Number_add__ n one ,(n)
  Sh_get limit "left" ,(left)
  __Number_subtract__ left n ,(left)
  __if__ (,() __Number_is_negative__ left)
    (,()
      Sh_get limit "onOver" ,(onOver)
      onOver) ,()
  __Dict_put__ limit "left" left)

;; 値の各葉の前に left、後ろに right を付けた値。入れ子の形は保つ
;; 前後に付ける文字列がなければ、LazyList を取り出さずにそのまま返す（遅延のまま）
(define Value_affix ,(v left right)
  __Cont_get__ ,(return)
  __String_equal__ left "" ,(noLeft)
  __String_equal__ right "" ,(noRight)
  __and__ noLeft noRight ,(none)
  __if__ (,() __NULL__ none) (,() return v) ,()
  __type_name__ v ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,()
      __String_concat__ left v ,(s)
      __String_concat__ s right)
    (,()
      List_fromLazyList v ,(items)
      Value_affix_list items left right ,(items)
      LazyList_fromList items))

(define Value_affix_list ,(items left right)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ items) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  Value_affix item left right ,(item)
  Value_affix_list rest left right ,(rest)
  __LList_cons__ item rest)

;; 値の LList の葉を、順につないだ LList
(define Values_leaves ,(values)
  Values_leaves_in values __NULL__)

(define Values_leaves_in ,(values limit)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ values) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ values ,(v rest)
  Value_leaves_in v limit ,(front)
  Values_leaves_in rest limit ,(back)
  List_append front back)

;; 値の LList の各値を String にした LList
(define Values_strings ,(sh pos values)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ values) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ values ,(v rest)
  Value_toString sh pos v ,(s)
  Values_strings sh pos rest ,(more)
  __LList_cons__ s more)

;; 先頭の語の LazyList から、コマンドの名前と、残りの値の LList を取り出す。
;; 先頭の要素だけを再帰的に展開し、残りの要素は LazyList でも1つの値にする。
;; 例えば ((a (b c)) d) なら、名前は a、残りの値は (b c) と d。空の LazyList があればエラー
(define Value_head ,(sh pos v)
  __LazyList_uncons__ (,() Sh_error sh pos "the command name is an empty LazyList") v ,(head tail)
  List_fromLazyList tail ,(rest)
  __type_name__ head ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() __NULL__ head rest)
    (,()
      Value_head sh pos head ,(name inner)
      List_append inner rest ,(more)
      __NULL__ name more))

;; 値を1つの String にする。LazyList は、葉を OFS で区切って連結し、末尾には付けない
(define Value_toString ,(sh pos v)
  __Cont_get__ ,(return)
  __type_name__ v ,(type)
  __if__ (,() __String_equal__ type "String") (,() return v) ,()
  Sh_ofs sh pos ,(ofs)
  Value_leaves v ,(leaves)
  List_join leaves ofs)
