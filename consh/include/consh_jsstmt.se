;; JS の文（consh/js/PLAN-ja.md の 2.5）。JavaScript のある版（wasm 版の VM）では、先頭の語がコマンドでない文を
;; JavaScript のコードとして評価する（構文解析は consh_parser.se の Ps_js）。
;; コードに現れる名前のシェルの変数を、同じ名前の JavaScript の変数として渡し、コードが代入した変数を受け取る。
;; 文字列でない JavaScript の値は、シェルの変数に、その番号（オブジェクトと関数はホストの表の #n、プリミティブは
;; number:3 のような値そのもの）だけを入れ、$ で読むたびにホストに直してもらう（Js_store、Js_force）。
;; JS の値の変数は、値を作った __JS_call__ の outputStream（toHost）も持つ。VM は、この Stream が捨てられたら閉じるので
;; （vm/src/value.rs の drop_close）、どの変数も使わなくなった値を、ホストは表から消す。
;; consh_eval.se（参照版も）が include する

;; JS の文を使うか。JavaScript が使えて（Js_probe_host）、起動したときの環境変数 CONSH_ENABLE_JS が js のときだけ真。
;; ブラウザ版では、サーバの config.json の "CONSH_ENABLE_JS" を、ホストがこの変数に設定する（consh-core.js）
(define Js_probe ,()
  Js_state ,(state)
  __String_equal__ state "js")

;; JavaScript の状態（consh/js/PLAN-ja.md の 3.22）。CONSH_ENABLE_JS が
;;   js なら "js"（js、JS の文、算術評価 (( )) を使える）、sjs なら "sjs"（算術評価だけ）、
;;   ないかほかの値なら "off"（どれも使えない）。JavaScript がない版は "none"。
;; 環境変数は、シェルの export でなく、VM のプロセスのものを見るので、起動した後には変わらない
(define Js_state ,()
  __Cont_get__ ,(return)
  Js_probe_host ,(has)
  __unless__ has (,() return "none") ,()
  __OS_get_envDict__ ,(env)
  __Dict_lookup_or__ env "CONSH_ENABLE_JS" (,(key) return "off") ,(value)
  __String_equal__ value "js" ,(test__) __if__ test__ (,() return "js") ,()
  __String_equal__ value "sjs" ,(test__) __if__ test__ (,() return "sjs") ,()
  __NULL__ "off")

;; JavaScript が使えるか（__JS_call__ が onError に進まないか）。使えれば、"0" の結果を読み捨てる
(define Js_probe_host ,()
  __Cont_get__ ,(return)
  __JS_call__ (,(msg) return __FALSE__) "0" __NULL__ ,(stream toHost)
  __LazyList_lines__ stream ,(lines)
  Js_drain lines ,()
  __OS_close__ (,(msg) __nop__) stream ,()
  __OS_close__ (,(msg) __nop__) toHost ,()
  __NULL__ __TRUE__)

(define Js_drain ,(lines)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return) lines ,(line rest)
  Js_drain rest)

;; 構文解析の opts（Parse_file_with、Parse_text_with）。js は JavaScript が使えるか、funcs は定義されている関数の Dict か null
(define Js_parse_opts ,(js funcs)
  __Dict_new__ ,(opts)
  __Dict_put__ opts "js" js ,()
  __Dict_put__ opts "funcs" funcs ,()
  __NULL__ opts)

;; 文 (jsstmt 位置 コード 代わりのコマンド行 名前 ...)。ホストは、結果の前に、代入した変数ごとに
;; (w 名前 s 文字列) か (w 名前 j 番号) の行を書く。
;; コードが打ち間違えたコマンドに見えるときは、結果の代わりに (f メッセージ) を書くので、代わりのコマンド行を実行する
;; （なければメッセージを出す）。そのほかは js（Builtin_js）の変数名のない形と同じ
(define Eval_jsstmt ,(sh pos children)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ children ,(code rest)
  __LList_uncons__ __print_exit_error__ rest ,(fallback names)
  __Dict_lookup_or__ sh "in" __print_exit_error__ ,(in)
  __Dict_lookup_or__ sh "out" __print_exit_error__ ,(out)
  __Dict_lookup_or__ sh "err" __print_exit_error__ ,(err)
  __NULL__ (,(msg status)
    __String_concat__ "js: " msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh status ,()
    return) ,(fail)
  Js_stmt_vars sh pos names __NULL__ __NULL__ __NULL__ ,(ns ks vs)
  ;; JS の値を変数に入れたら、toHost を閉じずに、その変数に持たせる
  __Ref_new__ __FALSE__ ,(keptRef)
  __LList_cons__ vs __NULL__ ,(args)
  __LList_cons__ ks args ,(args)
  __LList_cons__ ns args ,(args)
  __String_concat__ "//@consh-stmt\n" code ,(code)
  __JS_call__ (,(msg) Msg_strip msg ,(msg) fail msg "127") code args ,(stream toHost)
  __Ref_new__ toHost ,(toHostRef)
  __LazyList_lines__ stream ,(lines)
  __NULL__ (,()
    __Ref_get__ keptRef ,(kept)
    Js_close_result kept stream toHostRef (,()
      __OS_close__ __print_exit_error__ stream ,()
      Js_input_close toHostRef)) ,(closeAll)
  Js_stmt_lines sh pos in out err toHostRef keptRef lines "vars" ,(result rest)
  __is_null__ result ,(test__) __if__ test__ (,() closeAll ,() fail "no result" "1") ,()
  __LList_uncons__ __print_exit_error__ result ,(tag fields)
  __String_equal__ tag "f" ,(test__) __if__ test__
    (,()
      closeAll ,()
      List_first fields ,(msg)
      __is_null__ fallback ,(test__) __if__ test__ (,() fail msg "1") ,()
      ;; CONSH_JS_DEBUG（シェルの変数か環境変数）が空でなければ、JavaScript のエラーも出す
      Js_debug sh pos msg ,()
      Eval_lines sh fallback ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ fields ,(kind fields)
  __String_equal__ tag "e" ,(test__) __if__ test__ (,() closeAll ,() fail kind "1") ,()
  __String_equal__ kind "t" ,(test__) __if__ test__
    (,()
      __Ref_get__ toHostRef ,(toHost)
      L2 stream toHost ,(opened)
      Open_track sh opened ,(mark)
      Js_iter_out sh pos in out err toHostRef rest ,(status msg)
      Open_release sh mark ,()
      __Ref_set__ toHostRef __NULL__ ,()
      __is_null__ msg ,(test__) __unless__ test__ (,() fail msg status) ,()
      Sh_set_status sh status ,()
      return) ,()
  closeAll ,()
  List_first fields ,(value)
  Js_output sh pos out kind value ,()
  Sh_set_status sh "0")

;; Js_lines と同じだが、(w ...) の行を読んで、文脈の key（"vars" か、SJS変数の "sjsvars"）の Dict に入れる。
;; JS の値を入れたら keptRef を真にする
(define Js_stmt_lines ,(sh pos in out err toHostRef keptRef lines key)
  __Cont_get__ ,(return)
  Js_lines sh pos in out err toHostRef lines ,(result rest)
  __is_null__ result ,(test__) __if__ test__ (,() return result rest) ,()
  __LList_uncons__ __print_exit_error__ result ,(tag fields)
  __String_equal__ tag "w" ,(test__) __unless__ test__ (,() return result rest) ,()
  __Ref_get__ toHostRef ,(handle)
  Js_store sh pos fields handle key ,(isJs)
  __if__ isJs (,() __Ref_set__ keptRef __TRUE__) ,()
  Js_stmt_lines sh pos in out err toHostRef keptRef rest key)

;; 結果を読み終えたとき。keep なら、結果の Stream だけを閉じ、toHost は変数に持たせたまま閉じない（toHostRef は空にする）。
;; そうでなければ closeAll
(define Js_close_result ,(keep stream toHostRef closeAll)
  __Cont_get__ ,(return)
  __unless__ keep (,() closeAll ,() return) ,()
  __OS_close__ __print_exit_error__ stream ,()
  __Ref_set__ toHostRef __NULL__)

;; (w 名前 s 文字列) なら String を、(w 名前 j 番号) なら JS の値を、文脈の key の Dict（局所変数の "vars" か、
;; SJS変数の "sjsvars"）の名前に入れる。JS の値なら真を返す。
;; JS の値は、"js" に番号、"handle" に値を作った呼び出しの toHost を入れた Dict で、Value_force が読むたびに Js_force で直す
(define Js_store ,(sh pos fields handle key)
  __LList_uncons__ __print_exit_error__ fields ,(name fields)
  __LList_uncons__ __print_exit_error__ fields ,(kind fields)
  List_first fields ,(data)
  __String_equal__ kind "s" ,(isString)
  __String_equal__ key "sjsvars" ,(isSjs)
  __if_then_else__ isString
    (,() __NULL__ data)
    (,() __if_then_else__ isSjs (,() Sjs_wrap data handle) (,() Js_wrap data handle)) ,(value)
  __Dict_lookup_or__ sh key __print_exit_error__ ,(vars)
  __Dict_put__ vars name value ,()
  __not__ isString)

;; JS の値の番号 id を入れた変数の値。handle は、値を作った呼び出しの toHost（捨てられたら閉じる）
(define Js_wrap ,(id handle)
  __Dict_new__ ,(wrapped)
  __Dict_put__ wrapped "js" id ,()
  __Dict_put__ wrapped "handle" handle ,()
  __NULL__ wrapped)

;; js 変数名= の結果を変数に入れる値（Js_value）。j なら JS の値（Js_wrap）
(define Js_value_kept ,(kind value handle)
  __Cont_get__ ,(return)
  __String_equal__ kind "j" ,(test__) __if__ test__ (,() Js_wrap value handle ,(v) return v) ,()
  Js_value kind value)

;; js 変数名= のコード。変数名があれば、結果を JS の値のまま受け取る印の行を前に付ける
(define Js_keep_code ,(name code)
  __Cont_get__ ,(return)
  __is_null__ name ,(test__) __if__ test__ (,() return code) ,()
  __String_concat__ "//@consh-keep\n" code)

;; JS の値の変数 wrapped を、シェルの値にする。プリミティブ（number:3、boolean:true、bigint:5、undefined、null）は
;; ここで直し、オブジェクトと関数（#n）は、その時点の値をホストに直してもらう（__JS_value__）。
;; s は String、l は LazyList、n は空文字列、f は、呼ぶと js でその関数を呼ぶ関数値
(define Js_force ,(wrapped)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ wrapped "js" __print_exit_error__ ,(id)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __String_substring__ __print_exit_error__ id zero one ,(first)
  __String_equal__ first "#" ,(test__) __unless__ test__
    (,()
      __String_find__ __print_exit_error__ id ":" zero ,(colon)
      __is_null__ colon ,(test__) __if__ test__ (,() return "") ,()
      __Number_add__ colon one ,(start)
      __String_length__ id ,(len)
      __String_substring__ __print_exit_error__ id start len ,(text)
      return text) ,()
  __JS_value__ __print_exit_error__ id ,(text)
  __Sexp_read__ __print_exit_error__ text ,(sexp)
  __LList_uncons__ __print_exit_error__ sexp ,(kind fields)
  __String_equal__ kind "f" ,(test__) __if__ test__
    (,()
      ;; SJS が作った関数は、SJS の規則で呼ぶ（Sjs_call。戻り値は標準エラー）
      __Dict_lookup_or__ wrapped "sjs" (,(key) __NULL__ __FALSE__) ,(isSjs)
      __if__ isSjs
        (,() return (,(caller pos args in out err)
          Js_hold wrapped ,()
          Sjs_call caller pos wrapped args in out err)) ,()
      __String_concat__ "__consh_value(\"" id ,(code)
      __String_concat__ code "\")" ,(code)
      ;; 関数値は wrapped を持つ（その間、ホストは値を消さない）
      return (,(caller pos args in out err)
        Js_hold wrapped ,()
        __LList_cons__ code args ,(args)
        Builtin_js caller pos args in out err)) ,()
  __is_null__ fields ,(test__) __if__ test__ (,() return "") ,()
  List_first fields ,(value)
  Js_value kind value)

;; JavaScript に渡す変数：names のうち局所変数にあるものの、名前、種類、値の LList。
;; 種類は j（JS の値。値はホストの表の番号）、s（String）、l（リスト。LazyList は要素の LList にする）。
;; 関数値の変数と、JavaScript の側の名前（stdin、args）は渡さない
(define Js_stmt_vars ,(sh pos names ns ks vs)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return ns ks vs) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __NULL__ (,() Js_stmt_vars sh pos rest ns ks vs ,(ns ks vs) return ns ks vs) ,(skip)
  __String_equal__ name "stdin" ,(test__) __if__ test__ skip ,()
  __String_equal__ name "args" ,(test__) __if__ test__ skip ,()
  __Dict_lookup_or__ sh "vars" __print_exit_error__ ,(vars)
  __Dict_lookup_or__ vars name (,(key) skip) ,(raw)
  __NULL__ (,(kind value)
    __LList_cons__ name ns ,(ns)
    __LList_cons__ kind ks ,(ks)
    __LList_cons__ value vs ,(vs)
    Js_stmt_vars sh pos rest ns ks vs ,(ns ks vs)
    return ns ks vs) ,(add)
  __type_name__ raw ,(type)
  __String_equal__ type "Dict" ,(isDict)
  __if__ isDict
    (,()
      __Dict_lookup_or__ raw "js" (,(key) __NULL__ __NULL__) ,(id)
      __is_null__ id ,(test__) __unless__ test__ (,() add "j" id) ,()) ,()
  Value_force raw ,(value)
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(test__) __if__ test__ (,() add "s" value) ,()
  __String_equal__ type "Closure" ,(test__) __if__ test__ skip ,()
  Js_arg sh pos value ,(list)
  add "l" list)

;; 値を持っておくための、何もしない関数
(define Js_hold ,(value)
  __nop__)

;; JS の文をシェルの文として実行するとき、CONSH_JS_DEBUG が空でなければ、JavaScript としてのエラーを出す
(define Js_debug ,(sh pos msg)
  __Cont_get__ ,(return)
  Sh_defined sh pos "CONSH_JS_DEBUG" ,(defined)
  __unless__ defined return ,()
  Sh_lookup sh pos "CONSH_JS_DEBUG" ,(value)
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(test__) __if__ test__
    (,() __String_equal__ value "" ,(empty) __if__ empty return ,()) ,()
  __String_concat__ "js: " msg ,(m)
  __String_concat__ m " (run as a shell statement)" ,(m)
  Sh_warn sh pos m)

;; ── SJS：算術評価 (( )) と算術置換 $(( ))（consh/SAFEJS-PLAN-ja.md の 2）──
;; SJS式は、当面（段階 A）ホストの JavaScript で評価する。ホストは、コードが SJS の範囲（SAFEJS-PLAN-ja.md の 3）に
;; あるかを確かめてから、SJS変数だけを大域の名前として評価する（conma.js の evaluateSjs）。
;; SJS変数は、文脈の "sjsvars" の Dict に、局所変数（"vars"）と同じ形の値（String か、JS の値の Dict）で置き、
;; 局所変数と同じ所で写す（Ctx_top、Func_make、Func_call、Sh_child の Sjs_copy_into）

;; to の "sjsvars" に、from の "sjsvars" の写しを入れる（from になければ空の Dict）
(define Sjs_copy_into ,(from to)
  __Dict_lookup_or__ from "sjsvars" (,(key) __Dict_new__) ,(vars)
  __Dict_copy__ vars ,(vars)
  __Dict_put__ to "sjsvars" vars)

;; 文の算術評価 (arith 位置 コード (names 位置 名前 ...) [(redirs …)])。値は出さず、エラーなら $? を 2、
;; そうでなければ値の JavaScript の真偽で、真なら 0、偽なら 1 にする（SAFEJS-PLAN-ja.md の 2.2 の 1）
(define Eval_arith ,(sh pos children)
  __LList_uncons__ __print_exit_error__ children ,(code rest)
  __LList_uncons__ __print_exit_error__ rest ,(namesNode rest)
  __is_null__ rest ,(test__) __if_then_else__ test__
    (,() __NULL__ __NULL__)
    (,() List_first rest ,(node) Node_split node ,(rtag rpos items) __NULL__ items) ,(redirs)
  Eval_redirected sh pos redirs (,(inner) Eval_arith_run inner pos code namesNode))

(define Eval_arith_run ,(sh pos code namesNode)
  __Cont_get__ ,(return)
  Sjs_eval sh pos code namesNode (,(msg)
    __String_concat__ "sjs: " msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh "2" ,()
    return) ,(value)
  Sjs_truthy value ,(truth)
  __if_then_else__ truth (,() __NULL__ "0") (,() __NULL__ "1") ,(status)
  Sh_set_status sh status)

;; 語の算術置換 (arithsubst 位置 コード (names 位置 名前 ...)) の値（String か、JS の値の Dict）。
;; エラーなら、文を止めて $? を 2 にする（Sjs_abort）
(define Sjs_subst ,(sh pos children)
  __LList_uncons__ __print_exit_error__ children ,(code rest)
  List_first rest ,(namesNode)
  Sjs_eval sh pos code namesNode (,(msg) Sjs_abort sh pos msg))

;; 算術置換のエラー。Sh_error と同じく止めるが、$? は 2。対話モードでなければ、ConSh を終了ステータス 2 で終える
(define Sjs_abort ,(sh pos msg)
  __String_concat__ "sjs: " msg ,(m)
  Sh_message sh pos m ,(s)
  __OS_print_error__ s ,()
  Sh_set_status sh "2" ,()
  __Dict_lookup_or__ sh "global" __print_exit_error__ ,(global)
  __Dict_lookup_or__ global "interactive" (,(key) __NULL__ __FALSE__) ,(interactive)
  __unless__ interactive
    (,()
      __Number_fromString__ __print_exit_error__ "2" ,(two)
      __OS_exit__ __print_exit_error__ two) ,()
  __Dict_lookup_or__ sh "exitTo" (,(key) __NULL__ __NULL__) ,(exitTo)
  __is_null__ exitTo ,(test__) __unless__ test__ exitTo ,()
  __Dict_lookup_or__ sh "recover" (,(key) __NULL__ __NULL__) ,(recover)
  __is_null__ recover ,(test__) __unless__ test__ recover ,()
  __OS_exit_error__)

;; SJS式 code を評価した値（String か、JS の値の Dict）。代入された SJS変数は "sjsvars" に入れる。
;; エラーなら fail にメッセージを渡す（fail は戻らない）
(define Sjs_eval ,(sh pos code namesNode fail)
  Node_split namesNode ,(ntag npos names)
  __String_concat__ "//@consh-sjs\n" code ,(code)
  __Dict_lookup_or__ sh "in" __print_exit_error__ ,(in)
  __Dict_lookup_or__ sh "out" __print_exit_error__ ,(out)
  __Dict_lookup_or__ sh "err" __print_exit_error__ ,(err)
  Sjs_run sh pos code names __NULL__ in out err fail)

;; ホストに code（//@consh-sjs か //@consh-sjscall で始まる）を渡して評価し、値（String か、JS の値の Dict）を返す。
;; ホストに渡す引数は、SJS変数の名前、種類、値の LList と、$名前 のシェル変数の名前、種類、値の LList の 6 つに、
;; extra（SJS関数の呼び出しの引数など）を続けたもの。names は、コードに現れる名前（$ で始まるものを登録する）。
;; エラーなら fail にメッセージを渡す（fail は戻らない）
(define Sjs_run ,(sh pos code names extra in out err fail)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ sh "global" __print_exit_error__ ,(global)
  __Dict_lookup_or__ global "jsState" __print_exit_error__ ,(state)
  __String_equal__ state "none" ,(test__) __if__ test__ (,() fail "JavaScript is not available") ,()
  __String_equal__ state "off" ,(test__) __if__ test__
    (,() fail "SJS is disabled (set CONSH_ENABLE_JS to sjs or js to enable it)") ,()
  ;; SJS変数は、コードに現れる名前だけでなく、すべて渡す。SJS関数の中の大域の名前は、呼び出した評価の SJS変数を読むので、
  ;; 呼び出すコード（$(( g() ))）に現れない名前も要る
  __Dict_lookup_or__ sh "sjsvars" __print_exit_error__ ,(sjsvars)
  __Dict_keys__ sjsvars ,(keys)
  List_fromSeq keys ,(sjsNames)
  Sjs_vars sh sjsNames __NULL__ __NULL__ __NULL__ ,(ns ks vs)
  ;; $名前 のシェル変数も、同じ理由で、これまでに評価したコードに現れたものをすべて渡す（Sjs_register）
  Sjs_register global names ,()
  __Dict_lookup_or__ global "sjsShellNames" __print_exit_error__ ,(registry)
  __Dict_keys__ registry ,(keys)
  List_fromSeq keys ,(shellNames)
  Sjs_shell_vars sh pos shellNames __NULL__ __NULL__ __NULL__ ,(sns sks svs)
  __LList_cons__ svs extra ,(args)
  __LList_cons__ sks args ,(args)
  __LList_cons__ sns args ,(args)
  __LList_cons__ vs args ,(args)
  __LList_cons__ ks args ,(args)
  __LList_cons__ ns args ,(args)
  __JS_call__ (,(msg) Msg_strip msg ,(msg) fail msg) code args ,(stream toHost)
  __Ref_new__ toHost ,(toHostRef)
  __Ref_new__ __FALSE__ ,(keptRef)
  __LazyList_lines__ stream ,(lines)
  Js_stmt_lines sh pos in out err toHostRef keptRef lines "sjsvars" ,(result rest)
  __NULL__ (,(keep)
    __Ref_get__ keptRef ,(kept)
    __or__ kept keep ,(keep)
    Js_close_result keep stream toHostRef (,()
      __OS_close__ __print_exit_error__ stream ,()
      Js_input_close toHostRef)) ,(finish)
  __is_null__ result ,(test__) __if__ test__ (,() finish __FALSE__ ,() fail "no result") ,()
  __LList_uncons__ __print_exit_error__ result ,(tag fields)
  __LList_uncons__ __print_exit_error__ fields ,(kind fields)
  __String_equal__ tag "e" ,(test__) __if__ test__ (,() finish __FALSE__ ,() fail kind) ,()
  List_first fields ,(data)
  __String_equal__ kind "s" ,(test__) __if__ test__ (,() finish __FALSE__ ,() return data) ,()
  __Ref_get__ toHostRef ,(handle)
  Sjs_wrap data handle ,(value)
  finish __TRUE__ ,()
  __NULL__ value)

;; SJS が作った JS の値。Js_wrap に "sjs" の印を付ける（関数なら、コマンドとして呼ぶと Sjs_call になる。Js_force）
(define Sjs_wrap ,(id handle)
  Js_wrap id handle ,(wrapped)
  __Dict_put__ wrapped "sjs" __TRUE__ ,()
  __NULL__ wrapped)

;; names のうち $ で始まる名前を、文脈の global の "sjsShellNames" に登録する。global の Dict は、VProc の文脈の写しでも
;; 同じ Dict を共有する（Sh_child は global を浅く写す）ので、パイプラインなどの中で登録した名前も見える
(define Sjs_register ,(global names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __Dict_lookup_or__ global "sjsShellNames" __print_exit_error__ ,(registry)
  Str_starts name "$" ,(isShell)
  __if__ isShell (,() __Dict_put__ registry name __TRUE__) ,()
  Sjs_register global rest)

;; $名前 のシェル変数（names は $ の付いた名前）のうち定義されているものの、名前（$ 付き）、種類、値の LList。
;; 種類は j（JS の値。値はホストの表の番号）、s（String）、l（リスト。要素の LList）。局所変数になければ環境変数を見る。
;; 関数値の変数は渡さない（SJS で読むと、定義されていないエラーになる）
(define Sjs_shell_vars ,(sh pos names ns ks vs)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return ns ks vs) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __NULL__ (,() Sjs_shell_vars sh pos rest ns ks vs ,(ns ks vs) return ns ks vs) ,(skip)
  __NULL__ (,(kind value)
    __LList_cons__ name ns ,(ns)
    __LList_cons__ kind ks ,(ks)
    __LList_cons__ value vs ,(vs)
    Sjs_shell_vars sh pos rest ns ks vs ,(ns ks vs)
    return ns ks vs) ,(add)
  __String_length__ name ,(len)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __String_substring__ __print_exit_error__ name one len ,(bare)
  __Dict_lookup_or__ sh "vars" __print_exit_error__ ,(vars)
  __Dict_lookup_or__ vars bare (,(key)
    __Dict_lookup_or__ sh "env" __print_exit_error__ ,(env)
    Env_lookup env key (,(key) skip) ,(text)
    add "s" text) ,(raw)
  __type_name__ raw ,(type)
  __String_equal__ type "Dict" ,(isDict)
  __if__ isDict
    (,()
      __Dict_lookup_or__ raw "js" (,(key) __NULL__ __NULL__) ,(id)
      __is_null__ id ,(test__) __unless__ test__ (,() add "j" id) ,()) ,()
  Value_force raw ,(value)
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(test__) __if__ test__ (,() add "s" value) ,()
  __String_equal__ type "Closure" ,(test__) __if__ test__ skip ,()
  Js_arg sh pos value ,(list)
  add "l" list)

;; SJS関数 wrapped を、シェルのコマンドとして引数 args で呼ぶ（consh/SAFEJS-PLAN-ja.md の 2.2 の 3）。
;; 戻り値は標準エラー err に出し（undefined と null は何も出さない）、$? は、エラーなら 2、そうでなければ戻り値の真偽
(define Sjs_call ,(sh pos wrapped args in out err)
  __Cont_get__ ,(return)
  __NULL__ (,(msg)
    __String_concat__ "sjs: " msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh "2" ,()
    return) ,(fail)
  Js_args sh pos args ,(list)
  __LList_cons__ list __NULL__ ,(extra)
  __Dict_lookup_or__ wrapped "js" __print_exit_error__ ,(id)
  __String_concat__ "//@consh-sjscall\n" id ,(code)
  Sjs_run sh pos code __NULL__ extra in out err fail ,(value)
  Sjs_truthy value ,(truth)
  Sjs_output sh pos err value ,()
  __if_then_else__ truth (,() __NULL__ "0") (,() __NULL__ "1") ,(status)
  Sh_set_status sh status)

;; コマンドの先頭の語の要素 elems（consh/SAFEJS-PLAN-ja.md の 2.2 の 3）。算術置換だけなら、評価して、関数ならその関数値
;; （Sjs_call で呼ぶ Closure）を返し、関数でなければエラーにする。SJS が作った JS の値を持つ変数（$f、${f}）だけなら、
;; 関数でなければエラーにし、関数なら null（ふつうに展開する）。そのほかは null
(define Sjs_head ,(sh elems)
  __Cont_get__ ,(return)
  __LList_uncons__ (,(msg) return __NULL__) elems ,(elem more)
  __is_null__ more ,(single)
  __unless__ single (,() return __NULL__) ,()
  Node_split elem ,(kind pos children)
  __String_equal__ kind "arithsubst" ,(test__) __if__ test__
    (,()
      Sjs_subst sh pos children ,(raw)
      Value_force raw ,(value)
      __type_name__ value ,(type)
      __String_equal__ type "Closure" ,(test__) __if__ test__ (,() return value) ,()
      Sjs_abort sh pos "not a function") ,()
  __String_equal__ kind "var" ,(isVar)
  __String_equal__ kind "bvar" ,(isBvar)
  __or__ isVar isBvar ,(isRef)
  __unless__ isRef (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __is_null__ rest ,(noDefault)
  __unless__ noDefault (,() return __NULL__) ,()
  __Dict_lookup_or__ sh "vars" __print_exit_error__ ,(vars)
  __Dict_lookup_or__ vars name (,(key) return __NULL__) ,(raw)
  __type_name__ raw ,(type)
  __String_equal__ type "Dict" ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __Dict_lookup_or__ raw "sjs" (,(key) return __NULL__) ,(isSjs)
  Value_force raw ,(value)
  __type_name__ value ,(type)
  __String_equal__ type "Closure" ,(test__) __if__ test__ (,() return __NULL__) ,()
  __String_concat__ "not a function: $" name ,(msg)
  Sjs_abort sh pos msg)

;; SJS の値を 1 つの要素として target に書く。undefined と null は書かない
(define Sjs_output ,(sh pos target value)
  __Cont_get__ ,(return)
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(test__) __if__ test__ (,() Target_write sh pos target value ,() return) ,()
  __Dict_lookup_or__ value "js" __print_exit_error__ ,(id)
  __String_equal__ id "undefined" ,(test__) __if__ test__ return ,()
  __String_equal__ id "null" ,(test__) __if__ test__ return ,()
  Value_force value ,(v)
  Target_write sh pos target v)

;; SJS式に渡す SJS変数：names のうち "sjsvars" にあるものの、名前、種類（s か j）、値の LList
(define Sjs_vars ,(sh names ns ks vs)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return ns ks vs) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __Dict_lookup_or__ sh "sjsvars" __print_exit_error__ ,(vars)
  __Dict_lookup_or__ vars name (,(key) Sjs_vars sh rest ns ks vs ,(ns ks vs) return ns ks vs) ,(raw)
  __type_name__ raw ,(type)
  __String_equal__ type "String" ,(test__) __if_then_else__ test__
    (,() __NULL__ "s" raw)
    (,() __Dict_lookup_or__ raw "js" __print_exit_error__ ,(id) __NULL__ "j" id) ,(kind value)
  __LList_cons__ name ns ,(ns)
  __LList_cons__ kind ks ,(ks)
  __LList_cons__ value vs ,(vs)
  Sjs_vars sh rest ns ks vs)

;; SJS の値（String か、JS の値の Dict）の JavaScript の真偽。偽は、""、undefined、null、false、0、-0、NaN、0n
(define Sjs_truthy ,(value)
  __Cont_get__ ,(return)
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(test__) __if__ test__
    (,() __String_equal__ value "" ,(empty) __not__ empty ,(t) return t) ,()
  __Dict_lookup_or__ value "js" __print_exit_error__ ,(id)
  Sjs_falsy_id id ,(falsy)
  __not__ falsy)

(define Sjs_falsy_id ,(id)
  __Cont_get__ ,(return)
  __NULL__ (,(s) __String_equal__ id s ,(t) __if__ t (,() return __TRUE__)) ,(is)
  is "undefined" ,()
  is "null" ,()
  is "boolean:false" ,()
  is "number:0" ,()
  is "number:-0" ,()
  is "number:NaN" ,()
  is "bigint:0" ,()
  __NULL__ __FALSE__)
