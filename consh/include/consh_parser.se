(define Ps_at_redirect ,(p)
  __Cont_get__ ,(return)
  num "4" ,(four)
  Ps_peek_str p four ,(s)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "<") (,() return __TRUE__) ,()
  __if__ (,() __String_equal__ c ">") (,() return __TRUE__) ,()
  __if__ (,() __String_equal__ s "1>&2") (,() return __TRUE__) ,()
  Str_starts s "2>")

(define Str_starts ,(s prefix)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __String_length__ prefix ,(n)
  __Number_subtract__ len n ,(d)
  __if__ (,() __Number_is_negative__ d) (,() return __FALSE__) ,()
  num "0" ,(zero)
  __String_substring__ __print_exit_error__ s zero n ,(head)
  __String_equal__ head prefix)

(define Ps_redirect ,(p)
  __Cont_get__ ,(return)
  Ps_pos p ,(pos)
  num "4" ,(four)
  Ps_peek_str p four ,(s)
  __String_equal__ s "1>&2" ,(a)
  __String_equal__ s "2>&1" ,(b)
  __or__ a b ,(dup)
  __if__ dup
