;; ConSh の構文解析。PLAN-ja.md の 1.1 文法定義を、文字単位の再帰下降で解析する。
;; Python の参照実装 consh_parse の Parser と同じ手順で、consh_parse --pos を consh_ast.se で読んだものと同じ構文木を作る。
;;
;; ConMa の String は、文字を取り出すたびに長さに比例する時間がかかるので、先にスクリプトを文字のセルの LList にする。
;; セルは (文字 行継続 位置 番号) の LList で、行継続は、この文字が行継続の \ なら読み飛ばすセルの数（\ 改行は 2、
;; \ \r 改行は 3）、そうでなければ 0。位置は節に入れる (行 桁)、番号は先頭からの文字の番号。
;; 最後に、文字が "" の番兵のセルを置く（入力の終わり。位置は consh_parse と同じく、最後の文字の後ろ）。
;;
;; 解析の状態は Dict で、"cur"（今のセルからの LList）、"skipped"（"cur" から行継続を読み飛ばした LList）、
;; "sep"（コメントを始められる位置の番号）、"file"（エラーに出す名前）。
;; "cur" を変えるときは Ps_set で "skipped" も作り直す。今の文字を見るたびに行継続を調べ直さずに済むので速い
;; 行継続（\ と改行）は、引用符 '...'、$'...'、コメントの中を除き、読む前に読み飛ばす（Cur_skip）。
;; 構文エラーは「consh: ファイル:行:桁: メッセージ」を出して、終了ステータス 1 で終わる

;; ── 入口 ──

;; path のスクリプトを解析し、コマンド行の節の LList を返す（consh_parse --pos の各行と同じ）。
;; file はエラーに出す名前
(define Parse_file ,(path file)
  __OS_open__ (,(msg) Parse_fail msg) path "r" ,(stream)
  __LazyList_lines__ stream ,(lines)
  Cells_from_lines lines ,(cells)
  __OS_close__ __print_exit_error__ stream ,()
  __Dict_new__ ,(p)
  Ps_set p cells ,()
  num "0" ,(zero)
  __Dict_put__ p "sep" zero ,()
  __Dict_put__ p "file" file ,()
  Ps_program p)

(define Parse_fail ,(msg)
  __String_concat__ "consh: " msg ,(msg)
  __String_concat__ msg "\n" ,(msg)
  __print_exit_error__ msg)

;; text（改行で終わる行の並び）を解析する。行番号は startLine から数える（対話モードで、入力全体の行番号にする）。
;; 構文木のコマンド行の LList と、エラーなら「file:行:桁: メッセージ」と、メッセージだけを返す（エラーでなければ null）。
;; エラーでは終わらない
(define Parse_text ,(text file startLine)
  __Cont_get__ ,(return)
  Text_lines text ,(lines)
  LazyList_fromList lines ,(lines)
  Cells_from_lines_at lines startLine ,(cells)
  __Dict_new__ ,(p)
  Ps_set p cells ,()
  num "0" ,(zero)
  __Dict_put__ p "sep" zero ,()
  __Dict_put__ p "file" file ,()
  __Dict_put__ p "onError" (,(full msg) return __NULL__ full msg) ,()
  Ps_program p ,(lines)
  __NULL__ lines __NULL__ __NULL__)

;; 構文エラー msg が、入力が足りないため（続きを読めば正しくなりうる）か
(define Parse_incomplete ,(msg)
  __Cont_get__ ,(return)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ msg "end of input" zero ,(pos)
  __unless__ (,() __is_null__ pos) (,() return __TRUE__) ,()
  Str_starts msg "unterminated")

;; text を改行の後ろで区切った String の LList（最後の行に改行がなくても、その行を含める）
(define Text_lines ,(text)
  __Cont_get__ ,(return)
  __String_length__ text ,(len)
  __if__ (,() __Number_is_zero__ len) (,() return __NULL__) ,()
  num "0" ,(zero)
  __String_find__ __print_exit_error__ text "\n" zero ,(pos)
  __if__ (,() __is_null__ pos) (,() L1 text ,(l) return l) ,()
  num "1" ,(one)
  __Number_add__ pos one ,(next)
  __String_substring__ __print_exit_error__ text zero next ,(line)
  __String_substring__ __print_exit_error__ text next len ,(rest)
  Text_lines rest ,(more)
  __LList_cons__ line more)

;; ── 文字のセル ──

(define Cell_make ,(ch cont pos idx)
  __LList_cons__ idx __NULL__ ,(tail)
  __LList_cons__ pos tail ,(tail)
  __LList_cons__ cont tail ,(tail)
  __LList_cons__ ch tail)

(define Pos_make ,(line col)
  __LList_cons__ col __NULL__ ,(tail)
  __LList_cons__ line tail)

;; 行の LazyList（改行を含む）から、セルの LList を作る
(define Cells_from_lines ,(lines)
  num "1" ,(one)
  Cells_from_lines_at lines one)

(define Cells_from_lines_at ,(lines startLine)
  num "1" ,(one)
  num "0" ,(zero)
  Pos_make startLine one ,(endPos)
  Cells_lines lines startLine zero endPos __NULL__)

;; acc は逆順のセル。endPos は、ここで入力が終わったときの番兵の位置
(define Cells_lines ,(lines lineNo idx endPos acc)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,()
      num "0" ,(zero)
      Cell_make "" zero endPos idx ,(sentinel)
      __LList_cons__ sentinel acc ,(acc)
      List_reverse acc ,(cells)
      return cells) lines ,(line rest)
  __String_length__ line ,(len)
  num "0" ,(zero)
  Line_cont line len ,(contAt contLen)
  Cells_chars line zero len lineNo idx acc contAt contLen ,(idx acc)
  num "1" ,(one)
  __Number_add__ lineNo one ,(nextLine)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ line last len ,(lastCh)
  __if_then_else__ (,() __String_equal__ lastCh "\n")
    (,() Pos_make nextLine one)
    (,()
      __Number_add__ len one ,(col)
      Pos_make lineNo col) ,(endPos)
  Cells_lines rest nextLine idx endPos acc)

;; 行の終わりの行継続（\ 改行、\ \r 改行）の \ の位置と、読み飛ばす文字の数。なければ位置は -1
(define Line_cont ,(line len)
  __Cont_get__ ,(return)
  num "-1" ,(none)
  num "0" ,(zero)
  num "2" ,(two)
  num "3" ,(three)
  __Number_subtract__ len two ,(at2)
  __Number_subtract__ len three ,(at3)
  __if__ (,() __Number_is_negative__ at2) (,() return none zero) ,()
  __String_substring__ __print_exit_error__ line at2 len ,(end2)
  __if__ (,() __String_equal__ end2 "\\\n") (,() return at2 two) ,()
  __if__ (,() __Number_is_negative__ at3) (,() return none zero) ,()
  __String_substring__ __print_exit_error__ line at3 len ,(end3)
  __if__ (,() __String_equal__ end3 "\\\r\n") (,() return at3 three) ,()
  __NULL__ none zero)

(define Cells_chars ,(line i len lineNo idx acc contAt contLen)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return idx acc) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ line i next ,(ch)
  Pos_make lineNo next ,(pos)
  __Number_subtract__ i contAt ,(d)
  __if_then_else__ (,() __Number_is_zero__ d) (,() __NULL__ contLen) (,() num "0") ,(cont)
  Cell_make ch cont pos idx ,(cell)
  __LList_cons__ cell acc ,(acc)
  __Number_add__ idx one ,(idx)
  Cells_chars line next len lineNo idx acc contAt contLen)

;; ── カーソル（セルの LList） ──

(define Cur_char ,(cur)
  __LList_uncons__ __print_exit_error__ cur ,(cell rest)
  __LList_uncons__ __print_exit_error__ cell ,(ch more)
  __NULL__ ch)

(define Cur_pos ,(cur)
  __LList_uncons__ __print_exit_error__ cur ,(cell rest)
  __LList_uncons__ __print_exit_error__ cell ,(ch more)
  __LList_uncons__ __print_exit_error__ more ,(cont more)
  __LList_uncons__ __print_exit_error__ more ,(pos more)
  __NULL__ pos)

(define Cur_idx ,(cur)
  __LList_uncons__ __print_exit_error__ cur ,(cell rest)
  __LList_uncons__ __print_exit_error__ cell ,(ch more)
  __LList_uncons__ __print_exit_error__ more ,(cont more)
  __LList_uncons__ __print_exit_error__ more ,(pos more)
  __LList_uncons__ __print_exit_error__ more ,(idx more)
  __NULL__ idx)

;; 次のセル。番兵ならそのまま
(define Cur_next ,(cur)
  __LList_uncons__ __print_exit_error__ cur ,(cell rest)
  __if_then_else__ (,() __is_null__ rest) (,() __NULL__ cur) (,() __NULL__ rest))

;; 行継続（\ 改行、\ \r 改行）を読み飛ばしたカーソル
(define Cur_skip ,(cur)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ cur ,(cell rest)
  __LList_uncons__ __print_exit_error__ cell ,(ch more)
  __LList_uncons__ __print_exit_error__ more ,(cont more)
  __if__ (,() __Number_is_zero__ cont) (,() return cur) ,()
  Cur_drop cur cont ,(cur)
  Cur_skip cur)

;; n セル進んだカーソル
(define Cur_drop ,(cur n)
  __Cont_get__ ,(return)
  __if__ (,() __Number_is_zero__ n) (,() return cur) ,()
  Cur_next cur ,(cur)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  Cur_drop cur n)

;; 行継続を除いて k 文字先のカーソル
(define Cur_index ,(cur k)
  __Cont_get__ ,(return)
  Cur_skip cur ,(cur)
  __if__ (,() __Number_is_zero__ k) (,() return cur) ,()
  Cur_char cur ,(c)
  __if__ (,() __String_equal__ c "") (,() return cur) ,()
  Cur_next cur ,(cur)
  num "1" ,(one)
  __Number_subtract__ k one ,(k)
  Cur_index cur k)

;; ── 解析の状態 ──

(define Ps_get ,(p key)
  __Dict_lookup_or__ p key __print_exit_error__)

;; 今の位置（"cur"）を raw にし、行継続を読み飛ばした位置（"skipped"）も作る
(define Ps_set ,(p raw)
  __Dict_put__ p "cur" raw ,()
  Cur_skip raw ,(skipped)
  __Dict_put__ p "skipped" skipped)

;; k 文字先の文字（k は数字の String）。入力の終わりは ""
(define Ps_peek ,(p k)
  Ps_get p "skipped" ,(cur)
  num k ,(n)
  Cur_index cur n ,(cur)
  Cur_char cur)

(define Ps_c ,(p)
  Ps_get p "skipped" ,(cur)
  Cur_char cur)

(define Ps_peek_n ,(p n)
  Ps_get p "skipped" ,(cur)
  Cur_index cur n ,(cur)
  Cur_char cur)

;; 行継続を除いた n 文字の String
(define Ps_peek_str ,(p n)
  Ps_get p "skipped" ,(cur)
  Cur_str cur n "")

(define Cur_str ,(cur n acc)
  __Cont_get__ ,(return)
  __if__ (,() __Number_is_zero__ n) (,() return acc) ,()
  Cur_skip cur ,(cur)
  Cur_char cur ,(c)
  __String_concat__ acc c ,(acc)
  Cur_next cur ,(cur)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  Cur_str cur n acc)

;; 節の位置（行継続を除いた今の文字の位置）
(define Ps_pos ,(p)
  Ps_get p "skipped" ,(cur)
  Cur_pos cur)

;; エラーの位置（行継続を読み飛ばす前の位置）
(define Ps_raw_pos ,(p)
  Ps_get p "cur" ,(cur)
  Cur_pos cur)

(define Ps_skip ,(p)
  Ps_get p "skipped" ,(cur)
  __Dict_put__ p "cur" cur)

;; n 文字進む（n は Number）
(define Ps_advance_n ,(p n)
  __Cont_get__ ,(return)
  __if__ (,() __Number_is_zero__ n) return ,()
  Ps_get p "skipped" ,(cur)
  Cur_next cur ,(cur)
  Ps_set p cur ,()
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  Ps_advance_n p n)

(define Ps_advance ,(p k)
  num k ,(n)
  Ps_advance_n p n)

;; 行継続を読み飛ばさずに1文字進む
(define Ps_raw_next ,(p)
  Ps_get p "cur" ,(cur)
  Cur_next cur ,(cur)
  Ps_set p cur)

(define Ps_raw_char ,(p)
  Ps_get p "cur" ,(cur)
  Cur_char cur)

(define Ps_error ,(p msg)
  Ps_raw_pos p ,(pos)
  Ps_error_at p pos msg)

(define Ps_error_at ,(p pos msg)
  Ps_get p "file" ,(file)
  Pos_split pos ,(line col)
  __Number_toString__ line ,(l)
  __Number_toString__ col ,(c)
  __String_concat__ file ":" ,(s)
  __String_concat__ s l ,(s)
  __String_concat__ s ":" ,(s)
  __String_concat__ s c ,(s)
  __String_concat__ s ": " ,(s)
  __String_concat__ s msg ,(s)
  __Dict_lookup_or__ p "onError" (,(key) __NULL__ __NULL__) ,(onError)
  __unless__ (,() __is_null__ onError) (,() onError s msg) ,()
  Parse_fail s)

;; ── 文字の種類 ──

(define Ch_in ,(c set)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "") (,() return __FALSE__) ,()
  num "0" ,(zero)
  __String_find__ __print_exit_error__ set c zero ,(pos)
  __is_null__ pos ,(none)
  __not__ none)

(define Ch_code_in ,(c low high)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "") (,() return __FALSE__) ,()
  __String_toCode__ __print_exit_error__ c ,(code)
  num low ,(lo)
  num high ,(hi)
  __Number_subtract__ code lo ,(a)
  __Number_subtract__ hi code ,(b)
  __Number_is_negative__ a ,(below)
  __Number_is_negative__ b ,(above)
  __or__ below above ,(outside)
  __not__ outside)

(define Is_ident_start ,(c)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "_") (,() return __TRUE__) ,()
  Ch_code_in c "97" "122" ,(lower)
  __if__ lower (,() return __TRUE__) ,()
  Ch_code_in c "65" "90")

(define Is_digit ,(c)
  Ch_code_in c "48" "57")

(define Is_ident_char ,(c)
  __Cont_get__ ,(return)
  Is_ident_start c ,(s)
  __if__ s (,() return __TRUE__) ,()
  Is_digit c)

(define Is_space ,(c)
  Ch_in c " \t")

;; ; ' ( ) { } | & > < " $ \
(define Is_special ,(c)
  Ch_in c ";'(){}|&><\"$\\")

;; Python の repr と同じく、1文字を引用符で囲む
(define Py_repr ,(c)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "'") (,() return "\"'\"") ,()
  __if__ (,() __String_equal__ c "\\") (,() return "'\\\\'") ,()
  __if__ (,() __String_equal__ c "\t") (,() return "'\\t'") ,()
  __if__ (,() __String_equal__ c "\r") (,() return "'\\r'") ,()
  __String_concat__ "'" c ,(s)
  __String_concat__ s "'")

;; term（null は終わりの文字なし）が c と同じか
(define Is_term ,(c term)
  __if_then_else__ (,() __is_null__ term) (,() __NULL__ __FALSE__) (,() __String_equal__ c term))

;; ── 改行、空白、コメント ──

(define Ps_at_newline ,(p k)
  __Cont_get__ ,(return)
  Ps_peek p k ,(c)
  __if__ (,() __String_equal__ c "\n") (,() return __TRUE__) ,()
  __unless__ (,() __String_equal__ c "\r") (,() return __FALSE__) ,()
  num k ,(n)
  num "1" ,(one)
  __Number_add__ n one ,(n1)
  Ps_peek_n p n1 ,(d)
  __String_equal__ d "\n")

(define Ps_newline ,(p)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "\n") (,() return __TRUE__) ,()
  __unless__ (,() __String_equal__ c "\r") (,() return __FALSE__) ,()
  Ps_peek p "1" ,(d)
  __String_equal__ d "\n")

(define Ps_consume_newline ,(p)
  Ps_c p ,(c)
  __if_then_else__ (,() __String_equal__ c "\r") (,() __NULL__ "2") (,() __NULL__ "1") ,(n)
  Ps_advance p n ,()
  Ps_mark_sep p)

(define Ps_mark_sep ,(p)
  Ps_skip p ,()
  Ps_get p "cur" ,(cur)
  Cur_idx cur ,(idx)
  __Dict_put__ p "sep" idx)

;; 空白とタブを読み、その数を返す
(define Ps_skip_spaces ,(p)
  num "0" ,(zero)
  Ps_spaces p zero ,(n)
  __unless__ (,() __Number_is_zero__ n) (,() Ps_mark_sep p) ,()
  __NULL__ n)

(define Ps_spaces ,(p n)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  Is_space c ,(space)
  __unless__ space (,() return n) ,()
  Ps_advance p "1" ,()
  num "1" ,(one)
  __Number_add__ n one ,(n)
  Ps_spaces p n)

(define Ps_spaced ,(p)
  Ps_skip_spaces p ,(n)
  __Number_is_zero__ n ,(zero)
  __not__ zero)

(define Ps_at_comment ,(p)
  __Cont_get__ ,(return)
  Ps_skip p ,()
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "#") (,() return __FALSE__) ,()
  Ps_get p "cur" ,(cur)
  Cur_idx cur ,(idx)
  Ps_get p "sep" ,(sep)
  __Number_subtract__ idx sep ,(d)
  __Number_is_zero__ d)

;; コメントの中では行継続を取り除かない
(define Ps_skip_comment ,(p)
  __Cont_get__ ,(return)
  Ps_get p "cur" ,(cur)
  Cur_char cur ,(c)
  __if__ (,() __String_equal__ c "") return ,()
  __if__ (,() __String_equal__ c "\n") return ,()
  __if__ (,() __String_equal__ c "\r")
    (,()
      Cur_next cur ,(next)
      Cur_char next ,(d)
      __if__ (,() __String_equal__ d "\n") return ,()) ,()
  Ps_raw_next p ,()
  Ps_skip_comment p)

(define Ps_is_word_start ,(p)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return __FALSE__) ,()
  Is_space c ,(space)
  __if__ space (,() return __FALSE__) ,()
  Ps_newline p ,(nl)
  __if__ nl (,() return __FALSE__) ,()
  Is_special c ,(special)
  __unless__ special (,() return __TRUE__) ,()
  Ch_in c "\"'$\\")

(define Ps_is_bare ,(p)
  __Cont_get__ ,(return)
  Ps_is_word_start p ,(start)
  __unless__ start (,() return __FALSE__) ,()
  Ps_c p ,(c)
  Ch_in c "\"'$\\" ,(quote)
  __not__ quote)

(define Ps_at_stmt_end ,(p term)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return __TRUE__) ,()
  Ps_newline p ,(nl)
  __if__ nl (,() return __TRUE__) ,()
  __if__ (,() __String_equal__ c ";") (,() return __TRUE__) ,()
  Is_term c term ,(t)
  __if__ t (,() return __TRUE__) ,()
  Ps_at_comment p)

;; 今の文字が入力の終わり、改行、term、スクリプトを終えるキーワードか
(define Ps_at_line_end ,(p term)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return __TRUE__) ,()
  Ps_newline p ,(nl)
  __if__ nl (,() return __TRUE__) ,()
  Is_term c term ,(t)
  __if__ t (,() return __TRUE__) ,()
  Ps_at_terminator p)

(define Ps_describe ,(p)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return "end of input") ,()
  Ps_at_terminator p ,(term)
  __if__ term (,() Ps_keyword p ,(kw) return kw) ,()
  Ps_newline p ,(nl)
  __if__ nl (,() return "newline") ,()
  Py_repr c)

;; "前置き" + 今の文字の説明 のメッセージでエラーにする
(define Ps_error_found ,(p prefix)
  Ps_describe p ,(d)
  __String_concat__ prefix d ,(msg)
  Ps_error p msg)

(define Ps_expect ,(p c)
  __Cont_get__ ,(return)
  Ps_c p ,(d)
  __unless__ (,() __String_equal__ d c)
    (,()
      Py_repr c ,(r)
      __String_concat__ "expected " r ,(m)
      __String_concat__ m ", but found " ,(m)
      Ps_error_found p m) ,()
  Ps_advance p "1")

;; ── キーワード ──

;; 直後が空白、改行、;、|、&、入力の終わりのときだけキーワードになる。キーワードでなければ null
;; 今の位置のキーワード。同じ位置では何度も調べるので、位置の番号とともに "kwIdx"、"kw" に覚えておく
(define Ps_keyword ,(p)
  __Cont_get__ ,(return)
  Ps_get p "skipped" ,(cur)
  Cur_idx cur ,(idx)
  __Dict_lookup_or__ p "kwIdx" (,(key) num "-1") ,(kwIdx)
  __Number_subtract__ idx kwIdx ,(d)
  __if__ (,() __Number_is_zero__ d) (,() Ps_get p "kw" ,(kw) return kw) ,()
  Ps_keyword_at p cur ,(kw)
  __Dict_put__ p "kwIdx" idx ,()
  __Dict_put__ p "kw" kw ,()
  __NULL__ kw)

;; 小文字の並び（9文字まで）を読み、キーワードと同じで、直後が区切りならキーワードとする
;; （consh_parse の、各キーワードについて peek_str と直後の文字を調べるのと同じ結果になる）
(define Ps_keyword_at ,(p cur)
  __Cont_get__ ,(return)
  num "9" ,(nine)
  Cur_lower cur nine "" ,(word after)
  __String_length__ word ,(n)
  num "2" ,(two)
  __Number_subtract__ n two ,(d)
  __if__ (,() __Number_is_negative__ d) (,() return __NULL__) ,()
  Kw_all ,(kws)
  Ch_list_has kws word ,(known)
  __unless__ known (,() return __NULL__) ,()
  Cur_char after ,(c)
  Ps_after_keyword p c n ,(ok)
  __unless__ ok (,() return __NULL__) ,()
  __NULL__ word)

;; カーソルから、行継続を除いた小文字の並び（n 文字まで）と、その後ろのカーソル（行継続を読み飛ばした位置）
(define Cur_lower ,(cur n acc)
  __Cont_get__ ,(return)
  Cur_skip cur ,(cur)
  __if__ (,() __Number_is_zero__ n) (,() return acc cur) ,()
  Cur_char cur ,(c)
  Ch_code_in c "97" "122" ,(lower)
  __unless__ lower (,() return acc cur) ,()
  __String_concat__ acc c ,(acc)
  Cur_next cur ,(cur)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  Cur_lower cur n acc)

(define Kw_all ,()
  Kw_terminators ,(terms)
  Strs_cons "continue" terms ,(kws)
  Strs_cons "break" kws ,(kws)
  Strs_cons "for" kws ,(kws)
  Strs_cons "if" kws ,(kws)
  Strs_cons "return" kws ,(kws)
  Strs_cons "export" kws ,(kws)
  Strs_cons "function" kws)

(define Strs_cons ,(s list)
  __LList_cons__ s list)

;; 文の先頭でスクリプトを終えるキーワード
(define Kw_terminators ,()
  __LList_cons__ "done" __NULL__ ,(l)
  __LList_cons__ "do" l ,(l)
  __LList_cons__ "fi" l ,(l)
  __LList_cons__ "else" l ,(l)
  __LList_cons__ "elif" l ,(l)
  __LList_cons__ "then" l)

(define Ps_after_keyword ,(p c n)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "") (,() return __TRUE__) ,()
  Is_space c ,(space)
  __if__ space (,() return __TRUE__) ,()
  Ch_in c ";|&" ,(sep)
  __if__ sep (,() return __TRUE__) ,()
  __Number_toString__ n ,(k)
  Ps_at_newline p k)

(define Ps_at_terminator ,(p)
  __Cont_get__ ,(return)
  Ps_keyword p ,(kw)
  __if__ (,() __is_null__ kw) (,() return __FALSE__) ,()
  Kw_terminators ,(terms)
  Ch_list_has terms kw)

(define Ch_list_has ,(list s)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __if__ (,() __String_equal__ head s) (,() return __TRUE__) ,()
  Ch_list_has rest s)

(define Is_kw ,(kw s)
  __if_then_else__ (,() __is_null__ kw) (,() __NULL__ __FALSE__) (,() __String_equal__ kw s))

;; キーワード kw を読み、その位置を返す
(define Ps_expect_keyword ,(p kw)
  Ps_keyword p ,(k)
  Is_kw k kw ,(ok)
  __unless__ ok
    (,()
      __String_concat__ "expected " kw ,(m)
      __String_concat__ m ", but found " ,(m)
      Ps_error_found p m) ,()
  Ps_pos p ,(pos)
  __String_length__ kw ,(n)
  Ps_advance_n p n ,()
  __NULL__ pos)

;; ── 節を作る ──

(define Node_make ,(tag pos children)
  __LList_cons__ pos children ,(rest)
  __LList_cons__ tag rest)

(define Node_pos ,(node)
  Node_split node ,(tag pos children)
  __NULL__ pos)

(define Node_tag ,(node)
  Node_split node ,(tag pos children)
  __NULL__ tag)

(define L1 ,(a)
  __LList_cons__ a __NULL__)

(define L2 ,(a b)
  __LList_cons__ b __NULL__ ,(t)
  __LList_cons__ a t)

;; ── スクリプトとコマンド行 ──

;; コマンド行の節の LList
(define Ps_program ,(p)
  Ps_mark_sep p ,()
  Ps_script p __NULL__ ,(script)
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "") (,() Ps_error_found p "unexpected ") ,()
  Node_split script ,(tag pos lines)
  __NULL__ lines)

;; (script 位置 line ...)。term は終わりの文字（null ならなし）
(define Ps_script ,(p term)
  Ps_pos p ,(pos)
  Ps_script_lines p term __NULL__ ,(lines)
  List_reverse lines ,(lines)
  Ps_c p ,(c)
  __unless__ (,() __is_null__ term)
    (,()
      __unless__ (,() __String_equal__ c term)
        (,()
          Py_repr term ,(r)
          __String_concat__ "expected " r ,(m)
          __String_concat__ m ", but found " ,(m)
          Ps_error_found p m) ,()) ,()
  Node_make "script" pos lines)

(define Ps_script_lines ,(p term acc)
  __Cont_get__ ,(return)
  Ps_command_line p term ,(line)
  __if_then_else__ (,() __is_null__ line) (,() __NULL__ acc) (,() __LList_cons__ line acc) ,(acc)
  Ps_newline p ,(nl)
  __unless__ nl (,() return acc) ,()
  Ps_consume_newline p ,()
  Ps_script_lines p term acc)

;; (line 位置 文 ...)。文がなければ null
(define Ps_command_line ,(p term)
  __Cont_get__ ,(return)
  Ps_line_stmts p term __NULL__ ,(stmts)
  __if__ (,() __is_null__ stmts) (,() return __NULL__) ,()
  List_reverse stmts ,(stmts)
  List_first stmts ,(first)
  Node_pos first ,(pos)
  Node_make "line" pos stmts)

(define Ps_line_stmts ,(p term acc)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  Ps_at_comment p ,(comment)
  __if__ comment (,() Ps_skip_comment p ,() return acc) ,()
  Ps_at_line_end p term ,(end)
  __if__ end (,() return acc) ,()
  Ps_statement p term ,(s)
  __LList_cons__ s acc ,(acc)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c ";")
    (,()
      Ps_advance p "1" ,()
      Ps_mark_sep p ,()
      Ps_line_stmts p term acc ,(acc)
      return acc) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() Ps_skip_comment p ,() return acc) ,()
  Ps_at_line_end p term ,(end)
  __if__ end (,() return acc) ,()
  Ps_error_found p "unexpected ")

;; ── 文 ──

(define Ps_statement ,(p term)
  __Cont_get__ ,(return)
  Ps_pos p ,(pos)
  Ps_keyword p ,(kw)
  Is_kw kw "return" ,(isReturn)
  __if__ isReturn (,() Ps_return p pos ,(s) return s) ,()
  Is_kw kw "break" ,(isBreak)
  Is_kw kw "continue" ,(isContinue)
  __or__ isBreak isContinue ,(isJump)
  __if__ isJump (,() Ps_jump p pos kw term ,(s) return s) ,()
  Is_kw kw "export" ,(isExport)
  __if__ isExport (,() Ps_export p pos ,(s) return s) ,()
  Is_kw kw "function" ,(isFunction)
  __if__ isFunction (,() Ps_function p pos ,(s) return s) ,()
  Ps_defs p __NULL__ ,(defs)
  __unless__ (,() __is_null__ defs)
    (,()
      Ps_at_stmt_end p term ,(end)
      __if__ end
        (,()
          List_first defs ,(first)
          Node_pos first ,(dpos)
          Node_make "assign" dpos defs ,(s)
          return s) ,()) ,()
  Ps_command_list p defs __TRUE__)

;; 文の先頭の前置の変数定義（定義の間は空白、定義でなくなるまで）
(define Ps_defs ,(p acc)
  __Cont_get__ ,(return)
  Ps_at_def p ,(isDef)
  __unless__ isDef (,() List_reverse acc ,(defs) return defs) ,()
  Ps_def p ,(d)
  __LList_cons__ d acc ,(acc)
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() List_reverse acc ,(defs) return defs) ,()
  Ps_defs p acc)

(define Ps_return ,(p pos)
  Ps_advance p "6" ,()
  Ps_skip_spaces p ,(n)
  Ps_is_word_start p ,(start)
  Ps_at_comment p ,(comment)
  __Number_is_zero__ n ,(noSpace)
  __not__ start ,(noWord)
  __or__ noSpace noWord ,(bad)
  __or__ bad comment ,(bad)
  __if__ bad (,() Ps_error p "expected a word after return") ,()
  Ps_word p ,(word)
  L1 word ,(children)
  Node_make "return" pos children)

;; break [変数名]、continue [変数名]
(define Ps_jump ,(p pos kw term)
  __Cont_get__ ,(return)
  __String_length__ kw ,(len)
  Ps_advance_n p len ,()
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() Node_make kw pos __NULL__ ,(s) return s) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() Node_make kw pos __NULL__ ,(s) return s) ,()
  Ps_at_stmt_end p term ,(end)
  __if__ end (,() Node_make kw pos __NULL__ ,(s) return s) ,()
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident
    (,()
      __String_concat__ "expected a variable name after " kw ,(m)
      __String_concat__ m ", but found " ,(m)
      Ps_error_found p m) ,()
  Ps_ident p ,(name)
  L1 name ,(children)
  Node_make kw pos children)

(define Ps_export ,(p pos)
  Ps_advance p "6" ,()
  Ps_c p ,(c)
  Ps_newline p ,(nl)
  __String_equal__ c "" ,(end)
  __or__ end nl ,(bad)
  __if__ bad (,() Ps_error p "export followed by a newline") ,()
  Ps_export_items p __NULL__ ,(items)
  Node_make "export" pos items)

(define Ps_export_items ,(p acc)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() List_reverse acc ,(items) return items) ,()
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident (,() List_reverse acc ,(items) return items) ,()
  Ps_pos p ,(ipos)
  Ps_ident p ,(name)
  Ps_c p ,(c)
  __if_then_else__ (,() __String_equal__ c "=")
    (,()
      Ps_advance p "1" ,()
      Ps_value p ,(value)
      Def_make ipos name value)
    (,()
      L1 name ,(children)
      Node_make "name" ipos children) ,(item)
  __LList_cons__ item acc ,(acc)
  Ps_export_items p acc)

(define Def_make ,(pos name value)
  __if_then_else__ (,() __is_null__ value)
    (,() L1 name)
    (,() L2 name value) ,(children)
  Node_make "def" pos children)

(define Ps_function ,(p pos)
  Ps_advance p "8" ,()
  Ps_c p ,(c)
  Ps_newline p ,(nl)
  __String_equal__ c "" ,(end)
  __or__ end nl ,(bad)
  __if__ bad (,() Ps_error p "function followed by a newline") ,()
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident (,() Ps_error_found p "expected a function name, but found ") ,()
  Ps_ident p ,(name)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "(") (,() Ps_error_found p "expected '(', but found ") ,()
  Ps_params p ,(params)
  Ps_skip_spaces p ,(n)
  Ps_expect p "{" ,()
  Ps_script p "}" ,(body)
  Ps_advance p "1" ,()
  __LList_cons__ body __NULL__ ,(children)
  __LList_cons__ params children ,(children)
  __LList_cons__ name children ,(children)
  Node_make "function" pos children)

;; ── 変数定義と値 ──

(define Ps_at_def ,(p)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident (,() return __FALSE__) ,()
  num "1" ,(one)
  Ps_def_end p one)

(define Ps_def_end ,(p k)
  __Cont_get__ ,(return)
  Ps_peek_n p k ,(c)
  Is_ident_char c ,(more)
  __unless__ more (,() __String_equal__ c "=" ,(b) return b) ,()
  num "1" ,(one)
  __Number_add__ k one ,(k)
  Ps_def_end p k)

(define Ps_def ,(p)
  Ps_pos p ,(pos)
  Ps_ident p ,(name)
  Ps_advance p "1" ,()
  Ps_value p ,(value)
  Def_make pos name value)

;; 値 = [語] | "(" {スペース} [語 {スペース+ 語}] {スペース} ")" | 関数値。空なら null
(define Ps_value ,(p)
  __Cont_get__ ,(return)
  Ps_at_fun_value p ,(fun)
  __if__ fun (,() Ps_fun_value p ,(v) return v) ,()
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "(")
    (,()
      Ps_is_word_start p ,(start)
      __unless__ start (,() return __NULL__) ,()
      Ps_word p ,(word)
      return word) ,()
  Ps_pos p ,(pos)
  Ps_advance p "1" ,()
  Ps_skip_spaces p ,(n)
  Ps_array_words p __NULL__ ,(words)
  Ps_advance p "1" ,()
  Ps_is_word_start p ,(start)
  __if__ start
    (,()
      Ps_describe p ,(d)
      __String_concat__ "unexpected " d ,(m)
      __String_concat__ m " after ')'" ,(m)
      Ps_error p m) ,()
  Node_make "array" pos words)

(define Ps_array_words ,(p acc)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c ")") (,() List_reverse acc ,(words) return words) ,()
  Ps_is_word_start p ,(start)
  __unless__ start (,() Ps_error_found p "expected a word or ')', but found ") ,()
  Ps_word p ,(word)
  __LList_cons__ word acc ,(acc)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __if__ (,() __Number_is_zero__ n)
    (,() __unless__ (,() __String_equal__ c ")") (,() Ps_error_found p "expected ')', but found ") ,()) ,()
  Ps_array_words p acc)

(define Ps_ident ,(p)
  Ps_ident_from p "")

(define Ps_ident_from ,(p acc)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  Is_ident_char c ,(ok)
  __unless__ ok (,() return acc) ,()
  __String_concat__ acc c ,(acc)
  Ps_advance p "1" ,()
  Ps_ident_from p acc)

;; (params 位置 (名前 ...) [rest])
(define Ps_params ,(p)
  Ps_pos p ,(pos)
  Ps_advance p "1" ,()
  Ps_skip_spaces p ,(n)
  Ps_param_names p __NULL__ __TRUE__ ,(names)
  Ps_c p ,(c)
  __if_then_else__ (,() __String_equal__ c ".")
    (,()
      Ps_advance p "1" ,()
      Ps_skip_spaces p ,(n)
      Ps_c p ,(c)
      Is_ident_start c ,(ident)
      __unless__ ident (,() Ps_error_found p "expected a variable name after ., but found ") ,()
      Ps_ident p ,(rest)
      Ps_skip_spaces p ,(n)
      L1 rest)
    (,() __NULL__ __NULL__) ,(restList)
  Ps_expect p ")" ,()
  __LList_cons__ names restList ,(children)
  Node_make "params" pos children)

;; 名前を空白で区切って読む。最初の名前の前には空白を求めない
(define Ps_param_names ,(p acc first)
  __Cont_get__ ,(return)
  __unless__ first
    (,()
      Ps_skip_spaces p ,(n)
      __if__ (,() __Number_is_zero__ n) (,() List_reverse acc ,(names) return names) ,()) ,()
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident (,() List_reverse acc ,(names) return names) ,()
  Ps_ident p ,(name)
  __LList_cons__ name acc ,(acc)
  Ps_param_names p acc __FALSE__)

;; ── 関数値、reset、shift ──

;; k 文字先（Number）から空白とタブを読み飛ばした位置（Number）
(define Ps_spaces_from ,(p k)
  __Cont_get__ ,(return)
  Ps_peek_n p k ,(c)
  Is_space c ,(space)
  __unless__ space (,() return k) ,()
  num "1" ,(one)
  __Number_add__ k one ,(k)
  Ps_spaces_from p k)

;; k 文字先（Number）から識別子の文字を読み飛ばした位置（Number）
(define Ps_ident_end ,(p k)
  __Cont_get__ ,(return)
  Ps_peek_n p k ,(c)
  Is_ident_char c ,(more)
  __unless__ more (,() return k) ,()
  num "1" ,(one)
  __Number_add__ k one ,(k)
  Ps_ident_end p k)

;; 今の位置に、n 文字（Number）の word があり、その後ろに空白を読み飛ばして c があるか
(define Ps_word_then ,(p word n c)
  __Cont_get__ ,(return)
  Ps_peek_str p n ,(s)
  __unless__ (,() __String_equal__ s word) (,() return __FALSE__) ,()
  Ps_spaces_from p n ,(k)
  Ps_peek_n p k ,(d)
  __String_equal__ d c)

;; 値の位置の function は、直後に {スペース} と ( が続くときだけ関数値になる
(define Ps_at_fun_value ,(p)
  num "8" ,(n)
  Ps_word_then p "function" n "(")

;; 関数値 = "function" {スペース} 変数リスト {スペース} "{" スクリプト "}"
(define Ps_fun_value ,(p)
  Ps_pos p ,(pos)
  Ps_advance p "8" ,()
  Ps_skip_spaces p ,(n)
  Ps_params p ,(params)
  Ps_skip_spaces p ,(n)
  Ps_expect p "{" ,()
  Ps_script p "}" ,(body)
  Ps_advance p "1" ,()
  Ps_is_word_start p ,(start)
  __if__ start
    (,()
      Ps_describe p ,(d)
      __String_concat__ "unexpected " d ,(m)
      __String_concat__ m " after '}'" ,(m)
      Ps_error p m) ,()
  L2 params body ,(children)
  Node_make "fun" pos children)

;; reset は、直後に {スペース} と { が続くときだけキーワードになる
(define Ps_at_reset ,(p)
  num "5" ,(n)
  Ps_word_then p "reset" n "{")

;; shift は、直後にスペースと変数名が続き、その後に ( か { が来るときだけキーワードになる
(define Ps_at_shift ,(p)
  __Cont_get__ ,(return)
  num "5" ,(n)
  Ps_peek_str p n ,(s)
  __unless__ (,() __String_equal__ s "shift") (,() return __FALSE__) ,()
  Ps_peek_n p n ,(c)
  Is_space c ,(space)
  __unless__ space (,() return __FALSE__) ,()
  Ps_spaces_from p n ,(k)
  Ps_peek_n p k ,(c)
  Is_ident_start c ,(ident)
  __unless__ ident (,() return __FALSE__) ,()
  Ps_ident_end p k ,(k)
  Ps_spaces_from p k ,(k)
  Ps_peek_n p k ,(c)
  Ch_in c "({")

;; "reset" {スペース} "{" スクリプト "}"。スクリプトの節を返す
(define Ps_reset ,(p)
  Ps_advance p "5" ,()
  Ps_skip_spaces p ,(n)
  Ps_expect p "{" ,()
  Ps_script p "}" ,(body)
  Ps_advance p "1" ,()
  __NULL__ body)

;; "shift" スペース+ 変数名 [{スペース} 変数リスト] {スペース} "{" スクリプト "}"。子の LList を返す
(define Ps_shift ,(p)
  Ps_advance p "5" ,()
  Ps_skip_spaces p ,(n)
  Ps_ident p ,(name)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __if_then_else__ (,() __String_equal__ c "(")
    (,() Ps_params p ,(params) Ps_skip_spaces p ,(n) L1 params)
    (,() __NULL__ __NULL__) ,(plist)
  Ps_expect p "{" ,()
  Ps_script p "}" ,(body)
  Ps_advance p "1" ,()
  L1 body ,(tail)
  __LList_append__ plist tail ,(children)
  __LList_cons__ name children)

;; ── コマンド列、パイプライン、単純文 ──

;; defs は文の先頭で読んだ前置の変数定義。parsed が真なら読み終えている
(define Ps_command_list ,(p defs parsed)
  Ps_list_items p defs parsed __NULL__ ,(items)
  List_reverse items ,(items)
  __LList_uncons__ __print_exit_error__ items ,(first rest)
  Node_tag first ,(tag)
  __is_null__ rest ,(single)
  __String_equal__ tag "bg" ,(isBg)
  __not__ isBg ,(notBg)
  __if_then_else__ (,() __and__ single notBg)
    (,() __NULL__ first)
    (,()
      Node_pos first ,(pos)
      Node_make "list" pos items))

(define Ps_list_items ,(p defs parsed acc)
  __Cont_get__ ,(return)
  Ps_pipeline p defs parsed ,(pl)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "&") (,() __LList_cons__ pl acc ,(acc) return acc) ,()
  Ps_advance p "1" ,()
  Ps_mark_sep p ,()
  Node_pos pl ,(pos)
  L1 pl ,(children)
  Node_make "bg" pos children ,(bg)
  __LList_cons__ bg acc ,(acc)
  Ps_skip_spaces p ,(n)
  Ps_is_word_start p ,(start)
  __unless__ start (,() return acc) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() return acc) ,()
  Ps_at_terminator p ,(terminator)
  __if__ terminator (,() return acc) ,()
  Ps_list_items p __NULL__ __FALSE__ acc)

(define Ps_pipeline ,(p defs parsed)
  Ps_simple p defs parsed ,(first)
  Ps_pipe_rest p __NULL__ ,(rest)
  __if_then_else__ (,() __is_null__ rest)
    (,() __NULL__ first)
    (,()
      __LList_cons__ first rest ,(cmds)
      Node_pos first ,(pos)
      Node_make "pipe" pos cmds))

(define Ps_pipe_rest ,(p acc)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __unless__ (,() __String_equal__ c "|") (,() List_reverse acc ,(cmds) return cmds) ,()
  Ps_advance p "1" ,()
  Ps_mark_sep p ,()
  Ps_after_pipe p ,()
  Ps_simple p __NULL__ __FALSE__ ,(cmd)
  __LList_cons__ cmd acc ,(acc)
  Ps_pipe_rest p acc)

;; | の後には、空白と改行を混ぜて置ける。改行の前には行コメントを置ける
(define Ps_after_pipe ,(p)
  __Cont_get__ ,(return)
  Ps_at_comment p ,(comment)
  __if__ comment (,() Ps_skip_comment p) ,()
  Ps_newline p ,(nl)
  __if__ nl (,() Ps_consume_newline p ,() Ps_after_pipe p ,() return) ,()
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) return ,()
  Ps_after_pipe p)

(define Ps_simple ,(p defs parsed)
  __Cont_get__ ,(return)
  __if_then_else__ (,() __is_null__ defs)
    (,() Ps_pos p)
    (,() List_first defs ,(d) Node_pos d) ,(pos)
  __if_then_else__ parsed
    (,() __NULL__ defs)
    (,() Ps_defs p __NULL__) ,(defs)
  ;; reset と shift。前置の変数定義の後ではキーワードにならない。算術評価 (( )) も、前置の変数定義の後には置けない
  __if__ (,() __is_null__ defs)
    (,()
      Ps_at_arith p ,(isArith)
      __if__ isArith
        (,()
          Ps_arith p ,(code namesNode)
          Ps_stmt_redirs p ,(redirs)
          __LList_cons__ namesNode redirs ,(children)
          __LList_cons__ code children ,(children)
          Node_make "arith" pos children ,(s)
          return s) ,()
      Ps_at_reset p ,(isReset)
      __if__ isReset
        (,()
          Ps_reset p ,(body)
          Ps_stmt_redirs p ,(redirs)
          __LList_cons__ body redirs ,(children)
          Node_make "reset" pos children ,(s)
          return s) ,()
      Ps_at_shift p ,(isShift)
      __if__ isShift
        (,()
          Ps_shift p ,(children)
          Node_make "shift" pos children ,(s)
          return s) ,()) ,()
  __if_then_else__ (,() __is_null__ defs) (,() Ps_keyword p) (,() __NULL__ __NULL__) ,(kw)
  Is_kw kw "if" ,(isIf)
  __if__ isIf
    (,()
      Ps_if p ,(clauses)
      Ps_stmt_redirs p ,(redirs)
      __LList_append__ clauses redirs ,(children)
      Node_make "if" pos children ,(s)
      return s) ,()
  Is_kw kw "for" ,(isFor)
  __if__ isFor
    (,()
      Ps_for p ,(children)
      Ps_stmt_redirs p ,(redirs)
      __LList_append__ children redirs ,(children)
      Node_make "for" pos children ,(s)
      return s) ,()
  __unless__ (,() __is_null__ kw)
    (,()
      __String_concat__ "unexpected " kw ,(m)
      Ps_error p m) ,()
  Ps_is_word_start p ,(start)
  Ps_at_redirect p ,(redir)
  Ps_at_comment p ,(comment)
  __not__ start ,(noWord)
  __or__ noWord redir ,(bad)
  __or__ bad comment ,(bad)
  __if__ bad (,() Ps_error_found p "expected a command, but found ") ,()
  Ps_word p ,(word)
  Ps_cmd_words p __NULL__ ,(words redirsFollow)
  __LList_cons__ word words ,(words)
  __if_then_else__ redirsFollow
    (,() Ps_redirects p __NULL__)
    (,() __NULL__ __NULL__) ,(redirs)
  Cmd_make pos defs words redirs)

;; 語の後ろの語。リダイレクトが続けば、その前までの語と真を返す
(define Ps_cmd_words ,(p acc)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() List_reverse acc ,(w) return w __FALSE__) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() List_reverse acc ,(w) return w __FALSE__) ,()
  Ps_at_redirect p ,(redir)
  __if__ redir (,() List_reverse acc ,(w) return w __TRUE__) ,()
  Ps_is_word_start p ,(start)
  __unless__ start (,() List_reverse acc ,(w) return w __FALSE__) ,()
  Ps_word p ,(word)
  __LList_cons__ word acc ,(acc)
  Ps_cmd_words p acc)

;; (cmd 位置 [(env …)] (words …) [(redirs …)])
(define Cmd_make ,(pos defs words redirs)
  Redirs_node redirs ,(tail)
  List_first words ,(w)
  Node_pos w ,(wpos)
  Node_make "words" wpos words ,(wordsNode)
  __LList_cons__ wordsNode tail ,(children)
  __if_then_else__ (,() __is_null__ defs)
    (,() __NULL__ children)
    (,()
      List_first defs ,(d)
      Node_pos d ,(dpos)
      Node_make "env" dpos defs ,(env)
      __LList_cons__ env children) ,(children)
  Node_make "cmd" pos children)

;; リダイレクトの LList から、(redirs …) の節だけの LList（なければ null）
(define Redirs_node ,(redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs) (,() return __NULL__) ,()
  List_first redirs ,(r)
  Node_pos r ,(pos)
  Node_make "redirs" pos redirs ,(node)
  L1 node)

;; if 文と for 文の後ろのリダイレクト。(redirs …) の節だけの LList
(define Ps_stmt_redirs ,(p)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() return __NULL__) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() return __NULL__) ,()
  Ps_at_redirect p ,(redir)
  __unless__ redir (,() return __NULL__) ,()
