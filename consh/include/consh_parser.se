;; ── ANSI-C クォート $'...' ──
;; エスケープを文字にした sq の節を返す。中では行継続を取り除かない。
;; \xHH の続きはバイトとしてためて、まとめて UTF-8 として読む（読めないバイトは U+FFFD）

(define Ps_ansi_c ,(p)
  Ps_raw_pos p ,(start)
  Ps_raw_next p ,()
  Ps_raw_next p ,()
  Ps_ansi_chars p start "" __NULL__ ,(text)
  Ps_raw_next p ,()
  L1 text ,(children)
  Node_make "sq" start children)

;; out は作った文字列、bytes は \xHH のたまったバイト（逆順の LList）
(define Ps_ansi_chars ,(p start out bytes)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __if__ (,() __String_equal__ c "") (,() Ps_error_at p start "unterminated $'") ,()
  __if__ (,() __String_equal__ c "'") (,() Utf8_flush out bytes ,(out) return out) ,()
  Ps_get p "cur" ,(cur)
  Cur_next cur ,(next)
  Cur_char next ,(d)
  __String_equal__ c "\\" ,(isEscape)
  __String_equal__ d "" ,(atEnd)
  __not__ isEscape ,(plain)
  __or__ plain atEnd ,(plain)
  __if__ plain
    (,()
      Utf8_flush out bytes ,(out)
      __String_concat__ out c ,(out)
      Ps_raw_next p ,()
      Ps_ansi_chars p start out __NULL__ ,(out)
      return out) ,()
  __String_equal__ d "x" ,(isX)
  __String_equal__ d "u" ,(isU)
  __or__ isX isU ,(isHex)
  __if__ isHex
    (,()
      __if_then_else__ isX (,() num "2") (,() num "4") ,(n)
      Cur_next next ,(digits)
      Hex_read digits n ,(count code rest)
      __unless__ (,() __Number_is_zero__ count)
        (,()
          Ps_set p rest ,()
          __if_then_else__ isX
            (,()
              __LList_cons__ code bytes ,(bytes)
              __NULL__ out bytes)
            (,()
              Utf8_flush out bytes ,(out)
              __String_fromCode__ __print_exit_error__ code ,(ch)
              __String_concat__ out ch ,(out)
              __NULL__ out __NULL__) ,(out bytes)
          Ps_ansi_chars p start out bytes ,(out)
          return out) ,()) ,()
  Utf8_flush out bytes ,(out)
  Ansi_escape d ,(s)
  __String_concat__ out s ,(out)
  Ps_raw_next p ,()
  Ps_raw_next p ,()
  Ps_ansi_chars p start out __NULL__)

(define Ansi_escape ,(d)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ d "n") (,() return "\n") ,()
  __if__ (,() __String_equal__ d "t") (,() return "\t") ,()
  __if__ (,() __String_equal__ d "r") (,() return "\r") ,()
  __if__ (,() __String_equal__ d "\\") (,() return "\\") ,()
  __if__ (,() __String_equal__ d "'") (,() return "'") ,()
  __if__ (,() __String_equal__ d "\"") (,() return "\"") ,()
  __String_concat__ "\\" d)

;; カーソル cur から、16 進の数字を n 文字まで読む。読んだ数、値、その後ろのカーソルを返す
(define Hex_read ,(cur n)
  num "0" ,(zero)
  Hex_read_from cur n zero zero)

(define Hex_read_from ,(cur n count value)
  __Cont_get__ ,(return)
  __Number_subtract__ n count ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return count value cur) ,()
  Cur_char cur ,(c)
  Hex_digit c ,(d)
  __if__ (,() __is_null__ d) (,() return count value cur) ,()
  num "16" ,(base)
  __Number_multiply__ value base ,(value)
  __Number_add__ value d ,(value)
  num "1" ,(one)
  __Number_add__ count one ,(count)
  Cur_next cur ,(cur)
  Hex_read_from cur n count value)

;; 16 進の数字の値。数字でなければ null
(define Hex_digit ,(c)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ c "") (,() return __NULL__) ,()
  num "0" ,(zero)
  __String_find__ __print_exit_error__ "0123456789abcdef" c zero ,(lower)
  __unless__ (,() __is_null__ lower) (,() return lower) ,()
  __String_find__ __print_exit_error__ "0123456789ABCDEF" c zero ,(upper)
  __NULL__ upper)

;; たまったバイト（逆順）を UTF-8 として読んで out につなげる
(define Utf8_flush ,(out bytes)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ bytes) (,() return out) ,()
  List_reverse bytes ,(bytes)
  Utf8_decode bytes out)

;; Python の decode('utf-8', 'replace') と同じく、先頭のバイトから続くバイトが足りなければ、
;; そこまでを1つの U+FFFD にする
(define Utf8_decode ,(bytes out)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ bytes) (,() return out) ,()
  __LList_uncons__ __print_exit_error__ bytes ,(b rest)
  Utf8_lead b ,(need initial)
  __if__ (,() __is_null__ need)
    (,()
      Utf8_replacement out ,(out)
      Utf8_decode rest out ,(out)
      return out) ,()
  Utf8_continue rest need initial ,(ok code rest2 used)
  __if_then_else__ ok
    (,()
      __String_fromCode__ __print_exit_error__ code ,(ch)
      __String_concat__ out ch ,(out)
      __NULL__ out rest2)
    (,()
      Utf8_replacement out ,(out)
      __NULL__ out rest2) ,(out rest)
  Utf8_decode rest out)

;; 先頭のバイトから、続くバイトの数と、値の最初の部分。先頭のバイトになれなければ null
(define Utf8_lead ,(b)
  __Cont_get__ ,(return)
  num "128" ,(x80)
  __Number_subtract__ b x80 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "0" ,(z) return z b) ,()
  num "194" ,(xC2)
  __Number_subtract__ b xC2 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() return __NULL__ __NULL__) ,()
  num "224" ,(xE0)
  __Number_subtract__ b xE0 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "1" ,(n) num "192" ,(m) __Number_subtract__ b m ,(v) return n v) ,()
  num "240" ,(xF0)
  __Number_subtract__ b xF0 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "2" ,(n) __Number_subtract__ b xE0 ,(v) return n v) ,()
  num "245" ,(xF5)
  __Number_subtract__ b xF5 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "3" ,(n) __Number_subtract__ b xF0 ,(v) return n v) ,()
  __NULL__ __NULL__ __NULL__)

(define Utf8_replacement ,(out)
  num "65533" ,(code)
  __String_fromCode__ __print_exit_error__ code ,(ch)
  __String_concat__ out ch)

;; 続くバイトを need 個読む。すべて続くバイトなら真、値、残り。そうでなければ偽と、続くバイトでないところからの残り
(define Utf8_continue ,(bytes need value)
  __Cont_get__ ,(return)
  __if__ (,() __Number_is_zero__ need) (,() return __TRUE__ value bytes need) ,()
  __if__ (,() __is_null__ bytes) (,() return __FALSE__ value bytes need) ,()
  __LList_uncons__ __print_exit_error__ bytes ,(b rest)
  num "128" ,(x80)
  num "191" ,(xBF)
  __Number_subtract__ b x80 ,(lo)
  __Number_subtract__ xBF b ,(hi)
  __Number_is_negative__ lo ,(below)
  __Number_is_negative__ hi ,(above)
  __or__ below above ,(bad)
  __if__ bad (,() return __FALSE__ value bytes need) ,()
  num "64" ,(x40)
  __Number_multiply__ value x40 ,(value)
  __Number_add__ value lo ,(value)
  num "1" ,(one)
  __Number_subtract__ need one ,(need)
  Utf8_continue rest need value)


;; ── JavaScript の字句（算術評価 (( )) と算術置換 $(( )) の SJS式の範囲。consh/SAFEJS-PLAN-ja.md の 2.1）──
;; Js_scan は、今の位置から、括弧、文字列、テンプレート、コメント、正規表現の外にある term（算術評価の )）の手前までを
;; コードとして読み、コードに現れる名前（. の後ろでないもの）を集める（Ps_arith）。
;; st は、"code"（読んだコード）、"stack"（開いている括弧）、"re"（次に正規表現を置けるか）、"dot"（. の後か）、
;; "seen" と "names"（集めた名前）、"term"、"lines"（改行の後も読むか）を持つ Dict

(define Js_put ,(st key value)
  __Dict_put__ st key value)

(define Js_get ,(st key)
  __Dict_lookup_or__ st key __print_exit_error__)

;; 今の文字をコードに足して、1文字進む（行継続も読み飛ばさない）
(define Js_take ,(p st)
  Ps_raw_char p ,(c)
  Js_get st "code" ,(code)
  __String_concat__ code c ,(code)
  Js_put st "code" code ,()
  Ps_raw_next p)

;; 次の文字（今の文字の次。行継続も読み飛ばさない）
(define Js_next_char ,(p)
  Ps_get p "cur" ,(cur)
  Cur_next cur ,(next)
  Cur_char next)

(define Js_scan ,(p st)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  Js_get st "stack" ,(stack)
  __is_null__ stack ,(outside)
  Js_get st "lines" ,(lines)
  __String_equal__ c "" ,(test__) __if__ test__
    (,()
      __if__ lines (,() Ps_error p "unterminated ((") ,()
      __if__ outside return ,()
      Ps_error p "unterminated JavaScript") ,()
  __String_equal__ c "\n" ,(nl)
  __String_equal__ c "\r" ,(cr)
  Js_next_char p ,(d)
  __String_equal__ d "\n" ,(crlf)
  __and__ cr crlf ,(crlf)
  __or__ nl crlf ,(newline)
  __not__ lines ,(stopAtNewline)
  __and__ newline outside ,(test__)
  __and__ test__ stopAtNewline ,(test__) __if__ test__ return ,()
  Js_get st "term" ,(term)
  Is_term c term ,(isTerm)
  __and__ isTerm outside ,(test__) __if__ test__ return ,()
  Js_token p st c ,()
  Js_scan p st)

;; c で始まるトークンを読んでコードに足し、正規表現を置けるか（"re"）と . の後か（"dot"）を更新する
(define Js_token ,(p st c)
  __Cont_get__ ,(return)
  Ch_in c " \t\r\n" ,(test__) __if__ test__ (,() Js_take p st ,() return) ,()
  Js_ident_start c ,(test__) __if__ test__
    (,()
      Js_word p st "" ,(word)
      Js_get st "dot" ,(dot)
      __unless__ dot (,() Js_name st word) ,()
      Js_regex_after word ,(re)
      Js_put st "re" re ,()
      Js_put st "dot" __FALSE__ ,()
      return) ,()
  Js_put st "dot" __FALSE__ ,()
  Is_digit c ,(test__) __if__ test__
    (,()
      Js_number p st ,()
      Js_put st "re" __FALSE__ ,()
      return) ,()
  Ch_in c "'\"" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_string p st c ,()
      Js_put st "re" __FALSE__ ,()
      return) ,()
  __String_equal__ c "`" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_template p st ,()
      return) ,()
  __String_equal__ c "/" ,(test__) __if__ test__
    (,()
      Js_next_char p ,(d)
      __String_equal__ d "/" ,(test__) __if__ test__ (,() Js_line_comment p st ,() return) ,()
      __String_equal__ d "*" ,(test__) __if__ test__
        (,()
          Js_take p st ,()
          Js_take p st ,()
          Js_block_comment p st ,()
          return) ,()
      Js_get st "re" ,(re)
      Js_take p st ,()
      __if__ re
        (,()
          Js_regex p st __FALSE__ ,()
          Js_put st "re" __FALSE__ ,()
          return) ,()
      Js_put st "re" __TRUE__ ,()
      return) ,()
  Ch_in c "([{" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_closer c ,(closer)
      Js_get st "stack" ,(stack)
      __LList_cons__ closer stack ,(stack)
      Js_put st "stack" stack ,()
      Js_put st "re" __TRUE__ ,()
      return) ,()
  Ch_in c ")]}" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_get st "stack" ,(stack)
      __is_null__ stack ,(test__) __unless__ test__
        (,()
          __LList_uncons__ __print_exit_error__ stack ,(top rest)
          Js_put st "stack" rest ,()
          __String_equal__ top "T" ,(test__) __if__ test__ (,() Js_template p st ,() return) ,()) ,()
      __String_equal__ c "}" ,(re)
      Js_put st "re" re ,()
      return) ,()
  __String_equal__ c "." ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_next_char p ,(d)
      __String_equal__ d "." ,(test__) __if__ test__
        (,()
          ;; ... は、後ろの名前を参照にする
          Js_take p st ,()
          Js_take p st ,()
          Js_put st "re" __TRUE__ ,()
          return) ,()
      Js_put st "dot" __TRUE__ ,()
      Js_put st "re" __TRUE__ ,()
      return) ,()
  Js_take p st ,()
  Js_put st "re" __TRUE__)

(define Js_closer ,(c)
  __Cont_get__ ,(return)
  __String_equal__ c "(" ,(test__) __if__ test__ (,() return ")") ,()
  __String_equal__ c "[" ,(test__) __if__ test__ (,() return "]") ,()
  __NULL__ "}")

(define Js_ident_start ,(c)
  __Cont_get__ ,(return)
  Is_ident_start c ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ c "$" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Ch_code_in c "128" "1114111")

(define Js_ident_char ,(c)
  __Cont_get__ ,(return)
  Js_ident_start c ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Is_digit c)

;; 名前を読んでコードに足し、その名前を返す
(define Js_word ,(p st acc)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  Js_ident_char c ,(test__) __unless__ test__ (,() return acc) ,()
  __String_concat__ acc c ,(acc)
  Js_take p st ,()
  Js_word p st acc)

;; 名前を、まだなければ "names" に足す
(define Js_name ,(st name)
  __Cont_get__ ,(return)
  Js_get st "seen" ,(seen)
  __Dict_lookup_or__ seen name (,(key) __NULL__ __NULL__) ,(found)
  __is_null__ found ,(test__) __unless__ test__ return ,()
  __Dict_put__ seen name __TRUE__ ,()
  Js_get st "names" ,(names)
  __LList_cons__ name names ,(names)
  Js_put st "names" names)

;; この名前の後ろの / が正規表現の始まりか
(define Js_regex_after ,(word)
  __Cont_get__ ,(return)
  __NULL__ " return typeof instanceof in of new delete void throw case do else yield await " ,(list)
  __String_concat__ " " word ,(w)
  __String_concat__ w " " ,(w)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ list w zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define Js_number ,(p st)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  Js_ident_char c ,(ident)
  __String_equal__ c "." ,(dot)
  __or__ ident dot ,(test__) __unless__ test__ return ,()
  Js_take p st ,()
  Js_number p st)

;; 引用符 q の文字列の残り。改行では終わりにする（JavaScript の構文エラーにする）
(define Js_string ,(p st q)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
  __String_equal__ c "\n" ,(test__) __if__ test__ return ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Ps_raw_char p ,(d)
      __String_equal__ d "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
      Js_take p st ,()
      Js_string p st q ,()
      return) ,()
  Js_take p st ,()
  __String_equal__ c q ,(test__) __if__ test__ return ,()
  Js_string p st q)

;; テンプレートの残り。${ なら、"stack" に T を積んで戻る（対応する } の後で続きを読む）
(define Js_template ,(p st)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Ps_raw_char p ,(d)
      __String_equal__ d "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
      Js_take p st ,()
      Js_template p st ,()
      return) ,()
  __String_equal__ c "`" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_put st "re" __FALSE__ ,()
      return) ,()
  Js_next_char p ,(d)
  __String_equal__ c "$" ,(dollar)
  __String_equal__ d "{" ,(brace)
  __and__ dollar brace ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Js_take p st ,()
      Js_get st "stack" ,(stack)
      __LList_cons__ "T" stack ,(stack)
      Js_put st "stack" stack ,()
      Js_put st "re" __TRUE__ ,()
      return) ,()
  Js_take p st ,()
  Js_template p st)

;; // のコメント。改行の手前まで
(define Js_line_comment ,(p st)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __String_equal__ c "" ,(end)
  Ch_in c "\r\n" ,(nl)
  __or__ end nl ,(test__) __if__ test__ return ,()
  Js_take p st ,()
  Js_line_comment p st)

;; /* */ のコメントの残り
(define Js_block_comment ,(p st)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
  Js_next_char p ,(d)
  Js_take p st ,()
  __String_equal__ c "*" ,(star)
  __String_equal__ d "/" ,(slash)
  __and__ star slash ,(test__) __if__ test__ (,() Js_take p st ,() return) ,()
  Js_block_comment p st)

;; 正規表現リテラルの残り（最初の / の後）。inClass は [ ] の中か。改行では終わりにする
(define Js_regex ,(p st inClass)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __String_equal__ c "" ,(test__) __if__ test__ (,() Ps_error p "unterminated JavaScript") ,()
  Ch_in c "\r\n" ,(test__) __if__ test__ return ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      Js_take p st ,()
      Ps_raw_char p ,(d)
      Ch_in d "\r\n" ,(test__) __unless__ test__ (,() Js_take p st) ,()
      Js_regex p st inClass ,()
      return) ,()
  Js_take p st ,()
  __String_equal__ c "[" ,(test__) __if__ test__ (,() Js_regex p st __TRUE__ ,() return) ,()
  __String_equal__ c "]" ,(test__) __if__ test__ (,() Js_regex p st __FALSE__ ,() return) ,()
  __String_equal__ c "/" ,(slash)
  __not__ inClass ,(outside)
  __and__ slash outside ,(test__) __if__ test__ (,() Js_word p st "" ,(flags) return) ,()
  Js_regex p st inClass)

;; ── 算術評価 (( SJS式 )) と算術置換 $(( SJS式 ))（consh/SAFEJS-PLAN-ja.md の 2.1）──

;; 今の位置が (( か
(define Ps_at_arith ,(p)
  num "2" ,(two)
  Ps_peek_str p two ,(s)
  __String_equal__ s "((")

;; 今の位置の (( SJS式 )) を読み、SJS式のコードと、コードに現れる名前の節 (names 位置 名前 ...) を返す。
;; (( の後と )) の前には空白（改行も）が要る。SJS式は、JavaScript の字句（括弧、文字列、テンプレート、コメント、
;; 正規表現）を読んで、括弧の外の ) までとし、改行も含める（Js_scan の "lines"）
(define Ps_arith ,(p)
  Ps_pos p ,(pos)
  Ps_advance p "2" ,()
  Ps_raw_char p ,(c)
  Ch_in c " \t\r\n" ,(spaced)
  __unless__ spaced (,() Ps_error_found p "expected a space after '((', but found ") ,()
  __Dict_new__ ,(st)
  __Dict_put__ st "code" "" ,()
  __Dict_put__ st "stack" __NULL__ ,()
  __Dict_put__ st "re" __TRUE__ ,()
  __Dict_put__ st "dot" __FALSE__ ,()
  __Dict_new__ ,(seen)
  __Dict_put__ st "seen" seen ,()
  __Dict_put__ st "names" __NULL__ ,()
  __Dict_put__ st "term" ")" ,()
  __Dict_put__ st "lines" __TRUE__ ,()
  Js_scan p st ,()
  ;; 今の文字は、括弧の外の )
  Js_next_char p ,(d)
  __String_equal__ d ")" ,(closed)
  __unless__ closed (,() Ps_error p "expected '))' (a ')' outside the brackets of the expression)") ,()
  __Dict_lookup_or__ st "code" __print_exit_error__ ,(code)
  __String_length__ code ,(len)
  num "1" ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ code last len ,(lastChar)
  Ch_in lastChar " \t\r\n" ,(spacedEnd)
  __unless__ spacedEnd (,() Ps_error p "expected a space before '))'") ,()
  Ps_advance p "2" ,()
  __Dict_lookup_or__ st "names" __print_exit_error__ ,(names)
  List_reverse names ,(names)
  Node_make "names" pos names ,(namesNode)
  __NULL__ code namesNode)
