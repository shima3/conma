      return r) ,()
  Str_starts s ">>" ,(append)
  Str_starts s "2>" ,(err)
  Ps_c p ,(c)
  __if_then_else__ append (,() __NULL__ ">>") (,()
    __if_then_else__ err (,() __NULL__ "2>") (,() __NULL__ c)) ,(op)
  __String_length__ op ,(len)
  Ps_advance_n p len ,()
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __not__ append ,(notAppend)
  __String_equal__ c "(" ,(paren)
  __and__ notAppend paren ,(isParams)
  __if__ isParams
    (,()
      Ps_params p ,(params)
      L2 op params ,(children)
      Node_make "redir" pos children ,(r)
      return r) ,()
  Ps_is_word_start p ,(start)
  Ps_at_comment p ,(comment)
  __not__ start ,(noWord)
  __or__ noWord comment ,(bad)
  __if__ bad (,() Ps_error_found p "expected a redirection target, but found ") ,()
  Ps_word p ,(word)
  L2 op word ,(children)
  Node_make "redir" pos children)

;; ── 語 ──

;; (word 位置 語要素 …)
(define Ps_word ,(p)
  Ps_pos p ,(pos)
  Ps_word_elems p __NULL__ ,(elems)
  List_reverse elems ,(elems)
  Node_make "word" pos elems)

;; acc は逆順の語要素
(define Ps_word_elems ,(p acc)
  __Cont_get__ ,(return)
  Ps_skip p ,()
  Ps_raw_pos p ,(epos)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "'")
    (,()
      Ps_sq p ,(elem)
      __LList_cons__ elem acc ,(acc)
      Ps_word_elems p acc ,(acc)
      return acc) ,()
  __if__ (,() __String_equal__ c "\"")
    (,()
      Ps_dq p ,(elem)
      __LList_cons__ elem acc ,(acc)
      Ps_word_elems p acc ,(acc)
      return acc) ,()
  __if__ (,() __String_equal__ c "$")
    (,()
      Ps_peek p "1" ,(d)
      __if_then_else__ (,() __String_equal__ d "'")
        (,() Ps_ansi_c p)
        (,() Ps_dollar p) ,(elem)
      __if_then_else__ (,() __is_null__ elem)
        (,()
          Lit_add acc "$" epos ,(acc)
          Ps_advance p "1" ,()
          __NULL__ acc)
        (,() __LList_cons__ elem acc) ,(acc)
      Ps_word_elems p acc ,(acc)
      return acc) ,()
  __if__ (,() __String_equal__ c "\\")
    (,()
      Ps_advance p "1" ,()
      Ps_raw_char p ,(ch)
      __if__ (,() __String_equal__ ch "") (,() Ps_error p "\\ at the end of input") ,()
      L1 ch ,(children)
      Node_make "esc" epos children ,(elem)
      Ps_raw_next p ,()
      __LList_cons__ elem acc ,(acc)
      Ps_word_elems p acc ,(acc)
      return acc) ,()
  Ps_is_bare p ,(bare)
  __unless__ bare (,() return acc) ,()
  ;; 裸文字の並びをまとめて読み、1回で lit に加える（1文字ずつより速い。結果は同じ）
  Ps_bare_run p "" ,(run)
  Lit_add acc run epos ,(acc)
  Ps_word_elems p acc)

;; 今の文字から、裸文字の並びを読む（行継続は読み飛ばす）。今の文字は裸文字である
(define Ps_bare_run ,(p acc)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return acc) ,()
  num "0" ,(zero)
  __String_find__ __print_exit_error__ " \t\n;'(){}|&><\"$\\" c zero ,(stop)
  __unless__ (,() __is_null__ stop) (,() return acc) ,()
  __if__ (,() __String_equal__ c "\r")
    (,()
      Ps_peek p "1" ,(d)
      __if__ (,() __String_equal__ d "\n") (,() return acc) ,()) ,()
  __String_concat__ acc c ,(acc)
  Ps_advance p "1" ,()
  Ps_bare_run p acc)

;; 逆順の語要素 acc に文字列 s を加える。先頭が lit ならつなげる
(define Lit_add ,(acc s pos)
  __Cont_get__ ,(return)
  __unless__ (,() __is_null__ acc)
    (,()
      __LList_uncons__ __print_exit_error__ acc ,(head rest)
      Node_split head ,(tag hpos children)
      __if__ (,() __String_equal__ tag "lit")
        (,()
          List_first children ,(text)
          __String_concat__ text s ,(text)
          L1 text ,(children)
          Node_make "lit" hpos children ,(lit)
          __LList_cons__ lit rest ,(acc)
          return acc) ,()) ,()
  L1 s ,(children)
  Node_make "lit" pos children ,(lit)
  __LList_cons__ lit acc)

;; '...'。中では行継続を取り除かない
(define Ps_sq ,(p)
  Ps_raw_pos p ,(start)
  Ps_raw_next p ,()
  Ps_raw_until p "'" "" start "unterminated '" ,(text)
  Ps_raw_next p ,()
  L1 text ,(children)
  Node_make "sq" start children)

;; 文字 stop の前までの文字列（行継続も取り除かない）。入力が終われば、位置 start で msg のエラー
(define Ps_raw_until ,(p stop acc start msg)
  __Cont_get__ ,(return)
  Ps_raw_char p ,(c)
  __if__ (,() __String_equal__ c "") (,() Ps_error_at p start msg) ,()
  __if__ (,() __String_equal__ c stop) (,() return acc) ,()
  __String_concat__ acc c ,(acc)
  Ps_raw_next p ,()
  Ps_raw_until p stop acc start msg)

;; "..."
(define Ps_dq ,(p)
  Ps_raw_pos p ,(start)
  Ps_advance p "1" ,()
  Ps_dq_elems p start __NULL__ ,(elems)
  List_reverse elems ,(elems)
  Node_make "dq" start elems)

(define Ps_dq_elems ,(p start acc)
  __Cont_get__ ,(return)
  Ps_skip p ,()
  Ps_raw_pos p ,(epos)
  Ps_raw_char p ,(raw)
  __if__ (,() __String_equal__ raw "") (,() Ps_error_at p start "unterminated \"") ,()
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "\"") (,() Ps_advance p "1" ,() return acc) ,()
  __if__ (,() __String_equal__ c "$")
    (,()
      Ps_dollar p ,(elem)
      __if_then_else__ (,() __is_null__ elem)
        (,()
          Lit_add acc "$" epos ,(acc)
          Ps_advance p "1" ,()
          __NULL__ acc)
        (,() __LList_cons__ elem acc) ,(acc)
      Ps_dq_elems p start acc ,(acc)
      return acc) ,()
  __if__ (,() __String_equal__ c "\\")
    (,()
      Ps_advance p "1" ,()
      Ps_raw_char p ,(ch)
      __if__ (,() __String_equal__ ch "") (,() Ps_error_at p start "unterminated \"") ,()
      Ps_raw_next p ,()
      Ch_in ch "\"$\\" ,(kept)
      __if_then_else__ kept (,() __NULL__ ch) (,() __String_concat__ "\\" ch) ,(s)
      Lit_add acc s epos ,(acc)
      Ps_dq_elems p start acc ,(acc)
      return acc) ,()
  ;; ", $, \ のどれでもない文字の並びをまとめて読む
  Ps_dq_run p "" ,(run)
  Lit_add acc run epos ,(acc)
  Ps_dq_elems p start acc)

;; 二重引用符の中で、", $, \ と入力の終わりの前までの文字を読む（行継続は読み飛ばす）
(define Ps_dq_run ,(p acc)
  __Cont_get__ ,(return)
  Ps_c p ,(c)
  __if__ (,() __String_equal__ c "") (,() return acc) ,()
  num "0" ,(zero)
  __String_find__ __print_exit_error__ "\"$\\" c zero ,(stop)
  __unless__ (,() __is_null__ stop) (,() return acc) ,()
  __String_concat__ acc c ,(acc)
  Ps_advance p "1" ,()
  Ps_dq_run p acc)

;; 変数参照かコマンド置換の語要素。作れなければ null を返し、$ は読まない
(define Ps_dollar ,(p)
  __Cont_get__ ,(return)
  Ps_pos p ,(pos)
  Ps_peek p "1" ,(c)
  ;; $(( は算術置換（consh/SAFEJS-PLAN-ja.md の 2.1）
  Ps_peek p "2" ,(c2)
  __String_equal__ c "(" ,(open1)
  __String_equal__ c2 "(" ,(open2)
  __and__ open1 open2 ,(test__) __if__ test__
    (,()
      Ps_advance p "1" ,()
      Ps_arith p ,(code namesNode)
      L2 code namesNode ,(children)
      Node_make "arithsubst" pos children ,(e)
      return e) ,()
  __if__ (,() __String_equal__ c "(")
    (,()
      Ps_advance p "2" ,()
      Ps_script p ")" ,(script)
      Ps_advance p "1" ,()
      L1 script ,(children)
      Node_make "subst" pos children ,(e)
      return e) ,()
  Ps_peek p "2" ,(c2)
  __String_equal__ c "{" ,(brace)
  __String_equal__ c2 "-" ,(dash)
  __if__ (,() __and__ brace dash)
    (,()
      Ps_advance p "3" ,()
      Ps_is_word_start p ,(start)
      __unless__ start (,() Ps_error_found p "expected a pattern after '${-', but found ") ,()
      Ps_word p ,(word)
      Ps_c p ,(d)
      __unless__ (,() __String_equal__ d "}") (,() Ps_error_found p "expected '}', but found ") ,()
      Ps_advance p "1" ,()
      L1 word ,(children)
      Node_make "glob" pos children ,(e)
      return e) ,()
  __if__ brace (,() Ps_bvar p pos ,(e) return e) ,()
  Is_ident_start c ,(ident)
  __if__ ident
    (,()
      Ps_advance p "1" ,()
      Ps_ident p ,(name)
      L1 name ,(children)
      Node_make "var" pos children ,(e)
      return e) ,()
  Is_digit c ,(digit)
  Ch_in c "@#?!$" ,(special)
  __or__ digit special ,(single)
  __unless__ single (,() return __NULL__) ,()
  Ps_advance p "2" ,()
  L1 c ,(children)
  Node_make "var" pos children)

;; ${名前} と ${名前-値}。名前が作れなければ null
(define Ps_bvar ,(p pos)
  __Cont_get__ ,(return)
  num "2" ,(two)
  Ps_peek_n p two ,(c)
  Is_ident_start c ,(ident)
  Is_digit c ,(digit)
  __if_then_else__ ident
    (,() Ps_name_end p two Is_ident_char)
    (,()
      __if_then_else__ digit
        (,() Ps_name_end p two Is_digit)
        (,()
          __if_then_else__ (,() __String_equal__ c "@")
            (,() num "3")
            (,() __NULL__ two))) ,(k)
  __Number_subtract__ k two ,(len)
  __if__ (,() __Number_is_zero__ len) (,() return __NULL__) ,()
  Ps_peek_n p k ,(after)
  __String_equal__ after "}" ,(close)
  __String_equal__ after "-" ,(dash)
  __or__ close dash ,(ok)
  __unless__ ok (,() return __NULL__) ,()
  Ps_get p "cur" ,(cur)
  Cur_index cur two ,(from)
  Cur_str from len "" ,(name)
  Ps_advance_n p k ,()
  Ps_c p ,(d)
  __if_then_else__ (,() __String_equal__ d "-")
    (,()
      Ps_pos p ,(dpos)
      Ps_advance p "1" ,()
      Ps_value p ,(value)
      __if_then_else__ (,() __is_null__ value) (,() __NULL__ __NULL__) (,() L1 value) ,(vchildren)
      Node_make "default" dpos vchildren ,(default)
      Ps_c p ,(e)
      __unless__ (,() __String_equal__ e "}") (,() Ps_error_found p "expected '}', but found ") ,()
      L2 name default)
    (,() L1 name) ,(children)
  Ps_advance p "1" ,()
  Node_make "bvar" pos children)

;; k 文字先から、文字が ok であるあいだ進んだ位置
(define Ps_name_end ,(p k ok)
  __Cont_get__ ,(return)
  Ps_peek_n p k ,(c)
  ok c ,(more)
  __unless__ more (,() return k) ,()
  num "1" ,(one)
  __Number_add__ k one ,(k)
