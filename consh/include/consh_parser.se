  Redirs_node redirs)

(define Ps_redirects ,(p acc)
  __Cont_get__ ,(return)
  Ps_redirect p ,(r)
  __LList_cons__ r acc ,(acc)
  Ps_skip_spaces p ,(n)
  __if__ (,() __Number_is_zero__ n) (,() List_reverse acc ,(rs) return rs) ,()
  Ps_at_comment p ,(comment)
  __if__ comment (,() List_reverse acc ,(rs) return rs) ,()
  Ps_at_redirect p ,(redir)
  __if__ redir (,() Ps_redirects p acc ,(rs) return rs) ,()
  Ps_is_word_start p ,(start)
  __if__ start (,() Ps_error p "a word after a redirection") ,()
  List_reverse acc)

;; "for" スペース+ 変数名 スペース+ "in" {スペース+ 語} {スペース} (";" | 行末) {空白} "do" スクリプト "done"。
;; for の節の子（名前、(in …)、スクリプト）を返す
(define Ps_for ,(p)
  Ps_advance p "3" ,()
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  Is_ident_start c ,(ident)
  __Number_is_zero__ n ,(noSpace)
  __not__ ident ,(noIdent)
  __or__ noSpace noIdent ,(bad)
  __if__ bad (,() Ps_error_found p "expected a variable name after for, but found ") ,()
  Ps_ident p ,(name)
  Ps_skip_spaces p ,(n)
  __Number_is_zero__ n ,(noSpace)
  num "2" ,(two)
  Ps_peek_str p two ,(s)
  Ps_peek p "2" ,(c)
  __String_equal__ c "" ,(e1)
  Is_space c ,(e2)
  __String_equal__ c ";" ,(e3)
  Ps_at_newline p "2" ,(e4)
  __or__ e1 e2 ,(after)
  __or__ after e3 ,(after)
  __or__ after e4 ,(after)
  __String_equal__ s "in" ,(isIn)
  __and__ isIn after ,(good)
  __not__ good ,(bad)
  __or__ noSpace bad ,(bad)
  __if__ bad (,() Ps_error_found p "expected in, but found ") ,()
  Ps_pos p ,(ipos)
  Ps_advance p "2" ,()
  Ps_for_words p __NULL__ ,(words)
  Node_make "in" ipos words ,(inNode)
  Ps_c p ,(c)
  __if_then_else__ (,() __String_equal__ c ";")
    (,()
      Ps_advance p "1" ,()
      Ps_mark_sep p)
    (,()
      Ps_at_comment p ,(comment)
      __if__ comment (,() Ps_skip_comment p) ,()
      Ps_newline p ,(nl)
      __unless__ nl (,() Ps_error_found p "expected ';' or a newline, but found ") ,()
      Ps_consume_newline p) ,()
  Ps_before_do p ,()
  Ps_expect_keyword p "do" ,(dpos)
  Ps_script p __NULL__ ,(body)
  Ps_expect_keyword p "done" ,(epos)
  __LList_cons__ body __NULL__ ,(children)
  __LList_cons__ inNode children ,(children)
  __LList_cons__ name children)

(define Ps_for_words ,(p acc)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  Ps_c p ,(c)
  __String_equal__ c "" ,(e1)
  __String_equal__ c ";" ,(e2)
  Ps_newline p ,(e3)
  Ps_at_comment p ,(e4)
  __or__ e1 e2 ,(end)
  __or__ end e3 ,(end)
  __or__ end e4 ,(end)
  __if__ end (,() List_reverse acc ,(words) return words) ,()
  Ps_is_word_start p ,(start)
  __Number_is_zero__ n ,(noSpace)
  __not__ start ,(noWord)
  __or__ noSpace noWord ,(bad)
  __if__ bad (,() Ps_error_found p "expected a word, ';' or a newline, but found ") ,()
  Ps_word p ,(word)
  __LList_cons__ word acc ,(acc)
  Ps_for_words p acc)

;; do の前には、スペース、改行、行コメントを置ける
(define Ps_before_do ,(p)
  __Cont_get__ ,(return)
  Ps_skip_spaces p ,(n)
  Ps_at_comment p ,(comment)
  __if__ comment (,() Ps_skip_comment p) ,()
  Ps_newline p ,(nl)
  __unless__ nl return ,()
  Ps_consume_newline p ,()
  Ps_before_do p)

;; if、elif ごとに条件と本体のスクリプトを読む。if の節の子（clause …、[else]）を返す
(define Ps_if ,(p)
  Ps_clauses p "if" __NULL__ ,(clauses kw)
  Is_kw kw "else" ,(isElse)
  __if_then_else__ isElse
    (,()
      Ps_expect_keyword p "else" ,(pos)
      Ps_script p __NULL__ ,(body)
      L1 body ,(children)
      Node_make "else" pos children ,(elseNode)
      L1 elseNode)
    (,() __NULL__ __NULL__) ,(elseList)
  Ps_expect_keyword p "fi" ,(fpos)
  __LList_append__ clauses elseList)

(define Ps_clauses ,(p kw acc)
  __Cont_get__ ,(return)
  Is_kw kw "if" ,(isIf)
  Is_kw kw "elif" ,(isElif)
  __or__ isIf isElif ,(more)
  __unless__ more (,() List_reverse acc ,(clauses) return clauses kw) ,()
  Ps_expect_keyword p kw ,(pos)
  Ps_script p __NULL__ ,(cond)
  Ps_expect_keyword p "then" ,(tpos)
  Ps_script p __NULL__ ,(body)
  L2 cond body ,(children)
  Node_make "clause" pos children ,(clause)
  __LList_cons__ clause acc ,(acc)
