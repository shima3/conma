(define Gen_arg_values ,(g scope args code vals)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return code vals) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Gen_expr g scope a ,(c v)
  __String_concat__ code c ,(code)
  __LList_cons__ v vals ,(vals)
  Gen_arg_values g scope rest code vals)

(define Gen_cons_list ,(g vals code list)
  __Cont_get__ ,(return)
  __is_null__ vals ,(test__) __if__ test__ (,() return code list) ,()
  __LList_uncons__ __print_exit_error__ vals ,(v rest)
  Gen_temp g "l" ,(l)
  Cat5 code "__LList_cons__ " v " " list ,(code)
  Cat4 code " ,(" l ") " ,(code)
  Gen_cons_list g rest code l)

;; 呼び出し。o.m(...) と o[k](...) は Sjs_call_member、f?.(...) は f が null か undefined なら undefined
(define Gen_call ,(g scope e)
  Gen_chain g e (,() Gen_call_link g scope e))

(define Gen_call_link ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "callee" ,(callee)
  Sjs_get e "args" ,(args)
  __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(optional)
  Sjs_get callee "t" ,(ct)
  __String_equal__ ct "member" ,(isMember)
  __Dict_lookup_or__ callee "optional" (,(k) __NULL__ __FALSE__) ,(optMember)
  __not__ optMember ,(plainMember)
  __not__ optional ,(plainCall)
  __and__ isMember plainMember ,(x)
  __and__ x plainCall ,(test__) __if__ test__
    (,()
      Sjs_get callee "object" ,(object)
      Gen_chain_object g scope object ,(oc ov)
      Gen_key g scope callee ,(kc kv)
      Gen_args g scope args ,(ac list)
      Gen_temp g "t" ,(v)
      Cat5 oc kc ac "Sjs_call_member G " ov ,(c)
      Cat5 c " " kv " " list ,(c)
      Cat3 c " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      Gen_line_again g ,(again)
      __String_concat__ c again ,(c)
      return c v) ,()
  Gen_chain_object g scope callee ,(fc fv)
  Gen_args g scope args ,(ac list)
  Gen_temp g "t" ,(v)
  __unless__ optional
    (,()
      Cat5 fc ac "Sjs_call " fv " " ,(c)
      Cat4 c list " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      Gen_line_again g ,(again)
      __String_concat__ c again ,(c)
      return c v) ,()
  ;; f?.()：f が null か undefined なら、鎖全体を undefined にする
  __Dict_lookup_or__ g "chainEsc" (,(x) __NULL__ "") ,(esc)
  Gen_temp g "b" ,(b)
  Cat5 fc "Sjs_is_nullish " fv " ,(" b ,(c)
  Cat5 c ") __if__ " b " (,() " esc ,(c)
  Cat3 c " __NULL__) ,() " ac ,(c)
  Cat5 c "Sjs_call " fv " " list ,(c)
  Cat3 c " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; アロー関数と function 式：Sjs_function G (,(args) __Cont_get__ ,(return) 引数を束縛する 本体 return __NULL__)
(define Gen_function ,(g scope e name)
  __Cont_get__ ,(return)
  Sjs_get e "params" ,(params)
  Sjs_get e "body" ,(body)
  Sjs_get e "expr" ,(expr)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(inner)
  Gen_temp g "args" ,(args)
  Gen_params g inner params args "" ,(bind)
  ;; 本体の yield が、async ジェネレータのもの（Sjs_ag_yield）か
  __Dict_lookup_or__ e "gen" (,(k) __NULL__ __FALSE__) ,(isGen)
  __Dict_lookup_or__ e "async" (,(k) __NULL__ __FALSE__) ,(isAsync)
  __and__ isGen isAsync ,(isAsyncGen)
  __Dict_lookup_or__ g "asyncGen" (,(k) __NULL__ __FALSE__) ,(savedAsyncGen)
  __Dict_put__ g "asyncGen" isAsyncGen ,()
  __is_null__ body ,(concise)
  __if_then_else__ concise
    (,() Gen_expr g inner expr ,(c v) Cat4 c "return " v " ,() ")
    (,()
      Sjs_get body "body" ,(stmts)
      Gen_temp g "h" ,(h)
      Gen_cx __TRUE__ "" "" ,(fcx)
      Gen_cx_with fcx "ret" "return" ,(fcx)
      Gen_cx_with fcx "retH" h ,(fcx)
      Gen_block_code g inner stmts fcx ,(code)
      Cat4 "Sjs_handlers ,(" h ") " code) ,(bodyCode)
  __Dict_put__ g "asyncGen" savedAsyncGen ,()
  Gen_temp g "t" ,(v)
  Gen_quote name ,(qn)
  ;; ジェネレータ：呼び出しは引数を入れてジェネレータのオブジェクトを返し、本体は、next で動かす thunk にする
  ;; async 関数も同じ形で、本体の thunk を Sjs_async に渡す（結果は Promise）。async ジェネレータは Sjs_async_generator
  __or__ isGen isAsync ,(wrapped)
  __if__ wrapped
    (,()
      Gen_temp g "gen" ,(gv)
      __if_then_else__ isAsyncGen (,() __NULL__ "Sjs_async_generator G (,() __Cont_get__ ,(return) ") (,()
      __if_then_else__ isAsync (,() __NULL__ "Sjs_async G (,() __Cont_get__ ,(return) ") (,() __NULL__ "Sjs_generator G (,() __Cont_get__ ,(return) ")) ,(head)
      Cat3 head bodyCode "return __NULL__) ,(" ,(gc)
      Cat5 gc gv ") return " gv " " ,(bodyCode)
      Cat5 "Sjs_function G " qn " (,(" args ") __Cont_get__ ,(return) " ,(c)
      Cat4 c bind bodyCode ") ,(" ,(c)
      Cat3 c v ") " ,(c)
      return c v) ,()
  Cat5 "Sjs_function G " qn " (,(" args ") __Cont_get__ ,(return) " ,(c)
  Cat4 c bind bodyCode "return __NULL__) ,(" ,(c)
  Cat3 c v ") " ,(c)
  __NULL__ c v)

(define Gen_params ,(g scope params args acc)
  Gen_pattern_names_list params __NULL__ ,(names)
  Gen_hoist_names g scope names __FALSE__ acc ,(acc)
  Gen_params_bind g scope params args acc)

;; 引数の形に、引数の LList args の先頭から入れる。rest は残りの配列
(define Gen_params_bind ,(g scope params args acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(param rest)
  Sjs_get param "t" ,(t)
  __String_equal__ t "rest" ,(isRest)
  __if__ isRest
    (,()
      Sjs_get param "target" ,(target)
      Gen_temp g "t" ,(a)
      Cat5 acc "Sjs_array G " args " ,(" a ,(acc)
      __String_concat__ acc ") " ,(acc)
      Gen_pattern g scope target a __TRUE__ ,(c)
      __String_concat__ acc c ,(acc)
      return acc) ,()
  Gen_temp g "a" ,(a)
  Gen_temp g "r" ,(r)
  Cat5 acc "Sjs_arg " args " ,(" a ,(acc)
  Cat3 acc " " r ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_pattern g scope param a __TRUE__ ,(c)
  __String_concat__ acc c ,(acc)
  Gen_params_bind g scope rest r acc)
;; ── 段階 B5：ジェネレータ ──

;; yield 式と yield* 式（値は next に渡された値と、yield* では委ねた先の戻り値）
(define Gen_yield ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "arg" ,(arg)
  Sjs_get e "delegate" ,(delegate)
  Gen_temp g "t" ,(v)
  __is_null__ arg ,(none)
  __if_then_else__ none (,() __NULL__ "" "__NULL__") (,() Gen_expr g scope arg) ,(c a)
  __Dict_lookup_or__ g "asyncGen" (,(k) __NULL__ __FALSE__) ,(inAsyncGen)
  __if_then_else__ inAsyncGen
    (,() __if_then_else__ delegate (,() __NULL__ "Sjs_ag_yield_star G ") (,() __NULL__ "Sjs_ag_yield "))
    (,() __if_then_else__ delegate (,() __NULL__ "Sjs_yield_star ") (,() __NULL__ "Sjs_yield ")) ,(f)
  Cat5 c f a " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; ── 型の分かる被演算子（速くするため。consh/sjs/README-ja.md の「速くしたもの」）──
;; 変換の状態 g は、"types"（被演算子 → "number" か "boolean"）、"consts"（数のリテラルの文字列 → 定数の変数名）と
;; "constCode"（定数を作る手順。プログラムの始めに置く）、"numNames"（数だけを入れる名前。Gen_num_names）を持つ。
;; 型が分かれば、算術と比較は、型の確認を省いてプリミティブにし、条件は Sjs_truthy を省く

(define Gen_state ,(root)
  __Dict_new__ ,(g)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(counter)
  __Dict_put__ g "n" counter ,()
  __Dict_new__ ,(types)
  __Dict_put__ g "types" types ,()
  __Dict_new__ ,(consts)
  __Dict_put__ g "consts" consts ,()
  __Ref_new__ "" ,(constCode)
  __Dict_put__ g "constCode" constCode ,()
  Gen_num_names root ,(numNames)
  __Dict_put__ g "numNames" numNames ,()
  __NULL__ g)

(define Gen_type_set ,(g v kind)
  __Dict_lookup_or__ g "types" __print_exit_error__ ,(types)
  __Dict_put__ types v kind)

(define Gen_type ,(g v)
  __Dict_lookup_or__ g "types" __print_exit_error__ ,(types)
  __Dict_lookup_or__ types v (,(k) __NULL__ ""))

(define Gen_is_num_operand ,(g v)
  Gen_type g v ,(t)
  __String_equal__ t "number")

;; 数のリテラルの定数（同じ文字列は 1 つ）
(define Gen_const ,(g text)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ g "consts" __print_exit_error__ ,(consts)
  __Dict_lookup_or__ consts text (,(k) __NULL__ __NULL__) ,(known)
  __is_null__ known ,(test__) __unless__ test__ (,() return known) ,()
  Gen_temp g "k" ,(k)
  __Dict_put__ consts text k ,()
  Gen_type_set g k "number" ,()
  Gen_quote text ,(q)
  __Dict_lookup_or__ g "constCode" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(code)
  Cat5 code "__Number_fromString__ (,(msg) Sjs_throw \"SyntaxError\" \"a bad number\") " q " ,(" k ,(code)
  __String_concat__ code ") " ,(code)
  __Ref_set__ ref code ,()
  __NULL__ k)

(define Gen_const_code ,(g)
  __Dict_lookup_or__ g "constCode" __print_exit_error__ ,(ref)
  __Ref_get__ ref)

;; 式の値の種類が、式の形だけで分かるなら "number" か "boolean"（分からなければ ""）。算術は、数でなければエラーなので数
(define Gen_static_kind ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__ (,() return "number") ,()
  __String_equal__ t "update" ,(test__) __if__ test__ (,() return "number") ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_static_kind inner ,(k) return k) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,() Sjs_get e "text" ,(text) Sjs_in_words text "true false" ,(b) __if__ b (,() return "boolean") ,() return "") ,()
  __String_equal__ t "unary" ,(isUnary)
  __String_equal__ t "binary" ,(isBinary)
  __String_equal__ t "assign" ,(isAssign)
  __or__ isUnary isBinary ,(x) __or__ x isAssign ,(withOp)
  __unless__ withOp (,() return "") ,()
  Sjs_get e "op" ,(op)
  __if__ isUnary
    (,()
      Sjs_in_words op "- + ~" ,(test__) __if__ test__ (,() return "number") ,()
      __String_equal__ op "!" ,(test__) __if__ test__ (,() return "boolean") ,()
      return "") ,()
  __if__ isBinary
    (,()
      Sjs_in_words op "+ - * / % ** & | ^ << >> >>>" ,(test__) __if__ test__ (,() return "number") ,()
      Sjs_in_words op "< <= > >= === !== in" ,(test__) __if__ test__ (,() return "boolean") ,()
      return "") ,()
  Sjs_in_words op "+= -= *= /= %= **= &= |= ^= <<= >>= >>>=" ,(test__) __if__ test__ (,() return "number") ,()
  __String_equal__ op "=" ,(test__) __if__ test__ (,() Sjs_get e "value" ,(value) Gen_static_kind value ,(k) return k) ,()
  __NULL__ "")

;; 名前を読んだ値 v：数だけを入れる名前の、局所の変数なら、数
(define Gen_numeric_read ,(g scope e v)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "id" ,(test__) __unless__ test__ return ,()
  Sjs_get e "name" ,(name)
  Gen_lookup scope name ,(var isConst)
  __is_null__ var ,(test__) __if__ test__ return ,()
  __Dict_lookup_or__ g "numNames" __print_exit_error__ ,(numNames)
  __Dict_lookup_or__ numNames name (,(k) __NULL__ __FALSE__) ,(isNum)
  __if__ isNum (,() Gen_type_set g v "number") ,())

;; 条件の値 val の真偽：真偽値と分かれば、そのまま
(define Gen_truth ,(g val)
  __Cont_get__ ,(return)
  Gen_type g val ,(t)
  __String_equal__ t "boolean" ,(test__) __if__ test__ (,() return "" val) ,()
  Gen_temp g "b" ,(b)
  Cat5 "Sjs_truthy " val " ,(" b ") " ,(c)
  __NULL__ c b)

;; 2 項演算 op の手順（値は v）。+、-、* は、両方が数と分かればプリミティブ、片方だけなら、もう片方だけを確かめる。
;; < と > は、両方が数ならプリミティブ（差が負か。NaN との比較は差が NaN なので偽）
(define Gen_arith ,(g op lv rv v)
  __Cont_get__ ,(return)
  Gen_is_num_operand g lv ,(ln)
  Gen_is_num_operand g rv ,(rn)
  __and__ ln rn ,(both)
  __String_equal__ op "<" ,(isLt)
  __String_equal__ op ">" ,(isGt)
  __or__ isLt isGt ,(order)
  __and__ order both ,(test__) __if__ test__
    (,()
      Gen_temp g "d" ,(d)
      __if_then_else__ isLt (,() __NULL__ lv rv) (,() __NULL__ rv lv) ,(a b)
      Cat5 "__Number_subtract__ " a " " b " ,(" ,(c)
      Cat5 c d ") __Number_is_negative__ " d " ,(" ,(c)
      Cat3 c v ") " ,(c)
      return c) ,()
  Gen_arith_prim op ,(prim)
  __is_null__ prim ,(simple)
  __or__ ln rn ,(some)
  __not__ simple ,(hasPrim)
  __and__ hasPrim some ,(test__) __if__ test__
    (,()
      Cat5 prim " " lv " " rv ,(c)
      Cat3 c " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      __if__ both (,() return c) ,()
      Gen_quote op ,(q)
      __if_then_else__ ln (,() __NULL__ rv) (,() __NULL__ lv) ,(other)
      Cat5 "Sjs_need " q " " other " ,() " ,(check)
      __String_concat__ check c ,(c)
      return c) ,()
  Gen_binary_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Cat5 f " " lv " " rv ,(c)
  Cat3 c " ,(" v ,(c)
  __String_concat__ c ") ")

(define Gen_arith_prim ,(op)
  __Cont_get__ ,(return)
  __String_equal__ op "+" ,(test__) __if__ test__ (,() return "__Number_add__") ,()
  __String_equal__ op "-" ,(test__) __if__ test__ (,() return "__Number_subtract__") ,()
  __String_equal__ op "*" ,(test__) __if__ test__ (,() return "__Number_multiply__") ,()
  __NULL__ __NULL__)

;; 生成したコード code が、変数名 name を使うか（名前の後は空白か閉じ括弧）
(define Gen_uses ,(code name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_concat__ name " " ,(a)
  __String_concat__ name ")" ,(b)
  __String_find__ __print_exit_error__ code a zero ,(at1)
  __String_find__ __print_exit_error__ code b zero ,(at2)
  __is_null__ at1 ,(n1)
  __is_null__ at2 ,(n2)
  __and__ n1 n2 ,(none)
  __not__ none)

;; ── 数だけを入れる名前 ──
;; プログラム全体で、名前の宣言がすべて、数と分かる初期値の let か const で、名前への代入がすべて数と分かる値
;; （= の右辺が数、+= などの算術の代入、++、--）であり、引数、分割代入、for...of と for...in の変数、catch の
;; 変数、関数の名前に使われていない名前。局所の変数として読んだ値は数とする（Gen_numeric_read）。
;; 名前で決めるので、同じ名前の別の変数も同じ条件を満たす（控えめ）

(define Gen_num_names ,(root)
  __Dict_new__ ,(decl)
  __Dict_new__ ,(bad)
  Gen_scan root decl bad ,()
  __Dict_new__ ,(result)
  __Dict_keys__ decl ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  Gen_collect acc ,(sink)
  keys sink ,(s)
  __Ref_get__ acc ,(names)
  Gen_num_names_keep names bad result ,()
  __NULL__ result)

(define Gen_num_names_keep ,(names bad result)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  __Dict_lookup_or__ bad n (,(k) __NULL__ __FALSE__) ,(isBad)
  __unless__ isBad (,() __Dict_put__ result n __TRUE__) ,()
  Gen_num_names_keep rest bad result)

;; Seq（__Dict_keys__）の要素を、Ref の LList に集める Sink
(define Gen_collect ,(acc)
  __Ref_new__ __NULL__ ,(self)
  __Ref_set__ self (,(x) __Ref_get__ acc ,(l) __LList_cons__ x l ,(l) __Ref_set__ acc l ,() __Ref_get__ self) ,()
  __Ref_get__ self)

(define Gen_mark ,(dict names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  __Dict_put__ dict n __TRUE__ ,()
  Gen_mark dict rest)

(define Gen_mark_pattern ,(bad pat)
  __Cont_get__ ,(return)
  __is_null__ pat ,(test__) __if__ test__ return ,()
  __type_name__ pat ,(type)
  __String_equal__ type "Dict" ,(test__) __unless__ test__ return ,()
  Sjs_get pat "t" ,(t)
  __String_equal__ t "member" ,(test__) __if__ test__ return ,()
  Gen_pattern_names pat __NULL__ ,(names)
  Gen_mark bad names)

;; 構文木の節（Dict）か、その LList を見て、宣言（decl）と、数でない使い方（bad）を記録する
(define Gen_scan ,(node decl bad)
  __Cont_get__ ,(return)
  __type_name__ node ,(type)
  __String_equal__ type "LList" ,(test__) __if__ test__ (,() Gen_scan_list node decl bad ,() return) ,()
  __String_equal__ type "Dict" ,(test__) __unless__ test__ return ,()
  __Dict_lookup_or__ node "t" (,(k) __NULL__ "") ,(t)
  Gen_scan_node t node decl bad ,()
  __Dict_keys__ node ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  Gen_collect acc ,(sink)
  keys sink ,(s)
  __Ref_get__ acc ,(ks)
  Gen_scan_fields node ks decl bad)

(define Gen_scan_list ,(list decl bad)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Gen_scan x decl bad ,()
  Gen_scan_list rest decl bad)

(define Gen_scan_fields ,(node keys decl bad)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  __Dict_lookup_or__ node k __print_exit_error__ ,(v)
  Gen_scan v decl bad ,()
  Gen_scan_fields node rest decl bad)

(define Gen_scan_node ,(t node decl bad)
  __Cont_get__ ,(return)
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,()
      Sjs_get node "kind" ,(kind)
      Sjs_in_words kind "let const" ,(lexical)
      Sjs_get node "decls" ,(decls)
      Gen_scan_decls decls lexical decl bad ,()
      return) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__
    (,()
      Sjs_get node "target" ,(target)
      Sjs_get node "op" ,(op)
      Sjs_get target "t" ,(tt)
      __String_equal__ tt "id" ,(isId)
      __unless__ isId (,() Gen_mark_pattern bad target ,() return) ,()
      Sjs_get target "name" ,(name)
      Gen_static_kind node ,(kind)
      __String_equal__ kind "number" ,(test__) __unless__ test__ (,() __Dict_put__ bad name __TRUE__) ,()
      return) ,()
  Sjs_in_words t "forof forin" ,(test__) __if__ test__
    (,() __Dict_lookup_or__ node "target" (,(k) __NULL__ __NULL__) ,(target) Gen_mark_pattern bad target ,() return) ,()
  Sjs_in_words t "function arrow" ,(test__) __if__ test__
    (,()
      Sjs_get node "params" ,(params)
      Gen_pattern_names_list params __NULL__ ,(names)
      Gen_mark bad names ,()
      __Dict_lookup_or__ node "name" (,(k) __NULL__ "") ,(own)
      __String_equal__ own "" ,(test__) __unless__ test__ (,() __Dict_put__ bad own __TRUE__) ,()
      return) ,()
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() Sjs_get node "name" ,(n) __Dict_put__ bad n __TRUE__ ,() return) ,()
  __String_equal__ t "try" ,(test__) __if__ test__
    (,() __Dict_lookup_or__ node "param" (,(k) __NULL__ __NULL__) ,(param) Gen_mark_pattern bad param) ,()
  __nop__)

(define Gen_scan_decls ,(decls lexical decl bad)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "target" ,(target)
  Sjs_get target "t" ,(tt)
  __String_equal__ tt "id" ,(isId)
  __unless__ isId (,() Gen_mark_pattern bad target ,() Gen_scan_decls rest lexical decl bad ,() return) ,()
  Sjs_get target "name" ,(name)
  __Dict_lookup_or__ d "init" (,(k) __NULL__ __NULL__) ,(init)
  __is_null__ init ,(noInit)
  __if_then_else__ noInit (,() __NULL__ "") (,() Gen_static_kind init) ,(kind)
  __String_equal__ kind "number" ,(num)
  __and__ num lexical ,(ok)
  __if_then_else__ ok (,() __Dict_put__ decl name __TRUE__) (,() __Dict_put__ bad name __TRUE__) ,()
  Gen_scan_decls rest lexical decl bad)

;; メンバーを読み書きする関数：キーが数と分かれば、配列の添字の速い道（Sjs_get_index、Sjs_set_index）
(define Gen_get_fn ,(g kv)
  Gen_is_num_operand g kv ,(num)
  __if_then_else__ num (,() __NULL__ "Sjs_get_index G ") (,() __NULL__ "Sjs_get_member G "))

(define Gen_set_fn ,(g kv)
  Gen_is_num_operand g kv ,(num)
  __if_then_else__ num (,() __NULL__ "Sjs_set_index G ") (,() __NULL__ "Sjs_set_member G "))

;; コンマ演算子：式を順に求め、値は最後の式
(define Gen_seq ,(g scope exprs code)
  __LList_uncons__ __print_exit_error__ exprs ,(e rest)
  Gen_expr g scope e ,(c v)
  __String_concat__ code c ,(code)
  __is_null__ rest ,(last)
  __if_then_else__ last (,() __NULL__ code v) (,() Gen_seq g scope rest code))

;; ラベルの付いた継続も、finally を通すものにする
(define Gen_wrap_labels ,(wrap cx labels c)
  __Cont_get__ ,(return)
  __is_null__ labels ,(test__) __if__ test__ (,() return cx c) ,()
  __LList_uncons__ __print_exit_error__ labels ,(kind rest)
  wrap cx kind c ,(cx c)
  Gen_wrap_labels wrap cx rest c)

;; ラベルの付いた文。ループなら、そのループの break と continue にラベルを付ける（Gen_loop）。ほかの文は、
;; break ラベル で抜けられるように、脱出の継続を取る thunk にする
(define Gen_labeled ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "label" ,(label)
  Sjs_get s "body" ,(body)
  Sjs_get body "t" ,(bt)
  Sjs_in_words bt "while for forof dowhile" ,(isLoop)
  __if__ isLoop (,() __Dict_put__ g "label" label ,() Gen_stmt g scope body cx ,(c) return c) ,()
  Gen_temp g "lb" ,(lb)
  Gen_temp g "h" ,(h)
  Cat3 "brk" ":" label ,(bk)
  Gen_cx_label cx bk lb h ,(inner)
  Gen_stmt g scope body inner ,(bodyCode)
  Cat5 "(,() __Cont_get__ ,(" lb ") Sjs_handlers ,(" h ") " ,(c)
  Cat3 c bodyCode "__nop__) ,() ")

;; ── ?. の鎖 ──
;; メンバーと呼び出しの鎖（a?.b.c(d)）で、?. の所の値が null か undefined なら、鎖全体が undefined になる。
;; 鎖のいちばん外の節（g の "inChain" が偽）で、鎖に ?. があれば、脱出の継続を取る thunk にし、?. の所は、
;; その継続（g の "chainEsc"）で undefined を返す。鎖の中の節は、object と callee を "inChain" を真にして求める
;; （括弧、キー、引数は、鎖を切る）
(define Gen_chain ,(g e link)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ g "inChain" (,(x) __NULL__ __FALSE__) ,(inner)
  __Dict_put__ g "inChain" __FALSE__ ,()
  __if__ inner (,() link ,(c v) return c v) ,()
  Gen_chain_optional e ,(opt)
  __unless__ opt (,() link ,(c v) return c v) ,()
  __Dict_lookup_or__ g "chainEsc" (,(x) __NULL__ "") ,(saved)
  Gen_temp g "oc" ,(esc)
  __Dict_put__ g "chainEsc" esc ,()
  link ,(c v)
  __Dict_put__ g "chainEsc" saved ,()
  Gen_temp g "t" ,(t)
  Cat5 "(,() __Cont_get__ ,(" esc ") " c "__NULL__ " ,(code)
  Cat5 code v ") ,(" t ") " ,(code)
  __NULL__ code t)

;; 鎖に ?. があるか
(define Gen_chain_optional ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(opt)
  __if__ opt (,() return __TRUE__) ,()
  __String_equal__ t "member" ,(test__) __if__ test__ (,() Sjs_get e "object" ,(o) Gen_chain_optional o ,(r) return r) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Sjs_get e "callee" ,(f) Gen_chain_optional f ,(r) return r) ,()
  __NULL__ __FALSE__)

;; 鎖の中の節の object か callee を求める
(define Gen_chain_object ,(g scope x)
  __Dict_put__ g "inChain" __TRUE__ ,()
  Gen_expr g scope x)

;; 文脈 cx の continue の継続（"cnt" と、ラベルの付いたもの）のうち、old を指すものを cnt にする
(define Gen_cx_retarget ,(cx old cnt)
  Gen_cx_with cx "cnt" cnt ,(cx)
  __Dict_lookup_or__ cx "labels" (,(x) __NULL__ __NULL__) ,(labels)
  Gen_cx_retarget_labels cx labels old cnt)

(define Gen_cx_retarget_labels ,(cx labels old cnt)
  __Cont_get__ ,(return)
  __is_null__ labels ,(test__) __if__ test__ (,() return cx) ,()
  __LList_uncons__ __print_exit_error__ labels ,(kind rest)
  __Dict_lookup_or__ cx kind (,(x) __NULL__ "") ,(k)
  __String_equal__ k old ,(same)
  __if_then_else__ same (,() Gen_cx_with cx kind cnt) (,() __NULL__ cx) ,(cx)
  Gen_cx_retarget_labels cx rest old cnt)
