(define Gen_name_nodes ,(names acc)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  __Dict_new__ ,(d)
  __Dict_put__ d "name" n ,()
