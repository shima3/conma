;; SJS を ConMa のソースに変換する（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1〜B4）。
;; 構文木（sjs_parse.se）から、main を定義する ConMa のソースの String を作る。実行には sjs_rt.se を使う。
;;
;; 変換の形：
;; * 式は、値を求める手順の並び（「演算子 被演算子 ,(t) 」を並べたもの）と、その値を表す被演算子（変数名、
;;   文字列のリテラル、__TRUE__ など）にする。手順の並びは、そのまま後ろにつなげられる（Gen_expr）。
;; * 文は、手順の並びにする（Gen_stmt）。どの手順も ,(…) で終わるので、文をつなげて最後に __nop__ を置けば本体になる。
;; * 変数（let、const、var、引数）は Ref に入れ、名前ごとに一意の ConMa の変数名（v番号_名前）を付ける。そのため、
;;   ブロックの外に出ても束縛は残るが、名前は変換のときに解決するので、外の同じ名前とは混ざらない。
;;   宣言していない名前は大域の名前（SJS変数）で、文脈 G の Dict に置く（Sjs_global）。
;; * 関数は、引数の LList を受け取る Closure を Sjs_function で包む。本体の最初で __Cont_get__ ,(return) を取り、
;;   return 文はそれを呼ぶ。
;; * if は __if_then_else__、while は、Ref に入れた自分を呼ぶ thunk（末尾で呼ぶので CChain は伸びない）。
;; * &&、||、??、条件演算子は、__if_then_else__ の 2 つの thunk が値を返す形。
;; 変換の状態 g は Dict で、"n" に一時変数の番号の Ref を持つ。scope は Dict（名前 → ConMa の変数名）の LList
;; （内側が先）で、"const:名前" があれば const。
;; sjs_parse.se を使う

(define Sjs_translate ,(text)
  Sjs_parse text ,(program)
  Gen_state program ,(g)
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  Sjs_get program "body" ,(body)
  Gen_cx __FALSE__ "" "" ,(cx)
  Gen_block_code g scope body cx ,(code)
  Gen_const_code g ,(consts)
  __String_concat__ consts code ,(code)
  __String_concat__ ";; SJS を変換したもの（consh/include/sjs_gen.se）\n(include \"util.se\")\n(include \"sjs_rt.se\")\n(define main ,(args)\n  Sjs_init ,(G)\n" code ,(s)
  __String_concat__ s "\n  Sjs_run_jobs ,()\n  __nop__)\n")

;; 文の文脈 cx：関数の中か（"fn"）と、return、break、continue で呼ぶ継続の変数名（"ret"、"brk"、"cnt"。使えなければ ""）、
;; その継続を呼ぶ前に戻す、例外の受け手のスタックの変数名（"retH"、"brkH"、"cntH"。継続が try の finally を通す
;; Closure なら ""。その Closure が戻す）
(define Gen_cx ,(fn brk cnt)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fn" fn ,()
  __Dict_put__ cx "brk" brk ,()
  __Dict_put__ cx "cnt" cnt ,()
  __Dict_put__ cx "ret" "" ,()
  __Dict_put__ cx "retH" "" ,()
  __Dict_put__ cx "brkH" "" ,()
  __Dict_put__ cx "cntH" "" ,()
  ;; ラベルの付いた break と continue の継続のキー（"brk:名前"、"cnt:名前"）の LList
  __Dict_put__ cx "labels" __NULL__ ,()
  __NULL__ cx)

;; cx にラベル付きの継続 kind（"brk:名前" など）を足す。受け手のスタックの変数名は h
(define Gen_cx_label ,(cx kind k h)
  Gen_cx_with cx kind k ,(cx)
  __String_concat__ kind "H" ,(hk)
  Gen_cx_with cx hk h ,(cx)
  __Dict_lookup_or__ cx "labels" (,(x) __NULL__ __NULL__) ,(labels)
  __LList_cons__ kind labels ,(labels)
  Gen_cx_with cx "labels" labels)

;; cx の写しの key を value にしたもの
(define Gen_cx_with ,(cx key value)
  __Dict_copy__ cx ,(c)
  __Dict_put__ c key value ,()
  __NULL__ c)

;; return、break、continue（kind は "ret"、"brk"、"cnt"）の手順。val は return の値（なければ ""）
(define Gen_jump ,(cx kind val)
  __Cont_get__ ,(return)
  Sjs_get cx kind ,(k)
  __String_concat__ kind "H" ,(hk)
  Sjs_get cx hk ,(h)
  __String_equal__ h "" ,(noRestore)
  __if_then_else__ noRestore (,() __NULL__ "") (,() Cat3 "Sjs_set_handlers " h " ,() ") ,(restore)
  Cat5 restore k " " val " ,() ")

;; ConSh の (( )) と $(( )) の SJS式を、モジュールのソースにする（段階 B4。consh_jsstmt.se が __VProc_spawn__ で動かす）。
;; モジュールは Sjs_entry だけを定義する。Sjs_entry は、__VProc_spawn__ の引数（err ctx in out）の ctx（Dict）から、
;; 実行時の支えの関数（"rt"。Sjs_rt_names の名前の関数と、__TRUE__ などの標準の関数）を同じ名前の局所変数に束縛し、
;; 文脈 G を受け取り、"setup"（この VProc の PDict を置く）を呼んでから式を求め、値を "done" に渡す。
;; モジュールは何も include しないので、作るのは速い（実行時の支えは ConSh のモジュールにある）
(define Sjs_translate_module ,(text)
  Sjs_parse_expression text ,(e)
  Gen_state e ,(g)
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  Gen_expr g scope e ,(code val)
  Gen_const_code g ,(consts)
  __String_concat__ consts code ,(code)
  Sjs_rt_names ,(names)
  Gen_binds names "" ,(binds)
  Cat3 ";; SJS の (( )) を変換したもの（consh/include/sjs_gen.se の Sjs_translate_module）\n(define Sjs_entry ,(err ctx in out)\n  __Dict_lookup_or__ ctx \"rt\" (,(k) __NULL__ __NULL__) ,(rt)\n" binds "  __Dict_lookup_or__ ctx \"G\" (,(k) __NULL__ __NULL__) ,(G)\n  __Dict_lookup_or__ ctx \"done\" (,(k) __NULL__ __NULL__) ,(done)\n  __Dict_lookup_or__ ctx \"setup\" (,(k) __NULL__ __NULL__) ,(setup)\n  __Cont_get__ ,(sjsExit)\n  setup sjsExit ,()\n  " ,(s)
  ;; マイクロタスクの列を最後まで動かしてから、値を渡す
  Cat4 s code "Sjs_run_jobs ,() done " val ,(s)
  __String_concat__ s ")\n")

;; モジュールが受け取る関数の名前（sjs_rt.se の Sjs_rt_dict と同じ）
(define Sjs_rt_names ,()
  Sjs_words "__TRUE__ __FALSE__ __not__ __nop__ __print_exit_error__ Sjs_add Sjs_arg Sjs_array Sjs_call Sjs_call_member Sjs_div Sjs_function Sjs_ge Sjs_get_member Sjs_global Sjs_gt Sjs_handlers Sjs_is_nullish Sjs_iter_keys Sjs_iter_values Sjs_key Sjs_key_string Sjs_le Sjs_line Sjs_lt Sjs_mod Sjs_mul Sjs_neg Sjs_object Sjs_pos Sjs_raise Sjs_seq Sjs_set_global Sjs_set_handlers Sjs_set_member Sjs_shell_get Sjs_shell_number Sjs_step Sjs_sub Sjs_throw Sjs_to_string Sjs_truthy Sjs_try Sjs_type_error Sjs_typeof Sjs_pow Sjs_band Sjs_bor Sjs_bxor Sjs_bnot Sjs_shl Sjs_shr Sjs_ushr Sjs_is_undefined Sjs_array_new Sjs_array_push Sjs_array_list Sjs_spread_into Sjs_object_new Sjs_obj_set Sjs_object_spread Sjs_object_rest Sjs_case_runs Sjs_generator Sjs_yield Sjs_yield_star Sjs_iter_open Sjs_iter_more Sjs_iter_take Sjs_try_catch Sjs_async Sjs_await Sjs_run_jobs Sjs_need Sjs_eq_num Sjs_ne_num Sjs_get_index Sjs_set_index Sjs_array_hole Sjs_iter_next Sjs_iter_rest Sjs_iter_close Sjs_template_strings Sjs_async_generator Sjs_ag_yield Sjs_ag_yield_star Sjs_aiter_open Sjs_aiter_more Sjs_aiter_close Sjs_in_op Sjs_pattern_open Sjs_pattern_next Sjs_pattern_rest Sjs_pattern_close")

(define Gen_binds ,(names acc)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(n rest)
  Cat5 acc "  __Dict_lookup_or__ rt \"" n "\" (,(k) __NULL__ __NULL__) ,(" n ,(acc)
  __String_concat__ acc ")\n" ,(acc)
  Gen_binds rest acc)

(define Gen_error ,(msg)
  Sjs_throw "SyntaxError" msg)

(define Gen_not_yet ,(what)
  __String_concat__ "not yet translated to ConMa: " what ,(msg)
  Gen_error msg)

;; 新しい一時変数の名前（prefix に番号を付ける）
(define Gen_temp ,(g prefix)
  __Dict_lookup_or__ g "n" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ ref n ,()
  __Number_toString__ n ,(s)
  __String_concat__ prefix s)

;; 文字列を ConMa の文字列のリテラルにする
(define Gen_quote ,(s)
  Sjs_chars s ,(chars)
  Gen_quote_chars chars "\"")

(define Gen_quote_chars ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() __String_concat__ acc "\"" ,(s) return s) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "\"" ,(q)
  __String_equal__ c "\\" ,(b)
  __String_equal__ c "\n" ,(n)
  __String_equal__ c "\t" ,(t)
  __String_equal__ c "\r" ,(r)
  __String_toCode__ __print_exit_error__ c ,(code)
  __Number_fromString__ __print_exit_error__ "32" ,(space)
  __Number_subtract__ code space ,(d)
  __Number_is_negative__ d ,(control)
  __if_then_else__ q (,() __NULL__ "\\\"") (,()
  __if_then_else__ b (,() __NULL__ "\\\\") (,()
  __if_then_else__ n (,() __NULL__ "\\n") (,()
  __if_then_else__ t (,() __NULL__ "\\t") (,()
  __if_then_else__ r (,() __NULL__ "\\r") (,()
  __if_then_else__ control (,() Gen_error "a control character in Gen_quote") (,() __NULL__ c)))))) ,(e)
  __String_concat__ acc e ,(acc)
  Gen_quote_chars rest acc)

;; SJS の文字列の値 s の被演算子。ConMa の文字列のリテラルに書けない制御文字（\n、\t、\r のほか）があれば、
;; プログラムの始めに文字の番号から作る定数にする
(define Gen_str ,(g s)
  __Cont_get__ ,(return)
  Sjs_chars s ,(chars)
  Gen_has_control chars ,(ctl)
  __unless__ ctl (,() Gen_quote s ,(q) return q) ,()
  __String_concat__ "str:" s ,(key)
  __Dict_lookup_or__ g "consts" __print_exit_error__ ,(consts)
  __Dict_lookup_or__ consts key (,(k) __NULL__ __NULL__) ,(known)
  __is_null__ known ,(test__) __unless__ test__ (,() return known) ,()
  Gen_temp g "k" ,(k)
  __Dict_put__ consts key k ,()
  Gen_temp g "s" ,(v)
  Cat3 "__NULL__ \"\" ,(" v ") " ,(code)
  Gen_str_code g chars "" code v ,(code v)
  __Dict_lookup_or__ g "constCode" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(cc)
  Cat5 cc code "__NULL__ " v " ,(" ,(cc)
  Cat3 cc k ") " ,(cc)
  __Ref_set__ ref cc ,()
  __NULL__ k)

;; 制御文字（\n、\t、\r のほか）か
(define Gen_is_control ,(c)
  __Cont_get__ ,(return)
  __String_equal__ c "\n" ,(n)
  __String_equal__ c "\t" ,(t)
  __String_equal__ c "\r" ,(r)
  __or__ n t ,(x)
  __or__ x r ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __String_toCode__ __print_exit_error__ c ,(code)
  __Number_fromString__ __print_exit_error__ "32" ,(space)
  __Number_subtract__ code space ,(d)
  __Number_is_negative__ d)

(define Gen_has_control ,(chars)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Gen_is_control c ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Gen_has_control rest)

;; 文字を v の後につなぐ手順。run は、まだつないでいない制御文字でない文字
(define Gen_str_code ,(g chars run code v)
  __Cont_get__ ,(return)
  __NULL__ (,(code v)
    __Cont_get__ ,(ret)
    __String_equal__ run "" ,(test__) __if__ test__ (,() ret code v) ,()
    Gen_quote run ,(q)
    Gen_temp g "s" ,(v2)
    Cat5 code "__String_concat__ " v " " q ,(code)
    Cat3 code " ,(" v2 ,(code)
    __String_concat__ code ") " ,(code)
    __NULL__ code v2) ,(flush)
  __is_null__ chars ,(test__) __if__ test__ (,() flush code v ,(c x) return c x) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Gen_is_control c ,(ctl)
  __unless__ ctl (,() __String_concat__ run c ,(run) Gen_str_code g rest run code v ,(c2 x) return c2 x) ,()
  flush code v ,(code v)
  __String_toCode__ __print_exit_error__ c ,(n)
  __Number_toString__ n ,(ns)
  Gen_temp g "s" ,(ch)
  Gen_temp g "s" ,(v2)
  Cat4 code "__Number_fromString__ __print_exit_error__ \"" ns "\" ,(" ,(code)
  Cat5 code ch ") __String_fromCode__ __print_exit_error__ " ch " ,(" ,(code)
  Cat5 code ch ") __String_concat__ " v " " ,(code)
  Cat5 code ch " ,(" v2 ") " ,(code)
  Gen_str_code g rest "" code v2)

;; 文字列をつなぐ（a b c ...）
(define Cat3 ,(a b c)
  __String_concat__ a b ,(s)
  __String_concat__ s c)

(define Cat4 ,(a b c d)
  Cat3 a b c ,(s)
  __String_concat__ s d)

(define Cat5 ,(a b c d e)
  Cat4 a b c d ,(s)
  __String_concat__ s e)

;; ── 名前 ──

;; 名前 name の ConMa の変数名と、const か。宣言されていなければ null と偽
(define Gen_lookup ,(scope name)
  __Cont_get__ ,(return)
  __is_null__ scope ,(test__) __if__ test__ (,() return __NULL__ __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_lookup_or__ dict name (,(key) Gen_lookup rest key ,(v c) return v c) ,(v)
  __String_concat__ "const:" name ,(ck)
  __Dict_lookup_or__ dict ck (,(key) __NULL__ __FALSE__) ,(c)
  __NULL__ v c)

;; 今のスコープに name を宣言する。ConMa の変数名を返す
(define Gen_declare ,(g scope name isConst)
  Str_has_dollar name ,(test__) __if__ test__
    (,() __String_concat__ "not in SJS: a declaration of " name ,(m) __String_concat__ m " (a name that begins with $ is a shell variable)" ,(m) Sjs_not_in m) ,()
  __String_concat__ "v" "" ,(prefix)
  Gen_temp g "v" ,(t)
  Cat3 t "_" name ,(var)
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_put__ dict name var ,()
  __String_concat__ "const:" name ,(ck)
  __if__ isConst (,() __Dict_put__ dict ck __TRUE__) ,()
  __NULL__ var)

(define Str_has_dollar ,(name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ name "$" zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

;; ── 文 ──

;; 文の LList の手順の並びを acc に足したもの
(define Gen_stmts ,(g scope list cx acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  Gen_stmt g scope s cx ,(code)
  __String_concat__ acc code ,(acc)
  Gen_stmts g scope rest cx acc)

;; 文。最初に、文の行を記録する（Sjs_line。受け手のない例外のメッセージに出す）
(define Gen_stmt ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "t" ,(t)
  __String_equal__ t "block" ,(isBlock)
  __String_equal__ t "empty" ,(isEmpty)
  __or__ isBlock isEmpty ,(test__) __if__ test__ (,() Gen_stmt_body g scope s cx ,(c) return c) ,()
  ;; for...of の終わりに、繰り返しの手順を閉じる（Gen_forof。行は記録しない）
  __String_equal__ t "iterclose" ,(test__) __if__ test__
    (,()
      Sjs_get s "it" ,(it)
      __Dict_lookup_or__ s "await" (,(k) __NULL__ __FALSE__) ,(isAwait)
      __if_then_else__ isAwait (,() __NULL__ "Sjs_aiter_close ") (,() __NULL__ "Sjs_iter_close ") ,(f)
      Cat3 f it " ,() " ,(c)
      return c) ,()
  __Dict_lookup_or__ s "line" (,(k) __NULL__ "") ,(line)
  Gen_quote line ,(q)
  ;; 文の中の呼び出しは、戻った後に、この文の行を記録し直す（呼ばれた関数の文が、行を変えるので）
  __Dict_lookup_or__ g "line" (,(k) __NULL__ "") ,(outer)
  __Dict_put__ g "line" q ,()
  Gen_stmt_body g scope s cx ,(c)
  __Dict_put__ g "line" outer ,()
  Cat4 "Sjs_line " q " ,() " c)

;; 呼び出しの後に、今の文の行を記録し直す手順（文の外なら空）
(define Gen_line_again ,(g)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ g "line" (,(k) __NULL__ "") ,(q)
  __String_equal__ q "" ,(test__) __if__ test__ (,() return "") ,()
  Cat3 "Sjs_line " q " ,() ")

(define Gen_stmt_body ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "t" ,(t)
  __String_equal__ t "expr" ,(test__) __if__ test__
    (,() Sjs_get s "expr" ,(e) Gen_expr g scope e ,(code val) return code) ,()
  __String_equal__ t "empty" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "block" ,(test__) __if__ test__
    (,()
      __Dict_new__ ,(dict)
      __LList_cons__ dict scope ,(inner)
      Sjs_get s "body" ,(body)
      Gen_block_code g inner body cx ,(code)
      return code) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,()
      Sjs_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      Sjs_get s "decls" ,(decls)
      Gen_decls g scope decls isConst "" ,(code)
      return code) ,()
  __String_equal__ t "if" ,(test__) __if__ test__ (,() Gen_if g scope s cx ,(code) return code) ,()
  __String_equal__ t "while" ,(test__) __if__ test__ (,() Gen_while g scope s cx ,(code) return code) ,()
  __String_equal__ t "for" ,(test__) __if__ test__ (,() Gen_for g scope s cx ,(code) return code) ,()
  __String_equal__ t "forof" ,(test__) __if__ test__ (,() Gen_forof g scope s cx ,(code) return code) ,()
  __String_equal__ t "dowhile" ,(test__) __if__ test__ (,() Gen_dowhile g scope s cx ,(code) return code) ,()
  __String_equal__ t "switch" ,(test__) __if__ test__ (,() Gen_switch g scope s cx ,(code) return code) ,()
  __String_equal__ t "break" ,(isBreak)
  __String_equal__ t "continue" ,(isContinue)
  __or__ isBreak isContinue ,(test__) __if__ test__
    (,()
      __if_then_else__ isBreak (,() __NULL__ "brk") (,() __NULL__ "cnt") ,(kind)
      __Dict_lookup_or__ s "label" (,(x) __NULL__ "") ,(label)
      __String_equal__ label "" ,(plain)
      __unless__ plain
        (,()
          Cat3 kind ":" label ,(lkind)
          __Dict_lookup_or__ cx lkind (,(x) __NULL__ "") ,(k)
          __String_equal__ k "" ,(test__) __if__ test__
            (,() Cat4 "undefined label in " t ": " label ,(msg) Gen_error msg) ,()
          Gen_jump cx lkind "" ,(c)
          return c) ,()
      Sjs_get cx kind ,(k)
      __String_equal__ k "" ,(outside)
      __if__ outside (,() __String_concat__ t " outside a loop" ,(msg) Gen_error msg) ,()
      Gen_jump cx kind "" ,(c)
      return c) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,()
      Sjs_get cx "fn" ,(inFn)
      __unless__ inFn (,() Gen_error "return outside a function") ,()
      Sjs_get s "value" ,(value)
      __is_null__ value ,(none)
      __if__ none (,() Gen_jump cx "ret" "__NULL__" ,(c) return c) ,()
      Gen_expr g scope value ,(code val)
      ;; async ジェネレータの return v は、v を await する
      __Dict_lookup_or__ g "asyncGen" (,(k) __NULL__ __FALSE__) ,(inAsyncGen)
      __if_then_else__ inAsyncGen
        (,() Gen_temp g "t" ,(w) Cat5 code "Sjs_await " val " ,(" w ,(code) __String_concat__ code ") " ,(code) __NULL__ code w)
        (,() __NULL__ code val) ,(code val)
      Gen_jump cx "ret" val ,(j)
      __String_concat__ code j ,(c)
      return c) ,()
  __String_equal__ t "throw" ,(test__) __if__ test__
    (,()
      Sjs_get s "value" ,(value)
      Gen_expr g scope value ,(code val)
      Cat4 code "Sjs_raise " val " ,() " ,(c)
      return c) ,()
  __String_equal__ t "try" ,(test__) __if__ test__ (,() Gen_try g scope s cx ,(code) return code) ,()
  __String_equal__ t "funcdecl" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "labeled" ,(test__) __if__ test__ (,() Gen_labeled g scope s cx ,(code) return code) ,()
  __String_concat__ "a statement of " t ,(what)
  Gen_not_yet what)

(define Gen_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "target" ,(target)
  Sjs_get d "init" ,(init)
  __is_null__ init ,(none)
  Sjs_get target "t" ,(tt)
  __String_equal__ tt "id" ,(isId)
  __if_then_else__ isId (,() Sjs_get target "name") (,() __NULL__ "") ,(name)
  __if_then_else__ none (,() __NULL__ "" "__NULL__") (,() Gen_named g scope init name) ,(code val)
  Gen_pattern g scope target val __TRUE__ ,(bind)
