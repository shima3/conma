  __or__ isArrow isFunction ,(test__) __if__ test__ (,() Gen_named g scope e "" ,(c v) return c v) ,()
  __String_equal__ t "member" ,(test__) __if__ test__ (,() Gen_member g scope e ,(c v) return c v) ,()
  __String_equal__ t "array" ,(test__) __if__ test__ (,() Gen_array g scope e ,(c v) return c v) ,()
  __String_equal__ t "object" ,(test__) __if__ test__ (,() Gen_object g scope e ,(c v) return c v) ,()
  __String_equal__ t "template" ,(test__) __if__ test__ (,() Gen_template g scope e ,(c v) return c v) ,()
  __String_equal__ t "tagged" ,(test__) __if__ test__ (,() Gen_tagged g scope e ,(c v) return c v) ,()
  __String_equal__ t "yield" ,(test__) __if__ test__ (,() Gen_yield g scope e ,(c v) return c v) ,()
  __String_equal__ t "seq" ,(test__) __if__ test__ (,() Sjs_get e "exprs" ,(exprs) Gen_seq g scope exprs "" ,(c v) return c v) ,()
  __String_equal__ t "await" ,(test__) __if__ test__
    (,()
