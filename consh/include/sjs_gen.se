  Str_has_dollar name ,(d)
  __if_then_else__ d (,() __NULL__ name) (,() __NULL__ __NULL__))

;; 数のリテラル（-3 も）か
(define Gen_is_num_literal ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_is_num_literal inner ,(b) return b) ,()
  __String_equal__ t "num" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ t "unary" ,(isUnary)
  __unless__ isUnary (,() return __FALSE__) ,()
  Sjs_get e "op" ,(op)
