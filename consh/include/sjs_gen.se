;; switch：一致する case の番号（なければ default の番号、それもなければ -1）を求めてから、その番号以降の case の本体を
;; 順に実行する。break は switch を抜ける（脱出の継続）。case の本体は 1 つのスコープ
(define Gen_switch ,(g scope s cx)
  Sjs_get s "disc" ,(disc)
  Sjs_get s "cases" ,(cases)
