      return c2 d2) ,()
  Gen_expr g scope test ,(tc tv)
  Gen_temp g "m" ,(m)
  Cat5 code tc "Sjs_seq " dv " " ,(code)
  Cat5 code tv " ,(" m ") __if__ " ,(code)
  Cat5 code m " (,() __Number_fromString__ __print_exit_error__ " q " ,(" ,(code)
  Cat5 code n ") __Ref_set__ " start " " ,(code)
  Cat5 code n " ,() " found ") ,() " ,(code)
  Gen_case_match g scope rest dv start found next code dflt)

(define Gen_case_bodies ,(g scope cases start cx i code)
  __Cont_get__ ,(return)
  __is_null__ cases ,(test__) __if__ test__ (,() return code) ,()
  __LList_uncons__ __print_exit_error__ cases ,(c rest)
