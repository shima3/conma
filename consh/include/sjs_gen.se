  __is_null__ cases ,(test__) __if__ test__ (,() return code dflt) ,()
  __LList_uncons__ __print_exit_error__ cases ,(c rest)
  Sjs_get c "test" ,(test)
  __Number_toString__ i ,(is)
  Gen_quote is ,(q)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ i one ,(next)
