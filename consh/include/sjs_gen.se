  __if_then_else__ isBnot (,() __NULL__ "Sjs_bnot ") (,()
    __String_concat__ "the operator " op ,(what) Gen_not_yet what)))) ,(f)
  Cat5 code f val " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; 数を要る演算子の被演算子：$名前（括弧を透過）なら、値を数にする手順を足す（consh/SAFEJS-PLAN-ja.md の 2.2 の 7）
(define Gen_operand ,(g scope e)
  __Cont_get__ ,(return)
  Gen_expr g scope e ,(c v)
  Gen_shell_name e ,(name)
  __is_null__ name ,(test__) __if__ test__ (,() return c v) ,()
