;; SJS を ConMa のソースに変換する（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1、B2）。
;; 構文木（sjs_parse.se）から、main を定義する ConMa のソースの String を作る。実行には sjs_rt.se を使う。
;;
;; 変換の形：
;; * 式は、値を求める手順の並び（「演算子 被演算子 ,(t) 」を並べたもの）と、その値を表す被演算子（変数名、
;;   文字列のリテラル、__TRUE__ など）にする。手順の並びは、そのまま後ろにつなげられる（Gen_expr）。
;; * 文は、手順の並びにする（Gen_stmt）。どの手順も ,(…) で終わるので、文をつなげて最後に __nop__ を置けば本体になる。
;; * 変数（let、const、var、引数）は Ref に入れ、名前ごとに一意の ConMa の変数名（v番号_名前）を付ける。そのため、
;;   ブロックの外に出ても束縛は残るが、名前は変換のときに解決するので、外の同じ名前とは混ざらない。
;;   宣言していない名前は大域の名前（SJS変数）で、文脈 G の Dict に置く（Sjs_global）。
;; * 関数は、引数の LList を受け取る Closure を Sjs_function で包む。本体の最初で __Cont_get__ ,(return) を取り、
;;   return 文はそれを呼ぶ。
;; * if は __if_then_else__、while は、Ref に入れた自分を呼ぶ thunk（末尾で呼ぶので CChain は伸びない）。
;; * &&、||、??、条件演算子は、__if_then_else__ の 2 つの thunk が値を返す形。
;; 変換の状態 g は Dict で、"n" に一時変数の番号の Ref を持つ。scope は Dict（名前 → ConMa の変数名）の LList
;; （内側が先）で、"const:名前" があれば const。
;; sjs_parse.se を使う

(define Sjs_translate ,(text)
  Sjs_parse text ,(program)
  __Dict_new__ ,(g)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(counter)
  __Dict_put__ g "n" counter ,()
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  Sjs_get program "body" ,(body)
  Gen_cx __FALSE__ "" "" ,(cx)
  Gen_block_code g scope body cx ,(code)
  __String_concat__ ";; SJS を変換したもの（consh/include/sjs_gen.se）\n(include \"util.se\")\n(include \"sjs_rt.se\")\n(define main ,(args)\n  Sjs_init ,(G)\n" code ,(s)
  __String_concat__ s "\n  __nop__)\n")

;; 文の文脈 cx：関数の中か（"fn"）と、break と continue で呼ぶ継続の変数名（"brk" と "cnt"。ループの外では ""）
(define Gen_cx ,(fn brk cnt)
  __Dict_new__ ,(cx)
  __Dict_put__ cx "fn" fn ,()
  __Dict_put__ cx "brk" brk ,()
  __Dict_put__ cx "cnt" cnt ,()
  __NULL__ cx)

(define Gen_error ,(msg)
  Sjs_throw "SyntaxError" msg)

(define Gen_not_yet ,(what)
  __String_concat__ "not yet translated (stage B2 of SJS): " what ,(msg)
  Gen_error msg)

;; 新しい一時変数の名前（prefix に番号を付ける）
(define Gen_temp ,(g prefix)
  __Dict_lookup_or__ g "n" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ ref n ,()
  __Number_toString__ n ,(s)
  __String_concat__ prefix s)

;; 文字列を ConMa の文字列のリテラルにする
(define Gen_quote ,(s)
  Sjs_chars s ,(chars)
  Gen_quote_chars chars "\"")

(define Gen_quote_chars ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() __String_concat__ acc "\"" ,(s) return s) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "\"" ,(q)
  __String_equal__ c "\\" ,(b)
  __String_equal__ c "\n" ,(n)
  __String_equal__ c "\t" ,(t)
  __String_equal__ c "\r" ,(r)
  __String_toCode__ __print_exit_error__ c ,(code)
  __Number_fromString__ __print_exit_error__ "32" ,(space)
  __Number_subtract__ code space ,(d)
  __Number_is_negative__ d ,(control)
  __if_then_else__ q (,() __NULL__ "\\\"") (,()
  __if_then_else__ b (,() __NULL__ "\\\\") (,()
  __if_then_else__ n (,() __NULL__ "\\n") (,()
  __if_then_else__ t (,() __NULL__ "\\t") (,()
  __if_then_else__ r (,() __NULL__ "\\r") (,()
  __if_then_else__ control (,() Gen_not_yet "a control character in a string") (,() __NULL__ c)))))) ,(e)
  __String_concat__ acc e ,(acc)
  Gen_quote_chars rest acc)

;; 文字列をつなぐ（a b c ...）
(define Cat3 ,(a b c)
  __String_concat__ a b ,(s)
  __String_concat__ s c)

(define Cat4 ,(a b c d)
  Cat3 a b c ,(s)
  __String_concat__ s d)

(define Cat5 ,(a b c d e)
  Cat4 a b c d ,(s)
  __String_concat__ s e)

;; ── 名前 ──

;; 名前 name の ConMa の変数名と、const か。宣言されていなければ null と偽
(define Gen_lookup ,(scope name)
  __Cont_get__ ,(return)
  __is_null__ scope ,(test__) __if__ test__ (,() return __NULL__ __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_lookup_or__ dict name (,(key) Gen_lookup rest key ,(v c) return v c) ,(v)
  __String_concat__ "const:" name ,(ck)
  __Dict_lookup_or__ dict ck (,(key) __NULL__ __FALSE__) ,(c)
  __NULL__ v c)

;; 今のスコープに name を宣言する。ConMa の変数名を返す
(define Gen_declare ,(g scope name isConst)
  Str_has_dollar name ,(test__) __if__ test__ (,() Gen_not_yet "a name that begins with $ (a shell variable)") ,()
  __String_concat__ "v" "" ,(prefix)
  Gen_temp g "v" ,(t)
  Cat3 t "_" name ,(var)
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_put__ dict name var ,()
  __String_concat__ "const:" name ,(ck)
  __if__ isConst (,() __Dict_put__ dict ck __TRUE__) ,()
  __NULL__ var)

(define Str_has_dollar ,(name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ name "$" zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

;; ── 文 ──

;; 文の LList の手順の並びを acc に足したもの
(define Gen_stmts ,(g scope list cx acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  Gen_stmt g scope s cx ,(code)
  __String_concat__ acc code ,(acc)
  Gen_stmts g scope rest cx acc)

(define Gen_stmt ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "t" ,(t)
  __String_equal__ t "expr" ,(test__) __if__ test__
    (,() Sjs_get s "expr" ,(e) Gen_expr g scope e ,(code val) return code) ,()
  __String_equal__ t "empty" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "block" ,(test__) __if__ test__
    (,()
      __Dict_new__ ,(dict)
      __LList_cons__ dict scope ,(inner)
      Sjs_get s "body" ,(body)
      Gen_block_code g inner body cx ,(code)
      return code) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,()
      Sjs_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      Sjs_get s "decls" ,(decls)
      Gen_decls g scope decls isConst "" ,(code)
      return code) ,()
  __String_equal__ t "if" ,(test__) __if__ test__ (,() Gen_if g scope s cx ,(code) return code) ,()
  __String_equal__ t "while" ,(test__) __if__ test__ (,() Gen_while g scope s cx ,(code) return code) ,()
  __String_equal__ t "for" ,(test__) __if__ test__ (,() Gen_for g scope s cx ,(code) return code) ,()
  __String_equal__ t "forof" ,(test__) __if__ test__ (,() Gen_forof g scope s cx ,(code) return code) ,()
  __String_equal__ t "break" ,(isBreak)
  __String_equal__ t "continue" ,(isContinue)
  __or__ isBreak isContinue ,(test__) __if__ test__
    (,()
      __if_then_else__ isBreak (,() Sjs_get cx "brk") (,() Sjs_get cx "cnt") ,(k)
      __String_equal__ k "" ,(outside)
      __if__ outside (,() __String_concat__ t " outside a loop" ,(msg) Gen_error msg) ,()
      __String_concat__ k " ,() " ,(c)
      return c) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,()
      Sjs_get cx "fn" ,(inFn)
      __unless__ inFn (,() Gen_error "return outside a function") ,()
      Sjs_get s "value" ,(value)
      __is_null__ value ,(none)
      __if__ none (,() return "return __NULL__ ,() ") ,()
      Gen_expr g scope value ,(code val)
      Cat4 code "return " val " ,() " ,(c)
      return c) ,()
  __String_concat__ "a statement of " t ,(what)
  Gen_not_yet what)

(define Gen_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "name" ,(name)
  Sjs_get d "init" ,(init)
  __is_null__ init ,(none)
  __if_then_else__ none (,() __NULL__ "" "__NULL__") (,() Gen_named g scope init name) ,(code val)
  Gen_lookup scope name ,(var c)
  Cat5 acc code "__Ref_set__ " var " " ,(acc)
  Cat3 acc val " ,() " ,(acc)
  Gen_decls g scope rest isConst acc)

(define Gen_if ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "test" ,(test)
  Sjs_get s "yes" ,(yes)
  Sjs_get s "no" ,(no)
  Gen_expr g scope test ,(code val)
  Gen_temp g "b" ,(b)
  Gen_branch g scope yes cx ,(yesCode)
  Cat5 code "Sjs_truthy " val " ,(" b ,(c)
  __is_null__ no ,(noElse)
  __if__ noElse
    (,() Cat5 c ") __if__ " b " (,() " yesCode ,(c) __String_concat__ c "__nop__) ,() " ,(c) return c) ,()
  Gen_branch g scope no cx ,(noCode)
  Cat5 c ") __if_then_else__ " b " (,() " yesCode ,(c)
  Cat3 c "__nop__) (,() " noCode ,(c)
  __String_concat__ c "__nop__) ,() ")

;; if の枝の文（ブロックでなくても、自分のスコープを持つ）
(define Gen_branch ,(g scope s cx)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(inner)
  __LList_cons__ s __NULL__ ,(stmts)
  Gen_block_code g inner stmts cx)

;; ループ。break は外側の thunk の脱出の継続（brk）、continue は各回の本体の thunk の脱出の継続（cnt）で表す：
;;   (,() __Cont_get__ ,(brk) __Ref_new__ __NULL__ ,(loop) __Ref_set__ loop (,() 条件 Sjs_truthy t ,(b)
;;     __if__ b (,() (,() __Cont_get__ ,(cnt) 本体 __nop__) ,() 更新 __Ref_get__ loop ,(l) l)) ,() __Ref_get__ loop ,(l) l) ,()
;; testCode と testVal が条件（testVal が null なら、いつも真）、body は本体を作る関数（cx を受け取り、手順の並びを返す）、
;; updateCode は更新の手順の並び
(define Gen_loop ,(g cx testCode testVal body updateCode)
  Gen_temp g "brk" ,(brk)
  Gen_temp g "cnt" ,(cnt)
  Gen_temp g "loop" ,(loop)
  Gen_temp g "b" ,(b)
  Gen_temp g "l" ,(l)
  Sjs_get cx "fn" ,(fn)
  Gen_cx fn brk cnt ,(inner)
  body inner ,(bodyCode)
  Cat3 "(,() __Cont_get__ ,(" brk ") __Ref_new__ __NULL__ ,(" ,(c)
  Cat4 c loop ") __Ref_set__ " loop ,(c)
  Cat3 c " (,() " testCode ,(c)
  __is_null__ testVal ,(always)
  __if_then_else__ always
    (,() __String_concat__ c "__NULL__ __TRUE__ ,(")
    (,() Cat4 c "Sjs_truthy " testVal " ,(") ,(c)
  Cat5 c b ") __if__ " b " (,() (,() __Cont_get__ ,(" ,(c)
  Cat4 c cnt ") " bodyCode ,(c)
  Cat3 c "__nop__) ,() " updateCode ,(c)
  Cat5 c "__Ref_get__ " loop " ,(" l ,(c)
  Cat3 c ") " l ,(c)
  Cat5 c ")) ,() __Ref_get__ " loop " ,(" l ,(c)
  Cat4 c ") " l ") ,() ")

(define Gen_while ,(g scope s cx)
  Sjs_get s "test" ,(test)
  Sjs_get s "body" ,(body)
  Gen_expr g scope test ,(testCode val)
  Gen_loop g cx testCode val (,(inner) Gen_branch g scope body inner) "")

;; for (初期化; 条件; 更新) 本体。初期化の let の変数は、JavaScript と同じく回ごとに作り直す
;; （本体の中で作った関数が、その回の値を持つように）：各回の始めに、ループの変数の値を新しい Ref に写し、
;; 本体の後で、ループの変数に写し戻す
(define Gen_for ,(g scope s cx)
  Sjs_get s "init" ,(init)
  Sjs_get s "test" ,(test)
  Sjs_get s "update" ,(update)
  Sjs_get s "body" ,(body)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(outer)
  __is_null__ init ,(noInit)
  __if_then_else__ noInit (,() __NULL__ __NULL__) (,() __LList_cons__ init __NULL__) ,(inits)
  Gen_block_code g outer inits cx ,(initCode)
  ;; 回ごとの変数（let か const で宣言した名前）
  __if_then_else__ noInit (,() __NULL__ "") (,() Sjs_get init "t") ,(it)
  __String_equal__ it "decl" ,(isDecl)
  __if_then_else__ isDecl (,() Sjs_get init "kind") (,() __NULL__ "") ,(kind)
  __String_equal__ kind "var" ,(isVar)
  __not__ isVar ,(fresh)
  __and__ isDecl fresh ,(perIteration)
  __if_then_else__ perIteration (,() Sjs_get init "decls") (,() __NULL__ __NULL__) ,(decls)
  __is_null__ test ,(noTest)
  __if_then_else__ noTest (,() __NULL__ "" __NULL__) (,() Gen_expr g outer test) ,(testCode testVal)
  __is_null__ update ,(noUpdate)
  __if_then_else__ noUpdate (,() __NULL__ "") (,() Gen_expr g outer update ,(c v) __NULL__ c) ,(updateCode)
  Gen_loop g cx testCode testVal (,(inner)
    __Dict_new__ ,(idict)
    __LList_cons__ idict outer ,(iscope)
    Gen_copy_in g outer iscope decls "" "" ,(copyIn copyOut)
    Gen_branch g iscope body inner ,(bodyCode)
    Cat3 copyIn bodyCode copyOut) updateCode ,(loopCode)
  __String_concat__ initCode loopCode)

;; 回ごとの変数：外の Ref の値を、iscope に宣言した新しい Ref に入れる手順と、本体の後で外の Ref に写し戻す手順。
;; 写し戻しは、本体が continue で抜けたときも行うよう、本体の最後でなく、ループの各回の後にある必要があるが、
;; ここでは本体の後に置く（continue のときは写し戻さない。for の本体の中の continue の後の更新が、回の変数を
;; 変えていたときだけ違う）
(define Gen_copy_in ,(g outer iscope decls inCode outCode)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return inCode outCode) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "name" ,(name)
  Gen_lookup outer name ,(ov isConst)
  Gen_declare g iscope name isConst ,(iv)
  Gen_temp g "t" ,(t)
  Gen_temp g "t" ,(u)
  Cat5 inCode "__Ref_get__ " ov " ,(" t ,(inCode)
  Cat5 inCode ") __Ref_new__ " t " ,(" iv ,(inCode)
  __String_concat__ inCode ") " ,(inCode)
  Cat5 outCode "__Ref_get__ " iv " ,(" u ,(outCode)
  Cat5 outCode ") __Ref_set__ " ov " " u ,(outCode)
  __String_concat__ outCode " ,() " ,(outCode)
  Gen_copy_in g outer iscope rest inCode outCode)

;; for (x of e) と for (x in e)：値（of）か名前（in）の LList を Ref に入れ、回ごとに先頭を取り出す
(define Gen_forof ,(g scope s cx)
  Sjs_get s "kind" ,(kind)
  Sjs_get s "name" ,(name)
  Sjs_get s "of" ,(of)
  Sjs_get s "right" ,(right)
  Sjs_get s "body" ,(body)
  Gen_expr g scope right ,(rc rv)
  Gen_temp g "list" ,(list)
  Gen_temp g "lst" ,(lst)
  Gen_temp g "e" ,(e)
  Gen_temp g "x" ,(x)
  Gen_temp g "rest" ,(rest)
  __String_equal__ of "of" ,(isOf)
  __if_then_else__ isOf (,() __NULL__ "Sjs_iter_values ") (,() __NULL__ "Sjs_iter_keys ") ,(iter)
  Cat5 rc iter rv " ,(" lst ,(c)
  Cat5 c ") __Ref_new__ " lst " ,(" list ,(c)
  __String_concat__ c ") " ,(c)
  ;; 条件：残りがあるか。あれば取り出して Ref を進める
  Cat5 "__Ref_get__ " list " ,(" lst ") __is_null__ " ,(testCode)
  Cat5 testCode lst " ,(" e ") __not__ " ,(testCode)
  Cat5 testCode e " ,(" e "n) " ,(testCode)
  __String_concat__ e "n" ,(testVal)
  __is_null__ kind ,(assignOnly)
  Gen_loop g cx testCode testVal (,(inner)
    __Dict_new__ ,(idict)
    __LList_cons__ idict scope ,(iscope)
    Cat5 "__Ref_get__ " list " ,(" lst ") __LList_uncons__ __print_exit_error__ " ,(take)
    Cat5 take lst " ,(" x " " ,(take)
    Cat5 take rest ") __Ref_set__ " list " " ,(take)
    __String_concat__ take rest ,(take)
    __String_concat__ take " ,() " ,(take)
    __if_then_else__ assignOnly
      (,() Gen_write g scope name x)
      (,()
        __String_equal__ kind "const" ,(isConst)
        Gen_declare g iscope name isConst ,(iv)
        Cat5 "__Ref_new__ " x " ,(" iv ") ") ,(bind)
    Gen_branch g iscope body inner ,(bodyCode)
    Cat3 take bind bodyCode) "" ,(loopCode)
  __String_concat__ c loopCode)

;; ブロックの文の並び stmts（scope の最初の Dict が、このブロックのスコープ）。JavaScript と同じく、ブロックで
;; 宣言した名前（let、const、var）は、ブロックの始めから見えるように、先に Ref を作っておく（宣言の文は、その Ref に
;; 値を入れる）。自分を呼ぶ関数（const fact = (n) => ... fact(n - 1)）や、後で宣言する名前を使う関数のため
(define Gen_block_code ,(g scope stmts cx)
  Gen_hoist g scope stmts "" ,(code)
  Gen_stmts g scope stmts cx code)

(define Gen_hoist ,(g scope stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Sjs_get s "t" ,(t)
  __String_equal__ t "decl" ,(isDecl)
  __unless__ isDecl (,() Gen_hoist g scope rest acc ,(c) return c) ,()
  Sjs_get s "kind" ,(kind)
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "decls" ,(decls)
  Gen_hoist_decls g scope decls isConst acc ,(acc)
  Gen_hoist g scope rest acc)

(define Gen_hoist_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "name" ,(name)
  Gen_declare g scope name isConst ,(var)
  Cat3 acc "__Ref_new__ __NULL__ ,(" var ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_hoist_decls g scope rest isConst acc)

;; ── 式 ──

;; 式 e の手順の並びと、値の被演算子
(define Gen_expr ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      Gen_temp g "t" ,(v)
      Gen_quote text ,(q)
      Cat5 "__Number_fromString__ (,(msg) Sjs_throw \"SyntaxError\" \"a bad number\") " q " ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "str" ,(test__) __if__ test__
    (,() Sjs_get e "value" ,(value) Gen_quote value ,(q) return "" q) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __String_equal__ text "true" ,(test__) __if__ test__ (,() return "" "__TRUE__") ,()
      __String_equal__ text "false" ,(test__) __if__ test__ (,() return "" "__FALSE__") ,()
      Gen_temp g "t" ,(v)
      Cat3 "__Ref_new__ __NULL__ ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Sjs_get e "name" ,(name) Gen_read g scope name ,(c v) return c v) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_expr g scope inner ,(c v) return c v) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__ (,() Gen_unary g scope e ,(c v) return c v) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Gen_binary g scope e ,(c v) return c v) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__ (,() Gen_cond g scope e ,(c v) return c v) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__ (,() Gen_assign g scope e ,(c v) return c v) ,()
  __String_equal__ t "update" ,(test__) __if__ test__ (,() Gen_update g scope e ,(c v) return c v) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Gen_call g scope e ,(c v) return c v) ,()
  __String_equal__ t "arrow" ,(isArrow)
  __String_equal__ t "function" ,(isFunction)
  __or__ isArrow isFunction ,(test__) __if__ test__ (,() Gen_named g scope e "" ,(c v) return c v) ,()
  __String_equal__ t "member" ,(test__) __if__ test__ (,() Gen_member g scope e ,(c v) return c v) ,()
