  __if_then_else__ isOf
    (,() Cat5 "Sjs_iter_more " list " ,(" e "n) ")
    (,()
      Cat5 "__Ref_get__ " list " ,(" lst ") __is_null__ " ,(testCode)
      Cat5 testCode lst " ,(" e ") __not__ " ,(testCode)
      Cat5 testCode e " ,(" e "n) ") ,(testCode)
  __String_concat__ e "n" ,(testVal)
  __is_null__ kind ,(assignOnly)
  Gen_loop g cx testCode testVal (,(inner)
    __Dict_new__ ,(idict)
    __LList_cons__ idict scope ,(iscope)
    __if_then_else__ isOf
      (,() Cat5 "Sjs_iter_take " list " ,(" x ") ")
      (,()
        Cat5 "__Ref_get__ " list " ,(" lst ") __LList_uncons__ __print_exit_error__ " ,(take)
        Cat5 take lst " ,(" x " " ,(take)
        Cat5 take rest ") __Ref_set__ " list " " ,(take)
        __String_concat__ take rest ,(take)
        __String_concat__ take " ,() ") ,(take)
    __if_then_else__ assignOnly
      (,() Gen_pattern g scope target x __FALSE__)
      (,()
        __String_equal__ kind "const" ,(isConst)
        Gen_pattern_names target __NULL__ ,(names)
        Gen_hoist_names g iscope names isConst "" ,(h)
        Gen_pattern g iscope target x __TRUE__ ,(b)
        __String_concat__ h b) ,(bind)
    Gen_branch g iscope body inner ,(bodyCode)
    Cat3 take bind bodyCode) "" ,(loopCode)
  __String_concat__ c loopCode)

;; try 文。catch は Sjs_try（受け手の継続を積む）。finally は、本体と catch を、例外を受けて finally を実行してから
;; 投げ直す Sjs_try で包み、ふつうに終わった後にも finally を実行する。本体の中の return、break、continue は、
;; finally を実行してから外へ出る Closure（fin を呼ぶ）に置き換える：
;;   Sjs_handlers ,(hT) __NULL__ (,() finally の文 __nop__) ,(fin)
;;   __NULL__ (,(v) Sjs_set_handlers hT ,() fin ,() 外の return v) ,(retW) ...（break、continue も）
;;   Sjs_try (,() 本体と catch __nop__) (,(exc) fin ,() Sjs_raise exc) ,() fin ,()
(define Gen_try ,(g scope s cx)
  __Cont_get__ ,(return)
  Sjs_get s "body" ,(body)
  Sjs_get s "param" ,(param)
  Sjs_get s "handler" ,(handler)
  Sjs_get s "finalizer" ,(finalizer)
  __is_null__ finalizer ,(noFinally)
  __if__ noFinally (,() Gen_try_catch g scope body param handler cx ,(c) return c) ,()
  Gen_temp g "h" ,(hT)
  Gen_temp g "fin" ,(fin)
  Sjs_get finalizer "body" ,(fstmts)
  __Dict_new__ ,(fdict)
  __LList_cons__ fdict scope ,(fscope)
  Gen_block_code g fscope fstmts cx ,(finCode)
  Cat4 "Sjs_handlers ,(" hT ") __NULL__ (,() " finCode ,(c)
  Cat3 c "__nop__) ,(" fin ,(c)
  __String_concat__ c ") " ,(c)
  ;; return、break、continue を、finally を通すものにする
  __NULL__ (,(cx kind c)
    __Cont_get__ ,(ret)
    Sjs_get cx kind ,(k)
    __String_equal__ k "" ,(none)
    __if__ none (,() ret cx c) ,()
    Gen_temp g "w" ,(w)
    __String_equal__ kind "ret" ,(isRet)
    __if_then_else__ isRet (,() __NULL__ "v" "v") (,() __NULL__ "" "") ,(param arg)
    __String_concat__ "w" w ,(wv)
    Gen_jump cx kind arg ,(jump)
    Cat4 c "__NULL__ (,(" param ") Sjs_set_handlers " ,(c)
    Cat5 c hT " ,() " fin " ,() " ,(c)
    Cat5 c jump ") ,(" w ") " ,(c)
    Gen_cx_with cx kind w ,(cx)
    __String_concat__ kind "H" ,(hk)
    Gen_cx_with cx hk "" ,(cx)
    __NULL__ cx c) ,(wrap)
  wrap cx "ret" c ,(icx c)
  wrap icx "brk" c ,(icx c)
  wrap icx "cnt" c ,(icx c)
  __is_null__ handler ,(noCatch)
  __if_then_else__ noCatch
    (,() Sjs_get body "body" ,(stmts) __Dict_new__ ,(d) __LList_cons__ d scope ,(bscope) Gen_block_code g bscope stmts icx)
    (,() Gen_try_catch g scope body param handler icx) ,(inner)
  Cat4 c "Sjs_try (,() " inner "__nop__) (,(exc) " ,(c)
  Cat4 c fin " ,() Sjs_raise exc) ,() " fin ,(c)
  __String_concat__ c " ,() ")

;; try { body } catch (param) { handler }
(define Gen_try_catch ,(g scope body param handler cx)
  Sjs_get body "body" ,(bstmts)
  __Dict_new__ ,(bdict)
  __LList_cons__ bdict scope ,(bscope)
  Gen_block_code g bscope bstmts cx ,(bodyCode)
  __Dict_new__ ,(hdict)
  __LList_cons__ hdict scope ,(hscope)
  Gen_temp g "exc" ,(exc)
  __is_null__ param ,(noParam)
  __if_then_else__ noParam
    (,() __NULL__ "")
    (,()
      Gen_pattern_names param __NULL__ ,(names)
      Gen_hoist_names g hscope names __FALSE__ "" ,(h)
      Gen_pattern g hscope param exc __TRUE__ ,(b)
      __String_concat__ h b) ,(bind)
  Sjs_get handler "body" ,(hstmts)
  Gen_block_code g hscope hstmts cx ,(handlerCode)
  Cat5 "Sjs_try_catch (,() " bodyCode "__nop__) (,(" exc ") " ,(c)
  Cat4 c bind handlerCode "__nop__) ,() ")

;; ブロックの文の並び stmts（scope の最初の Dict が、このブロックのスコープ）。JavaScript と同じく、ブロックで
;; 宣言した名前（let、const、var）は、ブロックの始めから見えるように、先に Ref を作っておく（宣言の文は、その Ref に
;; 値を入れる）。自分を呼ぶ関数（const fact = (n) => ... fact(n - 1)）や、後で宣言する名前を使う関数のため
(define Gen_block_code ,(g scope stmts cx)
  Gen_hoist g scope stmts "" ,(code)
  Gen_funcdecls g scope stmts code ,(code)
  Gen_stmts g scope stmts cx code)

;; 関数の宣言の値を、ブロックの始めで（名前の Ref を作った後に）入れる
(define Gen_funcdecls ,(g scope stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Sjs_get s "t" ,(t)
  __String_equal__ t "funcdecl" ,(test__) __unless__ test__ (,() Gen_funcdecls g scope rest acc ,(c) return c) ,()
  Sjs_get s "name" ,(name)
  Sjs_get s "fn" ,(fn)
  Gen_named g scope fn name ,(c v)
  Gen_lookup scope name ,(var isConst)
  Cat5 acc c "__Ref_set__ " var " " ,(acc)
  Cat3 acc v " ,() " ,(acc)
  Gen_funcdecls g scope rest acc)

(define Gen_hoist ,(g scope stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Sjs_get s "t" ,(t)
  __String_equal__ t "funcdecl" ,(test__) __if__ test__
    (,()
      Sjs_get s "name" ,(name)
      __LList_cons__ name __NULL__ ,(names)
      Gen_hoist_names g scope names __FALSE__ acc ,(acc)
      Gen_hoist g scope rest acc ,(c)
      return c) ,()
  __String_equal__ t "decl" ,(isDecl)
  __unless__ isDecl (,() Gen_hoist g scope rest acc ,(c) return c) ,()
  Sjs_get s "kind" ,(kind)
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "decls" ,(decls)
  Gen_hoist_decls g scope decls isConst acc ,(acc)
  Gen_hoist g scope rest acc)

(define Gen_hoist_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "target" ,(target)
  Gen_pattern_names target __NULL__ ,(names)
  Gen_hoist_names g scope names isConst acc ,(acc)
  Gen_hoist_decls g scope rest isConst acc)

;; 名前を宣言して、それぞれの Ref を作る手順
(define Gen_hoist_names ,(g scope names isConst acc)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Gen_declare g scope name isConst ,(var)
  Cat3 acc "__Ref_new__ __NULL__ ,(" var ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_hoist_names g scope rest isConst acc)

;; ── 式 ──

;; 式 e の手順の並びと、値の被演算子
(define Gen_expr ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      Gen_temp g "t" ,(v)
      Gen_quote text ,(q)
      Cat5 "__Number_fromString__ (,(msg) Sjs_throw \"SyntaxError\" \"a bad number\") " q " ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "str" ,(test__) __if__ test__
    (,() Sjs_get e "value" ,(value) Gen_quote value ,(q) return "" q) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __String_equal__ text "true" ,(test__) __if__ test__ (,() return "" "__TRUE__") ,()
      __String_equal__ text "false" ,(test__) __if__ test__ (,() return "" "__FALSE__") ,()
      Gen_temp g "t" ,(v)
      Cat3 "__Ref_new__ __NULL__ ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Sjs_get e "name" ,(name) Gen_read g scope name ,(c v) return c v) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_expr g scope inner ,(c v) return c v) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__ (,() Gen_unary g scope e ,(c v) return c v) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Gen_binary g scope e ,(c v) return c v) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__ (,() Gen_cond g scope e ,(c v) return c v) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__ (,() Gen_assign g scope e ,(c v) return c v) ,()
  __String_equal__ t "update" ,(test__) __if__ test__ (,() Gen_update g scope e ,(c v) return c v) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Gen_call g scope e ,(c v) return c v) ,()
  __String_equal__ t "arrow" ,(isArrow)
  __String_equal__ t "function" ,(isFunction)
  __or__ isArrow isFunction ,(test__) __if__ test__ (,() Gen_named g scope e "" ,(c v) return c v) ,()
  __String_equal__ t "member" ,(test__) __if__ test__ (,() Gen_member g scope e ,(c v) return c v) ,()
  __String_equal__ t "array" ,(test__) __if__ test__ (,() Gen_array g scope e ,(c v) return c v) ,()
  __String_equal__ t "object" ,(test__) __if__ test__ (,() Gen_object g scope e ,(c v) return c v) ,()
  __String_equal__ t "template" ,(test__) __if__ test__ (,() Gen_template g scope e ,(c v) return c v) ,()
  __String_equal__ t "yield" ,(test__) __if__ test__ (,() Gen_yield g scope e ,(c v) return c v) ,()
  __String_concat__ "an expression of " t ,(what)
  Gen_not_yet what)

;; 名前を読む
(define Gen_read ,(g scope name)
  __Cont_get__ ,(return)
  Gen_lookup scope name ,(var isConst)
  Gen_temp g "t" ,(v)
  Str_has_dollar name ,(test__) __if__ test__
    (,() Gen_quote name ,(q) Cat5 "Sjs_shell_get " q " ,(" v ") " ,(c) return c v) ,()
  __is_null__ var ,(global)
  __unless__ global (,() Cat5 "__Ref_get__ " var " ,(" v ") " ,(c) return c v) ,()
  __String_equal__ name "undefined" ,(test__) __if__ test__ (,() return "" "__NULL__") ,()
  Gen_quote name ,(q)
  Cat5 "Sjs_global G " q " ,(" v ") " ,(c)
  __NULL__ c v)

;; 名前に値 val を入れる手順
(define Gen_write ,(g scope name val)
  __Cont_get__ ,(return)
  Str_has_dollar name ,(test__) __if__ test__
    (,()
      __String_concat__ "cannot assign to the shell variable " name ,(msg)
      Gen_quote msg ,(q)
      Cat3 "Sjs_type_error " q " ,() " ,(c)
      return c) ,()
  Gen_lookup scope name ,(var isConst)
  __if__ isConst (,() Gen_error "Assignment to constant variable.") ,()
  __is_null__ var ,(global)
  __unless__ global (,() Cat5 "__Ref_set__ " var " " val " ,() " ,(c) return c) ,()
  Gen_quote name ,(q)
  Cat5 "Sjs_set_global G " q " " val " ,() ")

;; 式の値を名前のない変数に入れる手順（val が変数でないときも、一時変数にする）
(define Gen_unary ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "arg" ,(arg)
  Sjs_in_words op "- + ~" ,(numeric)
  __if_then_else__ numeric (,() Gen_operand g scope arg) (,() Gen_expr g scope arg) ,(code val)
  Gen_temp g "t" ,(v)
  __String_equal__ op "!" ,(test__) __if__ test__
    (,()
      Gen_temp g "b" ,(b)
      Cat5 code "Sjs_truthy " val " ,(" b ,(c)
      Cat5 c ") __not__ " b " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  __String_equal__ op "-" ,(isNeg)
  __String_equal__ op "+" ,(isPos)
  __String_equal__ op "typeof" ,(isTypeof)
  __if_then_else__ isNeg (,() __NULL__ "Sjs_neg ") (,()
  __if_then_else__ isPos (,() __NULL__ "Sjs_pos ") (,()
  __String_equal__ op "~" ,(isBnot)
  __if_then_else__ isTypeof (,() __NULL__ "Sjs_typeof ") (,()
  __if_then_else__ isBnot (,() __NULL__ "Sjs_bnot ") (,()
    __String_concat__ "the operator " op ,(what) Gen_not_yet what)))) ,(f)
  Cat5 code f val " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; 数を要る演算子の被演算子：$名前（括弧を透過）なら、値を数にする手順を足す（consh/SAFEJS-PLAN-ja.md の 2.2 の 7）
(define Gen_operand ,(g scope e)
  __Cont_get__ ,(return)
  Gen_expr g scope e ,(c v)
  Gen_shell_name e ,(name)
  __is_null__ name ,(test__) __if__ test__ (,() return c v) ,()
  Gen_temp g "t" ,(n)
  Gen_quote name ,(q)
  Cat5 c "Sjs_shell_number " v " " q ,(c)
  Cat3 c " ,(" n ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c n)

;; 式が（括弧で囲んだ）$名前 なら、その名前。そうでなければ null
(define Gen_shell_name ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_shell_name inner ,(n) return n) ,()
  __String_equal__ t "id" ,(isId)
  __unless__ isId (,() return __NULL__) ,()
  Sjs_get e "name" ,(name)
  Str_has_dollar name ,(d)
  __if_then_else__ d (,() __NULL__ name) (,() __NULL__ __NULL__))

;; 数のリテラル（-3 も）か
(define Gen_is_num_literal ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_is_num_literal inner ,(b) return b) ,()
  __String_equal__ t "num" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ t "unary" ,(isUnary)
  __unless__ isUnary (,() return __FALSE__) ,()
  Sjs_get e "op" ,(op)
  __String_equal__ op "-" ,(minus)
  __unless__ minus (,() return __FALSE__) ,()
  Sjs_get e "arg" ,(arg)
  Gen_is_num_literal arg)

;; 二項演算子の実行時の関数（なければ null）
(define Gen_binary_fn ,(op)
  __Cont_get__ ,(return)
  __NULL__ (,(o f) __String_equal__ op o ,(t) __if__ t (,() return f)) ,(map)
  map "+" "Sjs_add" ,()
  map "-" "Sjs_sub" ,()
  map "*" "Sjs_mul" ,()
  map "/" "Sjs_div" ,()
  map "%" "Sjs_mod" ,()
  map "<" "Sjs_lt" ,()
  map "<=" "Sjs_le" ,()
  map ">" "Sjs_gt" ,()
  map ">=" "Sjs_ge" ,()
  map "===" "Sjs_seq" ,()
  map "**" "Sjs_pow" ,()
  map "&" "Sjs_band" ,()
  map "|" "Sjs_bor" ,()
  map "^" "Sjs_bxor" ,()
  map "<<" "Sjs_shl" ,()
  map ">>" "Sjs_shr" ,()
  map ">>>" "Sjs_ushr" ,()
  __NULL__ __NULL__)

(define Gen_binary ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "left" ,(left)
  Sjs_get e "right" ,(right)
  __String_equal__ op "&&" ,(isAnd)
  __String_equal__ op "||" ,(isOr)
  __String_equal__ op "??" ,(isNullish)
  __or__ isAnd isOr ,(logical)
  __or__ logical isNullish ,(test__) __if__ test__ (,() Gen_logical g scope op left right ,(c v) return c v) ,()
  ;; === と !== は、もう一方が数のリテラルなら $名前 を数にする。ほかの演算子（=== を除く）は、いつも数にする
  __String_equal__ op "===" ,(isSeq)
  __String_equal__ op "!==" ,(isSne)
  __or__ isSeq isSne ,(equality)
  Gen_is_num_literal left ,(leftNum)
  Gen_is_num_literal right ,(rightNum)
  __not__ equality ,(numeric)
  __or__ numeric rightNum ,(numLeft)
  __or__ numeric leftNum ,(numRight)
  __if_then_else__ numLeft (,() Gen_operand g scope left) (,() Gen_expr g scope left) ,(lc lv)
  __if_then_else__ numRight (,() Gen_operand g scope right) (,() Gen_expr g scope right) ,(rc rv)
  __String_concat__ lc rc ,(code)
  Gen_temp g "t" ,(v)
  __String_equal__ op "!==" ,(test__) __if__ test__
    (,()
      Gen_temp g "b" ,(b)
      Cat5 code "Sjs_seq " lv " " rv ,(c)
      Cat5 c " ,(" b ") __not__ " b ,(c)
      Cat3 c " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  Gen_binary_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Cat5 code f " " lv " " ,(c)
  Cat4 c rv " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; a && b、a || b、a ?? b：b は、必要なときだけ求める
(define Gen_logical ,(g scope op left right)
  Gen_expr g scope left ,(lc lv)
  Gen_expr g scope right ,(rc rv)
  Gen_temp g "b" ,(b)
  Gen_temp g "t" ,(v)
  __String_equal__ op "??" ,(isNullish)
  __String_equal__ op "&&" ,(isAnd)
  __if_then_else__ isNullish (,() __NULL__ "Sjs_is_nullish ") (,() __NULL__ "Sjs_truthy ") ,(f)
  Cat5 rc "__NULL__ " rv "" "" ,(evalRight)
  __String_concat__ "__NULL__ " lv ,(keepLeft)
  ;; && は真なら右、|| は偽なら右、?? は null か undefined なら右
  __or__ isAnd isNullish ,(rightWhenTrue)
  __if_then_else__ rightWhenTrue (,() __NULL__ evalRight keepLeft) (,() __NULL__ keepLeft evalRight) ,(yes no)
  Cat5 lc f lv " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() " yes ,(c)
  Cat3 c ") (,() " no ,(c)
  Cat3 c ") ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

(define Gen_cond ,(g scope e)
  Sjs_get e "test" ,(test)
  Sjs_get e "yes" ,(yes)
  Sjs_get e "no" ,(no)
  Gen_expr g scope test ,(tc tv)
  Gen_expr g scope yes ,(yc yv)
  Gen_expr g scope no ,(nc nv)
  Gen_temp g "b" ,(b)
  Gen_temp g "t" ,(v)
  Cat5 tc "Sjs_truthy " tv " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() " yc ,(c)
  Cat4 c "__NULL__ " yv ") (,() " ,(c)
  Cat4 c nc "__NULL__ " nv ,(c)
  Cat3 c ") ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; 複合の代入の演算子の関数（なければ null）
(define Gen_assign_fn ,(op)
  __Cont_get__ ,(return)
  __NULL__ (,(o f) __String_equal__ op o ,(t) __if__ t (,() return f)) ,(map)
  map "+=" "Sjs_add" ,()
  map "-=" "Sjs_sub" ,()
  map "*=" "Sjs_mul" ,()
  map "/=" "Sjs_div" ,()
  map "%=" "Sjs_mod" ,()
  map "**=" "Sjs_pow" ,()
  map "&=" "Sjs_band" ,()
  map "|=" "Sjs_bor" ,()
  map "^=" "Sjs_bxor" ,()
  map "<<=" "Sjs_shl" ,()
  map ">>=" "Sjs_shr" ,()
  map ">>>=" "Sjs_ushr" ,()
  __NULL__ __NULL__)

;; 名前 name を付けて式を求める（関数なら、その名前を console.log に出す。const f = () => ... の f）
(define Gen_named ,(g scope e name)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "arrow" ,(isArrow)
  __String_equal__ t "function" ,(isFunction)
  __if__ isFunction
    (,()
      __Dict_lookup_or__ e "name" (,(k) __NULL__ "") ,(own)
      __String_equal__ own "" ,(anon)
      __unless__ anon (,() Gen_function g scope e own ,(c v) return c v) ,()) ,()
  __or__ isArrow isFunction ,(test__) __if__ test__ (,() Gen_function g scope e name ,(c v) return c v) ,()
  Gen_expr g scope e)

;; メンバーのキー：.名前 なら文字列のリテラル、[式] なら、式を求めて Sjs_key で確かめる手順
(define Gen_key ,(g scope m)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ m "name" (,(k) __NULL__ __NULL__) ,(name)
  __is_null__ name ,(test__) __unless__ test__ (,() Gen_quote name ,(q) return "" q) ,()
  Sjs_get m "key" ,(key)
  Gen_expr g scope key ,(kc kv)
  Gen_temp g "k" ,(k)
  Cat5 kc "Sjs_key " kv " ,(" k ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c k)

;; o.名前、o[式]、o?.名前、o?.[式]
(define Gen_member ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "object" ,(object)
  __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(optional)
  Gen_expr g scope object ,(oc ov)
  Gen_key g scope e ,(kc kv)
  Gen_temp g "t" ,(v)
  Cat5 "Sjs_get_member G " ov " " kv " ,(" ,(get)
  Cat3 get v ") " ,(get)
  __unless__ optional (,() Cat3 oc kc get ,(c) return c v) ,()
  ;; ?. は、o が null か undefined なら undefined（キーは求めない）
  Gen_temp g "b" ,(b)
  Cat5 oc "Sjs_is_nullish " ov " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() __NULL__ __NULL__) (,() " kc ,(c)
  Cat5 c "Sjs_get_member G " ov " " kv ,(c)
  Cat5 c " ,(" v "x) __NULL__ " v ,(c)
  Cat5 c "x) ,(" v ") " "" ,(c)
  __NULL__ c v)

;; [a, b, ...]（スプレッドもある）
(define Gen_array ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "items" ,(items)
  Gen_has_spread items ,(spread)
  __if__ spread
    (,()
      Gen_temp g "a" ,(a)
      Cat3 "Sjs_array_new G ,(" a ") " ,(code)
      Gen_push_items g scope items a code ,(code)
      return code a) ,()
  Gen_args g scope items ,(code list)
  Gen_temp g "t" ,(v)
  Cat5 code "Sjs_array G " list " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; { キー: 値, ...o, ... }：空のオブジェクトを作り、順に入れる
(define Gen_object ,(g scope e)
  Sjs_get e "props" ,(props)
  Gen_temp g "o" ,(o)
  Cat3 "Sjs_object_new G ,(" o ") " ,(code)
  Gen_props g scope props o code)

(define Gen_props ,(g scope props o code)
  __Cont_get__ ,(return)
  __is_null__ props ,(test__) __if__ test__ (,() return code o) ,()
  __LList_uncons__ __print_exit_error__ props ,(prop rest)
  Sjs_get prop "t" ,(t)
  __String_equal__ t "spread" ,(isSpread)
  __if__ isSpread
    (,()
      Sjs_get prop "arg" ,(a)
      Gen_expr g scope a ,(ac av)
      Cat5 code ac "Sjs_object_spread " o " " ,(code)
      Cat3 code av " ,() " ,(code)
      Gen_props g scope rest o code ,(c v)
      return c v) ,()
  Sjs_get prop "computed" ,(computed)
  __is_null__ computed ,(static)
  __if_then_else__ static
    (,() Sjs_get prop "key" ,(key) Gen_quote key ,(q) __NULL__ "" q key)
    (,()
      Gen_expr g scope computed ,(kc kv)
      Gen_temp g "k" ,(k)
      Cat5 kc "Sjs_key " kv " ,(" k ,(c)
      Cat3 c ") Sjs_key_string " k ,(c)
      Cat3 c " ,(" k ,(c)
      __String_concat__ c "s) " ,(c)
      __String_concat__ k "s" ,(ks)
      __NULL__ c ks "") ,(kc kv keyName)
  Sjs_get prop "value" ,(value)
  Gen_named g scope value keyName ,(vc vv)
  Cat5 code kc vc "Sjs_obj_set " o ,(code)
  Cat5 code " " kv " " vv ,(code)
  __String_concat__ code " ,() " ,(code)
  Gen_props g scope rest o code)

;; `文字列 ${式} 文字列 ...`：式は String にしてつなぐ
(define Gen_template ,(g scope e)
  Sjs_get e "parts" ,(parts)
  Sjs_get e "exprs" ,(exprs)
  __LList_uncons__ __print_exit_error__ parts ,(first rest)
  Gen_quote first ,(q)
  Gen_temp g "s" ,(acc)
  Cat5 "__NULL__ " q " ,(" acc ") " ,(code)
  Gen_template_rest g scope rest exprs code acc)

(define Gen_template_rest ,(g scope parts exprs code acc)
  __Cont_get__ ,(return)
  __is_null__ exprs ,(test__) __if__ test__ (,() return code acc) ,()
  __LList_uncons__ __print_exit_error__ exprs ,(e moreExprs)
  __LList_uncons__ __print_exit_error__ parts ,(part moreParts)
  Gen_expr g scope e ,(ec ev)
  Gen_temp g "s" ,(s)
  Gen_temp g "s" ,(a1)
  Gen_temp g "s" ,(a2)
  Gen_quote part ,(q)
  Cat5 code ec "Sjs_to_string " ev " ,(" ,(code)
  Cat5 code s ") __String_concat__ " acc " " ,(code)
  Cat5 code s " ,(" a1 ") __String_concat__ " ,(code)
  Cat5 code a1 " " q " ,(" ,(code)
  Cat3 code a2 ") " ,(code)
  Gen_template_rest g scope moreParts moreExprs code a2)

;; 代入。名前か、メンバー（o.名前 = v、o[k] = v。o とキーは 1 回だけ求める）
(define Gen_assign ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "target" ,(target)
  Sjs_get e "value" ,(value)
  Sjs_get target "t" ,(tt)
  __String_equal__ tt "member" ,(test__) __if__ test__ (,() Gen_assign_member g scope op target value ,(c v) return c v) ,()
  __String_equal__ tt "arrayPattern" ,(isArrayPat)
  __String_equal__ tt "objectPattern" ,(isObjectPat)
  __or__ isArrayPat isObjectPat ,(test__) __if__ test__
    (,()
      Gen_expr g scope value ,(vc vv)
      Gen_pattern g scope target vv __FALSE__ ,(pc)
      __String_concat__ vc pc ,(c)
      return c vv) ,()
  Sjs_get target "name" ,(name)
  __String_equal__ op "=" ,(test__) __if__ test__
    (,()
      Gen_named g scope value name ,(vc vv)
      Gen_write g scope name vv ,(wc)
      __String_concat__ vc wc ,(c)
      return c vv) ,()
  Gen_operand g scope value ,(vc vv)
  Gen_assign_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Gen_read g scope name ,(rc rv)
  Gen_temp g "t" ,(v)
  Cat4 rc vc f " " ,(c)
  Cat5 c rv " " vv " ,(" ,(c)
  Cat3 c v ") " ,(c)
  Gen_write g scope name v ,(wc)
  __String_concat__ c wc ,(c)
  __NULL__ c v)

(define Gen_assign_member ,(g scope op target value)
  __Cont_get__ ,(return)
  Sjs_get target "object" ,(object)
  Gen_expr g scope object ,(oc ov)
  Gen_key g scope target ,(kc kv)
  __String_concat__ oc kc ,(prefix)
  __Dict_lookup_or__ target "name" (,(k) __NULL__ "") ,(keyName)
  __String_equal__ op "=" ,(test__) __if__ test__
    (,()
      Gen_named g scope value keyName ,(vc vv)
      Cat5 prefix vc "Sjs_set_member G " ov " " ,(c)
      Cat4 c kv " " vv ,(c)
      __String_concat__ c " ,() " ,(c)
      return c vv) ,()
  Gen_expr g scope value ,(vc vv)
  Gen_assign_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Gen_temp g "t" ,(old)
  Gen_temp g "t" ,(v)
  Cat5 prefix vc "Sjs_get_member G " ov " " ,(c)
  Cat5 c kv " ,(" old ") " ,(c)
  Cat5 c f " " old " " ,(c)
  Cat5 c vv " ,(" v ") " ,(c)
  Cat5 c "Sjs_set_member G " ov " " kv ,(c)
  Cat3 c " " v ,(c)
  __String_concat__ c " ,() " ,(c)
  __NULL__ c v)

;; ++x、x++、--x、x--（x は名前かメンバー）
(define Gen_update ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "prefix" ,(prefix)
  Sjs_get e "target" ,(target)
  Gen_temp g "d" ,(d)
  Gen_temp g "t" ,(v)
  __String_equal__ op "++" ,(inc)
  __if_then_else__ inc (,() __NULL__ "\"1\"") (,() __NULL__ "\"-1\"") ,(dText)
  Sjs_get target "t" ,(tt)
  __String_equal__ tt "member" ,(isMember)
  __if__ isMember
    (,()
      Sjs_get target "object" ,(object)
      Gen_expr g scope object ,(oc ov)
      Gen_key g scope target ,(kc kv)
      Gen_temp g "t" ,(old)
      Cat5 oc kc "Sjs_get_member G " ov " " ,(c)
      Cat5 c kv " ,(" old ") " ,(c)
      Cat5 c "__Number_fromString__ __print_exit_error__ " dText " ,(" d ,(c)
      Cat5 c ") Sjs_step " old " " d ,(c)
      Cat3 c " ,(" v ,(c)
      Cat5 c ") Sjs_set_member G " ov " " kv ,(c)
      Cat3 c " " v ,(c)
      __String_concat__ c " ,() " ,(c)
      __if_then_else__ prefix (,() __NULL__ v) (,() __NULL__ old) ,(result)
      return c result) ,()
  Sjs_get target "name" ,(name)
  Gen_read g scope name ,(rc rv)
  Cat5 rc "__Number_fromString__ __print_exit_error__ " dText " ,(" d ,(c)
  Cat5 c ") Sjs_step " rv " " d ,(c)
  Cat3 c " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  Gen_write g scope name v ,(wc)
  __String_concat__ c wc ,(c)
  __if_then_else__ prefix (,() __NULL__ v) (,() __NULL__ rv) ,(result)
  __NULL__ c result)

(define Gen_args ,(g scope args)
  __Cont_get__ ,(return)
  Gen_has_spread args ,(spread)
  __unless__ spread
    (,()
      Gen_arg_values g scope args "" __NULL__ ,(code vals)
      ;; vals は逆順（最後の引数が先）なので、そのまま後ろから cons する
      Gen_cons_list g vals code "__NULL__" ,(c l)
      return c l) ,()
  ;; スプレッドがあれば、配列に足していってから LList にする
  Gen_temp g "a" ,(a)
  Cat3 "Sjs_array_new G ,(" a ") " ,(code)
  Gen_push_items g scope args a code ,(code)
  Gen_temp g "l" ,(l)
  Cat5 code "Sjs_array_list " a " ,(" l ,(code)
  __String_concat__ code ") " ,(code)
  __NULL__ code l)

(define Gen_has_spread ,(items)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ items ,(x rest)
  Sjs_get x "t" ,(t)
  __String_equal__ t "spread" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Gen_has_spread rest)

;; 配列 a に、式（スプレッドは中身を）を足す手順
(define Gen_push_items ,(g scope items a code)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() return code) ,()
  __LList_uncons__ __print_exit_error__ items ,(x rest)
  Sjs_get x "t" ,(t)
  __String_equal__ t "spread" ,(isSpread)
  __if_then_else__ isSpread (,() Sjs_get x "arg") (,() __NULL__ x) ,(e)
  Gen_expr g scope e ,(c v)
  __if_then_else__ isSpread (,() __NULL__ "Sjs_spread_into ") (,() __NULL__ "Sjs_array_push ") ,(f)
  Cat5 code c f a " " ,(code)
  Cat3 code v " ,() " ,(code)
  Gen_push_items g scope rest a code)

(define Gen_arg_values ,(g scope args code vals)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return code vals) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Gen_expr g scope a ,(c v)
  __String_concat__ code c ,(code)
  __LList_cons__ v vals ,(vals)
  Gen_arg_values g scope rest code vals)

(define Gen_cons_list ,(g vals code list)
  __Cont_get__ ,(return)
  __is_null__ vals ,(test__) __if__ test__ (,() return code list) ,()
  __LList_uncons__ __print_exit_error__ vals ,(v rest)
  Gen_temp g "l" ,(l)
  Cat5 code "__LList_cons__ " v " " list ,(code)
  Cat4 code " ,(" l ") " ,(code)
  Gen_cons_list g rest code l)

;; 呼び出し。o.m(...) と o[k](...) は Sjs_call_member、f?.(...) は f が null か undefined なら undefined
(define Gen_call ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "callee" ,(callee)
  Sjs_get e "args" ,(args)
  __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(optional)
  Sjs_get callee "t" ,(ct)
  __String_equal__ ct "member" ,(isMember)
  __Dict_lookup_or__ callee "optional" (,(k) __NULL__ __FALSE__) ,(optMember)
  __not__ optMember ,(plainMember)
  __not__ optional ,(plainCall)
  __and__ isMember plainMember ,(x)
  __and__ x plainCall ,(test__) __if__ test__
    (,()
      Sjs_get callee "object" ,(object)
      Gen_expr g scope object ,(oc ov)
      Gen_key g scope callee ,(kc kv)
      Gen_args g scope args ,(ac list)
      Gen_temp g "t" ,(v)
      Cat5 oc kc ac "Sjs_call_member G " ov ,(c)
      Cat5 c " " kv " " list ,(c)
      Cat3 c " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  Gen_expr g scope callee ,(fc fv)
  Gen_args g scope args ,(ac list)
  Gen_temp g "t" ,(v)
  __unless__ optional
    (,()
      Cat5 fc ac "Sjs_call " fv " " ,(c)
      Cat4 c list " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  Gen_temp g "b" ,(b)
  Cat5 fc "Sjs_is_nullish " fv " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() __NULL__ __NULL__) (,() " ac ,(c)
  Cat5 c "Sjs_call " fv " " list ,(c)
  Cat5 c " ,(" v "x) __NULL__ " v ,(c)
  Cat3 c "x) ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; アロー関数と function 式：Sjs_function G (,(args) __Cont_get__ ,(return) 引数を束縛する 本体 return __NULL__)
(define Gen_function ,(g scope e name)
  __Cont_get__ ,(return)
  Sjs_get e "params" ,(params)
  Sjs_get e "body" ,(body)
  Sjs_get e "expr" ,(expr)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(inner)
  Gen_temp g "args" ,(args)
  Gen_params g inner params args "" ,(bind)
  __is_null__ body ,(concise)
  __if_then_else__ concise
    (,() Gen_expr g inner expr ,(c v) Cat4 c "return " v " ,() ")
    (,()
      Sjs_get body "body" ,(stmts)
      Gen_temp g "h" ,(h)
      Gen_cx __TRUE__ "" "" ,(fcx)
      Gen_cx_with fcx "ret" "return" ,(fcx)
      Gen_cx_with fcx "retH" h ,(fcx)
      Gen_block_code g inner stmts fcx ,(code)
      Cat4 "Sjs_handlers ,(" h ") " code) ,(bodyCode)
  Gen_temp g "t" ,(v)
  Gen_quote name ,(qn)
  ;; ジェネレータ：呼び出しは引数を入れてジェネレータのオブジェクトを返し、本体は、next で動かす thunk にする
  __Dict_lookup_or__ e "gen" (,(k) __NULL__ __FALSE__) ,(isGen)
  __if__ isGen
    (,()
      Gen_temp g "gen" ,(gv)
      Cat3 "Sjs_generator G (,() __Cont_get__ ,(return) " bodyCode "return __NULL__) ,(" ,(gc)
      Cat5 gc gv ") return " gv " " ,(bodyCode)
      Cat5 "Sjs_function G " qn " (,(" args ") __Cont_get__ ,(return) " ,(c)
      Cat4 c bind bodyCode ") ,(" ,(c)
      Cat3 c v ") " ,(c)
      return c v) ,()
  Cat5 "Sjs_function G " qn " (,(" args ") __Cont_get__ ,(return) " ,(c)
  Cat4 c bind bodyCode "return __NULL__) ,(" ,(c)
  Cat3 c v ") " ,(c)
  __NULL__ c v)

(define Gen_params ,(g scope params args acc)
  Gen_pattern_names_list params __NULL__ ,(names)
  Gen_hoist_names g scope names __FALSE__ acc ,(acc)
  Gen_params_bind g scope params args acc)

;; 引数の形に、引数の LList args の先頭から入れる。rest は残りの配列
(define Gen_params_bind ,(g scope params args acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(param rest)
  Sjs_get param "t" ,(t)
  __String_equal__ t "rest" ,(isRest)
  __if__ isRest
    (,()
      Sjs_get param "target" ,(target)
      Gen_temp g "t" ,(a)
      Cat5 acc "Sjs_array G " args " ,(" a ,(acc)
      __String_concat__ acc ") " ,(acc)
      Gen_pattern g scope target a __TRUE__ ,(c)
      __String_concat__ acc c ,(acc)
      return acc) ,()
  Gen_temp g "a" ,(a)
  Gen_temp g "r" ,(r)
  Cat5 acc "Sjs_arg " args " ,(" a ,(acc)
  Cat3 acc " " r ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_pattern g scope param a __TRUE__ ,(c)
  __String_concat__ acc c ,(acc)
  Gen_params_bind g scope rest r acc)
