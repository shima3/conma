  Cat4 c ") " hoist dc ,(c)
  Cat5 c "__Number_fromString__ __print_exit_error__ \"-1\" ,(" start "n) __Ref_new__ " start ,(c)
  Cat5 c "n ,(" start ") (,() __Cont_get__ ,(" found ,(c)
  Cat4 c ") " matchCode defaultIdx ,(c)
  Cat3 c "__nop__) ,() " bodies ,(c)
  __String_concat__ c "__nop__) ,() ")

(define Gen_case_stmts ,(cases acc)
  __Cont_get__ ,(return)
  __is_null__ cases ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ cases ,(c rest)
  Sjs_get c "body" ,(body)
  __LList_append__ acc body ,(acc)
  Gen_case_stmts rest acc)

;; case の条件を順に比べる手順（一致すれば start に番号を入れて found で抜ける）と、default があれば start に
;; その番号を入れる手順
