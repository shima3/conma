;; SJS を ConMa のソースに変換する（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。
;; 構文木（sjs_parse.se）から、main を定義する ConMa のソースの String を作る。実行には sjs_rt.se を使う。
;;
;; 変換の形：
;; * 式は、値を求める手順の並び（「演算子 被演算子 ,(t) 」を並べたもの）と、その値を表す被演算子（変数名、
;;   文字列のリテラル、__TRUE__ など）にする。手順の並びは、そのまま後ろにつなげられる（Gen_expr）。
;; * 文は、手順の並びにする（Gen_stmt）。どの手順も ,(…) で終わるので、文をつなげて最後に __nop__ を置けば本体になる。
;; * 変数（let、const、var、引数）は Ref に入れ、名前ごとに一意の ConMa の変数名（v番号_名前）を付ける。そのため、
;;   ブロックの外に出ても束縛は残るが、名前は変換のときに解決するので、外の同じ名前とは混ざらない。
;;   宣言していない名前は大域の名前（SJS変数）で、文脈 G の Dict に置く（Sjs_global）。
;; * 関数は、引数の LList を受け取る Closure を Sjs_function で包む。本体の最初で __Cont_get__ ,(return) を取り、
;;   return 文はそれを呼ぶ。
;; * if は __if_then_else__、while は、Ref に入れた自分を呼ぶ thunk（末尾で呼ぶので CChain は伸びない）。
;; * &&、||、??、条件演算子は、__if_then_else__ の 2 つの thunk が値を返す形。
;; 変換の状態 g は Dict で、"n" に一時変数の番号の Ref を持つ。scope は Dict（名前 → ConMa の変数名）の LList
;; （内側が先）で、"const:名前" があれば const。
;; sjs_parse.se を使う

(define Sjs_translate ,(text)
  Sjs_parse text ,(program)
  __Dict_new__ ,(g)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(counter)
  __Dict_put__ g "n" counter ,()
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  Sjs_get program "body" ,(body)
  Gen_block_code g scope body __FALSE__ ,(code)
  __String_concat__ ";; SJS を変換したもの（consh/include/sjs_gen.se）\n(include \"util.se\")\n(include \"sjs_rt.se\")\n(define main ,(args)\n  Sjs_init ,(G)\n" code ,(s)
  __String_concat__ s "\n  __nop__)\n")

(define Gen_error ,(msg)
  Sjs_throw "SyntaxError" msg)

(define Gen_not_yet ,(what)
  __String_concat__ "not yet translated (stage B1 of SJS): " what ,(msg)
  Gen_error msg)

;; 新しい一時変数の名前（prefix に番号を付ける）
(define Gen_temp ,(g prefix)
  __Dict_lookup_or__ g "n" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ ref n ,()
  __Number_toString__ n ,(s)
  __String_concat__ prefix s)

;; 文字列を ConMa の文字列のリテラルにする
(define Gen_quote ,(s)
  Sjs_chars s ,(chars)
  Gen_quote_chars chars "\"")

(define Gen_quote_chars ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() __String_concat__ acc "\"" ,(s) return s) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "\"" ,(q)
  __String_equal__ c "\\" ,(b)
  __String_equal__ c "\n" ,(n)
  __String_equal__ c "\t" ,(t)
  __String_equal__ c "\r" ,(r)
  __String_toCode__ __print_exit_error__ c ,(code)
  __Number_fromString__ __print_exit_error__ "32" ,(space)
  __Number_subtract__ code space ,(d)
  __Number_is_negative__ d ,(control)
  __if_then_else__ q (,() __NULL__ "\\\"") (,()
  __if_then_else__ b (,() __NULL__ "\\\\") (,()
  __if_then_else__ n (,() __NULL__ "\\n") (,()
  __if_then_else__ t (,() __NULL__ "\\t") (,()
  __if_then_else__ r (,() __NULL__ "\\r") (,()
  __if_then_else__ control (,() Gen_not_yet "a control character in a string") (,() __NULL__ c)))))) ,(e)
  __String_concat__ acc e ,(acc)
  Gen_quote_chars rest acc)

;; 文字列をつなぐ（a b c ...）
(define Cat3 ,(a b c)
  __String_concat__ a b ,(s)
  __String_concat__ s c)

(define Cat4 ,(a b c d)
  Cat3 a b c ,(s)
  __String_concat__ s d)

(define Cat5 ,(a b c d e)
  Cat4 a b c d ,(s)
  __String_concat__ s e)

;; ── 名前 ──

;; 名前 name の ConMa の変数名と、const か。宣言されていなければ null と偽
(define Gen_lookup ,(scope name)
  __Cont_get__ ,(return)
  __is_null__ scope ,(test__) __if__ test__ (,() return __NULL__ __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_lookup_or__ dict name (,(key) Gen_lookup rest key ,(v c) return v c) ,(v)
  __String_concat__ "const:" name ,(ck)
  __Dict_lookup_or__ dict ck (,(key) __NULL__ __FALSE__) ,(c)
  __NULL__ v c)

;; 今のスコープに name を宣言する。ConMa の変数名を返す
(define Gen_declare ,(g scope name isConst)
  Str_has_dollar name ,(test__) __if__ test__ (,() Gen_not_yet "a name that begins with $ (a shell variable)") ,()
  __String_concat__ "v" "" ,(prefix)
  Gen_temp g "v" ,(t)
  Cat3 t "_" name ,(var)
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  __Dict_put__ dict name var ,()
  __String_concat__ "const:" name ,(ck)
  __if__ isConst (,() __Dict_put__ dict ck __TRUE__) ,()
  __NULL__ var)

(define Str_has_dollar ,(name)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ name "$" zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

;; ── 文 ──

;; 文の LList の手順の並びを acc に足したもの
(define Gen_stmts ,(g scope list inFn acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  Gen_stmt g scope s inFn ,(code)
  __String_concat__ acc code ,(acc)
  Gen_stmts g scope rest inFn acc)

(define Gen_stmt ,(g scope s inFn)
  __Cont_get__ ,(return)
  Sjs_get s "t" ,(t)
  __String_equal__ t "expr" ,(test__) __if__ test__
    (,() Sjs_get s "expr" ,(e) Gen_expr g scope e ,(code val) return code) ,()
  __String_equal__ t "empty" ,(test__) __if__ test__ (,() return "") ,()
  __String_equal__ t "block" ,(test__) __if__ test__
    (,()
      __Dict_new__ ,(dict)
      __LList_cons__ dict scope ,(inner)
      Sjs_get s "body" ,(body)
      Gen_block_code g inner body inFn ,(code)
      return code) ,()
  __String_equal__ t "decl" ,(test__) __if__ test__
    (,()
      Sjs_get s "kind" ,(kind)
      __String_equal__ kind "const" ,(isConst)
      Sjs_get s "decls" ,(decls)
      Gen_decls g scope decls isConst "" ,(code)
      return code) ,()
  __String_equal__ t "if" ,(test__) __if__ test__ (,() Gen_if g scope s inFn ,(code) return code) ,()
  __String_equal__ t "while" ,(test__) __if__ test__ (,() Gen_while g scope s inFn ,(code) return code) ,()
  __String_equal__ t "return" ,(test__) __if__ test__
    (,()
      __unless__ inFn (,() Gen_error "return outside a function") ,()
      Sjs_get s "value" ,(value)
      __is_null__ value ,(none)
      __if__ none (,() return "return __NULL__ ,() ") ,()
      Gen_expr g scope value ,(code val)
      Cat4 code "return " val " ,() " ,(c)
      return c) ,()
  __String_concat__ "a statement of " t ,(what)
  Gen_not_yet what)

(define Gen_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "name" ,(name)
  Sjs_get d "init" ,(init)
  __is_null__ init ,(none)
  __if_then_else__ none (,() __NULL__ "" "__NULL__") (,() Gen_expr g scope init) ,(code val)
  Gen_lookup scope name ,(var c)
  Cat5 acc code "__Ref_set__ " var " " ,(acc)
  Cat3 acc val " ,() " ,(acc)
  Gen_decls g scope rest isConst acc)

(define Gen_if ,(g scope s inFn)
  __Cont_get__ ,(return)
  Sjs_get s "test" ,(test)
  Sjs_get s "yes" ,(yes)
  Sjs_get s "no" ,(no)
  Gen_expr g scope test ,(code val)
  Gen_temp g "b" ,(b)
  Gen_branch g scope yes inFn ,(yesCode)
  Cat5 code "Sjs_truthy " val " ,(" b ,(c)
  __is_null__ no ,(noElse)
  __if__ noElse
    (,() Cat5 c ") __if__ " b " (,() " yesCode ,(c) __String_concat__ c "__nop__) ,() " ,(c) return c) ,()
  Gen_branch g scope no inFn ,(noCode)
  Cat5 c ") __if_then_else__ " b " (,() " yesCode ,(c)
  Cat3 c "__nop__) (,() " noCode ,(c)
  __String_concat__ c "__nop__) ,() ")

;; if の枝の文（ブロックでなくても、自分のスコープを持つ）
(define Gen_branch ,(g scope s inFn)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(inner)
  __LList_cons__ s __NULL__ ,(stmts)
  Gen_block_code g inner stmts inFn)

(define Gen_while ,(g scope s inFn)
  Sjs_get s "test" ,(test)
  Sjs_get s "body" ,(body)
  Gen_temp g "loop" ,(loop)
  Gen_temp g "b" ,(b)
  Gen_temp g "l" ,(l)
  Gen_expr g scope test ,(testCode val)
  Gen_branch g scope body inFn ,(bodyCode)
  Cat3 "__Ref_new__ __NULL__ ,(" loop ") __Ref_set__ " ,(c)
  Cat4 c loop " (,() " testCode ,(c)
  Cat5 c "Sjs_truthy " val " ,(" b ,(c)
  Cat5 c ") __if__ " b " (,() " bodyCode ,(c)
  Cat5 c "__Ref_get__ " loop " ,(" l ,(c)
  Cat3 c ") " l ,(c)
  Cat5 c ")) ,() __Ref_get__ " loop " ,(" l ,(c)
  Cat4 c ") " l " ,() ")

;; ブロックの文の並び stmts（scope の最初の Dict が、このブロックのスコープ）。JavaScript と同じく、ブロックで
;; 宣言した名前（let、const、var）は、ブロックの始めから見えるように、先に Ref を作っておく（宣言の文は、その Ref に
;; 値を入れる）。自分を呼ぶ関数（const fact = (n) => ... fact(n - 1)）や、後で宣言する名前を使う関数のため
(define Gen_block_code ,(g scope stmts inFn)
  Gen_hoist g scope stmts "" ,(code)
  Gen_stmts g scope stmts inFn code)

(define Gen_hoist ,(g scope stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Sjs_get s "t" ,(t)
  __String_equal__ t "decl" ,(isDecl)
  __unless__ isDecl (,() Gen_hoist g scope rest acc ,(c) return c) ,()
  Sjs_get s "kind" ,(kind)
  __String_equal__ kind "const" ,(isConst)
  Sjs_get s "decls" ,(decls)
  Gen_hoist_decls g scope decls isConst acc ,(acc)
  Gen_hoist g scope rest acc)

(define Gen_hoist_decls ,(g scope decls isConst acc)
  __Cont_get__ ,(return)
  __is_null__ decls ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ decls ,(d rest)
  Sjs_get d "name" ,(name)
  Gen_declare g scope name isConst ,(var)
  Cat3 acc "__Ref_new__ __NULL__ ,(" var ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_hoist_decls g scope rest isConst acc)

;; ── 式 ──

;; 式 e の手順の並びと、値の被演算子
(define Gen_expr ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      Gen_temp g "t" ,(v)
      Gen_quote text ,(q)
      Cat5 "__Number_fromString__ (,(msg) Sjs_throw \"SyntaxError\" \"a bad number\") " q " ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "str" ,(test__) __if__ test__
    (,() Sjs_get e "value" ,(value) Gen_quote value ,(q) return "" q) ,()
  __String_equal__ t "lit" ,(test__) __if__ test__
    (,()
      Sjs_get e "text" ,(text)
      __String_equal__ text "true" ,(test__) __if__ test__ (,() return "" "__TRUE__") ,()
      __String_equal__ text "false" ,(test__) __if__ test__ (,() return "" "__FALSE__") ,()
      Gen_temp g "t" ,(v)
      Cat3 "__Ref_new__ __NULL__ ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "id" ,(test__) __if__ test__ (,() Sjs_get e "name" ,(name) Gen_read g scope name ,(c v) return c v) ,()
  __String_equal__ t "paren" ,(test__) __if__ test__ (,() Sjs_get e "expr" ,(inner) Gen_expr g scope inner ,(c v) return c v) ,()
  __String_equal__ t "unary" ,(test__) __if__ test__ (,() Gen_unary g scope e ,(c v) return c v) ,()
  __String_equal__ t "binary" ,(test__) __if__ test__ (,() Gen_binary g scope e ,(c v) return c v) ,()
  __String_equal__ t "cond" ,(test__) __if__ test__ (,() Gen_cond g scope e ,(c v) return c v) ,()
  __String_equal__ t "assign" ,(test__) __if__ test__ (,() Gen_assign g scope e ,(c v) return c v) ,()
  __String_equal__ t "update" ,(test__) __if__ test__ (,() Gen_update g scope e ,(c v) return c v) ,()
  __String_equal__ t "call" ,(test__) __if__ test__ (,() Gen_call g scope e ,(c v) return c v) ,()
  __String_equal__ t "arrow" ,(isArrow)
  __String_equal__ t "function" ,(isFunction)
  __or__ isArrow isFunction ,(test__) __if__ test__ (,() Gen_function g scope e ,(c v) return c v) ,()
  __String_equal__ t "member" ,(test__) __if__ test__ (,() Gen_not_yet "a property") ,()
  __String_concat__ "an expression of " t ,(what)
  Gen_not_yet what)

;; 名前を読む
(define Gen_read ,(g scope name)
  __Cont_get__ ,(return)
  Str_has_dollar name ,(test__) __if__ test__ (,() Gen_not_yet "a name that begins with $ (a shell variable)") ,()
  Gen_lookup scope name ,(var isConst)
  Gen_temp g "t" ,(v)
  __is_null__ var ,(global)
  __unless__ global (,() Cat5 "__Ref_get__ " var " ,(" v ") " ,(c) return c v) ,()
  __String_equal__ name "undefined" ,(test__) __if__ test__ (,() return "" "__NULL__") ,()
  Gen_quote name ,(q)
  Cat5 "Sjs_global G " q " ,(" v ") " ,(c)
  __NULL__ c v)

;; 名前に値 val を入れる手順
(define Gen_write ,(g scope name val)
  __Cont_get__ ,(return)
  Gen_lookup scope name ,(var isConst)
  __if__ isConst (,() Gen_error "Assignment to constant variable.") ,()
  __is_null__ var ,(global)
  __unless__ global (,() Cat5 "__Ref_set__ " var " " val " ,() " ,(c) return c) ,()
  Gen_quote name ,(q)
  Cat5 "__Dict_put__ G " q " " val " ,() ")

;; 式の値を名前のない変数に入れる手順（val が変数でないときも、一時変数にする）
(define Gen_unary ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "arg" ,(arg)
  Gen_expr g scope arg ,(code val)
  Gen_temp g "t" ,(v)
  __String_equal__ op "!" ,(test__) __if__ test__
    (,()
      Gen_temp g "b" ,(b)
      Cat5 code "Sjs_truthy " val " ,(" b ,(c)
      Cat5 c ") __not__ " b " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  __String_equal__ op "-" ,(isNeg)
  __String_equal__ op "+" ,(isPos)
  __String_equal__ op "typeof" ,(isTypeof)
  __if_then_else__ isNeg (,() __NULL__ "Sjs_neg ") (,()
  __if_then_else__ isPos (,() __NULL__ "Sjs_pos ") (,()
  __if_then_else__ isTypeof (,() __NULL__ "Sjs_typeof ") (,()
    __String_concat__ "the operator " op ,(what) Gen_not_yet what))) ,(f)
  Cat5 code f val " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; 二項演算子の実行時の関数（なければ null）
(define Gen_binary_fn ,(op)
  __Cont_get__ ,(return)
  __NULL__ (,(o f) __String_equal__ op o ,(t) __if__ t (,() return f)) ,(map)
  map "+" "Sjs_add" ,()
  map "-" "Sjs_sub" ,()
  map "*" "Sjs_mul" ,()
  map "/" "Sjs_div" ,()
  map "%" "Sjs_mod" ,()
  map "<" "Sjs_lt" ,()
  map "<=" "Sjs_le" ,()
  map ">" "Sjs_gt" ,()
  map ">=" "Sjs_ge" ,()
  map "===" "Sjs_seq" ,()
  __NULL__ __NULL__)

(define Gen_binary ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "left" ,(left)
  Sjs_get e "right" ,(right)
  __String_equal__ op "&&" ,(isAnd)
  __String_equal__ op "||" ,(isOr)
  __String_equal__ op "??" ,(isNullish)
  __or__ isAnd isOr ,(logical)
  __or__ logical isNullish ,(test__) __if__ test__ (,() Gen_logical g scope op left right ,(c v) return c v) ,()
  Gen_expr g scope left ,(lc lv)
  Gen_expr g scope right ,(rc rv)
  __String_concat__ lc rc ,(code)
  Gen_temp g "t" ,(v)
  __String_equal__ op "!==" ,(test__) __if__ test__
    (,()
      Gen_temp g "b" ,(b)
      Cat5 code "Sjs_seq " lv " " rv ,(c)
      Cat5 c " ,(" b ") __not__ " b ,(c)
      Cat3 c " ,(" v ,(c)
      __String_concat__ c ") " ,(c)
      return c v) ,()
  Gen_binary_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Cat5 code f " " lv " " ,(c)
  Cat4 c rv " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; a && b、a || b、a ?? b：b は、必要なときだけ求める
(define Gen_logical ,(g scope op left right)
  Gen_expr g scope left ,(lc lv)
  Gen_expr g scope right ,(rc rv)
  Gen_temp g "b" ,(b)
  Gen_temp g "t" ,(v)
  __String_equal__ op "??" ,(isNullish)
  __String_equal__ op "&&" ,(isAnd)
  __if_then_else__ isNullish (,() __NULL__ "Sjs_is_nullish ") (,() __NULL__ "Sjs_truthy ") ,(f)
  Cat5 rc "__NULL__ " rv "" "" ,(evalRight)
  __String_concat__ "__NULL__ " lv ,(keepLeft)
  ;; && は真なら右、|| は偽なら右、?? は null か undefined なら右
  __or__ isAnd isNullish ,(rightWhenTrue)
  __if_then_else__ rightWhenTrue (,() __NULL__ evalRight keepLeft) (,() __NULL__ keepLeft evalRight) ,(yes no)
  Cat5 lc f lv " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() " yes ,(c)
  Cat3 c ") (,() " no ,(c)
  Cat3 c ") ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

(define Gen_cond ,(g scope e)
  Sjs_get e "test" ,(test)
  Sjs_get e "yes" ,(yes)
  Sjs_get e "no" ,(no)
  Gen_expr g scope test ,(tc tv)
  Gen_expr g scope yes ,(yc yv)
  Gen_expr g scope no ,(nc nv)
  Gen_temp g "b" ,(b)
  Gen_temp g "t" ,(v)
  Cat5 tc "Sjs_truthy " tv " ,(" b ,(c)
  Cat5 c ") __if_then_else__ " b " (,() " yc ,(c)
  Cat4 c "__NULL__ " yv ") (,() " ,(c)
  Cat4 c nc "__NULL__ " nv ,(c)
  Cat3 c ") ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; 複合の代入の演算子の関数（なければ null）
(define Gen_assign_fn ,(op)
  __Cont_get__ ,(return)
  __NULL__ (,(o f) __String_equal__ op o ,(t) __if__ t (,() return f)) ,(map)
  map "+=" "Sjs_add" ,()
  map "-=" "Sjs_sub" ,()
  map "*=" "Sjs_mul" ,()
  map "/=" "Sjs_div" ,()
  map "%=" "Sjs_mod" ,()
  __NULL__ __NULL__)

(define Gen_assign ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "op" ,(op)
  Sjs_get e "target" ,(target)
  Sjs_get e "value" ,(value)
  Sjs_get target "name" ,(name)
  Gen_expr g scope value ,(vc vv)
  __String_equal__ op "=" ,(test__) __if__ test__
    (,()
      Gen_write g scope name vv ,(wc)
      __String_concat__ vc wc ,(c)
      return c vv) ,()
  Gen_assign_fn op ,(f)
  __is_null__ f ,(test__) __if__ test__ (,() __String_concat__ "the operator " op ,(what) Gen_not_yet what) ,()
  Gen_read g scope name ,(rc rv)
  Gen_temp g "t" ,(v)
  Cat4 rc vc f " " ,(c)
  Cat5 c rv " " vv " ,(" ,(c)
  Cat3 c v ") " ,(c)
  Gen_write g scope name v ,(wc)
  __String_concat__ c wc ,(c)
  __NULL__ c v)

;; ++x、x++、--x、x--
(define Gen_update ,(g scope e)
  Sjs_get e "op" ,(op)
  Sjs_get e "prefix" ,(prefix)
  Sjs_get e "target" ,(target)
  Sjs_get target "name" ,(name)
  Gen_read g scope name ,(rc rv)
  Gen_temp g "d" ,(d)
  Gen_temp g "t" ,(v)
  __String_equal__ op "++" ,(inc)
  __if_then_else__ inc (,() __NULL__ "\"1\"") (,() __NULL__ "\"-1\"") ,(dText)
  Cat5 rc "__Number_fromString__ __print_exit_error__ " dText " ,(" d ,(c)
  Cat5 c ") Sjs_step " rv " " d ,(c)
  Cat3 c " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  Gen_write g scope name v ,(wc)
  __String_concat__ c wc ,(c)
  __if_then_else__ prefix (,() __NULL__ v) (,() __NULL__ rv) ,(result)
  __NULL__ c result)

;; 引数の式の LList を求めて、値の LList を作る手順と、その変数
(define Gen_args ,(g scope args)
  Gen_arg_values g scope args "" __NULL__ ,(code vals)
  ;; vals は逆順（最後の引数が先）なので、そのまま後ろから cons する
  Gen_cons_list g vals code "__NULL__")

(define Gen_arg_values ,(g scope args code vals)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return code vals) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  Gen_expr g scope a ,(c v)
  __String_concat__ code c ,(code)
  __LList_cons__ v vals ,(vals)
  Gen_arg_values g scope rest code vals)

(define Gen_cons_list ,(g vals code list)
  __Cont_get__ ,(return)
  __is_null__ vals ,(test__) __if__ test__ (,() return code list) ,()
  __LList_uncons__ __print_exit_error__ vals ,(v rest)
  Gen_temp g "l" ,(l)
  Cat5 code "__LList_cons__ " v " " list ,(code)
  Cat4 code " ,(" l ") " ,(code)
  Gen_cons_list g rest code l)

(define Gen_call ,(g scope e)
  __Cont_get__ ,(return)
  Sjs_get e "callee" ,(callee)
  Sjs_get e "args" ,(args)
  Sjs_get callee "t" ,(ct)
  __String_equal__ ct "member" ,(isMember)
  __if__ isMember
    (,()
      Sjs_get callee "object" ,(object)
      Sjs_get callee "name" ,(method)
      Sjs_get object "t" ,(ot)
      __String_equal__ ot "id" ,(objId)
      __if_then_else__ objId (,() Sjs_get object "name") (,() __NULL__ "") ,(oname)
      __String_equal__ oname "console" ,(isConsole)
      Gen_lookup scope "console" ,(local isConst)
      __is_null__ local ,(notLocal)
      __and__ isConsole notLocal ,(console)
      __String_equal__ method "log" ,(isLog)
      __and__ console isLog ,(test__) __unless__ test__ (,() Gen_not_yet "a method call") ,()
      Gen_args g scope args ,(code list)
      Cat4 code "Sjs_log " list " ,() " ,(c)
      return c "__NULL__") ,()
  Gen_expr g scope callee ,(fc fv)
  Gen_args g scope args ,(ac list)
  Gen_temp g "t" ,(v)
  Cat5 fc ac "Sjs_call " fv " " ,(c)
  Cat4 c list " ,(" v ,(c)
  __String_concat__ c ") " ,(c)
  __NULL__ c v)

;; アロー関数と function 式：Sjs_function G (,(args) __Cont_get__ ,(return) 引数を束縛する 本体 return __NULL__)
(define Gen_function ,(g scope e)
  Sjs_get e "params" ,(params)
  Sjs_get e "body" ,(body)
  Sjs_get e "expr" ,(expr)
  __Dict_new__ ,(dict)
  __LList_cons__ dict scope ,(inner)
  Gen_temp g "args" ,(args)
  Gen_params g inner params args "" ,(bind)
  __is_null__ body ,(concise)
  __if_then_else__ concise
    (,() Gen_expr g inner expr ,(c v) Cat4 c "return " v " ,() ")
    (,() Sjs_get body "body" ,(stmts) Gen_block_code g inner stmts __TRUE__) ,(bodyCode)
  Gen_temp g "t" ,(v)
  Cat3 "Sjs_function G (,(" args ") __Cont_get__ ,(return) " ,(c)
  Cat4 c bind bodyCode "return __NULL__) ,(" ,(c)
  Cat3 c v ") " ,(c)
  __NULL__ c v)

;; 引数の名前を、引数の LList args から順に取り出して、Ref に入れる手順
(define Gen_params ,(g scope params args acc)
  __Cont_get__ ,(return)
  __is_null__ params ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ params ,(name rest)
  Gen_temp g "a" ,(a)
  Gen_temp g "r" ,(r)
  Gen_declare g scope name __FALSE__ ,(var)
  Cat5 acc "Sjs_arg " args " ,(" a ,(acc)
  Cat5 acc " " r ") __Ref_new__ " a ,(acc)
  Cat3 acc " ,(" var ,(acc)
  __String_concat__ acc ") " ,(acc)
  Gen_params g scope rest r acc)
