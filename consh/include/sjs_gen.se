  __String_equal__ t "arrayPattern" ,(test__) __if__ test__ (,() Sjs_get pat "items" ,(items) Gen_pattern_names_list items acc ,(acc) return acc) ,()
  __String_equal__ t "objectPattern" ,(test__) __if__ test__ (,() Sjs_get pat "props" ,(props) Gen_pattern_names_props props acc ,(acc) return acc) ,()
  __NULL__ acc)

(define Gen_pattern_names_list ,(items acc)
