;; 値 v（被演算子）を形 pat に入れる手順。init が真なら宣言（const にも入れる）、偽なら代入（名前かメンバー）
(define Gen_pattern ,(g scope pat v init)
  __Cont_get__ ,(return)
  Sjs_get pat "t" ,(t)
  __String_equal__ t "id" ,(test__) __if__ test__
    (,()
      Sjs_get pat "name" ,(name)
      __unless__ init (,() Gen_write g scope name v ,(c) return c) ,()
      Gen_lookup scope name ,(var c)
      Cat5 "__Ref_set__ " var " " v " ,() " ,(code)
      return code) ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      Sjs_get pat "object" ,(object)
      Gen_expr g scope object ,(oc ov)
      Gen_key g scope pat ,(kc kv)
      Cat5 oc kc "Sjs_set_member G " ov " " ,(c)
      Cat4 c kv " " v ,(c)
      __String_concat__ c " ,() " ,(c)
      return c) ,()
  __String_equal__ t "default" ,(test__) __if__ test__
    (,()
      ;; undefined なら既定値（名前を付けて求める）
      Sjs_get pat "target" ,(target)
      Sjs_get pat "value" ,(dflt)
      Sjs_get target "t" ,(tt)
      __String_equal__ tt "id" ,(isId)
      __if_then_else__ isId (,() Sjs_get target "name") (,() __NULL__ "") ,(name)
      Gen_named g scope dflt name ,(dc dv)
      Gen_temp g "b" ,(b)
      Gen_temp g "t" ,(x)
      Cat5 "Sjs_is_undefined " v " ,(" b ") __if_then_else__ " ,(c)
      Cat5 c b " (,() " dc "__NULL__ " ,(c)
      Cat5 c dv ") (,() __NULL__ " v ") ,(" ,(c)
      Cat3 c x ") " ,(c)
      Gen_pattern g scope target x init ,(inner)
      __String_concat__ c inner ,(c)
      return c) ,()
  __String_equal__ t "arrayPattern" ,(test__) __if__ test__
    (,()
      ;; 繰り返しの手順で、要る数だけ読み、残りの要素（...）がなければ閉じる（ジェネレータの return()）。
      ;; 値が配列なら、Sjs_pattern_open はその配列を返し、要素は添字で読む（SJS の配列は繰り返しを変えられないので、
      ;; JavaScript の配列の繰り返しと同じく、その時の配列の i 番目になる）
      Sjs_get pat "items" ,(items)
      Gen_temp g "it" ,(it)
      Cat5 "Sjs_pattern_open " v " ,(" it ") " ,(c)
      __Number_fromString__ __print_exit_error__ "0" ,(zero)
      Gen_pattern_items g scope items it init c zero ,(c)
      return c) ,()
  __String_equal__ t "objectPattern" ,(test__) __if__ test__
    (,()
      Sjs_get pat "props" ,(props)
      Gen_pattern_props g scope props v init "" "__NULL__" ,(c)
      return c) ,()
  Gen_error "cannot assign to this expression")

