  map "-" "Sjs_sub" ,()
  map "*" "Sjs_mul" ,()
  map "/" "Sjs_div" ,()
  map "%" "Sjs_mod" ,()
  map "<" "Sjs_lt" ,()
  map "<=" "Sjs_le" ,()
  map ">" "Sjs_gt" ,()
  map ">=" "Sjs_ge" ,()
  map "===" "Sjs_seq" ,()
  map "**" "Sjs_pow" ,()
