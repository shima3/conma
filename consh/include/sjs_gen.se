;; for (x of e) と for (x in e)：値（of）か名前（in）の LList を Ref に入れ、回ごとに先頭を取り出す
(define Gen_forof ,(g scope s cx)
  __Cont_get__ ,(return)
  ;; for...of：繰り返しの手順を開いてから、ループを try { } finally { 閉じる } の中で動かす（break、return、例外で
  ;; 抜けると、ジェネレータの return() を呼ぶ）。中のループは、開いた手順（"iterVar"）を使う
  Sjs_get s "of" ,(ofWord)
  __String_equal__ ofWord "of" ,(isOfLoop)
  ;; for await：Sjs_aiter_open、Sjs_aiter_more（次の値を await する）、Sjs_aiter_close（return() を await する）
  __Dict_lookup_or__ s "await" (,(k) __NULL__ __FALSE__) ,(isAwait)
  __Dict_lookup_or__ s "iterVar" (,(k) __NULL__ __NULL__) ,(given)
  __is_null__ given ,(fresh)
  __and__ isOfLoop fresh ,(test__) __if__ test__
    (,()
      Sjs_get s "right" ,(right)
      Gen_expr g scope right ,(rc rv)
      Gen_temp g "it" ,(it)
      __Dict_copy__ s ,(loop)
      __Dict_put__ loop "iterVar" it ,()
      __LList_cons__ loop __NULL__ ,(bodyStmts)
      Sjs_node "block" ,(block)
      __Dict_put__ block "body" bodyStmts ,()
      Sjs_node "iterclose" ,(close)
      __Dict_put__ close "it" it ,()
      __Dict_put__ close "await" isAwait ,()
      __LList_cons__ close __NULL__ ,(finStmts)
      Sjs_node "block" ,(fin)
      __Dict_put__ fin "body" finStmts ,()
      Sjs_node "try" ,(t)
      __Dict_put__ t "body" block ,()
      __Dict_put__ t "param" __NULL__ ,()
      __Dict_put__ t "handler" __NULL__ ,()
      __Dict_put__ t "finalizer" fin ,()
      Gen_try g scope t cx ,(tc)
      __if_then_else__ isAwait (,() __NULL__ "Sjs_aiter_open G ") (,() __NULL__ "Sjs_iter_open ") ,(open)
      Cat5 rc open rv " ,(" it ,(c)
      Cat3 c ") " tc ,(c)
      return c) ,()
  Sjs_get s "kind" ,(kind)
  Sjs_get s "target" ,(target)
  Sjs_get s "of" ,(of)
  Sjs_get s "right" ,(right)
  Sjs_get s "body" ,(body)
  __if_then_else__ fresh (,() Gen_expr g scope right) (,() __NULL__ "" "") ,(rc rv)
  __if_then_else__ fresh (,() Gen_temp g "list") (,() __NULL__ given) ,(list)
  Gen_temp g "lst" ,(lst)
  Gen_temp g "e" ,(e)
  Gen_temp g "x" ,(x)
  Gen_temp g "rest" ,(rest)
  __String_equal__ of "of" ,(isOf)
