;; ConSh の入口。bin/consh が、consh_parse --pos で作った構文木のファイルを渡して起動する。
;;   main の引数: モード 構文木のファイル スクリプト名 スクリプトの引数...
;;   モード run  : スクリプトを実行する
;;   モード dump : 構文木を読み、S 式に書き戻して標準出力に出す（読み込みの確認用）
;;   モード run-src、dump-src : 構文木のファイルの代わりにスクリプトのファイルを受け取り、consh_parser.se で解析する
;;   モード dump-sexp : dump と同じだが、構文木の S 式を __Sexp_read__ でなく ConMa の Sexp_read で読む
;;   モード interactive : 対話モード（consh_repl.se）。構文木のファイルとスクリプト名の引数は使わない
(include "util.se")
(include "consh_ast.se")
(include "consh_parser.se")
(include "consh_glob.se")
(include "consh_eval.se")
(include "consh_repl.se")

(define main ,(args)
  __Seq_get__ (,() main_usage) args ,(mode args)
  __Seq_get__ (,() main_usage) args ,(astFile args)
  __Seq_get__ (,() main_usage) args ,(script args)
  __String_equal__ mode "interactive" ,(condition)
  __if__ condition (,() List_fromSeq args ,(args) Repl_run args) ,()
  __String_equal__ mode "run-src" ,(runSrc)
  __String_equal__ mode "dump-src" ,(dumpSrc)
  __or__ runSrc dumpSrc ,(fromSrc)
  __String_equal__ mode "dump-sexp" ,(dumpSexp)
  __if_then_else__ fromSrc
    (,()
      ;; JavaScript のある版では、JS の文を使う（consh/js/PLAN-ja.md の 2.5）。dump-src は使わない
      __if_then_else__ runSrc (,() Js_probe) (,() __NULL__ __FALSE__) ,(js)
      Js_parse_opts js __NULL__ ,(opts)
      Parse_file_with astFile script opts)
    (,()
      __if_then_else__ dumpSexp
        (,() Ast_readFile_with main_error astFile Sexp_read)
        (,() Ast_readFile main_error astFile)) ,(lines)
  __String_equal__ mode "dump" ,(dump)
  __or__ dump dumpSrc ,(dump)
  __or__ dump dumpSexp ,(dump)
  __if_then_else__ dump
    (,() main_dump lines)
    (,()
      List_fromSeq args ,(args)
      Eval_run script args lines))

(define main_usage ,()
  main_error "usage: consh_main.se run|dump|dump-sexp|run-src|dump-src|interactive <file> <script> [<arg> ...]")

(define main_error ,(msg)
  __String_concat__ "consh: " msg ,(msg)
  __String_concat__ msg "\n" ,(msg)
  __print_exit_error__ msg)

;; 構文木のコマンド行を1行ずつ S 式にして出力する
(define main_dump ,(lines)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ lines) return ,()
  __LList_uncons__ __print_exit_error__ lines ,(line rest)
  Sexp_write line ,(s)
  stdout s "\n" ,(out)
  main_dump rest)
