;; ConSh の実行（段階 3〜10）。
;;   変数定義、export、外部コマンドの起動、ファイルへのリダイレクト、$?
;;   関数の定義と呼び出し、return、組み込みコマンド echo、cd、defined、builtin、command、if 文、
;;   for 文、break、continue
;;   関数と組み込みコマンドには、引数を値（String か LazyList）のまま渡す
;;   コマンド置換 $( ) とパイプライン。どちらも別の VProc で動かし、出力はチャネル（consh_chan.se）で受け取る
;;   変数リストへのリダイレクト（> (a b . rest)、2> (…)、< (…)）と組み込みコマンド stdin（段階 6）
;;   & で別の VProc に起動するパイプライン、$!、$$、組み込みコマンド wait、kill（段階 7）
;;
;; 文を実行する文脈 sh は Dict で、次のキーを持つ。
;;   "global"     VProc ごとの Dict。"status" に最後の文の終了ステータスの String（$?）、
;;                "substs" にこの VProc で起動して、まだ終わっていない $( ) の記録の LList（Subst_settle）、
;;                "jobs" にこの VProc から & で起動したジョブの LList（Job_add）、"lastBg" に $! の String
;;   "script"     スクリプトのファイル名（$0、エラーメッセージ）
;;   "args"       スクリプトの引数の LList（$@、$1、$#）
;;   "vars"       局所変数の Dict。値は String か LazyList
;;   "funcs"      このスコープで定義した関数の Dict（名前 → 関数）
;;   "parent"     レキシカルに外側の文脈（関数名を探す）。トップレベルでは null
;;   "inFunction" 関数の中か（__TRUE__ / __FALSE__）
;;   "return"     return で使う継続。関数の外では null
;;   "noReturn"   return をエラーにするときのメッセージ（コマンド置換とパイプラインの中）。関数を呼ぶと null に戻る
;;   "abort"      読み手がいなくなったチャネルに書いたとき、この VProc を終える継続を入れた Ref（Sh_start）。
;;                最初の VProc では null
;;   "cancelIn"   この VProc が終わったときに cancel する、標準入力のチャネル。なければ null
;;   "procRef"    この VProc で実行中の外部コマンドの OSProc を入れる Ref（kill で SIGTERM を送る）
;;   "bgCaptures" & の文の変数リストへのリダイレクトで、外に渡す遅延の値の LList（Bg_captures）。なければ null
;;   "loops"      実行中の for 文の LList（内側が先）。各要素は (ループ変数の名前 break の継続 continue の継続)。
;;                関数の中では、関数の外のループは見えない
;;   "env"        環境変数（Env_new）
;;   "in"         標準入力。Input_new または Input_stream の Dict（読み出し位置を共有する）
;;   "out" "err"  標準出力と標準エラー出力のターゲット（Target_*）
;;
;; 変数定義は新しい束縛と見る。関数は、定義した時点の局所変数の写しを持つので、
;; 後で変数を変えても関数からは見えない。関数名は、スコープごとの Dict を外側へたどって探すので、
;; 後で定義した関数も呼べる。
(include "consh_util.se")
(include "consh_ast.se")
(include "consh_expand.se")
(include "consh_chan.se")

;; ── 文脈 ──

(define Ctx_top ,(script args)
  __Dict_new__ ,(global)
  __Dict_put__ global "status" "0" ,()
  __Dict_put__ global "substs" __NULL__ ,()
  __Dict_put__ global "jobs" __NULL__ ,()
  __Dict_put__ global "lastBg" "" ,()
  num "0" ,(zero)
  __Dict_put__ global "sinks" zero ,()
  __OS_get_envDict__ ,(base)
  Env_new base __NULL__ ,(env)
  __OS_get_stderr__ ,(errStream)
  Target_stream global errStream ,(err)
  __Dict_new__ ,(vars)
  __Dict_new__ ,(funcs)
  __Dict_new__ ,(sh)
  __Dict_put__ sh "global" global ,()
  __Dict_put__ sh "script" script ,()
  __Dict_put__ sh "args" args ,()
  __Dict_put__ sh "vars" vars ,()
  __Dict_put__ sh "funcs" funcs ,()
  __Dict_put__ sh "parent" __NULL__ ,()
  __Dict_put__ sh "inFunction" __FALSE__ ,()
  __Dict_put__ sh "return" __NULL__ ,()
  __Dict_put__ sh "loops" __NULL__ ,()
  __Dict_put__ sh "env" env ,()
  __Dict_put__ sh "in" __NULL__ ,()
  __Dict_put__ sh "noReturn" __NULL__ ,()
  __Dict_put__ sh "abort" __NULL__ ,()
  __Dict_put__ sh "cancelIn" __NULL__ ,()
  __Dict_put__ sh "bgCaptures" __NULL__ ,()
  __Dict_put__ sh "owned" __NULL__ ,()
  __Ref_new__ __NULL__ ,(procRef)
  __Dict_put__ sh "procRef" procRef ,()
  Target_new_id global ,(outId)
  Target_make "top" outId (,(line) Top_write sh line) ,(out)
  __Dict_put__ sh "out" out ,()
  __Dict_put__ sh "err" err ,()
  __OS_get_stdin__ ,(inStream)
  Input_stream sh inStream ,(in)
  __Dict_put__ sh "in" in ,()
  __NULL__ sh)

;; トップレベルの標準出力。要素を1行として書く。LazyList の要素は、トップレベルの OFS で文字列化する。
;; パイプラインの要素の VProc からも書くので、PDict の stdout ではなく、OS の標準出力の Stream に書く。
;; 外部コマンドには、OS の標準出力の Stream をそのまま渡す（External_os_stream）
(define Top_write ,(sh line)
  Line_toString sh __NULL__ line ,(line)
  __String_concat__ line "\n" ,(s)
  __OS_get_stdout__ ,(stream)
  __OS_write__ __print_exit_error__ stream s)

(define Sh_get ,(sh key)
  __Dict_lookup_or__ sh key __print_exit_error__)

(define Sh_status ,(sh)
  Sh_get sh "global" ,(global)
  __Dict_lookup_or__ global "status" __print_exit_error__)

(define Sh_set_status ,(sh status)
  Sh_get sh "global" ,(global)
  __Dict_put__ global "status" status)

;; 「consh: スクリプト:行:桁: msg」の1行。pos が null なら「consh: スクリプト: msg」
(define Sh_message ,(sh pos msg)
  __Cont_get__ ,(return)
  Sh_get sh "script" ,(script)
  __if__ (,() __is_null__ pos)
    (,()
      __String_concat__ "consh: " script ,(s)
      __String_concat__ s ": " ,(s)
      __String_concat__ s msg ,(s)
      __String_concat__ s "\n" ,(s)
      return s) ,()
  Pos_split pos ,(line col)
  __Number_toString__ line ,(line)
  __Number_toString__ col ,(col)
  __String_concat__ "consh: " script ,(s)
  __String_concat__ s ":" ,(s)
  __String_concat__ s line ,(s)
  __String_concat__ s ":" ,(s)
  __String_concat__ s col ,(s)
  __String_concat__ s ": " ,(s)
  __String_concat__ s msg ,(s)
  __String_concat__ s "\n")

;; 仕様でエラーとするもの。メッセージを出して、終了ステータス 1 で終わる
(define Sh_error ,(sh pos msg)
  Sh_message sh pos msg ,(s)
  __print_exit_error__ s)

;; 続けられるエラー（ファイルを開けない、コマンドを起動できない）。メッセージを出して続ける
(define Sh_warn ,(sh pos msg)
  Sh_message sh pos msg ,(s)
  __OS_print_error__ s)

;; スクリプトの引数の LList。関数の中では $1、$@、$# は未定義なのでエラー
(define Sh_args ,(sh pos)
  Sh_get sh "inFunction" ,(inFunction)
  __if__ (,() __NULL__ inFunction)
    (,() Sh_error sh pos "$1, $@ and $# are not defined in a function") ,()
  Sh_get sh "args")

;; 変数参照の値。String か LazyList。局所変数がなければ環境変数を探す。
;; 未定義の変数と、足りない位置パラメータはエラーとする
(define Sh_lookup ,(sh pos name)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ name "@")
    (,()
      Sh_args sh pos ,(args)
      LazyList_fromList args ,(list)
      return list) ,()
  __if__ (,() String_is_digits name)
    (,()
      num name ,(n)
      __if__ (,() __Number_is_zero__ n) (,() Sh_get sh "script" ,(script) return script) ,()
      Sh_args sh pos ,(args)
      Sh_nth args n (,()
        __String_concat__ "missing positional parameter: $" name ,(msg)
        Sh_error sh pos msg) ,(arg)
      return arg) ,()
  __if__ (,() __String_equal__ name "#")
    (,()
      Sh_args sh pos ,(args)
      List_length args ,(n)
      __Number_toString__ n ,(s)
      return s) ,()
  __if__ (,() __String_equal__ name "?") (,() Sh_status sh ,(status) return status) ,()
  __if__ (,() __String_equal__ name "!")
    (,()
      Sh_get sh "global" ,(global)
      Sh_get global "lastBg" ,(id)
      return id) ,()
  __if__ (,() __String_equal__ name "$")
    (,()
      __OS_getpid__ ,(pid)
      __Number_toString__ pid ,(s)
      return s) ,()
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars name (,(key)
    Env_lookup env key (,(key)
      __String_concat__ "undefined variable: " key ,(msg)
      Sh_error sh pos msg)) ,(value)
  Value_force value)

;; 変数が定義済みか。位置パラメータは引数の数で決まる。特殊な変数は常に定義済み
(define Sh_defined ,(sh pos name)
  __Cont_get__ ,(return)
  __if__ (,() String_is_digits name)
    (,()
      num name ,(n)
      __if__ (,() __Number_is_zero__ n) (,() return __TRUE__) ,()
      Sh_args sh pos ,(args)
      List_length args ,(len)
      __Number_subtract__ len n ,(room)
      __if__ (,() __Number_is_negative__ room) (,() return __FALSE__) ,()
      return __TRUE__) ,()
  __String_equal__ name "@" ,(s1)
  __String_equal__ name "#" ,(s2)
  __String_equal__ name "?" ,(s3)
  __String_equal__ name "!" ,(s4)
  __String_equal__ name "$" ,(s5)
  __or__ s1 s2 ,(s)
  __or__ s s3 ,(s)
  __or__ s s4 ,(s)
  __or__ s s5 ,(s)
  __if__ (,() __NULL__ s) (,() return __TRUE__) ,()
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars name (,(key)
    Env_lookup env key (,(key) return __FALSE__)) ,(value)
  __NULL__ __TRUE__)

;; LList の n 番目（1 から）。足りなければ onMissing を呼ぶ
(define Sh_nth ,(list n onMissing)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) onMissing ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  __if__ (,() __Number_is_zero__ n) (,() return head) ,()
  Sh_nth tail n onMissing)

;; 文字列化の区切り。局所変数、環境変数の順に OFS を探し、どちらにもなければスペース
(define Sh_ofs ,(sh pos)
  __Cont_get__ ,(return)
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars "OFS" (,(key)
    Env_lookup env key (,(key) return " ")) ,(ofs)
  Value_force ofs ,(ofs)
  __type_name__ ofs ,(type)
  __unless__ (,() __String_equal__ type "String") (,() Sh_error sh pos "OFS is a LazyList") ,()
  __NULL__ ofs)

;; ── 環境変数 ──
;; シェル全体の環境変数 base と、前置の変数定義の層 layers（内側が先の、Dict の LList）。
;; 参照は内側の層から順に探し、なければ base を探す

(define Env_new ,(base layers)
  __Dict_new__ ,(env)
  __Dict_put__ env "base" base ,()
  __Dict_put__ env "layers" layers ,()
  __NULL__ env)

;; layer を一番内側に加えた環境変数
(define Env_push ,(env layer)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  __LList_cons__ layer layers ,(layers)
  Env_new base layers)

(define Env_lookup ,(env name onMissing)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  Env_lookup_layers layers name (,(key) __Dict_lookup_or__ base key onMissing))

(define Env_lookup_layers ,(layers name onMissing)
  __if_then_else__ (,() __is_null__ layers)
    (,() onMissing name)
    (,()
      __LList_uncons__ __print_exit_error__ layers ,(layer rest)
      __Dict_lookup_or__ layer name (,(key) Env_lookup_layers rest key onMissing)))

;; export。シェル全体の環境変数と、name を持つすべての層の値を変える
(define Env_export ,(env name value)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  __Dict_put__ base name value ,()
  Env_export_layers layers name value)

(define Env_export_layers ,(layers name value)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) return ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  __Dict_lookup_or__ layer name (,(key) __NULL__ __NULL__) ,(found)
  __unless__ (,() __is_null__ found) (,() __Dict_put__ layer name value) ,()
  Env_export_layers rest name value)

;; 環境変数の写し。export しても元の環境変数は変わらない
(define Env_copy ,(env)
  Sh_get env "base" ,(base)
  Dict_copy base ,(base)
  Sh_get env "layers" ,(layers)
  Env_copy_layers layers ,(layers)
  Env_new base layers)

(define Env_copy_layers ,(layers)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  Dict_copy layer ,(layer)
  Env_copy_layers rest ,(rest)
  __LList_cons__ layer rest)

;; 外部コマンドに渡す Dict。base に、外側の層から順に重ねる
(define Env_dict ,(env)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  Dict_copy base ,(dict)
  List_reverse layers ,(layers)
  Env_dict_layers dict layers ,()
  __NULL__ dict)

(define Env_dict_layers ,(dict layers)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) return ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  Dict_copy_into layer dict ,()
  Env_dict_layers dict rest)

;; ── 出力のターゲット ──
;; 標準出力と標準エラー出力の行き先は、次のどれか。
;;   (stream id Stream)  バイト列をそのまま書く Stream。要素は、末尾に改行を付けて書く
;;   (sink id write)     要素を1つずつ受け取る関数 write（,(line) ...）。どの VProc から呼んでもよい
;;   (top id write)      トップレベルの標準出力（Ctx_top）。要素は sink と同じく write で書くが、
;;                       外部コマンドには OS の標準出力の Stream をそのまま渡す（端末なら端末のまま）
;;   (file id dict)      関数、if 文、for 文に渡したファイルの Stream（Target_for_body）。dict は "stream" と "write" を持つ。
;;                       要素は write で、リダイレクトを書いた文の OFS で書き、外部コマンドには Stream をそのまま渡す
;;   (chan id writer)    チャネルの書き手（consh_chan.se）。それを作った VProc だけが使う。
;;                       別の VProc に渡すときは、同じチャネルの新しい書き手を作る（Child_target）
;;   (capture id record) 変数リストへのリダイレクト（Capture_new）。要素を受け取った順に変数に割り当てる。どの VProc から書いてもよい
;; id はターゲットを見分ける String で、2>&1 や 1>&2 で写したターゲットは同じ id を持つ。
;; 外部コマンドの出力が sink、chan、capture に行くときは、パイプで受け取って行ごとの要素にする（行の改行は除く）

(define Target_stream ,(global stream)
  Target_new_id global ,(id)
  Target_make "stream" id stream)

(define Target_sink ,(global write)
  Target_new_id global ,(id)
  Target_make "sink" id write)

(define Target_make ,(kind id value)
  __LList_cons__ value __NULL__ ,(rest)
  __LList_cons__ id rest ,(rest)
  __LList_cons__ kind rest)

(define Target_new_id ,(global)
  __Dict_lookup_or__ global "sinks" __print_exit_error__ ,(n)
  num "1" ,(one)
  __Number_add__ n one ,(n)
  __Dict_put__ global "sinks" n ,()
  __Number_toString__ n)

;; ターゲットの種類、id、値（Stream か write）
(define Target_split ,(target)
  __LList_uncons__ __print_exit_error__ target ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(id rest)
  __LList_uncons__ __print_exit_error__ rest ,(value rest)
  __NULL__ kind id value)

;; 関数、if 文、for 文の本体に渡すターゲット。stream を、同じ id の file ターゲットにする（ほかはそのまま）。
;; 本体の中の要素は、末尾に改行を付けて Stream に書き、LazyList の要素は、リダイレクトを書いた文の文脈 sh の OFS で文字列化する。
;; 本体の中の外部コマンドには、file と top の Stream をそのまま渡すので、端末やファイルに直接書く（External_os_stream）
(define Target_for_body ,(sh pos target)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "stream")
    (,()
      Stream_writer sh pos value ,(write)
      __Dict_new__ ,(dict)
      __Dict_put__ dict "stream" value ,()
      __Dict_put__ dict "write" write ,()
      Target_make "file" id dict)
    (,() __NULL__ target))

(define Stream_writer ,(sh pos stream)
  __NULL__ (,(line)
    Line_toString sh pos line ,(line)
    __String_concat__ line "\n" ,(s)
    __OS_write__ __print_exit_error__ stream s))

;; 要素 line をターゲットに書く。stream に書くとき、LazyList の要素は sh の OFS で文字列化する。
;; チャネルの読み手がいなくなっていれば、この VProc を終える（Sh_abort）
(define Target_write ,(sh pos target line)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "stream")
    (,()
      Line_toString sh pos line ,(line)
      __String_concat__ line "\n" ,(s)
      __OS_write__ __print_exit_error__ value s) (,()
  __if_then_else__ (,() __String_equal__ kind "chan")
    (,() Chan_put value line (,() Sh_abort sh)) (,()
  __if_then_else__ (,() __String_equal__ kind "capture")
    (,() Capture_put sh value line) (,()
  __if_then_else__ (,() __String_equal__ kind "file")
    (,()
      Sh_get value "write" ,(write)
      write line)
    (,() value line)))))

;; chan ターゲットなら書き手を閉じる
(define Target_close ,(target)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "chan")
    (,() Chan_close value)
    (,() __nop__))

;; 出力の要素を1行の String にする。LazyList は OFS で文字列化する
(define Line_toString ,(sh pos line)
  __type_name__ line ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() __NULL__ line)
    (,() Value_toString sh pos line))

;; input Stream を EOF まで読み、行ごとにターゲットに書く
(define Target_pump ,(sh target stream)
  __LazyList_lines__ stream ,(lines)
  Target_pump_lines sh target lines)

(define Target_pump_lines ,(sh target lines)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return) lines ,(line rest)
  Line_chomp line ,(line)
  Target_write sh __NULL__ target line ,()
  Target_pump_lines sh target rest)

;; 行末の改行（\n または \r\n）を除く
(define Line_chomp ,(line)
  Ast_chomp line ,(line)
  __String_length__ line ,(len)
  num "1" ,(one)
  __Number_subtract__ len one ,(last)
  __if_then_else__ (,() __Number_is_negative__ last)
    (,() __NULL__ line)
    (,()
      __String_substring__ __print_exit_error__ line last len ,(ch)
      __if_then_else__ (,() __String_equal__ ch "\r")
        (,()
          num "0" ,(zero)
          __String_substring__ __print_exit_error__ line zero last)
        (,() __NULL__ line)))

;; ── 文 ──

;; スクリプトを実行し、最後の文の終了ステータスで終わる
(define Eval_run ,(script args lines)
  Ctx_top script args ,(sh)
  Eval_lines sh lines ,()
  Subst_finish sh ,()
  Jobs_wait_all sh ,()
  Sh_status sh ,(status)
  num status ,(code)
  __OS_exit__ __print_exit_error__ code)

(define Eval_lines ,(sh lines)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ lines) return ,()
  __LList_uncons__ __print_exit_error__ lines ,(line rest)
  Node_split line ,(tag pos stmts)
  Eval_stmts sh stmts ,()
  Eval_lines sh rest)

(define Eval_stmts ,(sh stmts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ stmts) return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(stmt rest)
  Eval_stmt sh stmt ,()
  Eval_stmts sh rest)

(define Eval_stmt ,(sh stmt)
  Eval_stmt_run sh stmt ,()
  Subst_settle sh)

(define Eval_stmt_run ,(sh stmt)
  Node_split stmt ,(tag pos children)
  __if_then_else__ (,() __String_equal__ tag "cmd")
    (,() Eval_cmd sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "if")
    (,() Eval_if sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "for")
    (,() Eval_for sh pos children) (,()
  __String_equal__ tag "break" ,(isBreak)
  __String_equal__ tag "continue" ,(isContinue)
  __or__ isBreak isContinue ,(isJump)
  __if_then_else__ (,() __NULL__ isJump)
    (,() Eval_jump sh pos tag children) (,()
  __if_then_else__ (,() __String_equal__ tag "assign")
    (,()
      Eval_assign sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "export")
    (,()
      Eval_export sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "function")
    (,()
      Func_define sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "return")
    (,() Eval_return sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "pipe")
    (,() Eval_pipe sh pos children)
    (,() Eval_list sh children))))))))))

;; 文「変数定義 {スペース+ 変数定義}」。左から順に局所変数に設定する。右辺がなければ空文字列
(define Eval_assign ,(sh defs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) return ,()
  __LList_uncons__ __print_exit_error__ defs ,(def rest)
  Node_split def ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name values)
  Expand_def_value sh values ,(value)
  Sh_get sh "vars" ,(vars)
  __Dict_put__ vars name value ,()
  Eval_assign sh rest)

;; 文「export 項目 ...」。環境変数に設定し、局所変数は変えない
(define Eval_export ,(sh items)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ items) return ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  Node_split item ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name words)
  __if_then_else__ (,() __String_equal__ tag "name")
    (,()
      Sh_get sh "vars" ,(vars)
      __String_concat__ "export of an undefined local variable: " name ,(msg)
      __Dict_lookup_or__ vars name (,(key) Sh_error sh pos msg) ,(value)
      Value_force value ,(value)
      Value_toString sh pos value)
    (,() Eval_env_value sh pos words) ,(value)
  Sh_get sh "env" ,(env)
  Env_export env name value ,()
  Eval_export sh rest)

;; 環境変数に設定する値。右辺がなければ空文字列。LazyList は1つの String にする
(define Eval_env_value ,(sh pos values)
  Expand_def_value sh values ,(value)
  Value_toString sh pos value)

;; 文「return 語」。語は 0 から 255 の数。関数の残りを実行せずに戻る
(define Eval_return ,(sh pos children)
  Sh_get sh "return" ,(ret)
  Sh_get sh "noReturn" ,(noReturn)
  __unless__ (,() __is_null__ noReturn) (,() Sh_error sh pos noReturn) ,()
  __if__ (,() __is_null__ ret) (,() Sh_error sh pos "return outside a function") ,()
  __LList_uncons__ __print_exit_error__ children ,(word others)
  Expand_fields sh word ,(fields)
  Return_value fields ,(value)
  __if__ (,() __is_null__ value) (,() Sh_error sh pos "return needs a number from 0 to 255") ,()
  Sh_set_status sh value ,()
  ret)

;; 1語の 0 から 255 の数なら、その String。そうでなければ null
(define Return_value ,(fields)
  __Cont_get__ ,(return)
  List_length fields ,(n)
  num "1" ,(one)
  __Number_subtract__ n one ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ fields ,(word others)
  __unless__ (,() String_is_digits word) (,() return __NULL__) ,()
  num word ,(value)
  num "255" ,(max)
  __Number_subtract__ max value ,(room)
  __if__ (,() __Number_is_negative__ room) (,() return __NULL__) ,()
  __Number_toString__ value)

;; ── 関数 ──
;; 関数は Dict で、"params"（params の節）、"body"（script の節）、
;; "scope"（定義した文脈）、"vars"（定義した時点の局所変数の写し）を持つ

;; 文「function 名前 変数リスト { スクリプト }」。このスコープの関数の Dict に置く
(define Func_define ,(sh children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(params rest)
  __LList_uncons__ __print_exit_error__ rest ,(body rest)
  Sh_get sh "vars" ,(vars)
  Dict_copy vars ,(vars)
  __Dict_new__ ,(fn)
  __Dict_put__ fn "params" params ,()
  __Dict_put__ fn "body" body ,()
  __Dict_put__ fn "scope" sh ,()
  __Dict_put__ fn "vars" vars ,()
  Sh_get sh "funcs" ,(funcs)
  __Dict_put__ funcs name fn)

;; name の関数。レキシカルに外側へ向かって、最も近いスコープの関数を探す。なければ null
(define Func_lookup ,(sh name)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ sh) (,() return __NULL__) ,()
  Sh_get sh "funcs" ,(funcs)
  __Dict_lookup_or__ funcs name (,(key) __NULL__ __NULL__) ,(fn)
  __unless__ (,() __is_null__ fn) (,() return fn) ,()
  Sh_get sh "parent" ,(parent)
  Func_lookup parent name)

;; 関数を呼び出す。引数（String か LazyList）を変数リストに渡し、本体を新しいスコープで実行する。
;; 前置の変数定義の層は、sh の環境変数に積んである（Cmd_scope）
(define Func_call ,(sh pos fn args in out err)
  __Cont_get__ ,(return)
  Sh_get fn "params" ,(params)
  Sh_get fn "body" ,(body)
  Sh_get fn "scope" ,(scope)
  Sh_get fn "vars" ,(vars)
  Dict_copy vars ,(vars)
  Node_split params ,(ptag ppos pchildren)
  __LList_uncons__ __print_exit_error__ pchildren ,(names rest)
  List_first rest ,(restName)
  Func_bind vars names restName args ,()
  Sh_get sh "env" ,(env)
  __Dict_new__ ,(funcs)
  Dict_copy sh ,(callee)
  __Dict_put__ callee "vars" vars ,()
  __Dict_put__ callee "funcs" funcs ,()
  __Dict_put__ callee "parent" scope ,()
  __Dict_put__ callee "inFunction" __TRUE__ ,()
  __Dict_put__ callee "return" return ,()
  __Dict_put__ callee "loops" __NULL__ ,()
  __Dict_put__ callee "noReturn" __NULL__ ,()
  __Dict_put__ callee "env" env ,()
  __Dict_put__ callee "in" in ,()
  __Dict_put__ callee "out" out ,()
  __Dict_put__ callee "err" err ,()
  Node_split body ,(btag bpos lines)
  Sh_set_status sh "0" ,()
  Eval_lines callee lines)

;; 引数を順に名前に渡す。足りなければ空文字列。残りは LazyList にして restName に渡す（restName が "" なら捨てる）
(define Func_bind ,(vars names restName args)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names)
    (,()
      __unless__ (,() __String_equal__ restName "")
        (,()
          LazyList_fromList args ,(list)
          __Dict_put__ vars restName list) ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ names ,(name others)
  List_first args ,(arg)
  __Dict_put__ vars name arg ,()
  __if_then_else__ (,() __is_null__ args)
    (,() __NULL__ __NULL__)
    (,() __LList_uncons__ __print_exit_error__ args ,(head tail) __NULL__ tail) ,(args)
  Func_bind vars others restName args)

;; 関数に渡す標準出力と標準エラー出力のターゲット。標準出力の stream は file にする（Target_for_body）。
;; 標準エラー出力は、標準出力と同じ行き先（2>&1）なら同じターゲットにし、そうでなければそのまま
(define Func_targets ,(sh pos out err)
  Target_split out ,(outKind outId outValue)
  Target_split err ,(errKind errId errValue)
  Target_for_body sh pos out ,(out)
  __if_then_else__ (,() __String_equal__ outId errId)
    (,() __NULL__ out)
    (,() __NULL__ err) ,(err)
  __NULL__ out err)

;; ── 単純文 ──

;; (cmd [env] words [redirs]) の子を、前置の変数定義、語、リダイレクトの LList に分ける
(define Cmd_parts ,(children)
  Cmd_parts_from children __NULL__ __NULL__ __NULL__)

(define Cmd_parts_from ,(children defs words redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return defs words redirs) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "env")
    (,() Cmd_parts_from rest items words redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "words")
    (,() Cmd_parts_from rest defs items redirs)
    (,() Cmd_parts_from rest defs words items)))

;; 単純文を実行する。前置の変数定義は、同じ文の語の展開に反映する。
;; 先頭の語を先に展開してコマンドを決め、残りの語は、外部コマンドなら葉ごとの String に、
;; 関数と組み込みコマンドなら外部コマンド以外の語の規則で、値（String か LazyList）に展開する
(define Eval_cmd ,(sh pos children)
  __Cont_get__ ,(return)
  Cmd_parts children ,(defs words redirs)
  Cmd_scope sh defs ,(sh)
  Arg_limit_new sh pos ,(limit)
  Cmd_head sh words limit ,(name more rest)
  __if_then_else__ (,() __is_null__ name)
    (,() __NULL__ __TRUE__)
    (,() Cmd_is_external sh name) ,(isExternal)
  Eval_args sh rest isExternal limit ,(args)
  __if_then_else__ (,() __NULL__ isExternal)
    (,() Values_leaves_in more limit)
    (,() __NULL__ more) ,(more)
  List_append more args ,(args)
  Eval_redirs sh redirs ,(in out err opened ok group)
  __unless__ (,() __NULL__ ok)
    (,()
      Eval_close opened ,()
      Sh_set_status sh "1" ,()
      return) ,()
  __if__ (,() __is_null__ name)
    (,()
      Eval_close opened ,()
      Capture_assign sh group ,()
      Sh_set_status sh "0" ,()
      return) ,()
  Capture_run sh group (,(s) Cmd_run s pos name args in out err) ,()
  Eval_close opened)

;; 前置の変数定義があれば、その層を環境変数に積んだ文脈を返す。
;; 前置の変数定義どうしは影響しないので、どれも sh で展開する
(define Cmd_scope ,(sh defs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) (,() return sh) ,()
  __Dict_new__ ,(layer)
  Eval_env_defs sh defs layer ,()
  Sh_get sh "env" ,(env)
  Env_push env layer ,(env)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "env" env ,()
  __NULL__ inner)

;; 先頭の語を展開して、コマンドの名前と、先頭の語から出た残りの値の LList と、残りの語を返す。
;; ${x} と $(cmd) の LazyList なら、要素を順に値にする。先頭の要素だけは再帰的に展開して名前を取る（Value_head）。
;; そうでなければ、外部コマンドの語として展開し、最初の語が名前になる。
;; LazyList を含む語が空になればエラー。LazyList を含まない語が消えれば、次の語を見る。
;; 語がすべて消えたら、名前は null。
;; 外部コマンドの語として展開するときは、葉ごとに引数のバイト数の上限 limit から引く（外部コマンドでなかったときも）
(define Cmd_head ,(sh words limit)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__ __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  Node_split word ,(tag pos elems)
  Expand_parts sh word ,(parts)
  Parts_count parts "leaves" ,(nLeaves)
  Parts_count parts "list" ,(nList)
  __Number_is_zero__ nLeaves ,(noLeaves)
  __Number_is_zero__ nList ,(noList)
  __not__ noList ,(hasList)
  __and__ noLeaves hasList ,(isList)
  __if__ (,() __NULL__ isList)
    (,()
      Parts_list_value parts nList ,(value)
      Value_head sh pos value ,(name more)
      return name more rest) ,()
  Parts_fields_in parts limit ,(fields)
  __if__ (,() __is_null__ fields)
    (,()
      __and__ noLeaves noList ,(noLazyList)
      __unless__ (,() __NULL__ noLazyList) (,() Sh_error sh pos "the command name is an empty LazyList") ,()
      Cmd_head sh rest limit ,(name more rest)
      return name more rest) ,()
  __LList_uncons__ __print_exit_error__ fields ,(name more)
  __NULL__ name more rest)

;; name が外部コマンドか。関数、組み込みコマンド、builtin、command でなければ外部コマンド
(define Cmd_is_external ,(sh name)
  __Cont_get__ ,(return)
  __String_equal__ name "builtin" ,(isBuiltin)
  __String_equal__ name "command" ,(isCommand)
  __or__ isBuiltin isCommand ,(special)
  __if__ (,() __NULL__ special) (,() return __FALSE__) ,()
  Func_lookup sh name ,(fn)
  __unless__ (,() __is_null__ fn) (,() return __FALSE__) ,()
  Builtin_lookup name ,(builtin)
  __unless__ (,() __is_null__ builtin) (,() return __FALSE__) ,()
  __NULL__ __TRUE__)

;; (cmd [env] words [redirs]) の子を、前置の変数定義、語、リダイレクトの LList に分ける
(define Cmd_parts ,(children)
  Cmd_parts_from children __NULL__ __NULL__ __NULL__)

(define Cmd_parts_from ,(children defs words redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return defs words redirs) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "env")
    (,() Cmd_parts_from rest items words redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "words")
    (,() Cmd_parts_from rest defs items redirs)
    (,() Cmd_parts_from rest defs words items)))

;; 名前 name で、関数、組み込みコマンド、外部コマンドの順に探して実行する。
;; builtin name は組み込みコマンドを、command name は外部コマンドを実行する。
;; args は、外部コマンドなら String、それ以外なら値（String か LazyList）の LList
(define Cmd_run ,(sh pos name args in out err)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ name "builtin")
    (,()
      __if__ (,() __is_null__ args) (,() Sh_error sh pos "builtin: a command name is needed") ,()
      __LList_uncons__ __print_exit_error__ args ,(name2 args2)
      Arg_string sh pos "builtin" name2 ,(name2)
      Builtin_lookup name2 ,(builtin)
      __String_concat__ "builtin: not a builtin command: " name2 ,(msg)
      __if__ (,() __is_null__ builtin) (,() Sh_error sh pos msg) ,()
      builtin sh pos args2 in out err ,()
      return) ,()
  __if__ (,() __String_equal__ name "command")
    (,()
      Arg_limit_new sh pos ,(limit)
      Values_leaves_in args limit ,(args)
      __if__ (,() __is_null__ args) (,() Sh_error sh pos "command: a command name is needed") ,()
      __LList_uncons__ __print_exit_error__ args ,(name2 args2)
      External_run sh pos name2 args2 in out err ,()
      return) ,()
  Func_lookup sh name ,(fn)
  __unless__ (,() __is_null__ fn)
    (,()
      Func_targets sh pos out err ,(out err)
      Func_call sh pos fn args in out err ,()
      return) ,()
  Builtin_lookup name ,(builtin)
  __unless__ (,() __is_null__ builtin)
    (,()
      builtin sh pos args in out err ,()
      return) ,()
  External_run sh pos name args in out err)

;; 組み込みコマンドの引数 v が String なら、そのまま返す。LazyList ならエラー
(define Arg_string ,(sh pos command v)
  __type_name__ v ,(type)
  __String_concat__ command ": a LazyList is not allowed as an argument" ,(msg)
  __unless__ (,() __String_equal__ type "String") (,() Sh_error sh pos msg) ,()
  __NULL__ v)

;; ── if 文 ──

;; if 文を実行する。中の変数定義と関数定義は外に反映するので、局所変数と関数の Dict は同じものを使う
(define Eval_if ,(sh pos children)
  If_parts children ,(clauses elseBody redirs)
  Eval_redirected sh pos redirs (,(inner) If_clauses inner clauses elseBody))

;; if 文と for 文で、リダイレクトを適用した文脈 inner で run を実行する。リダイレクトがなければ sh のまま。
;; 関数と同じく、中の外部コマンドの出力は行ごとの要素にしてから書く。
;; 中の return、break、continue で外へ抜けるときも、開いた Stream を閉じる
(define Eval_redirected ,(sh pos redirs run)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs)
    (,()
      run sh ,()
      return) ,()
  Eval_redirs sh redirs ,(in out err opened ok group)
  __unless__ (,() __NULL__ ok)
    (,()
      Eval_close opened ,()
      Sh_set_status sh "1" ,()
      return) ,()
  Func_targets sh pos out err ,(out err)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "bgCaptures" __NULL__ ,()
  __Dict_put__ inner "in" in ,()
  __Dict_put__ inner "out" out ,()
  __Dict_put__ inner "err" err ,()
  Sh_get sh "return" ,(ret)
  __unless__ (,() __is_null__ ret)
    (,() __Dict_put__ inner "return" (,() Eval_close opened ,() Capture_assign sh group ,() ret)) ,()
  Sh_get sh "loops" ,(loops)
  Loops_closing sh loops opened group ,(loops)
  __Dict_put__ inner "loops" loops ,()
  Capture_run inner group run ,()
  Eval_close opened)

;; ループの LList の各 break と continue の継続を、先に opened を閉じ、変数リストに値を割り当てるものにした LList
(define Loops_closing ,(sh loops opened group)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ loops) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ loops ,(loop rest)
  Loop_split loop ,(name brk cont)
  Loop_make name
    (,() Eval_close opened ,() Capture_assign sh group ,() brk)
    (,() Eval_close opened ,() Capture_assign sh group ,() cont) ,(loop)
  Loops_closing sh rest opened group ,(rest)
  __LList_cons__ loop rest)

;; (if clause ... [else] [redirs]) の子を、clause の LList、else のスクリプト（なければ null）、
;; リダイレクトの LList に分ける
(define If_parts ,(children)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return __NULL__ __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  If_parts rest ,(clauses elseBody redirs)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "clause")
    (,()
      __LList_cons__ child clauses ,(clauses)
      __NULL__ clauses elseBody redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "else")
    (,()
      List_first items ,(body)
      __NULL__ clauses body redirs)
    (,() __NULL__ clauses elseBody items)))

;; 条件を順に実行し、最初に $? が 0 になった clause の本体を実行する。どれも 0 でなければ else を実行する。
;; else がなく、どの条件も成り立たなければ $? は 0
(define If_clauses ,(sh clauses elseBody)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ clauses)
    (,()
      __if_then_else__ (,() __is_null__ elseBody)
        (,() Sh_set_status sh "0")
        (,() If_script sh elseBody) ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ clauses ,(clause rest)
  Node_split clause ,(tag pos scripts)
  __LList_uncons__ __print_exit_error__ scripts ,(cond others)
  List_first others ,(body)
  If_script sh cond ,()
  Sh_status sh ,(status)
  __if_then_else__ (,() __String_equal__ status "0")
    (,() If_script sh body)
    (,() If_clauses sh rest elseBody))

;; if 文の中のスクリプトを実行する。空のスクリプトの $? は 0
(define If_script ,(sh script)
  __Cont_get__ ,(return)
  Node_split script ,(tag pos lines)
  __if__ (,() __is_null__ lines) (,() Sh_set_status sh "0" ,() return) ,()
  Eval_lines sh lines)

;; ── 別の VProc ──
;; コマンド置換とパイプラインの各要素は、別の VProc で動かす。
;; 中の変数定義、関数定義、export、cd、$? は外に影響しない。中から return や外のループへの break、continue はできない

;; 子の VProc の文脈。局所変数と環境変数は写しにし、関数は新しいスコープ（外側は sh）に定義する。
;; $? は sh の値から始まり、子の "global" に入る。noReturn は return をエラーにするときのメッセージ
(define Sh_child ,(sh in out err noReturn)
  Sh_get sh "global" ,(global)
  Dict_copy global ,(global)
  __Dict_put__ global "substs" __NULL__ ,()
  __Dict_put__ global "jobs" __NULL__ ,()
  Sh_get sh "vars" ,(vars)
  Dict_copy vars ,(vars)
  Sh_get sh "env" ,(env)
  Env_copy env ,(env)
  __Dict_new__ ,(funcs)
  Dict_copy sh ,(child)
  __Dict_put__ child "global" global ,()
  __Dict_put__ child "vars" vars ,()
  __Dict_put__ child "env" env ,()
  __Dict_put__ child "funcs" funcs ,()
  __Dict_put__ child "parent" sh ,()
  __Dict_put__ child "in" in ,()
  __Dict_put__ child "out" out ,()
  __Dict_put__ child "err" err ,()
  __Dict_put__ child "return" __NULL__ ,()
  __Dict_put__ child "noReturn" noReturn ,()
  __Dict_put__ child "loops" __NULL__ ,()
  __Dict_put__ child "abort" __NULL__ ,()
  __Dict_put__ child "cancelIn" __NULL__ ,()
  __Dict_put__ child "bgCaptures" __NULL__ ,()
  __Dict_put__ child "owned" __NULL__ ,()
  __Ref_new__ __NULL__ ,(procRef)
  __Dict_put__ child "procRef" procRef ,()
  __NULL__ child)

;; 子の VProc に渡すターゲット。chan なら、同じチャネルの新しい書き手にする（id は同じ）
(define Child_target ,(target)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "chan")
    (,()
      Chan_of value ,(chan)
      Chan_writer chan ,(writer)
      Target_make "chan" id writer)
    (,() __NULL__ target))

;; 標準出力と標準エラー出力を子に渡す。同じ行き先（2>&1）なら同じ書き手にする
(define Child_targets ,(out err)
  Child_target out ,(childOut)
  Target_split out ,(outKind outId outValue)
  Target_split err ,(errKind errId errValue)
  __if_then_else__ (,() __String_equal__ outId errId)
    (,() __NULL__ childOut)
    (,() Child_target err) ,(childErr)
  __NULL__ childOut childErr)

;; 文脈 child で body を実行する VProc を起動する。
;; 読み手がいなくなったチャネルに書くと、body の残りを捨てる（Sh_abort）。
;; 終わるときに、標準出力と標準エラー出力の書き手を閉じ、cancelIn のチャネルを cancel する
(define Sh_start ,(child body)
  __VProc_start__ (,()
    Sh_guarded child body ,()
    Sh_finish child))

(define Sh_guarded ,(child body)
  __Cont_get__ ,(done)
  __Ref_new__ done ,(abortRef)
  __Dict_put__ child "abort" abortRef ,()
  body child ,()
  __nop__)

;; 終わるときに、この VProc で起動した $( ) を終わらせてから、出力の書き手を閉じる
(define Sh_finish ,(child)
  Subst_finish child ,()
  Sh_release child)

;; 出力の書き手を閉じ、標準入力のチャネルを cancel し、$( ) の状態を "done" にする（kill でも使う）
(define Sh_release ,(child)
  Sh_get child "out" ,(out)
  Sh_get child "err" ,(err)
  Target_close out ,()
  Target_close err ,()
  Sh_get child "cancelIn" ,(chan)
  __unless__ (,() __is_null__ chan) (,() Chan_cancel chan) ,()
  __Dict_lookup_or__ child "substState" (,(key) __NULL__ __NULL__) ,(state)
  __unless__ (,() __is_null__ state) (,() __Ref_set__ state "done"))

;; この VProc を終える（Sh_start の body の残りを捨てる）
(define Sh_abort ,(sh)
  Sh_get sh "abort" ,(abortRef)
  __if__ (,() __is_null__ abortRef) (,() Sh_error sh __NULL__ "the reader of a pipe has finished") ,()
  __Ref_get__ abortRef ,(abort)
  abort)

;; チャネルが先に書ける要素の数
(define Pipe_cap ,()
  num "16")

;; 標準入力。Dict で、次のキーを持つ。
;;   "list"    まだ読んでいない要素の LazyList を入れた Ref。読んだ分だけ進める（読み出し位置の共有）
;;   "sh"      要素の LazyList を文字列化するときに OFS を探す文脈（パイプやリダイレクトを書いた文のスコープ）
;;   "stream"  Stream から作った場合はその Stream、そうでなければ null
;;   "touched" "list" を読んだことがあれば __TRUE__ の Ref。読んでいなければ、外部コマンドに Stream をそのまま渡す

;; 要素の LazyList から作る標準入力（パイプ、< (a b . rest)）
(define Input_new ,(sh list)
  __Ref_new__ list ,(ref)
  __Ref_new__ __TRUE__ ,(touched)
  __Dict_new__ ,(input)
  __Dict_put__ input "list" ref ,()
  __Dict_put__ input "sh" sh ,()
  __Dict_put__ input "stream" __NULL__ ,()
  __Dict_put__ input "touched" touched ,()
  __NULL__ input)

;; Stream から作る標準入力（シェルの標準入力、< ファイル）。要素は、改行を除いた行
(define Input_stream ,(sh stream)
  __LazyList_lines__ stream ,(lines)
  Lines_chomped lines ,(list)
  Input_new sh list ,(input)
  __Dict_put__ input "stream" stream ,()
  __Ref_new__ __FALSE__ ,(touched)
  __Dict_put__ input "touched" touched ,()
  __NULL__ input)

;; 行の LazyList の各行から改行を除いた LazyList（遅延のまま）
(define Lines_chomped ,(lines)
  __LazyList_new__ (,()
    __Cont_get__ ,(return)
    __LazyList_uncons__ (,() __LazyList_empty__ ,(empty) return empty) lines ,(line rest)
    Line_chomp line ,(line)
    Lines_chomped rest ,(rest)
    __LazyList_cons__ line rest))

;; < (a b . rest) の標準入力。a、b の値を順に要素にし、続けて rest の値の要素を並べる。
;; rest の値が String なら、1つの要素にする
(define Input_vars ,(sh pos params)
  __LList_uncons__ __print_exit_error__ params ,(names restList)
  List_first restList ,(restName)
  __if_then_else__ (,() __String_equal__ restName "")
    (,() __LazyList_empty__)
    (,()
      Sh_lookup sh pos restName ,(value)
      __type_name__ value ,(type)
      __if_then_else__ (,() __String_equal__ type "String")
        (,()
          __LazyList_empty__ ,(empty)
          __LazyList_cons__ value empty)
        (,() __NULL__ value)) ,(tail)
  Input_vars_names sh pos names tail ,(list)
  Input_new sh list)

(define Input_vars_names ,(sh pos names tail)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names) (,() return tail) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Sh_lookup sh pos name ,(value)
  Input_vars_names sh pos rest tail ,(more)
  __LazyList_cons__ value more)

;; ── 変数リストへのリダイレクト ──
;; > (a b . rest) と 2> (a b . rest)。受け取った要素を順に a、b に、残りを rest に割り当てる。
;; 同じ文の変数リストへのリダイレクトは組（group）にまとめる。組は Dict で、
;;   "records"     各リダイレクトの記録の LList
;;   "hasRest"     rest のある記録があるか
;;   "stopped"     コマンドを止めたか（Ref）
;; 記録は Dict で、"names"（変数名の LList）、"need"（その数）、"restName"（なければ ""）、
;; "items"（受け取った要素の MSeq）、"count"（その数の Ref）、"direct"（stdin が渡した残りの LazyList の Ref）、"group"。
;; rest のない記録がすべて変数の数だけ受け取り、rest のある記録がなければ、次に書いたときにコマンドを止める
;; （SIGPIPE に当たる。$? は 0）。それまでは、変数の数を超えた要素は捨てる。
;; 標準出力と標準エラー出力の記録は別々の VProc が書くので、組で共有する数は持たず、
;; 止めるかどうかは、書くたびに組のすべての記録の "count" を見て決める（Capture_satisfied）

;; 新しい記録を組に加え（組が null なら作る）、その capture ターゲットと組を返す
(define Capture_new ,(sh group params)
  __Cont_get__ ,(return)
  __if_then_else__ (,() __is_null__ group)
    (,()
      __Dict_new__ ,(g)
      __Dict_put__ g "records" __NULL__ ,()
      __Dict_put__ g "hasRest" __FALSE__ ,()
      __Ref_new__ __FALSE__ ,(stopped)
      __Dict_put__ g "stopped" stopped ,()
      __NULL__ g)
    (,() __NULL__ group) ,(group)
  __LList_uncons__ __print_exit_error__ params ,(names restList)
  List_first restList ,(restName)
  List_length names ,(need)
  __Dict_new__ ,(record)
  __Dict_put__ record "names" names ,()
  __Dict_put__ record "need" need ,()
  __Dict_put__ record "restName" restName ,()
  __MSeq_new__ ,(items)
  __Dict_put__ record "items" items ,()
  num "0" ,(zero)
  __Ref_new__ zero ,(count)
  __Dict_put__ record "count" count ,()
  __Ref_new__ __NULL__ ,(direct)
  __Dict_put__ record "direct" direct ,()
  __Dict_put__ record "group" group ,()
  Sh_get sh "bgCaptures" ,(specs)
  __if_then_else__ (,() __is_null__ specs)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ specs ,(spec others)
      __Dict_put__ sh "bgCaptures" others ,()
      __NULL__ spec) ,(spec)
  __Dict_put__ record "spec" spec ,()
  Sh_get group "records" ,(records)
  __LList_cons__ record records ,(records)
  __Dict_put__ group "records" records ,()
  __unless__ (,() __String_equal__ restName "")
    (,() __Dict_put__ group "hasRest" __TRUE__) ,()
  Sh_get sh "global" ,(global)
  Target_new_id global ,(id)
  Target_make "capture" id record ,(target)
  __NULL__ target group)

;; 要素 item を受け取る。変数の数を超えたら、rest があれば残りに加え、なければ捨てるか、コマンドを止める
(define Capture_put ,(sh record item)
  __Cont_get__ ,(return)
  Sh_get record "restName" ,(restName)
  __String_equal__ restName "" ,(noRest)
  Sh_get record "need" ,(need)
  Sh_get record "count" ,(countRef)
  __Ref_get__ countRef ,(count)
  __Number_subtract__ count need ,(diff)
  __Number_is_negative__ diff ,(needed)
  __not__ noRest ,(hasRest)
  __or__ needed hasRest ,(keep)
  __if__ (,() __NULL__ keep)
    (,()
      Capture_add record item ,()
      return) ,()
  Sh_get record "group" ,(group)
  Sh_get group "hasRest" ,(groupHasRest)
  __if__ (,() __NULL__ groupHasRest) return ,()
  Sh_get group "records" ,(records)
  Capture_satisfied records ,(satisfied)
  __unless__ (,() __NULL__ satisfied) return ,()
  Sh_get group "stopped" ,(stopped)
  __Ref_set__ stopped __TRUE__ ,()
  Sh_abort sh)

;; 組のすべての記録（rest はない）が、変数の数だけ受け取ったか
(define Capture_satisfied ,(records)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ records) (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ records ,(record rest)
  Sh_get record "count" ,(countRef)
  __Ref_get__ countRef ,(count)
  Sh_get record "need" ,(need)
  __Number_subtract__ count need ,(diff)
  __if__ (,() __Number_is_negative__ diff) (,() return __FALSE__) ,()
  Capture_satisfied rest)

;; 要素を記録に加える
(define Capture_add ,(record item)
  Sh_get record "items" ,(items)
  __MSeq_append__ __print_exit_error__ items item ,()
  Sh_get record "count" ,(countRef)
  __Ref_get__ countRef ,(count)
  num "1" ,(one)
  __Number_add__ count one ,(count)
  __Ref_set__ countRef count ,()
  Bg_spec_add record count item)

;; stdin > (a b . rest)：標準入力の要素を、変数の数だけ読み出し位置を進めながら受け取り、
;; rest には残りの LazyList をそのまま渡す（読み出し位置は進めない。rest は参照した時点で読む）
(define Capture_take ,(sh record listRef)
  __Cont_get__ ,(return)
  Sh_get record "count" ,(countRef)
  __Ref_get__ countRef ,(count)
  Sh_get record "need" ,(need)
  __Number_subtract__ count need ,(diff)
  __if__ (,() __Number_is_negative__ diff)
    (,()
      __Ref_get__ listRef ,(list)
      __LazyList_uncons__ (,() return) list ,(item rest)
      Capture_add record item ,()
      __Ref_set__ listRef rest ,()
      Capture_take sh record listRef ,()
      return) ,()
  Sh_get record "restName" ,(restName)
  __if__ (,() __String_equal__ restName "") return ,()
  __Ref_get__ listRef ,(list)
  Sh_get record "direct" ,(direct)
  __Ref_set__ direct list ,()
  Bg_spec_splice record list)

;; 組があれば、body をコマンドを止められる文脈で実行し、変数に割り当てる。止めたら $? は 0。
;; 組がなければ、body をそのまま実行する
(define Capture_run ,(sh group body)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ group) (,() body sh ,() return) ,()
  Capture_guarded sh body ,()
  Sh_get group "stopped" ,(stopped)
  __Ref_get__ stopped ,(isStopped)
  __if__ (,() __NULL__ isStopped) (,() Sh_set_status sh "0") ,()
  Capture_assign sh group)

(define Capture_guarded ,(sh body)
  __Cont_get__ ,(done)
  Dict_copy sh ,(inner)
  __Ref_new__ done ,(abortRef)
  __Dict_put__ inner "abort" abortRef ,()
  __Dict_put__ inner "bgCaptures" __NULL__ ,()
  body inner ,()
  __nop__)

;; 組の各記録の値を、sh の局所変数に割り当てる。足りない変数は空文字列、rest は残りの LazyList（なければ空）
(define Capture_assign ,(sh group)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ group) return ,()
  Sh_get group "records" ,(records)
  List_reverse records ,(records)
  Capture_assign_records sh records)

(define Capture_assign_records ,(sh records)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ records) return ,()
  __LList_uncons__ __print_exit_error__ records ,(record rest)
  Sh_get record "spec" ,(spec)
  Bg_spec_finish spec ,()
  Sh_get record "items" ,(items)
  List_fromMSeq items ,(items)
  Sh_get record "names" ,(names)
  Sh_get sh "vars" ,(vars)
  Capture_assign_names vars names items ,(items)
  Sh_get record "restName" ,(restName)
  __unless__ (,() __String_equal__ restName "")
    (,()
      Sh_get record "direct" ,(directRef)
      __Ref_get__ directRef ,(direct)
      __if_then_else__ (,() __is_null__ direct) (,() __LazyList_empty__) (,() __NULL__ direct) ,(tail)
      LazyList_prepend items tail ,(list)
      __Dict_put__ vars restName list) ,()
  Capture_assign_records sh rest)

;; names に items を順に割り当て、残りの items を返す
(define Capture_assign_names ,(vars names items)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names) (,() return items) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __if_then_else__ (,() __is_null__ items)
    (,() __NULL__ "" __NULL__)
    (,() __LList_uncons__ __print_exit_error__ items ,(item more) __NULL__ item more) ,(value more)
  __Dict_put__ vars name value ,()
  Capture_assign_names vars rest more)

;; LList items の後に LazyList tail を続けた LazyList
(define LazyList_prepend ,(items tail)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ items) (,() return tail) ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  LazyList_prepend rest tail ,(more)
  __LazyList_cons__ item more)

;; MSeq の要素の LList
(define List_fromMSeq ,(mseq)
  __Cont_get__ ,(return)
  __MSeq_is_empty__ __print_exit_error__ mseq ,(empty)
  __if__ (,() __NULL__ empty) (,() return __NULL__) ,()
  __MSeq_uncons__ __print_exit_error__ mseq ,(item rest)
  List_fromMSeq rest ,(more)
  __LList_cons__ item more)

;; ── コマンド置換 ──

;; $( スクリプト ) を別の VProc で実行し、標準出力の要素を並べた LazyList を返す。外部コマンドの出力は行ごとの要素になる。
;; 終わるのを待たずに返すので、要素は読み進めるのと並行に作られる。
;; 文の終わりには、子が終わるか、チャネルが一杯で書き手が待つまで待つ（Subst_settle）。
;; そのため、出力の少ない $( ) の副作用は、次の文より前に終わる
(define Eval_subst ,(sh pos script)
  Node_split script ,(tag spos lines)
  Pipe_cap ,(cap)
  Chan_new cap ,(chan)
  __Ref_new__ "running" ,(state)
  __Dict_put__ chan "state" state ,()
  Chan_writer chan ,(writer)
  Sh_get sh "global" ,(global)
  Target_new_id global ,(id)
  Target_make "chan" id writer ,(out)
  Sh_get sh "err" ,(err)
  Child_target err ,(err)
  Sh_get sh "in" ,(in)
  Sh_child sh in out err "return in a command substitution" ,(child)
  __Dict_put__ child "substState" state ,()
  Sh_start child (,(c) Eval_lines c lines) ,(vproc)
  Subst_watch vproc child ,()
  __Dict_new__ ,(record)
  __Dict_put__ record "vproc" vproc ,()
  __Dict_put__ record "chan" chan ,()
  __Dict_put__ record "state" state ,()
  Sh_get sh "global" ,(global)
  Sh_get global "substs" ,(substs)
  __LList_cons__ record substs ,(substs)
  __Dict_put__ global "substs" substs ,()
  Chan_list chan)

;; 子の VProc が ConMa の実行時エラーで止まると、Sh_finish を通らず、状態が "running" のまま、
;; チャネルも開いたまま残り、文の終わりや値を読む側が待ち続ける。そのため、別の VProc で子の終わりを待ち、
;; Sh_release で状態を "done" にし、出力の書き手を閉じる。正常に終わったときは、すでに Sh_finish が
;; 同じことをしているので、何も変わらない（Chan_close は2回目は何もしない）
(define Subst_watch ,(vproc child)
  __VProc_start__ (,()
    __VProc_wait__ __print_exit_error__ vproc ,()
    Sh_release child) ,(watcher)
  __nop__)

;; 文の終わりに、この VProc で起動した $( ) を、それぞれ終わるか、チャネルが一杯で書き手が待つまで待つ。
;; 終わったものは記録から除き、待っているもの（値がまだ読まれていない）は残す
(define Subst_settle ,(sh)
  __Cont_get__ ,(return)
  Sh_get sh "global" ,(global)
  Sh_get global "substs" ,(substs)
  __if__ (,() __is_null__ substs) return ,()
  Subst_settle_list substs ,(kept)
  __Dict_put__ global "substs" kept)

(define Subst_settle_list ,(substs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ substs) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ substs ,(record rest)
  Subst_settle_one record ,(state)
  Subst_settle_list rest ,(kept)
  __if__ (,() __String_equal__ state "done") (,() return kept) ,()
  __LList_cons__ record kept)

;; 状態が "running" でなくなるまで待ち、その状態（"blocked" か "done"）を返す
(define Subst_settle_one ,(record)
  __Cont_get__ ,(return)
  Sh_get record "state" ,(stateRef)
  __Ref_get__ stateRef ,(state)
  __unless__ (,() __String_equal__ state "running") (,() return state) ,()
  __Ref_wait_change__ stateRef state ,()
  Subst_settle_one record)

;; スクリプトや VProc の終わりに、まだ終わっていない $( ) のチャネルを cancel し、終わるのを待つ。
;; 出力のないもの（x=$(mkdir d)）は最後まで動き、書き手が待っているもの（x=$(yes)）は次に書いたときに止まる
(define Subst_finish ,(sh)
  Sh_get sh "global" ,(global)
  Sh_get global "substs" ,(substs)
  __Dict_put__ global "substs" __NULL__ ,()
  Subst_finish_list substs)

(define Subst_finish_list ,(substs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ substs) return ,()
  __LList_uncons__ __print_exit_error__ substs ,(record rest)
  Sh_get record "chan" ,(chan)
  Chan_cancel chan ,()
  Sh_get record "vproc" ,(vproc)
  __VProc_wait__ __print_exit_error__ vproc ,()
  Subst_finish_list rest)

;; ── パイプライン ──

;; パイプラインの各要素を別の VProc で動かし、前の要素の標準出力の要素を、次の要素の標準入力にする。
;; すべての要素が終わるのを待ち、$? は最後の要素の終了ステータスにする
(define Eval_pipe ,(sh pos elems)
  Pipe_check sh elems __TRUE__ ,()
  Sh_get sh "in" ,(in)
  Pipe_start sh elems in __NULL__ __NULL__ __NULL__ ,(vprocs last)
  Pipe_wait vprocs ,()
  Sh_get last "global" ,(global)
  __Dict_lookup_or__ global "status" __print_exit_error__ ,(status)
  Sh_set_status sh status)

;; 要素を順に起動する。in はこの要素の標準入力、cancelIn はそのチャネル（最初の要素は null）、
;; owned はこの要素が閉じる Stream の LList（前の要素との OS のパイプの読む側）。
;; 起動した VProc の LList と、最後の要素の文脈を返す。
;; この要素と次の要素がどちらも外部コマンドなら（Pipe_is_external）、チャネルではなく OS のパイプで直接つなぐ
(define Pipe_start ,(sh elems in cancelIn owned vprocs)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Sh_get sh "err" ,(err)
  __if__ (,() __is_null__ rest)
    (,()
      Sh_get sh "out" ,(out)
      Child_targets out err ,(out err)
      Pipe_element sh elem in out err cancelIn owned ,(vproc child)
      __LList_cons__ vproc vprocs ,(vprocs)
      return vprocs child) ,()
  Pipe_is_external sh elem ,(writes)
  List_first rest ,(next)
  Pipe_is_external sh next ,(reads)
  __and__ writes reads ,(direct)
  __if__ (,() __NULL__ direct)
    (,()
      __OS_pipe__ ,(reader writer)
      Sh_get sh "global" ,(global)
      Target_stream global writer ,(out)
      Child_target err ,(err)
      __LList_cons__ writer owned ,(mine)
      Pipe_element sh elem in out err cancelIn mine ,(vproc child)
      __LList_cons__ vproc vprocs ,(vprocs)
      Input_stream sh reader ,(next)
      __LList_cons__ reader __NULL__ ,(nextOwned)
      Pipe_start sh rest next __NULL__ nextOwned vprocs ,(vprocs last)
      return vprocs last) ,()
  Pipe_cap ,(cap)
  Chan_new cap ,(chan)
  Chan_writer chan ,(writer)
  Sh_get sh "global" ,(global)
  Target_new_id global ,(id)
  Target_make "chan" id writer ,(out)
  Child_target err ,(err)
  Pipe_element sh elem in out err cancelIn owned ,(vproc child)
  __LList_cons__ vproc vprocs ,(vprocs)
  Chan_list chan ,(list)
  Input_new sh list ,(next)
  Pipe_start sh rest next chan __NULL__ vprocs)

;; owned の Stream は、要素の外部コマンドを起動したら閉じる（External_run）。起動しなかったときのため、要素の終わりにも閉じる
(define Pipe_element ,(sh elem in out err cancelIn owned)
  Sh_child sh in out err "return in a pipeline" ,(child)
  __Dict_put__ child "cancelIn" cancelIn ,()
  __Dict_put__ child "owned" owned ,()
  Sh_start child (,(c)
    Eval_stmt c elem ,()
    Eval_close owned) ,(vproc)
  __NULL__ vproc child)

;; パイプラインの要素 elem が、先頭の語がクォートか裸文字だけの単純文で、その名前が外部コマンドか。
;; そうなら、要素は外部コマンドを1つだけ起動し、標準入力と標準出力の Stream をそのまま渡せる
(define Pipe_is_external ,(sh elem)
  __Cont_get__ ,(return)
  Node_split elem ,(tag pos children)
  __unless__ (,() __String_equal__ tag "cmd") (,() return __FALSE__) ,()
  Cmd_parts children ,(defs words redirs)
  List_first words ,(word)
  Node_split word ,(wtag wpos parts)
  List_length parts ,(n)
  num "1" ,(one)
  __Number_subtract__ n one ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() return __FALSE__) ,()
  List_first parts ,(part)
  Node_split part ,(ptag ppos texts)
  __String_equal__ ptag "lit" ,(isLit)
  __String_equal__ ptag "sq" ,(isSq)
  __or__ isLit isSq ,(plain)
  __unless__ (,() __NULL__ plain) (,() return __FALSE__) ,()
  List_first texts ,(name)
  Cmd_is_external sh name)

(define Pipe_wait ,(vprocs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ vprocs) return ,()
  __LList_uncons__ __print_exit_error__ vprocs ,(vproc rest)
  __VProc_wait__ __print_exit_error__ vproc ,()
  Pipe_wait rest)

;; パイプとリダイレクトが入出力を取り合う場合を調べる。パイプを先に接続し、リダイレクトを左から順に適用した結果、
;; 最後でない要素の標準出力のパイプに誰も書かなければ、また、最初でない要素が < で標準入力を変えれば、エラーとする
(define Pipe_check ,(sh elems isFirst)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) return ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Node_split elem ,(tag pos children)
  Stmt_redirs tag children ,(redirs)
  Pipe_check_redirs sh redirs isFirst "pipe" "err" ,(out err)
  __String_equal__ out "pipe" ,(outPipe)
  __String_equal__ err "pipe" ,(errPipe)
  __or__ outPipe errPipe ,(used)
  __is_null__ rest ,(isLast)
  __or__ used isLast ,(ok)
  __unless__ (,() __NULL__ ok) (,() Sh_error sh pos "the pipe has no writer") ,()
  Pipe_check sh rest __FALSE__)

;; 標準出力と標準エラー出力の行き先の名前を、リダイレクトに従って変える
(define Pipe_check_redirs ,(sh redirs isFirst out err)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs) (,() return out err) ,()
  __LList_uncons__ __print_exit_error__ redirs ,(redir rest)
  Node_split redir ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(op targets)
  __if__ (,() __String_equal__ op "<")
    (,()
      __unless__ (,() __NULL__ isFirst) (,() Sh_error sh pos "the pipe has no reader") ,()
      Pipe_check_redirs sh rest isFirst out err ,(out err)
      return out err) ,()
  __if__ (,() __String_equal__ op "1>&2")
    (,()
      Pipe_check_redirs sh rest isFirst err err ,(out err)
      return out err) ,()
  __if__ (,() __String_equal__ op "2>&1")
    (,()
      Pipe_check_redirs sh rest isFirst out out ,(out err)
      return out err) ,()
  __if__ (,() __String_equal__ op "2>")
    (,()
      Pipe_check_redirs sh rest isFirst out "file" ,(out err)
      return out err) ,()
  Pipe_check_redirs sh rest isFirst "file" err)

;; 単純文（cmd、if、for）のリダイレクトの LList
(define Stmt_redirs ,(tag children)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ tag "cmd")
    (,()
      Cmd_parts children ,(defs words redirs)
      return redirs) ,()
  __if__ (,() __String_equal__ tag "if")
    (,()
      If_parts children ,(clauses elseBody redirs)
      return redirs) ,()
  List_length children ,(n)
  num "4" ,(four)
  __Number_subtract__ n four ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() return __NULL__) ,()
  List_reverse children ,(reversed)
  List_first reversed ,(redirsNode)
  Node_split redirsNode ,(rtag rpos redirs)
  __NULL__ redirs)

;; ── for 文、break、continue ──

;; for 文を実行する。(for "名前" (in 語 ...) script [redirs])。
;; 語をすべて関数の引数と同じ規則で展開してから、値ごとに本体を実行する。LazyList の値は1階層だけ開き、
;; 要素を1つずつ取り出す。ループ変数は局所変数で、中の変数定義と関数定義は外に反映する。終わった後の $? は 0
(define Eval_for ,(sh pos children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(in rest)
  __LList_uncons__ __print_exit_error__ rest ,(body rest)
  __if_then_else__ (,() __is_null__ rest)
    (,() __NULL__ __NULL__)
    (,()
      List_first rest ,(redirsNode)
      Node_split redirsNode ,(rtag rpos redirs)
      __NULL__ redirs) ,(redirs)
  Node_split in ,(itag ipos words)
  Node_split body ,(btag bpos lines)
  Eval_redirected sh pos redirs (,(inner)
    For_values inner words ,(values)
    For_run inner name values lines ,()
    Sh_set_status inner "0"))

;; for 文の語を展開した値の LList
(define For_values ,(sh words)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  Expand_args sh word ,(values)
  For_values sh rest ,(more)
  List_append values more)

;; break はこの関数から抜ける
(define For_run ,(sh name values lines)
  __Cont_get__ ,(break)
  For_each sh name values lines break)

(define For_each ,(sh name values lines break)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ values) return ,()
  __LList_uncons__ __print_exit_error__ values ,(value rest)
  __type_name__ value ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() For_item sh name value lines break)
    (,() For_lazy sh name value lines break) ,()
  For_each sh name rest lines break)

;; LazyList の要素を1つずつ取り出して回す
(define For_lazy ,(sh name list lines break)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return) list ,(item rest)
  For_item sh name item lines break ,()
  For_lazy sh name rest lines break)

;; 1回分。ループ変数に item を設定して本体を実行する。continue はこの関数から抜ける
(define For_item ,(sh name item lines break)
  __Cont_get__ ,(continue)
  Sh_get sh "vars" ,(vars)
  __Dict_put__ vars name item ,()
  Loop_make name break continue ,(loop)
  Sh_get sh "loops" ,(loops)
  __LList_cons__ loop loops ,(loops)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "loops" loops ,()
  Eval_lines inner lines)

(define Loop_make ,(name brk cont)
  __LList_cons__ cont __NULL__ ,(rest)
  __LList_cons__ brk rest ,(rest)
  __LList_cons__ name rest)

(define Loop_split ,(loop)
  __LList_uncons__ __print_exit_error__ loop ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(brk rest)
  __LList_uncons__ __print_exit_error__ rest ,(cont rest)
  __NULL__ name brk cont)

;; 文「break [名前]」「continue [名前]」。名前があれば、そのループ変数の最も内側のループを、なければ最も内側のループを指す。
;; $? は 0 にする
(define Eval_jump ,(sh pos tag children)
  Sh_get sh "loops" ,(loops)
  __String_concat__ tag " outside a loop" ,(msg)
  __if__ (,() __is_null__ loops) (,() Sh_error sh pos msg) ,()
  List_first children ,(name)
  Loops_find loops name ,(loop)
  __String_concat__ tag ": no loop for " ,(msg)
  __String_concat__ msg name ,(msg)
  __if__ (,() __is_null__ loop) (,() Sh_error sh pos msg) ,()
  Loop_split loop ,(loopName brk cont)
  Sh_set_status sh "0" ,()
  __if_then_else__ (,() __String_equal__ tag "break")
    (,() brk)
    (,() cont))

;; name のループ。name が "" なら最も内側のループ。なければ null
(define Loops_find ,(loops name)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ loops) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ loops ,(loop rest)
  __if__ (,() __String_equal__ name "") (,() return loop) ,()
  Loop_split loop ,(loopName brk cont)
  __if__ (,() __String_equal__ name loopName) (,() return loop) ,()
  Loops_find rest name)

;; ── & ──

;; コマンド列。(list 要素 ...) の要素は、(bg パイプライン) か、パイプライン
(define Eval_list ,(sh elems)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ elems) return ,()
  __LList_uncons__ __print_exit_error__ elems ,(elem rest)
  Node_split elem ,(tag pos children)
  __if_then_else__ (,() __String_equal__ tag "bg")
    (,()
      List_first children ,(pipeline)
      Eval_bg sh pos pipeline)
    (,() Eval_stmt_run sh elem) ,()
  Eval_list sh rest)

;; パイプライン & 。別の VProc で起動して、終わるのを待たない。$! はその VProc（パイプラインなら最後の要素）の番号。
;; 単純文の変数リストへのリダイレクト（f > (a b . rest) &）は、a、b に、値ができるまで待つ遅延の値を、
;; rest に、要素が届くたびに伸びる LazyList を、呼び出し側の局所変数に入れる（Bg_captures）
(define Eval_bg ,(sh pos pipeline)
  Node_split pipeline ,(ptag ppos pchildren)
  Sh_get sh "in" ,(in)
  __if_then_else__ (,() __String_equal__ ptag "pipe")
    (,()
      Pipe_check sh pchildren __TRUE__ ,()
      Pipe_start sh pchildren in __NULL__ __NULL__ __NULL__ ,(vprocs last)
      List_first vprocs ,(vproc)
      __NULL__ vproc last)
    (,()
      Sh_get sh "out" ,(out)
      Sh_get sh "err" ,(err)
      Child_targets out err ,(out err)
      Sh_child sh in out err "return in a background job" ,(child)
      Stmt_redirs ptag pchildren ,(redirs)
      Bg_captures sh redirs ,(specs)
      __Dict_put__ child "bgCaptures" specs ,()
      __Dict_put__ child "bgSpecs" specs ,()
      Sh_start child (,(c) Eval_stmt c pipeline) ,(vproc)
      __NULL__ vproc child) ,(vproc child)
  Job_add sh vproc child ,()
  Sh_set_status sh "0")

;; ── ジョブ ──
;; ジョブは Dict で、"id"（$! の String）、"vproc"、"child"（その VProc の文脈）、"killed"（kill したか）を持つ

(define Job_add ,(sh vproc child)
  __VProc_id__ vproc ,(n)
  __Number_toString__ n ,(id)
  __Dict_new__ ,(job)
  __Dict_put__ job "id" id ,()
  __Dict_put__ job "vproc" vproc ,()
  __Dict_put__ job "child" child ,()
  __Dict_put__ job "killed" __FALSE__ ,()
  Sh_get sh "global" ,(global)
  Sh_get global "jobs" ,(jobs)
  __LList_cons__ job jobs ,(jobs)
  __Dict_put__ global "jobs" jobs ,()
  __Dict_put__ global "lastBg" id)

;; id のジョブ。なければ null
(define Job_find ,(sh id)
  Sh_get sh "global" ,(global)
  Sh_get global "jobs" ,(jobs)
  Job_find_in jobs id)

(define Job_find_in ,(jobs id)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ jobs) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ jobs ,(job rest)
  Sh_get job "id" ,(jobId)
  __if__ (,() __String_equal__ jobId id) (,() return job) ,()
  Job_find_in rest id)

(define Job_remove ,(sh job)
  Sh_get sh "global" ,(global)
  Sh_get global "jobs" ,(jobs)
  Sh_get job "id" ,(id)
  Job_remove_from jobs id ,(jobs)
  __Dict_put__ global "jobs" jobs)

(define Job_remove_from ,(jobs id)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ jobs) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ jobs ,(job rest)
  Job_remove_from rest id ,(rest)
  Sh_get job "id" ,(jobId)
  __if__ (,() __String_equal__ jobId id) (,() return rest) ,()
  __LList_cons__ job rest)

;; ジョブが終わるのを待ち、その終了ステータスを返す。kill したジョブは 143
(define Job_wait ,(job)
  __Cont_get__ ,(return)
  Sh_get job "vproc" ,(vproc)
  __VProc_wait__ __print_exit_error__ vproc ,()
  Sh_get job "killed" ,(killed)
  __if__ (,() __NULL__ killed) (,() return "143") ,()
  Sh_get job "child" ,(child)
  Sh_get child "global" ,(global)
  __Dict_lookup_or__ global "status" __print_exit_error__)

;; スクリプトの終わりに、& で起動したジョブがすべて終わるのを待つ
(define Jobs_wait_all ,(sh)
  __Cont_get__ ,(return)
  Sh_get sh "global" ,(global)
  Sh_get global "jobs" ,(jobs)
  __if__ (,() __is_null__ jobs) return ,()
  __LList_uncons__ __print_exit_error__ jobs ,(job rest)
  __Dict_put__ global "jobs" rest ,()
  Job_wait job ,(status)
  Jobs_wait_all sh)

;; ジョブを止める。VProc を止め、実行中の外部コマンドに SIGTERM を送り、出力の書き手を閉じ、
;; 標準入力のチャネルを cancel し、まだできていない遅延の値を空にする
(define Job_kill ,(job)
  __Dict_put__ job "killed" __TRUE__ ,()
  Sh_get job "vproc" ,(vproc)
  __VProc_kill__ vproc ,()
  Sh_get job "child" ,(child)
  Sh_get child "procRef" ,(procRef)
  __Ref_get__ procRef ,(proc)
  __unless__ (,() __is_null__ proc)
    (,()
      num "15" ,(sigterm)
      __OS_kill__ (,(msg) __nop__) proc sigterm) ,()
  Sh_release child ,()
  __Dict_lookup_or__ child "bgSpecs" (,(key) __NULL__ __NULL__) ,(specs)
  Bg_specs_finish specs)

;; wait [ID ...]: ID がなければ、この VProc から & で起動したすべてのジョブを待ち、$? を 0 にする。
;; ID があれば、順に待ち、$? を最後のジョブの終了ステータスにする。ないジョブ（待った後のものも）は 127
(define Builtin_wait ,(sh pos args in out err)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ args)
    (,()
      Jobs_wait_all sh ,()
      Sh_set_status sh "0" ,()
      return) ,()
  Wait_ids sh pos args)

(define Wait_ids ,(sh pos ids)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ ids) return ,()
  __LList_uncons__ __print_exit_error__ ids ,(id rest)
  Arg_string sh pos "wait" id ,(id)
  Job_find sh id ,(job)
  __if_then_else__ (,() __is_null__ job)
    (,() Sh_set_status sh "127")
    (,()
      Job_remove sh job ,()
      Job_wait job ,(status)
      Sh_set_status sh status) ,()
  Wait_ids sh pos rest)

;; kill ID ...: この VProc から & で起動したジョブを止める。ないジョブがあれば、メッセージを出して $? を 1 にする
(define Builtin_kill ,(sh pos args in out err)
  __if__ (,() __is_null__ args) (,() Sh_error sh pos "kill: a job ID is needed") ,()
  Sh_set_status sh "0" ,()
  Kill_ids sh pos args)

(define Kill_ids ,(sh pos ids)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ ids) return ,()
  __LList_uncons__ __print_exit_error__ ids ,(id rest)
  Arg_string sh pos "kill" id ,(id)
  Job_find sh id ,(job)
  __if_then_else__ (,() __is_null__ job)
    (,()
      __String_concat__ "kill: no such job: " id ,(msg)
      Sh_warn sh pos msg ,()
      Sh_set_status sh "1")
    (,() Job_kill job) ,()
  Kill_ids sh pos rest)

;; ── 遅延の値 ──
;; f > (a b . rest) & の a、b に入れる値。Dict で、"ref" に、値ができたら (値) の LList を入れる。
;; 局所変数から読むとき（Value_force）に、値ができるまで待つ

(define Promise_new ,()
  __Ref_new__ __NULL__ ,(ref)
  __Dict_new__ ,(promise)
  __Dict_put__ promise "ref" ref ,()
  __NULL__ promise)

;; 値を決める。2回目は何もしない
(define Promise_resolve ,(promise value)
  __Cont_get__ ,(return)
  Sh_get promise "ref" ,(ref)
  __Ref_get__ ref ,(cell)
  __unless__ (,() __is_null__ cell) return ,()
  __LList_cons__ value __NULL__ ,(cell)
  __Ref_set__ ref cell)

;; 遅延の値なら、値ができるまで待ってその値を返す。そうでなければ、そのまま返す
(define Value_force ,(value)
  __Cont_get__ ,(return)
  __type_name__ value ,(type)
  __unless__ (,() __String_equal__ type "Dict") (,() return value) ,()
  Sh_get value "ref" ,(ref)
  Promise_wait ref)

(define Promise_wait ,(ref)
  __Cont_get__ ,(return)
  __Ref_get__ ref ,(cell)
  __unless__ (,() __is_null__ cell)
    (,()
      __LList_uncons__ __print_exit_error__ cell ,(value rest)
      return value) ,()
  __Ref_wait_change__ ref __NULL__ ,()
  Promise_wait ref)

;; & の単純文のリダイレクトのうち、> と 2> の変数リストごとに、呼び出し側の局所変数に遅延の値を入れ、
;; 子に渡す記録（spec）の LList を返す。spec は Dict で、"promises"（変数名の順の遅延の値の LList）と
;; "rest"（rest の要素を足していく鎖。rest がなければ null）を持つ
(define Bg_captures ,(sh redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ redirs ,(redir rest)
  Bg_captures sh rest ,(specs)
  Node_split redir ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(op targets)
  __if__ (,() __String_equal__ op "<") (,() return specs) ,()
  __if__ (,() __is_null__ targets) (,() return specs) ,()
  List_first targets ,(target)
  Node_split target ,(ttag tpos params)
  __unless__ (,() __String_equal__ ttag "params") (,() return specs) ,()
  __LList_uncons__ __print_exit_error__ params ,(names restList)
  List_first restList ,(restName)
  Sh_get sh "vars" ,(vars)
  Bg_promises vars names ,(promises)
  __Dict_new__ ,(spec)
  __Dict_put__ spec "promises" promises ,()
  __if_then_else__ (,() __String_equal__ restName "")
    (,() __NULL__ __NULL__)
    (,()
      __Ref_new__ __NULL__ ,(node)
      __Ref_new__ node ,(tail)
      Grow_list node ,(list)
      __Dict_put__ vars restName list ,()
      __NULL__ tail) ,(restTail)
  __Dict_put__ spec "rest" restTail ,()
  __LList_cons__ spec specs)

(define Bg_promises ,(vars names)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Promise_new ,(promise)
  __Dict_put__ vars name promise ,()
  Bg_promises vars rest ,(more)
  __LList_cons__ promise more)

;; 記録が count 個目の要素 item を受け取ったとき。変数の数までなら、その遅延の値を決め、超えたら rest の鎖に足す
(define Bg_spec_add ,(record count item)
  __Cont_get__ ,(return)
  Sh_get record "spec" ,(spec)
  __if__ (,() __is_null__ spec) return ,()
  Sh_get spec "promises" ,(promises)
  Sh_nth promises count (,()
    Sh_get spec "rest" ,(tail)
    __unless__ (,() __is_null__ tail) (,() Grow_append tail item) ,()
    return) ,(promise)
  Promise_resolve promise item)

;; stdin > (a . rest) & の rest：残りの LazyList を鎖の続きにする
(define Bg_spec_splice ,(record list)
  __Cont_get__ ,(return)
  Sh_get record "spec" ,(spec)
  __if__ (,() __is_null__ spec) return ,()
  Sh_get spec "rest" ,(tail)
  __if__ (,() __is_null__ tail) return ,()
  Grow_splice tail list)

;; 文が終わったとき（kill したときも）、まだ決まっていない遅延の値を空文字列にし、rest の鎖を終える
(define Bg_spec_finish ,(spec)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ spec) return ,()
  Sh_get spec "promises" ,(promises)
  Bg_resolve_empty promises ,()
  Sh_get spec "rest" ,(tail)
  __unless__ (,() __is_null__ tail) (,() Grow_close tail))

(define Bg_specs_finish ,(specs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ specs) return ,()
  __LList_uncons__ __print_exit_error__ specs ,(spec rest)
  Bg_spec_finish spec ,()
  Bg_specs_finish rest)

(define Bg_resolve_empty ,(promises)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ promises) return ,()
  __LList_uncons__ __print_exit_error__ promises ,(promise rest)
  Promise_resolve promise "" ,()
  Bg_resolve_empty rest)

;; ── 伸びる LazyList ──
;; 節の Ref の鎖。節の値は、null（まだ）、(要素 . 次の節)、"end"（終わり）、(Dict "list" LazyList)（その LazyList に続く）。
;; tail は、次に書く節を入れた Ref。書くのは & の VProc だけ

(define Grow_list ,(node)
  __LazyList_new__ (,() Grow_next node))

(define Grow_next ,(node)
  __Cont_get__ ,(return)
  __Ref_get__ node ,(value)
  __if__ (,() __is_null__ value)
    (,()
      __Ref_wait_change__ node __NULL__ ,()
      Grow_next node ,(list)
      return list) ,()
  __type_name__ value ,(type)
  __if__ (,() __String_equal__ type "String") (,() __LazyList_empty__ ,(empty) return empty) ,()
  __if__ (,() __String_equal__ type "Dict") (,() Sh_get value "list" ,(list) return list) ,()
  __LList_uncons__ __print_exit_error__ value ,(item next)
  Grow_list next ,(rest)
  __LazyList_cons__ item rest)

(define Grow_append ,(tail item)
  __Cont_get__ ,(return)
  __Ref_get__ tail ,(node)
  __Ref_get__ node ,(value)
  __unless__ (,() __is_null__ value) return ,()
  __Ref_new__ __NULL__ ,(next)
  __LList_cons__ item next ,(cell)
  __Ref_set__ node cell ,()
  __Ref_set__ tail next)

(define Grow_close ,(tail)
  __Cont_get__ ,(return)
  __Ref_get__ tail ,(node)
  __Ref_get__ node ,(value)
  __unless__ (,() __is_null__ value) return ,()
  __Ref_set__ node "end")

(define Grow_splice ,(tail list)
  __Cont_get__ ,(return)
  __Ref_get__ tail ,(node)
  __Ref_get__ node ,(value)
  __unless__ (,() __is_null__ value) return ,()
  __Dict_new__ ,(link)
  __Dict_put__ link "list" list ,()
  __Ref_set__ node link)

;; ── 組み込みコマンド ──
;; どれも ,(sh pos args in out err) を取る

(define Builtin_lookup ,(name)
  __if_then_else__ (,() __String_equal__ name "echo") (,() __NULL__ Builtin_echo) (,()
  __if_then_else__ (,() __String_equal__ name "cd") (,() __NULL__ Builtin_cd) (,()
  __if_then_else__ (,() __String_equal__ name "defined") (,() __NULL__ Builtin_defined) (,()
  __if_then_else__ (,() __String_equal__ name "stdin") (,() __NULL__ Builtin_stdin) (,()
  __if_then_else__ (,() __String_equal__ name "wait") (,() __NULL__ Builtin_wait) (,()
  __if_then_else__ (,() __String_equal__ name "kill") (,() __NULL__ Builtin_kill)
    (,() __NULL__ __NULL__)))))))

;; echo 値 ...: 標準出力に1つの要素を出す。
;; 引数が1つなら、その値（LazyList でも）をそのまま出す。引数がなければ空文字列を出す。
;; 2つ以上なら、各値を文字列化し、スペースで区切って連結する
(define Builtin_echo ,(sh pos args in out err)
  Echo_line sh pos args ,(line)
  Target_write sh pos out line ,()
  Sh_set_status sh "0")

(define Echo_line ,(sh pos args)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ args) (,() return "") ,()
  __LList_uncons__ __print_exit_error__ args ,(first rest)
  __if__ (,() __is_null__ rest) (,() return first) ,()
  Values_strings sh pos args ,(strs)
  List_join strs " ")

;; cd [ディレクトリ]: カレントディレクトリを変える。省略すると環境変数 HOME
(define Builtin_cd ,(sh pos args in out err)
  __Cont_get__ ,(return)
  __if_then_else__ (,() __is_null__ args)
    (,()
      Sh_get sh "env" ,(env)
      Env_lookup env "HOME" (,(key)
        Sh_warn sh pos "cd: HOME is not set" ,()
        Sh_set_status sh "1" ,()
        return))
    (,()
      List_first args ,(dir)
      Arg_string sh pos "cd" dir) ,(dir)
  __OS_chdir__ (,(msg)
    Msg_strip msg ,(msg)
    __String_concat__ "cd: " msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh "1" ,()
    return) dir ,()
  Sh_set_status sh "0")

;; defined [-l] 変数名: 変数が定義済みなら $? を 0、未定義なら 1 にする。-l なら局所変数だけを調べる
(define Builtin_defined ,(sh pos args in out err)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ args) (,() Sh_error sh pos "defined: a variable name is needed") ,()
  __LList_uncons__ __print_exit_error__ args ,(first rest)
  Arg_string sh pos "defined" first ,(first)
  __String_equal__ first "-l" ,(localOnly)
  __if_then_else__ (,() __NULL__ localOnly)
    (,() __NULL__ rest)
    (,() __NULL__ args) ,(names)
  __if__ (,() __is_null__ names) (,() Sh_error sh pos "defined: a variable name is needed") ,()
  __LList_uncons__ __print_exit_error__ names ,(name others)
  __unless__ (,() __is_null__ others) (,() Sh_error sh pos "defined: too many arguments") ,()
  Arg_string sh pos "defined" name ,(name)
  __if__ (,() __NULL__ localOnly)
    (,()
      Sh_get sh "vars" ,(vars)
      __Dict_lookup_or__ vars name (,(key) Sh_set_status sh "1" ,() return) ,(value)
      Sh_set_status sh "0" ,()
      return) ,()
  Sh_defined sh pos name ,(found)
  __if_then_else__ (,() __NULL__ found)
    (,() Sh_set_status sh "0")
    (,() Sh_set_status sh "1"))

;; stdin: 標準入力の要素を標準出力に出す。読み出し位置（Input の "list"）は、出した要素の分だけ進める。
;; 標準出力が変数リスト（stdin > (a . rest)）なら、変数の数だけ進め、rest には残りをそのまま渡す
(define Builtin_stdin ,(sh pos args in out err)
  __unless__ (,() __is_null__ args) (,() Sh_error sh pos "stdin: no arguments are allowed") ,()
  Sh_get in "touched" ,(touched)
  __Ref_set__ touched __TRUE__ ,()
  Sh_get in "list" ,(listRef)
  Target_split out ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "capture")
    (,() Capture_take sh value listRef)
    (,() Stdin_copy sh pos listRef out) ,()
  Sh_set_status sh "0")

(define Stdin_copy ,(sh pos listRef out)
  __Cont_get__ ,(return)
  __Ref_get__ listRef ,(list)
  __LazyList_uncons__ (,() return) list ,(item rest)
  Target_write sh pos out item ,()
  __Ref_set__ listRef rest ,()
  Stdin_copy sh pos listRef out)

;; ── 外部コマンド ──

;; 外部コマンドを起動し、終わるまで待って、$? を設定する。
;; 標準出力か標準エラー出力が sink か chan に行くときは、パイプで受け取って行ごとに書く。
;; 標準入力がパイプ（Input_new）なら、要素を1行ずつ書く VProc（Feed_loop）を起動し、OS のパイプでつなぐ
(define External_run ,(sh pos name args in out err)
  __Cont_get__ ,(return)
  Arg_check sh pos name args ,()
  Sh_get sh "env" ,(env)
  Env_dict env ,(dict)
  __MSeq_new__ ,(command)
  __MSeq_append__ __print_exit_error__ command name ,()
  Eval_append command args ,()
  External_streams sh pos out err ,(outStream errStream reader writer pumpTarget reader2 writer2 pumpTarget2)
  External_input in ,(inStream feed)
  Sh_get sh "owned" ,(owned)
  __OS_spawn__ (,(msg)
    Eval_close_pipe reader writer ,()
    Eval_close_pipe reader2 writer2 ,()
    Feed_cancel feed ,()
    Msg_strip msg ,(msg)
    __String_concat__ name ": " ,(m)
    __String_concat__ m msg ,(m)
    Sh_warn sh pos m ,()
    Eval_close owned ,()
    Sh_set_status sh "127" ,()
    return) command inStream outStream errStream dict ,(proc)
  Eval_close owned ,()
  Sh_get sh "procRef" ,(procRef)
  __Ref_set__ procRef proc ,()
  Feed_start feed ,()
  Pump_start sh reader2 writer2 pumpTarget2 ,(pumper)
  __unless__ (,() __is_null__ reader)
    (,()
      __OS_close__ __print_exit_error__ writer ,()
      External_guard sh reader proc feed (,() Target_pump sh pumpTarget reader) ,()
      __OS_close__ __print_exit_error__ reader) ,()
  __unless__ (,() __is_null__ pumper) (,() __VProc_wait__ __print_exit_error__ pumper) ,()
  __OS_wait__ __print_exit_error__ proc ,(code)
  __Ref_set__ procRef __NULL__ ,()
  Feed_stop feed ,()
  Eval_status code ,(status)
  Sh_set_status sh status)

;; 出力を読みながら body を実行する。その間にチャネルの読み手がいなくなって、この VProc を終えるときは、
;; 先に出力のパイプを閉じ（外部コマンドは次に書いたとき SIGPIPE で止まる）、終わるのを待つ
(define External_guard ,(sh reader proc feed body)
  __Cont_get__ ,(return)
  Sh_get sh "abort" ,(abortRef)
  __if__ (,() __is_null__ abortRef) (,() body ,() return) ,()
  __Ref_get__ abortRef ,(old)
  __Ref_set__ abortRef (,()
    __Ref_set__ abortRef old ,()
    __OS_close__ (,(msg) __nop__) reader ,()
    __OS_wait__ __print_exit_error__ proc ,(code)
    Feed_stop feed ,()
    old) ,()
  body ,()
  __Ref_set__ abortRef old)

;; 外部コマンドに渡す標準入力の Stream と、要素を書く準備（なければ null）。
;; Stream から作った標準入力で、まだ LazyList として読んでいなければ、その Stream をそのまま渡す。
;; そうでなければ、OS のパイプを作り、読む側をコマンドに渡す
(define External_input ,(in)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ in) (,() return __NULL__ __NULL__) ,()
  Sh_get in "stream" ,(stream)
  Sh_get in "touched" ,(touchedRef)
  __Ref_get__ touchedRef ,(touched)
  __unless__ (,() __is_null__ stream)
    (,() __unless__ (,() __NULL__ touched) (,() return stream __NULL__)) ,()
  __OS_pipe__ ,(reader writer)
  __Ref_new__ __FALSE__ ,(stop)
  __Dict_new__ ,(feed)
  __Dict_put__ feed "input" in ,()
  __Dict_put__ feed "reader" reader ,()
  __Dict_put__ feed "writer" writer ,()
  __Dict_put__ feed "stop" stop ,()
  __NULL__ reader feed)

;; コマンドを起動した後、こちらの読む側を閉じ（コマンドが終われば、書くと失敗する）、書く VProc を起動する
(define Feed_start ,(feed)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ feed) return ,()
  Sh_get feed "reader" ,(reader)
  __OS_close__ __print_exit_error__ reader ,()
  __VProc_start__ (,() Feed_loop feed) ,(vproc)
  __nop__)

;; コマンドを起動できなかったとき
(define Feed_cancel ,(feed)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ feed) return ,()
  Sh_get feed "reader" ,(reader)
  Sh_get feed "writer" ,(writer)
  Eval_close_pipe reader writer)

;; コマンドが終わったら、書く VProc に、それ以上要素を取り出さないように知らせる
(define Feed_stop ,(feed)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ feed) return ,()
  Sh_get feed "stop" ,(stop)
  __Ref_set__ stop __TRUE__)

;; 標準入力の要素を1つずつ取り出し、文字列化して改行を付け、パイプに書く。
;; 書き終えた要素の分だけ、標準入力の読み位置を進める。要素がなくなるか、コマンドが終わるか、
;; 書けなくなったら（コマンドがパイプを閉じた）、パイプを閉じて終わる
(define Feed_loop ,(feed)
  __Cont_get__ ,(return)
  Sh_get feed "writer" ,(writer)
  Sh_get feed "stop" ,(stop)
  Sh_get feed "input" ,(input)
  Sh_get input "list" ,(listRef)
  Sh_get input "sh" ,(sh)
  __Ref_get__ listRef ,(list)
  __LazyList_uncons__ (,() Feed_end writer ,() return) list ,(item rest)
  __Ref_get__ stop ,(stopped)
  __if__ (,() __NULL__ stopped) (,() Feed_end writer ,() return) ,()
  Line_toString sh __NULL__ item ,(line)
  __String_concat__ line "\n" ,(s)
  Write_pieces writer s (,() Feed_end writer ,() return) ,()
  __Ref_set__ listRef rest ,()
  Feed_loop feed)

(define Feed_end ,(writer)
  __OS_close__ (,(msg) __nop__) writer)

;; s を 128 文字（UTF-8 で 512 バイト以下）ずつ、書けるようになるのを待ってから書く。
;; ほかの VProc が読むパイプに書いても、インタプリタ全体が止まらない。書けなければ onError を呼ぶ
(define Write_pieces ,(stream s onError)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __if__ (,() __Number_is_zero__ len) return ,()
  num "128" ,(piece)
  __Number_subtract__ len piece ,(over)
  __if_then_else__ (,() __Number_is_negative__ over)
    (,() __NULL__ len)
    (,() __NULL__ piece) ,(n)
  num "0" ,(zero)
  __String_substring__ __print_exit_error__ s zero n ,(head)
  __String_substring__ __print_exit_error__ s n len ,(rest)
  __OS_wait_writable__ (,(msg) onError) stream ,()
  __OS_write__ (,(msg) onError) stream head ,()
  Write_pieces stream rest onError)

;; 外部コマンドに渡す標準出力と標準エラー出力の Stream と、
;; sink か chan に行く出力を受け取るパイプの両端（なければ null）と、その行き先のターゲットを返す。
;; 標準出力と標準エラー出力が別々の sink に行くときは、標準エラー出力の分を2組目に返す（別の VProc で読む）
(define External_streams ,(sh pos out err)
  __Cont_get__ ,(return)
  Target_split out ,(outKind outId outValue)
  Target_split err ,(errKind errId errValue)
  External_os_stream out ,(outValue)
  External_os_stream err ,(errValue)
  __is_null__ outValue ,(outIsSink)
  __is_null__ errValue ,(errIsSink)
  __or__ outIsSink errIsSink ,(anySink)
  __unless__ (,() __NULL__ anySink)
    (,() return outValue errValue __NULL__ __NULL__ __NULL__ __NULL__ __NULL__ __NULL__) ,()
  __OS_pipe__ ,(reader writer)
  __unless__ (,() __NULL__ outIsSink)
    (,() return outValue writer reader writer err __NULL__ __NULL__ __NULL__) ,()
  __unless__ (,() __NULL__ errIsSink)
    (,() return writer errValue reader writer out __NULL__ __NULL__ __NULL__) ,()
  __if__ (,() __String_equal__ outId errId)
    (,() return writer writer reader writer out __NULL__ __NULL__ __NULL__) ,()
  __OS_pipe__ ,(reader2 writer2)
  return writer writer2 reader writer out reader2 writer2 err)

;; ターゲットが外部コマンドにそのまま渡せる Stream なら、その Stream。stream ならその値、top なら OS の標準出力、
;; file ならその "stream"。
;; そうでなければ null
(define External_os_stream ,(target)
  __Cont_get__ ,(return)
  Target_split target ,(kind id value)
  __if__ (,() __String_equal__ kind "stream") (,() return value) ,()
  __if__ (,() __String_equal__ kind "top") (,() __OS_get_stdout__ ,(stream) return stream) ,()
  __if__ (,() __String_equal__ kind "file") (,() Sh_get value "stream" ,(stream) return stream) ,()
  __NULL__ __NULL__)

;; 2組目のパイプ（標準エラー出力）を別の VProc で読み、ターゲットに書く。なければ null を返す。
;; chan のターゲットには、その VProc 用の書き手を作る。読み手がいなくなったら、パイプを閉じて終わる
(define Pump_start ,(sh reader writer target)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ reader) (,() return __NULL__) ,()
  __OS_close__ __print_exit_error__ writer ,()
  Child_target target ,(target)
  __VProc_start__ (,()
    Pump_guarded sh target reader ,()
    __OS_close__ (,(msg) __nop__) reader ,()
    Target_close target))

(define Pump_guarded ,(sh target reader)
  __Cont_get__ ,(done)
  Dict_copy sh ,(inner)
  __Ref_new__ done ,(abortRef)
  __Dict_put__ inner "abort" abortRef ,()
  Target_pump inner target reader)

(define Eval_close_pipe ,(reader writer)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ reader) return ,()
  __OS_close__ (,(msg) __nop__) reader ,()
  __OS_close__ (,(msg) __nop__) writer)

;; __OS_wait__ の終了コードを $? にする。シグナルで止まった場合（負の数）は、シグナル番号 + 128
(define Eval_status ,(code)
  __if_then_else__ (,() __Number_is_negative__ code)
    (,()
      num "128" ,(base)
      __Number_subtract__ base code)
    (,() __NULL__ code) ,(code)
  __Number_toString__ code)

;; 前置の変数定義を dict に加える。同じ文の語の展開に影響しないので、どれも呼び出し側の値で展開する
(define Eval_env_defs ,(sh defs dict)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) return ,()
  __LList_uncons__ __print_exit_error__ defs ,(def rest)
  Node_split def ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name values)
  Eval_env_value sh pos values ,(value)
  __Dict_put__ dict name value ,()
  Eval_env_defs sh rest dict)

;; 語を展開した値の LList。外部コマンドなら葉ごとの String、それ以外なら外部コマンド以外の語の規則で展開する。
;; 外部コマンドなら、葉ごとに引数のバイト数の上限 limit から引く
(define Eval_args ,(sh words isExternal limit)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  __if_then_else__ (,() __NULL__ isExternal)
    (,() Expand_fields_in sh word limit)
    (,() Expand_args sh word) ,(values)
  Eval_args sh rest isExternal limit ,(more)
  List_append values more)

;; ── 引数のバイト数の上限 ──
;; 外部コマンドの引数（コマンド名を含む）の UTF-8 のバイト数に、それぞれの終わりの NUL の 1 を足した合計は、
;; 環境変数 ARG_MAX の値以下でなければならない（局所変数 ARG_MAX は見ない。前置の変数定義の層は見る）。
;; ARG_MAX がなければ、OS の値（ConMa の __OS_sysconf__ "SC_ARG_MAX"）を使う。環境変数は数えない。
;; 関数と組み込みコマンドの引数には適用しない。超えたらエラーにする

;; 上限（Number）
(define Arg_max ,(sh pos)
  __Cont_get__ ,(return)
  Sh_get sh "env" ,(env)
  Env_lookup env "ARG_MAX" (,(key) __NULL__ __NULL__) ,(value)
  __if__ (,() __is_null__ value)
    (,()
      __OS_sysconf__ (,(msg) Sh_error sh pos msg) "SC_ARG_MAX" ,(n)
      return n) ,()
  __String_concat__ "ARG_MAX is not a non-negative integer: " value ,(msg)
  __Number_fromString__ (,(m) Sh_error sh pos msg) value ,(n)
  __Number_floor__ n ,(whole)
  __Number_subtract__ n whole ,(frac)
  __unless__ (,() __Number_is_zero__ frac) (,() Sh_error sh pos msg) ,()
  __if__ (,() __Number_is_negative__ n) (,() Sh_error sh pos msg) ,()
  __NULL__ n)

;; 語の展開の途中で引く、上限の残り（Value_leaves_in）。Dict で、"left"（残り）と "onOver"（超えたときのエラー）
(define Arg_limit_new ,(sh pos)
  Arg_max sh pos ,(max)
  __Dict_new__ ,(limit)
  __Dict_put__ limit "left" max ,()
  Arg_over_message max ,(msg)
  __Dict_put__ limit "onOver" (,() Sh_error sh pos msg) ,()
  __NULL__ limit)

(define Arg_over_message ,(max)
  __Number_toString__ max ,(s)
  __String_concat__ "the arguments of an external command exceed ARG_MAX (" s ,(msg)
  __String_concat__ msg " bytes)")

;; 外部コマンドを起動する前に、コマンド名と引数の正確なバイト数を調べる。
;; 文字数の 4 倍（UTF-8 の1文字は 4 バイト以下）でも上限以下なら、バイト数は数えない
(define Arg_check ,(sh pos name args)
  __Cont_get__ ,(return)
  Arg_max sh pos ,(max)
  __LList_cons__ name args ,(all)
  num "0" ,(zero)
  Arg_chars all zero ,(chars)
  num "4" ,(four)
  __Number_multiply__ chars four ,(upper)
  __Number_subtract__ max upper ,(room)
  __unless__ (,() __Number_is_negative__ room) return ,()
  Arg_bytes all zero ,(bytes)
  __Number_subtract__ max bytes ,(room)
  __unless__ (,() __Number_is_negative__ room) return ,()
  Arg_over_message max ,(msg)
  Sh_error sh pos msg)

;; 各 String の文字数 + 1 の合計
(define Arg_chars ,(list total)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return total) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  __String_length__ s ,(n)
  num "1" ,(one)
  __Number_add__ total n ,(total)
  __Number_add__ total one ,(total)
  Arg_chars rest total)

;; 各 String の UTF-8 のバイト数 + 1 の合計
(define Arg_bytes ,(list total)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return total) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  num "0" ,(zero)
  __String_length__ s ,(len)
  Utf8_bytes s zero len total ,(total)
  num "1" ,(one)
  __Number_add__ total one ,(total)
  Arg_bytes rest total)

;; s の i 文字目から len 文字目の前までの UTF-8 のバイト数を total に足す
(define Utf8_bytes ,(s i len total)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return total) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ s i next ,(ch)
  __String_toCode__ __print_exit_error__ ch ,(code)
  Utf8_char_bytes code ,(n)
  __Number_add__ total n ,(total)
  Utf8_bytes s next len total)

(define Utf8_char_bytes ,(code)
  __Cont_get__ ,(return)
  num "128" ,(b1)
  __Number_subtract__ code b1 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "1" ,(n) return n) ,()
  num "2048" ,(b2)
  __Number_subtract__ code b2 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "2" ,(n) return n) ,()
  num "65536" ,(b3)
  __Number_subtract__ code b3 ,(d)
  __if__ (,() __Number_is_negative__ d) (,() num "3" ,(n) return n) ,()
  num "4")

(define Eval_append ,(mseq list)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) return ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  __MSeq_append__ __print_exit_error__ mseq head ,()
  Eval_append mseq tail)

(define Eval_close ,(streams)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ streams) return ,()
  __LList_uncons__ __print_exit_error__ streams ,(stream rest)
  __OS_close__ (,(msg) __nop__) stream ,()
  Eval_close rest)

;; ── リダイレクト ──

;; リダイレクトを左から順に適用し、標準入力、標準出力と標準エラー出力のターゲット、開いた Stream の LList、
;; 成功したか、変数リストへのリダイレクトの組（Capture_group、なければ null）を返す。
;; ファイルを開けなければ、メッセージを出して失敗とする
(define Eval_redirs ,(sh redirs)
  __Dict_new__ ,(used)
  Sh_get sh "in" ,(in)
  Sh_get sh "out" ,(out)
  Sh_get sh "err" ,(err)
  Eval_redirs_from sh redirs used in out err __NULL__ __NULL__)

(define Eval_redirs_from ,(sh redirs used in out err opened group)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs) (,() return in out err opened __TRUE__ group) ,()
  __LList_uncons__ __print_exit_error__ redirs ,(redir rest)
  Node_split redir ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(op targets)
  Redir_fd op ,(fd)
  __Dict_lookup_or__ used fd (,(key) __NULL__ __FALSE__) ,(dup)
  __if__ (,() __NULL__ dup) (,() Sh_error sh pos "duplicate redirection") ,()
  __Dict_put__ used fd __TRUE__ ,()
  __if__ (,() __String_equal__ op "1>&2")
    (,()
      Eval_redirs_from sh rest used in err err opened group ,(in out err opened ok group)
      return in out err opened ok group) ,()
  __if__ (,() __String_equal__ op "2>&1")
    (,()
      Eval_redirs_from sh rest used in out out opened group ,(in out err opened ok group)
      return in out err opened ok group) ,()
  __LList_uncons__ __print_exit_error__ targets ,(target others)
  Node_split target ,(targetTag targetPos targetChildren)
  __if__ (,() __String_equal__ targetTag "params")
    (,()
      __if__ (,() __String_equal__ fd "0")
        (,()
          Input_vars sh pos targetChildren ,(input)
          Eval_redirs_from sh rest used input out err opened group ,(in out err opened ok group)
          return in out err opened ok group) ,()
      Capture_new sh group targetChildren ,(target group)
      __if_then_else__ (,() __String_equal__ fd "1")
        (,() Eval_redirs_from sh rest used in target err opened group)
        (,() Eval_redirs_from sh rest used in out target opened group) ,(in out err opened ok group)
      return in out err opened ok group) ,()
  Expand_fields sh target ,(fields)
  List_length fields ,(n)
  num "1" ,(one)
  __Number_subtract__ n one ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() Sh_error sh pos "ambiguous redirect") ,()
  __LList_uncons__ __print_exit_error__ fields ,(path others)
  Redir_mode op ,(mode)
  __OS_open__ (,(msg)
    Msg_strip msg ,(msg)
    __String_concat__ path ": " ,(m)
    __String_concat__ m msg ,(m)
    Sh_warn sh pos m ,()
    return in out err opened __FALSE__ group) path mode ,(stream)
  __LList_cons__ stream opened ,(opened)
  __if_then_else__ (,() __String_equal__ fd "0")
    (,()
      Input_stream sh stream ,(input)
      Eval_redirs_from sh rest used input out err opened group) (,()
  Sh_get sh "global" ,(global)
  Target_stream global stream ,(target)
  __if_then_else__ (,() __String_equal__ fd "1")
    (,() Eval_redirs_from sh rest used in target err opened group)
    (,() Eval_redirs_from sh rest used in out target opened group)))

;; リダイレクトが変える入出力の番号
(define Redir_fd ,(op)
  __if_then_else__ (,() __String_equal__ op "<") (,() __NULL__ "0") (,()
  __String_equal__ op "2>" ,(e1)
  __String_equal__ op "2>&1" ,(e2)
  __or__ e1 e2 ,(isErr)
  __if_then_else__ (,() __NULL__ isErr) (,() __NULL__ "2") (,() __NULL__ "1")))

(define Redir_mode ,(op)
  __if_then_else__ (,() __String_equal__ op "<") (,() __NULL__ "r") (,()
  __if_then_else__ (,() __String_equal__ op ">>") (,() __NULL__ "a") (,() __NULL__ "w")))
