;; ConSh の実行（段階 3）。
;;   変数定義、export、外部コマンドの起動、ファイルへのリダイレクト、$?
;;   関数の定義と呼び出し、return、組み込みコマンド echo、cd、defined、builtin、command、if 文、
;;   for 文、break、continue
;;   関数と組み込みコマンドには、引数を値（String か LazyList）のまま渡す
;;   コマンド置換 $( )
;; パイプ、&、変数リストへのリダイレクトは、まだない（実行するとエラー）。
;;
;; 文を実行する文脈 sh は Dict で、次のキーを持つ。
;;   "global"     シェル全体で共有する Dict。"status" に最後の文の終了ステータスの String（$?）
;;   "script"     スクリプトのファイル名（$0、エラーメッセージ）
;;   "args"       スクリプトの引数の LList（$@、$1、$#）
;;   "vars"       局所変数の Dict。値は String か LazyList
;;   "funcs"      このスコープで定義した関数の Dict（名前 → 関数）
;;   "parent"     レキシカルに外側の文脈（関数名を探す）。トップレベルでは null
;;   "inFunction" 関数の中か（__TRUE__ / __FALSE__）
;;   "return"     return で使う継続。関数の外では null
;;   "inSubst"    コマンド置換の中か（関数を呼ぶと __FALSE__ に戻る）。なければ __FALSE__ とみなす
;;   "loops"      実行中の for 文の LList（内側が先）。各要素は (ループ変数の名前 break の継続 continue の継続)。
;;                関数の中では、関数の外のループは見えない
;;   "env"        環境変数（Env_new）
;;   "in"         外部コマンドの標準入力の Stream。null なら親のまま
;;   "out" "err"  標準出力と標準エラー出力のターゲット（Target_*）
;;
;; 変数定義は新しい束縛と見る。関数は、定義した時点の局所変数の写しを持つので、
;; 後で変数を変えても関数からは見えない。関数名は、スコープごとの Dict を外側へたどって探すので、
;; 後で定義した関数も呼べる。
(include "consh_util.se")
(include "consh_ast.se")
(include "consh_expand.se")

;; ── 文脈 ──

(define Ctx_top ,(script args)
  __Dict_new__ ,(global)
  __Dict_put__ global "status" "0" ,()
  num "0" ,(zero)
  __Dict_put__ global "sinks" zero ,()
  __OS_get_envDict__ ,(base)
  Env_new base __NULL__ ,(env)
  __OS_get_stderr__ ,(errStream)
  Target_stream global errStream ,(err)
  __Dict_new__ ,(vars)
  __Dict_new__ ,(funcs)
  __Dict_new__ ,(sh)
  __Dict_put__ sh "global" global ,()
  __Dict_put__ sh "script" script ,()
  __Dict_put__ sh "args" args ,()
  __Dict_put__ sh "vars" vars ,()
  __Dict_put__ sh "funcs" funcs ,()
  __Dict_put__ sh "parent" __NULL__ ,()
  __Dict_put__ sh "inFunction" __FALSE__ ,()
  __Dict_put__ sh "return" __NULL__ ,()
  __Dict_put__ sh "loops" __NULL__ ,()
  __Dict_put__ sh "env" env ,()
  __Dict_put__ sh "in" __NULL__ ,()
  Target_sink global (,(line) Top_write sh line) ,(out)
  __Dict_put__ sh "out" out ,()
  __Dict_put__ sh "err" err ,()
  __NULL__ sh)

;; トップレベルの標準出力。要素を1行として書く。LazyList の要素は、トップレベルの OFS で文字列化する
(define Top_write ,(sh line)
  Line_toString sh __NULL__ line ,(line)
  stdout line "\n" ,(out)
  __nop__)

(define Sh_get ,(sh key)
  __Dict_lookup_or__ sh key __print_exit_error__)

(define Sh_status ,(sh)
  Sh_get sh "global" ,(global)
  __Dict_lookup_or__ global "status" __print_exit_error__)

(define Sh_set_status ,(sh status)
  Sh_get sh "global" ,(global)
  __Dict_put__ global "status" status)

;; 「consh: スクリプト:行:桁: msg」の1行。pos が null なら「consh: スクリプト: msg」
(define Sh_message ,(sh pos msg)
  __Cont_get__ ,(return)
  Sh_get sh "script" ,(script)
  __if__ (,() __is_null__ pos)
    (,()
      __String_concat__ "consh: " script ,(s)
      __String_concat__ s ": " ,(s)
      __String_concat__ s msg ,(s)
      __String_concat__ s "\n" ,(s)
      return s) ,()
  Pos_split pos ,(line col)
  __Number_toString__ line ,(line)
  __Number_toString__ col ,(col)
  __String_concat__ "consh: " script ,(s)
  __String_concat__ s ":" ,(s)
  __String_concat__ s line ,(s)
  __String_concat__ s ":" ,(s)
  __String_concat__ s col ,(s)
  __String_concat__ s ": " ,(s)
  __String_concat__ s msg ,(s)
  __String_concat__ s "\n")

;; 仕様でエラーとするもの。メッセージを出して、終了ステータス 1 で終わる
(define Sh_error ,(sh pos msg)
  Sh_message sh pos msg ,(s)
  __print_exit_error__ s)

;; 続けられるエラー（ファイルを開けない、コマンドを起動できない）。メッセージを出して続ける
(define Sh_warn ,(sh pos msg)
  Sh_message sh pos msg ,(s)
  __OS_print_error__ s)

;; スクリプトの引数の LList。関数の中では $1、$@、$# は未定義なのでエラー
(define Sh_args ,(sh pos)
  Sh_get sh "inFunction" ,(inFunction)
  __if__ (,() __NULL__ inFunction)
    (,() Sh_error sh pos "$1, $@ and $# are not defined in a function") ,()
  Sh_get sh "args")

;; 変数参照の値。String か LazyList。局所変数がなければ環境変数を探す。
;; 未定義の変数と、足りない位置パラメータはエラーとする
(define Sh_lookup ,(sh pos name)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ name "@")
    (,()
      Sh_args sh pos ,(args)
      LazyList_fromList args ,(list)
      return list) ,()
  __if__ (,() String_is_digits name)
    (,()
      num name ,(n)
      __if__ (,() __Number_is_zero__ n) (,() Sh_get sh "script" ,(script) return script) ,()
      Sh_args sh pos ,(args)
      Sh_nth args n (,()
        __String_concat__ "missing positional parameter: $" name ,(msg)
        Sh_error sh pos msg) ,(arg)
      return arg) ,()
  __if__ (,() __String_equal__ name "#")
    (,()
      Sh_args sh pos ,(args)
      List_length args ,(n)
      __Number_toString__ n ,(s)
      return s) ,()
  __if__ (,() __String_equal__ name "?") (,() Sh_status sh ,(status) return status) ,()
  __if__ (,() __String_equal__ name "!") (,() return "") ,()
  __if__ (,() __String_equal__ name "$") (,() Sh_error sh pos "$$ is not implemented yet") ,()
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars name (,(key)
    Env_lookup env key (,(key)
      __String_concat__ "undefined variable: " key ,(msg)
      Sh_error sh pos msg)))

;; 変数が定義済みか。位置パラメータは引数の数で決まる。特殊な変数は常に定義済み
(define Sh_defined ,(sh pos name)
  __Cont_get__ ,(return)
  __if__ (,() String_is_digits name)
    (,()
      num name ,(n)
      __if__ (,() __Number_is_zero__ n) (,() return __TRUE__) ,()
      Sh_args sh pos ,(args)
      List_length args ,(len)
      __Number_subtract__ len n ,(room)
      __if__ (,() __Number_is_negative__ room) (,() return __FALSE__) ,()
      return __TRUE__) ,()
  __String_equal__ name "@" ,(s1)
  __String_equal__ name "#" ,(s2)
  __String_equal__ name "?" ,(s3)
  __String_equal__ name "!" ,(s4)
  __String_equal__ name "$" ,(s5)
  __or__ s1 s2 ,(s)
  __or__ s s3 ,(s)
  __or__ s s4 ,(s)
  __or__ s s5 ,(s)
  __if__ (,() __NULL__ s) (,() return __TRUE__) ,()
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars name (,(key)
    Env_lookup env key (,(key) return __FALSE__)) ,(value)
  __NULL__ __TRUE__)

;; LList の n 番目（1 から）。足りなければ onMissing を呼ぶ
(define Sh_nth ,(list n onMissing)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) onMissing ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  __if__ (,() __Number_is_zero__ n) (,() return head) ,()
  Sh_nth tail n onMissing)

;; 文字列化の区切り。局所変数、環境変数の順に OFS を探し、どちらにもなければスペース
(define Sh_ofs ,(sh pos)
  __Cont_get__ ,(return)
  Sh_get sh "vars" ,(vars)
  Sh_get sh "env" ,(env)
  __Dict_lookup_or__ vars "OFS" (,(key)
    Env_lookup env key (,(key) return " ")) ,(ofs)
  __type_name__ ofs ,(type)
  __unless__ (,() __String_equal__ type "String") (,() Sh_error sh pos "OFS is a LazyList") ,()
  __NULL__ ofs)

;; ── 環境変数 ──
;; シェル全体の環境変数 base と、前置の変数定義の層 layers（内側が先の、Dict の LList）。
;; 参照は内側の層から順に探し、なければ base を探す

(define Env_new ,(base layers)
  __Dict_new__ ,(env)
  __Dict_put__ env "base" base ,()
  __Dict_put__ env "layers" layers ,()
  __NULL__ env)

;; layer を一番内側に加えた環境変数
(define Env_push ,(env layer)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  __LList_cons__ layer layers ,(layers)
  Env_new base layers)

(define Env_lookup ,(env name onMissing)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  Env_lookup_layers layers name (,(key) __Dict_lookup_or__ base key onMissing))

(define Env_lookup_layers ,(layers name onMissing)
  __if_then_else__ (,() __is_null__ layers)
    (,() onMissing name)
    (,()
      __LList_uncons__ __print_exit_error__ layers ,(layer rest)
      __Dict_lookup_or__ layer name (,(key) Env_lookup_layers rest key onMissing)))

;; export。シェル全体の環境変数と、name を持つすべての層の値を変える
(define Env_export ,(env name value)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  __Dict_put__ base name value ,()
  Env_export_layers layers name value)

(define Env_export_layers ,(layers name value)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) return ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  __Dict_lookup_or__ layer name (,(key) __NULL__ __NULL__) ,(found)
  __unless__ (,() __is_null__ found) (,() __Dict_put__ layer name value) ,()
  Env_export_layers rest name value)

;; 環境変数の写し。export しても元の環境変数は変わらない
(define Env_copy ,(env)
  Sh_get env "base" ,(base)
  Dict_copy base ,(base)
  Sh_get env "layers" ,(layers)
  Env_copy_layers layers ,(layers)
  Env_new base layers)

(define Env_copy_layers ,(layers)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  Dict_copy layer ,(layer)
  Env_copy_layers rest ,(rest)
  __LList_cons__ layer rest)

;; 外部コマンドに渡す Dict。base に、外側の層から順に重ねる
(define Env_dict ,(env)
  Sh_get env "base" ,(base)
  Sh_get env "layers" ,(layers)
  Dict_copy base ,(dict)
  List_reverse layers ,(layers)
  Env_dict_layers dict layers ,()
  __NULL__ dict)

(define Env_dict_layers ,(dict layers)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ layers) return ,()
  __LList_uncons__ __print_exit_error__ layers ,(layer rest)
  Dict_copy_into layer dict ,()
  Env_dict_layers dict rest)

;; ── 出力のターゲット ──
;; 標準出力と標準エラー出力の行き先は、次のどちらか。
;;   (stream id Stream)  バイト列をそのまま書く Stream。要素は、末尾に改行を付けて書く
;;   (sink id write)     要素を1つずつ受け取る関数 write（,(line) ...）
;; id はターゲットを見分ける String で、2>&1 や 1>&2 で写したターゲットは同じ id を持つ。
;; 外部コマンドの出力が sink に行くときは、パイプで受け取って行ごとの要素にする（行の改行は除く）

(define Target_stream ,(global stream)
  Target_new_id global ,(id)
  Target_make "stream" id stream)

(define Target_sink ,(global write)
  Target_new_id global ,(id)
  Target_make "sink" id write)

(define Target_make ,(kind id value)
  __LList_cons__ value __NULL__ ,(rest)
  __LList_cons__ id rest ,(rest)
  __LList_cons__ kind rest)

(define Target_new_id ,(global)
  __Dict_lookup_or__ global "sinks" __print_exit_error__ ,(n)
  num "1" ,(one)
  __Number_add__ n one ,(n)
  __Dict_put__ global "sinks" n ,()
  __Number_toString__ n)

;; ターゲットの種類、id、値（Stream か write）
(define Target_split ,(target)
  __LList_uncons__ __print_exit_error__ target ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(id rest)
  __LList_uncons__ __print_exit_error__ rest ,(value rest)
  __NULL__ kind id value)

;; stream ターゲットを、同じ id の sink ターゲットにする。要素は、末尾に改行を付けて Stream に書く。
;; 関数の出力をファイルに向けると、関数の中の外部コマンドの出力も行ごとの要素になる（Func_targets）。
;; LazyList の要素は、リダイレクトを書いた文の文脈 sh の OFS で文字列化する
(define Target_as_sink ,(sh pos target)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "sink")
    (,() __NULL__ target)
    (,()
      Stream_writer sh pos value ,(write)
      Target_make "sink" id write))

(define Stream_writer ,(sh pos stream)
  __NULL__ (,(line)
    Line_toString sh pos line ,(line)
    __String_concat__ line "\n" ,(s)
    __OS_write__ __print_exit_error__ stream s))

;; 要素 line をターゲットに書く。stream に書くとき、LazyList の要素は sh の OFS で文字列化する
(define Target_write ,(sh pos target line)
  Target_split target ,(kind id value)
  __if_then_else__ (,() __String_equal__ kind "stream")
    (,()
      Line_toString sh pos line ,(line)
      __String_concat__ line "\n" ,(s)
      __OS_write__ __print_exit_error__ value s)
    (,() value line))

;; 出力の要素を1行の String にする。LazyList は OFS で文字列化する
(define Line_toString ,(sh pos line)
  __type_name__ line ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() __NULL__ line)
    (,() Value_toString sh pos line))

;; input Stream を EOF まで読み、行ごとにターゲットに書く
(define Target_pump ,(target stream)
  __LazyList_lines__ stream ,(lines)
  Target_pump_lines target lines)

(define Target_pump_lines ,(target lines)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return) lines ,(line rest)
  Line_chomp line ,(line)
  Target_write __NULL__ __NULL__ target line ,()
  Target_pump_lines target rest)

;; 行末の改行（\n または \r\n）を除く
(define Line_chomp ,(line)
  Ast_chomp line ,(line)
  __String_length__ line ,(len)
  num "1" ,(one)
  __Number_subtract__ len one ,(last)
  __if_then_else__ (,() __Number_is_negative__ last)
    (,() __NULL__ line)
    (,()
      __String_substring__ __print_exit_error__ line last len ,(ch)
      __if_then_else__ (,() __String_equal__ ch "\r")
        (,()
          num "0" ,(zero)
          __String_substring__ __print_exit_error__ line zero last)
        (,() __NULL__ line)))

;; ── 文 ──

;; スクリプトを実行し、最後の文の終了ステータスで終わる
(define Eval_run ,(script args lines)
  Ctx_top script args ,(sh)
  Eval_lines sh lines ,()
  Sh_status sh ,(status)
  num status ,(code)
  __OS_exit__ __print_exit_error__ code)

(define Eval_lines ,(sh lines)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ lines) return ,()
  __LList_uncons__ __print_exit_error__ lines ,(line rest)
  Node_split line ,(tag pos stmts)
  Eval_stmts sh stmts ,()
  Eval_lines sh rest)

(define Eval_stmts ,(sh stmts)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ stmts) return ,()
  __LList_uncons__ __print_exit_error__ stmts ,(stmt rest)
  Eval_stmt sh stmt ,()
  Eval_stmts sh rest)

(define Eval_stmt ,(sh stmt)
  Node_split stmt ,(tag pos children)
  __if_then_else__ (,() __String_equal__ tag "cmd")
    (,() Eval_cmd sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "if")
    (,() Eval_if sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "for")
    (,() Eval_for sh pos children) (,()
  __String_equal__ tag "break" ,(isBreak)
  __String_equal__ tag "continue" ,(isContinue)
  __or__ isBreak isContinue ,(isJump)
  __if_then_else__ (,() __NULL__ isJump)
    (,() Eval_jump sh pos tag children) (,()
  __if_then_else__ (,() __String_equal__ tag "assign")
    (,()
      Eval_assign sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "export")
    (,()
      Eval_export sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "function")
    (,()
      Func_define sh children ,()
      Sh_set_status sh "0") (,()
  __if_then_else__ (,() __String_equal__ tag "return")
    (,() Eval_return sh pos children) (,()
  __if_then_else__ (,() __String_equal__ tag "pipe")
    (,() Sh_error sh pos "pipelines are not implemented yet")
    (,() Sh_error sh pos "& is not implemented yet"))))))))))

;; 文「変数定義 {スペース+ 変数定義}」。左から順に局所変数に設定する。右辺がなければ空文字列
(define Eval_assign ,(sh defs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) return ,()
  __LList_uncons__ __print_exit_error__ defs ,(def rest)
  Node_split def ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name values)
  Expand_def_value sh values ,(value)
  Sh_get sh "vars" ,(vars)
  __Dict_put__ vars name value ,()
  Eval_assign sh rest)

;; 文「export 項目 ...」。環境変数に設定し、局所変数は変えない
(define Eval_export ,(sh items)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ items) return ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  Node_split item ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name words)
  __if_then_else__ (,() __String_equal__ tag "name")
    (,()
      Sh_get sh "vars" ,(vars)
      __String_concat__ "export of an undefined local variable: " name ,(msg)
      __Dict_lookup_or__ vars name (,(key) Sh_error sh pos msg) ,(value)
      Value_toString sh pos value)
    (,() Eval_env_value sh pos words) ,(value)
  Sh_get sh "env" ,(env)
  Env_export env name value ,()
  Eval_export sh rest)

;; 環境変数に設定する値。右辺がなければ空文字列。LazyList は1つの String にする
(define Eval_env_value ,(sh pos values)
  Expand_def_value sh values ,(value)
  Value_toString sh pos value)

;; 文「return 語」。語は 0 から 255 の数。関数の残りを実行せずに戻る
(define Eval_return ,(sh pos children)
  Sh_get sh "return" ,(ret)
  __Dict_lookup_or__ sh "inSubst" (,(key) __NULL__ __FALSE__) ,(inSubst)
  __if__ (,() __NULL__ inSubst) (,() Sh_error sh pos "return in a command substitution") ,()
  __if__ (,() __is_null__ ret) (,() Sh_error sh pos "return outside a function") ,()
  __LList_uncons__ __print_exit_error__ children ,(word others)
  Expand_fields sh word ,(fields)
  Return_value fields ,(value)
  __if__ (,() __is_null__ value) (,() Sh_error sh pos "return needs a number from 0 to 255") ,()
  Sh_set_status sh value ,()
  ret)

;; 1語の 0 から 255 の数なら、その String。そうでなければ null
(define Return_value ,(fields)
  __Cont_get__ ,(return)
  List_length fields ,(n)
  num "1" ,(one)
  __Number_subtract__ n one ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ fields ,(word others)
  __unless__ (,() String_is_digits word) (,() return __NULL__) ,()
  num word ,(value)
  num "255" ,(max)
  __Number_subtract__ max value ,(room)
  __if__ (,() __Number_is_negative__ room) (,() return __NULL__) ,()
  __Number_toString__ value)

;; ── 関数 ──
;; 関数は Dict で、"params"（params の節）、"body"（script の節）、
;; "scope"（定義した文脈）、"vars"（定義した時点の局所変数の写し）を持つ

;; 文「function 名前 変数リスト { スクリプト }」。このスコープの関数の Dict に置く
(define Func_define ,(sh children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(params rest)
  __LList_uncons__ __print_exit_error__ rest ,(body rest)
  Sh_get sh "vars" ,(vars)
  Dict_copy vars ,(vars)
  __Dict_new__ ,(fn)
  __Dict_put__ fn "params" params ,()
  __Dict_put__ fn "body" body ,()
  __Dict_put__ fn "scope" sh ,()
  __Dict_put__ fn "vars" vars ,()
  Sh_get sh "funcs" ,(funcs)
  __Dict_put__ funcs name fn)

;; name の関数。レキシカルに外側へ向かって、最も近いスコープの関数を探す。なければ null
(define Func_lookup ,(sh name)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ sh) (,() return __NULL__) ,()
  Sh_get sh "funcs" ,(funcs)
  __Dict_lookup_or__ funcs name (,(key) __NULL__ __NULL__) ,(fn)
  __unless__ (,() __is_null__ fn) (,() return fn) ,()
  Sh_get sh "parent" ,(parent)
  Func_lookup parent name)

;; 関数を呼び出す。引数（String か LazyList）を変数リストに渡し、本体を新しいスコープで実行する。
;; 前置の変数定義の層は、sh の環境変数に積んである（Cmd_scope）
(define Func_call ,(sh pos fn args in out err)
  __Cont_get__ ,(return)
  Sh_get fn "params" ,(params)
  Sh_get fn "body" ,(body)
  Sh_get fn "scope" ,(scope)
  Sh_get fn "vars" ,(vars)
  Dict_copy vars ,(vars)
  Node_split params ,(ptag ppos pchildren)
  __LList_uncons__ __print_exit_error__ pchildren ,(names rest)
  List_first rest ,(restName)
  Func_bind vars names restName args ,()
  Sh_get sh "env" ,(env)
  __Dict_new__ ,(funcs)
  Dict_copy sh ,(callee)
  __Dict_put__ callee "vars" vars ,()
  __Dict_put__ callee "funcs" funcs ,()
  __Dict_put__ callee "parent" scope ,()
  __Dict_put__ callee "inFunction" __TRUE__ ,()
  __Dict_put__ callee "return" return ,()
  __Dict_put__ callee "loops" __NULL__ ,()
  __Dict_put__ callee "inSubst" __FALSE__ ,()
  __Dict_put__ callee "env" env ,()
  __Dict_put__ callee "in" in ,()
  __Dict_put__ callee "out" out ,()
  __Dict_put__ callee "err" err ,()
  Node_split body ,(btag bpos lines)
  Sh_set_status sh "0" ,()
  Eval_lines callee lines)

;; 引数を順に名前に渡す。足りなければ空文字列。残りは LazyList にして restName に渡す（restName が "" なら捨てる）
(define Func_bind ,(vars names restName args)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names)
    (,()
      __unless__ (,() __String_equal__ restName "")
        (,()
          LazyList_fromList args ,(list)
          __Dict_put__ vars restName list) ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ names ,(name others)
  List_first args ,(arg)
  __Dict_put__ vars name arg ,()
  __if_then_else__ (,() __is_null__ args)
    (,() __NULL__ __NULL__)
    (,() __LList_uncons__ __print_exit_error__ args ,(head tail) __NULL__ tail) ,(args)
  Func_bind vars others restName args)

;; 関数に渡す標準出力と標準エラー出力のターゲット。標準出力は sink にする。
;; 標準エラー出力は、標準出力と同じ行き先（2>&1）なら同じ sink にし、そうでなければそのまま
(define Func_targets ,(sh pos out err)
  Target_split out ,(outKind outId outValue)
  Target_split err ,(errKind errId errValue)
  Target_as_sink sh pos out ,(out)
  __if_then_else__ (,() __String_equal__ outId errId)
    (,() __NULL__ out)
    (,() __NULL__ err) ,(err)
  __NULL__ out err)

;; ── 単純文 ──

;; (cmd [env] words [redirs]) の子を、前置の変数定義、語、リダイレクトの LList に分ける
(define Cmd_parts ,(children)
  Cmd_parts_from children __NULL__ __NULL__ __NULL__)

(define Cmd_parts_from ,(children defs words redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return defs words redirs) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "env")
    (,() Cmd_parts_from rest items words redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "words")
    (,() Cmd_parts_from rest defs items redirs)
    (,() Cmd_parts_from rest defs words items)))

;; 単純文を実行する。前置の変数定義は、同じ文の語の展開に反映する。
;; 先頭の語を先に展開してコマンドを決め、残りの語は、外部コマンドなら葉ごとの String に、
;; 関数と組み込みコマンドなら外部コマンド以外の語の規則で、値（String か LazyList）に展開する
(define Eval_cmd ,(sh pos children)
  __Cont_get__ ,(return)
  Cmd_parts children ,(defs words redirs)
  Cmd_scope sh defs ,(sh)
  Cmd_head sh words ,(name more rest)
  __if_then_else__ (,() __is_null__ name)
    (,() __NULL__ __TRUE__)
    (,() Cmd_is_external sh name) ,(isExternal)
  Eval_args sh rest isExternal ,(args)
  __if_then_else__ (,() __NULL__ isExternal)
    (,() Values_leaves more)
    (,() __NULL__ more) ,(more)
  List_append more args ,(args)
  Eval_redirs sh redirs ,(in out err opened ok)
  __unless__ (,() __NULL__ ok)
    (,()
      Eval_close opened ,()
      Sh_set_status sh "1" ,()
      return) ,()
  __if__ (,() __is_null__ name)
    (,()
      Eval_close opened ,()
      Sh_set_status sh "0" ,()
      return) ,()
  Cmd_run sh pos name args in out err ,()
  Eval_close opened)

;; 前置の変数定義があれば、その層を環境変数に積んだ文脈を返す。
;; 前置の変数定義どうしは影響しないので、どれも sh で展開する
(define Cmd_scope ,(sh defs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) (,() return sh) ,()
  __Dict_new__ ,(layer)
  Eval_env_defs sh defs layer ,()
  Sh_get sh "env" ,(env)
  Env_push env layer ,(env)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "env" env ,()
  __NULL__ inner)

;; 先頭の語を展開して、コマンドの名前と、先頭の語から出た残りの値の LList と、残りの語を返す。
;; ${x} と $(cmd) の LazyList なら、要素を順に値にする。先頭の要素だけは再帰的に展開して名前を取る（Value_head）。
;; そうでなければ、外部コマンドの語として展開し、最初の語が名前になる。
;; LazyList を含む語が空になればエラー。LazyList を含まない語が消えれば、次の語を見る。
;; 語がすべて消えたら、名前は null
(define Cmd_head ,(sh words)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__ __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  Node_split word ,(tag pos elems)
  Expand_parts sh word ,(parts)
  Parts_count parts "leaves" ,(nLeaves)
  Parts_count parts "list" ,(nList)
  __Number_is_zero__ nLeaves ,(noLeaves)
  __Number_is_zero__ nList ,(noList)
  __not__ noList ,(hasList)
  __and__ noLeaves hasList ,(isList)
  __if__ (,() __NULL__ isList)
    (,()
      Parts_list_value parts nList ,(value)
      Value_head sh pos value ,(name more)
      return name more rest) ,()
  Parts_fields parts ,(fields)
  __if__ (,() __is_null__ fields)
    (,()
      __and__ noLeaves noList ,(noLazyList)
      __unless__ (,() __NULL__ noLazyList) (,() Sh_error sh pos "the command name is an empty LazyList") ,()
      Cmd_head sh rest ,(name more rest)
      return name more rest) ,()
  __LList_uncons__ __print_exit_error__ fields ,(name more)
  __NULL__ name more rest)

;; name が外部コマンドか。関数、組み込みコマンド、builtin、command でなければ外部コマンド
(define Cmd_is_external ,(sh name)
  __Cont_get__ ,(return)
  __String_equal__ name "builtin" ,(isBuiltin)
  __String_equal__ name "command" ,(isCommand)
  __or__ isBuiltin isCommand ,(special)
  __if__ (,() __NULL__ special) (,() return __FALSE__) ,()
  Func_lookup sh name ,(fn)
  __unless__ (,() __is_null__ fn) (,() return __FALSE__) ,()
  Builtin_lookup name ,(builtin)
  __unless__ (,() __is_null__ builtin) (,() return __FALSE__) ,()
  __NULL__ __TRUE__)

;; (cmd [env] words [redirs]) の子を、前置の変数定義、語、リダイレクトの LList に分ける
(define Cmd_parts ,(children)
  Cmd_parts_from children __NULL__ __NULL__ __NULL__)

(define Cmd_parts_from ,(children defs words redirs)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return defs words redirs) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "env")
    (,() Cmd_parts_from rest items words redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "words")
    (,() Cmd_parts_from rest defs items redirs)
    (,() Cmd_parts_from rest defs words items)))

;; 名前 name で、関数、組み込みコマンド、外部コマンドの順に探して実行する。
;; builtin name は組み込みコマンドを、command name は外部コマンドを実行する。
;; args は、外部コマンドなら String、それ以外なら値（String か LazyList）の LList
(define Cmd_run ,(sh pos name args in out err)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ name "builtin")
    (,()
      __if__ (,() __is_null__ args) (,() Sh_error sh pos "builtin: a command name is needed") ,()
      __LList_uncons__ __print_exit_error__ args ,(name2 args2)
      Arg_string sh pos "builtin" name2 ,(name2)
      Builtin_lookup name2 ,(builtin)
      __String_concat__ "builtin: not a builtin command: " name2 ,(msg)
      __if__ (,() __is_null__ builtin) (,() Sh_error sh pos msg) ,()
      builtin sh pos args2 in out err ,()
      return) ,()
  __if__ (,() __String_equal__ name "command")
    (,()
      Values_leaves args ,(args)
      __if__ (,() __is_null__ args) (,() Sh_error sh pos "command: a command name is needed") ,()
      __LList_uncons__ __print_exit_error__ args ,(name2 args2)
      External_run sh pos name2 args2 in out err ,()
      return) ,()
  Func_lookup sh name ,(fn)
  __unless__ (,() __is_null__ fn)
    (,()
      Func_targets sh pos out err ,(out err)
      Func_call sh pos fn args in out err ,()
      return) ,()
  Builtin_lookup name ,(builtin)
  __unless__ (,() __is_null__ builtin)
    (,()
      builtin sh pos args in out err ,()
      return) ,()
  External_run sh pos name args in out err)

;; 組み込みコマンドの引数 v が String なら、そのまま返す。LazyList ならエラー
(define Arg_string ,(sh pos command v)
  __type_name__ v ,(type)
  __String_concat__ command ": a LazyList is not allowed as an argument" ,(msg)
  __unless__ (,() __String_equal__ type "String") (,() Sh_error sh pos msg) ,()
  __NULL__ v)

;; ── if 文 ──

;; if 文を実行する。中の変数定義と関数定義は外に反映するので、局所変数と関数の Dict は同じものを使う
(define Eval_if ,(sh pos children)
  If_parts children ,(clauses elseBody redirs)
  Eval_redirected sh pos redirs (,(inner) If_clauses inner clauses elseBody))

;; if 文と for 文で、リダイレクトを適用した文脈 inner で run を実行する。リダイレクトがなければ sh のまま。
;; 関数と同じく、中の外部コマンドの出力は行ごとの要素にしてから書く。
;; 中の return、break、continue で外へ抜けるときも、開いた Stream を閉じる
(define Eval_redirected ,(sh pos redirs run)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs)
    (,()
      run sh ,()
      return) ,()
  Eval_redirs sh redirs ,(in out err opened ok)
  __unless__ (,() __NULL__ ok)
    (,()
      Eval_close opened ,()
      Sh_set_status sh "1" ,()
      return) ,()
  Func_targets sh pos out err ,(out err)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "in" in ,()
  __Dict_put__ inner "out" out ,()
  __Dict_put__ inner "err" err ,()
  Sh_get sh "return" ,(ret)
  __unless__ (,() __is_null__ ret)
    (,() __Dict_put__ inner "return" (,() Eval_close opened ,() ret)) ,()
  Sh_get sh "loops" ,(loops)
  Loops_closing loops opened ,(loops)
  __Dict_put__ inner "loops" loops ,()
  run inner ,()
  Eval_close opened)

;; ループの LList の各 break と continue の継続を、先に opened を閉じるものにした LList
(define Loops_closing ,(loops opened)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ loops) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ loops ,(loop rest)
  Loop_split loop ,(name brk cont)
  Loop_make name (,() Eval_close opened ,() brk) (,() Eval_close opened ,() cont) ,(loop)
  Loops_closing rest opened ,(rest)
  __LList_cons__ loop rest)

;; (if clause ... [else] [redirs]) の子を、clause の LList、else のスクリプト（なければ null）、
;; リダイレクトの LList に分ける
(define If_parts ,(children)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ children) (,() return __NULL__ __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ children ,(child rest)
  If_parts rest ,(clauses elseBody redirs)
  Node_split child ,(tag pos items)
  __if_then_else__ (,() __String_equal__ tag "clause")
    (,()
      __LList_cons__ child clauses ,(clauses)
      __NULL__ clauses elseBody redirs) (,()
  __if_then_else__ (,() __String_equal__ tag "else")
    (,()
      List_first items ,(body)
      __NULL__ clauses body redirs)
    (,() __NULL__ clauses elseBody items)))

;; 条件を順に実行し、最初に $? が 0 になった clause の本体を実行する。どれも 0 でなければ else を実行する。
;; else がなく、どの条件も成り立たなければ $? は 0
(define If_clauses ,(sh clauses elseBody)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ clauses)
    (,()
      __if_then_else__ (,() __is_null__ elseBody)
        (,() Sh_set_status sh "0")
        (,() If_script sh elseBody) ,()
      return) ,()
  __LList_uncons__ __print_exit_error__ clauses ,(clause rest)
  Node_split clause ,(tag pos scripts)
  __LList_uncons__ __print_exit_error__ scripts ,(cond others)
  List_first others ,(body)
  If_script sh cond ,()
  Sh_status sh ,(status)
  __if_then_else__ (,() __String_equal__ status "0")
    (,() If_script sh body)
    (,() If_clauses sh rest elseBody))

;; if 文の中のスクリプトを実行する。空のスクリプトの $? は 0
(define If_script ,(sh script)
  __Cont_get__ ,(return)
  Node_split script ,(tag pos lines)
  __if__ (,() __is_null__ lines) (,() Sh_set_status sh "0" ,() return) ,()
  Eval_lines sh lines)

;; ── コマンド置換 ──

;; $( スクリプト ) を実行し、標準出力の要素を並べた LazyList を返す。外部コマンドの出力は行ごとの要素になる。
;; 当面は同じ VProc で最後まで実行してから値にする（PLAN-ja.md の 2.3）。
;; 中の変数定義、関数定義、export、cd、$? は外に影響しない。中から return や外のループへの break、continue はできない
(define Eval_subst ,(sh pos script)
  Node_split script ,(tag spos lines)
  ;; 出力の要素は、逆順の LList にして Dict の "items" に置く
  __Dict_new__ ,(box)
  __Dict_put__ box "items" __NULL__ ,()
  Sh_get sh "global" ,(global)
  Target_sink global (,(item)
    Sh_get box "items" ,(items)
    __LList_cons__ item items ,(items)
    __Dict_put__ box "items" items) ,(out)
  Subst_scope sh out ,(inner)
  Sh_status sh ,(status)
  __OS_getcwd__ ,(cwd)
  Eval_lines inner lines ,()
  __OS_chdir__ __print_exit_error__ cwd ,()
  Sh_set_status sh status ,()
  Sh_get box "items" ,(items)
  List_reverse items ,(items)
  LazyList_fromList items)

;; コマンド置換の中の文脈。局所変数と環境変数は写しにし、関数は新しいスコープ（外側は sh）に定義する
(define Subst_scope ,(sh out)
  Sh_get sh "vars" ,(vars)
  Dict_copy vars ,(vars)
  Sh_get sh "env" ,(env)
  Env_copy env ,(env)
  __Dict_new__ ,(funcs)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "vars" vars ,()
  __Dict_put__ inner "env" env ,()
  __Dict_put__ inner "funcs" funcs ,()
  __Dict_put__ inner "parent" sh ,()
  __Dict_put__ inner "out" out ,()
  __Dict_put__ inner "return" __NULL__ ,()
  __Dict_put__ inner "inSubst" __TRUE__ ,()
  __Dict_put__ inner "loops" __NULL__ ,()
  __NULL__ inner)

;; ── for 文、break、continue ──

;; for 文を実行する。(for "名前" (in 語 ...) script [redirs])。
;; 語をすべて関数の引数と同じ規則で展開してから、値ごとに本体を実行する。LazyList の値は1階層だけ開き、
;; 要素を1つずつ取り出す。ループ変数は局所変数で、中の変数定義と関数定義は外に反映する。終わった後の $? は 0
(define Eval_for ,(sh pos children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(in rest)
  __LList_uncons__ __print_exit_error__ rest ,(body rest)
  __if_then_else__ (,() __is_null__ rest)
    (,() __NULL__ __NULL__)
    (,()
      List_first rest ,(redirsNode)
      Node_split redirsNode ,(rtag rpos redirs)
      __NULL__ redirs) ,(redirs)
  Node_split in ,(itag ipos words)
  Node_split body ,(btag bpos lines)
  Eval_redirected sh pos redirs (,(inner)
    For_values inner words ,(values)
    For_run inner name values lines ,()
    Sh_set_status inner "0"))

;; for 文の語を展開した値の LList
(define For_values ,(sh words)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  Expand_args sh word ,(values)
  For_values sh rest ,(more)
  List_append values more)

;; break はこの関数から抜ける
(define For_run ,(sh name values lines)
  __Cont_get__ ,(break)
  For_each sh name values lines break)

(define For_each ,(sh name values lines break)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ values) return ,()
  __LList_uncons__ __print_exit_error__ values ,(value rest)
  __type_name__ value ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,() For_item sh name value lines break)
    (,() For_lazy sh name value lines break) ,()
  For_each sh name rest lines break)

;; LazyList の要素を1つずつ取り出して回す
(define For_lazy ,(sh name list lines break)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return) list ,(item rest)
  For_item sh name item lines break ,()
  For_lazy sh name rest lines break)

;; 1回分。ループ変数に item を設定して本体を実行する。continue はこの関数から抜ける
(define For_item ,(sh name item lines break)
  __Cont_get__ ,(continue)
  Sh_get sh "vars" ,(vars)
  __Dict_put__ vars name item ,()
  Loop_make name break continue ,(loop)
  Sh_get sh "loops" ,(loops)
  __LList_cons__ loop loops ,(loops)
  Dict_copy sh ,(inner)
  __Dict_put__ inner "loops" loops ,()
  Eval_lines inner lines)

(define Loop_make ,(name brk cont)
  __LList_cons__ cont __NULL__ ,(rest)
  __LList_cons__ brk rest ,(rest)
  __LList_cons__ name rest)

(define Loop_split ,(loop)
  __LList_uncons__ __print_exit_error__ loop ,(name rest)
  __LList_uncons__ __print_exit_error__ rest ,(brk rest)
  __LList_uncons__ __print_exit_error__ rest ,(cont rest)
  __NULL__ name brk cont)

;; 文「break [名前]」「continue [名前]」。名前があれば、そのループ変数の最も内側のループを、なければ最も内側のループを指す。
;; $? は 0 にする
(define Eval_jump ,(sh pos tag children)
  Sh_get sh "loops" ,(loops)
  __String_concat__ tag " outside a loop" ,(msg)
  __if__ (,() __is_null__ loops) (,() Sh_error sh pos msg) ,()
  List_first children ,(name)
  Loops_find loops name ,(loop)
  __String_concat__ tag ": no loop for " ,(msg)
  __String_concat__ msg name ,(msg)
  __if__ (,() __is_null__ loop) (,() Sh_error sh pos msg) ,()
  Loop_split loop ,(loopName brk cont)
  Sh_set_status sh "0" ,()
  __if_then_else__ (,() __String_equal__ tag "break")
    (,() brk)
    (,() cont))

;; name のループ。name が "" なら最も内側のループ。なければ null
(define Loops_find ,(loops name)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ loops) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ loops ,(loop rest)
  __if__ (,() __String_equal__ name "") (,() return loop) ,()
  Loop_split loop ,(loopName brk cont)
  __if__ (,() __String_equal__ name loopName) (,() return loop) ,()
  Loops_find rest name)

;; ── 組み込みコマンド ──
;; どれも ,(sh pos args in out err) を取る

(define Builtin_lookup ,(name)
  __if_then_else__ (,() __String_equal__ name "echo") (,() __NULL__ Builtin_echo) (,()
  __if_then_else__ (,() __String_equal__ name "cd") (,() __NULL__ Builtin_cd) (,()
  __if_then_else__ (,() __String_equal__ name "defined") (,() __NULL__ Builtin_defined)
    (,() __NULL__ __NULL__))))

;; echo 値 ...: 標準出力に1つの要素を出す。
;; 引数が1つなら、その値（LazyList でも）をそのまま出す。引数がなければ空文字列を出す。
;; 2つ以上なら、各値を文字列化し、スペースで区切って連結する
(define Builtin_echo ,(sh pos args in out err)
  Echo_line sh pos args ,(line)
  Target_write sh pos out line ,()
  Sh_set_status sh "0")

(define Echo_line ,(sh pos args)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ args) (,() return "") ,()
  __LList_uncons__ __print_exit_error__ args ,(first rest)
  __if__ (,() __is_null__ rest) (,() return first) ,()
  Values_strings sh pos args ,(strs)
  List_join strs " ")

;; cd [ディレクトリ]: カレントディレクトリを変える。省略すると環境変数 HOME
(define Builtin_cd ,(sh pos args in out err)
  __Cont_get__ ,(return)
  __if_then_else__ (,() __is_null__ args)
    (,()
      Sh_get sh "env" ,(env)
      Env_lookup env "HOME" (,(key)
        Sh_warn sh pos "cd: HOME is not set" ,()
        Sh_set_status sh "1" ,()
        return))
    (,()
      List_first args ,(dir)
      Arg_string sh pos "cd" dir) ,(dir)
  __OS_chdir__ (,(msg)
    Msg_strip msg ,(msg)
    __String_concat__ "cd: " msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh "1" ,()
    return) dir ,()
  Sh_set_status sh "0")

;; defined [-l] 変数名: 変数が定義済みなら $? を 0、未定義なら 1 にする。-l なら局所変数だけを調べる
(define Builtin_defined ,(sh pos args in out err)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ args) (,() Sh_error sh pos "defined: a variable name is needed") ,()
  __LList_uncons__ __print_exit_error__ args ,(first rest)
  Arg_string sh pos "defined" first ,(first)
  __String_equal__ first "-l" ,(localOnly)
  __if_then_else__ (,() __NULL__ localOnly)
    (,() __NULL__ rest)
    (,() __NULL__ args) ,(names)
  __if__ (,() __is_null__ names) (,() Sh_error sh pos "defined: a variable name is needed") ,()
  __LList_uncons__ __print_exit_error__ names ,(name others)
  __unless__ (,() __is_null__ others) (,() Sh_error sh pos "defined: too many arguments") ,()
  Arg_string sh pos "defined" name ,(name)
  __if__ (,() __NULL__ localOnly)
    (,()
      Sh_get sh "vars" ,(vars)
      __Dict_lookup_or__ vars name (,(key) Sh_set_status sh "1" ,() return) ,(value)
      Sh_set_status sh "0" ,()
      return) ,()
  Sh_defined sh pos name ,(found)
  __if_then_else__ (,() __NULL__ found)
    (,() Sh_set_status sh "0")
    (,() Sh_set_status sh "1"))

;; ── 外部コマンド ──

;; 外部コマンドを起動し、終わるまで待って、$? を設定する。
;; 標準出力か標準エラー出力が sink に行くときは、パイプで受け取って行ごとに書く
(define External_run ,(sh pos name args in out err)
  __Cont_get__ ,(return)
  Sh_get sh "env" ,(env)
  Env_dict env ,(dict)
  __MSeq_new__ ,(command)
  __MSeq_append__ __print_exit_error__ command name ,()
  Eval_append command args ,()
  External_streams sh pos out err ,(outStream errStream reader writer pumpTarget)
  __OS_spawn__ (,(msg)
    Eval_close_pipe reader writer ,()
    Msg_strip msg ,(msg)
    __String_concat__ name ": " ,(m)
    __String_concat__ m msg ,(m)
    Sh_warn sh pos m ,()
    Sh_set_status sh "127" ,()
    return) command in outStream errStream dict ,(proc)
  __unless__ (,() __is_null__ reader)
    (,()
      __OS_close__ __print_exit_error__ writer ,()
      Target_pump pumpTarget reader ,()
      __OS_close__ __print_exit_error__ reader) ,()
  __OS_wait__ __print_exit_error__ proc ,(code)
  Eval_status code ,(status)
  Sh_set_status sh status)

;; 外部コマンドに渡す標準出力と標準エラー出力の Stream と、
;; sink に行く出力を受け取るパイプの両端（なければ null）と、その行き先のターゲットを返す
(define External_streams ,(sh pos out err)
  __Cont_get__ ,(return)
  Target_split out ,(outKind outId outValue)
  Target_split err ,(errKind errId errValue)
  __String_equal__ outKind "sink" ,(outIsSink)
  __String_equal__ errKind "sink" ,(errIsSink)
  __or__ outIsSink errIsSink ,(anySink)
  __unless__ (,() __NULL__ anySink)
    (,() return outValue errValue __NULL__ __NULL__ __NULL__) ,()
  __OS_pipe__ ,(reader writer)
  __unless__ (,() __NULL__ outIsSink)
    (,() return outValue writer reader writer err) ,()
  __unless__ (,() __NULL__ errIsSink)
    (,() return writer errValue reader writer out) ,()
  __unless__ (,() __String_equal__ outId errId)
    (,() Sh_error sh pos "standard output and standard error to two different places are not implemented yet") ,()
  return writer writer reader writer out)

(define Eval_close_pipe ,(reader writer)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ reader) return ,()
  __OS_close__ (,(msg) __nop__) reader ,()
  __OS_close__ (,(msg) __nop__) writer)

;; __OS_wait__ の終了コードを $? にする。シグナルで止まった場合（負の数）は、シグナル番号 + 128
(define Eval_status ,(code)
  __if_then_else__ (,() __Number_is_negative__ code)
    (,()
      num "128" ,(base)
      __Number_subtract__ base code)
    (,() __NULL__ code) ,(code)
  __Number_toString__ code)

;; 前置の変数定義を dict に加える。同じ文の語の展開に影響しないので、どれも呼び出し側の値で展開する
(define Eval_env_defs ,(sh defs dict)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ defs) return ,()
  __LList_uncons__ __print_exit_error__ defs ,(def rest)
  Node_split def ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(name values)
  Eval_env_value sh pos values ,(value)
  __Dict_put__ dict name value ,()
  Eval_env_defs sh rest dict)

;; 語を展開した値の LList。外部コマンドなら葉ごとの String、それ以外なら外部コマンド以外の語の規則で展開する
(define Eval_args ,(sh words isExternal)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ words) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ words ,(word rest)
  __if_then_else__ (,() __NULL__ isExternal)
    (,() Expand_fields sh word)
    (,() Expand_args sh word) ,(values)
  Eval_args sh rest isExternal ,(more)
  List_append values more)

(define Eval_append ,(mseq list)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) return ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  __MSeq_append__ __print_exit_error__ mseq head ,()
  Eval_append mseq tail)

(define Eval_close ,(streams)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ streams) return ,()
  __LList_uncons__ __print_exit_error__ streams ,(stream rest)
  __OS_close__ (,(msg) __nop__) stream ,()
  Eval_close rest)

;; ── リダイレクト ──

;; リダイレクトを左から順に適用し、標準入力の Stream（null は親のまま）、標準出力と標準エラー出力の
;; ターゲット、開いた Stream の LList、成功したかを返す。ファイルを開けなければ、メッセージを出して失敗とする
(define Eval_redirs ,(sh redirs)
  __Dict_new__ ,(used)
  Sh_get sh "in" ,(in)
  Sh_get sh "out" ,(out)
  Sh_get sh "err" ,(err)
  Eval_redirs_from sh redirs used in out err __NULL__)

(define Eval_redirs_from ,(sh redirs used in out err opened)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ redirs) (,() return in out err opened __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ redirs ,(redir rest)
  Node_split redir ,(tag pos children)
  __LList_uncons__ __print_exit_error__ children ,(op targets)
  Redir_fd op ,(fd)
  __Dict_lookup_or__ used fd (,(key) __NULL__ __FALSE__) ,(dup)
  __if__ (,() __NULL__ dup) (,() Sh_error sh pos "duplicate redirection") ,()
  __Dict_put__ used fd __TRUE__ ,()
  __if__ (,() __String_equal__ op "1>&2")
    (,()
      Eval_redirs_from sh rest used in err err opened ,(in out err opened ok)
      return in out err opened ok) ,()
  __if__ (,() __String_equal__ op "2>&1")
    (,()
      Eval_redirs_from sh rest used in out out opened ,(in out err opened ok)
      return in out err opened ok) ,()
  __LList_uncons__ __print_exit_error__ targets ,(target others)
  Node_split target ,(targetTag targetPos targetChildren)
  __if__ (,() __String_equal__ targetTag "params")
    (,() Sh_error sh pos "redirection to a variable list is not implemented yet") ,()
  Expand_fields sh target ,(fields)
  List_length fields ,(n)
  num "1" ,(one)
  __Number_subtract__ n one ,(diff)
  __unless__ (,() __Number_is_zero__ diff) (,() Sh_error sh pos "ambiguous redirect") ,()
  __LList_uncons__ __print_exit_error__ fields ,(path others)
  Redir_mode op ,(mode)
  __OS_open__ (,(msg)
    Msg_strip msg ,(msg)
    __String_concat__ path ": " ,(m)
    __String_concat__ m msg ,(m)
    Sh_warn sh pos m ,()
    return in out err opened __FALSE__) path mode ,(stream)
  __LList_cons__ stream opened ,(opened)
  __if_then_else__ (,() __String_equal__ fd "0")
    (,() Eval_redirs_from sh rest used stream out err opened) (,()
  Sh_get sh "global" ,(global)
  Target_stream global stream ,(target)
  __if_then_else__ (,() __String_equal__ fd "1")
    (,() Eval_redirs_from sh rest used in target err opened)
    (,() Eval_redirs_from sh rest used in out target opened)))

;; リダイレクトが変える入出力の番号
(define Redir_fd ,(op)
  __if_then_else__ (,() __String_equal__ op "<") (,() __NULL__ "0") (,()
  __String_equal__ op "2>" ,(e1)
  __String_equal__ op "2>&1" ,(e2)
  __or__ e1 e2 ,(isErr)
  __if_then_else__ (,() __NULL__ isErr) (,() __NULL__ "2") (,() __NULL__ "1")))

(define Redir_mode ,(op)
  __if_then_else__ (,() __String_equal__ op "<") (,() __NULL__ "r") (,()
  __if_then_else__ (,() __String_equal__ op ">>") (,() __NULL__ "a") (,() __NULL__ "w")))
