;; ConSh のチャネル。パイプと $( ) で、いくつもの VProc が書き、1つの LazyList として読む。
;;
;; __LazyList_pipe__ の Sink は、それを作った VProc でしか使えない。ConSh では、パイプラインの要素の中の
;; パイプラインや $( ) のように、同じ行き先に別の VProc が書くので、書き手の VProc ごとに鎖（chain）を持つ。
;;
;; チャネルは Dict で、次のキーを持つ。
;;   "chains"    鎖の MSeq。書き手を作る VProc が __MSeq_append__ で加える（1回の適用なので、ほかの VProc と競合しない）
;;   "wake"      書き手が書くたびに新しい値にする Ref。読み手はこれが変わるのを待つ
;;   "cancelled" 読み手がもう読まないとき __TRUE__ にする Ref
;;   "cap"       書き手が、読み手がまだ取り出していない要素を先に書ける数
;;
;; 鎖は Dict で、"head"（最初の節の Ref）と "consumed"（読み手が取り出した数の Ref）を持つ。
;; 節は Ref で、値は null（まだ書いていない）、(要素 . 次の節) の LList、"end"（書き手が閉じた）のどれか。
;; 1つの鎖に書くのは1つの VProc だけで、節を書くのは書き手、consumed を変えるのは読み手だけなので、競合しない。
;;
;; 書き手は Dict で、"chan"、"chain"、"tail"（次に書く節）、"produced"（書いた数）を持ち、その VProc だけが使う。
;;
;; 読み手は、すべての鎖が閉じたら LazyList を終える。鎖を加えるのは、すでに書き手を持つ VProc か、
;; チャネルを作った VProc（読み始める前）なので、まだ閉じていない鎖があるうちに加わる。
;; そのため、開いている鎖がなくなったら、もう鎖は加わらない。

(define Chan_new ,(cap)
  __Dict_new__ ,(chan)
  __MSeq_new__ ,(chains)
  __Dict_put__ chan "chains" chains ,()
  __Dict_new__ ,(token)
  __Ref_new__ token ,(wake)
  __Dict_put__ chan "wake" wake ,()
  __Ref_new__ __FALSE__ ,(cancelled)
  __Dict_put__ chan "cancelled" cancelled ,()
  __Dict_put__ chan "cap" cap ,()
  __NULL__ chan)

;; 新しい鎖を加え、その書き手を返す。書き手は、それを使う VProc が最後に Chan_close する
(define Chan_writer ,(chan)
  __Ref_new__ __NULL__ ,(head)
  num "0" ,(zero)
  __Ref_new__ zero ,(consumed)
  __Dict_new__ ,(chain)
  __Dict_put__ chain "head" head ,()
  __Dict_put__ chain "consumed" consumed ,()
  Sh_get chan "chains" ,(chains)
  __MSeq_append__ __print_exit_error__ chains chain ,()
  __Dict_new__ ,(writer)
  __Dict_put__ writer "chan" chan ,()
  __Dict_put__ writer "chain" chain ,()
  __Dict_put__ writer "tail" head ,()
  __Dict_put__ writer "produced" zero ,()
  __NULL__ writer)

;; 書き手のチャネル
(define Chan_of ,(writer)
  Sh_get writer "chan")

;; 要素 item を書く。読み手が取り出していない要素が cap 個あれば、読み手が取り出すまで待つ。
;; 読み手が cancel していれば、書かずに onCancelled を呼ぶ（SIGPIPE に当たる）
(define Chan_put ,(writer item onCancelled)
  Chan_wait_room writer onCancelled ,()
  Sh_get writer "tail" ,(tail)
  __Ref_new__ __NULL__ ,(next)
  __LList_cons__ item next ,(cell)
  __Ref_set__ tail cell ,()
  __Dict_put__ writer "tail" next ,()
  Sh_get writer "produced" ,(produced)
  num "1" ,(one)
  __Number_add__ produced one ,(produced)
  __Dict_put__ writer "produced" produced ,()
  Sh_get writer "chan" ,(chan)
  Chan_wake chan)

;; consumed を cancelled より先に読む。cancelled を先に読むと、その後で読み手が cancel して consumed を
;; 書き換えたとき、書き換えた後の consumed が変わるのを待ってしまい、二度と起きない。
;; consumed を先に読めば、その後の cancel は consumed を変えるので、__Ref_wait_change__ は待たずに戻る。
;; チャネルに "state"（$( ) の状態の Ref）があれば、待つ間は "blocked" にする（Subst_settle）
(define Chan_wait_room ,(writer onCancelled)
  __Cont_get__ ,(return)
  Sh_get writer "chan" ,(chan)
  Sh_get writer "chain" ,(chain)
  Sh_get chain "consumed" ,(consumedRef)
  __Ref_get__ consumedRef ,(consumed)
  Sh_get chan "cancelled" ,(cancelledRef)
  __Ref_get__ cancelledRef ,(cancelled)
  __if__ cancelled onCancelled ,()
  Sh_get writer "produced" ,(produced)
  Sh_get chan "cap" ,(cap)
  __Number_subtract__ produced consumed ,(ahead)
  __Number_subtract__ ahead cap ,(over)
  __Number_is_negative__ over ,(condition)
  __if__ condition return ,()
  __Dict_lookup_or__ chan "state" (,(key) __NULL__ __NULL__) ,(state)
  __is_null__ state ,(condition)
  __unless__ condition (,() __Ref_set__ state "blocked") ,()
  __Ref_wait_change__ consumedRef consumed ,()
  __is_null__ state ,(condition)
  __unless__ condition (,() __Ref_set__ state "running") ,()
  Chan_wait_room writer onCancelled)

;; 書き手を閉じる。2回目は何もしない
(define Chan_close ,(writer)
  __Cont_get__ ,(return)
  Sh_get writer "tail" ,(tail)
  __Ref_get__ tail ,(value)
  __is_null__ value ,(condition)
  __unless__ condition return ,()
  __Ref_set__ tail "end" ,()
  Sh_get writer "chan" ,(chan)
  Chan_wake chan)

(define Chan_wake ,(chan)
  Sh_get chan "wake" ,(wake)
  __Dict_new__ ,(token)
  __Ref_set__ wake token)

;; 読み手がもう読まないことを書き手に知らせる。待っている書き手を起こす
(define Chan_cancel ,(chan)
  Sh_get chan "cancelled" ,(cancelledRef)
  __Ref_set__ cancelledRef __TRUE__ ,()
  Sh_get chan "chains" ,(chains)
  Chan_cancel_chains chains)

(define Chan_cancel_chains ,(chains)
  __Cont_get__ ,(return)
  __MSeq_is_empty__ __print_exit_error__ chains ,(empty)
  __if__ empty return ,()
  __MSeq_uncons__ __print_exit_error__ chains ,(chain rest)
  Sh_get chain "consumed" ,(consumedRef)
  __Ref_get__ consumedRef ,(consumed)
  ;; __Ref_wait_change__ は値の同一性で比べるので、同じ数の別のオブジェクトを置いて、待っている書き手を起こす
  num "0" ,(zero)
  __Number_add__ consumed zero ,(same)
  __Ref_set__ consumedRef same ,()
  Chan_cancel_chains rest)

;; ── 読み手 ──
;; 読み手の状態は Dict で、"chan"、"seen"（読み手が知っている鎖の数）、
;; "cursors"（まだ閉じていない鎖の読み位置の LList）、"untilRegister"（次に新しい鎖を探すまでに取り出す要素の数）を持つ。
;; 読み位置は Dict で、"chain" と "node"（次に読む節）。
;; LazyList の節は順に1つずつ評価されるので、状態を同時に2つの VProc が変えることはない。
;; 新しい鎖を探す（Chan_register）のは、知っている鎖に要素がないときと、Chan_register_every 個ごとだけにする。
;; 鎖の MSeq をたどるのは手間がかかり、要素ごとに探すと、読み手の時間の大半になっていた

;; チャネルに書かれた要素を、届いた順に並べた LazyList
(define Chan_list ,(chan)
  __Dict_new__ ,(state)
  __Dict_put__ state "chan" chan ,()
  num "0" ,(zero)
  __Dict_put__ state "seen" zero ,()
  __Dict_put__ state "cursors" __NULL__ ,()
  __Dict_put__ state "untilRegister" zero ,()
  Chan_list_from state)

;; 知っている鎖に要素があっても、この数の要素を取り出すごとに新しい鎖を探す（後から加わった鎖も読まれるように）
(define Chan_register_every ,()
  num "16")

(define Chan_list_from ,(state)
  __LazyList_new__ (,() Chan_next state))

;; 次の要素の LazyList。要素がなければ、新しい鎖を探し、それでもなければ、書き手が書くか、すべての鎖が閉じるまで待つ。
;; すべての鎖が閉じたと決めるのは、新しい鎖を探した後だけである
(define Chan_next ,(state)
  __Cont_get__ ,(return)
  Sh_get state "chan" ,(chan)
  Sh_get chan "wake" ,(wake)
  __Ref_get__ wake ,(token)
  Sh_get state "untilRegister" ,(until)
  __Number_is_zero__ until ,(condition)
  __if__ condition
    (,()
      Chan_register state ,(added)
      Chan_register_every ,(every)
      __Dict_put__ state "untilRegister" every) ,()
  Chan_take_from state ,(item found)
  __if__ found (,() Chan_found state item ,(list) return list) ,()
  ;; 新しい鎖があれば、そこからも取り出してみる。なければ、知っている鎖は今調べたので、待つ
  ;; （その後に書かれていれば、token が変わっているので、待たずに戻る）
  Chan_register state ,(added)
  __if__ added (,()
    Chan_take_from state ,(item found)
    __if__ found (,() Chan_found state item ,(list) return list) ,()) ,()
  Sh_get state "cursors" ,(cursors)
  __is_null__ cursors ,(condition)
  __if__ condition
    (,()
      ;; 鎖を調べた後、知っている鎖が閉じるまでの間に、書き手が新しい鎖を加えたかもしれないので、もう一度調べる。
      ;; それでも開いた鎖がなければ終える（開いた鎖がなくなった後に、鎖が加わることはない）
      Chan_register state ,(more)
      Sh_get state "cursors" ,(cursors)
      __is_null__ cursors ,(condition)
      __if__ condition
        (,()
          __LazyList_empty__ ,(empty)
          return empty) ,()
      Chan_next state ,(list)
      return list) ,()
  __Ref_wait_change__ wake token ,()
  Chan_next state)

;; 知っている鎖から1つ取り出し、読み位置を更新する。要素と、取り出せたかを返す
(define Chan_take_from ,(state)
  Sh_get state "cursors" ,(cursors)
  Chan_take cursors __NULL__ ,(item cursors found)
  __Dict_put__ state "cursors" cursors ,()
  __NULL__ item found)

;; 取り出した要素 item を先頭にし、続きを遅延にした LazyList
(define Chan_found ,(state item)
  Sh_get state "untilRegister" ,(until)
  num "1" ,(one)
  __Number_subtract__ until one ,(until)
  __Dict_put__ state "untilRegister" until ,()
  Chan_list_from state ,(rest)
  __LazyList_cons__ item rest)

;; まだ知らない鎖の読み位置を cursors の末尾に加える。加えたかを返す
(define Chan_register ,(state)
  __Cont_get__ ,(return)
  Sh_get state "chan" ,(chan)
  Sh_get chan "chains" ,(chains)
  Sh_get state "seen" ,(seen)
  Chan_skip chains seen ,(chains)
  __MSeq_is_empty__ __print_exit_error__ chains ,(none)
  __if__ none (,() return __FALSE__) ,()
  Chan_cursors chains ,(added)
  List_length added ,(n)
  __Number_add__ seen n ,(seen)
  __Dict_put__ state "seen" seen ,()
  Sh_get state "cursors" ,(cursors)
  List_append cursors added ,(cursors)
  __Dict_put__ state "cursors" cursors ,()
  __NULL__ __TRUE__)

;; MSeq の先頭の n 個を除いた MSeq
(define Chan_skip ,(chains n)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(condition)
  __if__ condition (,() return chains) ,()
  __MSeq_uncons__ __print_exit_error__ chains ,(chain rest)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  Chan_skip rest n)

(define Chan_cursors ,(chains)
  __Cont_get__ ,(return)
  __MSeq_is_empty__ __print_exit_error__ chains ,(empty)
  __if__ empty (,() return __NULL__) ,()
  __MSeq_uncons__ __print_exit_error__ chains ,(chain rest)
  __Dict_new__ ,(cursor)
  __Dict_put__ cursor "chain" chain ,()
  Sh_get chain "head" ,(head)
  __Dict_put__ cursor "node" head ,()
  Chan_cursors rest ,(more)
  __LList_cons__ cursor more)

;; 要素のある最初の鎖から1つ取り出す。閉じた鎖は除く。取り出した鎖は末尾に回す（ほかの鎖も読まれるように）。
;; 鎖が1つだけなら回さない。
;; 要素、新しい cursors、取り出せたかを返す。passed は、調べた鎖のうち残すものの逆順の LList
(define Chan_take ,(cursors passed)
  __Cont_get__ ,(return)
  __is_null__ cursors ,(condition)
  __if__ condition
    (,()
      List_reverse passed ,(cursors)
      return __NULL__ cursors __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ cursors ,(cursor rest)
  Sh_get cursor "node" ,(node)
  __Ref_get__ node ,(value)
  __is_null__ value ,(condition)
  __if__ condition (,()
    __LList_cons__ cursor passed ,(passed)
    Chan_take rest passed ,(item cursors found)
    return item cursors found) ,()
  __type_name__ value ,(type)
  __String_equal__ type "String" ,(condition)
  __if__ condition (,()
    Chan_take rest passed ,(item cursors found)
    return item cursors found) ,()
  __LList_uncons__ __print_exit_error__ value ,(item next)
  __Dict_put__ cursor "node" next ,()
  Sh_get cursor "chain" ,(chain)
  Sh_get chain "consumed" ,(consumedRef)
  __Ref_get__ consumedRef ,(consumed)
  num "1" ,(one)
  __Number_add__ consumed one ,(consumed)
  __Ref_set__ consumedRef consumed ,()
  __is_null__ passed ,(noPassed)
  __is_null__ rest ,(noRest)
  __and__ noPassed noRest ,(only)
  __if__ only (,() return item cursors __TRUE__) ,()
  List_reverse passed ,(front)
  List_append front rest ,(cursors)
  __LList_cons__ cursor __NULL__ ,(last)
  List_append cursors last ,(cursors)
  __NULL__ item cursors __TRUE__)
