;; ConSh のチャネル。パイプと $( ) で、いくつもの VProc が書き、1つの LazyList として読む。
;;
;; チャネルそのものは、拡張 ConMa の機能 "chan" のプリミティブ（__Chan_new__、__Chan_writer__、__Chan_of__、
;; __Chan_put__、__Chan_close__、__Chan_cancel__、__Chan_reader__、__Chan_take__。docs/dev/CHAN-PLAN-ja.md、
;; docs/PRIMITIVES.md の 16）で、意味は代わりの定義（include/core/chan.se）に書いてある。ConSh は、それを直接呼ぶ。
;; ここには、読み手が取り出す要素を LazyList にする関数だけを置く。
;; 参照版（consh/reference/consh_chan.se）は、代わりの定義を読んでから、このファイルを読む。

;; チャネルに書かれた要素を、届いた順に並べた LazyList
(define Chan_list ,(chan)
  __Chan_reader__ chan ,(reader)
  Chan_list_from reader)

(define Chan_list_from ,(reader)
  __LazyList_new__ (,() Chan_next reader))

;; 次の要素を先頭にし、続きを遅延にした LazyList。すべての鎖が閉じていれば空
(define Chan_next ,(reader)
  __Chan_take__ reader ,(item found)
  __if_then_else__ found
    (,()
      Chan_list_from reader ,(rest)
      __LazyList_cons__ item rest)
    __LazyList_empty__)
