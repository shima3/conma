;; ConSh の構文木（AST.md）を読み書きする。
;; consh_parse が1行に1つずつ出力する S 式を、次の ConMa の値にする。
;;   リスト → LList（空のリストは null）
;;   記号   → 数字で始まれば Number（(行 桁) の数）、それ以外は String（節の種類）
;;   文字列 → エスケープを戻した String
;; 節の種類と文字列は、どちらも String になる。書き戻すときは、リストの先頭の String を節の種類とする。
;; ただし、params の名前のリスト ("a" "b") は、先頭も文字列として書く。
(include "util.se")
(include "token.se")

;; ── 読み込み ──

;; path のファイルから構文木を読み、コマンド行の節の LList を返す。
;; 読めなければ onError に「path:行: メッセージ」を渡す
(define Ast_readFile ,(onError path)
  __OS_open__ onError path "r" ,(stream)
  __LazyList_lines__ stream ,(lines)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Ast_readLines onError path one lines ,(nodes)
  __OS_close__ onError stream ,()
  __NULL__ nodes)

;; LazyList の各行（n 行目から）を S 式として読み、その LList を返す
(define Ast_readLines ,(onError path n lines)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return __NULL__) lines ,(line rest)
  Ast_chomp line ,(line)
  Sexp_read (,(msg)
    __Number_toString__ n ,(lineNo)
    __String_concat__ path ":" ,(s)
    __String_concat__ s lineNo ,(s)
    __String_concat__ s ": " ,(s)
    __String_concat__ s msg ,(s)
    onError s) line ,(node)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  Ast_readLines onError path n rest ,(nodes)
  __LList_cons__ node nodes)

;; 行末の改行を除く
(define Ast_chomp ,(line)
  __String_length__ line ,(len)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ len one ,(last)
  __if_then_else__ (,() __Number_is_negative__ last)
    (,() __NULL__ line)
    (,()
      __String_substring__ __print_exit_error__ line last len ,(ch)
      __if_then_else__ (,() __String_equal__ ch "\n")
        (,()
          __Number_fromString__ __print_exit_error__ "0" ,(zero)
          __String_substring__ __print_exit_error__ line zero last)
        (,() __NULL__ line)))

;; text の S 式を1つ読む。後ろには空白と改行だけを置ける
(define Sexp_read ,(onError text)
  __String_length__ text ,(len)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Sexp_value onError text len zero ,(value i)
  Sexp_skip text len i ,(i)
  __Number_subtract__ len i ,(rest)
  __unless__ (,() __Number_is_zero__ rest)
    (,() Sexp_error onError "unexpected characters after an S-expression" text i) ,()
  __NULL__ value)

;; i 文字目から値を1つ読み、値と、その次の位置を返す
(define Sexp_value ,(onError text len i)
  Sexp_skip text len i ,(i)
  Sexp_char text len i ,(ch)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ i one ,(next)
  __if_then_else__ (,() __String_equal__ ch "(")
    (,() Sexp_items onError text len next) (,()
  __if_then_else__ (,() __String_equal__ ch "\"")
    (,() Sexp_string onError text len next "") (,()
  __if_then_else__ (,() Sexp_is_delimiter ch)
    (,() Sexp_error onError "expected a value" text i)
    (,() Sexp_symbol onError text len i next))))

;; リストの要素を ")" まで読み、その LList と、")" の次の位置を返す
(define Sexp_items ,(onError text len i)
  Sexp_skip text len i ,(i)
  Sexp_char text len i ,(ch)
  __if_then_else__ (,() __String_equal__ ch ")")
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __NULL__ __NULL__ next) (,()
  __if_then_else__ (,() __String_equal__ ch "")
    (,() Sexp_error onError "unterminated list" text i)
    (,()
      Sexp_value onError text len i ,(value i)
      Sexp_items onError text len i ,(rest i)
      __LList_cons__ value rest ,(list)
      __NULL__ list i)))

;; 文字列の中身を閉じる " まで読み、エスケープを戻した String と、" の次の位置を返す。acc は読んだ分
(define Sexp_string ,(onError text len i acc)
  Sexp_char text len i ,(ch)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ i one ,(next)
  __if_then_else__ (,() __String_equal__ ch "")
    (,() Sexp_error onError "unterminated string" text i) (,()
  __if_then_else__ (,() __String_equal__ ch "\"")
    (,() __NULL__ acc next) (,()
  __if_then_else__ (,() __String_equal__ ch "\\")
    (,()
      Sexp_char text len next ,(e)
      Sexp_unescape e ,(e)
      __String_concat__ acc e ,(acc)
      __Number_add__ next one ,(next)
      Sexp_string onError text len next acc)
    (,()
      __String_concat__ acc ch ,(acc)
      Sexp_string onError text len next acc))))

;; \ の後の文字 e が表す文字。\n、\t、\r 以外は e そのもの（\" と \\）
(define Sexp_unescape ,(e)
  __if_then_else__ (,() __String_equal__ e "n") (,() __NULL__ "\n") (,()
  __if_then_else__ (,() __String_equal__ e "t") (,() __NULL__ "\t") (,()
  __if_then_else__ (,() __String_equal__ e "r") (,() __NULL__ "\r") (,()
  __NULL__ e))))

;; start 文字目から区切りの前までを記号にする。数字で始まれば Number にする
(define Sexp_symbol ,(onError text len start i)
  Sexp_char text len i ,(ch)
  __if_then_else__ (,() Sexp_is_delimiter ch)
    (,()
      __String_substring__ __print_exit_error__ text start i ,(symbol)
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ start one ,(second)
      __String_substring__ __print_exit_error__ text start second ,(first)
      __if_then_else__ (,() Sexp_is_digit first)
        (,()
          __Number_fromString__ (,(msg) Sexp_error onError "invalid number" text start) symbol ,(number)
          __NULL__ number i)
        (,() __NULL__ symbol i))
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      Sexp_symbol onError text len start next))

;; 空白と改行を読み飛ばした位置
(define Sexp_skip ,(text len i)
  Sexp_char text len i ,(ch)
  __String_equal__ ch " " ,(space)
  __String_equal__ ch "\t" ,(tab)
  __String_equal__ ch "\n" ,(lf)
  __String_equal__ ch "\r" ,(cr)
  __or__ space tab ,(blank)
  __or__ lf cr ,(newline)
  __or__ blank newline ,(skip)
  __if_then_else__ (,() __NULL__ skip)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      Sexp_skip text len next)
    (,() __NULL__ i))

;; i 文字目の1文字。終わりなら ""
(define Sexp_char ,(text len i)
  __Number_subtract__ len i ,(rest)
  __if_then_else__ (,() __Number_is_positive__ rest)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __String_substring__ __print_exit_error__ text i next)
    (,() __NULL__ ""))

;; 記号の終わりになる文字か（終わりの "" を含む）
(define Sexp_is_delimiter ,(ch)
  __String_equal__ ch "" ,(end)
  __String_equal__ ch " " ,(space)
  __String_equal__ ch "\t" ,(tab)
  __String_equal__ ch "\n" ,(lf)
  __String_equal__ ch "\r" ,(cr)
  __String_equal__ ch "(" ,(lparen)
  __String_equal__ ch ")" ,(rparen)
  __String_equal__ ch "\"" ,(quote)
  __or__ end space ,(a)
  __or__ tab lf ,(b)
  __or__ cr lparen ,(c)
  __or__ rparen quote ,(d)
  __or__ a b ,(ab)
  __or__ c d ,(cd)
  __or__ ab cd)

(define Sexp_is_digit ,(ch)
  __String_toCode__ __print_exit_error__ ch ,(code)
  __Number_fromString__ __print_exit_error__ "48" ,(zero)
  __Number_fromString__ __print_exit_error__ "57" ,(nine)
  __Number_subtract__ code zero ,(low)
  __Number_subtract__ nine code ,(high)
  __Number_is_negative__ low ,(below)
  __Number_is_negative__ high ,(above)
  __or__ below above ,(outside)
  __not__ outside)

;; 「<メッセージ> at column <桁>: <text>」を onError に渡す。桁は 1 から数える
(define Sexp_error ,(onError msg text i)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ i one ,(col)
  __Number_toString__ col ,(col)
  __String_concat__ msg " at column " ,(msg)
  __String_concat__ msg col ,(msg)
  __String_concat__ msg ": " ,(msg)
  __String_concat__ msg text ,(msg)
  onError msg)

;; ── 書き戻し ──

;; 値を S 式の String にする。consh_parse の出力と同じ形になる
(define Sexp_write ,(value)
  __type_name__ value ,(type)
  __if_then_else__ (,() __String_equal__ type "LList")
    (,() Sexp_write_list value) (,()
  __if_then_else__ (,() __String_equal__ type "null")
    (,() __NULL__ "()") (,()
  __if_then_else__ (,() __String_equal__ type "Number")
    (,() __Number_toString__ value)
    (,() Sexp_quote value))))

;; 先頭が String のリストは節で、先頭を節の種類として書く。params の中の、先頭が String のリストは名前のリスト
(define Sexp_write_list ,(list)
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __type_name__ head ,(type)
  __if_then_else__ (,() __String_equal__ type "String")
    (,()
      __String_equal__ head "params" ,(isParams)
      Sexp_write_items rest isParams head)
    (,()
      Sexp_write head ,(first)
      Sexp_write_items rest __FALSE__ first) ,(body)
  __String_concat__ "(" body ,(s)
  __String_concat__ s ")")

;; items の各要素を、空白で区切って acc の後ろにつなげる
(define Sexp_write_items ,(items isParams acc)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ items) (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ items ,(item rest)
  __if_then_else__ (,() __NULL__ isParams)
    (,() Sexp_write_param item)
    (,() Sexp_write item) ,(s)
  __String_concat__ acc " " ,(acc)
  __String_concat__ acc s ,(acc)
  Sexp_write_items rest isParams acc)

;; params の子。先頭が String のリストは名前のリストで、すべて文字列として書く
(define Sexp_write_param ,(item)
  __type_name__ item ,(type)
  __String_equal__ type "LList" ,(isList)
  __if_then_else__ (,() __NULL__ isList)
    (,()
      __LList_uncons__ __print_exit_error__ item ,(head rest)
      __type_name__ head ,(headType)
      __String_equal__ headType "String")
    (,() __NULL__ __FALSE__) ,(isNames)
  __if_then_else__ (,() __NULL__ isNames)
    (,()
      __LList_uncons__ __print_exit_error__ item ,(head rest)
      Sexp_quote head ,(first)
      Sexp_write_names rest first ,(body)
      __String_concat__ "(" body ,(s)
      __String_concat__ s ")")
    (,() Sexp_write item))

(define Sexp_write_names ,(names acc)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names) (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Sexp_quote name ,(s)
  __String_concat__ acc " " ,(acc)
  __String_concat__ acc s ,(acc)
  Sexp_write_names rest acc)

;; consh_parse と同じく \ " 改行 タブ 復帰 をエスケープして、" で囲む
(define Sexp_quote ,(str)
  __Token_escape__ str ,(s)
  __String_concat__ "\"" s ,(s)
  __String_concat__ s "\"")
