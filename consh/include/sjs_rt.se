  __Number_fromString__ __print_exit_error__ "2147483648" ,(half)
  __Number_subtract__ u half ,(d)
  __Number_is_negative__ d ,(small)
  __if_then_else__ small (,() __NULL__ u) (,() Sjs_two32 ,(m) __Number_subtract__ u m))

;; 32 ビットの符号なし整数 a と b の、ビットごとの演算 op（"&"、"|"、"^"）
(define Sjs_bits ,(op a b)
  Sjs_zero ,(zero)
  Sjs_one ,(one)
  __Number_fromString__ __print_exit_error__ "32" ,(n)
  Sjs_bits_loop op a b one zero n)

(define Sjs_bits_loop ,(op a b place acc n)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  Sjs_low_bit a ,(x a)
  Sjs_low_bit b ,(y b)
  __String_equal__ op "&" ,(isAnd)
  __String_equal__ op "|" ,(isOr)
  __and__ x y ,(both)
  __or__ x y ,(either)
  __not__ both ,(notBoth)
  __and__ either notBoth ,(one)
  __if_then_else__ isAnd (,() __NULL__ both) (,() __if_then_else__ isOr (,() __NULL__ either) (,() __NULL__ one)) ,(bit)
  __if_then_else__ bit (,() __Number_add__ acc place) (,() __NULL__ acc) ,(acc)
  __Number_multiply__ place two ,(place)
  Sjs_dec n ,(n)
  Sjs_bits_loop op a b place acc n)

;; 整数 a の最下位のビット（真偽値）と、a を 2 で割った整数部
(define Sjs_low_bit ,(a)
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __Number_divide__ __print_exit_error__ a two ,(h)
