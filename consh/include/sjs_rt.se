  __is_null__ b ,(test__) __if__ test__ (,() Sjs_reverse_list acc ,(r) Sjs_reverse_onto_list r a ,(m) return m) ,()
  __LList_uncons__ __print_exit_error__ a ,(x as)
  __LList_uncons__ __print_exit_error__ b ,(y bs)
  __Number_subtract__ y x ,(d)
  __Number_is_negative__ d ,(yFirst)
  __if__ yFirst (,() __LList_cons__ y acc ,(acc) Sjs_merge_numbers a bs acc ,(m) return m) ,()
  __LList_cons__ x acc ,(acc)
