  __String_equal__ kind "function" ,(test__) __if__ test__ (,() Sjs_members_find o ks ,(found v) return v) ,()
  __NULL__ __NULL__)

;; i 番目の文字（なければ undefined）
(define Sjs_char_at ,(s i)
