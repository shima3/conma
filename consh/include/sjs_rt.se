  __Dict_put__ o "keys" keys ,()
  __NULL__ o)

(define Sjs_obj_get ,(o key)
  __Dict_lookup_or__ o "props" __print_exit_error__ ,(props)
  __Dict_lookup_or__ props key (,(k) __NULL__ __NULL__))

;; k in o：o のメンバーに k があるか。オブジェクトは自分のメンバー、配列は要素のある添字（穴は偽）、ほかは
;; メンバー（"members"）と、読んで値のある名前（length、メソッド。プロトタイプはないので、SJS にあるメソッドだけ）。
;; 関数の length と name は、SJS では読めないが、JavaScript と同じく真。o がオブジェクトの類でなければ TypeError
(define Sjs_in_op ,(G k o)
  __Cont_get__ ,(return)
  Sjs_kind o ,(kind)
  Sjs_word_in kind "array object function generator asyncgen promise" ,(isObject)
  __unless__ isObject
    (,()
      Sjs_key_string k ,(ks)
      Sjs_to_string o ,(os)
      __String_concat__ "Cannot use 'in' operator to search for '" ks ,(msg)
      __String_concat__ msg "' in " ,(msg)
      __String_concat__ msg os ,(msg)
      Sjs_type_error msg) ,()
  __String_equal__ kind "array" ,(test__) __if__ test__
    (,()
      Sjs_index k ,(i)
      __is_null__ i ,(test__) __unless__ test__ (,() Sjs_array_has o i ,(h) return h) ,()) ,()
  Sjs_key_string k ,(ks)
  __String_equal__ kind "object" ,(test__) __if__ test__ (,() Sjs_obj_has o ks ,(h) return h) ,()
  Sjs_members_find o ks ,(found v)
  __if__ found (,() return __TRUE__) ,()
  __String_equal__ kind "function" ,(test__) __if__ test__ (,() Sjs_word_in ks "length name" ,(h) return h) ,()
  Sjs_get_member G o ks ,(m)
  __is_null__ m ,(none)
  __not__ none)

;; 配列と関数のメンバー（配列の添字でないもの、関数に入れたもの）は、"members" の SJS のオブジェクト（初めて入れる
;; ときに作る）に持つ。数えないメンバー（組み込みの関数とオブジェクトのメンバー、タグ付きテンプレートの raw）は、
;; props にだけ入れ、名前の一覧に入れない（エラーの name と message と同じ。Object.keys と JSON に出ない）

