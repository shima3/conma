  __Dict_lookup_or__ m "props" __print_exit_error__ ,(props)
  __Dict_lookup_or__ props k (,(x) return __FALSE__ __NULL__) ,(v)
  __NULL__ __TRUE__ v)

(define Sjs_members_of ,(G o)
  __Dict_lookup_or__ o "members" (,(k) Sjs_object_new G ,(m) __Dict_put__ o "members" m ,() __NULL__ m))

(define Sjs_members_set ,(G o k v)
