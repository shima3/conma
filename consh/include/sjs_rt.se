  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Number_toString__ i ,(k)
  __Dict_lookup_or__ items k (,(key) return __FALSE__) ,(x)
  __NULL__ __TRUE__)

;; 要素のある添字の LList（順に。穴を飛ばす）
(define Sjs_array_present ,(a)
