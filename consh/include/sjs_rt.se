;; SJS の実行時の支え（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。sjs_gen.se が作る ConMa のコードが呼ぶ。
;;
;; SJS の値の表し方：
;;   数        Number（IEEE 754 の倍精度。ConMa の Number と同じ）
;;   文字列    String
;;   真偽値    __TRUE__ と __FALSE__（ConMa では Closure）
;;   undefined __NULL__
;;   null      Ref（中身は使わない。SJS の値で Ref になるのは null だけ）
;;   関数      Dict。"t" に "function"、"f" に引数の LList を受け取る Closure、"id" に作った順の番号（=== で比べる）、
;;             "name" に名前（console.log に出す。なければ ""）、"props" に静的なメンバーの Dict（Number.isInteger など）
;;   配列      Dict。"t" に "array"、"id"、"items" に添字の String（"0"、"1"、…）から値への Dict、"length" に長さの Ref
;;   オブジェクト Dict。"t" に "object"、"id"、"props" に名前から値への Dict、"keys" に名前を足した順（逆順）の LList の Ref
;;             （プロトタイプはない。キーの順は、足した順だけ。JavaScript の整数のキーを先にする規則はない）
;; 文脈 G（Dict）には、組み込み（console、Math など）を名前で置き、"" に値の番号を数える Ref を置く（"" は SJS の名前に
;; ならない）。大域の名前（SJS変数）は、PDict の "sjs_vars" の Dict に置く（Sjs_global、Sjs_set_global）。組み込みが先。
;; ConSh から動かすとき（段階 B4。consh_jsstmt.se）は、ConSh が、評価する VProc の PDict に、SJS変数の Dict（"sjs_vars"）、
;; $名前 を引く関数（"sjs_shell"）、console.log の出力先（"sjs_out"）、受け手のない例外の行き先（"sjs_fail"）を置く。
;; 例外（段階 B3）：受け手の継続のスタックを PDict の "sjs_handlers" に置く（Sjs_try が積み、Sjs_raise が取り出して
;; 呼ぶ）。受け手がなければ、"sjs: " を付けてメッセージを標準エラーに出し、終了ステータス 2 で終える。
;; 実行時のエラー（TypeError など）は、隠した name と message を持つオブジェクト（"error" の印。JSON では {}、
;; String では "TypeError: メッセージ"。段階 A の Error と同じ見え方）にして投げる。文脈 G は PDict の "sjs_G" にも置く

;; ── 文脈と大域の名前 ──

(define Sjs_init ,()
  __Dict_new__ ,(G)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(counter)
  __Dict_put__ G "" counter ,()
  Sjs_builtins G ,()
  __PDict_put__ "sjs_G" G ,()
  __Dict_new__ ,(vars)
  __PDict_put__ "sjs_vars" vars ,()
  __NULL__ G)

;; ConSh のための文脈：組み込みと値の番号だけを作る（PDict は、評価するときに置く）
(define Sjs_context ,()
  __Dict_new__ ,(G)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(counter)
  __Dict_put__ G "" counter ,()
  Sjs_builtins G ,()
  __NULL__ G)

;; 大域の名前 name の値：組み込みか、SJS変数。なければ ReferenceError
(define Sjs_global ,(G name)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ G name (,(key) __NULL__ __NULL__) ,(builtin)
  __is_null__ builtin ,(test__) __unless__ test__ (,() return builtin) ,()
  __String_equal__ name "undefined" ,(test__) __if__ test__ (,() return __NULL__) ,()
  Sjs_vars ,(vars)
  __Dict_lookup_or__ vars name (,(key)
    __String_concat__ key " is not defined" ,(msg)
    Sjs_throw "ReferenceError" msg))

;; 大域の名前 name に v を入れる（SJS変数）。組み込みの名前には入れられない（段階 A の sjsScope と同じ）
(define Sjs_set_global ,(G name v)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ G name (,(key) __NULL__ __NULL__) ,(builtin)
  __is_null__ builtin ,(test__) __unless__ test__ (,() __String_concat__ "cannot assign to " name ,(msg) Sjs_type_error msg) ,()
  Sjs_vars ,(vars)
  __Dict_put__ vars name v)

(define Sjs_vars ,()
  __Cont_get__ ,(return)
  __PDict_lookup_or__ "sjs_vars" (,(k) __NULL__ __NULL__) ,(vars)
  __is_null__ vars ,(test__) __unless__ test__ (,() return vars) ,()
  __Dict_new__ ,(d)
  __PDict_put__ "sjs_vars" d ,()
  __NULL__ d)

;; $名前 の値（ConSh のシェル変数。consh/SAFEJS-PLAN-ja.md の 2.2 の 7）。PDict の "sjs_shell" の関数が引く
(define Sjs_shell_get ,(name)
  __PDict_lookup_or__ "sjs_shell" (,(k) __NULL__ __NULL__) ,(get)
  __is_null__ get ,(test__) __if__ test__ (,() __String_concat__ "undefined variable: " name ,(msg) Sjs_throw "ReferenceError" msg) ,()
  get name)

;; 演算子の被演算子の $名前 の数：数か、10 進の数の書き方の文字列。ほかは not a number のエラー（段階 A の sjsNumber）
(define Sjs_shell_number ,(v name)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "number" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "string" ,(isString)
  __if__ isString
    (,()
      Sjs_decimal_text v ,(ok)
      __if__ ok (,() __Number_fromString__ (,(m) __nop__) v ,(n) return n) ,()) ,()
  __String_concat__ "not a number: " name ,(msg)
  __if_then_else__ isString
    (,() Sjs_json_string v ,(q) __String_concat__ msg " (" ,(m) __String_concat__ m q ,(m) __String_concat__ m ")")
    (,() __NULL__ msg) ,(msg)
  Sjs_type_error msg)

;; ── エラー ──

(define Sjs_throw ,(name msg)
  ;; 変換するとき（G がない）は、そのまま出して終える
  __PDict_lookup_or__ "sjs_G" (,(k) __NULL__ __NULL__) ,(G)
  __is_null__ G ,(test__) __if__ test__ (,() __String_concat__ name ": " ,(s) __String_concat__ s msg ,(s) Sjs_uncaught s) ,()
  Sjs_error_object G name msg ,(e)
  Sjs_raise e)

;; 受け手のない例外：メッセージ text と、最後に実行した文の行（Sjs_line）を出して、終了ステータス 2 で終える
(define Sjs_uncaught ,(text)
  ;; ConSh から動かすときは、ConSh に渡す
  __PDict_lookup_or__ "sjs_fail" (,(k) __NULL__ __NULL__) ,(fail)
  __is_null__ fail ,(test__) __unless__ test__ (,() fail text) ,()
  __PDict_lookup_or__ "sjs_line" (,(k) __NULL__ __NULL__) ,(line)
  __is_null__ line ,(noLine)
  __if_then_else__ noLine (,() __NULL__ "sjs: ") (,() __String_concat__ "sjs: line " line ,(s) __String_concat__ s ": ") ,(s)
  __String_concat__ s text ,(s)
  __String_concat__ s "\n" ,(s)
  __OS_print_error__ s ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __OS_exit__ __print_exit_error__ two)

;; 文の行（変換したコードが、文ごとに呼ぶ）
(define Sjs_line ,(line)
  __PDict_put__ "sjs_line" line)

;; ── 例外 ──

(define Sjs_handlers ,()
  __PDict_lookup_or__ "sjs_handlers" (,(k) __NULL__ __NULL__))

(define Sjs_set_handlers ,(hs)
  __PDict_put__ "sjs_handlers" hs)

;; 値 v を投げる。いちばん内側の受け手を取り除いて、それに v を渡す。受け手がなければ終える
(define Sjs_raise ,(v)
  Sjs_handlers ,(hs)
  __is_null__ hs ,(none)
  __if__ none (,() Sjs_error_text v ,(t) Sjs_uncaught t) ,()
  __LList_uncons__ __print_exit_error__ hs ,(k rest)
  Sjs_set_handlers rest ,()
  k v)

;; 受け手のない例外のメッセージ：エラーのオブジェクトは "名前: メッセージ"、ほかは String(v)（段階 A の errorLine と同じ）
(define Sjs_error_text ,(v)
  Sjs_to_string v)

;; try { body } catch (e) { handler(e) }。body と handler は thunk と、値を受け取る Closure。
;; body がふつうに終われば、受け手を取り除いて戻る。投げられれば、受け手のスタックを try の前に戻して handler を呼ぶ
(define Sjs_try ,(body handler)
  __Cont_get__ ,(return)
  Sjs_handlers ,(saved)
  (,()
    __Cont_get__ ,(catchK)
    __LList_cons__ catchK saved ,(hs)
    Sjs_set_handlers hs ,()
    body ,()
    Sjs_set_handlers saved ,()
    return) ,(exc)
  Sjs_set_handlers saved ,()
  handler exc)

;; エラーのオブジェクト：name と message を、名前の一覧に入れずに持つ（Object.keys と JSON に出ない）
(define Sjs_error_object ,(G name msg)
  Sjs_object_new G ,(o)
  __Dict_lookup_or__ o "props" __print_exit_error__ ,(props)
  __Dict_put__ props "name" name ,()
  __Dict_put__ props "message" msg ,()
  __Dict_put__ o "error" __TRUE__ ,()
  __NULL__ o)

(define Sjs_type_error ,(msg)
  Sjs_throw "TypeError" msg)

;; ── 型 ──

;; SJS の値の種類："number"、"string"、"boolean"、"undefined"、"null"、"function"
(define Sjs_kind ,(v)
  __Cont_get__ ,(return)
  __type_name__ v ,(type)
  __String_equal__ type "Number" ,(test__) __if__ test__ (,() return "number") ,()
  __String_equal__ type "String" ,(test__) __if__ test__ (,() return "string") ,()
  __String_equal__ type "Closure" ,(test__) __if__ test__ (,() return "boolean") ,()
  __String_equal__ type "null" ,(test__) __if__ test__ (,() return "undefined") ,()
  __String_equal__ type "Ref" ,(test__) __if__ test__ (,() return "null") ,()
  __String_equal__ type "Dict" ,(test__) __if__ test__
    (,() __Dict_lookup_or__ v "t" __print_exit_error__ ,(t) return t) ,()
  __String_concat__ "an unknown value: " type ,(msg)
  Sjs_type_error msg)

;; typeof
(define Sjs_typeof ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return "object") ,()
  __String_equal__ kind "array" ,(test__) __if__ test__ (,() return "object") ,()
  __NULL__ kind)

(define Sjs_is_number ,(v)
  __type_name__ v ,(type)
  __String_equal__ type "Number")

;; JavaScript の真偽。偽は、false、0、-0、NaN、""、undefined、null
(define Sjs_truthy ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "boolean" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "string" ,(test__) __if__ test__
    (,() __String_equal__ v "" ,(empty) __not__ empty ,(t) return t) ,()
  __String_equal__ kind "number" ,(test__) __if__ test__
    (,()
      __Number_is_zero__ v ,(zero)
      __if__ zero (,() return __FALSE__) ,()
      Sjs_is_nan v ,(nan)
      __not__ nan ,(t)
      return t) ,()
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __NULL__ __TRUE__)

;; null か undefined か（??）
(define Sjs_is_nullish ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ kind "null")

;; エラーのメッセージの値の説明（conma.js の sjsDescribe と同じ）
(define Sjs_describe ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__
    (,()
      __String_length__ v ,(len)
      __Number_fromString__ __print_exit_error__ "20" ,(twenty)
      __Number_subtract__ len twenty ,(over)
      __Number_is_positive__ over ,(long)
      __if_then_else__ long
        (,()
          __Number_fromString__ __print_exit_error__ "0" ,(zero)
          __String_substring__ __print_exit_error__ v zero twenty ,(head)
          __String_concat__ head "..." ,(s) __NULL__ s)
        (,() __NULL__ v) ,(shown)
      Sjs_json_string shown ,(q)
      __String_concat__ "the string " q ,(s)
      return s) ,()
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return "undefined") ,()
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return "null") ,()
  __String_equal__ kind "function" ,(test__) __if__ test__ (,() return "a function") ,()
  __String_equal__ kind "array" ,(test__) __if__ test__ (,() return "an array") ,()
  __String_equal__ kind "object" ,(test__) __if__ test__ (,() return "an object") ,()
  Sjs_to_string v ,(s)
  __String_concat__ "the " kind ,(a)
  __String_concat__ a " " ,(a)
  __String_concat__ a s)

;; 文字列を JSON の文字列のリテラルにする（", \, 改行、タブ、復帰だけを逃がす）
(define Sjs_json_string ,(s)
  Sjs_chars s ,(chars)
  Sjs_json_chars chars "\"")

(define Sjs_json_chars ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() __String_concat__ acc "\"" ,(s) return s) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "\"" ,(q)
  __String_equal__ c "\\" ,(b)
  __String_equal__ c "\n" ,(n)
  __String_equal__ c "\t" ,(t)
  __String_equal__ c "\r" ,(r)
  __if_then_else__ q (,() __NULL__ "\\\"") (,()
  __if_then_else__ b (,() __NULL__ "\\\\") (,()
  __if_then_else__ n (,() __NULL__ "\\n") (,()
  __if_then_else__ t (,() __NULL__ "\\t") (,()
  __if_then_else__ r (,() __NULL__ "\\r") (,() __NULL__ c))))) ,(e)
  __String_concat__ acc e ,(acc)
  Sjs_json_chars rest acc)

;; 文字列の 1 文字ずつの LList
(define Sjs_chars ,(s)
  __String_length__ s ,(len)
  Sjs_chars_from s len __NULL__)

(define Sjs_chars_from ,(s i acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ i ,(test__) __if__ test__ (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ i one ,(j)
  __String_substring__ __print_exit_error__ s j i ,(c)
  __LList_cons__ c acc ,(acc)
  Sjs_chars_from s j acc)

;; ── 数 ──

(define Sjs_is_nan ,(n)
  __Number_toString__ n ,(s)
  __String_equal__ s "nan")

(define Sjs_infinity ,()
  __Number_fromString__ __print_exit_error__ "1e308" ,(big)
  __Number_fromString__ __print_exit_error__ "10" ,(ten)
  __Number_multiply__ big ten)

(define Sjs_nan ,()
  Sjs_infinity ,(inf)
  __Number_subtract__ inf inf)

;; 演算子 op の被演算子が数か確かめる（conma.js の sjsNeed と同じメッセージ）
(define Sjs_need ,(op v)
  __Cont_get__ ,(return)
  Sjs_is_number v ,(ok)
  __if__ ok return ,()
  Sjs_describe v ,(d)
  __String_concat__ op " needs numbers, not " ,(msg)
  __String_concat__ msg d ,(msg)
  __String_equal__ op "+" ,(plus)
  __String_equal__ op "+=" ,(plusEq)
  __or__ plus plusEq ,(join)
  __if_then_else__ join
    (,() __String_concat__ msg " (join strings with a template literal)")
    (,() __NULL__ msg) ,(msg)
  Sjs_type_error msg)

(define Sjs_need2 ,(op a b)
  Sjs_need op a ,()
  Sjs_need op b)

(define Sjs_add ,(a b)
  Sjs_need2 "+" a b ,()
  __Number_add__ a b)

(define Sjs_sub ,(a b)
  Sjs_need2 "-" a b ,()
  __Number_subtract__ a b)

(define Sjs_mul ,(a b)
  Sjs_need2 "*" a b ,()
  __Number_multiply__ a b)

;; a / b。0 で割れば、JavaScript と同じく Infinity、-Infinity か NaN（割る数の -0 は 0 と同じに扱う）
(define Sjs_div ,(a b)
  __Cont_get__ ,(return)
  Sjs_need2 "/" a b ,()
  __Number_divide__ (,(msg)
    Sjs_is_nan a ,(nan)
    __Number_is_zero__ a ,(zero)
    __or__ nan zero ,(undefinedRatio)
    __if__ undefinedRatio (,() Sjs_nan ,(n) return n) ,()
    Sjs_infinity ,(inf)
    __Number_is_negative__ a ,(neg)
    __if__ neg (,() __Number_fromString__ __print_exit_error__ "0" ,(z) __Number_subtract__ z inf ,(m) return m) ,()
    return inf) a b)

;; a % b：a - b * trunc(a / b)（JavaScript の % と同じく、結果の符号は a に合わせる）。0 で割れば NaN
(define Sjs_mod ,(a b)
  __Cont_get__ ,(return)
  Sjs_need2 "%" a b ,()
  __Number_is_zero__ b ,(zero)
  __if__ zero (,() Sjs_nan ,(n) return n) ,()
  __Number_divide__ __print_exit_error__ a b ,(q)
  Sjs_trunc q ,(t)
  __Number_multiply__ b t ,(m)
  __Number_subtract__ a m)

(define Sjs_trunc ,(x)
  __Cont_get__ ,(return)
  __Number_is_negative__ x ,(neg)
  __unless__ neg (,() __Number_floor__ x ,(f) return f) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_subtract__ zero x ,(y)
  __Number_floor__ y ,(f)
  __Number_subtract__ zero f)

(define Sjs_neg ,(v)
  Sjs_need "-" v ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_subtract__ zero v)

(define Sjs_pos ,(v)
  Sjs_need "+" v ,()
  __NULL__ v)

;; ++ と --：d は 1 か -1
(define Sjs_step ,(v d)
  __Number_is_positive__ d ,(up)
  __if_then_else__ up (,() __NULL__ "++") (,() __NULL__ "--") ,(op)
  Sjs_need op v ,()
  __Number_add__ v d)

;; ── 比べる ──

;; 大小の比較の被演算子：数どうしか、文字列どうし（conma.js の sjsCompare と同じメッセージ）。数なら真
(define Sjs_compare_kind ,(op a b)
  __Cont_get__ ,(return)
  Sjs_kind a ,(ka)
  Sjs_kind b ,(kb)
  __String_equal__ ka kb ,(same)
  __String_equal__ ka "number" ,(num)
  __String_equal__ ka "string" ,(str)
  __and__ same num ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __and__ same str ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Sjs_describe a ,(da)
  Sjs_describe b ,(db)
  __String_concat__ op " compares two numbers or two strings, not " ,(msg)
  __String_concat__ msg da ,(msg)
  __String_concat__ msg " and " ,(msg)
  __String_concat__ msg db ,(msg)
  Sjs_type_error msg)

;; a < b（数か文字列）
(define Sjs_less ,(a b)
  __Cont_get__ ,(return)
  Sjs_kind a ,(ka)
  __String_equal__ ka "number" ,(num)
  __if__ num (,() __Number_subtract__ a b ,(d) __Number_is_negative__ d ,(t) return t) ,()
  Sjs_chars a ,(ca)
  Sjs_chars b ,(cb)
  Sjs_less_chars ca cb)

;; 文字の LList の辞書順（文字の番号で比べる）
(define Sjs_less_chars ,(ca cb)
  __Cont_get__ ,(return)
  __is_null__ cb ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __is_null__ ca ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ ca ,(a rest1)
  __LList_uncons__ __print_exit_error__ cb ,(b rest2)
  __String_toCode__ __print_exit_error__ a ,(x)
  __String_toCode__ __print_exit_error__ b ,(y)
  __Number_subtract__ x y ,(d)
  __Number_is_negative__ d ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __Number_is_positive__ d ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Sjs_less_chars rest1 rest2)

(define Sjs_lt ,(a b)
  Sjs_compare_kind "<" a b ,(isNumber)
  Sjs_less a b)

(define Sjs_gt ,(a b)
  Sjs_compare_kind ">" a b ,(isNumber)
  Sjs_less b a)

;; a <= b は、b < a でなく、NaN を含まないとき（数の NaN は、どの比較も偽）
(define Sjs_le ,(a b)
  Sjs_compare_kind "<=" a b ,(isNumber)
  Sjs_not_greater a b)

(define Sjs_ge ,(a b)
  Sjs_compare_kind ">=" a b ,(isNumber)
  Sjs_not_greater b a)

(define Sjs_not_greater ,(a b)
  __Cont_get__ ,(return)
  Sjs_kind a ,(ka)
  __String_equal__ ka "number" ,(num)
  __if__ num
    (,()
      Sjs_is_nan a ,(n1)
      Sjs_is_nan b ,(n2)
      __or__ n1 n2 ,(test__) __if__ test__ (,() return __FALSE__) ,()) ,()
  Sjs_less b a ,(greater)
  __not__ greater)

;; a === b
(define Sjs_seq ,(a b)
  __Cont_get__ ,(return)
  Sjs_kind a ,(ka)
  Sjs_kind b ,(kb)
  __String_equal__ ka kb ,(same)
  __unless__ same (,() return __FALSE__) ,()
  __String_equal__ ka "undefined" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ ka "null" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __String_equal__ ka "string" ,(test__) __if__ test__ (,() __String_equal__ a b ,(t) return t) ,()
  __String_equal__ ka "boolean" ,(test__) __if__ test__
    (,()
      __and__ a b ,(both)
      __or__ a b ,(either)
      __not__ either ,(neither)
      __or__ both neither ,(t)
      return t) ,()
  __String_equal__ ka "number" ,(test__) __if__ test__
    (,()
      ;; 差が 0 か、同じ無限大（Infinity - Infinity は NaN）。NaN はどれとも等しくない
      __Number_subtract__ a b ,(d)
      __Number_is_zero__ d ,(test__) __if__ test__ (,() return __TRUE__) ,()
      Sjs_is_nan a ,(nan)
      __if__ nan (,() return __FALSE__) ,()
      __Number_toString__ a ,(sa)
      __Number_toString__ b ,(sb)
      __String_equal__ sa sb ,(t)
      return t) ,()
  ;; 関数（とオブジェクト）は、同じものか（番号で比べる）
  __Dict_lookup_or__ a "id" __print_exit_error__ ,(ia)
  __Dict_lookup_or__ b "id" __print_exit_error__ ,(ib)
  __Number_subtract__ ia ib ,(d)
  __Number_is_zero__ d)

;; ── 関数 ──

;; 値の番号（関数、配列、オブジェクトの "id"）
(define Sjs_new_id ,(G)
  __Dict_lookup_or__ G "" __print_exit_error__ ,(counter)
  __Ref_get__ counter ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(n)
  __Ref_set__ counter n ,()
  __NULL__ n)

;; 引数の LList を受け取る Closure f から、名前 name（なければ ""）の SJS の関数の値を作る
(define Sjs_function ,(G name f)
  Sjs_new_id G ,(n)
  __Dict_new__ ,(fn)
  __Dict_put__ fn "t" "function" ,()
  __Dict_put__ fn "f" f ,()
  __Dict_put__ fn "id" n ,()
  __Dict_put__ fn "name" name ,()
  __NULL__ fn)

;; f(args)。args は引数の LList
(define Sjs_call ,(f args)
  __Cont_get__ ,(return)
  Sjs_kind f ,(kind)
  __String_equal__ kind "function" ,(ok)
  __unless__ ok (,() Sjs_describe f ,(d) __String_concat__ d " is not a function" ,(msg) Sjs_type_error msg) ,()
  __Dict_lookup_or__ f "f" __print_exit_error__ ,(closure)
  closure args)

;; 引数の LList の最初と残り。なければ undefined と空
(define Sjs_arg ,(args)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return __NULL__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ args)

;; ── 文字列にする ──

;; String(v)
(define Sjs_to_string ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__ (,() return v) ,()
  __String_equal__ kind "number" ,(test__) __if__ test__ (,() Sjs_num_str v ,(s) return s) ,()
  __String_equal__ kind "boolean" ,(test__) __if__ test__
    (,() __if_then_else__ v (,() __NULL__ "true") (,() __NULL__ "false") ,(s) return s) ,()
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return "undefined") ,()
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return "null") ,()
  __String_equal__ kind "array" ,(test__) __if__ test__ (,() Sjs_join v "," ,(s) return s) ,()
  __String_equal__ kind "object" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ v "error" (,(k) return "[object Object]") ,(isError)
      Sjs_obj_get v "name" ,(name)
      Sjs_obj_get v "message" ,(msg)
      Sjs_to_string name ,(n)
      Sjs_to_string msg ,(m)
      __String_concat__ n ": " ,(s)
      __String_concat__ s m ,(s)
      return s) ,()
  __NULL__ "function () { [native code] }")

;; 数を、JavaScript の String(n) と同じ形にする。ConMa の __Number_toString__ は、最も短い桁を出すが、
;; 指数の形（1e-07）と、指数にする範囲が JavaScript と違うので、桁と小数点の位置に分けてから書き直す
(define Sjs_num_str ,(n)
  __Cont_get__ ,(return)
  __Number_toString__ n ,(repr)
  __String_equal__ repr "inf" ,(test__) __if__ test__ (,() return "Infinity") ,()
  __String_equal__ repr "-inf" ,(test__) __if__ test__ (,() return "-Infinity") ,()
  __String_equal__ repr "nan" ,(test__) __if__ test__ (,() return "NaN") ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __String_substring__ __print_exit_error__ repr zero one ,(first)
  __String_equal__ first "-" ,(negative)
  __String_length__ repr ,(len)
  __if_then_else__ negative
    (,() __String_substring__ __print_exit_error__ repr one len)
    (,() __NULL__ repr) ,(body)
  __if_then_else__ negative (,() __NULL__ "-") (,() __NULL__ "") ,(sign)
  ;; 仮数と指数
  __String_find__ __print_exit_error__ body "e" zero ,(e)
  __String_length__ body ,(blen)
  __is_null__ e ,(noExp)
  __if_then_else__ noExp
    (,() __NULL__ body zero)
    (,()
      __String_substring__ __print_exit_error__ body zero e ,(mant)
      __Number_add__ e one ,(es)
      __String_substring__ __print_exit_error__ body es blen ,(expText)
      Sjs_parse_int expText ,(exp)
      __NULL__ mant exp) ,(mant exp)
  ;; 整数部と小数部
  __String_find__ __print_exit_error__ mant "." zero ,(dot)
  __String_length__ mant ,(mlen)
  __is_null__ dot ,(noDot)
  __if_then_else__ noDot
    (,() __NULL__ mant "")
    (,()
      __String_substring__ __print_exit_error__ mant zero dot ,(ip)
      __Number_add__ dot one ,(fs)
      __String_substring__ __print_exit_error__ mant fs mlen ,(fp)
      __NULL__ ip fp) ,(ip fp)
  __String_concat__ ip fp ,(digits)
  __String_length__ ip ,(ilen)
  __Number_add__ ilen exp ,(point)
  Sjs_strip_leading_zeros digits point ,(digits point)
  Sjs_strip_trailing_zeros digits ,(digits)
  __String_equal__ digits "" ,(test__) __if__ test__ (,() return "0") ,()
  Sjs_render digits point ,(s)
  __String_concat__ sign s)

;; 10 進の整数の String（+ か - で始まってもよい）を Number にする
(define Sjs_parse_int ,(s)
  __Cont_get__ ,(return)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __String_substring__ __print_exit_error__ s zero one ,(first)
  __String_equal__ first "+" ,(plus)
  __String_length__ s ,(len)
  __if__ plus (,() __String_substring__ __print_exit_error__ s one len ,(rest) __Number_fromString__ __print_exit_error__ rest ,(n) return n) ,()
  __Number_fromString__ __print_exit_error__ s)

(define Sjs_strip_leading_zeros ,(digits point)
  __Cont_get__ ,(return)
  __String_length__ digits ,(len)
  __Number_is_zero__ len ,(test__) __if__ test__ (,() return digits point) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __String_substring__ __print_exit_error__ digits zero one ,(c)
  __String_equal__ c "0" ,(isZero)
  __unless__ isZero (,() return digits point) ,()
  __String_substring__ __print_exit_error__ digits one len ,(rest)
  __Number_subtract__ point one ,(point)
  Sjs_strip_leading_zeros rest point)

(define Sjs_strip_trailing_zeros ,(digits)
  __Cont_get__ ,(return)
  __String_length__ digits ,(len)
  __Number_is_zero__ len ,(test__) __if__ test__ (,() return digits) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ digits last len ,(c)
  __String_equal__ c "0" ,(isZero)
  __unless__ isZero (,() return digits) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_substring__ __print_exit_error__ digits zero last ,(rest)
  Sjs_strip_trailing_zeros rest)

;; 桁 digits（先頭も末尾も 0 でない）と小数点の位置 point（値は 0.digits × 10^point）から、
;; JavaScript の Number::toString の形を作る（ECMAScript の 6.1.6.1.20）
(define Sjs_render ,(digits point)
  __Cont_get__ ,(return)
  __String_length__ digits ,(k)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_fromString__ __print_exit_error__ "21" ,(n21)
  __Number_fromString__ __print_exit_error__ "-6" ,(nm6)
  ;; k <= point <= 21：桁の後に 0 を足す
  __Number_subtract__ point k ,(extra)
  __Number_is_negative__ extra ,(short)
  __Number_subtract__ n21 point ,(room)
  __Number_is_negative__ room ,(tooBig)
  __not__ short ,(test1)
  __not__ tooBig ,(test2)
  __and__ test1 test2 ,(test__) __if__ test__
    (,() Sjs_zeros extra ,(z) __String_concat__ digits z ,(s) return s) ,()
  ;; 0 < point <= 21：途中に小数点
  __Number_is_positive__ point ,(positive)
  __and__ positive test2 ,(test__) __if__ test__
    (,()
      __String_substring__ __print_exit_error__ digits zero point ,(a)
      __String_substring__ __print_exit_error__ digits point k ,(b)
      __String_concat__ a "." ,(s)
      __String_concat__ s b ,(s)
      return s) ,()
  ;; -6 < point <= 0：0. と 0 の後に桁
  __Number_subtract__ point nm6 ,(above)
  __Number_is_positive__ above ,(aboveMin)
  __not__ positive ,(notPositive)
  __and__ aboveMin notPositive ,(test__) __if__ test__
    (,()
      __Number_subtract__ zero point ,(nz)
      Sjs_zeros nz ,(z)
      __String_concat__ "0." z ,(s)
      __String_concat__ s digits ,(s)
      return s) ,()
  ;; 指数の形：d.ddde+n
  __Number_subtract__ point one ,(e)
  __String_substring__ __print_exit_error__ digits zero one ,(lead)
  __String_substring__ __print_exit_error__ digits one k ,(tail)
  __String_equal__ tail "" ,(noTail)
  __if_then_else__ noTail (,() __NULL__ lead) (,() __String_concat__ lead "." ,(s) __String_concat__ s tail) ,(m)
  __Number_is_negative__ e ,(neg)
  __if_then_else__ neg (,() __Number_subtract__ zero e ,(a) __NULL__ "-" a) (,() __NULL__ "+" e) ,(esign eabs)
  __Number_toString__ eabs ,(es)
  __String_concat__ m "e" ,(s)
  __String_concat__ s esign ,(s)
  __String_concat__ s es)

(define Sjs_zeros ,(n)
  Sjs_zeros_acc n "")

(define Sjs_zeros_acc ,(n acc)
  __Cont_get__ ,(return)
  __Number_is_positive__ n ,(more)
  __unless__ more (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  __String_concat__ acc "0" ,(acc)
  Sjs_zeros_acc n acc)

;; ── console ──

;; console.log(...args)：値を空白でつないで、標準出力に 1 行で出す。ConSh の段階 A（conma.js の inspect）と同じく、
;; 文字列はそのまま、配列とオブジェクトは JSON.stringify、ほかは String。ConSh から動かすときは、PDict の "sjs_out" の関数に
;; 行（改行なし）を渡す
(define Sjs_log ,(args)
  __Cont_get__ ,(return)
  Sjs_log_join args "" __TRUE__ ,(line)
  __PDict_lookup_or__ "sjs_out" (,(k) __NULL__ __NULL__) ,(out)
  __is_null__ out ,(test__) __unless__ test__ (,() out line ,() return) ,()
  __String_concat__ line "\n" ,(line)
  __OS_print__ line)

(define Sjs_log_join ,(args acc first)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ args ,(v rest)
  Sjs_console_string v ,(s)
  __if_then_else__ first (,() __NULL__ acc) (,() __String_concat__ acc " ") ,(acc)
  __String_concat__ acc s ,(acc)
  Sjs_log_join rest acc __FALSE__)

;; ════ 段階 B2：配列、オブジェクト、メンバー、組み込み ════

(define Sjs_zero ,() __Number_fromString__ __print_exit_error__ "0")
(define Sjs_one ,() __Number_fromString__ __print_exit_error__ "1")
(define Sjs_inc ,(n) Sjs_one ,(one) __Number_add__ n one)
(define Sjs_dec ,(n) Sjs_one ,(one) __Number_subtract__ n one)

;; ── 配列 ──

(define Sjs_array_new ,(G)
  Sjs_new_id G ,(id)
  __Dict_new__ ,(a)
  __Dict_put__ a "t" "array" ,()
  __Dict_put__ a "id" id ,()
  __Dict_new__ ,(items)
  __Dict_put__ a "items" items ,()
  Sjs_zero ,(zero)
  __Ref_new__ zero ,(len)
  __Dict_put__ a "length" len ,()
  __NULL__ a)

;; 値の LList から配列を作る
(define Sjs_array ,(G list)
  Sjs_array_new G ,(a)
  Sjs_array_push_list a list ,()
  __NULL__ a)

(define Sjs_array_length ,(a)
  __Dict_lookup_or__ a "length" __print_exit_error__ ,(ref)
  __Ref_get__ ref)

(define Sjs_array_push ,(a v)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Dict_lookup_or__ a "length" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  __Number_toString__ n ,(k)
  __Dict_put__ items k v ,()
  Sjs_inc n ,(n)
  __Ref_set__ ref n)

(define Sjs_array_push_list ,(a list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(v rest)
  Sjs_array_push a v ,()
  Sjs_array_push_list a rest)

;; i 番目（Number）の値。なければ undefined
(define Sjs_array_get ,(a i)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Number_toString__ i ,(k)
  __Dict_lookup_or__ items k (,(key) __NULL__ __NULL__))

;; i 番目に v を入れる。長さを越えれば、長さを i + 1 にする（間は undefined）
(define Sjs_array_set ,(a i v)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Number_toString__ i ,(k)
  __Dict_put__ items k v ,()
  __Dict_lookup_or__ a "length" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  __Number_subtract__ i n ,(d)
  __Number_is_negative__ d ,(test__) __if__ test__ return ,()
  Sjs_inc i ,(n)
  __Ref_set__ ref n)

;; 値の LList（順に。空いた所は undefined）
(define Sjs_array_list ,(a)
  Sjs_array_length a ,(n)
  Sjs_array_list_from a n __NULL__)

(define Sjs_array_list_from ,(a i acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ i ,(test__) __if__ test__ (,() return acc) ,()
  Sjs_dec i ,(i)
  Sjs_array_get a i ,(v)
  __LList_cons__ v acc ,(acc)
  Sjs_array_list_from a i acc)

;; ── オブジェクト ──

(define Sjs_object_new ,(G)
  Sjs_new_id G ,(id)
  __Dict_new__ ,(o)
  __Dict_put__ o "t" "object" ,()
  __Dict_put__ o "id" id ,()
  __Dict_new__ ,(props)
  __Dict_put__ o "props" props ,()
  __Ref_new__ __NULL__ ,(keys)
  __Dict_put__ o "keys" keys ,()
  __NULL__ o)

(define Sjs_obj_get ,(o key)
  __Dict_lookup_or__ o "props" __print_exit_error__ ,(props)
  __Dict_lookup_or__ props key (,(k) __NULL__ __NULL__))

(define Sjs_obj_has ,(o key)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ o "props" __print_exit_error__ ,(props)
  __Dict_lookup_or__ props key (,(k) return __FALSE__) ,(v)
  __NULL__ __TRUE__)

(define Sjs_obj_set ,(o key v)
  __Dict_lookup_or__ o "props" __print_exit_error__ ,(props)
  Sjs_obj_has o key ,(had)
  __Dict_put__ props key v ,()
  __if__ had (,() __nop__) ,()
  __not__ had ,(isNew)
  __if__ isNew
    (,()
      __Dict_lookup_or__ o "keys" __print_exit_error__ ,(ref)
      __Ref_get__ ref ,(keys)
      __LList_cons__ key keys ,(keys)
      __Ref_set__ ref keys))

;; 名前の LList。JavaScript と同じく、配列の添字の形の名前（"0"、"12"）を小さい順に先に、ほかを足した順に
(define Sjs_obj_keys ,(o)
  __Dict_lookup_or__ o "keys" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(keys)
  Sjs_reverse_list keys ,(keys)
  Sjs_split_index_keys keys __NULL__ __NULL__ ,(ints others)
  Sjs_sort_numbers ints ,(ints)
  Sjs_numbers_to_strings ints ,(ints)
  __LList_append__ ints others)

;; 添字の形の名前（Number にしたもの、逆順）と、ほかの名前（順のまま）
(define Sjs_split_index_keys ,(keys ints others)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() Sjs_reverse_list others ,(o) return ints o) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_index k ,(i)
  __is_null__ i ,(test__) __if__ test__
    (,() __LList_cons__ k others ,(others) Sjs_split_index_keys rest ints others ,(a b) return a b) ,()
  __LList_cons__ i ints ,(ints)
  Sjs_split_index_keys rest ints others)

;; 数の LList を小さい順に（挿入ソート）
(define Sjs_sort_numbers ,(list)
  Sjs_sort_numbers_into list __NULL__)

(define Sjs_sort_numbers_into ,(list sorted)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return sorted) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Sjs_insert_number x sorted ,(sorted)
  Sjs_sort_numbers_into rest sorted)

(define Sjs_insert_number ,(x sorted)
  __Cont_get__ ,(return)
  __is_null__ sorted ,(test__) __if__ test__ (,() __LList_cons__ x __NULL__ ,(l) return l) ,()
  __LList_uncons__ __print_exit_error__ sorted ,(y rest)
  __Number_subtract__ x y ,(d)
  __Number_is_positive__ d ,(after)
  __unless__ after (,() __LList_cons__ x sorted ,(l) return l) ,()
  Sjs_insert_number x rest ,(rest)
  __LList_cons__ y rest)

(define Sjs_numbers_to_strings ,(list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ list ,(n rest)
  __Number_toString__ n ,(k)
  Sjs_numbers_to_strings rest ,(rest)
  __LList_cons__ k rest)

(define Sjs_reverse_list ,(list)
  Sjs_reverse_list_onto list __NULL__)

(define Sjs_reverse_list_onto ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  __LList_cons__ head acc ,(acc)
  Sjs_reverse_list_onto tail acc)

;; 名前と値の組の LList（(名前 値) の LList の LList）から、オブジェクトを作る
(define Sjs_object ,(G pairs)
  Sjs_object_new G ,(o)
  Sjs_object_fill o pairs ,()
  __NULL__ o)

(define Sjs_object_fill ,(o pairs)
  __Cont_get__ ,(return)
  __is_null__ pairs ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ pairs ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(key more)
  __LList_uncons__ __print_exit_error__ more ,(v more)
  Sjs_obj_set o key v ,()
  Sjs_object_fill o rest)

;; ── キー ──

;; 計算したキー（a[k]）。数ならそのまま、ほかは文字列にし、SJS の外に出るキー（constructor など）はエラー（conma.js の sjsKey）
(define Sjs_key ,(k)
  __Cont_get__ ,(return)
  Sjs_is_number k ,(test__) __if__ test__ (,() return k) ,()
  Sjs_to_string k ,(s)
  Sjs_bad_property s ,(bad)
  __unless__ bad (,() return s) ,()
  __String_concat__ "the property " s ,(msg)
  __String_concat__ msg " is not in SJS" ,(msg)
  Sjs_type_error msg)

(define Sjs_bad_property ,(s)
  __Cont_get__ ,(return)
  __NULL__ (,(name) __String_equal__ s name ,(t) __if__ t (,() return __TRUE__)) ,(is)
  is "constructor" ,() is "prototype" ,() is "caller" ,() is "callee" ,() is "arguments" ,()
  Sjs_str_starts s "__")

(define Sjs_str_starts ,(s prefix)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __String_length__ prefix ,(plen)
  __Number_subtract__ len plen ,(d)
  __Number_is_negative__ d ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Sjs_zero ,(zero)
  __String_substring__ __print_exit_error__ s zero plen ,(head)
  __String_equal__ head prefix)

;; キーが配列の添字（0 以上の整数か、その 10 進の書き方の文字列）なら、その Number。そうでなければ null
(define Sjs_index ,(key)
  __Cont_get__ ,(return)
  Sjs_is_number key ,(isNum)
  __unless__ isNum
    (,()
      __Number_fromString__ (,(m) return __NULL__) key ,(n)
      __Number_toString__ n ,(back)
      __String_equal__ back key ,(canonical)
      __unless__ canonical (,() return __NULL__) ,()
      Sjs_index n ,(i)
      return i) ,()
  __Number_is_negative__ key ,(test__) __if__ test__ (,() return __NULL__) ,()
  __Number_floor__ key ,(f)
  __Number_subtract__ key f ,(d)
  __Number_is_zero__ d ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __NULL__ key)

(define Sjs_key_string ,(key)
  Sjs_to_string key)

;; ── メンバー ──

;; o[key] と o.key（key は String か Number）
(define Sjs_get_member ,(G o key)
  __Cont_get__ ,(return)
  Sjs_key_string key ,(ks)
  Sjs_kind o ,(kind)
  __String_equal__ kind "undefined" ,(u)
  __String_equal__ kind "null" ,(n)
  __or__ u n ,(test__) __if__ test__
    (,()
      __String_concat__ "Cannot read properties of " kind ,(msg)
      __String_concat__ msg " (reading '" ,(msg)
      __String_concat__ msg ks ,(msg)
