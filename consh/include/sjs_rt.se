  Sjs_nan ,(nan)
  __Dict_put__ G "NaN" nan ,()
  ;; Promise（段階 B5b）
  Sjs_object_new G ,(promise)
  Sjs_def G promise "resolve" (,(args) Sjs_arg args ,(v rest) Sjs_promise_coerce G v) ,()
  Sjs_def G promise "reject" (,(args) Sjs_arg args ,(e rest) Sjs_promise_new G ,(p) Sjs_promise_reject p e ,() __NULL__ p) ,()
  Sjs_def G promise "all" (,(args) Sjs_arg args ,(v rest) Sjs_promise_all G v) ,()
  __Dict_put__ G "Promise" promise)

;; Object.keys などの名前：オブジェクトは名前、配列は要素のある添字と、添字でないメンバー（"members"）、文字列は添字、
;; 関数などは入れたメンバー。数と真偽値は空。null と undefined は TypeError
(define Sjs_own_keys ,(o)
  __Cont_get__ ,(return)
  Sjs_kind o ,(kind)
  __String_equal__ kind "object" ,(test__) __if__ test__ (,() Sjs_obj_keys o ,(l) return l) ,()
  Sjs_is_nullish o ,(test__) __if__ test__ (,() Sjs_type_error "Cannot convert undefined or null to object") ,()
  __String_equal__ kind "array" ,(test__) __if__ test__ (,() Sjs_array_keys o ,(l) return l) ,()
  __String_equal__ kind "string" ,(test__) __if__ test__ (,() __String_length__ o ,(n) Sjs_index_strings n __NULL__ ,(l) return l) ,()
  ;; 関数などは、入れたメンバー。数と真偽値は空
  __type_name__ o ,(type)
  __String_equal__ type "Dict" ,(isDict)
  __unless__ isDict (,() return __NULL__) ,()
  Sjs_members_keys o)

;; 配列の名前：要素のある添字の文字列と、添字でないメンバーの名前
(define Sjs_array_keys ,(a)
  Sjs_array_present a ,(idx)
  Sjs_number_strings idx __NULL__ ,(ks)
  Sjs_members_keys a ,(more)
  Sjs_reverse_list ks ,(rev)
  Sjs_reverse_onto_list rev more)

(define Sjs_reverse_onto_list ,(rev acc)
  __Cont_get__ ,(return)
  __is_null__ rev ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ rev ,(x rest)
  __LList_cons__ x acc ,(acc)
  Sjs_reverse_onto_list rest acc)

(define Sjs_own_values ,(G o keys)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_get_member G o k ,(v)
  Sjs_own_values G o rest ,(vs)
  __LList_cons__ v vs)

(define Sjs_own_entries ,(G o keys)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_get_member G o k ,(v)
  __LList_cons__ v __NULL__ ,(pair)
  __LList_cons__ k pair ,(pair)
  Sjs_array G pair ,(entry)
  Sjs_own_entries G o rest ,(es)
  __LList_cons__ entry es)

;; Math.max（isMax が真）と Math.min。引数を数にする。NaN があれば NaN
(define Sjs_extreme ,(args best isMax)
  __Cont_get__ ,(return)
  __is_null__ args ,(test__) __if__ test__ (,() return best) ,()
  __LList_uncons__ __print_exit_error__ args ,(v rest)
  Sjs_to_number v ,(n)
  Sjs_is_nan n ,(test__) __if__ test__ (,() return n) ,()
  __Number_is_zero__ n ,(zn)
  __Number_is_zero__ best ,(zb)
  __and__ zn zb ,(zeros)
  ;; 0 と -0：JavaScript では -0 が小さい。max は和（-0 + -0 だけが -0）、min は -(-a + -b)
  __if__ zeros
    (,()
      __if_then_else__ isMax
        (,() __Number_add__ best n)
        (,() Sjs_minus best ,(a) Sjs_minus n ,(b) __Number_add__ a b ,(s) Sjs_minus s) ,(best)
      Sjs_extreme rest best isMax ,(r)
      return r) ,()
  __if_then_else__ isMax (,() Sjs_less best n) (,() Sjs_less n best) ,(better)
  __if_then_else__ better (,() __NULL__ n) (,() __NULL__ best) ,(best)
  Sjs_extreme rest best isMax)

(define Sjs_is_integer ,(v)
  __Cont_get__ ,(return)
  Sjs_is_number v ,(num)
  __unless__ num (,() return __FALSE__) ,()
  __Number_floor__ v ,(f)
  __Number_subtract__ v f ,(d)
  __Number_is_zero__ d)

;; parseInt：前の空白を除き、符号と 10 進の数字の並びを読む。数字がなければ NaN
(define Sjs_parse_int_prefix ,(s)
  Sjs_trim s ,(t)
  Sjs_chars t ,(chars)
  __is_null__ chars ,(empty)
  __if_then_else__ empty (,() __NULL__ "" __NULL__) (,() __LList_uncons__ __print_exit_error__ chars ,(c rest) Sjs_in_chars c "+-" ,(sign) __if_then_else__ sign (,() __NULL__ c rest) (,() __NULL__ "" chars)) ,(sign digits)
  Sjs_take_digits digits "" ,(ds)
  __String_equal__ ds "" ,(none)
  __if_then_else__ none (,() Sjs_nan) (,() __String_concat__ sign ds ,(n) Sjs_parse_int n))

(define Sjs_take_digits ,(chars acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Sjs_in_chars c "0123456789" ,(ok)
  __unless__ ok (,() return acc) ,()
  __String_concat__ acc c ,(acc)
  Sjs_take_digits rest acc)

;; ════ 段階 B4：ConSh から動かすモジュールに渡す関数 ════
;; 変換したモジュール（sjs_gen.se の Sjs_translate_module）は何も include しないので、実行時の支えの関数と、標準の関数
;; （__TRUE__ など）を、この Dict で受け取り、同じ名前の局所変数に束縛する（名前の一覧は sjs_gen.se の Sjs_rt_names）

(define Sjs_rt_dict ,()
  __Dict_new__ ,(rt)
  __NULL__ (,(name f) __Dict_put__ rt name f) ,(put)
  put "__TRUE__" __TRUE__ ,() put "__FALSE__" __FALSE__ ,() put "__not__" __not__ ,() put "__nop__" __nop__ ,()
  put "__print_exit_error__" __print_exit_error__ ,()
  put "Sjs_add" Sjs_add ,() put "Sjs_arg" Sjs_arg ,() put "Sjs_array" Sjs_array ,() put "Sjs_call" Sjs_call ,()
  put "Sjs_call_member" Sjs_call_member ,() put "Sjs_div" Sjs_div ,() put "Sjs_function" Sjs_function ,()
  put "Sjs_ge" Sjs_ge ,() put "Sjs_get_member" Sjs_get_member ,() put "Sjs_global" Sjs_global ,() put "Sjs_gt" Sjs_gt ,()
  put "Sjs_handlers" Sjs_handlers ,() put "Sjs_is_nullish" Sjs_is_nullish ,() put "Sjs_iter_keys" Sjs_iter_keys ,()
  put "Sjs_iter_values" Sjs_iter_values ,() put "Sjs_key" Sjs_key ,() put "Sjs_key_string" Sjs_key_string ,()
  put "Sjs_le" Sjs_le ,() put "Sjs_reraise" Sjs_reraise ,() put "Sjs_lt" Sjs_lt ,() put "Sjs_mod" Sjs_mod ,() put "Sjs_mul" Sjs_mul ,()
  put "Sjs_neg" Sjs_neg ,() put "Sjs_object" Sjs_object ,() put "Sjs_pos" Sjs_pos ,() put "Sjs_raise" Sjs_raise ,()
  put "Sjs_seq" Sjs_seq ,() put "Sjs_set_global" Sjs_set_global ,() put "Sjs_set_handlers" Sjs_set_handlers ,()
  put "Sjs_set_member" Sjs_set_member ,() put "Sjs_shell_get" Sjs_shell_get ,() put "Sjs_shell_number" Sjs_shell_number ,()
  put "Sjs_step" Sjs_step ,() put "Sjs_sub" Sjs_sub ,() put "Sjs_throw" Sjs_throw ,() put "Sjs_to_string" Sjs_to_string ,()
  put "Sjs_truthy" Sjs_truthy ,() put "Sjs_try" Sjs_try ,() put "Sjs_type_error" Sjs_type_error ,() put "Sjs_typeof" Sjs_typeof ,()
  put "Sjs_pow" Sjs_pow ,() put "Sjs_band" Sjs_band ,() put "Sjs_bor" Sjs_bor ,() put "Sjs_bxor" Sjs_bxor ,() put "Sjs_bnot" Sjs_bnot ,()
  put "Sjs_shl" Sjs_shl ,() put "Sjs_shr" Sjs_shr ,() put "Sjs_ushr" Sjs_ushr ,()
  put "Sjs_is_undefined" Sjs_is_undefined ,() put "Sjs_array_new" Sjs_array_new ,() put "Sjs_array_push" Sjs_array_push ,()
  put "Sjs_array_list" Sjs_array_list ,() put "Sjs_spread_into" Sjs_spread_into ,() put "Sjs_object_new" Sjs_object_new ,()
  put "Sjs_obj_set" Sjs_obj_set ,() put "Sjs_object_spread" Sjs_object_spread ,() put "Sjs_object_rest" Sjs_object_rest ,()
  put "Sjs_case_runs" Sjs_case_runs ,()
  put "Sjs_generator" Sjs_generator ,() put "Sjs_yield" Sjs_yield ,() put "Sjs_yield_star" Sjs_yield_star ,()
  put "Sjs_iter_open" Sjs_iter_open ,() put "Sjs_iter_more" Sjs_iter_more ,() put "Sjs_iter_take" Sjs_iter_take ,()
  put "Sjs_try_catch" Sjs_try_catch ,()
  put "Sjs_async" Sjs_async ,() put "Sjs_await" Sjs_await ,() put "Sjs_run_jobs" Sjs_run_jobs ,() put "Sjs_need" Sjs_need ,() put "Sjs_eq_num" Sjs_eq_num ,() put "Sjs_ne_num" Sjs_ne_num ,() put "Sjs_get_index" Sjs_get_index ,() put "Sjs_array_hole" Sjs_array_hole ,() put "Sjs_iter_next" Sjs_iter_next ,() put "Sjs_iter_rest" Sjs_iter_rest ,() put "Sjs_iter_close" Sjs_iter_close ,() put "Sjs_set_index" Sjs_set_index ,() put "Sjs_template_strings" Sjs_template_strings ,() put "Sjs_async_generator" Sjs_async_generator ,() put "Sjs_ag_yield" Sjs_ag_yield ,() put "Sjs_ag_yield_star" Sjs_ag_yield_star ,() put "Sjs_aiter_open" Sjs_aiter_open ,() put "Sjs_aiter_more" Sjs_aiter_more ,() put "Sjs_aiter_close" Sjs_aiter_close ,() put "Sjs_in_op" Sjs_in_op ,() put "Sjs_pattern_open" Sjs_pattern_open ,() put "Sjs_pattern_next" Sjs_pattern_next ,() put "Sjs_pattern_rest" Sjs_pattern_rest ,() put "Sjs_pattern_close" Sjs_pattern_close ,() put "Sjs_eq_lit" Sjs_eq_lit ,() put "Sjs_ne_lit" Sjs_ne_lit ,()
  put "Sjs_wasm_module" Sjs_wasm_module ,() put "Sjs_wasm_fn_checked" Sjs_wasm_fn_checked ,()
  __NULL__ rt)


;; ── ** とビット演算（段階 B4。段階 A と同じく、数だけ）──

;; a ** b：b が整数なら掛け算で（負なら逆数）、b が 0.5 なら平方根。ほかの b はまだ変換しない
(define Sjs_pow ,(a b)
  __Cont_get__ ,(return)
  Sjs_need2 "**" a b ,()
  Sjs_is_integer b ,(integer)
  __unless__ integer
    (,()
      __Number_fromString__ __print_exit_error__ "0.5" ,(half)
      __Number_subtract__ b half ,(d)
      ;; 指数 0.5 は平方根。ただし JavaScript と同じく、0 と -0 は +0、-Infinity は Infinity（平方根では -0 と NaN）
      __Number_is_zero__ d ,(test__) __if__ test__
        (,()
          __Number_is_zero__ a ,(test__) __if__ test__ (,() Sjs_zero ,(z) return z) ,()
          Sjs_is_infinite a ,(infA) __Number_is_negative__ a ,(negA) __and__ infA negA ,(test__)
          __if__ test__ (,() Sjs_infinity ,(inf) return inf) ,()
          __Number_sqrt__ (,(m) Sjs_nan) a ,(r) return r) ,()
      Sjs_type_error "not yet translated to ConMa: ** with an exponent that is not an integer") ,()
  __Number_is_negative__ b ,(neg)
  __if_then_else__ neg (,() Sjs_neg b) (,() __NULL__ b) ,(n)
  Sjs_one ,(one)
  Sjs_pow_loop a n one ,(r)
  __unless__ neg (,() return r) ,()
  Sjs_div one r)

;; 二乗を繰り返す
(define Sjs_pow_loop ,(x n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __Number_divide__ __print_exit_error__ n two ,(h)
  __Number_floor__ h ,(half)
  __Number_multiply__ half two ,(even)
  __Number_subtract__ n even ,(bit)
  __Number_is_zero__ bit ,(isEven)
  __if_then_else__ isEven (,() __NULL__ acc) (,() __Number_multiply__ acc x) ,(acc)
  __Number_multiply__ x x ,(x)
  Sjs_pow_loop x half acc)

;; ビット演算（& | ^ ~ << >> >>>）は sjs_bits.se：高速版（consh/include）は高速版 ConMa のプリミティブ（"bitwise32"）を、
;; 参照版（consh/reference）は算術で 1 ビットずつ求める（docs/BITWISE-PLAN-ja.md の W6）

;; ── 段階 B4：分割代入、スプレッド、switch ──

(define Sjs_is_undefined ,(v)
  Sjs_kind v ,(kind)
  __String_equal__ kind "undefined")

;; 配列 a に、v の中身（配列は要素、文字列は文字）を足す（...v）
(define Sjs_spread_into ,(a v)
  Sjs_iter_values v ,(list)
  Sjs_array_push_list a list)

;; オブジェクト o に、v の名前と値を足す（{...v}）。配列と文字列は添字、null と undefined は何も足さない
(define Sjs_object_spread ,(o v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "object" ,(isObject)
  __if__ isObject (,() Sjs_obj_keys v ,(keys) Sjs_copy_props o v keys ,() return) ,()
  __String_equal__ kind "array" ,(isArray)
  __String_equal__ kind "string" ,(isString)
  __or__ isArray isString ,(indexed)
  __unless__ indexed return ,()
  Sjs_iter_keys v ,(keys)
  Sjs_iter_values v ,(vals)
  Sjs_copy_pairs o keys vals)

(define Sjs_copy_props ,(o v keys)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_obj_get v k ,(x)
  Sjs_obj_set o k x ,()
  Sjs_copy_props o v rest)

(define Sjs_copy_pairs ,(o keys vals)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k krest)
  __LList_uncons__ __print_exit_error__ vals ,(x vrest)
  Sjs_obj_set o k x ,()
  Sjs_copy_pairs o krest vrest)

;; {a, ...rest} の rest：v（オブジェクト）の名前のうち used（取り出した名前の LList）にないものの新しいオブジェクト
(define Sjs_object_rest ,(G v used)
  Sjs_object_new G ,(o)
  Sjs_kind v ,(kind)
  __String_equal__ kind "object" ,(isObject)
  __if__ isObject
    (,()
      Sjs_obj_keys v ,(keys)
      Sjs_copy_unused o v keys used) ,()
  __NULL__ o)

(define Sjs_copy_unused ,(o v keys used)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_list_has_string used k ,(skip)
  __unless__ skip (,() Sjs_obj_get v k ,(x) Sjs_obj_set o k x) ,()
  Sjs_copy_unused o v rest used)

(define Sjs_list_has_string ,(list s)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Sjs_to_string x ,(xs)
  __String_equal__ xs s ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Sjs_list_has_string rest s)

;; switch：一致した番号 start（Number。なければ -1）から、番号 k（String）の case を実行するか
(define Sjs_case_runs ,(start k)
  __Cont_get__ ,(return)
  __Number_is_negative__ start ,(none)
  __if__ none (,() return __FALSE__) ,()
  __Number_fromString__ __print_exit_error__ k ,(n)
  __Number_subtract__ n start ,(d)
  __Number_is_negative__ d ,(before)
  __not__ before)

;; ── 段階 B5：ジェネレータ ──
;; ジェネレータのオブジェクトは Dict で、"t" は "generator"、"body" は本体の thunk（値は return の値）、"G" は文脈、
;; "state" は Ref（"start"、"suspended"、"running"、"done"）。本体は、最初の next で、その next の上で動き始める。
;; yield は、本体に戻る継続（"resume"。(mode value) を受け取る）を覚えて、next の継続（"caller"）に結果を渡す。
;; 次の next は、そのときの継続を "caller" にして "resume" を呼ぶ。継続は、作った VProc の外でも呼べるので、
;; 別の (( )) の評価（別の VProc）からも続けられる。本体の受け手のスタックは、next を呼んだ所のものと別にし
;; （"bodyH"）、いちばん下の受け手（境）が、本体から出た例外を、今の next を呼んだ所に投げ直す。
;; return(v) は、yield の所から「return の印」を投げ、catch は通り抜け、finally は実行して、境で終える

(define Sjs_generator ,(G body)
  Sjs_new_id G ,(n)
  __Dict_new__ ,(gen)
  __Dict_put__ gen "t" "generator" ,()
  __Dict_put__ gen "id" n ,()
  __Dict_put__ gen "G" G ,()
  __Dict_put__ gen "body" body ,()
  __Ref_new__ "start" ,(state)
  __Dict_put__ gen "state" state ,()
  Sjs_list5 "resume" "caller" "callerH" "prev" "bodyH" ,(names)
  Sjs_gen_refs gen names ,()
  Sjs_gen_ctx_save ,(ctx)
  __Dict_put__ gen "ctx" ctx ,()
  __NULL__ gen)

(define Sjs_gen_refs ,(gen names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  __Ref_new__ __NULL__ ,(r)
  __Dict_put__ gen name r ,()
  Sjs_gen_refs gen rest)

(define Sjs_gen_ref ,(gen name)
  __Dict_lookup_or__ gen name __print_exit_error__)

;; 作ったときの PDict の文脈（シェルから値を読むとき、Sjs_gen_ctx_restore で置く）
(define Sjs_gen_ctx_save ,()
  Sjs_list5 "sjs_G" "sjs_vars" "sjs_shell" "sjs_out" "sjs_pos" ,(keys)
  Sjs_gen_ctx_loop keys __NULL__)

(define Sjs_list5 ,(a b c d e)
  __LList_cons__ e __NULL__ ,(l)
  __LList_cons__ d l ,(l)
  __LList_cons__ c l ,(l)
  __LList_cons__ b l ,(l)
  __LList_cons__ a l)

(define Sjs_gen_ctx_loop ,(keys acc)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  __PDict_lookup_or__ k (,(key) __NULL__ __NULL__) ,(v)
  __LList_cons__ v __NULL__ ,(pair)
  __LList_cons__ k pair ,(pair)
  __LList_cons__ pair acc ,(acc)
  Sjs_gen_ctx_loop rest acc)

(define Sjs_gen_ctx_restore ,(pairs)
  __Cont_get__ ,(return)
  __is_null__ pairs ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ pairs ,(pair rest)
  __LList_uncons__ __print_exit_error__ pair ,(k more)
  __LList_uncons__ __print_exit_error__ more ,(v more)
  __PDict_put__ k v ,()
  Sjs_gen_ctx_restore rest)

;; {value: v, done: d}
(define Sjs_gen_result ,(G v done)
  Sjs_object_new G ,(o)
  Sjs_obj_set o "value" v ,()
  Sjs_obj_set o "done" done ,()
  __NULL__ o)

;; next(x)、throw(x)、return(x)（mode は "next"、"throw"、"return"）。結果のオブジェクトを返す
(define Sjs_gen_resume ,(gen mode x)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ gen "G" __print_exit_error__ ,(G)
  Sjs_gen_ref gen "state" ,(stateRef)
  __Ref_get__ stateRef ,(state)
  __String_equal__ state "running" ,(test__) __if__ test__ (,() Sjs_type_error "Generator is already running") ,()
  __String_equal__ mode "next" ,(isNext)
  __String_equal__ mode "throw" ,(isThrow)
  __String_equal__ state "done" ,(done)
  __String_equal__ state "start" ,(start)
  __not__ isNext ,(notNext)
  __and__ start notNext ,(endAtStart)
  __or__ done endAtStart ,(test__) __if__ test__
    (,()
      __Ref_set__ stateRef "done" ,()
      __if__ isThrow (,() Sjs_raise x) ,()
      __if_then_else__ isNext (,() __NULL__ __NULL__) (,() __NULL__ x) ,(v)
      Sjs_gen_result G v __TRUE__ ,(r)
      return r) ,()
  ;; 入る：今の next の継続と、呼んだ所の受け手のスタックと "sjs_gen" を覚える
  Sjs_gen_ref gen "caller" ,(callerRef)
  __Ref_set__ callerRef return ,()
  Sjs_handlers ,(hs)
  Sjs_gen_ref gen "callerH" ,(callerH)
  __Ref_set__ callerH hs ,()
  __PDict_lookup_or__ "sjs_gen" (,(k) __NULL__ __NULL__) ,(prev)
  Sjs_gen_ref gen "prev" ,(prevRef)
  __Ref_set__ prevRef prev ,()
  __PDict_put__ "sjs_gen" gen ,()
  __Ref_set__ stateRef "running" ,()
  __if__ start
    (,()
      __LList_cons__ (,(exc) Sjs_gen_escape gen exc) __NULL__ ,(bodyHs)
      Sjs_set_handlers bodyHs ,()
      __Dict_lookup_or__ gen "body" __print_exit_error__ ,(body)
      body ,(v)
      Sjs_gen_leave gen v __TRUE__) ,()
  Sjs_gen_ref gen "bodyH" ,(bodyH)
  __Ref_get__ bodyH ,(bodyHs)
  Sjs_set_handlers bodyHs ,()
  Sjs_gen_ref gen "resume" ,(resumeRef)
  __Ref_get__ resumeRef ,(resume)
  resume mode x)

;; 本体から出る：呼んだ所の受け手のスタックと "sjs_gen" を戻し、next の継続に {value: v, done} を渡す
(define Sjs_gen_leave ,(gen v done)
  __Dict_lookup_or__ gen "G" __print_exit_error__ ,(G)
  Sjs_gen_ref gen "state" ,(stateRef)
  __if_then_else__ done (,() __NULL__ "done") (,() __NULL__ "suspended") ,(state)
  __Ref_set__ stateRef state ,()
  Sjs_gen_restore gen ,()
  Sjs_gen_result G v done ,(r)
  Sjs_gen_ref gen "caller" ,(callerRef)
  __Ref_get__ callerRef ,(k)
  k r)

(define Sjs_gen_restore ,(gen)
  Sjs_gen_ref gen "callerH" ,(callerH)
  __Ref_get__ callerH ,(hs)
  Sjs_set_handlers hs ,()
  Sjs_gen_ref gen "prev" ,(prevRef)
  __Ref_get__ prevRef ,(prev)
  __PDict_put__ "sjs_gen" prev)

;; 本体の境の受け手：return の印なら、その値で終える。ほかの例外は、終えてから next を呼んだ所に投げ直す
(define Sjs_gen_escape ,(gen exc)
  Sjs_kind exc ,(kind)
  __String_equal__ kind "genreturn" ,(test__) __if__ test__
    (,() __Dict_lookup_or__ exc "value" __print_exit_error__ ,(v) Sjs_gen_leave gen v __TRUE__) ,()
  Sjs_gen_ref gen "state" ,(stateRef)
  __Ref_set__ stateRef "done" ,()
  Sjs_gen_restore gen ,()
  Sjs_reraise exc)

;; yield v：止まって v を出し、続けられたら next に渡された値を返す（throw なら投げ、return なら return の印を投げる）
(define Sjs_yield ,(v)
  __Cont_get__ ,(return)
  Sjs_yield_wait v ,(mode x)
  __String_equal__ mode "next" ,(test__) __if__ test__ (,() return x) ,()
  __String_equal__ mode "throw" ,(test__) __if__ test__ (,() Sjs_raise x) ,()
  __Dict_new__ ,(mark)
  __Dict_put__ mark "t" "genreturn" ,()
  __Dict_put__ mark "value" x ,()
  Sjs_reraise mark)

(define Sjs_yield_wait ,(v)
  __Cont_get__ ,(resume)
  __PDict_lookup_or__ "sjs_gen" (,(k) __NULL__ __NULL__) ,(gen)
  Sjs_gen_ref gen "resume" ,(resumeRef)
  __Ref_set__ resumeRef resume ,()
  Sjs_handlers ,(hs)
  Sjs_gen_ref gen "bodyH" ,(bodyH)
  __Ref_set__ bodyH hs ,()
  Sjs_gen_leave gen v __FALSE__)

;; yield* v：v の値を 1 つずつ yield し、v がジェネレータなら、その戻り値を返す
(define Sjs_yield_star ,(v)
  Sjs_iter_open v ,(it)
  Sjs_yield_star_loop it)

(define Sjs_yield_star_loop ,(it)
  __Cont_get__ ,(return)
  Sjs_iter_more it ,(more)
  __unless__ more (,() __Dict_lookup_or__ it "ret" (,(k) return __NULL__) ,(r) __Ref_get__ r ,(rv) return rv) ,()
  Sjs_iter_take it ,(x)
  Sjs_yield x ,(sent)
  Sjs_yield_star_loop it)

;; ジェネレータのメソッド
(define Sjs_gen_method ,(G gen name)
  __Cont_get__ ,(return)
  __NULL__ (,(m) __String_equal__ name m ,(t) __if__ t
    (,() Sjs_function G m (,(args) Sjs_arg args ,(x rest) Sjs_gen_resume gen m x) ,(fn) return fn)) ,(method)
  method "next" ,()
  method "return" ,()
  method "throw" ,()
  __NULL__ __NULL__)

;; ── 繰り返しの手順（for...of、yield*）：配列と文字列は値の LList から、ジェネレータは next で 1 つずつ ──

(define Sjs_iter_open ,(v)
  __Cont_get__ ,(return)
  __Dict_new__ ,(it)
  Sjs_kind v ,(kind)
  __String_equal__ kind "generator" ,(test__) __if__ test__
    (,()
      __Dict_put__ it "gen" v ,()
      __Ref_new__ __NULL__ ,(buf)
      __Dict_put__ it "buf" buf ,()
      __Ref_new__ __NULL__ ,(ret)
      __Dict_put__ it "ret" ret ,()
      return it) ,()
  Sjs_iter_values v ,(list)
  __Ref_new__ list ,(ref)
  __Dict_put__ it "list" ref ,()
  __NULL__ it)

;; 残りがあるか（ジェネレータなら next を呼んで、値を "buf" に置く）
(define Sjs_iter_more ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "list" (,(k) __NULL__ __NULL__) ,(ref)
  __is_null__ ref ,(test__) __unless__ test__ (,() __Ref_get__ ref ,(l) __is_null__ l ,(e) __not__ e ,(m) return m) ,()
  __Dict_lookup_or__ it "gen" __print_exit_error__ ,(gen)
  Sjs_gen_resume gen "next" __NULL__ ,(r)
  Sjs_obj_get r "done" ,(done)
  Sjs_obj_get r "value" ,(v)
  __if__ done (,() __Dict_lookup_or__ it "ret" __print_exit_error__ ,(ret) __Ref_set__ ret v ,() __Dict_put__ it "done" __TRUE__ ,() return __FALSE__) ,()
  __Dict_lookup_or__ it "buf" __print_exit_error__ ,(buf)
  __Ref_set__ buf v ,()
  __NULL__ __TRUE__)

;; 次の値（Sjs_iter_more が真を返した後に呼ぶ）
(define Sjs_iter_take ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "list" (,(k) __NULL__ __NULL__) ,(ref)
  __is_null__ ref ,(test__) __unless__ test__
    (,() __Ref_get__ ref ,(l) __LList_uncons__ __print_exit_error__ l ,(x rest) __Ref_set__ ref rest ,() return x) ,()
  __Dict_lookup_or__ it "buf" __print_exit_error__ ,(buf)
  __Ref_get__ buf)

;; 残りの値をすべて、逆順の LList にする（スプレッド、分割代入）
(define Sjs_iter_drain ,(it acc)
  __Cont_get__ ,(return)
  Sjs_iter_more it ,(more)
  __unless__ more (,() return acc) ,()
  Sjs_iter_take it ,(x)
  __LList_cons__ x acc ,(acc)
  Sjs_iter_drain it acc)

;; catch のある try：return の印（ジェネレータの return(v)）は受けずに通す
(define Sjs_try_catch ,(body handler)
  Sjs_try body (,(exc)
    Sjs_kind exc ,(kind)
    __String_equal__ kind "genreturn" ,(test__) __if__ test__ (,() Sjs_reraise exc) ,()
    ;; catch が受けたので、投げた所の位置を消す（後の受け手のない例外に、古い位置を出さない）
    __PDict_put__ "sjs_pos" __NULL__ ,()
    handler exc))

;; ── 段階 B5b：Promise、async、await ──
;; Promise は Dict で、"t" は "promise"、"state" は Ref（"pending"、"fulfilled"、"rejected"）、"value" は Ref、
;; "reactions" は、決着を待つ (成功の Closure 失敗の Closure) の逆順の LList の Ref、"handled" は、受け手が付いたか、
;; "resolved" は、resolve か reject が呼ばれたか（2 度目からは何もしない）。
;; 決着したときと、決着した Promise に受け手を付けたときは、受け手を呼ぶジョブを、PDict の "sjs_jobs" の列
;; （マイクロタスクの列）に入れる。Sjs_run_jobs が列を最後まで動かす（ConSh は評価ごと、consh/sjs/sjs は最後に）。
;; 列が空になったとき、受け手のない拒否された Promise があれば、受け手のない例外にする。
;; async 関数は、本体をジェネレータの本体として動かし（Sjs_async）、await は yield にする（Sjs_await）。
;; 本体が止まるたびに、await した値の Promise に、本体を続けるジョブを受け手として付ける

(define Sjs_promise_new ,(G)
  Sjs_new_id G ,(n)
  __Dict_new__ ,(p)
  __Dict_put__ p "t" "promise" ,()
  __Dict_put__ p "id" n ,()
  __Ref_new__ "pending" ,(state)
  __Dict_put__ p "state" state ,()
  __Ref_new__ __NULL__ ,(value)
  __Dict_put__ p "value" value ,()
  __Ref_new__ __NULL__ ,(reactions)
  __Dict_put__ p "reactions" reactions ,()
  __Ref_new__ __FALSE__ ,(handled)
  __Dict_put__ p "handled" handled ,()
  __Ref_new__ __FALSE__ ,(resolved)
  __Dict_put__ p "resolved" resolved ,()
  __NULL__ p)

(define Sjs_promise_ref ,(p name)
  __Dict_lookup_or__ p name __print_exit_error__ ,(r)
  __Ref_get__ r)

;; Promise.resolve(v)：Promise ならそのまま、ほかは v で成功した Promise
(define Sjs_promise_coerce ,(G v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "promise" ,(test__) __if__ test__ (,() return v) ,()
  Sjs_promise_new G ,(p)
  Sjs_promise_settle p "fulfilled" v ,()
  __NULL__ p)

;; resolve(v)：v が Promise なら、ジョブで v の決着を p に写す。p 自身なら TypeError で拒否する
(define Sjs_promise_resolve ,(p v)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "resolved" __print_exit_error__ ,(resolved)
  __Ref_get__ resolved ,(done)
  __if__ done return ,()
  __Ref_set__ resolved __TRUE__ ,()
  Sjs_seq p v ,(test__) __if__ test__
    (,()
      __PDict_lookup_or__ "sjs_G" (,(k) __NULL__ __NULL__) ,(G)
      Sjs_error_object G "TypeError" "Chaining cycle detected for promise #<Promise>" ,(e)
      Sjs_promise_settle p "rejected" e ,()
      return) ,()
  Sjs_kind v ,(kind)
  __String_equal__ kind "promise" ,(test__) __if__ test__
    (,()
      Sjs_enqueue (,() Sjs_promise_then v (,(x) Sjs_promise_settle p "fulfilled" x) (,(e) Sjs_promise_settle p "rejected" e)) ,()
      return) ,()
  Sjs_promise_settle p "fulfilled" v)

(define Sjs_promise_reject ,(p e)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "resolved" __print_exit_error__ ,(resolved)
  __Ref_get__ resolved ,(done)
  __if__ done return ,()
  __Ref_set__ resolved __TRUE__ ,()
  ;; 受け手のない拒否のメッセージの位置（Sjs_unhandled_check）：エラーのオブジェクトなら作った所、ほかは、拒否のもとに
  ;; なった例外を投げた所（"sjs_pos"。async 関数の本体の throw など）。"sjs_pos" は使ったので消す（後の拒否に古い位置を
  ;; 出さない。Promise.reject(値) のように投げずに拒否したものは、位置がない）
  __PDict_lookup_or__ "sjs_pos" (,(k) __NULL__ __NULL__) ,(thrown)
  __PDict_put__ "sjs_pos" __NULL__ ,()
  Sjs_error_pos e thrown ,(pos)
  __Dict_put__ p "pos" pos ,()
  Sjs_promise_settle p "rejected" e)

;; v がエラーのオブジェクトで、作った所の位置を持てばそれ、なければ other
(define Sjs_error_pos ,(v other)
  __Cont_get__ ,(return)
  __type_name__ v ,(t)
  __String_equal__ t "Dict" ,(d)
  __unless__ d (,() return other) ,()
  __Dict_lookup_or__ v "pos" (,(k) __NULL__ other))

;; 決着させ、待っている受け手のジョブを、付けた順に列に入れる
(define Sjs_promise_settle ,(p state v)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "state" __print_exit_error__ ,(stateRef)
  __Ref_get__ stateRef ,(now)
  __String_equal__ now "pending" ,(test__) __unless__ test__ return ,()
  __Ref_set__ stateRef state ,()
  __Dict_lookup_or__ p "value" __print_exit_error__ ,(valueRef)
  __Ref_set__ valueRef v ,()
  __Dict_lookup_or__ p "reactions" __print_exit_error__ ,(reactionsRef)
  __Ref_get__ reactionsRef ,(rev)
  __Ref_set__ reactionsRef __NULL__ ,()
  Sjs_reverse_list rev ,(reactions)
  __String_equal__ state "fulfilled" ,(ok)
  Sjs_promise_fire reactions ok v ,()
  __if__ ok return ,()
  Sjs_promise_ref p "handled" ,(handled)
  __if__ handled return ,()
  ;; 受け手のない拒否：列が空になったときに、まだ受け手がなければ、受け手のない例外にする
  __PDict_lookup_or__ "sjs_unhandled" (,(k) __NULL__ __NULL__) ,(list)
  __LList_cons__ p list ,(list)
  __PDict_put__ "sjs_unhandled" list)

(define Sjs_promise_fire ,(reactions ok v)
  __Cont_get__ ,(return)
  __is_null__ reactions ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ reactions ,(r rest)
  __LList_uncons__ __print_exit_error__ r ,(onOk more)
  __LList_uncons__ __print_exit_error__ more ,(onFail more)
  __if_then_else__ ok (,() __NULL__ onOk) (,() __NULL__ onFail) ,(f)
  Sjs_enqueue (,() f v) ,()
  Sjs_promise_fire rest ok v)

;; p に受け手（ConMa の Closure）を付ける
(define Sjs_promise_then ,(p onOk onFail)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "handled" __print_exit_error__ ,(handled)
  __Ref_set__ handled __TRUE__ ,()
  Sjs_promise_ref p "state" ,(state)
  Sjs_promise_ref p "value" ,(v)
  __String_equal__ state "fulfilled" ,(test__) __if__ test__ (,() Sjs_enqueue (,() onOk v) ,() return) ,()
  __String_equal__ state "rejected" ,(test__) __if__ test__ (,() Sjs_enqueue (,() onFail v) ,() return) ,()
  __LList_cons__ onFail __NULL__ ,(r)
  __LList_cons__ onOk r ,(r)
  __Dict_lookup_or__ p "reactions" __print_exit_error__ ,(reactionsRef)
  __Ref_get__ reactionsRef ,(rs)
  __LList_cons__ r rs ,(rs)
  __Ref_set__ reactionsRef rs)

;; then、catch、finally
(define Sjs_promise_method ,(G p name)
  __Cont_get__ ,(return)
  __NULL__ (,(m f) __String_equal__ name m ,(t) __if__ t (,() Sjs_function G m f ,(fn) return fn)) ,(method)
  method "then" (,(args)
    Sjs_arg args ,(f rest)
    Sjs_arg rest ,(r rest)
    Sjs_promise_derive G p f r) ,()
  method "catch" (,(args)
    Sjs_arg args ,(r rest)
    Sjs_promise_derive G p __NULL__ r) ,()
  ;; finally(f)：仕様どおり、f の戻り値を Promise にして、その決着の後に、同じ値か理由を渡す
  method "finally" (,(args)
    Sjs_arg args ,(f rest)
    Sjs_kind f ,(fk)
    __String_equal__ fk "function" ,(isFn)
    __unless__ isFn (,() Sjs_promise_derive G p f f) ,()
    Sjs_function G "" (,(as)
      Sjs_arg as ,(v rest)
      Sjs_call f __NULL__ ,(y)
      Sjs_promise_coerce G y ,(c)
      Sjs_function G "" (,(bs) __NULL__ v) ,(back)
      Sjs_promise_derive G c back __NULL__) ,(onOk)
    Sjs_function G "" (,(as)
      Sjs_arg as ,(e rest)
      Sjs_call f __NULL__ ,(y)
      Sjs_promise_coerce G y ,(c)
      Sjs_function G "" (,(bs) Sjs_reraise e) ,(thrower)
      Sjs_promise_derive G c thrower __NULL__) ,(onFail)
    Sjs_promise_derive G p onOk onFail) ,()
  __NULL__ __NULL__)

;; p.then(f, r) の Promise
(define Sjs_promise_derive ,(G p f r)
  Sjs_promise_new G ,(q)
  Sjs_kind f ,(fk)
  __String_equal__ fk "function" ,(hasF)
  Sjs_kind r ,(rk)
  __String_equal__ rk "function" ,(hasR)
  Sjs_promise_then p
    (,(v) __if_then_else__ hasF (,() Sjs_promise_handler q f v (,(x) Sjs_promise_resolve q x)) (,() Sjs_promise_resolve q v))
    (,(e) __if_then_else__ hasR (,() Sjs_promise_handler q r e (,(x) Sjs_promise_resolve q x)) (,() Sjs_promise_reject q e)) ,()
  __NULL__ q)

;; SJS の関数 f を x で呼び、戻り値を k に渡す（f が関数でなければ undefined を渡す）。投げられたら q を拒否する
(define Sjs_promise_handler ,(q f x k)
  __Cont_get__ ,(return)
  Sjs_kind f ,(kind)
  __String_equal__ kind "function" ,(isFn)
  __Ref_new__ __NULL__ ,(out)
  Sjs_try
    (,()
      __if_then_else__ isFn (,() __LList_cons__ x __NULL__ ,(args) Sjs_call f args) (,() __NULL__ __NULL__) ,(y)
      __Ref_set__ out y)
    (,(e) Sjs_promise_reject q e ,() return) ,()
  __Ref_get__ out ,(y)
  k y)

;; Promise.all(配列)
(define Sjs_promise_all ,(G v)
  __Cont_get__ ,(return)
  Sjs_promise_new G ,(p)
  Sjs_iter_values v ,(items)
  Sjs_array_new G ,(results)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Sjs_promise_all_count items zero ,(n)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() Sjs_promise_resolve p results ,() return p) ,()
  __Ref_new__ n ,(left)
  Sjs_promise_all_each G p results left items zero ,()
  __NULL__ p)

(define Sjs_promise_all_count ,(items n)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ (,() return n) ,()
  __LList_uncons__ __print_exit_error__ items ,(x rest)
  Sjs_inc n ,(n)
  Sjs_promise_all_count rest n)

(define Sjs_promise_all_each ,(G p results left items i)
  __Cont_get__ ,(return)
  __is_null__ items ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ items ,(x rest)
  Sjs_set_member G results i __NULL__ ,()
  Sjs_promise_coerce G x ,(q)
  Sjs_promise_then q
    (,(v)
      Sjs_set_member G results i v ,()
      __Ref_get__ left ,(n)
      Sjs_dec n ,(n)
      __Ref_set__ left n ,()
      __Number_is_zero__ n ,(test__) __if__ test__ (,() Sjs_promise_resolve p results) ,())
    (,(e) Sjs_promise_reject p e) ,()
  Sjs_inc i ,(i)
  Sjs_promise_all_each G p results left rest i)

;; ── マイクロタスクの列 ──

(define Sjs_jobs ,()
  __Cont_get__ ,(return)
  __PDict_lookup_or__ "sjs_jobs" (,(k) __NULL__ __NULL__) ,(q)
  __is_null__ q ,(test__) __unless__ test__ (,() return q) ,()
  __Dict_new__ ,(q)
  __Ref_new__ __NULL__ ,(in)
  __Dict_put__ q "in" in ,()
  __Ref_new__ __NULL__ ,(out)
  __Dict_put__ q "out" out ,()
  __PDict_put__ "sjs_jobs" q ,()
  __NULL__ q)

(define Sjs_enqueue ,(job)
  Sjs_jobs ,(q)
  __Dict_lookup_or__ q "in" __print_exit_error__ ,(in)
  __Ref_get__ in ,(l)
  __LList_cons__ job l ,(l)
  __Ref_set__ in l)

;; 次のジョブ（なければ null）
(define Sjs_dequeue ,()
  __Cont_get__ ,(return)
  Sjs_jobs ,(q)
  __Dict_lookup_or__ q "out" __print_exit_error__ ,(out)
  __Ref_get__ out ,(l)
  __is_null__ l ,(test__) __unless__ test__
    (,() __LList_uncons__ __print_exit_error__ l ,(job rest) __Ref_set__ out rest ,() return job) ,()
  __Dict_lookup_or__ q "in" __print_exit_error__ ,(in)
  __Ref_get__ in ,(rev)
  __is_null__ rev ,(test__) __if__ test__ (,() return __NULL__) ,()
  __Ref_set__ in __NULL__ ,()
  Sjs_reverse_list rev ,(l)
  __LList_uncons__ __print_exit_error__ l ,(job rest)
  __Ref_set__ out rest ,()
  __NULL__ job)

;; 列が空になるまでジョブを動かし、受け手のない拒否があれば、受け手のない例外にする
(define Sjs_run_jobs ,()
  __Cont_get__ ,(return)
  Sjs_dequeue ,(job)
  __is_null__ job ,(test__) __unless__ test__ (,() job ,() Sjs_run_jobs ,() return) ,()
  __PDict_lookup_or__ "sjs_unhandled" (,(k) __NULL__ __NULL__) ,(list)
  __PDict_put__ "sjs_unhandled" __NULL__ ,()
  Sjs_reverse_list list ,(list)
  Sjs_unhandled_check list)

(define Sjs_unhandled_check ,(list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ list ,(p rest)
  Sjs_promise_ref p "handled" ,(handled)
  __if__ handled (,() Sjs_unhandled_check rest ,() return) ,()
  Sjs_promise_ref p "value" ,(e)
  Sjs_error_text e ,(t)
  __String_concat__ "Uncaught (in promise) " t ,(msg)
  __Dict_lookup_or__ p "pos" (,(k) __NULL__ __NULL__) ,(pos)
  __PDict_put__ "sjs_pos" pos ,()
  Sjs_uncaught msg)

;; ── async 関数 ──

;; async 関数の呼び出し：本体の thunk body を、ジェネレータの本体として、最初の await まで動かし、結果の Promise を返す
(define Sjs_async ,(G body)
  Sjs_generator G body ,(gen)
  Sjs_promise_new G ,(p)
  Sjs_async_step G gen p "next" __NULL__ ,()
  __NULL__ p)

;; 本体を続ける。終われば戻り値で p を解決し、投げられれば p を拒否し、await で止まれば、その値の Promise の受け手から続ける
(define Sjs_async_step ,(G gen p mode x)
  __Cont_get__ ,(return)
  __Ref_new__ __NULL__ ,(out)
  Sjs_try (,() Sjs_gen_resume gen mode x ,(r) __Ref_set__ out r) (,(e) Sjs_promise_reject p e ,() return) ,()
  __Ref_get__ out ,(r)
  Sjs_obj_get r "done" ,(done)
  Sjs_obj_get r "value" ,(v)
  __if__ done (,() Sjs_promise_resolve p v ,() return) ,()
  Sjs_promise_coerce G v ,(q)
  Sjs_promise_then q (,(y) Sjs_async_step G gen p "next" y) (,(e) Sjs_async_step G gen p "throw" e))

;; await v（async 関数の本体の中。本体はジェネレータとして動いている）
(define Sjs_await ,(v)
  Sjs_yield v)

;; ── async ジェネレータ ──
;; Dict で、"t" は "asyncgen"、"gen" は本体を動かすジェネレータ、"queue" は要求 (mode x Promise) の LList（古い順）の Ref、
;; "busy" は、本体が動いているか await で止まっているか（Ref）。本体の中では、await も yield もジェネレータの yield で、
;; yield は値を await してから、印（"t" が "agyield"）を出す。next、return、throw は要求を列に入れて Promise を返し、
;; 本体が止まっていれば、列の先頭の要求で続ける（Sjs_ag_drain）。印が出れば、その要求の Promise を {value, done: false}
;; で解決し、本体が終われば {value, done: true} で解決し、投げれば拒否して、次の要求に進む。await で止まれば、
;; async 関数と同じく、値の Promise の受け手から続ける

(define Sjs_async_generator ,(G body)
  Sjs_generator G body ,(gen)
  Sjs_new_id G ,(n)
  __Dict_new__ ,(ag)
  __Dict_put__ ag "t" "asyncgen" ,()
  __Dict_put__ ag "id" n ,()
  __Dict_put__ ag "G" G ,()
  __Dict_put__ ag "gen" gen ,()
  __Ref_new__ __NULL__ ,(queue)
  __Dict_put__ ag "queue" queue ,()
  __Ref_new__ __FALSE__ ,(busy)
  __Dict_put__ ag "busy" busy ,()
  __NULL__ ag)

;; next(x)、return(x)、throw(x)：要求を列の後ろに入れ、その Promise を返す
(define Sjs_ag_request ,(ag mode x)
  __Dict_lookup_or__ ag "G" __print_exit_error__ ,(G)
  Sjs_promise_new G ,(p)
  __LList_cons__ p __NULL__ ,(req)
  __LList_cons__ x req ,(req)
  __LList_cons__ mode req ,(req)
  __Dict_lookup_or__ ag "queue" __print_exit_error__ ,(qref)
  __Ref_get__ qref ,(q)
  Sjs_reverse_list q ,(rev)
  __LList_cons__ req rev ,(rev)
  Sjs_reverse_list rev ,(q)
  __Ref_set__ qref q ,()
  Sjs_ag_drain ag ,()
  __NULL__ p)

;; 本体が止まっていて、列に要求があれば、先頭の要求で本体を続ける
(define Sjs_ag_drain ,(ag)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ ag "busy" __print_exit_error__ ,(busyRef)
  __Ref_get__ busyRef ,(busy)
  __if__ busy return ,()
  __Dict_lookup_or__ ag "queue" __print_exit_error__ ,(qref)
  __Ref_get__ qref ,(q)
  __is_null__ q ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ q ,(req rest)
  __LList_uncons__ __print_exit_error__ req ,(mode more)
  __LList_uncons__ __print_exit_error__ more ,(x more)
  __LList_uncons__ __print_exit_error__ more ,(p more)
  __Dict_lookup_or__ ag "G" __print_exit_error__ ,(G)
  __Dict_lookup_or__ ag "gen" __print_exit_error__ ,(gen)
  Sjs_gen_ref gen "state" ,(stateRef)
  __Ref_get__ stateRef ,(state)
  ;; 始まる前の return と throw は、本体を動かさずに終える
  __String_equal__ state "start" ,(start)
  __String_equal__ mode "next" ,(isNext)
  __not__ isNext ,(notNext)
  __and__ start notNext ,(test__) __if__ test__ (,() __Ref_set__ stateRef "done" ,()) ,()
  __Ref_get__ stateRef ,(state)
  __String_equal__ state "done" ,(test__) __if__ test__
    (,()
      __if__ isNext (,() Sjs_ag_finish ag ,() Sjs_gen_result G __NULL__ __TRUE__ ,(r) Sjs_promise_resolve p r ,() Sjs_ag_drain ag ,() return) ,()
      __String_equal__ mode "throw" ,(test__) __if__ test__ (,() Sjs_ag_finish ag ,() Sjs_promise_reject p x ,() Sjs_ag_drain ag ,() return) ,()
      ;; 終わった後の return(x)：x を await してから {value: x, done: true}
      __Ref_set__ busyRef __TRUE__ ,()
      Sjs_promise_coerce G x ,(c)
      Sjs_promise_then c
        (,(y) Sjs_ag_finish ag ,() Sjs_gen_result G y __TRUE__ ,(r) Sjs_promise_resolve p r ,() Sjs_ag_drain ag)
        (,(e) Sjs_ag_finish ag ,() Sjs_promise_reject p e ,() Sjs_ag_drain ag) ,()
      return) ,()
  __Ref_set__ busyRef __TRUE__ ,()
  Sjs_ag_step ag p mode x)

;; 先頭の要求を終える
(define Sjs_ag_finish ,(ag)
  __Dict_lookup_or__ ag "busy" __print_exit_error__ ,(busyRef)
  __Ref_set__ busyRef __FALSE__ ,()
  __Dict_lookup_or__ ag "queue" __print_exit_error__ ,(qref)
  __Ref_get__ qref ,(q)
  __LList_uncons__ __print_exit_error__ q ,(req rest)
  __Ref_set__ qref rest)

;; 本体を mode と x で続ける
(define Sjs_ag_step ,(ag p mode x)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ ag "G" __print_exit_error__ ,(G)
  __Dict_lookup_or__ ag "gen" __print_exit_error__ ,(gen)
  __Ref_new__ __NULL__ ,(out)
  Sjs_try (,() Sjs_gen_resume gen mode x ,(r) __Ref_set__ out r)
    (,(e) Sjs_ag_finish ag ,() Sjs_promise_reject p e ,() Sjs_ag_drain ag ,() return) ,()
  __Ref_get__ out ,(r)
  Sjs_obj_get r "done" ,(done)
  Sjs_obj_get r "value" ,(v)
  __if__ done (,() Sjs_ag_finish ag ,() Sjs_gen_result G v __TRUE__ ,(res) Sjs_promise_resolve p res ,() Sjs_ag_drain ag ,() return) ,()
  Sjs_kind v ,(kind)
  __String_equal__ kind "agyield" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ v "value" __print_exit_error__ ,(w)
      Sjs_ag_finish ag ,()
      Sjs_gen_result G w __FALSE__ ,(res)
      Sjs_promise_resolve p res ,()
      Sjs_ag_drain ag ,()
      return) ,()
  ;; await で止まった
  Sjs_promise_coerce G v ,(q)
  Sjs_promise_then q (,(y) Sjs_ag_step ag p "next" y) (,(e) Sjs_ag_step ag p "throw" e))

;; async ジェネレータの yield v：v を await してから出す
(define Sjs_ag_yield ,(v)
  Sjs_await v ,(w)
  Sjs_ag_yield_raw w)

;; await せずに出す。続けられたら、next なら渡された値を返し、throw なら投げ、return(x) なら x を await してから
;; return の印を投げる
(define Sjs_ag_yield_raw ,(w)
  __Cont_get__ ,(return)
  __Dict_new__ ,(mark)
  __Dict_put__ mark "t" "agyield" ,()
  __Dict_put__ mark "value" w ,()
  Sjs_yield_wait mark ,(mode x)
  __String_equal__ mode "next" ,(test__) __if__ test__ (,() return x) ,()
  __String_equal__ mode "throw" ,(test__) __if__ test__ (,() Sjs_raise x) ,()
  Sjs_await x ,(y)
  __Dict_new__ ,(rmark)
  __Dict_put__ rmark "t" "genreturn" ,()
  __Dict_put__ rmark "value" y ,()
  Sjs_reraise rmark)

;; async ジェネレータの yield* v：v が async ジェネレータなら、その next の結果の値をそのまま出し、戻り値を返す。
;; ほかは、繰り返しの値を 1 つずつ await して出す（throw と return は、委ねた先に渡さない）
(define Sjs_ag_yield_star ,(G v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "asyncgen" ,(test__) __if__ test__ (,() Sjs_ag_delegate v __NULL__ ,(r) return r) ,()
  Sjs_iter_open v ,(it)
  Sjs_ag_yield_star_loop it)

(define Sjs_ag_delegate ,(ag sent)
  __Cont_get__ ,(return)
  Sjs_ag_request ag "next" sent ,(p)
  Sjs_await p ,(r)
  Sjs_obj_get r "done" ,(done)
  Sjs_obj_get r "value" ,(v)
  __if__ done (,() return v) ,()
  Sjs_ag_yield_raw v ,(sent)
  Sjs_ag_delegate ag sent)

(define Sjs_ag_yield_star_loop ,(it)
  __Cont_get__ ,(return)
  Sjs_iter_more it ,(more)
  __unless__ more (,() __Dict_lookup_or__ it "ret" (,(k) return __NULL__) ,(r) __Ref_get__ r ,(rv) return rv) ,()
  Sjs_iter_take it ,(x)
  Sjs_ag_yield x ,(sent)
  Sjs_ag_yield_star_loop it)

(define Sjs_ag_method ,(G ag name)
  __Cont_get__ ,(return)
  __NULL__ (,(m) __String_equal__ name m ,(t) __if__ t
    (,() Sjs_function G m (,(args) Sjs_arg args ,(x rest) Sjs_ag_request ag m x) ,(fn) return fn)) ,(method)
  method "next" ,()
  method "return" ,()
  method "throw" ,()
  __NULL__ __NULL__)

;; for await の繰り返しの手順：async ジェネレータなら next の結果を await し、ほかは、繰り返しの値を await する
(define Sjs_aiter_open ,(G v)
  __Cont_get__ ,(return)
  __Dict_new__ ,(it)
  __Ref_new__ __NULL__ ,(buf)
  __Dict_put__ it "buf" buf ,()
  Sjs_kind v ,(kind)
  __String_equal__ kind "asyncgen" ,(test__) __if__ test__ (,() __Dict_put__ it "agen" v ,() return it) ,()
  Sjs_iter_open v ,(inner)
  __Dict_put__ it "sync" inner ,()
  __NULL__ it)

(define Sjs_aiter_more ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "buf" __print_exit_error__ ,(buf)
  __Dict_lookup_or__ it "agen" (,(k) __NULL__ __NULL__) ,(ag)
  __is_null__ ag ,(test__) __unless__ test__
    (,()
      Sjs_ag_request ag "next" __NULL__ ,(p)
      Sjs_await p ,(r)
      Sjs_obj_get r "done" ,(done)
      __if__ done (,() __Dict_put__ it "done" __TRUE__ ,() return __FALSE__) ,()
      Sjs_obj_get r "value" ,(v)
      __Ref_set__ buf v ,()
      return __TRUE__) ,()
  __Dict_lookup_or__ it "sync" __print_exit_error__ ,(inner)
  Sjs_iter_more inner ,(more)
  __unless__ more (,() __Dict_put__ it "done" __TRUE__ ,() return __FALSE__) ,()
  Sjs_iter_take inner ,(x)
  Sjs_await x ,(v)
  __Ref_set__ buf v ,()
  __NULL__ __TRUE__)

;; for await を途中で抜けたとき：async ジェネレータなら return() を呼んで await する
(define Sjs_aiter_close ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "done" (,(k) __NULL__ __FALSE__) ,(finished)
  __if__ finished return ,()
  __Dict_lookup_or__ it "agen" (,(k) __NULL__ __NULL__) ,(ag)
  ;; 投げて終わった async ジェネレータの return() は呼ばない（JavaScript と同じ）
  __is_null__ ag ,(test__) __unless__ test__
    (,()
      __Dict_lookup_or__ ag "gen" __print_exit_error__ ,(gen)
      Sjs_gen_ref gen "state" ,(stateRef)
      __Ref_get__ stateRef ,(state)
      __String_equal__ state "done" ,(test__) __if__ test__ return ,()
      Sjs_ag_request ag "return" __NULL__ ,(p)
      Sjs_await p ,(r)
      return) ,()
  __Dict_lookup_or__ it "sync" __print_exit_error__ ,(inner)
  Sjs_iter_close inner)

;; ── 速くするため：変換器が型を知っている所（sjs_gen.se の Gen_arith など）──

;; a === k（k は数と分かっている）。a が数でなければ偽。差が 0 なら真、0 でない数（無限大も）なら偽、NaN（NaN か、
;; 同じ無限大どうし）なら Sjs_seq で決める
(define Sjs_eq_num ,(a k)
  __Cont_get__ ,(return)
  __type_name__ a ,(t)
  __String_equal__ t "Number" ,(num)
  __unless__ num (,() return __FALSE__) ,()
  __Number_subtract__ a k ,(d)
  __Number_is_zero__ d ,(z)
  __if__ z (,() return __TRUE__) ,()
  __Number_is_positive__ d ,(p)
  __if__ p (,() return __FALSE__) ,()
  __Number_is_negative__ d ,(n)
  __if__ n (,() return __FALSE__) ,()
  Sjs_seq a k)

;; a === k（k は有限の数のリテラル）：a が数で、差が 0 か（a が NaN か無限大なら、差は 0 でない）
(define Sjs_eq_lit ,(a k)
  __Cont_get__ ,(return)
  __type_name__ a ,(t)
  __String_equal__ t "Number" ,(num)
  __unless__ num (,() return __FALSE__) ,()
  __Number_subtract__ a k ,(d)
  __Number_is_zero__ d)

(define Sjs_ne_lit ,(a k)
  __Cont_get__ ,(return)
  __type_name__ a ,(t)
  __String_equal__ t "Number" ,(num)
  __unless__ num (,() return __TRUE__) ,()
  __Number_subtract__ a k ,(d)
  __Number_is_zero__ d ,(z)
  __if__ z (,() return __FALSE__) ,()
  __NULL__ __TRUE__)

(define Sjs_ne_num ,(a k)
  Sjs_eq_num a k ,(e)
  __not__ e)

;; o[i]（i は数と分かっている）：配列なら items をそのまま引く（整数でない数と負の数は、items にないので undefined）。
;; ほかは Sjs_get_member
(define Sjs_get_index ,(G o i)
  __Cont_get__ ,(return)
  __type_name__ o ,(t)
  __String_equal__ t "Dict" ,(d)
  __unless__ d (,() Sjs_get_member G o i ,(v) return v) ,()
  __Dict_lookup_or__ o "items" (,(k) Sjs_get_member G o i ,(v) return v) ,(items)
  __Number_toString__ i ,(ks)
  __Dict_lookup_or__ items ks (,(k) Sjs_members_find o ks ,(found v) __NULL__ v))

;; o[i] = v（i は数と分かっている）：配列で、i が 0 以上の整数なら、そのまま入れる。ほかは Sjs_set_member
(define Sjs_set_index ,(G o i v)
  __Cont_get__ ,(return)
  __type_name__ o ,(t)
  __String_equal__ t "Dict" ,(d)
  __unless__ d (,() Sjs_set_member G o i v ,() return) ,()
  __Dict_lookup_or__ o "items" (,(k) Sjs_set_member G o i v ,() return) ,(items)
  __Dict_lookup_or__ o "frozen" (,(k) __NULL__ __FALSE__) ,(frozen)
  __if__ frozen return ,()
  __Number_toString__ i ,(ks)
  ;; すでにある添字なら、入れ替えるだけ（長さも穴も変わらない。負の数と整数でない数は items にない）
  __Dict_lookup_or__ items ks (,(k) Sjs_set_index_new G o i v ,() return) ,(old)
  __Dict_put__ items ks v)

;; Sjs_set_index の、items にない添字：0 以上の整数なら Sjs_array_set（長さを延ばす）、ほかは Sjs_set_member
(define Sjs_set_index_new ,(G o i v)
  __Cont_get__ ,(return)
  __Number_is_negative__ i ,(neg)
  __if__ neg (,() Sjs_set_member G o i v ,() return) ,()
  __Number_floor__ i ,(f)
  __Number_subtract__ i f ,(frac)
  __Number_is_zero__ frac ,(whole)
  __unless__ whole (,() Sjs_set_member G o i v ,() return) ,()
  Sjs_array_set o i v)

;; 配列の穴（[1, , 2]）：要素を入れずに、長さだけを 1 増やす
(define Sjs_array_hole ,(a)
  __Dict_put__ a "holes" __TRUE__ ,()
  __Dict_lookup_or__ a "length" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(n)
  Sjs_inc n ,(n)
  __Ref_set__ ref n)

;; 分割代入の次の要素（なければ undefined）
(define Sjs_iter_next ,(it)
  __Cont_get__ ,(return)
  Sjs_iter_more it ,(more)
  __unless__ more (,() return __NULL__) ,()
  Sjs_iter_take it)

;; 残りの要素の配列（...rest）
(define Sjs_iter_rest ,(G it)
  Sjs_iter_drain it __NULL__ ,(rev)
  Sjs_reverse_list rev ,(l)
  Sjs_array G l)

;; ── 分割代入の配列の形 ──
;; 値を開く：配列ならその配列（要素は添字で読む）、ほかは繰り返しの手順（Sjs_iter_open）。SJS の配列は繰り返しを
;; 変えられないので、JavaScript の配列の繰り返しと同じく、その時の配列の i 番目と、その時の長さまでの残りになる
(define Sjs_pattern_open ,(v)
  __Cont_get__ ,(return)
  __type_name__ v ,(t)
  __String_equal__ t "Dict" ,(d)
  __unless__ d (,() Sjs_iter_open v ,(it) return it) ,()
  ;; items があるのは配列だけ
  __Dict_lookup_or__ v "items" (,(k) Sjs_iter_open v ,(it) return it) ,(items)
  __NULL__ v)

;; key 番目（添字の文字列）の要素。繰り返しの手順なら次の値（なければ undefined）
(define Sjs_pattern_next ,(it key)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "items" (,(k) Sjs_iter_next it ,(x) return x) ,(items)
  __Dict_lookup_or__ items key (,(k) __NULL__ __NULL__))

;; i 番目からの残りの要素の配列（...rest）
(define Sjs_pattern_rest ,(G it i)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "items" (,(k) Sjs_iter_rest G it ,(a) return a) ,(items)
  Sjs_array_length it ,(n)
  Sjs_array_list_down it n i __NULL__ ,(l)
  Sjs_array G l)

;; 配列 a の i 番目から n - 1 番目までの値の LList（後ろから作る）
(define Sjs_array_list_down ,(a n i acc)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(d)
  __Number_is_positive__ d ,(more)
  __unless__ more (,() return acc) ,()
  Sjs_dec n ,(n)
  Sjs_array_get a n ,(v)
  __LList_cons__ v acc ,(acc)
  Sjs_array_list_down a n i acc)

;; 閉じる：配列は何もしない
(define Sjs_pattern_close ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "items" (,(k) Sjs_iter_close it ,() return) ,(items)
  return)

;; 繰り返しの手順を閉じる：終わっていないジェネレータなら return() を呼ぶ（finally を動かす）。配列と文字列は何もしない
(define Sjs_iter_close ,(it)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ it "gen" (,(k) return) ,(gen)
  __Dict_lookup_or__ it "done" (,(k) __NULL__ __FALSE__) ,(finished)
  __if__ finished return ,()
  Sjs_gen_ref gen "state" ,(stateRef)
  __Ref_get__ stateRef ,(state)
  __String_equal__ state "done" ,(test__) __if__ test__ return ,()
  Sjs_gen_resume gen "return" __NULL__ ,(r)
  __nop__)

;; ── 数の関数の wasm 版（consh/SJS-WASM-PLAN-ja.md の 5.2、5.5。段階 2、3）──
;; 変換器（sjs_gen.se、sjs_wasm.se）が、数の関数をまとめた WAT のモジュールを作り、数の関数を Sjs_wasm_fn で包む。
;; 呼ばれたとき、モジュールがあり、引数が足りて、どれも数なら wasm 版を、そうでなければ ConMa 版（f）を動かす。
;; 燃料（段階 3）：wasm 版を燃料 2^16 で呼び、使い切れば、燃料を 2 倍にして始めから呼び直す（数の関数は引数だけで結果が
;; 決まるので、やり直してよい。やり直しを含めた仕事は、最後の 1 回の 2 倍を超えない）。__Wasm_call__ は、燃料を使い切ると
;; 時間の区切りを終えるので、やり直しの合間に、ほかの VProc が動き、Ctrl-C が届く。燃料が上限の 2^30 を超えるか、
;; trap になれば（深い再帰でスタックがあふれたときなど）、ConMa 版を始めから動かす（ConMa 版は VProc の区切りで止まり、
;; CChain を伸ばすだけなので深い再帰も動く）

;; wat のモジュール。作れなければ（wasm 版の VM でない、--trace、CONMA_NO_WASM など）null
(define Sjs_wasm_module ,(wat)
  __Cont_get__ ,(return)
  __Wasm_compile__ (,(msg) Sjs_wasm_strict msg ,() return __NULL__) wat ,(w)
  __NULL__ w)

;; 環境変数 SJS_WASM_STRICT があれば、モジュールを作れなかった理由（WebAssembly がない場合を除く）を標準エラーに出す。
;; 変換器の作った WAT の誤りを、テストで見つけるため（ConMa 版で動くので、出力は変わらない）
(define Sjs_wasm_strict ,(msg)
  __Cont_get__ ,(return)
  __OS_get_envDict__ ,(env)
  __Dict_lookup_or__ env "SJS_WASM_STRICT" (,(k) return) ,(v)
  Sjs_zero ,(zero)
  __String_find__ (,(m) return) msg "not available" zero ,(at)
  __is_null__ at ,(test__) __unless__ test__ return ,()
  __String_concat__ "sjs: wasm: " msg ,(line)
  __String_concat__ line "\n" ,(line)
  __OS_print_error__ line)

;; 最初の燃料（2^20）、燃料を増やす倍率（8）、燃料の上限（2^30）。consh/SJS-WASM-ARRAY-PLAN-ja.md の 18 と 19（段階 F1）：
;; 2^20 は、最適化された後のコードで約 1 ms（燃料 1 あたり約 1 ns）。2^16 から 2 倍ずつだと、1 回の呼び出しに 2^16 より多く
;; 要る関数は、毎回切れてからやり直していた。8 倍にすると、1 回だけ呼ぶ長い関数で捨てる仕事が、平均で要る仕事の約 1.44 倍
;; から約 0.48 倍になる（その代わり、Ctrl-C が効くまでが、それまでの時間の約 7 倍までのびる）
(define Sjs_wasm_fuel ,()
  __Number_fromString__ __print_exit_error__ "1048576")

(define Sjs_wasm_fuel_factor ,()
  __Number_fromString__ __print_exit_error__ "8")

(define Sjs_wasm_fuel_limit ,()
  __Number_fromString__ __print_exit_error__ "1073741824")

;; 燃料 fuel が切れた後の燃料：fuel の 8 倍か上限の小さい方。fuel が上限なら偽（ConMa 版に替える）
(define Sjs_wasm_more_fuel ,(fuel)
  __Cont_get__ ,(return)
  Sjs_wasm_fuel_limit ,(limit)
  __Number_subtract__ limit fuel ,(room)
  __Number_is_positive__ room ,(test__) __unless__ test__ (,() return __FALSE__ fuel) ,()
  Sjs_wasm_fuel_factor ,(k)
  __Number_multiply__ fuel k ,(more)
  __Number_subtract__ limit more ,(d)
  __Number_is_negative__ d ,(over)
  __if_then_else__ over (,() __NULL__ limit) (,() __NULL__ more) ,(next)
  __NULL__ __TRUE__ next)

;; 数の関数 name（引数は n 個）の、引数の LList を受け取る Closure。W はモジュールか null、f は ConMa 版。void が真なら、
;; 値を返さない関数で、wasm 版の戻り値（0）の代わりに undefined を返す（配列の計画の段階 A0）。
;; ConMa 版に替えて動かしている間（busy が正）は、その中からこの関数を呼んでも、wasm 版を試さずに ConMa 版を動かす。
;; そうしないと、深い再帰が trap になったとき、ConMa 版の再帰の各段で wasm 版を試し直し、仕事が深さの 2 乗になる
;; （wasm の最初の実行は最適化の前のコードでスタックの枠が大きいので、深さ 100 万の再帰は trap になることがある）
(define Sjs_wasm_fn ,(W name shapes writes void f)
  Sjs_wasm_fn_core W name shapes writes void f (,() __NULL__ __TRUE__))

;; ConSh の (( )) の数の関数（段階 4）：呼ぶとき、names（空白で区切った名前）の SJS変数が、作ったときの関数（ids の番号）を
;; 指し、mathNames（空白で区切った、その関数とそれが呼ぶ数の関数が使う Math のメンバーの名前）のメンバーが元のままの
;; ときだけ wasm 版を使う（後の (( )) が書き換えることがある）。名前の列は、関数を作るときに 1 度だけ作り、使うメンバー
;; だけを比べる（呼ぶたびに 10 個のメンバーの名前を分けて比べると、Math を使う関数が wasm 版を使わないときより遅く
;; なった。REVIEW-ja.md の 2026-11-14（2）の 4）
(define Sjs_wasm_fn_checked ,(W G ids names mathNames name shapes writes void f)
  Sjs_wasm_words names ,(list)
  Sjs_wasm_words mathNames ,(mnames)
  __is_null__ mnames ,(noMath)
  Sjs_wasm_fn_core W name shapes writes void f (,()
    __Cont_get__ ,(return)
    __unless__ noMath (,() Sjs_wasm_math_ok G mnames ,(ok) __unless__ ok (,() return __FALSE__) ,()) ,()
    Sjs_wasm_same_fns ids list))

;; 空白で区切った語の LList（順は逆。確かめる順は問わない）
(define Sjs_wasm_words ,(s)
  Sjs_chars s ,(chars)
  Sjs_wasm_words_loop chars "" __NULL__)

(define Sjs_wasm_words_loop ,(chars word acc)
  __Cont_get__ ,(return)
  __String_equal__ word "" ,(empty)
  __is_null__ chars ,(test__) __if__ test__
    (,() __if_then_else__ empty (,() __NULL__ acc) (,() __LList_cons__ word acc) ,(acc) return acc) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c " " ,(test__) __if__ test__
    (,()
      __if_then_else__ empty (,() __NULL__ acc) (,() __LList_cons__ word acc) ,(acc)
      Sjs_wasm_words_loop rest "" acc ,(t)
      return t) ,()
  __String_concat__ word c ,(word)
  Sjs_wasm_words_loop rest word acc)

;; names の SJS変数が、どれも ids の番号の関数か
(define Sjs_wasm_same_fns ,(ids names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ ids nm (,(k) return __FALSE__) ,(id)
  Sjs_vars ,(vars)
  __Dict_lookup_or__ vars nm (,(k) return __FALSE__) ,(v)
  __type_name__ v ,(t)
  __String_equal__ t "Dict" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ v "id" (,(k) return __FALSE__) ,(vid)
  __Number_subtract__ vid id ,(d)
  __Number_is_zero__ d ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Sjs_wasm_same_fns ids rest)

;; Math のメンバー（names。数の関数が使う名前の LList）が、組み込みを作ったときのままか
(define Sjs_wasm_math_ok ,(G names)
  __Dict_lookup_or__ G " math" (,(k) __NULL__ __NULL__) ,(snap)
  __Dict_lookup_or__ G "Math" __print_exit_error__ ,(math)
  __Dict_lookup_or__ math "props" __print_exit_error__ ,(props)
  Sjs_wasm_same_members snap props names)

(define Sjs_wasm_same_members ,(snap props names)
  __Cont_get__ ,(return)
  __is_null__ names ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ names ,(nm rest)
  __Dict_lookup_or__ snap nm (,(k) return __FALSE__) ,(a)
  __Dict_lookup_or__ props nm (,(k) return __FALSE__) ,(b)
  __type_name__ a ,(ta)
  __type_name__ b ,(tb)
  __String_equal__ ta tb ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  __String_equal__ ta "Number" ,(isNum)
  __if_then_else__ isNum
    (,() __Number_subtract__ a b ,(d) __Number_is_zero__ d)
    (,() __Dict_lookup_or__ a "id" (,(k) return __FALSE__) ,(ia) __Dict_lookup_or__ b "id" (,(k) return __FALSE__) ,(ib) __Number_subtract__ ia ib ,(d) __Number_is_zero__ d) ,(same)
  __unless__ same (,() return __FALSE__) ,()
  Sjs_wasm_same_members snap props rest)

;; Sjs_wasm_fn の本体。shapes は引数の形（深さ。0 は数、1 は数の配列、2 は数の配列の配列、…）を空白で区切ったもの
;; （配列の計画の段階 A2）。writes が偽なら、配列に書かない関数なので、呼んだ後に書き戻さない（写す費用の改善）。
;; check は、wasm 版を使ってよいかを返す thunk。
;; busy は、ConMa 版を動かしている深さと、それを数えている VProc の番号（Sjs_wasm_busy）。ConMa 版の途中で VProc を止める
;; （(( )) を Ctrl-C で止める）と、深さが戻らないまま残るが、別の VProc（次の評価）からは 0 に見える
(define Sjs_wasm_fn_core ,(W name shapes writes void f check)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Ref_new__ zero ,(busy)
  __Ref_new__ __NULL__ ,(busyOwner)
  Sjs_wasm_fuel ,(fuel0)
  __Ref_new__ fuel0 ,(memo)
  Sjs_wasm_depths shapes ,(depths n arrays)
  __NULL__ (,(args)
    __Cont_get__ ,(return)
    __is_null__ W ,(none)
    __if__ none (,() f args ,(r) return r) ,()
    ;; ConMa 版で動かしている間は、確かめずに ConMa 版（check はその後。再帰の各段で確かめない）
    Sjs_wasm_busy busy busyOwner ,(b me)
    __Number_is_zero__ b ,(free)
    __unless__ free (,() f args ,(r) return r) ,()
    check ,(allowed)
    __unless__ allowed (,() f args ,(r) return r) ,()
    ;; 前に "ok" になった燃料から始める（この関数で何度も切れてからやり直さないように。段階 F1）
    __Ref_get__ memo ,(fuel)
    ;; 配列の引数があれば、写して __Wasm_call_memory__ で呼ぶ（写せなければ ConMa 版）
    __if_then_else__ arrays
      (,() Sjs_wasm_run_memory W name depths writes args memo fuel)
      (,()
        __Cont_get__ ,(give)
        Sjs_wasm_args args n ,(ok nums)
        __unless__ ok (,() give __FALSE__ __NULL__) ,()
        Sjs_wasm_run W name nums memo fuel) ,(done value)
    __if__ done (,() __if_then_else__ void (,() __NULL__ __NULL__) (,() __NULL__ value) ,(r) return r) ,()
    Sjs_inc b ,(b1)
    __Ref_set__ busyOwner me ,()
    __Ref_set__ busy b1 ,()
    f args ,(r)
    Sjs_wasm_busy busy busyOwner ,(b2 me2)
    ;; 別の VProc が数え直していれば 0（負にしない）
    __Number_is_zero__ b2 ,(z2)
    __if_then_else__ z2 (,() __NULL__ b2) (,() Sjs_dec b2) ,(b3)
    __Ref_set__ busyOwner me2 ,()
    __Ref_set__ busy b3 ,()
    __NULL__ r))

;; 今の VProc の番号 me と、その VProc が数えている深さ（busy を数えたのが別の VProc なら 0）
(define Sjs_wasm_busy ,(busy busyOwner)
  __Cont_get__ ,(return)
  __VProc_current__ ,(vp)
  __VProc_id__ vp ,(me)
  __Ref_get__ busyOwner ,(owner)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __is_null__ owner ,(test__) __if__ test__ (,() return zero me) ,()
  __Number_subtract__ owner me ,(d)
  __Number_is_zero__ d ,(test__) __unless__ test__ (,() return zero me) ,()
  __Ref_get__ busy ,(b)
  __NULL__ b me)

;; 燃料 fuel で wasm 版を呼ぶ。使い切れば 8 倍（上限まで）にしてやり直す。結果が出れば、その燃料を memo（Ref）に入れて、
;; 真とその値。上限で切れるか trap なら偽
(define Sjs_wasm_run ,(W name nums memo fuel)
  __Cont_get__ ,(return)
  __Wasm_call__ (,(msg) return __FALSE__ __NULL__) W name nums fuel ,(status value)
  __String_equal__ status "ok" ,(test__) __if__ test__ (,() __Ref_set__ memo fuel ,() return __TRUE__ value) ,()
  __String_equal__ status "fuel" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Sjs_wasm_more_fuel fuel ,(go more)
  __unless__ go (,() return __FALSE__ __NULL__) ,()
  Sjs_wasm_run W name nums memo more)

;; ── 配列の引数（配列の計画の段階 A2）──
;; wasm のモジュールのメモリを f64 の語の列として使い、配列 1 つを「長さ、要素 0、要素 1、…」の連続した語に置く。要素が配列なら、
;; その配列の先頭の語の番号を入れる。子の配列を先に置き、同じ配列（"id"）は 1 回だけ置くので、別名が保たれる。配列の引数は、
;; 先頭の語の番号として渡す。"ok" なら、数の配列の要素を、元の配列の "items" に書き戻す（"fuel" と "trap" では書き戻さない）。
;; 形が違う、穴がある、凍っている、数の配列の要素が数でない配列は、写さない（ConMa 版で動かす）

;; 形の文字列から、深さの LList（順のとおり）、その数、配列があるか
(define Sjs_wasm_depths ,(shapes)
  Sjs_wasm_words shapes ,(rev)
  Sjs_wasm_depths_loop rev __NULL__ __FALSE__)

(define Sjs_wasm_depths_loop ,(rev acc arrays)
  __Cont_get__ ,(return)
  __is_null__ rev ,(test__) __if__ test__ (,() Sjs_wasm_count acc ,(n) return acc n arrays) ,()
  __LList_uncons__ __print_exit_error__ rev ,(w rest)
  __Number_fromString__ __print_exit_error__ w ,(d)
  __Number_is_zero__ d ,(isNum)
  __not__ isNum ,(isArray)
  __or__ arrays isArray ,(arrays)
  __LList_cons__ d acc ,(acc)
  Sjs_wasm_depths_loop rest acc arrays)

(define Sjs_wasm_count ,(list)
  Sjs_zero ,(zero)
  Sjs_wasm_count_loop list zero)

(define Sjs_wasm_count_loop ,(list n)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return n) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Sjs_inc n ,(n)
  Sjs_wasm_count_loop rest n)

(define Sjs_wasm_reverse ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __LList_cons__ x acc ,(acc)
  Sjs_wasm_reverse rest acc)

;; 燃料 fuel で、配列を写して wasm 版を呼ぶ。使い切れば 8 倍（上限まで）にして、写し直してやり直す（その間にほかの VProc が
;; 配列を変えても、最後の 1 回をその時点で一度に動かしたのと同じになる）。結果が出れば書き戻し、その燃料を memo に入れて、
;; 真とその値。写せない、上限で切れる、trap なら偽
(define Sjs_wasm_run_memory ,(W name depths writes args memo fuel)
  __Cont_get__ ,(return)
  Sjs_wasm_pack depths args ,(ok params words backs)
  __unless__ ok (,() return __FALSE__ __NULL__) ,()
  __Wasm_call_memory__ (,(msg) return __FALSE__ __NULL__) W name params words fuel ,(status value out)
  __String_equal__ status "ok" ,(test__) __if__ test__ (,() __if__ writes (,() Sjs_wasm_unpack backs out) ,() __Ref_set__ memo fuel ,() return __TRUE__ value) ,()
  __String_equal__ status "fuel" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Sjs_wasm_more_fuel fuel ,(go more)
  __unless__ go (,() return __FALSE__ __NULL__) ,()
  Sjs_wasm_run_memory W name depths writes args memo more)

;; 引数を写す：写せれば、真、wasm に渡す引数（数か、配列の先頭の語の番号）の LList、語の LList、書き戻す数の配列の
;; (配列 先頭の語の番号 長さ) の LList（先頭の語の番号の順）
(define Sjs_wasm_pack ,(depths args)
  __Cont_get__ ,(return)
  __Dict_new__ ,(P)
  __Ref_new__ __NULL__ ,(words)
  __Dict_put__ P "words" words ,()
  Sjs_zero ,(zero)
  __Ref_new__ zero ,(count)
  __Dict_put__ P "count" count ,()
  __Dict_new__ ,(seen)
  __Dict_put__ P "seen" seen ,()
  __Ref_new__ __NULL__ ,(backs)
  __Dict_put__ P "backs" backs ,()
  Sjs_wasm_pack_args P depths args ,(ok params)
  __unless__ ok (,() return __FALSE__ __NULL__ __NULL__ __NULL__) ,()
  __Ref_get__ words ,(wr)
  Sjs_wasm_reverse wr __NULL__ ,(ws)
  __Ref_get__ backs ,(br)
  Sjs_wasm_reverse br __NULL__ ,(bs)
  __NULL__ __TRUE__ params ws bs)

(define Sjs_wasm_pack_args ,(P depths args)
  __Cont_get__ ,(return)
  __is_null__ depths ,(test__) __if__ test__ (,() return __TRUE__ __NULL__) ,()
  __is_null__ args ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ depths ,(d drest)
  __LList_uncons__ __print_exit_error__ args ,(a arest)
  __Number_is_zero__ d ,(isNum)
  __if_then_else__ isNum
    (,() __type_name__ a ,(ty) __String_equal__ ty "Number" ,(ok) __NULL__ ok a)
    (,() Sjs_wasm_pack_array P a d) ,(ok v)
  __unless__ ok (,() return __FALSE__ __NULL__) ,()
  Sjs_wasm_pack_args P drest arest ,(ok rest)
  __LList_cons__ v rest ,(l)
  __NULL__ ok l)

;; 配列 a を深さ d で写す。写せれば、真と先頭の語の番号
(define Sjs_wasm_pack_array ,(P a d)
  __Cont_get__ ,(return)
  __type_name__ a ,(ty)
  __String_equal__ ty "Dict" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  __Dict_lookup_or__ a "t" (,(k) return __FALSE__ __NULL__) ,(t)
  __String_equal__ t "array" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  __Dict_lookup_or__ a "frozen" (,(k) __NULL__ __FALSE__) ,(frozen)
  __if__ frozen (,() return __FALSE__ __NULL__) ,()
  __Dict_lookup_or__ a "id" __print_exit_error__ ,(id)
  __Number_toString__ id ,(key)
  __Dict_lookup_or__ P "seen" __print_exit_error__ ,(seen)
  __Dict_lookup_or__ seen key (,(k) __NULL__ __NULL__) ,(known)
  __is_null__ known ,(test__) __unless__ test__ (,() return __TRUE__ known) ,()
  Sjs_array_length a ,(len)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  Sjs_dec d ,(dm1)
  __Number_is_zero__ dm1 ,(leaf)
  Sjs_zero ,(zero)
  __Dict_lookup_or__ P "count" __print_exit_error__ ,(count)
  __Dict_lookup_or__ P "words" __print_exit_error__ ,(words)
  ;; 数の配列：長さと要素を、語の列（逆順）に直接積む（写す費用の改善。計画の 16、17）。数でない要素があれば、
  ;; 写すのをやめる（語の列は捨てるので、途中まで積んでよい）。配列の配列：子を先に置いてから、子の先頭の語の番号を積む
  __if_then_else__ leaf
    (,()
      __Ref_get__ count ,(addr0)
      __Ref_get__ words ,(ws)
      __LList_cons__ len ws ,(ws)
      ;; __Dict_numbers__（高速版 ConMa の機能 "wasm" のプリミティブ）が、"0"〜 の値を積む（要素がないか、数でなければ onError）
      __Dict_numbers__ (,(msg) return __FALSE__ __NULL__) items len ws ,(ws)
      __Ref_set__ words ws ,()
      __NULL__ addr0)
    (,()
      Sjs_wasm_children P items len zero dm1 __NULL__ ,(ok rev)
      __unless__ ok (,() return __FALSE__ __NULL__) ,()
      ;; 子を置いた後に、この配列を置く
      __Ref_get__ count ,(addr1)
      __Ref_get__ words ,(ws)
      __LList_cons__ len ws ,(ws)
      Sjs_wasm_reverse rev __NULL__ ,(elems)
      Sjs_wasm_push_all elems ws ,(ws)
      __Ref_set__ words ws ,()
      __NULL__ addr1) ,(addr)
  Sjs_inc len ,(size)
  __Number_add__ addr size ,(next)
  __Ref_set__ count next ,()
  __Dict_put__ seen key addr ,()
  __if__ leaf
    (,()
      __Dict_lookup_or__ P "backs" __print_exit_error__ ,(backs)
      __Ref_get__ backs ,(bs)
      __LList_cons__ len __NULL__ ,(b)
      __LList_cons__ addr b ,(b)
      __LList_cons__ a b ,(b)
      __LList_cons__ b bs ,(bs)
      __Ref_set__ backs bs) ,()
  __NULL__ __TRUE__ addr)

;; elems を、逆順の LList ws の先に積む
(define Sjs_wasm_push_all ,(elems ws)
  __Cont_get__ ,(return)
  __is_null__ elems ,(test__) __if__ test__ (,() return ws) ,()
  __LList_uncons__ __print_exit_error__ elems ,(x rest)
  __LList_cons__ x ws ,(ws)
  Sjs_wasm_push_all rest ws)

;; items の 0 から len - 1 までの配列を、深さ d で写す。写せれば、真と先頭の語の番号の逆順の LList
(define Sjs_wasm_children ,(P items len i d acc)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __Number_is_zero__ left ,(test__) __if__ test__ (,() return __TRUE__ acc) ,()
  __Number_toString__ i ,(k)
  __Dict_lookup_or__ items k (,(key) return __FALSE__ __NULL__) ,(v)
  Sjs_wasm_pack_array P v d ,(ok addr)
  __unless__ ok (,() return __FALSE__ __NULL__) ,()
  __LList_cons__ addr acc ,(acc)
  Sjs_inc i ,(i)
  Sjs_wasm_children P items len i d acc)

;; 書き戻す：backs の (配列 先頭の語の番号 長さ) ごとに、語の列 words の、その配列の要素を "items" に入れる
(define Sjs_wasm_unpack ,(backs words)
  Sjs_zero ,(zero)
  Sjs_wasm_unpack_loop backs words zero)

(define Sjs_wasm_unpack_loop ,(backs words pos)
  __Cont_get__ ,(return)
  __is_null__ backs ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ backs ,(b rest)
  __LList_uncons__ __print_exit_error__ b ,(a b1)
  __LList_uncons__ __print_exit_error__ b1 ,(addr b2)
  __LList_uncons__ __print_exit_error__ b2 ,(len b3)
  ;; 要素は、先頭の語（長さ）の次から
  Sjs_inc addr ,(start)
  __Number_subtract__ start pos ,(skip)
  Sjs_wasm_drop words skip ,(ws)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Dict_put_numbers__ items len ws ,(ws)
  __Number_add__ start len ,(pos)
  Sjs_wasm_unpack_loop rest ws pos)

(define Sjs_wasm_drop ,(list k)
  __Cont_get__ ,(return)
  __Number_is_positive__ k ,(more)
  __unless__ more (,() return list) ,()
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  Sjs_dec k ,(k)
  Sjs_wasm_drop rest k)

;; args の先頭の n 個が、どれも数か。数なら、真とその LList
(define Sjs_wasm_args ,(args n)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return __TRUE__ __NULL__) ,()
  __is_null__ args ,(test__) __if__ test__ (,() return __FALSE__ __NULL__) ,()
  __LList_uncons__ __print_exit_error__ args ,(a rest)
  __type_name__ a ,(t)
  __String_equal__ t "Number" ,(test__) __unless__ test__ (,() return __FALSE__ __NULL__) ,()
  Sjs_dec n ,(m)
  Sjs_wasm_args rest m ,(ok tail)
  __LList_cons__ a tail ,(l)
  __NULL__ ok l)

