(define Sjs_array_present_from ,(a i acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ i ,(test__) __if__ test__ (,() return acc) ,()
  Sjs_dec i ,(i)
  Sjs_array_has a i ,(has)
  __if_then_else__ has (,() __LList_cons__ i acc) (,() __NULL__ acc) ,(acc)
  Sjs_array_present_from a i acc)

;; a の from 番目から to 番目の前までを、out の at 番目から写す（穴は穴のまま）。out の長さは、写した所の後まで
(define Sjs_array_copy_into ,(out a from to at)
  __Cont_get__ ,(return)
  __Number_subtract__ to from ,(left)
  __Number_is_positive__ left ,(more)
