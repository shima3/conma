;; n 番目から len 番目の前までの要素を消す。消す範囲が広ければ、items の添字を見て消す
(define Sjs_array_truncate ,(a n len)
  __Cont_get__ ,(return)
  __Number_subtract__ len n ,(span)
  __Number_fromString__ __print_exit_error__ "64" ,(small)
  __Number_subtract__ span small ,(d)
  __Number_is_positive__ d ,(wide)
  __if__ wide (,() Sjs_array_item_indexes a ,(idx count) Sjs_array_remove_from a idx n ,() return) ,()
  Sjs_array_truncate_loop a n len)

(define Sjs_array_remove_from ,(a idx n)
  __Cont_get__ ,(return)
  __is_null__ idx ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ idx ,(i rest)
  __Number_subtract__ i n ,(d)
  __Number_is_negative__ d ,(keep)
  __unless__ keep
    (,() __Dict_lookup_or__ a "items" __print_exit_error__ ,(items) __Number_toString__ i ,(k) __Dict_remove__ items k) ,()
  Sjs_array_remove_from a rest n)

(define Sjs_array_truncate_loop ,(a n len)
  __Cont_get__ ,(return)
  __Number_subtract__ len n ,(left)
  __Number_is_positive__ left ,(more)
  __unless__ more return ,()
