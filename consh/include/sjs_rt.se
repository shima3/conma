;; ── ** とビット演算（段階 B4。段階 A と同じく、数だけ）──

;; a ** b：b が整数なら掛け算で（負なら逆数）、b が 0.5 なら平方根。ほかの b はまだ変換しない
(define Sjs_pow ,(a b)
  __Cont_get__ ,(return)
  Sjs_need2 "**" a b ,()
  Sjs_is_integer b ,(integer)
  __unless__ integer
    (,()
      __Number_fromString__ __print_exit_error__ "0.5" ,(half)
      __Number_subtract__ b half ,(d)
      __Number_is_zero__ d ,(test__) __if__ test__ (,() __Number_sqrt__ (,(m) Sjs_nan) a ,(r) return r) ,()
      Sjs_type_error "not yet translated to ConMa: ** with an exponent that is not an integer") ,()
  __Number_is_negative__ b ,(neg)
  __if_then_else__ neg (,() Sjs_neg b) (,() __NULL__ b) ,(n)
  Sjs_one ,(one)
  Sjs_pow_loop a n one ,(r)
  __unless__ neg (,() return r) ,()
  Sjs_div one r)

;; 二乗を繰り返す
(define Sjs_pow_loop ,(x n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __Number_divide__ __print_exit_error__ n two ,(h)
  __Number_floor__ h ,(half)
  __Number_multiply__ half two ,(even)
  __Number_subtract__ n even ,(bit)
  __Number_is_zero__ bit ,(isEven)
  __if_then_else__ isEven (,() __NULL__ acc) (,() __Number_multiply__ acc x) ,(acc)
  __Number_multiply__ x x ,(x)
  Sjs_pow_loop x half acc)

(define Sjs_two32 ,() __Number_fromString__ __print_exit_error__ "4294967296")

;; ToUint32：整数部を 2^32 で割った余り（0 以上）。NaN と無限大は 0
(define Sjs_to_uint32 ,(x)
  __Cont_get__ ,(return)
  Sjs_is_nan x ,(nan)
  __if__ nan (,() Sjs_zero ,(z) return z) ,()
  __Number_toString__ x ,(repr)
  __String_equal__ repr "inf" ,(pinf)
  __String_equal__ repr "-inf" ,(ninf)
  __or__ pinf ninf ,(test__) __if__ test__ (,() Sjs_zero ,(z) return z) ,()
  Sjs_trunc x ,(t)
  Sjs_two32 ,(m)
  __Number_divide__ __print_exit_error__ t m ,(q)
  __Number_floor__ q ,(q)
  __Number_multiply__ q m ,(y)
  __Number_subtract__ t y)

;; ToInt32：ToUint32 が 2^31 以上なら 2^32 を引く
(define Sjs_to_int32 ,(x)
