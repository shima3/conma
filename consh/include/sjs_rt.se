  __Ref_new__ __NULL__ ,(acc)
  Sjs_collect acc ,(sink)
  keys sink ,(x)
  __Ref_get__ acc ,(ks)
  Sjs_zero ,(zero)
  Sjs_numbers_of ks __NULL__ zero)

(define Sjs_numbers_of ,(ks acc count)
  __Cont_get__ ,(return)
  __is_null__ ks ,(test__) __if__ test__ (,() return acc count) ,()
  __LList_uncons__ __print_exit_error__ ks ,(k rest)
  __Number_fromString__ __print_exit_error__ k ,(n)
  __LList_cons__ n acc ,(acc)
