  __Ref_set__ self (,(x) __Ref_get__ acc ,(l) __LList_cons__ x l ,(l) __Ref_set__ acc l ,() __Ref_get__ self) ,()
  __Ref_get__ self)

;; 数の LList を小さい順に（マージソート）
(define Sjs_sort_numbers ,(l)
  __Cont_get__ ,(return)
  __is_null__ l ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ l ,(x rest)
  __is_null__ rest ,(test__) __if__ test__ (,() return l) ,()
