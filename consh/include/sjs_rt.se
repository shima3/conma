  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  __Number_toString__ len ,(k)
  __Dict_remove__ items k ,()
  Sjs_array_truncate_loop a n len)

;; タグ付きテンプレートの最初の引数：中身の配列で、raw に逃がしを解かない中身の配列を持つ
(define Sjs_template_strings ,(G parts raws)
  Sjs_array G parts ,(a)
