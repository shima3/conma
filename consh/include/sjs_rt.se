;; ── JSON.stringify ──

;; v の JSON。undefined と関数は null（JSON.stringify の undefined）
(define Sjs_json ,(v)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__ (,() Sjs_json_string v ,(s) return s) ,()
  __String_equal__ kind "number" ,(test__) __if__ test__
    (,()
      Sjs_num_str v ,(s)
      __String_equal__ s "NaN" ,(a)
      __String_equal__ s "Infinity" ,(b)
      __String_equal__ s "-Infinity" ,(c)
      __or__ a b ,(x)
      __or__ x c ,(test__) __if__ test__ (,() return "null") ,()
      return s) ,()
  __String_equal__ kind "boolean" ,(test__) __if__ test__ (,() Sjs_to_string v ,(s) return s) ,()
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return "null") ,()
  __String_equal__ kind "array" ,(test__) __if__ test__
    (,()
      Sjs_array_list v ,(list)
      Sjs_json_items list "" __TRUE__ ,(body)
      __String_concat__ "[" body ,(s)
      __String_concat__ s "]" ,(s)
      return s) ,()
  __String_equal__ kind "object" ,(test__) __if__ test__
    (,()
      Sjs_obj_keys v ,(keys)
      Sjs_json_props v keys "" __TRUE__ ,(body)
      __String_concat__ "{" body ,(s)
      __String_concat__ s "}" ,(s)
      return s) ,()
  __String_equal__ kind "generator" ,(test__) __if__ test__ (,() return "{}") ,()
  __String_equal__ kind "asyncgen" ,(test__) __if__ test__ (,() return "{}") ,()
  __String_equal__ kind "promise" ,(test__) __if__ test__ (,() return "{}") ,()
  __NULL__ __NULL__)

