  Sjs_to_number v ,(n)
  Sjs_zero ,(zero)
  __Number_add__ n zero ,(n)
  __NULL__ (,() Sjs_throw "RangeError" "Invalid array length") ,(bad)
  __Number_is_negative__ n ,(test__) __if__ test__ bad ,()
  __Number_floor__ n ,(f)
  __Number_subtract__ n f ,(frac)
  __Number_is_zero__ frac ,(whole)
  __unless__ whole bad ,()
  __Number_fromString__ __print_exit_error__ "4294967295" ,(max)
  __Number_subtract__ max n ,(room)
  __Number_is_negative__ room ,(test__) __if__ test__ bad ,()
  Sjs_array_length a ,(len)
