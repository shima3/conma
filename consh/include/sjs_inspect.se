;; console.log の形：Node.js の util.inspect（既定の設定：depth 2、breakLength 80、compact 3、maxArrayLength 100）と同じ手順で、
;; SJS の値を文字列にする（2026-11-14 から。前は JSON.stringify の形だった）。sjs_rt.se が include し、Sjs_console_string が呼ぶ。
;; consh/js/conma.js の inspect（ConSh の段階 A）も同じ手順。Node.js と違うところ：
;;   ・エラーはスタックがないので、一番外では "TypeError: メッセージ"、中では "[TypeError: メッセージ]"（スタックのない Error と同じ）
;;   ・オブジェクトの名前の順は SJS の Object.keys の順（整数の名前を先にしない）
;;   ・ジェネレータ関数と async 関数も [Function: 名前]
;;   ・文字列の長さは文字（コードポイント）で数える（JavaScript は UTF-16 の単位）
;;
;; 文脈 X（Dict）："cur" に今いちばん内側で形を作っているものの深さの Ref（ctx.currentDepth）、"seen" に作っている途中の
;; 配列とオブジェクトの番号の LList の Ref、"refs" に循環で参照されたものの番号 → *n の n、"next" に次の n の Ref

(define Sjs_inspect ,(v)
  __Dict_new__ ,(X)
  Sjs_zero ,(zero)
  __Ref_new__ zero ,(cur)
  __Dict_put__ X "cur" cur ,()
  __Ref_new__ __NULL__ ,(seen)
  __Dict_put__ X "seen" seen ,()
  __Dict_new__ ,(refs)
  __Dict_put__ X "refs" refs ,()
  Sjs_one ,(one)
  __Ref_new__ one ,(next)
  __Dict_put__ X "next" next ,()
  Sjs_ins_value X v zero zero)

;; v の形。depth は深さ（recurseTimes）、indent は字下げの幅（indentationLvl）
(define Sjs_ins_value ,(X v depth indent)
  __Cont_get__ ,(return)
  Sjs_kind v ,(kind)
  __String_equal__ kind "string" ,(test__) __if__ test__ (,() Sjs_ins_string v indent ,(s) return s) ,()
  __String_equal__ kind "number" ,(test__) __if__ test__
    (,() __Number_is_negative_zero__ v ,(nz) __if__ nz (,() return "-0") ,() Sjs_num_str v ,(s) return s) ,()
  __String_equal__ kind "boolean" ,(test__) __if__ test__ (,() Sjs_to_string v ,(s) return s) ,()
  __String_equal__ kind "undefined" ,(test__) __if__ test__ (,() return "undefined") ,()
  __String_equal__ kind "null" ,(test__) __if__ test__ (,() return "null") ,()
  __String_equal__ kind "function" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ v "name" (,(k) __NULL__ "") ,(name)
      __String_equal__ name "" ,(anon)
      __if__ anon (,() return "[Function (anonymous)]") ,()
      Cat3s "[Function: " name "]" ,(s)
      return s) ,()
  __String_equal__ kind "generator" ,(test__) __if__ test__ (,() return "Object [Generator] {}") ,()
  __String_equal__ kind "asyncgen" ,(test__) __if__ test__ (,() return "Object [AsyncGenerator] {}") ,()
  __String_equal__ kind "promise" ,(test__) __if__ test__ (,() Sjs_ins_promise X v depth indent ,(s) return s) ,()
  __String_equal__ kind "object" ,(isObject)
  __if__ isObject
    (,()
      __Dict_lookup_or__ v "error" (,(k) __NULL__ __FALSE__) ,(isError)
      __if__ isError (,() Sjs_to_string v ,(s) Cat3s "[" s "]" ,(s) return s) ,()) ,()
  Sjs_ins_container X v kind depth indent)

;; Promise { 値 }、Promise { <pending> }、Promise { <rejected> 値 }
(define Sjs_ins_promise ,(X p depth indent)
  __Cont_get__ ,(return)
  Sjs_promise_ref p "state" ,(state)
  __String_equal__ state "pending" ,(test__) __if__ test__ (,() return "Promise { <pending> }") ,()
  Sjs_promise_ref p "value" ,(x)
  __Dict_lookup_or__ X "cur" __print_exit_error__ ,(cur)
  __Ref_set__ cur depth ,()
  Sjs_inc depth ,(d1)
  Sjs_two ,(two)
  __Number_add__ indent two ,(i2)
  Sjs_ins_value X x d1 i2 ,(s)
  __String_equal__ state "rejected" ,(rejected)
  __if_then_else__ rejected (,() __String_concat__ "<rejected> " s) (,() __NULL__ s) ,(s)
  __LList_cons__ s __NULL__ ,(output)
  Sjs_one ,(one)
  Sjs_ins_reduce X output "" "Promise {" "}" __FALSE__ depth indent one __NULL__)

(define Sjs_two ,() __Number_fromString__ __print_exit_error__ "2")

;; 配列とオブジェクト
(define Sjs_ins_container ,(X v kind depth indent)
  __Cont_get__ ,(return)
  __String_equal__ kind "array" ,(isArray)
  ;; 循環、空、深さの順に見る（Node.js と同じ。深すぎても空なら [] と {}）
  __Dict_lookup_or__ v "id" __print_exit_error__ ,(id)
  __Dict_lookup_or__ X "seen" __print_exit_error__ ,(seenRef)
  __Ref_get__ seenRef ,(seen)
  Sjs_ins_member id seen ,(test__) __if__ test__ (,() Sjs_ins_ref X id ,(n) Cat3s "[Circular *" n "]" ,(s) return s) ,()
  __if_then_else__ isArray (,() Sjs_array_length v) (,() Sjs_obj_keys v ,(keys) __LList_length__ keys) ,(count)
  __Number_is_zero__ count ,(test__) __if__ test__
    (,() __if_then_else__ isArray (,() __NULL__ "[]") (,() __NULL__ "{}") ,(s) return s) ,()
  ;; 深さが 2 より深ければ [Array]、[Object]
  Sjs_two ,(two)
  __Number_subtract__ depth two ,(over)
  __Number_is_positive__ over ,(test__) __if__ test__
    (,() __if_then_else__ isArray (,() __NULL__ "[Array]") (,() __NULL__ "[Object]") ,(s) return s) ,()
  __LList_cons__ id seen ,(seen2)
  __Ref_set__ seenRef seen2 ,()
  __Dict_lookup_or__ X "cur" __print_exit_error__ ,(cur)
  __Ref_set__ cur depth ,()
  Sjs_inc depth ,(d1)
  __Number_add__ indent two ,(i2)
  __if_then_else__ isArray (,() Sjs_ins_array X v d1 i2) (,() Sjs_obj_keys v ,(keys) Sjs_ins_props X v keys d1 i2 __NULL__) ,(output)
  __Ref_set__ seenRef seen ,()
  __if_then_else__ isArray (,() __NULL__ "[") (,() __NULL__ "{") ,(open)
  __if_then_else__ isArray (,() __NULL__ "]") (,() __NULL__ "}") ,(close)
  __LList_length__ output ,(entries)
  Sjs_ins_reduce X output "" open close isArray depth indent entries v ,(s)
  ;; 中で循環として参照されたなら <ref *n>
  __Dict_lookup_or__ X "refs" __print_exit_error__ ,(refs)
  __Number_toString__ id ,(key)
  __Dict_lookup_or__ refs key (,(k) return s) ,(n)
  Cat3s "<ref *" n "> " ,(prefix)
  __String_concat__ prefix s)

(define Sjs_ins_member ,(x list)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(y rest)
  __Number_subtract__ x y ,(d)
  __Number_is_zero__ d ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Sjs_ins_member x rest)

;; 循環で参照された番号 id の *n の n（初めてなら新しく付ける）
(define Sjs_ins_ref ,(X id)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ X "refs" __print_exit_error__ ,(refs)
  __Number_toString__ id ,(key)
  __Dict_lookup_or__ refs key (,(k) __NULL__ __NULL__) ,(old)
  __is_null__ old ,(test__) __unless__ test__ (,() return old) ,()
  __Dict_lookup_or__ X "next" __print_exit_error__ ,(next)
  __Ref_get__ next ,(n)
  Sjs_inc n ,(n1)
  __Ref_set__ next n1 ,()
  __Number_toString__ n ,(ns)
  __Dict_put__ refs key ns ,()
  __NULL__ ns)

;; 配列の要素の形の LList。穴は、続くものをまとめて <n empty item(s)>。100 個（穴のまとまりも 1 個と数える）を超えれば
;; ... n more item(s)
(define Sjs_ins_array ,(X a depth indent)
  Sjs_array_length a ,(len)
  __Dict_lookup_or__ a "items" __print_exit_error__ ,(items)
  Sjs_zero ,(zero)
  Sjs_ins_items X items len zero zero depth indent __NULL__ ,(rev)
  Sjs_reverse_list rev)

(define Sjs_ins_items ,(X items len i holes depth indent acc)
  __Cont_get__ ,(return)
  __LList_length__ acc ,(count)
  __Number_fromString__ __print_exit_error__ "100" ,(max)
  __Number_subtract__ len i ,(left)
  __Number_is_positive__ left ,(more)
  ;; 終わり：たまった穴を出す
  __unless__ more
    (,() Sjs_ins_holes holes acc ,(acc) return acc) ,()
  __Number_toString__ i ,(key)
  __Ref_new__ __TRUE__ ,(present)
  __Dict_lookup_or__ items key (,(k) __Ref_set__ present __FALSE__ ,() __NULL__ __NULL__) ,(v)
  __Ref_get__ present ,(has)
  Sjs_inc i ,(i1)
  __unless__ has (,() Sjs_inc holes ,(h1) Sjs_ins_items X items len i1 h1 depth indent acc ,(r) return r) ,()
  Sjs_ins_holes holes acc ,(acc)
  Sjs_zero ,(zero)
  ;; 100 個に達していれば、残りの数
  __LList_length__ acc ,(count)
  __Number_subtract__ count max ,(full)
  __Number_is_negative__ full ,(room)
  __unless__ room (,() Sjs_ins_more left acc ,(acc) return acc) ,()
  Sjs_ins_value X v depth indent ,(s)
  __LList_cons__ s acc ,(acc)
  Sjs_ins_items X items len i1 zero depth indent acc)

(define Sjs_ins_holes ,(holes acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ holes ,(test__) __if__ test__ (,() return acc) ,()
  Sjs_one ,(one)
  __Number_subtract__ holes one ,(d)
  __Number_is_zero__ d ,(single)
  __Number_toString__ holes ,(hs)
  __if_then_else__ single (,() __NULL__ " empty item>") (,() __NULL__ " empty items>") ,(tail)
  Cat3s "<" hs tail ,(s)
  __LList_cons__ s acc)

(define Sjs_ins_more ,(left acc)
  Sjs_one ,(one)
  __Number_subtract__ left one ,(d)
  __Number_is_zero__ d ,(single)
  __Number_toString__ left ,(ls)
  __if_then_else__ single (,() __NULL__ " more item") (,() __NULL__ " more items") ,(tail)
  Cat3s "... " ls tail ,(s)
  __LList_cons__ s acc)

;; オブジェクトの名前と値の形の LList（逆順の acc に足し、最後に戻す）
(define Sjs_ins_props ,(X o keys depth indent acc)
  __Cont_get__ ,(return)
  __is_null__ keys ,(test__) __if__ test__ (,() Sjs_reverse_list acc ,(l) return l) ,()
  __LList_uncons__ __print_exit_error__ keys ,(k rest)
  Sjs_obj_get o k ,(v)
  Sjs_ins_key k ,(ks)
  Sjs_ins_value X v depth indent ,(vs)
  Cat3s ks ": " vs ,(s)
  __LList_cons__ s acc ,(acc)
  Sjs_ins_props X o rest depth indent acc)

;; 名前：識別子（[a-zA-Z_][a-zA-Z_0-9]*）ならそのまま、ほかは引用符で囲む
(define Sjs_ins_key ,(k)
  __Cont_get__ ,(return)
  Sjs_chars k ,(chars)
  __is_null__ chars ,(test__) __if__ test__ (,() Sjs_ins_quote k ,(q) return q) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Sjs_in_chars c "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" ,(first)
  __unless__ first (,() Sjs_ins_quote k ,(q) return q) ,()
  Sjs_ins_ident_rest rest ,(ok)
  __unless__ ok (,() Sjs_ins_quote k ,(q) return q) ,()
  __NULL__ k)

(define Sjs_ins_ident_rest ,(chars)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Sjs_in_chars c "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789" ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Sjs_ins_ident_rest rest)

;; 文字列の値：引用符で囲む。16 文字より長く、80 - indent - 4 文字より長ければ、改行の後で切って ' +\n' でつなぐ
(define Sjs_ins_string ,(s indent)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __Number_fromString__ __print_exit_error__ "16" ,(n16)
  __Number_fromString__ __print_exit_error__ "76" ,(n76)
  __Number_subtract__ len n16 ,(a)
  __Number_subtract__ n76 indent ,(limit)
  __Number_subtract__ len limit ,(b)
  __Number_is_positive__ a ,(longA)
  __Number_is_positive__ b ,(longB)
  __and__ longA longB ,(long)
  __unless__ long (,() Sjs_ins_quote s ,(q) return q) ,()
  Sjs_ins_lines s ,(lines)
  Sjs_ins_quote_all lines __NULL__ ,(quoted)
  Sjs_two ,(two)
  __Number_add__ indent two ,(i2)
  Sjs_spaces i2 ,(pad)
  __String_concat__ " +\n" pad ,(sep)
  Sjs_ins_join quoted sep)

;; 改行の後で切った行の LList（改行は前の行に付ける）
(define Sjs_ins_lines ,(s)
  Sjs_chars s ,(chars)
  Sjs_ins_lines_loop chars "" __NULL__)

(define Sjs_ins_lines_loop ,(chars line acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__
    (,()
      __String_equal__ line "" ,(empty)
      __if_then_else__ empty (,() __NULL__ acc) (,() __LList_cons__ line acc) ,(acc)
      Sjs_reverse_list acc ,(l)
      return l) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_concat__ line c ,(line)
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() __LList_cons__ line acc ,(acc) Sjs_ins_lines_loop rest "" acc ,(l) return l) ,()
  Sjs_ins_lines_loop rest line acc)

(define Sjs_ins_quote_all ,(lines acc)
  __Cont_get__ ,(return)
  __is_null__ lines ,(test__) __if__ test__ (,() Sjs_reverse_list acc ,(l) return l) ,()
  __LList_uncons__ __print_exit_error__ lines ,(x rest)
  Sjs_ins_quote x ,(q)
  __LList_cons__ q acc ,(acc)
  Sjs_ins_quote_all rest acc)

;; 引用符で囲んだ文字列：' を含まなければ '、含んで " を含まなければ "、両方を含んで ` と ${ を含まなければ `、ほかは '。
;; その引用符、\、制御文字（\b \t \n \f \r のほかは \xHH。0x7F〜0x9F も）を逃がす
(define Sjs_ins_quote ,(s)
  Sjs_zero ,(zero)
  __String_find__ __print_exit_error__ s "'" zero ,(sq)
  __String_find__ __print_exit_error__ s "\"" zero ,(dq)
  __String_find__ __print_exit_error__ s "`" zero ,(bq)
  __String_find__ __print_exit_error__ s "${" zero ,(tpl)
  __is_null__ sq ,(noSq)
  __is_null__ dq ,(noDq)
  __is_null__ bq ,(noBq)
  __is_null__ tpl ,(noTpl)
  __and__ noBq noTpl ,(btOk)
  __if_then_else__ noSq (,() __NULL__ "'")
    (,() __if_then_else__ noDq (,() __NULL__ "\"") (,() __if_then_else__ btOk (,() __NULL__ "`") (,() __NULL__ "'"))) ,(quote)
  Sjs_chars s ,(chars)
  Sjs_ins_escape chars quote quote ,(body)
  __String_concat__ body quote)

(define Sjs_ins_escape ,(chars quote acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c quote ,(isQuote)
  __String_equal__ c "\\" ,(isBackslash)
  __or__ isQuote isBackslash ,(test__) __if__ test__
    (,() Cat3s acc "\\" c ,(acc) Sjs_ins_escape rest quote acc ,(r) return r) ,()
  Sjs_ins_control c ,(e)
  __String_concat__ acc e ,(acc)
  Sjs_ins_escape rest quote acc)

(define Sjs_ins_control ,(c)
  __Cont_get__ ,(return)
  __String_toCode__ __print_exit_error__ c ,(code)
  __Number_fromString__ __print_exit_error__ "32" ,(n32)
  __Number_fromString__ __print_exit_error__ "127" ,(n127)
  __Number_fromString__ __print_exit_error__ "160" ,(n160)
  __Number_subtract__ code n32 ,(d32)
  __Number_is_negative__ d32 ,(low)
  __Number_subtract__ code n127 ,(d127)
  __Number_subtract__ code n160 ,(d160)
  __Number_is_negative__ d127 ,(below127)
  __Number_is_negative__ d160 ,(below160)
  __not__ below127 ,(from127)
  __and__ from127 below160 ,(high)
  __or__ low high ,(control)
  __unless__ control (,() return c) ,()
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() return "\\n") ,()
  __String_equal__ c "\t" ,(test__) __if__ test__ (,() return "\\t") ,()
  __String_equal__ c "\r" ,(test__) __if__ test__ (,() return "\\r") ,()
  __Number_fromString__ __print_exit_error__ "8" ,(n8)
  __Number_fromString__ __print_exit_error__ "12" ,(n12)
  __Number_subtract__ code n8 ,(d8)
  __Number_is_zero__ d8 ,(test__) __if__ test__ (,() return "\\b") ,()
  __Number_subtract__ code n12 ,(d12)
  __Number_is_zero__ d12 ,(test__) __if__ test__ (,() return "\\f") ,()
  __Number_fromString__ __print_exit_error__ "16" ,(sixteen)
  __Number_divide__ __print_exit_error__ code sixteen ,(q)
  __Number_floor__ q ,(hi)
  __Number_multiply__ hi sixteen ,(m)
  __Number_subtract__ code m ,(lo)
  Sjs_ins_hex hi ,(h)
  Sjs_ins_hex lo ,(l)
  Cat3s "\\x" h l)

(define Sjs_ins_hex ,(n)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ n one ,(m)
  __String_substring__ __print_exit_error__ "0123456789ABCDEF" n m)

;; ── 1 行か、1 項目ずつの行か（reduceToSingleString）──
;; output は項目の形の LList、entries は配列なら要素をまとめる前の項目の数。value は配列（要素が数かを見る）か null

(define Sjs_ins_reduce ,(X output base open close isArray depth indent entries value)
  __Cont_get__ ,(return)
  __LList_length__ output ,(n)
  ;; 6 個より多い配列の項目は、列にまとめる
  __Number_fromString__ __print_exit_error__ "6" ,(six)
  __Number_subtract__ n six ,(d6)
  __Number_is_positive__ d6 ,(many)
  __and__ isArray many ,(group)
  __if_then_else__ group (,() Sjs_ins_group output indent value) (,() __NULL__ output) ,(output)
  __LList_length__ output ,(m)
  __Number_subtract__ m n ,(dm)
  __Number_is_zero__ dm ,(ungrouped)
  ;; いちばん内側の深さ cur から 3 段より浅く、まとめていなければ、80 文字に収まるとき 1 行
  __Dict_lookup_or__ X "cur" __print_exit_error__ ,(curRef)
  __Ref_get__ curRef ,(cur)
  __Number_subtract__ cur depth ,(inner)
  __Number_fromString__ __print_exit_error__ "3" ,(three)
  __Number_subtract__ inner three ,(d3)
  __Number_is_negative__ d3 ,(shallow)
  __and__ shallow ungrouped ,(test__) __if__ test__
    (,()
      __String_length__ open ,(ol)
      __String_length__ base ,(bl)
      __Number_fromString__ __print_exit_error__ "10" ,(ten)
      __Number_add__ m indent ,(start)
      __Number_add__ start ol ,(start)
      __Number_add__ start bl ,(start)
      __Number_add__ start ten ,(start)
      Sjs_ins_below output start ,(fits)
      __if__ fits
        (,()
          Sjs_ins_join output ", " ,(joined)
          Sjs_zero ,(zero)
          __String_find__ __print_exit_error__ joined "\n" zero ,(nl)
          __is_null__ nl ,(oneLine)
          __if__ oneLine (,() Cat3s open " " joined ,(s) Cat3s s " " close ,(s) return s) ,()) ,()) ,()
  Sjs_spaces indent ,(pad)
  __String_concat__ "\n" pad ,(nlpad)
  __String_concat__ "," nlpad ,(sep0)
  __String_concat__ sep0 "  " ,(sep)
  Sjs_ins_join output sep ,(body)
  Cat3s open nlpad "  " ,(s)
  Cat3s s body nlpad ,(s)
  __String_concat__ s close)

;; isBelowBreakLength：項目の数 + start + 長さの和が 80 以下（項目の数を 2 度足した時点で超えれば偽）
(define Sjs_ins_below ,(output start)
  __Cont_get__ ,(return)
  __LList_length__ output ,(n)
  __Number_add__ n start ,(total)
  __Number_add__ total n ,(t2)
  __Number_fromString__ __print_exit_error__ "80" ,(n80)
  __Number_subtract__ t2 n80 ,(d)
  __Number_is_positive__ d ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Sjs_ins_below_loop output total n80)

(define Sjs_ins_below_loop ,(output total limit)
  __Cont_get__ ,(return)
  __is_null__ output ,(test__) __if__ test__ (,() return __TRUE__) ,()
  __LList_uncons__ __print_exit_error__ output ,(s rest)
  __String_length__ s ,(len)
  __Number_add__ total len ,(total)
  __Number_subtract__ total limit ,(d)
  __Number_is_positive__ d ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Sjs_ins_below_loop rest total limit)

(define Sjs_ins_join ,(list sep)
  Sjs_ins_join_loop list sep "" __TRUE__)

(define Sjs_ins_join_loop ,(list sep acc first)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(s rest)
  __if_then_else__ first (,() __NULL__ acc) (,() __String_concat__ acc sep) ,(acc)
  __String_concat__ acc s ,(acc)
  Sjs_ins_join_loop rest sep acc __FALSE__)

(define Sjs_spaces ,(n)
  Sjs_ins_repeat " " n "")

(define Sjs_ins_repeat ,(s n acc)
  __Cont_get__ ,(return)
  Sjs_zero ,(zero)
  __Number_subtract__ n zero ,(d)
  __Number_is_positive__ d ,(test__) __unless__ test__ (,() return acc) ,()
  __String_concat__ acc s ,(acc)
  Sjs_dec n ,(n)
  Sjs_ins_repeat s n acc)

;; ── 配列の要素を列にまとめる（groupArrayElements）──

(define Sjs_ins_group ,(output indent value)
  __Cont_get__ ,(return)
  __LList_length__ output ,(len)
  ;; "... n more items" は数えない
  __Number_fromString__ __print_exit_error__ "100" ,(max)
  Sjs_ins_has_more output ,(hasMore)
  __if_then_else__ hasMore (,() Sjs_dec len) (,() __NULL__ len) ,(outputLength)
  Sjs_two ,(sep)
  Sjs_ins_lengths output outputLength ,(lens)
  Sjs_ins_sum_max lens ,(sum maxLength)
  ;; totalLength は長さ + 2 の和
  __Number_multiply__ outputLength sep ,(extra)
  __Number_add__ sum extra ,(totalLength)
  __Number_add__ maxLength sep ,(actualMax)
  ;; actualMax * 3 + indent < 80、かつ（totalLength / actualMax > 5 か maxLength <= 6）
  __Number_fromString__ __print_exit_error__ "3" ,(three)
  __Number_fromString__ __print_exit_error__ "80" ,(n80)
  __Number_multiply__ actualMax three ,(a3)
  __Number_add__ a3 indent ,(a3)
  __Number_subtract__ a3 n80 ,(d80)
  __Number_is_negative__ d80 ,(fit3)
  __unless__ fit3 (,() return output) ,()
  __Number_divide__ __print_exit_error__ totalLength actualMax ,(ratio)
  __Number_fromString__ __print_exit_error__ "5" ,(five)
  __Number_subtract__ ratio five ,(r5)
  __Number_is_positive__ r5 ,(spread)
  __Number_fromString__ __print_exit_error__ "6" ,(six)
  __Number_subtract__ maxLength six ,(m6)
  __Number_is_positive__ m6 ,(wide)
  __not__ wide ,(narrow)
  __or__ spread narrow ,(test__) __unless__ test__ (,() return output) ,()
  ;; 列の数：min(round(sqrt(2.5 * biasedMax * outputLength) / biasedMax), floor((80 - indent) / actualMax), 12, 15)。
  ;; averageBias = sqrt(actualMax - totalLength / output の項目の数)、biasedMax = max(actualMax - 3 - averageBias, 1)
  __LList_length__ output ,(allLen)
  __Number_divide__ __print_exit_error__ totalLength allLen ,(avg)
  __Number_subtract__ actualMax avg ,(ab)
  __Number_sqrt__ (,(m) Sjs_nan) ab ,(averageBias)
  __Number_subtract__ actualMax three ,(bm)
  __Number_subtract__ bm averageBias ,(bm)
  Sjs_one ,(one)
  __Number_subtract__ bm one ,(bm1)
  __Number_is_negative__ bm1 ,(small)
  __if_then_else__ small (,() __NULL__ one) (,() __NULL__ bm) ,(biasedMax)
  __Number_fromString__ __print_exit_error__ "2.5" ,(heights)
  __Number_multiply__ heights biasedMax ,(area)
  __Number_multiply__ area outputLength ,(area)
  __Number_sqrt__ (,(m) Sjs_nan) area ,(side)
  __Number_divide__ __print_exit_error__ side biasedMax ,(c1)
  Sjs_round c1 ,(c1)
  __Number_subtract__ n80 indent ,(room)
  __Number_divide__ __print_exit_error__ room actualMax ,(c2)
  __Number_floor__ c2 ,(c2)
  __Number_fromString__ __print_exit_error__ "12" ,(c3)
  Sjs_ins_min c1 c2 ,(columns)
  Sjs_ins_min columns c3 ,(columns)
  __Number_subtract__ columns one ,(cd)
  __Number_is_positive__ cd ,(test__) __unless__ test__ (,() return output) ,()
  ;; 列ごとの幅（その列のいちばん長い項目 + 2）
  Sjs_zero ,(zero)
  Sjs_ins_widths lens columns zero __NULL__ ,(widths)
  ;; 数だけの配列は右に寄せ、ほかは左に寄せる
  Sjs_ins_all_numbers value allLen ,(right)
  Sjs_ins_rows output lens outputLength columns widths right zero __NULL__ ,(rows)
  __if__ hasMore (,() Sjs_ins_last output ,(lastItem) __LList_cons__ lastItem rows ,(rows) Sjs_reverse_list rows ,(l) return l) ,()
  Sjs_reverse_list rows)

(define Sjs_ins_min ,(a b)
  __Number_subtract__ a b ,(d)
  __Number_is_negative__ d ,(less)
  __if_then_else__ less (,() __NULL__ a) (,() __NULL__ b))

(define Sjs_ins_has_more ,(output)
  Sjs_ins_last output ,(last)
  __String_length__ last ,(len)
  __Number_fromString__ __print_exit_error__ "4" ,(four)
  __Number_subtract__ len four ,(d)
  __Number_is_negative__ d ,(test__) __if_then_else__ test__ (,() __NULL__ __FALSE__) (,()
  Sjs_zero ,(zero)
  __String_substring__ __print_exit_error__ last zero four ,(head)
  __String_equal__ head "... "))

(define Sjs_ins_last ,(list)
  __LList_uncons__ __print_exit_error__ list ,(x rest)
  __is_null__ rest ,(test__) __if_then_else__ test__ (,() __NULL__ x) (,() Sjs_ins_last rest))

;; 先頭 n 個の項目の長さの LList
(define Sjs_ins_lengths ,(output n)
  Sjs_ins_lengths_loop output n __NULL__ ,(rev)
  Sjs_reverse_list rev)

(define Sjs_ins_lengths_loop ,(output n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ output ,(s rest)
  __String_length__ s ,(len)
  __LList_cons__ len acc ,(acc)
  Sjs_dec n ,(n)
  Sjs_ins_lengths_loop rest n acc)

(define Sjs_ins_sum_max ,(lens)
  Sjs_zero ,(zero)
  Sjs_ins_sum_max_loop lens zero zero)

(define Sjs_ins_sum_max_loop ,(lens sum max)
  __Cont_get__ ,(return)
  __is_null__ lens ,(test__) __if__ test__ (,() return sum max) ,()
  __LList_uncons__ __print_exit_error__ lens ,(x rest)
  __Number_add__ sum x ,(sum)
  __Number_subtract__ x max ,(d)
  __Number_is_positive__ d ,(bigger)
  __if_then_else__ bigger (,() __NULL__ x) (,() __NULL__ max) ,(max)
  Sjs_ins_sum_max_loop rest sum max)

;; 列 i（0 から columns - 1）の幅：i、i + columns、… 番目の長さの最大 + 2
(define Sjs_ins_widths ,(lens columns i acc)
  __Cont_get__ ,(return)
  __Number_subtract__ i columns ,(d)
  __Number_is_negative__ d ,(test__) __unless__ test__ (,() Sjs_reverse_list acc ,(l) return l) ,()
  Sjs_zero ,(zero)
  Sjs_ins_column_max lens columns i zero zero ,(w)
  Sjs_two ,(two)
  __Number_add__ w two ,(w)
  __LList_cons__ w acc ,(acc)
  Sjs_inc i ,(i)
  Sjs_ins_widths lens columns i acc)

(define Sjs_ins_column_max ,(lens columns i j max)
  __Cont_get__ ,(return)
  __is_null__ lens ,(test__) __if__ test__ (,() return max) ,()
  __LList_uncons__ __print_exit_error__ lens ,(x rest)
  ;; j が i から columns ごとのものか
  __Number_subtract__ j i ,(d)
  __Number_divide__ __print_exit_error__ d columns ,(q)
  __Number_floor__ q ,(f)
  __Number_subtract__ q f ,(frac)
  __Number_is_zero__ frac ,(inColumn)
  __Number_is_negative__ d ,(before)
  __not__ before ,(after)
  __and__ inColumn after ,(take)
  __Number_subtract__ x max ,(dx)
  __Number_is_positive__ dx ,(bigger)
  __and__ take bigger ,(test__) __if_then_else__ test__ (,() __NULL__ x) (,() __NULL__ max) ,(max)
  Sjs_inc j ,(j)
  Sjs_ins_column_max rest columns i j max)

;; 配列 value の先頭 n 個（項目の数。穴も数える）がすべて数か
(define Sjs_ins_all_numbers ,(value n)
  __Cont_get__ ,(return)
  __is_null__ value ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Dict_lookup_or__ value "items" __print_exit_error__ ,(items)
  Sjs_zero ,(zero)
  Sjs_ins_all_numbers_loop items zero n)

(define Sjs_ins_all_numbers_loop ,(items i n)
  __Cont_get__ ,(return)
  __Number_subtract__ i n ,(d)
  __Number_is_negative__ d ,(test__) __unless__ test__ (,() return __TRUE__) ,()
  __Number_toString__ i ,(key)
  __Dict_lookup_or__ items key (,(k) return __FALSE__) ,(v)
  Sjs_kind v ,(kind)
  __String_equal__ kind "number" ,(test__) __unless__ test__ (,() return __FALSE__) ,()
  Sjs_inc i ,(i)
  Sjs_ins_all_numbers_loop items i n)

;; 行の LList（逆順）。1 行は columns 個ずつ。右寄せなら最後の項目も幅 - 2 に合わせ、左寄せなら最後は寄せない
(define Sjs_ins_rows ,(output lens left columns widths right i acc)
  __Cont_get__ ,(return)
  __Number_is_positive__ left ,(test__) __unless__ test__ (,() return acc) ,()
  Sjs_ins_min left columns ,(k)
  Sjs_ins_row output lens widths k right "" ,(line output lens)
  __LList_cons__ line acc ,(acc)
  __Number_subtract__ left k ,(left)
  Sjs_ins_rows output lens left columns widths right i acc)

(define Sjs_ins_row ,(output lens widths k right acc)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ output ,(s orest)
  __LList_uncons__ __print_exit_error__ lens ,(len lrest)
  __LList_uncons__ __print_exit_error__ widths ,(w wrest)
  Sjs_one ,(one)
  __Number_subtract__ k one ,(k1)
  __Number_is_zero__ k1 ,(last)
