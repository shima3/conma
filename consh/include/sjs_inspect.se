  Sjs_two ,(two)
  __Number_add__ len two ,(cl)
  __Number_subtract__ w cl ,(p)
  Sjs_spaces p ,(pad)
  __if_then_else__ right (,() __String_concat__ pad cell) (,() __String_concat__ cell pad) ,(cell)
  __String_concat__ acc cell ,(acc)
