;; SJS の構文解析（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。conma.js の sjsParse と同じ形の再帰下降。
;; 節は Dict で、"t" に種類を持つ。式：
;;   num（"text"）、str（"value"）、lit（"text" が true、false、null）、id（"name"）、paren（"expr"）、
;;   binary（"op" "left" "right"。&&、||、?? も）、unary（"op" "arg"）、update（"op" "prefix" "target"）、
;;   assign（"op" "target" "value"）、cond（"test" "yes" "no"）、call（"callee" "args" "optional"）、
;;   member（"object" と、"name"（.名前）か "key"（[式]）、"optional"（?.））、
;;   arrow と function（"params" は名前の LList、"body" はブロックか、"expr" は式。function は "name" も）、
;;   array（"items"）、object（"props"。各要素は "key"（String）か "computed"（式）、"value"）、
;;   template（"parts" は文字列の LList、"exprs" は式の LList。parts は exprs より 1 つ多い）
;; 文：block（"body"）、empty、decl（"kind" "decls"。decls は "name" と "init" を持つ Dict の LList）、
;;   if（"test" "yes" "no"）、while（"test" "body"）、for（"init" "test" "update" "body"）、
;;   forof（"kind"（let、const、var か null）"name" "of"（of か in）"right" "body"）、break、continue、
;;   return（"value"）、throw（"value"）、try（"body" "param" "handler" "finalizer"）、expr（"expr"）、program（"body"）。
;;   文の節は "line"（始まりの行の String）も持つ
;; まだ読まない書き方（配列の穴、ラベルなど）は、「not yet translated」のエラーにする。
;; sjs_lex.se を使う

(define Sjs_parse ,(text)
  Sjs_lex text ,(toks)
  Sjs_check_tokens toks __NULL__ ,()
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_statements p "" __NULL__ ,(body)
  Sjs_node "program" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

;; SJS式だけのテキスト（ConSh の (( )) と $(( ))）を読む
(define Sjs_parse_expression ,(text)
  Sjs_lex text ,(toks)
  Sjs_check_tokens toks __NULL__ ,()
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_expression p ,(e)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(end)
  __unless__ end (,() P_fail p) ,()
  __NULL__ e)

;; 構文解析の前に、字句を見て SJS の範囲を確かめる（段階 A の sjsCheck と同じ順で、同じメッセージ）：名前、. の後の名前、
;; == と !=。prev は前の字句（なければ null）
(define Sjs_check_tokens ,(toks prev)
  __Cont_get__ ,(return)
  __is_null__ toks ,(test__) __if__ test__ return ,()
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  Tok_kind tok ,(kind)
  Tok_text tok ,(text)
  __is_null__ prev ,(first)
  __if_then_else__ first (,() __NULL__ __FALSE__) (,() Tok_is prev "." ,(a) Tok_is prev "?." ,(b) __or__ a b) ,(afterDot)
  __String_equal__ kind "id" ,(test__) __if__ test__
    (,() __if_then_else__ afterDot (,() P_check_property text) (,() P_check_name text)) ,()
  __String_equal__ kind "punct" ,(punct)
  Sjs_in_words text "== !=" ,(loose)
  __and__ punct loose ,(test__) __if__ test__
    (,() __String_concat__ "not in SJS: " text ,(m) __String_concat__ m " (use " ,(m) __String_concat__ m text ,(m) __String_concat__ m "=)" ,(m) Sjs_not_in m) ,()
  Sjs_check_tokens rest tok)

;; 「not in SJS」のエラー（段階 A と同じく、エラーの名前を付けない）
(define Sjs_not_in ,(msg)
  Sjs_uncaught msg)

;; SJS の範囲の外の名前（段階 A の SJS_NAMES と、__ で始まる名前）なら、「not in SJS」のエラー
(define P_check_name ,(name)
  __Cont_get__ ,(return)
  Sjs_in_words name "this new class super import export with eval arguments debugger yield async await globalThis window self document Function" ,(bad)
  Sjs_starts name "__" ,(under)
  __or__ bad under ,(test__) __unless__ test__ return ,()
  __String_concat__ "not in SJS: " name ,(msg)
  Sjs_not_in msg)

;; . の後の名前（段階 A の sjsBadProperty）
(define P_check_property ,(name)
  __Cont_get__ ,(return)
  Sjs_in_words name "constructor prototype caller callee arguments" ,(bad)
  Sjs_starts name "__" ,(under)
  __or__ bad under ,(test__) __unless__ test__ return ,()
  __String_concat__ "not in SJS: ." name ,(msg)
  Sjs_not_in msg)

(define Sjs_node ,(t)
  __Dict_new__ ,(n)
  __Dict_put__ n "t" t ,()
  __NULL__ n)

(define Sjs_get ,(n key)
  __Dict_lookup_or__ n key __print_exit_error__)

;; ── 字句を読む ──

(define P_peek ,(p)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __NULL__ tok)

;; n 個先の字句（0 は今の字句）。入力の終わりより先は eof
(define P_peek_at ,(p n)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  P_nth toks n)

(define P_nth ,(toks n)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return tok) ,()
  __is_null__ rest ,(test__) __if__ test__ (,() return tok) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  P_nth rest n)

(define P_next ,(p)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __is_null__ rest ,(test__) __if__ test__ (,() return tok) ,()
  __Ref_set__ ref rest ,()
  __NULL__ tok)

;; 字句 tok が、記号か名前の text か
(define Tok_is ,(tok text)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "punct" ,(punct)
  __String_equal__ kind "id" ,(id)
  __or__ punct id ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Tok_text tok ,(t)
  __String_equal__ t text)

(define P_is ,(p text)
  P_peek p ,(tok)
  Tok_is tok text)

(define P_eat ,(p text)
  __Cont_get__ ,(return)
  P_is p text ,(yes)
  __unless__ yes (,() return __FALSE__) ,()
  P_next p ,(tok)
  __NULL__ __TRUE__)

(define P_expect ,(p text)
  __Cont_get__ ,(return)
  P_eat p text ,(ok)
  __if__ ok return ,()
  P_peek p ,(tok)
  P_describe tok ,(d)
  __String_concat__ "expected '" text ,(msg)
  __String_concat__ msg "' but found " ,(msg)
  __String_concat__ msg d ,(msg)
  Sjs_throw "SyntaxError" msg)

(define P_describe ,(tok)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ (,() return "the end") ,()
  Tok_text tok ,(t)
  __String_concat__ "'" t ,(s)
  __String_concat__ s "'")

(define P_fail ,(p)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(eof)
  __if_then_else__ eof (,() __NULL__ "end of the expression") (,() P_describe tok) ,(d)
  __String_concat__ "unexpected " d ,(msg)
  Sjs_throw "SyntaxError" msg)

(define P_not_yet ,(what)
  __String_concat__ "not yet translated to ConMa: " what ,(msg)
  Sjs_throw "SyntaxError" msg)

;; 名前（キーワードでない）
(define Sjs_keywords ,()
  __NULL__ " break case catch class const continue default delete do else false finally for function if in instanceof let new null of return switch this throw true try typeof var void while yield async await ")

(define Sjs_is_keyword ,(name)
  Sjs_keywords ,(kws)
  __String_concat__ " " name ,(s)
  __String_concat__ s " " ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ kws s zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define Tok_is_name ,(tok)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(id)
  __unless__ id (,() return __FALSE__) ,()
  Tok_text tok ,(t)
  Sjs_is_keyword t ,(kw)
  __not__ kw)

(define P_name ,(p)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_is_name tok ,(ok)
  __unless__ ok
    (,() P_describe tok ,(d) __String_concat__ "expected a name but found " d ,(msg) Sjs_throw "SyntaxError" msg) ,()
  P_next p ,(tok)
  Tok_text tok)

;; 文の終わり：; か、} か入力の終わりの前か、改行の前
(define P_semi ,(p)
  __Cont_get__ ,(return)
  P_eat p ";" ,(test__) __if__ test__ return ,()
  P_is p "}" ,(test__) __if__ test__ return ,()
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ return ,()
  Tok_nl tok ,(test__) __if__ test__ return ,()
  P_fail p)

;; ── 文 ──

;; end（"}" か、入力の終わりなら ""）までの文の LList
(define P_statements ,(p end acc)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(atEof)
  __String_equal__ end "" ,(toEof)
  __and__ atEof toEof ,(test__) __if__ test__ (,() Sjs_reverse acc ,(body) return body) ,()
  __if__ atEof (,() P_expect p end) ,()
  P_is p end ,(test__) __if__ test__ (,() Sjs_reverse acc ,(body) return body) ,()
  P_statement p ,(s)
  __LList_cons__ s acc ,(acc)
  P_statements p end acc)

(define P_block ,(p)
  P_expect p "{" ,()
  P_statements p "}" __NULL__ ,(body)
  P_expect p "}" ,()
  Sjs_node "block" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

;; 文。節の "line" に、文の始まりの行を入れる（実行時のエラーの位置。Sjs_line）
(define P_statement ,(p)
  P_peek p ,(tok)
  Tok_line tok ,(line)
  P_statement_body p ,(n)
  __Dict_put__ n "line" line ,()
  __NULL__ n)

(define P_statement_body ,(p)
  __Cont_get__ ,(return)
  P_is p "{" ,(test__) __if__ test__ (,() P_block p ,(n) return n) ,()
  P_eat p ";" ,(test__) __if__ test__ (,() Sjs_node "empty" ,(n) return n) ,()
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(isId)
  __if__ isId
    (,()
      Tok_text tok ,(word)
      __String_equal__ word "let" ,(isLet)
      __String_equal__ word "const" ,(isConst)
      __String_equal__ word "var" ,(isVar)
      __or__ isLet isConst ,(decl)
      __or__ decl isVar ,(test__) __if__ test__ (,() P_decl p ,(n) P_semi p ,() return n) ,()
      __String_equal__ word "if" ,(test__) __if__ test__ (,() P_if p ,(n) return n) ,()
      __String_equal__ word "while" ,(test__) __if__ test__ (,() P_while p ,(n) return n) ,()
      __String_equal__ word "return" ,(test__) __if__ test__ (,() P_return p ,(n) return n) ,()
      __String_equal__ word "for" ,(test__) __if__ test__ (,() P_for p ,(n) return n) ,()
      __String_equal__ word "throw" ,(test__) __if__ test__
        (,()
          P_next p ,(t)
          P_peek p ,(next)
          Tok_nl next ,(nl)
          __if__ nl (,() Sjs_throw "SyntaxError" "a new line after throw") ,()
          P_expression p ,(value)
          P_semi p ,()
          Sjs_node "throw" ,(n)
          __Dict_put__ n "value" value ,()
          return n) ,()
      __String_equal__ word "try" ,(test__) __if__ test__ (,() P_try p ,(n) return n) ,()
      __String_equal__ word "do" ,(test__) __if__ test__
        (,()
          P_next p ,(t)
          P_statement p ,(body)
          P_expect p "while" ,()
          P_expect p "(" ,()
          P_expression p ,(test)
          P_expect p ")" ,()
          P_eat p ";" ,(semi)
          Sjs_node "dowhile" ,(n)
          __Dict_put__ n "body" body ,()
          __Dict_put__ n "test" test ,()
          return n) ,()
      __String_equal__ word "switch" ,(test__) __if__ test__ (,() P_switch p ,(n) return n) ,()
      __String_equal__ word "break" ,(isBreak)
      __String_equal__ word "continue" ,(isContinue)
      __or__ isBreak isContinue ,(test__) __if__ test__
        (,()
          P_next p ,(t)
          P_peek p ,(next)
          Tok_is_name next ,(named)
          Tok_nl next ,(nl)
          __not__ nl ,(same)
          __and__ named same ,(test__) __if__ test__ (,() P_not_yet "labels") ,()
          P_semi p ,()
          Sjs_node word ,(n)
          return n) ,()
      P_unsupported_statement word ,()) ,()
  P_expression p ,(e)
  P_semi p ,()
  Sjs_node "expr" ,(n)
  __Dict_put__ n "expr" e ,()
  __NULL__ n)

(define P_unsupported_statement ,(word)
  __Cont_get__ ,(return)
  Sjs_in_words word "function" ,(test__)
  __unless__ test__ return ,()
  __String_concat__ word " statements" ,(what)
  P_not_yet what)

;; word が、空白で区切った語の並び words の 1 つか
(define Sjs_in_words ,(word words)
  __String_concat__ " " words ,(s)
  __String_concat__ s " " ,(s)
  __String_concat__ " " word ,(w)
  __String_concat__ w " " ,(w)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ s w zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define P_decl ,(p)
  P_next p ,(tok)
  Tok_text tok ,(kind)
  P_declarators p __NULL__ ,(decls)
  Sjs_node "decl" ,(n)
  __Dict_put__ n "kind" kind ,()
  __Dict_put__ n "decls" decls ,()
  __NULL__ n)

(define P_declarators ,(p acc)
  __Cont_get__ ,(return)
  P_binding_target p ,(target)
  P_eat p "=" ,(hasInit)
  __if_then_else__ hasInit (,() P_assign p) (,() __NULL__ __NULL__) ,(init)
  Sjs_node "declarator" ,(d)
  __Dict_put__ d "target" target ,()
  __Dict_put__ d "init" init ,()
  __LList_cons__ d acc ,(acc)
  P_eat p "," ,(more)
  __if__ more (,() P_declarators p acc ,(decls) return decls) ,()
  Sjs_reverse acc)

;; 束縛の形：名前、[ ... ]（配列の形）、{ ... }（オブジェクトの形）。節は id、arrayPattern（"items"。要素は形か、
;; default（"target" "value"）か、rest（"target"）か、穴の null）、objectPattern（"props"。要素は "key"（String）か
;; "computed"（式）と "value"（形か default）、または rest）
(define P_binding_target ,(p)
  __Cont_get__ ,(return)
  P_eat p "[" ,(test__) __if__ test__ (,() P_array_pattern p __NULL__ ,(n) return n) ,()
  P_eat p "{" ,(test__) __if__ test__ (,() P_object_pattern p __NULL__ ,(n) return n) ,()
  P_peek p ,(tok)
  Tok_text tok ,(text)
  P_check_name text ,()
  P_name p ,(name)
  Str_has_dollar name ,(test__) __if__ test__
    (,() __String_concat__ "not in SJS: a declaration of " name ,(m) __String_concat__ m " (a name that begins with $ is a shell variable)" ,(m) Sjs_not_in m) ,()
  Sjs_node "id" ,(n)
  __Dict_put__ n "name" name ,()
  __NULL__ n)

;; 形と、= の後の既定値
(define P_binding_element ,(p)
  __Cont_get__ ,(return)
  P_binding_target p ,(target)
  P_eat p "=" ,(hasDefault)
  __unless__ hasDefault (,() return target) ,()
  P_assign p ,(value)
  Sjs_node "default" ,(n)
  __Dict_put__ n "target" target ,()
  __Dict_put__ n "value" value ,()
  __NULL__ n)

(define P_array_pattern ,(p acc)
  __Cont_get__ ,(return)
  __NULL__ (,(acc) Sjs_reverse acc ,(items) Sjs_node "arrayPattern" ,(n) __Dict_put__ n "items" items ,() return n) ,(finish)
  P_eat p "]" ,(test__) __if__ test__ (,() finish acc) ,()
  P_eat p "," ,(test__) __if__ test__ (,() __LList_cons__ __NULL__ acc ,(acc) P_array_pattern p acc ,(n) return n) ,()
  P_eat p "..." ,(test__) __if__ test__
    (,()
      P_binding_target p ,(t)
      Sjs_node "rest" ,(r)
      __Dict_put__ r "target" t ,()
      __LList_cons__ r acc ,(acc)
      P_expect p "]" ,()
      finish acc) ,()
  P_binding_element p ,(e)
  __LList_cons__ e acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p "]" ,() finish acc) ,()
  P_array_pattern p acc)

(define P_object_pattern ,(p acc)
  __Cont_get__ ,(return)
  __NULL__ (,(acc) Sjs_reverse acc ,(props) Sjs_node "objectPattern" ,(n) __Dict_put__ n "props" props ,() return n) ,(finish)
  P_eat p "}" ,(test__) __if__ test__ (,() finish acc) ,()
  P_eat p "..." ,(test__) __if__ test__
    (,()
      P_binding_target p ,(t)
      Sjs_node "rest" ,(r)
      __Dict_put__ r "target" t ,()
      __LList_cons__ r acc ,(acc)
      P_expect p "}" ,()
      finish acc) ,()
  Sjs_node "prop" ,(prop)
  P_eat p "[" ,(computed)
  __if__ computed (,() P_assign p ,(k) P_expect p "]" ,() __Dict_put__ prop "computed" k ,() __Dict_put__ prop "key" "") ,()
  __unless__ computed
    (,()
      P_next p ,(tok)
      Tok_kind tok ,(kind)
      Tok_text tok ,(text)
      Sjs_in_words kind "id str num" ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected a property name in a pattern") ,()
      __Dict_put__ prop "key" text ,()
      __Dict_put__ prop "computed" __NULL__ ,()
      __String_equal__ kind "id" ,(isId)
      __Dict_put__ prop "shorthandOk" isId) ,()
  P_eat p ":" ,(hasValue)
  __if_then_else__ hasValue
    (,() P_binding_element p)
    (,()
      __Dict_lookup_or__ prop "shorthandOk" (,(k) __NULL__ __FALSE__) ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected ':' in a pattern") ,()
      Sjs_get prop "key" ,(name)
      P_check_name name ,()
      Sjs_node "id" ,(id)
      __Dict_put__ id "name" name ,()
      P_eat p "=" ,(hasDefault)
      __if_then_else__ hasDefault
        (,()
          P_assign p ,(dv)
          Sjs_node "default" ,(d)
          __Dict_put__ d "target" id ,()
          __Dict_put__ d "value" dv ,()
          __NULL__ d)
        (,() __NULL__ id)) ,(value)
  __Dict_put__ prop "value" value ,()
  __LList_cons__ prop acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p "}" ,() finish acc) ,()
  P_object_pattern p acc)

;; switch (式) { case 式: 文 ... default: 文 ... }。"cases" は、"test"（default なら null）と "body"（文の LList）の Dict の LList
(define P_switch ,(p)
  P_next p ,(t)
  P_expect p "(" ,()
  P_expression p ,(disc)
  P_expect p ")" ,()
  P_expect p "{" ,()
  P_cases p __NULL__ ,(cases)
  Sjs_node "switch" ,(n)
  __Dict_put__ n "disc" disc ,()
  __Dict_put__ n "cases" cases ,()
  __NULL__ n)

(define P_cases ,(p acc)
  __Cont_get__ ,(return)
  P_eat p "}" ,(test__) __if__ test__ (,() Sjs_reverse acc ,(cases) return cases) ,()
  P_eat p "default" ,(isDefault)
  __if_then_else__ isDefault (,() __NULL__ __NULL__) (,() P_expect p "case" ,() P_expression p) ,(test)
  P_expect p ":" ,()
  P_case_body p __NULL__ ,(body)
  Sjs_node "case" ,(c)
  __Dict_put__ c "test" test ,()
  __Dict_put__ c "body" body ,()
  __LList_cons__ c acc ,(acc)
  P_cases p acc)

(define P_case_body ,(p acc)
  __Cont_get__ ,(return)
  P_is p "case" ,(a)
  P_is p "default" ,(b)
  P_is p "}" ,(c)
  __or__ a b ,(x)
  __or__ x c ,(test__) __if__ test__ (,() Sjs_reverse acc ,(body) return body) ,()
  P_statement p ,(st)
  __LList_cons__ st acc ,(acc)
  P_case_body p acc)

(define P_if ,(p)
  P_next p ,(tok)
  P_expect p "(" ,()
  P_expression p ,(test)
  P_expect p ")" ,()
  P_statement p ,(yes)
  P_eat p "else" ,(hasElse)
  __if_then_else__ hasElse (,() P_statement p) (,() __NULL__ __NULL__) ,(no)
  Sjs_node "if" ,(n)
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "yes" yes ,()
  __Dict_put__ n "no" no ,()
  __NULL__ n)

(define P_while ,(p)
  P_next p ,(tok)
  P_expect p "(" ,()
  P_expression p ,(test)
  P_expect p ")" ,()
  P_statement p ,(body)
  Sjs_node "while" ,(n)
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "body" body ,()
  __NULL__ n)

(define P_return ,(p)
  __Cont_get__ ,(return)
  P_next p ,(tok)
  Sjs_node "return" ,(n)
  P_peek p ,(next)
