;; SJS の構文解析（consh/SAFEJS-PLAN-ja.md の 4.2。段階 B1）。conma.js の sjsParse と同じ形の再帰下降。
;; 節は Dict で、"t" に種類を持つ。式：
;;   num（"text"）、str（"value"）、lit（"text" が true、false、null）、id（"name"）、paren（"expr"）、
;;   binary（"op" "left" "right"。&&、||、?? も）、unary（"op" "arg"）、update（"op" "prefix" "target"）、
;;   assign（"op" "target" "value"）、cond（"test" "yes" "no"）、call（"callee" "args" "optional"）、
;;   member（"object" と、"name"（.名前）か "key"（[式]）、"optional"（?.））、
;;   arrow と function（"params" は名前の LList、"body" はブロックか、"expr" は式。function は "name" も）、
;;   array（"items"）、object（"props"。各要素は "key"（String）か "computed"（式）、"value"）、
;;   template（"parts" は文字列の LList、"exprs" は式の LList。parts は exprs より 1 つ多い）
;; 文：block（"body"）、empty、decl（"kind" "decls"。decls は "name" と "init" を持つ Dict の LList）、
;;   if（"test" "yes" "no"）、while（"test" "body"）、for（"init" "test" "update" "body"）、
;;   forof（"kind"（let、const、var か null）"name" "of"（of か in）"right" "body"）、break、continue、
;;   return（"value"）、expr（"expr"）、program（"body"）
;; まだ読まない書き方（分割代入、スプレッド、try、switch など）は、「not yet translated」のエラーにする。
;; sjs_lex.se を使う

(define Sjs_parse ,(text)
  Sjs_lex text ,(toks)
  __Ref_new__ toks ,(ref)
  __Dict_new__ ,(p)
  __Dict_put__ p "toks" ref ,()
  P_statements p "" __NULL__ ,(body)
  Sjs_node "program" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

(define Sjs_node ,(t)
  __Dict_new__ ,(n)
  __Dict_put__ n "t" t ,()
  __NULL__ n)

(define Sjs_get ,(n key)
  __Dict_lookup_or__ n key __print_exit_error__)

;; ── 字句を読む ──

(define P_peek ,(p)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __NULL__ tok)

;; n 個先の字句（0 は今の字句）。入力の終わりより先は eof
(define P_peek_at ,(p n)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  P_nth toks n)

(define P_nth ,(toks n)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return tok) ,()
  __is_null__ rest ,(test__) __if__ test__ (,() return tok) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  P_nth rest n)

(define P_next ,(p)
  __Cont_get__ ,(return)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __is_null__ rest ,(test__) __if__ test__ (,() return tok) ,()
  __Ref_set__ ref rest ,()
  __NULL__ tok)

;; 字句 tok が、記号か名前の text か
(define Tok_is ,(tok text)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "punct" ,(punct)
  __String_equal__ kind "id" ,(id)
  __or__ punct id ,(ok)
  __unless__ ok (,() return __FALSE__) ,()
  Tok_text tok ,(t)
  __String_equal__ t text)

(define P_is ,(p text)
  P_peek p ,(tok)
  Tok_is tok text)

(define P_eat ,(p text)
  __Cont_get__ ,(return)
  P_is p text ,(yes)
  __unless__ yes (,() return __FALSE__) ,()
  P_next p ,(tok)
  __NULL__ __TRUE__)

(define P_expect ,(p text)
  __Cont_get__ ,(return)
  P_eat p text ,(ok)
  __if__ ok return ,()
  P_peek p ,(tok)
  P_describe tok ,(d)
  __String_concat__ "expected '" text ,(msg)
  __String_concat__ msg "' but found " ,(msg)
  __String_concat__ msg d ,(msg)
  Sjs_throw "SyntaxError" msg)

(define P_describe ,(tok)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ (,() return "the end") ,()
  Tok_text tok ,(t)
  __String_concat__ "'" t ,(s)
  __String_concat__ s "'")

(define P_fail ,(p)
  P_peek p ,(tok)
  P_describe tok ,(d)
  __String_concat__ "unexpected " d ,(msg)
  Sjs_throw "SyntaxError" msg)

(define P_not_yet ,(what)
  __String_concat__ "not yet translated (stage B2 of SJS): " what ,(msg)
  Sjs_throw "SyntaxError" msg)

;; 名前（キーワードでない）
(define Sjs_keywords ,()
  __NULL__ " break case catch class const continue default delete do else false finally for function if in instanceof let new null of return switch this throw true try typeof var void while yield async await ")

(define Sjs_is_keyword ,(name)
  Sjs_keywords ,(kws)
  __String_concat__ " " name ,(s)
  __String_concat__ s " " ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ kws s zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define Tok_is_name ,(tok)
  __Cont_get__ ,(return)
  Tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(id)
  __unless__ id (,() return __FALSE__) ,()
  Tok_text tok ,(t)
  Sjs_is_keyword t ,(kw)
  __not__ kw)

(define P_name ,(p)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_is_name tok ,(ok)
  __unless__ ok
    (,() P_describe tok ,(d) __String_concat__ "expected a name but found " d ,(msg) Sjs_throw "SyntaxError" msg) ,()
  P_next p ,(tok)
  Tok_text tok)

;; 文の終わり：; か、} か入力の終わりの前か、改行の前
(define P_semi ,(p)
  __Cont_get__ ,(return)
  P_eat p ";" ,(test__) __if__ test__ return ,()
  P_is p "}" ,(test__) __if__ test__ return ,()
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ return ,()
  Tok_nl tok ,(test__) __if__ test__ return ,()
  P_fail p)

;; ── 文 ──

;; end（"}" か、入力の終わりなら ""）までの文の LList
(define P_statements ,(p end acc)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(atEof)
  __String_equal__ end "" ,(toEof)
  __and__ atEof toEof ,(test__) __if__ test__ (,() Sjs_reverse acc ,(body) return body) ,()
  __if__ atEof (,() P_expect p end) ,()
  P_is p end ,(test__) __if__ test__ (,() Sjs_reverse acc ,(body) return body) ,()
  P_statement p ,(s)
  __LList_cons__ s acc ,(acc)
  P_statements p end acc)

(define P_block ,(p)
  P_expect p "{" ,()
  P_statements p "}" __NULL__ ,(body)
  P_expect p "}" ,()
  Sjs_node "block" ,(n)
  __Dict_put__ n "body" body ,()
  __NULL__ n)

(define P_statement ,(p)
  __Cont_get__ ,(return)
  P_is p "{" ,(test__) __if__ test__ (,() P_block p ,(n) return n) ,()
  P_eat p ";" ,(test__) __if__ test__ (,() Sjs_node "empty" ,(n) return n) ,()
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "id" ,(isId)
  __if__ isId
    (,()
      Tok_text tok ,(word)
      __String_equal__ word "let" ,(isLet)
      __String_equal__ word "const" ,(isConst)
      __String_equal__ word "var" ,(isVar)
      __or__ isLet isConst ,(decl)
      __or__ decl isVar ,(test__) __if__ test__ (,() P_decl p ,(n) P_semi p ,() return n) ,()
      __String_equal__ word "if" ,(test__) __if__ test__ (,() P_if p ,(n) return n) ,()
      __String_equal__ word "while" ,(test__) __if__ test__ (,() P_while p ,(n) return n) ,()
      __String_equal__ word "return" ,(test__) __if__ test__ (,() P_return p ,(n) return n) ,()
      __String_equal__ word "for" ,(test__) __if__ test__ (,() P_for p ,(n) return n) ,()
      __String_equal__ word "break" ,(isBreak)
      __String_equal__ word "continue" ,(isContinue)
      __or__ isBreak isContinue ,(test__) __if__ test__
        (,()
          P_next p ,(t)
          P_peek p ,(next)
          Tok_is_name next ,(named)
          Tok_nl next ,(nl)
          __not__ nl ,(same)
          __and__ named same ,(test__) __if__ test__ (,() P_not_yet "labels") ,()
          P_semi p ,()
          Sjs_node word ,(n)
          return n) ,()
      P_unsupported_statement word ,()) ,()
  P_expression p ,(e)
  P_semi p ,()
  Sjs_node "expr" ,(n)
  __Dict_put__ n "expr" e ,()
  __NULL__ n)

(define P_unsupported_statement ,(word)
  __Cont_get__ ,(return)
  Sjs_in_words word "do switch throw try function" ,(test__)
  __unless__ test__ return ,()
  __String_concat__ word " statements" ,(what)
  P_not_yet what)

;; word が、空白で区切った語の並び words の 1 つか
(define Sjs_in_words ,(word words)
  __String_concat__ " " words ,(s)
  __String_concat__ s " " ,(s)
  __String_concat__ " " word ,(w)
  __String_concat__ w " " ,(w)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ s w zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define P_decl ,(p)
  P_next p ,(tok)
  Tok_text tok ,(kind)
  P_declarators p __NULL__ ,(decls)
  Sjs_node "decl" ,(n)
  __Dict_put__ n "kind" kind ,()
  __Dict_put__ n "decls" decls ,()
  __NULL__ n)

(define P_declarators ,(p acc)
  __Cont_get__ ,(return)
  P_is p "[" ,(arr)
  P_is p "{" ,(obj)
  __or__ arr obj ,(test__) __if__ test__ (,() P_not_yet "destructuring") ,()
  P_name p ,(name)
  P_eat p "=" ,(hasInit)
  __if_then_else__ hasInit (,() P_assign p) (,() __NULL__ __NULL__) ,(init)
  Sjs_node "declarator" ,(d)
  __Dict_put__ d "name" name ,()
  __Dict_put__ d "init" init ,()
  __LList_cons__ d acc ,(acc)
  P_eat p "," ,(more)
  __if__ more (,() P_declarators p acc ,(decls) return decls) ,()
  Sjs_reverse acc)

(define P_if ,(p)
  P_next p ,(tok)
  P_expect p "(" ,()
  P_expression p ,(test)
  P_expect p ")" ,()
  P_statement p ,(yes)
  P_eat p "else" ,(hasElse)
  __if_then_else__ hasElse (,() P_statement p) (,() __NULL__ __NULL__) ,(no)
  Sjs_node "if" ,(n)
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "yes" yes ,()
  __Dict_put__ n "no" no ,()
  __NULL__ n)

(define P_while ,(p)
  P_next p ,(tok)
  P_expect p "(" ,()
  P_expression p ,(test)
  P_expect p ")" ,()
  P_statement p ,(body)
  Sjs_node "while" ,(n)
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "body" body ,()
  __NULL__ n)

(define P_return ,(p)
  __Cont_get__ ,(return)
  P_next p ,(tok)
  Sjs_node "return" ,(n)
  P_peek p ,(next)
  Tok_is next ";" ,(semi)
  Tok_is next "}" ,(close)
  Tok_kind next ,(kind)
  __String_equal__ kind "eof" ,(eof)
  Tok_nl next ,(nl)
  __or__ semi close ,(none)
  __or__ none eof ,(none)
  __or__ none nl ,(none)
  __if__ none (,() __Dict_put__ n "value" __NULL__ ,() P_semi p ,() return n) ,()
  P_expression p ,(value)
  __Dict_put__ n "value" value ,()
  P_semi p ,()
  __NULL__ n)

;; ── 式 ──

(define P_expression ,(p)
  __Cont_get__ ,(return)
  P_assign p ,(e)
  P_is p "," ,(test__) __if__ test__ (,() P_not_yet "the comma operator") ,()
  __NULL__ e)

;; 代入の演算子か
(define Sjs_is_assign_op ,(text)
  Sjs_in_words text "= += -= *= /= %= **= <<= >>= >>>= &= |= ^= &&= ||= ??=")

(define P_assign ,(p)
  __Cont_get__ ,(return)
  ;; アロー関数：名前 => か、( ... ) =>
  P_peek p ,(tok)
  Tok_is_name tok ,(isName)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  P_peek_at p one ,(tok1)
  Tok_is tok1 "=>" ,(arrow1)
  __and__ isName arrow1 ,(test__) __if__ test__
    (,()
      P_next p ,(tok)
      Tok_text tok ,(name)
      P_next p ,(tok)
      __LList_cons__ name __NULL__ ,(params)
      P_arrow_body p params ,(n)
      return n) ,()
  Tok_is tok "(" ,(test__) __if__ test__
    (,()
      P_paren_arrow p ,(isArrow)
      __if__ isArrow
        (,()
          P_next p ,(tok)
          P_params p __NULL__ ,(params)
          P_expect p "=>" ,()
          P_arrow_body p params ,(n)
          return n) ,()) ,()
  P_conditional p ,(left)
  P_peek p ,(op)
  Tok_kind op ,(kind)
  __String_equal__ kind "punct" ,(punct)
  __unless__ punct (,() return left) ,()
  Tok_text op ,(opText)
  Sjs_is_assign_op opText ,(isAssign)
  __unless__ isAssign (,() return left) ,()
  P_next p ,(tok)
  P_target left ,()
  P_assign p ,(value)
  Sjs_node "assign" ,(n)
  __Dict_put__ n "op" opText ,()
  __Dict_put__ n "target" left ,()
  __Dict_put__ n "value" value ,()
  __NULL__ n)

;; 代入できる式か（段階 B1 は名前だけ）
(define P_target ,(e)
  __Cont_get__ ,(return)
  Sjs_get e "t" ,(t)
  __String_equal__ t "id" ,(test__) __if__ test__ return ,()
  __String_equal__ t "member" ,(test__) __if__ test__
    (,()
      __Dict_lookup_or__ e "optional" (,(k) __NULL__ __FALSE__) ,(opt)
      __if__ opt (,() Sjs_throw "SyntaxError" "cannot assign to an optional chain") ,()
      return) ,()
  Sjs_throw "SyntaxError" "cannot assign to this expression")

;; 今の ( に対応する ) の後が => か
(define P_paren_arrow ,(p)
  __Dict_lookup_or__ p "toks" __print_exit_error__ ,(ref)
  __Ref_get__ ref ,(toks)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  P_scan_close toks zero)

(define P_scan_close ,(toks depth)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  Tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ (,() return __FALSE__) ,()
  Tok_kind tok ,(kind)
  __String_equal__ kind "punct" ,(punct)
  Tok_text tok ,(t)
  Sjs_in_words t "( [ {" ,(open)
  Sjs_in_words t ") ] }" ,(close)
  __and__ punct open ,(isOpen)
  __and__ punct close ,(isClose)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __if_then_else__ isOpen (,() __Number_add__ depth one) (,()
    __if_then_else__ isClose (,() __Number_subtract__ depth one) (,() __NULL__ depth)) ,(depth)
  __Number_is_zero__ depth ,(atZero)
  __and__ isClose atZero ,(test__) __if__ test__
    (,()
      __Number_fromString__ __print_exit_error__ "0" ,(zero)
      P_nth rest zero ,(next)
      Tok_is next "=>" ,(t)
      return t) ,()
  P_scan_close rest depth)

;; ( の後から ) まで（) も読む）の引数の名前の LList
(define P_params ,(p acc)
  __Cont_get__ ,(return)
  P_eat p ")" ,(test__) __if__ test__ (,() Sjs_reverse acc ,(params) return params) ,()
  P_is p "..." ,(test__) __if__ test__ (,() P_not_yet "rest parameters") ,()
  P_is p "[" ,(arr)
  P_is p "{" ,(obj)
  __or__ arr obj ,(test__) __if__ test__ (,() P_not_yet "destructuring parameters") ,()
  P_name p ,(name)
  P_is p "=" ,(test__) __if__ test__ (,() P_not_yet "default values of parameters") ,()
  __LList_cons__ name acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p ")" ,() Sjs_reverse acc ,(params) return params) ,()
  P_params p acc)

(define P_arrow_body ,(p params)
  __Cont_get__ ,(return)
  Sjs_node "arrow" ,(n)
  __Dict_put__ n "params" params ,()
  P_is p "{" ,(test__) __if__ test__
    (,() P_block p ,(body) __Dict_put__ n "body" body ,() __Dict_put__ n "expr" __NULL__ ,() return n) ,()
  P_assign p ,(e)
  __Dict_put__ n "body" __NULL__ ,()
  __Dict_put__ n "expr" e ,()
  __NULL__ n)

(define P_conditional ,(p)
  __Cont_get__ ,(return)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  P_binary p zero ,(test)
  P_eat p "?" ,(isCond)
  __unless__ isCond (,() return test) ,()
  P_assign p ,(yes)
  P_expect p ":" ,()
  P_assign p ,(no)
  Sjs_node "cond" ,(n)
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "yes" yes ,()
  __Dict_put__ n "no" no ,()
  __NULL__ n)

;; 二項演算子の優先順位（conma.js の SJS_BINARY と同じ）。二項演算子でなければ null
(define Sjs_prec ,(op)
  __Cont_get__ ,(return)
  __NULL__ (,(words n) Sjs_in_words op words ,(t) __if__ t (,() __Number_fromString__ __print_exit_error__ n ,(m) return m)) ,(level)
  level "??" "1" ,()
  level "||" "2" ,()
  level "&&" "3" ,()
  level "|" "4" ,()
  level "^" "5" ,()
  level "&" "6" ,()
  level "=== !==" "7" ,()
  level "< > <= >= in instanceof" "8" ,()
  level "<< >> >>>" "9" ,()
  level "+ -" "10" ,()
  level "* / %" "11" ,()
  level "**" "12" ,()
  __NULL__ __NULL__)

(define P_binary ,(p min)
  P_unary p ,(left)
  P_binary_rest p min left)

(define P_binary_rest ,(p min left)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "punct" ,(punct)
  Tok_text tok ,(op)
  __String_equal__ op "in" ,(isIn)
  __String_equal__ op "instanceof" ,(isInstanceof)
  __or__ isIn isInstanceof ,(word)
  __String_equal__ kind "id" ,(id)
  __and__ id word ,(wordOp)
  __or__ punct wordOp ,(maybe)
  __unless__ maybe (,() return left) ,()
  Sjs_prec op ,(prec)
  __is_null__ prec ,(test__) __if__ test__ (,() return left) ,()
  __Number_subtract__ prec min ,(d)
  __Number_is_positive__ d ,(higher)
  __unless__ higher (,() return left) ,()
  __if__ wordOp (,() __String_concat__ "the operator " op ,(what) P_not_yet what) ,()
  P_next p ,(t)
  ;; ** は右結合
  __String_equal__ op "**" ,(right)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __if_then_else__ right (,() __Number_subtract__ prec one) (,() __NULL__ prec) ,(next)
  P_binary p next ,(rhs)
  Sjs_node "binary" ,(n)
  __Dict_put__ n "op" op ,()
  __Dict_put__ n "left" left ,()
  __Dict_put__ n "right" rhs ,()
  P_binary_rest p min n)

(define P_unary ,(p)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  Tok_text tok ,(text)
  __String_equal__ kind "punct" ,(punct)
  Sjs_in_words text "! - + ~" ,(sign)
  __and__ punct sign ,(isSign)
  __String_equal__ kind "id" ,(id)
  Sjs_in_words text "typeof void delete" ,(wordOp)
  __and__ id wordOp ,(isWord)
  __or__ isSign isWord ,(test__) __if__ test__
    (,()
      P_next p ,(t)
      P_unary p ,(arg)
      Sjs_node "unary" ,(n)
      __Dict_put__ n "op" text ,()
      __Dict_put__ n "arg" arg ,()
      return n) ,()
  Sjs_in_words text "++ --" ,(step)
  __and__ punct step ,(test__) __if__ test__
    (,()
      P_next p ,(t)
      P_unary p ,(target)
      P_target target ,()
      Sjs_node "update" ,(n)
      __Dict_put__ n "op" text ,()
      __Dict_put__ n "prefix" __TRUE__ ,()
      __Dict_put__ n "target" target ,()
      return n) ,()
  P_postfix p ,(e)
  P_peek p ,(tok)
  Tok_is tok "++" ,(inc)
  Tok_is tok "--" ,(dec)
  __or__ inc dec ,(isStep)
  Tok_nl tok ,(nl)
  __not__ nl ,(sameLine)
  __and__ isStep sameLine ,(test__) __if__ test__
    (,()
      P_next p ,(t)
      Tok_text t ,(op)
      P_target e ,()
      Sjs_node "update" ,(n)
      __Dict_put__ n "op" op ,()
      __Dict_put__ n "prefix" __FALSE__ ,()
      __Dict_put__ n "target" e ,()
      return n) ,()
  __NULL__ e)

(define P_postfix ,(p)
  P_primary p ,(e)
  P_postfix_rest p e)

(define P_postfix_rest ,(p e)
  __Cont_get__ ,(return)
  P_eat p "." ,(test__) __if__ test__
    (,()
      P_next p ,(tok)
      Tok_kind tok ,(kind)
      __String_equal__ kind "id" ,(ok)
      __unless__ ok (,() Sjs_throw "SyntaxError" "expected a property name after '.'") ,()
      Tok_text tok ,(name)
      Sjs_node "member" ,(n)
      __Dict_put__ n "object" e ,()
      __Dict_put__ n "name" name ,()
      P_postfix_rest p n ,(r)
      return r) ,()
  P_eat p "(" ,(test__) __if__ test__
    (,()
      P_args p __NULL__ ,(args)
      Sjs_node "call" ,(n)
      __Dict_put__ n "callee" e ,()
      __Dict_put__ n "args" args ,()
      P_postfix_rest p n ,(r)
      return r) ,()
  P_eat p "[" ,(test__) __if__ test__
    (,()
      P_expression p ,(key)
      P_expect p "]" ,()
      Sjs_node "member" ,(n)
      __Dict_put__ n "object" e ,()
      __Dict_put__ n "key" key ,()
      P_postfix_rest p n ,(r)
      return r) ,()
  P_eat p "?." ,(test__) __if__ test__
    (,()
      P_eat p "(" ,(test__) __if__ test__
        (,()
          P_args p __NULL__ ,(args)
          Sjs_node "call" ,(n)
          __Dict_put__ n "callee" e ,()
          __Dict_put__ n "args" args ,()
          __Dict_put__ n "optional" __TRUE__ ,()
          P_postfix_rest p n ,(r)
          return r) ,()
      Sjs_node "member" ,(n)
      __Dict_put__ n "object" e ,()
      __Dict_put__ n "optional" __TRUE__ ,()
      P_eat p "[" ,(computed)
      __if_then_else__ computed
        (,() P_expression p ,(key) P_expect p "]" ,() __Dict_put__ n "key" key)
        (,()
          P_next p ,(tok)
          Tok_kind tok ,(kind)
          __String_equal__ kind "id" ,(ok)
          __unless__ ok (,() Sjs_throw "SyntaxError" "expected a property name after '?.'") ,()
          Tok_text tok ,(name)
          __Dict_put__ n "name" name) ,()
      P_postfix_rest p n ,(r)
      return r) ,()
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  __String_equal__ kind "template" ,(t1)
  __String_equal__ kind "tmplhead" ,(t2)
  __or__ t1 t2 ,(test__) __if__ test__ (,() P_not_yet "tagged templates") ,()
  __NULL__ e)

;; ( の後から ) まで（) も読む）の引数の式の LList
(define P_args ,(p acc)
  __Cont_get__ ,(return)
  P_eat p ")" ,(test__) __if__ test__ (,() Sjs_reverse acc ,(args) return args) ,()
  P_is p "..." ,(test__) __if__ test__ (,() P_not_yet "spread arguments") ,()
  P_assign p ,(a)
  __LList_cons__ a acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p ")" ,() Sjs_reverse acc ,(args) return args) ,()
  P_args p acc)

(define P_primary ,(p)
  __Cont_get__ ,(return)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  Tok_text tok ,(text)
  __String_equal__ kind "num" ,(test__) __if__ test__
    (,() P_next p ,(t) Sjs_node "num" ,(n) __Dict_put__ n "text" text ,() return n) ,()
  __String_equal__ kind "str" ,(test__) __if__ test__
    (,() P_next p ,(t) Sjs_node "str" ,(n) __Dict_put__ n "value" text ,() return n) ,()
  __String_equal__ kind "id" ,(test__) __if__ test__
    (,()
      Sjs_in_words text "true false null" ,(test__) __if__ test__
        (,() P_next p ,(t) Sjs_node "lit" ,(n) __Dict_put__ n "text" text ,() return n) ,()
      __String_equal__ text "function" ,(test__) __if__ test__ (,() P_function p ,(n) return n) ,()
      P_name p ,(name)
      Sjs_node "id" ,(n)
      __Dict_put__ n "name" name ,()
      return n) ,()
  P_eat p "(" ,(test__) __if__ test__
    (,()
      P_expression p ,(e)
      P_expect p ")" ,()
      Sjs_node "paren" ,(n)
      __Dict_put__ n "expr" e ,()
      return n) ,()
  __String_equal__ kind "template" ,(test__) __if__ test__
    (,()
      P_next p ,(t)
      __LList_cons__ text __NULL__ ,(parts)
      Sjs_node "template" ,(n)
      __Dict_put__ n "parts" parts ,()
      __Dict_put__ n "exprs" __NULL__ ,()
      return n) ,()
  __String_equal__ kind "tmplhead" ,(test__) __if__ test__
    (,()
      P_next p ,(t)
      __LList_cons__ text __NULL__ ,(parts)
      P_template_rest p parts __NULL__ ,(n)
      return n) ,()
  P_eat p "[" ,(test__) __if__ test__ (,() P_array p __NULL__ ,(n) return n) ,()
  P_eat p "{" ,(test__) __if__ test__ (,() P_object p __NULL__ ,(n) return n) ,()
  P_fail p)

;; テンプレートの ${ の後から。parts と exprs は逆順
(define P_template_rest ,(p parts exprs)
  __Cont_get__ ,(return)
  P_expression p ,(e)
  __LList_cons__ e exprs ,(exprs)
  P_next p ,(tok)
  Tok_kind tok ,(kind)
  Tok_text tok ,(text)
  __LList_cons__ text parts ,(parts)
  __String_equal__ kind "tmplmid" ,(test__) __if__ test__ (,() P_template_rest p parts exprs ,(n) return n) ,()
  __String_equal__ kind "tmpltail" ,(ok)
  __unless__ ok (,() Sjs_throw "SyntaxError" "expected the rest of a template literal") ,()
  Sjs_reverse parts ,(parts)
  Sjs_reverse exprs ,(exprs)
  Sjs_node "template" ,(n)
  __Dict_put__ n "parts" parts ,()
  __Dict_put__ n "exprs" exprs ,()
  __NULL__ n)

;; [ の後から ] まで（] も読む）の配列のリテラル
(define P_array ,(p acc)
  __Cont_get__ ,(return)
  P_eat p "]" ,(test__) __if__ test__
    (,() Sjs_reverse acc ,(items) Sjs_node "array" ,(n) __Dict_put__ n "items" items ,() return n) ,()
  P_is p "," ,(test__) __if__ test__ (,() P_not_yet "holes in array literals") ,()
  P_is p "..." ,(test__) __if__ test__ (,() P_not_yet "spread elements") ,()
  P_assign p ,(e)
  __LList_cons__ e acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p "]" ,() Sjs_reverse acc ,(items) Sjs_node "array" ,(n) __Dict_put__ n "items" items ,() return n) ,()
  P_array p acc)

;; { の後から } まで（} も読む）のオブジェクトのリテラル
(define P_object ,(p acc)
  __Cont_get__ ,(return)
  __NULL__ (,(acc) Sjs_reverse acc ,(props) Sjs_node "object" ,(n) __Dict_put__ n "props" props ,() return n) ,(finish)
  P_eat p "}" ,(test__) __if__ test__ (,() finish acc) ,()
  P_property p ,(prop)
  __LList_cons__ prop acc ,(acc)
  P_eat p "," ,(comma)
  __unless__ comma (,() P_expect p "}" ,() finish acc) ,()
  P_object p acc)

(define P_property ,(p)
  __Cont_get__ ,(return)
  P_is p "..." ,(test__) __if__ test__ (,() P_not_yet "spread properties") ,()
  Sjs_node "prop" ,(prop)
  P_peek p ,(tok)
  Tok_kind tok ,(kind)
  Tok_text tok ,(text)
  ;; get と set（getter と setter）は SJS の範囲の外
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  P_peek_at p one ,(after)
  Tok_is after ":" ,(a1)
  Tok_is after "(" ,(a2)
  Tok_is after "," ,(a3)
  Tok_is after "}" ,(a4)
  __or__ a1 a2 ,(x) __or__ x a3 ,(x) __or__ x a4 ,(plainAfter)
  __String_equal__ kind "id" ,(isId)
  Sjs_in_words text "get set" ,(accessor)
  __and__ isId accessor ,(y)
  __not__ plainAfter ,(z)
  __and__ y z ,(test__) __if__ test__ (,() Sjs_throw "SyntaxError" "not in SJS: a getter or a setter") ,()
  ;; キー
  P_eat p "[" ,(computed)
  __if__ computed
    (,() P_assign p ,(key) P_expect p "]" ,() __Dict_put__ prop "computed" key) ,()
  __unless__ computed
    (,()
      __String_equal__ kind "str" ,(isStr)
      __String_equal__ kind "num" ,(isNum)
      __or__ isId isStr ,(ok)
      __or__ ok isNum ,(ok)
      __unless__ ok (,() P_fail p) ,()
      __String_equal__ text "__proto__" ,(proto)
      __and__ isStr proto ,(test__) __if__ test__ (,() Sjs_throw "SyntaxError" "not in SJS: the property __proto__") ,()
      P_next p ,(t)
      __Dict_put__ prop "key" text ,()
      __Dict_put__ prop "computed" __NULL__) ,()
  P_eat p ":" ,(test__) __if__ test__ (,() P_assign p ,(v) __Dict_put__ prop "value" v ,() return prop) ,()
  ;; メソッド：名前(引数) { 本体 }
  P_eat p "(" ,(test__) __if__ test__
    (,()
      P_params p __NULL__ ,(params)
      P_block p ,(body)
      Sjs_node "function" ,(f)
      __Dict_put__ f "params" params ,()
      __Dict_put__ f "body" body ,()
      __Dict_put__ f "expr" __NULL__ ,()
      __Dict_put__ f "name" text ,()
      __Dict_put__ prop "value" f ,()
      return prop) ,()
  ;; 短縮形：名前
  __if__ computed (,() P_fail p) ,()
  __unless__ isId (,() P_fail p) ,()
  Sjs_is_keyword text ,(kw)
  __if__ kw (,() P_fail p) ,()
  Sjs_node "id" ,(v)
  __Dict_put__ v "name" text ,()
  __Dict_put__ prop "value" v ,()
  __NULL__ prop)

;; for 文
(define P_for ,(p)
  __Cont_get__ ,(return)
  P_next p ,(t)
  P_expect p "(" ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  P_peek p ,(tok)
  Tok_is tok "let" ,(isLet)
  Tok_is tok "const" ,(isConst)
  Tok_is tok "var" ,(isVar)
  __or__ isLet isConst ,(decl)
  __or__ decl isVar ,(decl)
  ;; for (let x of e) と for (let x in e)、for (x of e)
  __if_then_else__ decl (,() P_peek_at p one ,(n1) P_peek_at p two ,(n2) __NULL__ n1 n2) (,() P_peek_at p one ,(n2) __NULL__ tok n2) ,(nameTok ofTok)
  Tok_is_name nameTok ,(named)
  Tok_is ofTok "of" ,(isOf)
  Tok_is ofTok "in" ,(isIn)
  __or__ isOf isIn ,(ofIn)
  __and__ named ofIn ,(test__) __if__ test__
    (,()
      __if_then_else__ decl (,() P_next p ,(k) Tok_text k) (,() __NULL__ __NULL__) ,(kind)
      P_name p ,(name)
      P_next p ,(o)
      Tok_text o ,(of)
      P_expression p ,(right)
      P_expect p ")" ,()
      P_statement p ,(body)
      Sjs_node "forof" ,(n)
      __Dict_put__ n "kind" kind ,()
      __Dict_put__ n "name" name ,()
      __Dict_put__ n "of" of ,()
      __Dict_put__ n "right" right ,()
      __Dict_put__ n "body" body ,()
      return n) ,()
  P_is p ";" ,(noInit)
  __if_then_else__ noInit (,() __NULL__ __NULL__) (,()
    __if_then_else__ decl
      (,() P_decl p)
      (,() P_expression p ,(e) Sjs_node "expr" ,(s) __Dict_put__ s "expr" e ,() __NULL__ s)) ,(init)
  P_expect p ";" ,()
  P_is p ";" ,(noTest)
  __if_then_else__ noTest (,() __NULL__ __NULL__) (,() P_expression p) ,(test)
  P_expect p ";" ,()
  P_is p ")" ,(noUpdate)
  __if_then_else__ noUpdate (,() __NULL__ __NULL__) (,() P_expression p) ,(update)
  P_expect p ")" ,()
  P_statement p ,(body)
  Sjs_node "for" ,(n)
  __Dict_put__ n "init" init ,()
  __Dict_put__ n "test" test ,()
  __Dict_put__ n "update" update ,()
  __Dict_put__ n "body" body ,()
  __NULL__ n)

;; function 式（名前は読むが使わない）
(define P_function ,(p)
  __Cont_get__ ,(return)
  P_next p ,(tok)
  P_is p "*" ,(test__) __if__ test__ (,() Sjs_throw "SyntaxError" "not in SJS: a generator") ,()
  P_peek p ,(tok)
  Tok_is_name tok ,(named)
  __if_then_else__ named (,() P_next p ,(t) Tok_text t) (,() __NULL__ "") ,(fname)
  P_expect p "(" ,()
  P_params p __NULL__ ,(params)
  P_block p ,(body)
  Sjs_node "function" ,(n)
  __Dict_put__ n "name" fname ,()
  __Dict_put__ n "params" params ,()
  __Dict_put__ n "body" body ,()
  __Dict_put__ n "expr" __NULL__ ,()
  __NULL__ n)
