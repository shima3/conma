;; ConSh の glob（PLAN-ja.md 1.2 の「glob の適用は Bash と同様とする」）。consh_parse の glob.glob と同じ結果にする。
;;
;; パターンは String で、\c は文字 c そのものを表す。引用符の中の文字と ${-語} の葉は、*、?、[、]、-、!、\ に \ を付けて入れ
;; （Glob_escape）、引用符の外の文字は \ だけに \ を付けて入れる（Glob_escape_active）。それ以外の *、?、[...] が記号である。
;;   *      0 文字以上の任意の文字列
;;   ?      任意の1文字
;;   [...]  中のどれかの1文字。a-z は範囲、先頭の ! は否定、先頭の ] はその文字。閉じていない [ はその文字
;; / で区切った部分ごとに、記号を含む部分は __OS_listdir__ の名前と照合し、含まない部分はそのまま付ける。
;; . で始まる名前は、パターンの部分が . で始まるときだけ一致する。結果は文字コード順に並べる

;; ── パターンを作る ──

;; s の、chars のどれかの文字の前に \ を付けた String
(define Glob_escape ,(s)
  Glob_escape_chars s "*?[]-!\\")

(define Glob_escape_active ,(s)
  Glob_escape_chars s "\\")

(define Glob_escape_chars ,(s chars)
  __Cont_get__ ,(return)
  Glob_has_any s chars ,(has)
  __unless__ has (,() return s) ,()
  __String_length__ s ,(len)
  num "0" ,(zero)
  Glob_escape_from s zero len chars "")

(define Glob_escape_from ,(s i len chars acc)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return acc) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ s i next ,(ch)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ chars ch zero ,(pos)
  __if_then_else__ (,() __is_null__ pos)
    (,() __NULL__ acc)
    (,() __String_concat__ acc "\\") ,(acc)
  __String_concat__ acc ch ,(acc)
  Glob_escape_from s next len chars acc)

;; s が chars のどれかの文字を含むか。chars の文字ごとに __String_find__ で探す
(define Glob_has_any ,(s chars)
  num "0" ,(zero)
  Glob_has_any_from s chars zero)

(define Glob_has_any_from ,(s chars i)
  __Cont_get__ ,(return)
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ (,(msg) return __FALSE__) chars i next ,(ch)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ s ch zero ,(pos)
  __is_null__ pos ,(condition)
  __unless__ condition (,() return __TRUE__) ,()
  Glob_has_any_from s chars next)

;; 引用符の外の文字列 s が glob の記号を含むか。語の展開のたびに呼ぶので、記号ごとに直接探す
(define Glob_has_meta ,(s)
  __Cont_get__ ,(return)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ s "*" zero ,(pos)
  __is_null__ pos ,(condition)
  __unless__ condition (,() return __TRUE__) ,()
  __String_find__ __print_exit_error__ s "?" zero ,(pos)
  __is_null__ pos ,(condition)
  __unless__ condition (,() return __TRUE__) ,()
  __String_find__ __print_exit_error__ s "[" zero ,(pos)
  __is_null__ pos ,(none)
  __not__ none)

;; ── 展開する ──

;; パターンに一致したパスの LList（文字コード順）。一致しなければ null
(define Glob_expand ,(pattern)
  __Cont_get__ ,(return)
  Glob_split pattern ,(comps)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ pattern "/" zero ,(slash)
  __if_then_else__ (,() __is_null__ slash) (,() __NULL__ __FALSE__) (,() __Number_is_zero__ slash) ,(absolute)
  __if_then_else__ absolute
    (,()
      __LList_uncons__ __print_exit_error__ comps ,(first rest)
      __LList_cons__ "/" __NULL__ ,(prefixes)
      __NULL__ prefixes rest)
    (,()
      __LList_cons__ "" __NULL__ ,(prefixes)
      __NULL__ prefixes comps) ,(prefixes comps)
  Glob_walk prefixes comps __FALSE__ ,(paths multi)
  __unless__ multi (,() return paths) ,()
  Glob_sort paths)

;; s を / で区切った String の LList
(define Glob_split ,(s)
  __Cont_get__ ,(return)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ s "/" zero ,(pos)
  __if__ (,() __is_null__ pos) (,() __LList_cons__ s __NULL__ ,(list) return list) ,()
  __String_substring__ __print_exit_error__ s zero pos ,(head)
  num "1" ,(one)
  __Number_add__ pos one ,(next)
  __String_length__ s ,(len)
  __String_substring__ __print_exit_error__ s next len ,(rest)
  Glob_split rest ,(tail)
  __LList_cons__ head tail)

;; 部分 comps を順に照合し、一致したパスの LList と、2つ以上のディレクトリの名前を合わせたか（並べ直しが要るか）を返す
(define Glob_walk ,(prefixes comps multi)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ comps) (,() return prefixes multi) ,()
  __if__ (,() __is_null__ prefixes) (,() return __NULL__ multi) ,()
  __LList_uncons__ __print_exit_error__ comps ,(comp rest)
  __is_null__ rest ,(last)
  __if__ (,() __String_equal__ comp "")
    (,()
      ;; 最後の / はディレクトリだけに一致させ、/ を付ける。途中の // は1つの / とみなす
      __if_then_else__ last
        (,() Glob_dirs prefixes)
        (,() __NULL__ prefixes) ,(prefixes)
      Glob_walk prefixes rest multi ,(paths multi)
      return paths multi) ,()
  Glob_is_magic comp ,(magic)
  __if__ magic
    (,()
      List_length prefixes ,(n)
      num "1" ,(one)
      __Number_subtract__ n one ,(more)
      __Number_is_positive__ more ,(several)
      __or__ multi several ,(multi)
      Glob_list_matches prefixes comp ,(prefixes)
      Glob_walk prefixes rest multi ,(paths multi)
      return paths multi) ,()
  Glob_unescape comp ,(name)
  Glob_add_literal prefixes name last ,(prefixes)
  Glob_walk prefixes rest multi)

;; prefix の後ろに name を付けたパス。prefix が "" ならカレントディレクトリ
(define Glob_join ,(prefix name)
  __Cont_get__ ,(return)
  __if__ (,() __String_equal__ prefix "") (,() return name) ,()
  __String_length__ prefix ,(len)
  num "1" ,(one)
  __Number_subtract__ len one ,(last)
  __String_substring__ __print_exit_error__ prefix last len ,(ch)
  __if__ (,() __String_equal__ ch "/") (,() __String_concat__ prefix name ,(path) return path) ,()
  __String_concat__ prefix "/" ,(path)
  __String_concat__ path name)

;; __OS_listdir__ に渡すディレクトリ。"" は "."
(define Glob_dir ,(prefix)
  __if_then_else__ (,() __String_equal__ prefix "") (,() __NULL__ ".") (,() __NULL__ prefix))

;; 各 prefix のディレクトリの中で、comp に一致する名前のパスを並べる。読めないディレクトリは飛ばす
(define Glob_list_matches ,(prefixes comp)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ prefixes) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ prefixes ,(prefix rest)
  Glob_dir prefix ,(dir)
  Glob_listdir dir ,(names)
  num "0" ,(zero)
  num "1" ,(one)
  __String_substring__ __print_exit_error__ comp zero one ,(first)
  __String_equal__ first "." ,(dotted)
  Glob_filter prefix names comp dotted ,(front)
  Glob_list_matches rest comp ,(back)
  List_append front back)

;; ディレクトリの名前の LList。読めなければ null
(define Glob_listdir ,(dir)
  __Cont_get__ ,(return)
  __OS_listdir__ (,(msg) return __NULL__) dir)

(define Glob_filter ,(prefix names comp dotted)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ names) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ names ,(name rest)
  Glob_filter prefix rest comp dotted ,(tail)
  num "0" ,(zero)
  num "1" ,(one)
  __String_substring__ __print_exit_error__ name zero one ,(first)
  __String_equal__ first "." ,(hidden)
  __not__ dotted ,(undotted)
  __and__ hidden undotted ,(skip)
  __if__ skip (,() return tail) ,()
  Glob_match comp name ,(ok)
  __unless__ ok (,() return tail) ,()
  Glob_join prefix name ,(path)
  __LList_cons__ path tail)

;; 記号のない部分 name を付ける。最後の部分なら、あるものだけを残す
(define Glob_add_literal ,(prefixes name last)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ prefixes) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ prefixes ,(prefix rest)
  Glob_add_literal rest name last ,(tail)
  __if_then_else__ last
    (,()
      Glob_dir prefix ,(dir)
      __OS_listdir__ (,(msg) return tail) dir ,(names)
      ;; . と .. は __OS_listdir__ が返さないが、ディレクトリがあればある
      __String_equal__ name "." ,(dot)
      __String_equal__ name ".." ,(dotdot)
      __or__ dot dotdot ,(special)
      __if_then_else__ special (,() __NULL__ __TRUE__) (,() List_contains names name))
    (,() __NULL__ __TRUE__) ,(exists)
  __unless__ exists (,() return tail) ,()
  Glob_join prefix name ,(path)
  __LList_cons__ path tail)

;; ディレクトリであるものだけに / を付けて残す
(define Glob_dirs ,(prefixes)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ prefixes) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ prefixes ,(prefix rest)
  Glob_dirs rest ,(tail)
  Glob_dir prefix ,(dir)
  __OS_listdir__ (,(msg) return tail) dir ,(names)
  Glob_join prefix "" ,(path)
  __LList_cons__ path tail)

(define List_contains ,(list s)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return __FALSE__) ,()
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __if__ (,() __String_equal__ head s) (,() return __TRUE__) ,()
  List_contains rest s)

;; 部分が、\ の付いていない記号を含むか
(define Glob_is_magic ,(comp)
  __Cont_get__ ,(return)
  Glob_has_meta comp ,(has)
  __unless__ has (,() return __FALSE__) ,()
  __String_length__ comp ,(len)
  num "0" ,(zero)
  Glob_is_magic_from comp zero len)

(define Glob_is_magic_from ,(p i len)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return __FALSE__) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ p i next ,(c)
  __if__ (,() __String_equal__ c "\\")
    (,()
      __Number_add__ next one ,(after)
      __Number_subtract__ len after ,(over)
      __if__ (,() __Number_is_negative__ over) (,() return __FALSE__) ,()
      Glob_is_magic_from p after len ,(b)
      return b) ,()
  Glob_has_meta c ,(meta)
  __if__ meta (,() return __TRUE__) ,()
  Glob_is_magic_from p next len)

;; \ を取り除いた String（記号のない部分）
(define Glob_unescape ,(p)
  __Cont_get__ ,(return)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ p "\\" zero ,(pos)
  __if__ (,() __is_null__ pos) (,() return p) ,()
  __String_length__ p ,(len)
  Glob_unescape_from p zero len "")

(define Glob_unescape_from ,(p i len acc)
  __Cont_get__ ,(return)
  __Number_subtract__ len i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return acc) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ p i next ,(c)
  __Number_subtract__ len next ,(rest)
  __String_equal__ c "\\" ,(isEscape)
  __Number_is_positive__ rest ,(hasNext)
  __and__ isEscape hasNext ,(escaped)
  __if__ escaped
    (,()
      __Number_add__ next one ,(after)
      __String_substring__ __print_exit_error__ p next after ,(d)
      __String_concat__ acc d ,(acc)
      Glob_unescape_from p after len acc ,(s)
      return s) ,()
  __String_concat__ acc c ,(acc)
  Glob_unescape_from p next len acc)

;; ── 照合 ──

;; 部分のパターン p が名前 n 全体に一致するか
(define Glob_match ,(p n)
  __String_length__ p ,(plen)
  __String_length__ n ,(nlen)
  num "0" ,(zero)
  Glob_match_at p zero plen n zero nlen)

(define Glob_match_at ,(p pi plen n ni nlen)
  __Cont_get__ ,(return)
  __Number_subtract__ plen pi ,(pleft)
  __Number_subtract__ nlen ni ,(nleft)
  __if__ (,() __Number_is_zero__ pleft) (,() __Number_is_zero__ nleft ,(b) return b) ,()
  num "1" ,(one)
  __Number_add__ pi one ,(next)
  __String_substring__ __print_exit_error__ p pi next ,(c)
  __if__ (,() __String_equal__ c "*") (,() Glob_match_star p next plen n ni nlen ,(b) return b) ,()
  __if__ (,() __Number_is_zero__ nleft) (,() return __FALSE__) ,()
  __Number_add__ ni one ,(ni1)
  __String_substring__ __print_exit_error__ n ni ni1 ,(ch)
  __if__ (,() __String_equal__ c "?") (,() Glob_match_at p next plen n ni1 nlen ,(b) return b) ,()
  __if__ (,() __String_equal__ c "[")
    (,()
      Glob_class p next plen ch ,(ok after closed)
      __if__ closed
        (,()
          __unless__ ok (,() return __FALSE__) ,()
          Glob_match_at p after plen n ni1 nlen ,(b)
          return b) ,()) ,()
  ;; \c はその文字。閉じていない [ と、最後の \ もその文字
  __Number_subtract__ plen next ,(rest)
  __String_equal__ c "\\" ,(isEscape)
  __Number_is_positive__ rest ,(hasNext)
  __and__ isEscape hasNext ,(escaped)
  __if_then_else__ escaped
    (,()
      __Number_add__ next one ,(after)
      __String_substring__ __print_exit_error__ p next after ,(lit)
      __NULL__ lit after)
    (,() __NULL__ c next) ,(lit after)
  __unless__ (,() __String_equal__ lit ch) (,() return __FALSE__) ,()
  Glob_match_at p after plen n ni1 nlen)

;; * の後ろのパターンが、名前の ni 文字目以降のどこかから一致するか
(define Glob_match_star ,(p pi plen n ni nlen)
  __Cont_get__ ,(return)
  Glob_match_at p pi plen n ni nlen ,(ok)
  __if__ ok (,() return __TRUE__) ,()
  __Number_subtract__ nlen ni ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return __FALSE__) ,()
  num "1" ,(one)
  __Number_add__ ni one ,(ni1)
  Glob_match_star p pi plen n ni1 nlen)

;; [ の後ろ（i 文字目から）の文字の集まりに ch が入るか、] の後ろの位置、] で閉じているかを返す
(define Glob_class ,(p i plen ch)
  __Cont_get__ ,(return)
  __Number_subtract__ plen i ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return __FALSE__ i __FALSE__) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ p i next ,(c)
  __String_equal__ c "!" ,(negate)
  __if_then_else__ negate (,() __NULL__ next) (,() __NULL__ i) ,(start)
  __String_toCode__ __print_exit_error__ ch ,(code)
  Glob_class_items p start start plen code __FALSE__ ,(found after closed)
  __if_then_else__ negate (,() __not__ found) (,() __NULL__ found) ,(ok)
  __NULL__ ok after closed)

;; j 文字目から ] まで。最初の文字（start）の ] はその文字。a-z は範囲、\c は c
(define Glob_class_items ,(p start j plen code found)
  __Cont_get__ ,(return)
  __Number_subtract__ plen j ,(left)
  __if__ (,() __Number_is_zero__ left) (,() return found j __FALSE__) ,()
  num "1" ,(one)
  __Number_add__ j one ,(next)
  __String_substring__ __print_exit_error__ p j next ,(c)
  __Number_subtract__ j start ,(offset)
  __Number_is_zero__ offset ,(isFirst)
  __if__ (,()
      __String_equal__ c "]" ,(isClose)
      __not__ isFirst ,(notFirst)
      __and__ isClose notFirst)
    (,() return found next __TRUE__) ,()
  ;; \c は c
  __Number_subtract__ plen next ,(rest)
  __String_equal__ c "\\" ,(isEscape)
  __Number_is_positive__ rest ,(hasNext)
  __and__ isEscape hasNext ,(escaped)
  __if_then_else__ escaped
    (,()
      __Number_add__ next one ,(after)
      __String_substring__ __print_exit_error__ p next after ,(d)
      __NULL__ d after)
    (,() __NULL__ c next) ,(c next)
  __String_toCode__ __print_exit_error__ c ,(low)
  ;; 範囲 c-d（- の後ろが ] でなければ）
  Glob_range_end p next plen ,(high after)
  __Number_subtract__ code low ,(fromLow)
  __Number_subtract__ high code ,(toHigh)
  __Number_is_negative__ fromLow ,(below)
  __Number_is_negative__ toHigh ,(above)
  __or__ below above ,(outside)
  __not__ outside ,(inside)
  __or__ found inside ,(found)
  Glob_class_items p start after plen code found)

;; i 文字目が - で、その後ろが ] でなければ、範囲の終わりの文字のコードと、その後ろの位置。
;; そうでなければ、範囲ではないので、終わりは i 文字目の前の文字（範囲の始まり）のコードと、位置 i
(define Glob_range_end ,(p i plen)
  __Cont_get__ ,(return)
  num "1" ,(one)
  num "2" ,(two)
  __Number_add__ i two ,(endNext)
  __Number_subtract__ plen endNext ,(room)
  __if__ (,() __Number_is_negative__ room) (,() Glob_prev_code p i ,(c) return c i) ,()
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ p i next ,(dash)
  __unless__ (,() __String_equal__ dash "-") (,() Glob_prev_code p i ,(c) return c i) ,()
  __String_substring__ __print_exit_error__ p next endNext ,(d)
  __if__ (,() __String_equal__ d "]") (,() Glob_prev_code p i ,(c) return c i) ,()
  __String_toCode__ __print_exit_error__ d ,(high)
  __NULL__ high endNext)

;; i 文字目の前の文字のコード（範囲でない1文字の終わり）
(define Glob_prev_code ,(p i)
  num "1" ,(one)
  __Number_subtract__ i one ,(prev)
  __String_substring__ __print_exit_error__ p prev i ,(c)
  __String_toCode__ __print_exit_error__ c)

;; ── 並べる ──

;; String の LList を文字コード順に並べる（マージソート）
(define Glob_sort ,(list)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __if__ (,() __is_null__ rest) (,() return list) ,()
  Glob_halves list __NULL__ __NULL__ ,(a b)
  Glob_sort a ,(a)
  Glob_sort b ,(b)
  Glob_merge a b)

(define Glob_halves ,(list a b)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return a b) ,()
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __LList_cons__ head a ,(a)
  Glob_halves rest b a)

(define Glob_merge ,(a b)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ a) (,() return b) ,()
  __if__ (,() __is_null__ b) (,() return a) ,()
  __LList_uncons__ __print_exit_error__ a ,(x as)
  __LList_uncons__ __print_exit_error__ b ,(y bs)
  String_less y x ,(yFirst)
  __if__ yFirst
    (,()
      Glob_merge a bs ,(rest)
      __LList_cons__ y rest ,(list)
      return list) ,()
  Glob_merge as b ,(rest)
  __LList_cons__ x rest)

;; a が文字コード順で b より前か
(define String_less ,(a b)
  __String_length__ a ,(alen)
  __String_length__ b ,(blen)
  num "0" ,(zero)
  String_less_from a b zero alen blen)

(define String_less_from ,(a b i alen blen)
  __Cont_get__ ,(return)
  __Number_subtract__ blen i ,(bleft)
  __if__ (,() __Number_is_zero__ bleft) (,() return __FALSE__) ,()
  __Number_subtract__ alen i ,(aleft)
  __if__ (,() __Number_is_zero__ aleft) (,() return __TRUE__) ,()
  num "1" ,(one)
  __Number_add__ i one ,(next)
  __String_substring__ __print_exit_error__ a i next ,(ca)
  __String_substring__ __print_exit_error__ b i next ,(cb)
  __String_toCode__ __print_exit_error__ ca ,(x)
  __String_toCode__ __print_exit_error__ cb ,(y)
  __Number_subtract__ x y ,(d)
  __if__ (,() __Number_is_negative__ d) (,() return __TRUE__) ,()
  __if__ (,() __Number_is_positive__ d) (,() return __FALSE__) ,()
  String_less_from a b next alen blen)
