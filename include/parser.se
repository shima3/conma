;; parser: Token の Seq から1つの Program を作る（PARSER.md, AST.md, SELFHOST.md）
;;
;; __Parser_main__ onError fileName tokens ,(Program)
;;   tokens は comment_remover が返す Token の Seq。
;;   fileName が null でなければ、bin/parser --file fileName と同じく、
;;   Program の位置にその名前を入れ、SInfo のない Body に SInfo を入れる。
;;   null なら、FILE Token の値を Program の位置に入れ、SInfo は入れない。
;;   構文エラーでは、__Parser_main__ を呼んだときの CChain に戻して onError にメッセージを渡す。
;;   onError が値を返せば、それが __Parser_main__ の値になる。
;;
;; Token を LList に集めてから、再帰下降で解析する。
;; 解析する関数は、作ったノードと残りの Token の LList を返す。
;; 式を解析する関数は、さらに最後に読んだ Token も返す（値のない LCont の位置に使う）
(include "token.se")
(include "ast.se")

(define __Parser_main__ ,(onError fileName tokens)
  __CChain_get__ ,(cc)
  __Parser_collect__ tokens ,(toks)
  __Parser_program__ (,(msg) __CChain_set__ cc ,() onError msg) fileName toks)

;; ── Token の LList ──

(define __Parser_collect__ ,(tokens)
  __Parser_cons_sink__ __NULL__ ,(sink)
  tokens sink ,(sink)
  sink __NULL__ ,(reversed)
  __Parser_reverse__ reversed __NULL__)

;; Token を list の前に加える Sink。null を渡すと list を返す
(define __Parser_cons_sink__ ,(list)
  __NULL__ (,(token)
    __if_then_else__ (,() __is_null__ token)
      (,() __NULL__ list)
      (,()
        __LList_cons__ token list ,(list)
        __Parser_cons_sink__ list)))

(define __Parser_reverse__ ,(list acc)
  __if_then_else__ (,() __is_null__ list)
    (,() __NULL__ acc)
    (,()
      __LList_uncons__ __print_exit_error__ list ,(head rest)
      __LList_cons__ head acc ,(acc)
      __Parser_reverse__ rest acc))

;; toks の先頭の Token の kind。toks が空なら null
(define __Parser_peek_kind__ ,(toks)
  __if_then_else__ (,() __is_null__ toks)
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(tok rest)
      __Token_get_kind__ tok))

;; toks の先頭の kind が kind なら __TRUE__
(define __Parser_next_is__ ,(toks kind)
  __Parser_peek_kind__ toks ,(k)
  __if_then_else__ (,() __is_null__ k)
    (,() __NULL__ __FALSE__)
    (,() __String_equal__ k kind))

;; 先頭の Token が kind（value が null でなければ、その値も）であることを確かめて読む
(define __Parser_expect__ ,(fail toks kind value)
  __Parser_repr__ kind ,(kindRepr)
  __if_then_else__ (,() __is_null__ toks)
    (,()
      __String_concat__ "Unexpected end of input; expected " kindRepr ,(msg)
      fail msg)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(tok rest)
      __Token_get_kind__ tok ,(k)
      __Token_get_value__ tok ,(v)
      __Parser_where__ tok ,(where)
      __if_then_else__ (,() __String_equal__ k kind)
        (,()
          __if_then_else__ (,() __is_null__ value)
            (,() __NULL__ tok rest)
            (,()
              __if_then_else__ (,() __String_equal__ v value)
                (,() __NULL__ tok rest)
                (,()
                  __Parser_repr__ value ,(valueRepr)
                  __Parser_repr__ v ,(vRepr)
                  __Parser_concat__ where "expected " valueRepr ", got " vRepr ,(msg)
                  fail msg)))
        (,()
          __Parser_repr__ k ,(kRepr)
          __Parser_repr__ v ,(vRepr)
          __Parser_concat__ where "expected " kindRepr ", got " kRepr ,(msg)
          __Parser_concat__ msg " " vRepr "" "" ,(msg)
          fail msg)))

;; "line:col: "
(define __Parser_where__ ,(tok)
  __Token_get_line__ tok ,(line)
  __Token_get_col__ tok ,(col)
  __Number_toString__ line ,(line)
  __Number_toString__ col ,(col)
  __Parser_concat__ line ":" col ": " "")

(define __Parser_concat__ ,(a b c d e)
  __String_concat__ a b ,(s)
  __String_concat__ s c ,(s)
  __String_concat__ s d ,(s)
  __String_concat__ s e)

;; ── ノード ──

;; tok の位置に kind のノードを作る
(define __Parser_node__ ,(kind tok children)
  __Token_get_line__ tok ,(line)
  __Token_get_col__ tok ,(col)
  __Parser_node_at__ kind line col children)

(define __Parser_node_at__ ,(kind line col children)
  __LList_cons__ col __NULL__ ,(pos)
  __LList_cons__ line pos ,(pos)
  __AST_new__ kind pos children)

(define __Parser_list1__ ,(a)
  __LList_cons__ a __NULL__)

(define __Parser_list2__ ,(a b)
  __LList_cons__ b __NULL__ ,(list)
  __LList_cons__ a list)

;; SYMBOL の Token から Variable ノードを作る
(define __Parser_variable__ ,(tok)
  __Token_get_value__ tok ,(name)
  __Parser_list1__ name ,(children)
  __Parser_node__ "Variable" tok children)

;; STRING の Token から String ノードを作る。値は両端の " を除いたソースの文字列
(define __Parser_string__ ,(tok)
  __Token_get_value__ tok ,(value)
  __Parser_unquote__ value ,(value)
  __Parser_list1__ value ,(children)
  __Parser_node__ "String" tok children)

(define __Parser_unquote__ ,(value)
  __String_length__ value ,(len)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ len one ,(end)
  __String_substring__ __print_exit_error__ value one end)

;; ── 文法 ──

;; Program = { Statement }
(define __Parser_program__ ,(fail fileName toks)
  __Parser_next_is__ toks "FILE" ,(hasFile)
  __if_then_else__ (,() __NULL__ hasFile)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(fileTok rest)
      __Token_get_value__ fileTok ,(fileValue)
      __NULL__ fileValue rest)
    (,() __NULL__ __NULL__ toks) ,(fileValue toks)
  __if_then_else__ (,() __is_null__ fileName)
    (,() __NULL__ fileValue)
    (,() __NULL__ fileName) ,(name)
  __if_then_else__ (,() __is_null__ toks)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __NULL__ one one)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(first rest)
      __Token_get_line__ first ,(line)
      __Token_get_col__ first ,(col)
      __NULL__ line col) ,(line col)
  __if_then_else__ (,() __is_null__ name)
    (,() __NULL__ __NULL__)
    (,() __Parser_list1__ name) ,(pos)
  __LList_cons__ col pos ,(pos)
  __LList_cons__ line pos ,(pos)
  __Parser_statements__ fail fileName toks __NULL__ ,(children)
  __AST_new__ "Program" pos children)

;; Token がなくなるまで Statement を読み、ノードの LList を返す
(define __Parser_statements__ ,(fail fileName toks acc)
  __if_then_else__ (,() __is_null__ toks)
    (,() __Parser_reverse__ acc __NULL__)
    (,()
      __Parser_statement__ fail fileName toks ,(node toks)
      __LList_cons__ node acc ,(acc)
      __Parser_statements__ fail fileName toks acc))

;; Statement = Includer | Definition
(define __Parser_statement__ ,(fail fileName toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __Parser_where__ tok ,(where)
  __Token_get_kind__ tok ,(kind)
  __if_then_else__ (,() __String_equal__ kind "LPAREN")
    __nop__
    (,()
      __String_concat__ where "expected '(' to start a statement" ,(msg)
      fail msg) ,()
  __Parser_next_is__ rest "SYMBOL" ,(isSymbol)
  __if_then_else__ (,() __NULL__ isSymbol)
    __nop__
    (,()
      __String_concat__ where "expected 'include' or 'define' after '('" ,(msg)
      fail msg) ,()
  __LList_uncons__ __print_exit_error__ rest ,(kw rest2)
  __Token_get_value__ kw ,(keyword)
  __if_then_else__ (,() __String_equal__ keyword "include")
    (,() __Parser_includer__ fail toks) (,()
  __if_then_else__ (,() __String_equal__ keyword "define")
    (,() __Parser_definition__ fail fileName toks)
    (,()
      __Parser_where__ kw ,(where)
      __Parser_repr__ keyword ,(keywordRepr)
      __Parser_concat__ where "expected 'include' or 'define', got " keywordRepr "" "" ,(msg)
      fail msg)))

;; Includer = "(", "include", String, ")"
(define __Parser_includer__ ,(fail toks)
  __Parser_expect__ fail toks "LPAREN" __NULL__ ,(lparen toks)
  __Parser_expect__ fail toks "SYMBOL" "include" ,(kw toks)
  __Parser_expect__ fail toks "STRING" __NULL__ ,(stok toks)
  __Parser_expect__ fail toks "RPAREN" __NULL__ ,(rparen toks)
  __Parser_string__ stok ,(str)
  __Parser_list1__ str ,(children)
  __Parser_node__ "Includer" lparen children ,(node)
  __NULL__ node toks)

;; Definition = "(", "define", Variable, Function, ")"。位置は define の位置
(define __Parser_definition__ ,(fail fileName toks)
  __Parser_expect__ fail toks "LPAREN" __NULL__ ,(lparen toks)
  __Parser_expect__ fail toks "SYMBOL" "define" ,(define toks)
  __Parser_expect__ fail toks "SYMBOL" __NULL__ ,(vtok toks)
  __Parser_function__ fail fileName toks ,(func toks)
  __Parser_expect__ fail toks "RPAREN" __NULL__ ,(rparen toks)
  __Parser_variable__ vtok ,(var)
  __Parser_list2__ var func ,(children)
  __Parser_node__ "Definition" define children ,(node)
  __NULL__ node toks)

;; Function = ",", Head, Body
(define __Parser_function__ ,(fail fileName toks)
  __Parser_expect__ fail toks "COMMA" __NULL__ ,(comma toks)
  __Parser_head__ fail toks ,(head toks)
  __Parser_body__ fail fileName toks ,(body toks)
  __Parser_list2__ head body ,(children)
  __Parser_node__ "Function" comma children ,(node)
  __NULL__ node toks)

;; Head = "(", { Variable }, ")"
(define __Parser_head__ ,(fail toks)
  __Parser_expect__ fail toks "LPAREN" __NULL__ ,(lparen toks)
  __Parser_params__ fail toks __NULL__ ,(params toks)
  __Parser_expect__ fail toks "RPAREN" __NULL__ ,(rparen toks)
  __Parser_node__ "Head" lparen params ,(node)
  __NULL__ node toks)

;; ")" か Token の終わりまで、パラメータの Variable を読む
(define __Parser_params__ ,(fail toks acc)
  __Parser_peek_kind__ toks ,(kind)
  __if_then_else__ (,() __is_null__ kind)
    (,() __NULL__ __TRUE__)
    (,() __String_equal__ kind "RPAREN") ,(atEnd)
  __if_then_else__ (,() __NULL__ atEnd)
    (,()
      __Parser_reverse__ acc __NULL__ ,(params)
      __NULL__ params toks)
    (,()
      __Parser_expect__ fail toks "SYMBOL" __NULL__ ,(vtok toks)
      __Parser_variable__ vtok ,(var)
      __LList_cons__ var acc ,(acc)
      __Parser_params__ fail toks acc))

;; 式を始められる Token（SYMBOL、STRING、LPAREN）なら __TRUE__
(define __Parser_expression_start__ ,(toks)
  __Parser_peek_kind__ toks ,(kind)
  __if_then_else__ (,() __is_null__ kind)
    (,() __NULL__ __FALSE__)
    (,()
      __String_equal__ kind "SYMBOL" ,(isSymbol)
      __String_equal__ kind "STRING" ,(isString)
      __String_equal__ kind "LPAREN" ,(isLparen)
      __or__ isSymbol isString ,(b)
      __or__ b isLparen))

;; 先頭の Token の位置。Token がなければ dLine dCol
(define __Parser_next_pos__ ,(toks dLine dCol)
  __if_then_else__ (,() __is_null__ toks)
    (,() __NULL__ dLine dCol)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(tok rest)
      __Token_get_line__ tok ,(line)
      __Token_get_col__ tok ,(col)
      __NULL__ line col))

;; Body = [SInfo], [Operator, OList], [LCont]
;; Operator と OList がなければ (Operator pos (Null pos)) と (OList pos) にする
(define __Parser_body__ ,(fail fileName toks)
  __Parser_sinfo_start__ toks ,(hasSInfo)
  __if_then_else__ (,() __NULL__ hasSInfo)
    (,() __Parser_sinfo__ fail toks)
    (,() __NULL__ __NULL__ toks) ,(sinfo toks)
  __Parser_expression_start__ toks ,(hasOperator)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __if_then_else__ (,() __NULL__ hasOperator)
    (,()
      __Parser_operator__ fail fileName toks ,(inner toks last)
      __AST_get_pos__ inner ,(pos)
      __LList_uncons__ __print_exit_error__ pos ,(opLine rest)
      __LList_uncons__ __print_exit_error__ rest ,(opCol rest)
      __NULL__ inner opLine opCol toks)
    (,()
      __Parser_next_pos__ toks one one ,(opLine opCol)
      __Parser_node_at__ "Null" opLine opCol __NULL__ ,(inner)
      __NULL__ inner opLine opCol toks) ,(inner opLine opCol toks)
  __Parser_list1__ inner ,(children)
  __Parser_node_at__ "Operator" opLine opCol children ,(operator)
  __if_then_else__ (,() __is_null__ sinfo)
    (,() __Parser_auto_sinfo__ fileName opLine opCol)
    (,() __NULL__ sinfo) ,(sinfo)
  __if_then_else__ (,() __NULL__ hasOperator)
    (,() __Parser_olist__ fail fileName toks __NULL__ __NULL__)
    (,() __NULL__ __NULL__ __NULL__ toks) ,(items last toks)
  __if_then_else__ (,() __is_null__ items)
    (,() __Parser_next_pos__ toks opLine opCol)
    (,()
      __LList_uncons__ __print_exit_error__ items ,(first rest)
      __AST_get_pos__ first ,(pos)
      __LList_uncons__ __print_exit_error__ pos ,(line rest)
      __LList_uncons__ __print_exit_error__ rest ,(col rest)
      __NULL__ line col) ,(olLine olCol)
  __Parser_node_at__ "OList" olLine olCol items ,(olist)
  __Parser_lcont__ fail fileName toks last olLine olCol ,(lcont toks)
  __Parser_list2__ olist lcont ,(children)
  __LList_cons__ operator children ,(children)
  __if_then_else__ (,() __is_null__ sinfo)
    (,() __NULL__ children)
    (,() __LList_cons__ sinfo children) ,(children)
  __if_then_else__ (,() __NULL__ hasSInfo)
    (,() __AST_get_pos__ sinfo)
    (,()
      __LList_cons__ opCol __NULL__ ,(pos)
      __LList_cons__ opLine pos) ,(pos)
  __AST_new__ "Body" pos children ,(node)
  __NULL__ node toks)

;; fileName があれば、Operator の位置の SInfo を作る。なければ null
(define __Parser_auto_sinfo__ ,(fileName line col)
  __if_then_else__ (,() __is_null__ fileName)
    (,() __NULL__ __NULL__)
    (,()
      __Number_toString__ line ,(lineStr)
      __Number_toString__ col ,(colStr)
      __Parser_list2__ lineStr colStr ,(children)
      __LList_cons__ fileName children ,(children)
      __Parser_node_at__ "SInfo" line col children))

;; 次が "(" "__SInfo__" なら __TRUE__
(define __Parser_sinfo_start__ ,(toks)
  __Parser_next_is__ toks "LPAREN" ,(isLparen)
  __if_then_else__ (,() __NULL__ isLparen)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(tok rest)
      __Parser_next_is__ rest "SYMBOL" ,(isSymbol)
      __if_then_else__ (,() __NULL__ isSymbol)
        (,()
          __LList_uncons__ __print_exit_error__ rest ,(kw rest)
          __Token_get_value__ kw ,(value)
          __String_equal__ value "__SInfo__")
        (,() __NULL__ __FALSE__))
    (,() __NULL__ __FALSE__))

;; SInfo = "(", "__SInfo__", { String }, ")"
(define __Parser_sinfo__ ,(fail toks)
  __Parser_expect__ fail toks "LPAREN" __NULL__ ,(lparen toks)
  __Parser_expect__ fail toks "SYMBOL" "__SInfo__" ,(kw toks)
  __Parser_sinfo_strings__ toks __NULL__ ,(strings toks)
  __Parser_expect__ fail toks "RPAREN" __NULL__ ,(rparen toks)
  __Parser_node__ "SInfo" lparen strings ,(node)
  __NULL__ node toks)

(define __Parser_sinfo_strings__ ,(toks acc)
  __Parser_next_is__ toks "STRING" ,(isString)
  __if_then_else__ (,() __NULL__ isString)
    (,()
      __LList_uncons__ __print_exit_error__ toks ,(tok toks)
      __Token_get_value__ tok ,(value)
      __Parser_unquote__ value ,(value)
      __LList_cons__ value acc ,(acc)
      __Parser_sinfo_strings__ toks acc)
    (,()
      __Parser_reverse__ acc __NULL__ ,(strings)
      __NULL__ strings toks))

;; Operator = Variable | FuncExp。ノード、残りの Token、最後に読んだ Token を返す
(define __Parser_operator__ ,(fail fileName toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __Token_get_kind__ tok ,(kind)
  __if_then_else__ (,() __String_equal__ kind "SYMBOL")
    (,()
      __Parser_variable__ tok ,(var)
      __NULL__ var rest tok) (,()
  __if_then_else__ (,() __String_equal__ kind "LPAREN")
    (,() __Parser_funcexp__ fail fileName toks)
    (,()
      __Parser_where__ tok ,(where)
      __Token_get_value__ tok ,(value)
      __Parser_repr__ kind ,(kindRepr)
      __Parser_repr__ value ,(valueRepr)
      __Parser_concat__ where "expected Operator, got " kindRepr " " valueRepr ,(msg)
      fail msg)))

;; Expression = Variable | String | FuncExp
(define __Parser_expression__ ,(fail fileName toks)
  __LList_uncons__ __print_exit_error__ toks ,(tok rest)
  __Token_get_kind__ tok ,(kind)
  __if_then_else__ (,() __String_equal__ kind "STRING")
    (,()
      __Parser_string__ tok ,(str)
      __NULL__ str rest tok)
    (,() __Parser_operator__ fail fileName toks))

;; 式が続く限り OList の要素を読む。要素の LList、最後に読んだ Token、残りの Token を返す
(define __Parser_olist__ ,(fail fileName toks acc last)
  __Parser_expression_start__ toks ,(more)
  __if_then_else__ (,() __NULL__ more)
    (,()
      __Parser_expression__ fail fileName toks ,(expr toks last)
      __LList_cons__ expr acc ,(acc)
      __Parser_olist__ fail fileName toks acc last)
    (,()
      __Parser_reverse__ acc __NULL__ ,(items)
      __NULL__ items last toks))

;; LCont = Function。なければ子のない LCont を、最後に読んだ Token の直後の位置に作る
(define __Parser_lcont__ ,(fail fileName toks last olLine olCol)
  __Parser_next_is__ toks "COMMA" ,(isComma)
  __if_then_else__ (,() __NULL__ isComma)
    (,()
      __Parser_function__ fail fileName toks ,(func toks)
      __AST_get_pos__ func ,(pos)
      __Parser_list1__ func ,(children)
      __AST_new__ "LCont" pos children ,(node)
      __NULL__ node toks)
    (,()
      __if_then_else__ (,() __is_null__ last)
        (,() __Parser_next_pos__ toks olLine olCol)
        (,()
          __Token_get_line__ last ,(line)
          __Token_get_col__ last ,(col)
          __Token_get_value__ last ,(value)
          __String_length__ value ,(len)
          __Number_add__ col len ,(col)
          __NULL__ line col) ,(line col)
      __Parser_node_at__ "LCont" line col __NULL__ ,(node)
      __NULL__ node toks))

;; FuncExp = "(", Function, ")"。最後に読んだ Token は ")"
(define __Parser_funcexp__ ,(fail fileName toks)
  __Parser_expect__ fail toks "LPAREN" __NULL__ ,(lparen toks)
  __Parser_function__ fail fileName toks ,(func toks)
  __Parser_expect__ fail toks "RPAREN" __NULL__ ,(rparen toks)
  __Parser_list1__ func ,(children)
  __Parser_node__ "FuncExp" lparen children ,(node)
  __NULL__ node toks rparen)

;; ── エラーメッセージ ──

;; Python の repr と同じく、str を引用符で囲む。
;; ' を含み " を含まなければ "..."、それ以外は '...'。\ と囲む引用符、改行、タブ、復帰はエスケープする
(define __Parser_repr__ ,(str)
  __Parser_contains__ str "'" ,(hasSingle)
  __Parser_contains__ str "\"" ,(hasDouble)
  __not__ hasDouble ,(noDouble)
  __if_then_else__ (,() __and__ hasSingle noDouble)
    (,() __NULL__ "\"")
    (,() __NULL__ "'") ,(quote)
  __String_length__ str ,(len)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Parser_repr_loop__ str len zero quote quote ,(s)
  __String_concat__ s quote)

(define __Parser_repr_loop__ ,(str len i quote acc)
  __Number_subtract__ len i ,(rest)
  __if_then_else__ (,() __Number_is_zero__ rest)
    (,() __NULL__ acc)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __String_substring__ __print_exit_error__ str i next ,(ch)
      __Parser_repr_char__ ch quote ,(ch)
      __String_concat__ acc ch ,(acc)
      __Parser_repr_loop__ str len next quote acc))

;; repr の中の1文字
(define __Parser_repr_char__ ,(ch quote)
  __if_then_else__ (,() __String_equal__ ch "\\") (,() __NULL__ "\\\\") (,()
  __if_then_else__ (,() __String_equal__ ch quote) (,() __String_concat__ "\\" ch) (,()
  __if_then_else__ (,() __String_equal__ ch "\n") (,() __NULL__ "\\n") (,()
  __if_then_else__ (,() __String_equal__ ch "\t") (,() __NULL__ "\\t") (,()
  __if_then_else__ (,() __String_equal__ ch "\r") (,() __NULL__ "\\r") (,()
  __NULL__ ch))))))

;; str が ch（1文字）を含めば __TRUE__
(define __Parser_contains__ ,(str ch)
  __String_length__ str ,(len)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Parser_contains_loop__ str len zero ch)

(define __Parser_contains_loop__ ,(str len i ch)
  __Number_subtract__ len i ,(rest)
  __if_then_else__ (,() __Number_is_zero__ rest)
    (,() __NULL__ __FALSE__)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __String_substring__ __print_exit_error__ str i next ,(c)
      __if_then_else__ (,() __String_equal__ c ch)
        (,() __NULL__ __TRUE__)
        (,() __Parser_contains_loop__ str len next ch)))
