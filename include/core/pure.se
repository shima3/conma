;; コア ConMa の pure.se：コア ConMa のモジュールは include/core、include の順に探して作るので、include/pure.se の
;; 代わりにこのファイルが使われる。コア ConMa と拡張 ConMa で共通の定義は include/pure.se にある。
;; 拡張 ConMa では __TRUE__ と __FALSE__ は組み込みである（include/ext/pure.se。フロントエンドが
;; (Uses "boolean") を書く）。コア ConMa では、ここで定義する。
;; 制御の関数（__if_then_else__ など）も、拡張 ConMa では組み込みで、コア ConMa では control.se で定義する
(include "../pure.se")
(include "control.se")

;; Boolean：選んだ値を、適用せずに返す
(define __TRUE__ ,(then else)
  __NULL__ then)

(define __FALSE__ ,(then else)
  __NULL__ else)
