(define __nop__ ,())

;; コア ConMa と拡張 ConMa で共通の定義。__TRUE__ と __FALSE__ は、コア ConMa では include/core/pure.se で定義し、拡張 ConMa では
;; 組み込みである（include/ext/pure.se）。このファイルを直接 include せず、"pure.se" として include する

(define __and__ ,(Boolean1 Boolean2)
  Boolean1 Boolean2 __FALSE__)

(define __or__ ,(Boolean1 Boolean2)
  Boolean1 __TRUE__ Boolean2)

(define __not__ ,(Boolean)
  Boolean __FALSE__ __TRUE__)

;; __if_then_else__、__if__、__unless__ は拡張 ConMa の組み込み（PRIMITIVES.md）。コア ConMa の定義は include/core/control.se にある

(define __fix__ ,(x)
  x (,() __fix__ x))

(define __LList_is_empty__ ,(list)
  __is_null__ list)
