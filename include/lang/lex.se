;; 言語キットの字句解析の部品（docs/dev/PLATFORM-PLAN-ja.md の 4.3 節、段階 P4）。SJS の字句解析（sjs/include/sjs_lex.se）から
;; 取り出した。どの言語の字句解析からも使える：文字の LList を読む関数、行と桁、空白とコメント、数、文字列と逃がし、名前、
;; いちばん長い記号。言語に固有のもの（キーワード、テンプレート文字列など）は、それぞれの言語が持つ。
;;
;; 字句は LList (種類 テキスト 改行 行 桁 [raw]) で、改行は、前に改行があったか（真偽値）、行と桁は、字句の始まりの行と桁の
;; 番号（String。1 から）。raw は言語が使う 6 番目の値（SJS のテンプレートの部分の、逃がしを解かない中身）。
;; 桁を求めるには、字句を読み始める前に、文字の数を PDict の "kit_lex_n" に、Kit_lex_line_starts で作る行の始まりの表を
;; "kit_lex_starts" に置く（Kit_lex_start が両方を置く）。
;; エラー（閉じていない文字列とコメント、悪い逃がし）は Kit_lex_error で、PDict の "kit_error" の関数（名前 メッセージ）が
;; あればそれを呼び（SJS は SyntaxError を投げる）、なければ「メッセージ」を標準エラーに出して終了ステータス 2 で終える。
;; 名前に使える文字は、英字、数字（2 文字目から）、_ と、言語が引数 extra で渡す文字（SJS は "$"）

;; text を読み始める：文字の LList を返し、桁を求めるための "kit_lex_n" と "kit_lex_starts" を置く
(define Kit_lex_start ,(text)
  Kit_lex_chars text ,(chars)
  __LList_length__ chars ,(n)
  __PDict_put__ "kit_lex_n" n ,()
  __Dict_new__ ,(starts)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  Kit_lex_line_starts text starts one zero ,()
  __PDict_put__ "kit_lex_starts" starts ,()
  __NULL__ chars)

;; 文字列の 1 文字ずつの LList
(define Kit_lex_chars ,(s)
  __String_length__ s ,(len)
  Kit_lex_chars_from s len __NULL__)

(define Kit_lex_chars_from ,(s i acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ i ,(test__) __if__ test__ (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ i one ,(j)
  __String_substring__ __print_exit_error__ s j i ,(c)
  __LList_cons__ c acc ,(acc)
  Kit_lex_chars_from s j acc)

(define Kit_lex_error ,(msg)
  __PDict_lookup_or__ "kit_error" (,(k) __NULL__ __NULL__) ,(handler)
  __is_null__ handler ,(none)
  __unless__ none (,() handler "SyntaxError" msg) ,()
  __String_concat__ msg "\n" ,(line)
  __OS_print_error__ line ,()
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __OS_exit__ __print_exit_error__ two)

(define Kit_lex_cat3 ,(a b c)
  __String_concat__ a b ,(s)
  __String_concat__ s c)

;; 行の番号（String）から、その行の始まりの位置（Number）への Dict を作る
(define Kit_lex_line_starts ,(text starts line at)
  __Cont_get__ ,(return)
  __Number_toString__ line ,(ls)
  __Dict_put__ starts ls at ,()
  __String_find__ __print_exit_error__ text "\n" at ,(nl)
  __is_null__ nl ,(test__) __if__ test__ return ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ nl one ,(next)
  __Number_add__ line one ,(line)
  Kit_lex_line_starts text starts line next)

;; 残りの文字 chars で始まる字句の、行 line の中の桁（String。1 から）
(define Kit_lex_col ,(chars line)
  __PDict_lookup_or__ "kit_lex_n" __print_exit_error__ ,(n)
  __PDict_lookup_or__ "kit_lex_starts" __print_exit_error__ ,(starts)
  __LList_length__ chars ,(left)
  __Number_subtract__ n left ,(at)
  __Number_toString__ line ,(ls)
  __Dict_lookup_or__ starts ls (,(k) __Number_fromString__ __print_exit_error__ "0") ,(start)
  __Number_subtract__ at start ,(c)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ c one ,(c)
  __Number_toString__ c)

(define Kit_lex_tok ,(kind text nl line col)
  __Number_toString__ line ,(ls)
  __LList_cons__ col __NULL__ ,(l)
  __LList_cons__ ls l ,(l)
  __LList_cons__ nl l ,(l)
  __LList_cons__ text l ,(l)
  __LList_cons__ kind l)

(define Kit_lex_tok_raw ,(tok)
  __Cont_get__ ,(return)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(text rest)
  __LList_uncons__ __print_exit_error__ rest ,(nl rest)
  __LList_uncons__ __print_exit_error__ rest ,(line rest)
  __LList_uncons__ __print_exit_error__ rest ,(col rest)
  __is_null__ rest ,(test__) __if__ test__ (,() return text) ,()
  __LList_uncons__ __print_exit_error__ rest ,(raw rest)
  __NULL__ raw)

(define Kit_lex_tok_kind ,(tok)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __NULL__ kind)

(define Kit_lex_tok_text ,(tok)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(text rest)
  __NULL__ text)

(define Kit_lex_tok_nl ,(tok)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(text rest)
  __LList_uncons__ __print_exit_error__ rest ,(nl rest)
  __NULL__ nl)

(define Kit_lex_tok_line ,(tok)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(text rest)
  __LList_uncons__ __print_exit_error__ rest ,(nl rest)
  __LList_uncons__ __print_exit_error__ rest ,(line rest)
  __NULL__ line)

(define Kit_lex_tok_col ,(tok)
  __LList_uncons__ __print_exit_error__ tok ,(kind rest)
  __LList_uncons__ __print_exit_error__ rest ,(text rest)
  __LList_uncons__ __print_exit_error__ rest ,(nl rest)
  __LList_uncons__ __print_exit_error__ rest ,(line rest)
  __LList_uncons__ __print_exit_error__ rest ,(col rest)
  __NULL__ col)

(define Kit_lex_reverse ,(list)
  Kit_lex_reverse_onto list __NULL__)

(define Kit_lex_reverse_onto ,(list acc)
  __Cont_get__ ,(return)
  __is_null__ list ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  __LList_cons__ head acc ,(acc)
  Kit_lex_reverse_onto tail acc)

;; 文字の LList の最初（なければ ""）と残り
(define Kit_lex_peek ,(chars)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return "") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __NULL__ c)

(define Kit_lex_rest ,(chars)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __NULL__ rest)

(define Kit_lex_in ,(c set)
  __Cont_get__ ,(return)
  __String_equal__ c "" ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ set c zero ,(at)
  __is_null__ at ,(none)
  __not__ none)

(define Kit_lex_code ,(c)
  __Cont_get__ ,(return)
  __String_equal__ c "" ,(test__) __if__ test__ (,() __Number_fromString__ __print_exit_error__ "-1" ,(m) return m) ,()
  __String_toCode__ __print_exit_error__ c)

;; 文字の番号 c が lo 以上 hi 以下か
(define Kit_lex_code_in ,(c lo hi)
  __Number_fromString__ __print_exit_error__ lo ,(l)
  __Number_fromString__ __print_exit_error__ hi ,(h)
  __Number_subtract__ c l ,(a)
  __Number_subtract__ h c ,(b)
  __Number_is_negative__ a ,(below)
  __Number_is_negative__ b ,(above)
  __or__ below above ,(out)
  __not__ out)

(define Kit_lex_is_digit ,(c)
  Kit_lex_code c ,(n)
  Kit_lex_code_in n "48" "57")

(define Kit_lex_is_ident_start ,(c extra)
  __Cont_get__ ,(return)
  Kit_lex_code c ,(n)
  Kit_lex_code_in n "65" "90" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Kit_lex_code_in n "97" "122" ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Kit_lex_in c extra)

(define Kit_lex_is_ident_char ,(c extra)
  __Cont_get__ ,(return)
  Kit_lex_is_ident_start c extra ,(test__) __if__ test__ (,() return __TRUE__) ,()
  Kit_lex_is_digit c)

(define Kit_lex_skip_line ,(chars)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() return chars) ,()
  Kit_lex_skip_line rest)

;; /* の後から */ の後まで。中に改行があれば nl を真にする。lines は中の改行の数
(define Kit_lex_skip_block ,(chars nl lines)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() Kit_lex_error "unterminated comment") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Kit_lex_peek rest ,(d)
  __String_equal__ c "*" ,(star)
  __String_equal__ d "/" ,(slash)
  __and__ star slash ,(test__) __if__ test__ (,() Kit_lex_rest rest ,(rest) return rest nl lines) ,()
  __String_equal__ c "\n" ,(newline)
  __or__ nl newline ,(nl)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __if_then_else__ newline (,() __Number_add__ lines one) (,() __NULL__ lines) ,(lines)
  Kit_lex_skip_block rest nl lines)

;; 数：数字、小数点、指数（e、E、その後の + か -）
(define Kit_lex_number ,(chars acc extra)
  __Cont_get__ ,(return)
  Kit_lex_peek chars ,(c)
  Kit_lex_is_ident_char c extra ,(word)
  __String_equal__ c "." ,(dot)
  __or__ word dot ,(take)
  __unless__ take (,() return acc chars) ,()
  __String_concat__ acc c ,(acc)
  Kit_lex_rest chars ,(rest)
  Kit_lex_in c "eE" ,(exp)
  Kit_lex_peek rest ,(d)
  Kit_lex_in d "+-" ,(sign)
  __and__ exp sign ,(test__) __if__ test__
    (,() __String_concat__ acc d ,(acc) Kit_lex_rest rest ,(rest) Kit_lex_number rest acc extra ,(t r) return t r) ,()
  Kit_lex_number rest acc extra)

;; 引用符 quote の後から、閉じる引用符の後まで。中身（逃がしを解いたもの）と残り
(define Kit_lex_string ,(chars quote acc)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() Kit_lex_error "unterminated string") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c quote ,(test__) __if__ test__ (,() return acc rest) ,()
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() Kit_lex_error "unterminated string") ,()
  __String_equal__ c "\\" ,(test__) __if__ test__
    (,()
      __is_null__ rest ,(test__) __if__ test__ (,() Kit_lex_error "unterminated string") ,()
      __LList_uncons__ __print_exit_error__ rest ,(e rest)
      Kit_lex_escape e rest ,(s rest)
      __String_concat__ acc s ,(acc)
      Kit_lex_string rest quote acc ,(t r)
      return t r) ,()
  __String_concat__ acc c ,(acc)
  Kit_lex_string rest quote acc)

;; \ の後の文字 e の意味と、残り（\u は 4 桁の 16 進）
(define Kit_lex_escape ,(e rest)
  __Cont_get__ ,(return)
  __String_equal__ e "n" ,(test__) __if__ test__ (,() return "\n" rest) ,()
  __String_equal__ e "t" ,(test__) __if__ test__ (,() return "\t" rest) ,()
  __String_equal__ e "r" ,(test__) __if__ test__ (,() return "\r" rest) ,()
  __String_equal__ e "0" ,(test__) __if__ test__
    (,() __Number_fromString__ __print_exit_error__ "0" ,(z) __String_fromCode__ __print_exit_error__ z ,(s) return s rest) ,()
  __String_equal__ e "b" ,(test__) __if__ test__ (,() Kit_lex_char_code "8" ,(s) return s rest) ,()
  __String_equal__ e "f" ,(test__) __if__ test__ (,() Kit_lex_char_code "12" ,(s) return s rest) ,()
  __String_equal__ e "v" ,(test__) __if__ test__ (,() Kit_lex_char_code "11" ,(s) return s rest) ,()
  __String_equal__ e "x" ,(test__) __if__ test__
    (,() Kit_lex_hex_digits rest "2" ,(code rest) __String_fromCode__ __print_exit_error__ code ,(s) return s rest) ,()
  Kit_lex_peek rest ,(brace)
  __String_equal__ e "u" ,(isU)
  __String_equal__ brace "{" ,(isBrace)
  __and__ isU isBrace ,(test__) __if__ test__
    (,()
      Kit_lex_rest rest ,(rest)
      __Number_fromString__ __print_exit_error__ "0" ,(zero)
      Kit_lex_hex_braced rest zero __FALSE__ ,(code rest)
      __String_fromCode__ (,(msg) Kit_lex_error "a bad \\u{} escape") code ,(s)
      return s rest) ,()
  __String_equal__ e "u" ,(test__) __if__ test__
    (,()
      Kit_lex_hex4 rest ,(code rest)
      __String_fromCode__ (,(msg) Kit_lex_error "a \\u escape of a surrogate") code ,(s)
      return s rest) ,()
  __String_equal__ e "\n" ,(test__) __if__ test__ (,() return "" rest) ,()
  __NULL__ e rest)

;; \u{ の後から } まで（} も読む）の 16 進の数字の値。any は、数字があったか（\u{} はエラー）
(define Kit_lex_hex_braced ,(chars acc any)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__ (,() Kit_lex_error "a bad \\u{} escape") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_equal__ c "}" ,(close)
  __and__ close any ,(test__) __if__ test__ (,() return acc rest) ,()
  __if__ close (,() Kit_lex_error "a bad \\u{} escape") ,()
  __LList_cons__ c __NULL__ ,(one)
  __Number_fromString__ __print_exit_error__ "1" ,(n)
  Kit_lex_hex_loop one n acc ,(acc more)
  Kit_lex_hex_braced rest acc __TRUE__)

(define Kit_lex_char_code ,(n)
  __Number_fromString__ __print_exit_error__ n ,(code)
  __String_fromCode__ __print_exit_error__ code)

(define Kit_lex_hex4 ,(chars)
  Kit_lex_hex_digits chars "4" ,(n rest)
  __NULL__ n rest)

(define Kit_lex_hex_digits ,(chars count)
  __Number_fromString__ __print_exit_error__ count ,(n)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Kit_lex_hex_loop chars n zero)

(define Kit_lex_hex_loop ,(chars n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc chars) ,()
  __is_null__ chars ,(test__) __if__ test__ (,() Kit_lex_error "a bad \\u escape") ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ "0123456789abcdef" c zero ,(lower)
  __String_find__ __print_exit_error__ "0123456789ABCDEF" c zero ,(upper)
  __is_null__ lower ,(noLower)
  __if_then_else__ noLower (,() __NULL__ upper) (,() __NULL__ lower) ,(digit)
  __is_null__ digit ,(test__) __if__ test__ (,() Kit_lex_error "a bad \\u escape") ,()
  __Number_fromString__ __print_exit_error__ "16" ,(sixteen)
  __Number_multiply__ acc sixteen ,(acc)
  __Number_add__ acc digit ,(acc)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  Kit_lex_hex_loop rest n acc)

(define Kit_lex_ident ,(chars acc extra)
  __Cont_get__ ,(return)
  Kit_lex_peek chars ,(c)
  Kit_lex_is_ident_char c extra ,(take)
  __unless__ take (,() return acc chars) ,()
  __String_concat__ acc c ,(acc)
  Kit_lex_rest chars ,(rest)
  Kit_lex_ident rest acc extra)

;; 最初の記号と残り。記号でなければ null。singles は 1 文字の記号の候補（記号の最初の文字）、list は 2 文字以上の
;; 記号の候補（空白で区切る）。list は長いものから並ぶので、先頭の 4、3、2 文字を順に、空白で囲んで
;; 候補の中から __String_find__ で探す（候補を語に分けて 1 つずつ比べるのと同じ結果）
(define Kit_lex_punct ,(chars singles list)
  __Cont_get__ ,(return)
  Kit_lex_peek chars ,(c)
  Kit_lex_in c singles ,(test__) __unless__ test__ (,() return __NULL__ chars) ,()
  Kit_lex_take_chars chars "4" "" ,(s4)
  Kit_lex_cat3 " " list " " ,(list)
  __String_length__ s4 ,(n)
  Kit_lex_punct_prefix list s4 n ,(p)
  __is_null__ p ,(test__) __unless__ test__
    (,() __String_length__ p ,(len) Kit_lex_drop chars len ,(rest) return p rest) ,()
  Kit_lex_rest chars ,(rest)
  __NULL__ c rest)

;; s の先頭の n 文字（n が 1 より大きい間、1 文字ずつ短くする）のうち、空白で囲んだ list の中にある一番長いもの。なければ null
(define Kit_lex_punct_prefix ,(list s n)
  __Cont_get__ ,(return)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(m)
  __Number_is_positive__ m ,(test__) __unless__ test__ (,() return __NULL__) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_substring__ __print_exit_error__ s zero n ,(p)
  Kit_lex_cat3 " " p " " ,(key)
  __String_find__ __print_exit_error__ list key zero ,(at)
  __is_null__ at ,(test__) __unless__ test__ (,() return p) ,()
  Kit_lex_punct_prefix list s m)

(define Kit_lex_starts_with ,(s prefix)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __String_length__ prefix ,(plen)
  __Number_subtract__ len plen ,(d)
  __Number_is_negative__ d ,(test__) __if__ test__ (,() return __FALSE__) ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_substring__ __print_exit_error__ s zero plen ,(head)
  __String_equal__ head prefix)

;; 空白で区切った語の LList（空白を __String_find__ で探す）
(define Kit_lex_words ,(s)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  Kit_lex_words_from s zero __NULL__ ,(rev)
  Kit_lex_reverse rev)

(define Kit_lex_words_from ,(s i acc)
  __Cont_get__ ,(return)
  __String_length__ s ,(len)
  __String_find__ __print_exit_error__ s " " i ,(at)
  __is_null__ at ,(last)
  __if_then_else__ last (,() __NULL__ len) (,() __NULL__ at) ,(end)
  __String_substring__ __print_exit_error__ s i end ,(word)
  __String_equal__ word "" ,(empty)
  __if_then_else__ empty (,() __NULL__ acc) (,() __LList_cons__ word acc) ,(acc)
  __if__ last (,() return acc) ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_add__ at one ,(next)
  Kit_lex_words_from s next acc)

(define Kit_lex_take_chars ,(chars count acc)
  __Number_fromString__ __print_exit_error__ count ,(n)
  Kit_lex_take_n chars n acc)

(define Kit_lex_take_n ,(chars n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __is_null__ chars ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  __String_concat__ acc c ,(acc)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  Kit_lex_take_n rest n acc)

(define Kit_lex_drop ,(chars n)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return chars) ,()
  Kit_lex_rest chars ,(rest)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __Number_subtract__ n one ,(n)
  Kit_lex_drop rest n)

;; word が、空白で区切った語の並び words の 1 つか
;; word が、空白で区切った語の並び words の 1 つか
(define Kit_lex_in_words ,(word words)
  __String_concat__ " " words ,(s)
  __String_concat__ s " " ,(s)
  __String_concat__ " " word ,(w)
  __String_concat__ w " " ,(w)
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __String_find__ __print_exit_error__ s w zero ,(at)
  __is_null__ at ,(none)
  __not__ none)
