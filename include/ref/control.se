;; 制御の関数 __if_then_else__、__if__、__unless__、__Cont_get__ の、簡潔版 ConMa の定義。
;; 簡潔版では、include/ref/pure.se がこのファイルを include するので、どのモジュールもこの定義を使う。
;; 高速版 ConMa では、この 4 つは組み込みである（機能 "control"。フロントエンドが (Uses "control") を書き、
;; bin/concise がこの定義を入れて簡潔版に直す。docs/FAST-PLAN-ja.md の 4.6）。
;; 高速版のプログラムが (include "ref/control.se") とすると、組み込みの代わりにこの定義が使われる
;; （定義のない大域変数だけが組み込みになる。RESOLVER.md, PRIMITIVES.md）。ステップを ConMa の関数として追いたいときや、
;; 組み込みと結果を比べるときに使う。__Cont_get__ の定義が使う __CChain_pop_LCont__ は util.se にある
(include "util.se")

;; Boolean を then と else に適用し、返った節を呼ぶ
(define __if_then_else__ ,(Boolean then else)
  Boolean then else ,(clause)
  clause)

(define __if__ ,(Boolean then)
  __if_then_else__ Boolean then __nop__)

(define __unless__ ,(Boolean else)
  __if_then_else__ Boolean __nop__ else)

;; 呼び出し元に戻る継続 return を LCont に渡す。
;; return は可変長引数の関数で、受け取った引数をそのまま呼び出し元の LCont に渡す。
;; 引数がなければ、引数なしで呼び出し元に戻る。
;; 呼び出し元がない（CChain が空になる）ときは、CChain を空にして VProc を終える
(define __Cont_get__ ,()
  __CChain_pop_LCont__ ,(lc)
  __CChain_get__ ,(cc)
  lc (, args
    __if_then_else__ (,() __is_null__ cc)
      (,() __CChain_set__ cc)
      (,()
        __CChain_set__ cc ,()
        __CChain_pop_LCont__ ,(lc)
        args lc)))
