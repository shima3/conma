(include "pure.se")

(define __PDict_lookup_or_error__ ,(key)
  __PDict_lookup_or__ key (,(key)
    __OS_print_error__ "not found key: " ,()
    __OS_print_error__ key ,()
    __OS_print_error__ "\n" ,()
    __OS_exit_error__))

(define __exit__ ,(String)
  __PDict_lookup_or_error__ "__EXIT__" ,(exit)
  exit String)

(define stdin ,()
  __PDict_lookup_or_error__ "__STD_IN__")

(define stdout ,()
  __PDict_lookup_or_error__ "__STD_OUT__")

(define stderr ,()
  __PDict_lookup_or_error__ "__STD_ERR__")

(define __CChain_pop_LCont__ ,()
  __CChain_pop_CFrame__ ,(cf)
  __CChain_pop_CFrame__ ,(cf2)
  __CFrame_get_Closure__ cf ,(lc)
  __CFrame_get_Closure__ cf2 ,(lc2)
  lc lc2)

;; __nop__ と同様に何も実行しない関数
;; LCont を明示的に取得し、呼び出す点が __nop__ と異なる。
(define __noop__ ,()
  __CChain_pop_LCont__ ,(lc)
  lc)

(define __print__ ,(str)
  __CChain_pop_LCont__ ,(lc)
  stdout str "\n" ,(out)
  lc)

(define __print_exit_error__ ,(msg)
  __OS_print_error__ msg ,()
  __OS_exit_error__)

;; 呼び出し元に戻る継続 return を LCont に渡す。
;; return は可変長引数の関数で、受け取った引数をそのまま呼び出し元の LCont に渡す。
;; 引数がなければ、引数なしで呼び出し元に戻る。
;; 呼び出し元がない（CChain が空になる）ときは、CChain を空にして VProc を終える
(define __Cont_get__ ,()
  __CChain_pop_LCont__ ,(lc)
  __CChain_get__ ,(cc)
  lc (, args
    __if_then_else__ (,() __is_null__ cc)
      (,() __CChain_set__ cc)
      (,()
        __CChain_set__ cc ,()
        __CChain_pop_LCont__ ,(lc)
        args lc)))

;; プログラムの入口。__VProc_spawn__ の entryPoint に "__main__" を指定して起動する。
;; err, in, out と終了用の継続を PDict に登録してから、利用者が定義する main を args に適用する。
(define __main__ ,(err args in out)
  __Cont_get__ ,(exit)
  __PDict_put__ "__EXIT__" exit ,()
  __PDict_put__ "__STD_IN__" in ,()
  __PDict_put__ "__STD_OUT__" out ,()
  __PDict_put__ "__STD_ERR__" err ,()
  main args ,()
  exit "")

;; ── 標準入出力 ──

;; output Stream に value を書き込み、続けて書き込む Sink を返す
(define __Stream_sink__ ,(stream value)
  __OS_write__ __print_exit_error__ stream value ,()
  __NULL__ (,(value) __Stream_sink__ stream value))

;; input Stream を EOF まで読み、1行ずつ（改行を含めて）sink に渡す Seq。
;; 最後の行に改行がなければ、改行なしで渡す。最後の Sink を返す。
;; データがまだ来ていなければ、来るまで待つ（ほかの VProc は動き続ける）
(define __Stream_lines__ ,(stream sink)
  __Stream_lines_read__ stream "" sink)

;; buf は、まだ改行が来ていない行の途中
(define __Stream_lines_read__ ,(stream buf sink)
  __OS_read__ __print_exit_error__ stream ,(data)
  __if_then_else__ (,() __is_null__ data)
    (,()
      __String_length__ buf ,(len)
      __if_then_else__ (,() __Number_is_zero__ len)
        (,() __NULL__ sink)
        (,() sink buf))
    (,()
      __String_length__ data ,(dataLen)
      __if_then_else__ (,() __Number_is_zero__ dataLen)
        (,()
          __OS_wait_readable__ __print_exit_error__ stream ,()
          __Stream_lines_read__ stream buf sink)
        (,()
          __String_length__ buf ,(start)
          __String_concat__ buf data ,(buf)
          __String_length__ buf ,(len)
          __Number_fromString__ __print_exit_error__ "0" ,(zero)
          __Stream_lines_scan__ stream buf len zero start sink)))

;; buf の i 文字目から改行を探す。lineStart から改行までを1行として sink に渡す
(define __Stream_lines_scan__ ,(stream buf len lineStart i sink)
  __Number_subtract__ len i ,(rest)
  __if_then_else__ (,() __Number_is_zero__ rest)
    (,()
      __String_substring__ __print_exit_error__ buf lineStart len ,(buf)
      __Stream_lines_read__ stream buf sink)
    (,()
      __Number_fromString__ __print_exit_error__ "1" ,(one)
      __Number_add__ i one ,(next)
      __String_substring__ __print_exit_error__ buf i next ,(ch)
      __if_then_else__ (,() __String_equal__ ch "\n")
        (,()
          __String_substring__ __print_exit_error__ buf lineStart next ,(line)
          sink line ,(sink)
          __Stream_lines_scan__ stream buf len next next sink)
        (,() __Stream_lines_scan__ stream buf len lineStart next sink)))

;; インタプリタが最初の VProc を起動する入口（vproc_run.py --main）。
;; 標準入出力の Stream から err, in, out を作り、__main__ を呼ぶ
(define __start__ ,(args)
  __OS_get_stderr__ ,(errStream)
  __OS_get_stdin__ ,(inStream)
  __OS_get_stdout__ ,(outStream)
  __main__
    (,(value) __Stream_sink__ errStream value)
    args
    (,(sink) __Stream_lines__ inStream sink)
    (,(value) __Stream_sink__ outStream value))

;; ── Seq ──

;; Seq の最初の要素 first と、残りの Seq rest を返す。Seq が空なら onEmpty を呼ぶ。
;; sink が first を受け取ったとき、残りの要素は次のどちらかにある。
;;   ・余ったオペランドとして CChain に積まれた Seq Closure（要素をまとめて渡す Seq）
;;   ・sink の適用の LCont（要素を1つずつ渡す Seq の続き）
;; どちらも CChain の先頭なので、__CChain_pop_LCont__ で取り出して rest にする。
;; 最後の要素では、取り出されるのは Seq の適用の LCont（下の ,(sink) ...）になる。
;; これを後で rest として sink に適用すると、got が __TRUE__ なので sink をそのまま返し、空の Seq として働く。
;; Seq が空なら sink は呼ばれず、Seq は sink をそのまま LCont に返すので、got が __FALSE__ になり onEmpty を呼ぶ
(define __Seq_get__ ,(onEmpty Seq)
  __Cont_get__ ,(return)
  __Ref_new__ __FALSE__ ,(got)
  Seq (,(first)
        __Ref_set__ got __TRUE__ ,()
        __CChain_pop_LCont__ ,(rest)
        return first rest) ,(sink)
  __Ref_get__ got ,(gotOne)
  __if_then_else__ (,() __NULL__ gotOne)
    (,() __NULL__ sink)
    onEmpty)

;; Seq の要素を順に __OS_print__ で出力する
(define __Seq_print__ ,(seq)
  __Cont_get__ ,(return)
  __Seq_get__ return seq ,(str rest)
  __OS_print__ str ,()
  __Seq_print__ rest)

;; 引数をすべて続けて出力し、改行する（可変長引数）
(define __println__ , args
  __Seq_print__ args ,()
  __OS_print__ "\n")
