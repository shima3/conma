{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "consh-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "consh/js/serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "consh-web-plain",
      "runtimeExecutable": "python3",
