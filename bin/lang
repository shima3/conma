#!/bin/bash
# bin/lang: ConMa に変換する言語のプログラムを、変換して動かす（docs/dev/PLATFORM-PLAN-ja.md の 4.3 節、段階 P4。言語キット）。
#   bin/lang [--emit] 言語のディレクトリ ファイル [引数 ...]
#   bin/lang --version     ConMa の版を出す（bin/version。2026-11-24）
# ファイルの後の引数は、変換したプログラムの main に渡す（ConJS の argv。docs/dev/PLATFORM-PLAN-ja.md の 4.8 節、段階 P8）。
# 言語のディレクトリ（sjs、conjs など）の lang.conf に、言語の名前（name）、変換器（translator。ディレクトリからの相対パス）、
# include の並び（include。リポジトリのルートからの相対パスを空白で区切る）、ファイルの拡張子（ext。bin/lang-test が使う）を「名前=値」の行で書く（# で始まる行は飛ばす。
# シェルとしては読まない）。変換器のモジュールは、ソースか VM（フロントエンドを持つ）が新しくなったときだけ作り直し、
# bin/cache-dir の場所に「name」c.module.se として置く（作るのに数秒かかる）。一時ファイルに作ってから mv で置き換えるので、
# 同時に動く bin/lang が作りかけのモジュールを読むことはない。変換は Rust 版の VM（vm/target/release/conma）で行い、それが
# なければ wasm 版の VM（vm/wasm/build.sh で作る。Node.js の vm-node.js の build と link。2026-11-23 から）で行う。
# 環境変数 CONMA_TRANSLATE_VM を wasm にすると、Rust 版の VM があっても wasm 版で変換する（確かめるため）。
# どちらで作っても、モジュールは 1 バイトも同じになる。
# --emit なら、変換した ConMa のソースを出して終える。そうでなければ、CONMA_VM の VM で動かす：なし（Rust 版）、
# wasm（vm/wasm/vm-wasm.sh。Node.js）、python（bin/vm）。transpiled は Rust 版で動かす（変換器のモジュールのため）。
# CONMA_VM がなく、Rust 版の VM もなければ、wasm 版で動かす（Rust を入れずに、Node.js だけで動かせるように）。
# Rust 版で動かすとき、CONMA_RUNNER があれば、vm/target/release/conma の代わりに、その実行ファイルで動かす（VM を組み込んで
# ホストの関数を足したプログラム。test/host-api.sh。docs/HOST-ja.md）。変換とモジュール作りは、いつも vm/target/release/conma。
# 変換したソースの include の行（ランタイム）は、フロントエンドに通すと約 1.4 秒かかるので、先にモジュールにしておく
# （docs/dev/PLATFORM-PLAN-ja.md の 4.4 節、段階 P5）：include の行だけのファイル（キャッシュの「name」-rt-ハッシュ.se）の
# モジュール（ランタイムのモジュール）を、include の行が同じなら 1 度だけ作り、変換器のモジュールと同じく、ソースか VM が
# 新しくなったときだけ作り直す。include の行を除いたソースだけをモジュールにして、conma link でランタイムのモジュールと
# 大域変数の名前で合わせる。できるモジュールは、include の行ごとフロントエンドに通したものと、大域変数の番号とファイルの
# 順のほかは同じで、同じステップ数で動く
# 起動を速くするため、外のコマンドを少なくする（2026-11-24）：dirname の代わりに ${0%/*}、shasum（Perl）の代わりに cksum、
# 2 つの grep の代わりに 1 つの awk
case "$0" in */*) root="${0%/*}/.." ;; *) root=.. ;; esac
root="$(cd "$root" && pwd)"
if [ "$1" = --version ]; then exec "$root/bin/version"; fi
conma="$root/vm/target/release/conma"
wasm="$root/vm/wasm/target/wasm32-unknown-unknown/release/conma_wasm.wasm"
# 変換とモジュール作りをする VM（tr）と、それが新しくなったらモジュールを作り直す印のファイル（stamps）
if [ -x "$conma" ] && [ "$CONMA_TRANSLATE_VM" != wasm ]; then
  tr=("$conma") stamps=("$conma")
elif [ -f "$wasm" ]; then
  tr=("$root/vm/wasm/vm-wasm.sh") stamps=("$wasm" "$root/vm/frontend.module.se")
else
  echo "lang: no VM to translate with: build the Rust VM (cd vm && cargo build --release) or the wasm VM (vm/wasm/build.sh)" >&2
  exit 2
fi
# 印のファイルのどれかが $1 より新しいか
stale() { local s; for s in "${stamps[@]}"; do [ "$s" -nt "$1" ] && return 0; done; return 1; }
emit=
if [ "$1" = --emit ]; then emit=yes; shift; fi
if [ $# -lt 2 ]; then echo "usage: lang [--emit] language-directory file [argument ...]" >&2; exit 2; fi
dir="$(cd "$1" && pwd)" || exit 2
file="$2"
shift 2
name= translator= include=
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ''|'#'*) ;;
    name=*) name="${line#name=}" ;;
    translator=*) translator="${line#translator=}" ;;
    include=*) include="${line#include=}" ;;
    ext=*) ;;   # ファイルの拡張子（bin/lang-test が読む）
    *) echo "lang: $dir/lang.conf: unknown line: $line" >&2; exit 2 ;;
  esac
done < "$dir/lang.conf" || exit 2
if [ -z "$name" ] || [ -z "$translator" ]; then echo "lang: $dir/lang.conf needs name and translator" >&2; exit 2; fi
inc=() dirs=()
for d in $include; do inc+=(--include "$root/$d"); dirs+=("$root/$d"); done
tmp="$(mktemp -d "${TMPDIR:-/tmp}/lang.XXXXXX")" || exit 1
trap 'rm -rf "$tmp"' EXIT
module="$("$root/bin/cache-dir")/${name}c.module.se" || exit 1
if [ ! -s "$module" ] || [ -n "$(find "${dirs[@]}" "$root/include/ext" "$root/include" "$dir/$translator" \( -name '*.se' -o -type d \) -newer "$module")" ] ||
   stale "$module"; then
  module_tmp=$(mktemp "$module.XXXXXX") || exit 1
  if ! "${tr[@]}" build "${inc[@]}" "$dir/$translator" > "$module_tmp"; then rm -f "$module_tmp"; exit 1; fi
  mv -f "$module_tmp" "$module" || { rm -f "$module_tmp"; exit 1; }
fi
"${tr[@]}" --main "$module" "$file" > "$tmp/prog.se" || exit $?
if [ -n "$emit" ]; then cat "$tmp/prog.se"; exit 0; fi
# ランタイムのモジュール（作りかけを読まないように、一時ファイルに作ってから mv で置き換える）
awk -v rt="$tmp/rt.se" -v alone="$tmp/alone.se" '/^\(include / { print > rt; next } { print > alone }' "$tmp/prog.se" || exit 1
: >> "$tmp/rt.se"
cache="$(dirname "$module")"
rthash="$( { printf '%s\n' "$include"; cat "$tmp/rt.se"; } | cksum)"
rthash="${rthash%% *}"
rtsrc="$cache/${name}-rt-$rthash.se" rtmod="$cache/${name}-rt-$rthash.module.se"
if [ ! -s "$rtmod" ] || [ -n "$(find "${dirs[@]}" "$root/include/ext" "$root/include" \( -name '*.se' -o -type d \) -newer "$rtmod")" ] ||
   stale "$rtmod"; then
  # ソースも、一時ファイルに書いてから mv で置く（同時に動く bin/lang が、書きかけのソースからモジュールを作らないように）
  if [ ! -f "$rtsrc" ] || ! cmp -s "$tmp/rt.se" "$rtsrc"; then
    src_tmp=$(mktemp "$rtsrc.XXXXXX") || exit 1
    cp "$tmp/rt.se" "$src_tmp" && mv -f "$src_tmp" "$rtsrc" || { rm -f "$src_tmp"; exit 1; }
  fi
  rt_tmp=$(mktemp "$rtmod.XXXXXX") || exit 1
  if ! "${tr[@]}" build "${inc[@]}" "$rtsrc" > "$rt_tmp"; then rm -f "$rt_tmp"; exit 1; fi
  mv -f "$rt_tmp" "$rtmod" || { rm -f "$rt_tmp"; exit 1; }
fi
"${tr[@]}" build "${inc[@]}" "$tmp/alone.se" > "$tmp/alone.module.se" || exit $?
"${tr[@]}" link "$rtmod" "$tmp/alone.module.se" > "$tmp/prog.module.se" || exit $?
vm="$CONMA_VM"
[ -z "$vm" ] && [ ! -x "$conma" ] && vm=wasm
case "$vm" in
  wasm) "$root/vm/wasm/vm-wasm.sh" --main "$tmp/prog.module.se" "$@" ;;
  python) "$root/bin/vm" --main "$tmp/prog.module.se" "$@" ;;
  ''|rust|transpiled) "${CONMA_RUNNER:-$conma}" --main "$tmp/prog.module.se" "$@" ;;
  *) echo "lang: CONMA_VM must be empty, rust, transpiled, wasm or python, not \"$CONMA_VM\"" >&2; exit 2 ;;
esac
