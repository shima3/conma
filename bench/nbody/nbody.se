;; nbody: the orbits of the Jovian planets around the sun (the n-body benchmark of pyperformance and of the
;; Computer Language Benchmarks Game), the same computation as nbody.py.
;;   main N: prints the energy of the system, advances it N steps of 0.01 days, and prints the energy again.
;; A body is a Dict with "x" "y" "z" "vx" "vy" "vz" "m". The operations are done in the same order as in
;; nbody.py, so both print the same two numbers.
(include "util.se")

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

(define show ,(n)
  __Number_toString__ n ,(s)
  __OS_print__ s ,()
  __OS_print__ "\n")

(define solar_mass ,()
  num "3.14159265358979323" ,(pi)
  num "4" ,(four)
  __Number_multiply__ four pi ,(a)
  __Number_multiply__ a pi)

(define body ,(x y z vx vy vz m)
  __Dict_new__ ,(b)
  __Dict_put__ b "x" x ,()
  __Dict_put__ b "y" y ,()
  __Dict_put__ b "z" z ,()
  __Dict_put__ b "vx" vx ,()
  __Dict_put__ b "vy" vy ,()
  __Dict_put__ b "vz" vz ,()
  __Dict_put__ b "m" m ,()
  __NULL__ b)

;; a planet from its position (AU), velocity (AU per day) and mass (in solar masses)
(define planet ,(sm xs ys zs vxs vys vzs ms)
  num "365.24" ,(dpy)
  num xs ,(x)
  num ys ,(y)
  num zs ,(z)
  num vxs ,(vx)
  num vys ,(vy)
  num vzs ,(vz)
  num ms ,(m)
  __Number_multiply__ vx dpy ,(vx)
  __Number_multiply__ vy dpy ,(vy)
  __Number_multiply__ vz dpy ,(vz)
  __Number_multiply__ m sm ,(m)
  body x y z vx vy vz m)

(define make_bodies ,(sm)
  num "0" ,(zero)
  body zero zero zero zero zero zero sm ,(sun)
  planet sm "4.84143144246472090e+00" "-1.16032004402742839e+00" "-1.03622044471123109e-01"
    "1.66007664274403694e-03" "7.69901118419740425e-03" "-6.90460016972063023e-05"
    "9.54791938424326609e-04" ,(jupiter)
  planet sm "8.34336671824457987e+00" "4.12479856412430479e+00" "-4.03523417114321381e-01"
    "-2.76742510726862411e-03" "4.99852801234917238e-03" "2.30417297573763929e-05"
    "2.85885980666130812e-04" ,(saturn)
  planet sm "1.28943695621391310e+01" "-1.51111514016986312e+01" "-2.23307578892655734e-01"
    "2.96460137564761618e-03" "2.37847173959480950e-03" "-2.96589568540237556e-05"
    "4.36624404335156298e-05" ,(uranus)
  planet sm "1.53796971148509165e+01" "-2.59193146099879641e+01" "1.79258772950371181e-01"
    "2.68067772490389322e-03" "1.62824170038242295e-03" "-9.51592254519715870e-05"
    "5.15138902046611451e-05" ,(neptune)
  __LList_cons__ neptune __NULL__ ,(l)
  __LList_cons__ uranus l ,(l)
  __LList_cons__ saturn l ,(l)
  __LList_cons__ jupiter l ,(l)
  __LList_cons__ sun l)

;; every pair (b1 b2) of bodies, b1 before b2 in the list
(define make_pairs ,(bodies)
  __is_null__ bodies ,(done)
  __if_then_else__ done
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ bodies ,(b rest)
      pairs_with b rest ,(front)
      make_pairs rest ,(back)
      __LList_append__ front back))

(define pairs_with ,(b others)
  __is_null__ others ,(done)
  __if_then_else__ done
    (,() __NULL__ __NULL__)
    (,()
      __LList_uncons__ __print_exit_error__ others ,(o rest)
      __LList_cons__ o __NULL__ ,(pair)
      __LList_cons__ b pair ,(pair)
      pairs_with b rest ,(more)
      __LList_cons__ pair more))

;; p minus the sum of v * m over the bodies (v is the value under key)
(define momentum ,(bodies key p)
  __is_null__ bodies ,(done)
  __if_then_else__ done
    (,() __NULL__ p)
    (,()
      __LList_uncons__ __print_exit_error__ bodies ,(b rest)
      __Dict_lookup_or__ b key __print_exit_error__ ,(v)
      __Dict_lookup_or__ b "m" __print_exit_error__ ,(m)
      __Number_multiply__ v m ,(t)
      __Number_subtract__ p t ,(p)
      momentum rest key p))

;; give the sun the momentum that makes the total momentum zero
(define offset_momentum ,(bodies sm)
  num "0" ,(zero)
  momentum bodies "vx" zero ,(px)
  momentum bodies "vy" zero ,(py)
  momentum bodies "vz" zero ,(pz)
  __LList_uncons__ __print_exit_error__ bodies ,(sun rest)
  __Number_divide__ __print_exit_error__ px sm ,(v)
  __Dict_put__ sun "vx" v ,()
  __Number_divide__ __print_exit_error__ py sm ,(v)
  __Dict_put__ sun "vy" v ,()
  __Number_divide__ __print_exit_error__ pz sm ,(v)
  __Dict_put__ sun "vz" v)

(define energy ,(bodies pairs)
  num "0" ,(e)
  potential pairs e ,(e)
  num "2" ,(two)
  kinetic bodies two e)

(define potential ,(pairs e)
  __is_null__ pairs ,(done)
  __if_then_else__ done
    (,() __NULL__ e)
    (,()
      __LList_uncons__ __print_exit_error__ pairs ,(pair rest)
      __LList_uncons__ __print_exit_error__ pair ,(b1 r)
      __LList_uncons__ __print_exit_error__ r ,(b2 r)
      __Dict_lookup_or__ b1 "x" __print_exit_error__ ,(x1)
      __Dict_lookup_or__ b2 "x" __print_exit_error__ ,(x2)
      __Dict_lookup_or__ b1 "y" __print_exit_error__ ,(y1)
      __Dict_lookup_or__ b2 "y" __print_exit_error__ ,(y2)
      __Dict_lookup_or__ b1 "z" __print_exit_error__ ,(z1)
      __Dict_lookup_or__ b2 "z" __print_exit_error__ ,(z2)
      __Number_subtract__ x1 x2 ,(dx)
      __Number_subtract__ y1 y2 ,(dy)
      __Number_subtract__ z1 z2 ,(dz)
      __Number_multiply__ dx dx ,(a)
      __Number_multiply__ dy dy ,(b)
      __Number_multiply__ dz dz ,(c)
      __Number_add__ a b ,(s)
      __Number_add__ s c ,(d2)
      __Number_sqrt__ __print_exit_error__ d2 ,(d)
      __Dict_lookup_or__ b1 "m" __print_exit_error__ ,(m1)
      __Dict_lookup_or__ b2 "m" __print_exit_error__ ,(m2)
      __Number_multiply__ m1 m2 ,(mm)
      __Number_divide__ __print_exit_error__ mm d ,(q)
      __Number_subtract__ e q ,(e)
      potential rest e))

(define kinetic ,(bodies two e)
  __is_null__ bodies ,(done)
  __if_then_else__ done
    (,() __NULL__ e)
    (,()
      __LList_uncons__ __print_exit_error__ bodies ,(b rest)
      __Dict_lookup_or__ b "vx" __print_exit_error__ ,(vx)
      __Dict_lookup_or__ b "vy" __print_exit_error__ ,(vy)
      __Dict_lookup_or__ b "vz" __print_exit_error__ ,(vz)
      __Dict_lookup_or__ b "m" __print_exit_error__ ,(m)
      __Number_multiply__ vx vx ,(a)
      __Number_multiply__ vy vy ,(b2)
      __Number_multiply__ vz vz ,(c)
      __Number_add__ a b2 ,(s)
      __Number_add__ s c ,(s)
      __Number_multiply__ m s ,(t)
      __Number_divide__ __print_exit_error__ t two ,(t)
      __Number_add__ e t ,(e)
      kinetic rest two e))

;; the velocities of one pair
(define pair_step ,(pair dt)
  __LList_uncons__ __print_exit_error__ pair ,(b1 r)
  __LList_uncons__ __print_exit_error__ r ,(b2 r)
  __Dict_lookup_or__ b1 "x" __print_exit_error__ ,(x1)
  __Dict_lookup_or__ b2 "x" __print_exit_error__ ,(x2)
  __Dict_lookup_or__ b1 "y" __print_exit_error__ ,(y1)
  __Dict_lookup_or__ b2 "y" __print_exit_error__ ,(y2)
  __Dict_lookup_or__ b1 "z" __print_exit_error__ ,(z1)
  __Dict_lookup_or__ b2 "z" __print_exit_error__ ,(z2)
  __Number_subtract__ x1 x2 ,(dx)
  __Number_subtract__ y1 y2 ,(dy)
  __Number_subtract__ z1 z2 ,(dz)
  __Number_multiply__ dx dx ,(a)
  __Number_multiply__ dy dy ,(b)
  __Number_multiply__ dz dz ,(c)
  __Number_add__ a b ,(s)
  __Number_add__ s c ,(d2)
  __Number_sqrt__ __print_exit_error__ d2 ,(d)
  __Number_multiply__ d2 d ,(dd)
  __Number_divide__ __print_exit_error__ dt dd ,(mag)
  __Dict_lookup_or__ b2 "m" __print_exit_error__ ,(m2)
  __Number_multiply__ m2 mag ,(m2mag)
  __Dict_lookup_or__ b1 "vx" __print_exit_error__ ,(v)
  __Number_multiply__ dx m2mag ,(t)
  __Number_subtract__ v t ,(v)
  __Dict_put__ b1 "vx" v ,()
  __Dict_lookup_or__ b1 "vy" __print_exit_error__ ,(v)
  __Number_multiply__ dy m2mag ,(t)
  __Number_subtract__ v t ,(v)
  __Dict_put__ b1 "vy" v ,()
  __Dict_lookup_or__ b1 "vz" __print_exit_error__ ,(v)
  __Number_multiply__ dz m2mag ,(t)
  __Number_subtract__ v t ,(v)
  __Dict_put__ b1 "vz" v ,()
  __Dict_lookup_or__ b1 "m" __print_exit_error__ ,(m1)
  __Number_multiply__ m1 mag ,(m1mag)
  __Dict_lookup_or__ b2 "vx" __print_exit_error__ ,(v)
  __Number_multiply__ dx m1mag ,(t)
  __Number_add__ v t ,(v)
  __Dict_put__ b2 "vx" v ,()
  __Dict_lookup_or__ b2 "vy" __print_exit_error__ ,(v)
  __Number_multiply__ dy m1mag ,(t)
  __Number_add__ v t ,(v)
  __Dict_put__ b2 "vy" v ,()
  __Dict_lookup_or__ b2 "vz" __print_exit_error__ ,(v)
  __Number_multiply__ dz m1mag ,(t)
  __Number_add__ v t ,(v)
  __Dict_put__ b2 "vz" v)

(define pairs_step ,(pairs dt)
  __is_null__ pairs ,(done)
  __unless__ done
    (,()
      __LList_uncons__ __print_exit_error__ pairs ,(pair rest)
      pair_step pair dt ,()
      pairs_step rest dt))

;; the positions of the bodies
(define positions ,(bodies dt)
  __is_null__ bodies ,(done)
  __unless__ done
    (,()
      __LList_uncons__ __print_exit_error__ bodies ,(b rest)
      __Dict_lookup_or__ b "vx" __print_exit_error__ ,(v)
      __Number_multiply__ dt v ,(t)
      __Dict_lookup_or__ b "x" __print_exit_error__ ,(p)
      __Number_add__ p t ,(p)
      __Dict_put__ b "x" p ,()
      __Dict_lookup_or__ b "vy" __print_exit_error__ ,(v)
      __Number_multiply__ dt v ,(t)
      __Dict_lookup_or__ b "y" __print_exit_error__ ,(p)
      __Number_add__ p t ,(p)
      __Dict_put__ b "y" p ,()
      __Dict_lookup_or__ b "vz" __print_exit_error__ ,(v)
      __Number_multiply__ dt v ,(t)
      __Dict_lookup_or__ b "z" __print_exit_error__ ,(p)
      __Number_add__ p t ,(p)
      __Dict_put__ b "z" p ,()
      positions rest dt))

(define advance ,(bodies pairs dt n one)
  __Number_is_zero__ n ,(done)
  __unless__ done
    (,()
      pairs_step pairs dt ,()
      positions bodies dt ,()
      __Number_subtract__ n one ,(n)
      advance bodies pairs dt n one))

(define main ,(args)
  args (,(nText)
    num nText ,(n)
    num "1" ,(one)
    num "0.01" ,(dt)
    solar_mass ,(sm)
    make_bodies sm ,(bodies)
    make_pairs bodies ,(pairs)
    offset_momentum bodies sm ,()
    energy bodies pairs ,(e)
    show e ,()
    advance bodies pairs dt n one ,()
    energy bodies pairs ,(e)
    show e))
