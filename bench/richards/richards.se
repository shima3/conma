;; richards: Martin Richards' simulation of the task dispatcher of an operating system (the richards
;; benchmark of pyperformance), the same computation as richards.py.
;;   main N: runs the simulation N times and prints the hold count and the packet count of each run.
;; A task, a packet and the record of a task are Dicts; a task has under "fn" the function that runs it
;; (as a method of its class in richards.py). The work area w is a Dict too, with the constants that
;; richards.py has as global variables. The data of a packet is a Dict from 0 1 2 3. The idle task computes
;; `control & 1`, `control // 2` and `^ 0xD008` with the bitwise primitives of fast ConMa (docs/BITWISE-PLAN-ja.md;
;; the frontend marks the module (Uses "bitwise32"), and bin/concise translates it for the Python VM).
(include "util.se")

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

(define show_counts ,(w)
  __Dict_lookup_or__ w "hold" __print_exit_error__ ,(h)
  __Dict_lookup_or__ w "qpkt" __print_exit_error__ ,(q)
  __Number_toString__ h ,(hs)
  __Number_toString__ q ,(qs)
  __String_concat__ hs " " ,(s)
  __String_concat__ s qs ,(s)
  __String_concat__ s "\n" ,(s)
  __OS_print__ s)

;; ── Packets ──

(define packet ,(w link ident kind)
  __Dict_new__ ,(p)
  __Dict_put__ p "link" link ,()
  __Dict_put__ p "ident" ident ,()
  __Dict_put__ p "kind" kind ,()
  __Dict_lookup_or__ w "zero" __print_exit_error__ ,(zero)
  __Dict_put__ p "datum" zero ,()
  __Dict_new__ ,(data)
  __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
  __Dict_lookup_or__ w "bufsize" __print_exit_error__ ,(n)
  fill_zeros data zero n one zero ,()
  __Dict_put__ p "data" data ,()
  __NULL__ p)

(define fill_zeros ,(data i n one zero)
  __Number_subtract__ n i ,(left)
  __Number_is_positive__ left ,(more)
  __if__ more
    (,()
      __Dict_put__ data i zero ,()
      __Number_add__ i one ,(i)
      fill_zeros data i n one zero))

;; lst with the packet p at its end
(define append_to ,(p lst)
  __Dict_put__ p "link" __NULL__ ,()
  __is_null__ lst ,(empty)
  __if_then_else__ empty
    (,() __NULL__ p)
    (,()
      last_packet lst ,(q)
      __Dict_put__ q "link" p ,()
      __NULL__ lst))

(define last_packet ,(p)
  __Dict_lookup_or__ p "link" __print_exit_error__ ,(next)
  __is_null__ next ,(end)
  __if_then_else__ end
    (,() __NULL__ p)
    (,() last_packet next))

;; ── Tasks ──

(define task ,(w ident priority input pending waiting holding rec fn)
  __Dict_new__ ,(t)
  __Dict_lookup_or__ w "list" __print_exit_error__ ,(link)
  __Dict_put__ t "link" link ,()
  __Dict_put__ t "ident" ident ,()
  __Dict_put__ t "priority" priority ,()
  __Dict_put__ t "input" input ,()
  __Dict_put__ t "pending" pending ,()
  __Dict_put__ t "waiting" waiting ,()
  __Dict_put__ t "holding" holding ,()
  __Dict_put__ t "rec" rec ,()
  __Dict_put__ t "fn" fn ,()
  __Dict_put__ w "list" t ,()
  __Dict_lookup_or__ w "tasks" __print_exit_error__ ,(tasks)
  __Dict_put__ tasks ident t)

;; holding or (not pending and waiting)
(define holding_or_waiting ,(t)
  __Dict_lookup_or__ t "holding" __print_exit_error__ ,(holding)
  __if_then_else__ holding
    (,() __NULL__ __TRUE__)
    (,()
      __Dict_lookup_or__ t "pending" __print_exit_error__ ,(pending)
      __if_then_else__ pending
        (,() __NULL__ __FALSE__)
        (,() __Dict_lookup_or__ t "waiting" __print_exit_error__)))

;; pending and waiting and not holding
(define waiting_with_packet ,(t)
  __Dict_lookup_or__ t "pending" __print_exit_error__ ,(pending)
  __if_then_else__ pending
    (,()
      __Dict_lookup_or__ t "waiting" __print_exit_error__ ,(waiting)
      __if_then_else__ waiting
        (,()
          __Dict_lookup_or__ t "holding" __print_exit_error__ ,(holding)
          __if_then_else__ holding (,() __NULL__ __FALSE__) (,() __NULL__ __TRUE__))
        (,() __NULL__ __FALSE__))
    (,() __NULL__ __FALSE__))

;; old, or t if the packet makes t run before old
(define add_packet ,(t p old)
  __Dict_lookup_or__ t "input" __print_exit_error__ ,(input)
  __is_null__ input ,(empty)
  __if_then_else__ empty
    (,()
      __Dict_put__ t "input" p ,()
      __Dict_put__ t "pending" __TRUE__ ,()
      __Dict_lookup_or__ t "priority" __print_exit_error__ ,(a)
      __Dict_lookup_or__ old "priority" __print_exit_error__ ,(b)
      __Number_subtract__ a b ,(d)
      __Number_is_positive__ d ,(higher)
      __if_then_else__ higher (,() __NULL__ t) (,() __NULL__ old))
    (,()
      append_to p input ,(input)
      __Dict_put__ t "input" input ,()
      __NULL__ old))

;; the task to run next
(define run_task ,(w t)
  waiting_with_packet t ,(wp)
  __if_then_else__ wp
    (,()
      __Dict_lookup_or__ t "input" __print_exit_error__ ,(msg)
      __Dict_lookup_or__ msg "link" __print_exit_error__ ,(next)
      __Dict_put__ t "input" next ,()
      __is_null__ next ,(none)
      __if_then_else__ none (,() __NULL__ __FALSE__) (,() __NULL__ __TRUE__) ,(pending)
      __Dict_put__ t "pending" pending ,()
      __Dict_put__ t "waiting" __FALSE__ ,()
      __Dict_put__ t "holding" __FALSE__ ,()
      __NULL__ msg)
    (,() __NULL__ __NULL__) ,(msg)
  __Dict_lookup_or__ t "fn" __print_exit_error__ ,(fn)
  __Dict_lookup_or__ t "rec" __print_exit_error__ ,(rec)
  fn w t msg rec)

(define task_wait ,(t)
  __Dict_put__ t "waiting" __TRUE__ ,()
  __NULL__ t)

(define task_hold ,(w t)
  __Dict_lookup_or__ w "hold" __print_exit_error__ ,(n)
  __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
  __Number_add__ n one ,(n)
  __Dict_put__ w "hold" n ,()
  __Dict_put__ t "holding" __TRUE__ ,()
  __Dict_lookup_or__ t "link" __print_exit_error__)

(define task_release ,(w t ident)
  find_task w ident ,(u)
  __Dict_put__ u "holding" __FALSE__ ,()
  __Dict_lookup_or__ u "priority" __print_exit_error__ ,(a)
  __Dict_lookup_or__ t "priority" __print_exit_error__ ,(b)
  __Number_subtract__ a b ,(d)
  __Number_is_positive__ d ,(higher)
  __if_then_else__ higher (,() __NULL__ u) (,() __NULL__ t))

(define qpkt ,(w t pkt)
  __Dict_lookup_or__ pkt "ident" __print_exit_error__ ,(ident)
  find_task w ident ,(u)
  __Dict_lookup_or__ w "qpkt" __print_exit_error__ ,(n)
  __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
  __Number_add__ n one ,(n)
  __Dict_put__ w "qpkt" n ,()
  __Dict_put__ pkt "link" __NULL__ ,()
  __Dict_lookup_or__ t "ident" __print_exit_error__ ,(mine)
  __Dict_put__ pkt "ident" mine ,()
  add_packet u pkt t)

(define find_task ,(w ident)
  __Dict_lookup_or__ w "tasks" __print_exit_error__ ,(tasks)
  __Dict_lookup_or__ tasks ident (,(key) __print_exit_error__ "no such task"))

;; ── The functions of the tasks ──

(define device_fn ,(w t pkt d)
  __is_null__ pkt ,(none)
  __if_then_else__ none
    (,()
      __Dict_lookup_or__ d "pending" __print_exit_error__ ,(p)
      __is_null__ p ,(nop)
      __if_then_else__ nop
        (,() task_wait t)
        (,()
          __Dict_put__ d "pending" __NULL__ ,()
          qpkt w t p))
    (,()
      __Dict_put__ d "pending" pkt ,()
      task_hold w t))

(define handler_fn ,(w t pkt h)
  __is_null__ pkt ,(none)
  __unless__ none
    (,()
      __Dict_lookup_or__ pkt "kind" __print_exit_error__ ,(kind)
      __Dict_lookup_or__ w "kWork" __print_exit_error__ ,(kw)
      __Number_subtract__ kind kw ,(dk)
      __Number_is_zero__ dk ,(isWork)
      __if_then_else__ isWork
        (,()
          __Dict_lookup_or__ h "workIn" __print_exit_error__ ,(l)
          append_to pkt l ,(l)
          __Dict_put__ h "workIn" l)
        (,()
          __Dict_lookup_or__ h "deviceIn" __print_exit_error__ ,(l)
          append_to pkt l ,(l)
          __Dict_put__ h "deviceIn" l)) ,()
  __Dict_lookup_or__ h "workIn" __print_exit_error__ ,(work)
  __is_null__ work ,(nowork)
  __if_then_else__ nowork
    (,() task_wait t)
    (,()
      __Dict_lookup_or__ work "datum" __print_exit_error__ ,(count)
      __Dict_lookup_or__ w "bufsize" __print_exit_error__ ,(bufsize)
      __Number_subtract__ count bufsize ,(dc)
      __Number_is_negative__ dc ,(below)
      __if_then_else__ below
        (,()
          __Dict_lookup_or__ h "deviceIn" __print_exit_error__ ,(dev)
          __is_null__ dev ,(nodev)
          __if_then_else__ nodev
            (,() task_wait t)
            (,()
              __Dict_lookup_or__ dev "link" __print_exit_error__ ,(dl)
              __Dict_put__ h "deviceIn" dl ,()
              __Dict_lookup_or__ work "data" __print_exit_error__ ,(data)
              __Dict_lookup_or__ data count __print_exit_error__ ,(v)
              __Dict_put__ dev "datum" v ,()
              __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
              __Number_add__ count one ,(c1)
              __Dict_put__ work "datum" c1 ,()
              qpkt w t dev))
        (,()
          __Dict_lookup_or__ work "link" __print_exit_error__ ,(wl)
          __Dict_put__ h "workIn" wl ,()
          qpkt w t work)))

(define idle_fn ,(w t pkt i)
  __Dict_lookup_or__ i "count" __print_exit_error__ ,(c)
  __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
  __Number_subtract__ c one ,(c)
  __Dict_put__ i "count" c ,()
  __Number_is_zero__ c ,(z)
  __if_then_else__ z
    (,() task_hold w t)
    (,()
      __Dict_lookup_or__ i "control" __print_exit_error__ ,(control)
      __Number_shr32__ control one ,(half)
      __Number_and32__ control one ,(bit)
      __Number_is_zero__ bit ,(isEven)
      __if_then_else__ isEven
        (,()
          __Dict_put__ i "control" half ,()
          __Dict_lookup_or__ w "iDevA" __print_exit_error__ ,(id)
          task_release w t id)
        (,()
          __Dict_lookup_or__ w "xD008" __print_exit_error__ ,(mask)
          __Number_xor32__ half mask ,(x)
          __Dict_put__ i "control" x ,()
          __Dict_lookup_or__ w "iDevB" __print_exit_error__ ,(id)
          task_release w t id)))
(define worker_fn ,(w t pkt wr)
  __is_null__ pkt ,(none)
  __if_then_else__ none
    (,() task_wait t)
    (,()
      __Dict_lookup_or__ wr "destination" __print_exit_error__ ,(dst)
      __Dict_lookup_or__ w "iHandlerA" __print_exit_error__ ,(ha)
      __Number_subtract__ dst ha ,(dd)
      __Number_is_zero__ dd ,(isA)
      __if_then_else__ isA
        (,() __Dict_lookup_or__ w "iHandlerB" __print_exit_error__)
        (,() __NULL__ ha) ,(dest)
      __Dict_put__ wr "destination" dest ,()
      __Dict_put__ pkt "ident" dest ,()
      __Dict_lookup_or__ w "zero" __print_exit_error__ ,(zero)
      __Dict_put__ pkt "datum" zero ,()
      __Dict_lookup_or__ pkt "data" __print_exit_error__ ,(data)
      __Dict_lookup_or__ w "bufsize" __print_exit_error__ ,(n)
      fill_data w wr data zero n ,()
      qpkt w t pkt))

;; for i in range(n): the data of the packet from the count of the worker
(define fill_data ,(w wr data i n)
  __Number_subtract__ n i ,(left)
  __Number_is_positive__ left ,(more)
  __if__ more
    (,()
      __Dict_lookup_or__ wr "count" __print_exit_error__ ,(c)
      __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
      __Number_add__ c one ,(c)
      __Dict_put__ wr "count" c ,()
      __Dict_lookup_or__ w "n26" __print_exit_error__ ,(n26)
      __Number_subtract__ c n26 ,(over)
      __Number_is_positive__ over ,(big)
      __if__ big (,() __Dict_put__ wr "count" one) ,()
      __Dict_lookup_or__ wr "count" __print_exit_error__ ,(c)
      __Dict_lookup_or__ w "n65" __print_exit_error__ ,(a)
      __Number_add__ a c ,(v)
      __Number_subtract__ v one ,(v)
      __Dict_put__ data i v ,()
      __Number_add__ i one ,(i)
      fill_data w wr data i n))

;; ── The scheduler ──

(define schedule ,(w t)
  __is_null__ t ,(done)
  __unless__ done
    (,()
      holding_or_waiting t ,(hw)
      __if_then_else__ hw
        (,() __Dict_lookup_or__ t "link" __print_exit_error__)
        (,() run_task w t) ,(next)
      schedule w next))

(define record ,(keys values)
  __Dict_new__ ,(r)
  record_fill r keys values ,()
  __NULL__ r)

(define record_fill ,(r keys values)
  __is_null__ keys ,(done)
  __unless__ done
    (,()
      __LList_uncons__ __print_exit_error__ keys ,(k ks)
      __LList_uncons__ __print_exit_error__ values ,(v vs)
      __Dict_put__ r k v ,()
      record_fill r ks vs))

(define run_once ,(w)
  __Dict_new__ ,(tasks)
  __Dict_put__ w "tasks" tasks ,()
  __Dict_put__ w "list" __NULL__ ,()
  __Dict_lookup_or__ w "zero" __print_exit_error__ ,(zero)
  __Dict_put__ w "hold" zero ,()
  __Dict_put__ w "qpkt" zero ,()
  __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
  __Dict_lookup_or__ w "kWork" __print_exit_error__ ,(kWork)
  __Dict_lookup_or__ w "kDev" __print_exit_error__ ,(kDev)
  __Dict_lookup_or__ w "iDevA" __print_exit_error__ ,(iDevA)
  __Dict_lookup_or__ w "iDevB" __print_exit_error__ ,(iDevB)
  __Dict_lookup_or__ w "iHandlerA" __print_exit_error__ ,(iHandlerA)
  __Dict_lookup_or__ w "iHandlerB" __print_exit_error__ ,(iHandlerB)

  __Dict_new__ ,(idle)
  __Dict_put__ idle "control" one ,()
  __Dict_lookup_or__ w "n10000" __print_exit_error__ ,(n10000)
  __Dict_put__ idle "count" n10000 ,()
  __Dict_lookup_or__ w "iIdle" __print_exit_error__ ,(iIdle)
  task w iIdle one __NULL__ __FALSE__ __FALSE__ __FALSE__ idle idle_fn ,()

  packet w __NULL__ zero kWork ,(wkq)
  packet w wkq zero kWork ,(wkq)
  __Dict_new__ ,(worker)
  __Dict_put__ worker "destination" iHandlerA ,()
  __Dict_put__ worker "count" zero ,()
  __Dict_lookup_or__ w "iWork" __print_exit_error__ ,(iWork)
  __Dict_lookup_or__ w "n1000" __print_exit_error__ ,(n1000)
  task w iWork n1000 wkq __TRUE__ __TRUE__ __FALSE__ worker worker_fn ,()

  packet w __NULL__ iDevA kDev ,(wkq)
  packet w wkq iDevA kDev ,(wkq)
  packet w wkq iDevA kDev ,(wkq)
  __Dict_new__ ,(ha)
  __Dict_put__ ha "workIn" __NULL__ ,()
  __Dict_put__ ha "deviceIn" __NULL__ ,()
  __Dict_lookup_or__ w "n2000" __print_exit_error__ ,(n2000)
  task w iHandlerA n2000 wkq __TRUE__ __TRUE__ __FALSE__ ha handler_fn ,()

  packet w __NULL__ iDevB kDev ,(wkq)
  packet w wkq iDevB kDev ,(wkq)
  packet w wkq iDevB kDev ,(wkq)
  __Dict_new__ ,(hb)
  __Dict_put__ hb "workIn" __NULL__ ,()
  __Dict_put__ hb "deviceIn" __NULL__ ,()
  __Dict_lookup_or__ w "n3000" __print_exit_error__ ,(n3000)
  task w iHandlerB n3000 wkq __TRUE__ __TRUE__ __FALSE__ hb handler_fn ,()

  __Dict_new__ ,(da)
  __Dict_put__ da "pending" __NULL__ ,()
  __Dict_lookup_or__ w "n4000" __print_exit_error__ ,(n4000)
  task w iDevA n4000 __NULL__ __FALSE__ __TRUE__ __FALSE__ da device_fn ,()
  __Dict_new__ ,(db)
  __Dict_put__ db "pending" __NULL__ ,()
  __Dict_lookup_or__ w "n5000" __print_exit_error__ ,(n5000)
  task w iDevB n5000 __NULL__ __FALSE__ __TRUE__ __FALSE__ db device_fn ,()

  __Dict_lookup_or__ w "list" __print_exit_error__ ,(list)
  schedule w list ,()
  show_counts w)

(define repeat ,(w n one)
  __Number_is_zero__ n ,(done)
  __unless__ done
    (,()
      run_once w ,()
      __Number_subtract__ n one ,(n)
      repeat w n one))

;; the work area, with the constants
(define work_area ,()
  __Dict_new__ ,(w)
  __LList_cons__ "n10000" __NULL__ ,(ks) __LList_cons__ "10000" __NULL__ ,(vs)
  __LList_cons__ "n5000" ks ,(ks) __LList_cons__ "5000" vs ,(vs)
  __LList_cons__ "n4000" ks ,(ks) __LList_cons__ "4000" vs ,(vs)
  __LList_cons__ "n3000" ks ,(ks) __LList_cons__ "3000" vs ,(vs)
  __LList_cons__ "n2000" ks ,(ks) __LList_cons__ "2000" vs ,(vs)
  __LList_cons__ "n1000" ks ,(ks) __LList_cons__ "1000" vs ,(vs)
  __LList_cons__ "n65" ks ,(ks) __LList_cons__ "65" vs ,(vs)
  __LList_cons__ "n26" ks ,(ks) __LList_cons__ "26" vs ,(vs)
  __LList_cons__ "xD008" ks ,(ks) __LList_cons__ "53256" vs ,(vs)
  __LList_cons__ "bufsize" ks ,(ks) __LList_cons__ "4" vs ,(vs)
  __LList_cons__ "kWork" ks ,(ks) __LList_cons__ "1001" vs ,(vs)
  __LList_cons__ "kDev" ks ,(ks) __LList_cons__ "1000" vs ,(vs)
  __LList_cons__ "iDevB" ks ,(ks) __LList_cons__ "6" vs ,(vs)
  __LList_cons__ "iDevA" ks ,(ks) __LList_cons__ "5" vs ,(vs)
  __LList_cons__ "iHandlerB" ks ,(ks) __LList_cons__ "4" vs ,(vs)
  __LList_cons__ "iHandlerA" ks ,(ks) __LList_cons__ "3" vs ,(vs)
  __LList_cons__ "iWork" ks ,(ks) __LList_cons__ "2" vs ,(vs)
  __LList_cons__ "iIdle" ks ,(ks) __LList_cons__ "1" vs ,(vs)
  __LList_cons__ "two" ks ,(ks) __LList_cons__ "2" vs ,(vs)
  __LList_cons__ "one" ks ,(ks) __LList_cons__ "1" vs ,(vs)
  __LList_cons__ "zero" ks ,(ks) __LList_cons__ "0" vs ,(vs)
  constants w ks vs ,()
  __NULL__ w)

(define constants ,(w keys texts)
  __is_null__ keys ,(done)
  __unless__ done
    (,()
      __LList_uncons__ __print_exit_error__ keys ,(k ks)
      __LList_uncons__ __print_exit_error__ texts ,(s ss)
      num s ,(v)
      __Dict_put__ w k v ,()
      constants w ks ss))

(define main ,(args)
  args (,(nText)
    num nText ,(n)
    work_area ,(w)
    __Dict_lookup_or__ w "one" __print_exit_error__ ,(one)
    repeat w n one))
