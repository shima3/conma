;; SELFHOST.md の手順1: token.se と ast.se
(include "token.se")
(include "ast.se")

(define println ,(str)
  __OS_print__ str ,()
  __OS_print__ "\n" ,()
  )

(define num ,(str)
  __Number_fromString__ __print_exit_error__ str)

(define printNumber ,(n)
  __Number_toString__ n ,(str)
  println str)

(define printToken ,(token)
  __Token_toSexp__ token ,(str)
  println str)

(define printAST ,(node)
  __AST_toSexp__ node ,(str)
  println str)

;; (line col) の位置
(define pos ,(line col)
  num line ,(line)
  num col ,(col)
  __LList_cons__ col __NULL__ ,(list)
  __LList_cons__ line list)

;; 子ノードを1つ持つノード
(define node1 ,(kind pos child)
  __LList_cons__ child __NULL__ ,(children)
  __AST_new__ kind pos children)

;; 子ノードを2つ持つノード
(define node2 ,(kind pos child1 child2)
  __LList_cons__ child2 __NULL__ ,(children)
  __LList_cons__ child1 children ,(children)
  __AST_new__ kind pos children)

;; case1: __Token_new__ で作った Token から、各欄を取り出す
(define case1 ,()
  num "4" ,(line)
  num "18" ,(col)
  __Token_new__ "SYMBOL" "define" line col ,(token)
  __Token_get_kind__ token ,(kind)
  println kind ,()
  __Token_get_value__ token ,(value)
  println value ,()
  __Token_get_line__ token ,(line)
  printNumber line ,()
  __Token_get_col__ token ,(col)
  printNumber col ,()
  __type_name__ token ,(type)
  println type ,()
  )

;; case2: __Token_toSexp__。value の \ " 改行 タブ 復帰 はエスケープする
(define case2 ,()
  num "0" ,(zero)
  num "1" ,(one)
  num "3" ,(three)
  __Token_new__ "FILE" "t.se" zero zero ,(token)
  printToken token ,()
  __Token_new__ "LPAREN" "(" one one ,(token)
  printToken token ,()
  __Token_new__ "STRING" "\"s\\\"\\\\\"" one three ,(token)
  printToken token ,()
  __Token_new__ "NEWLINE" "\n" one three ,(token)
  printToken token ,()
  __Token_new__ "NEWLINE" "\r\n" one three ,(token)
  printToken token ,()
  __Token_new__ "BLOCK_COMMENT_TEXT" " a\n \"b\" \\ " one three ,(token)
  printToken token ,()
  __Token_new__ "LINE_COMMENT_CONTENT" " c\t\"d\" 日本語" one three ,(token)
  printToken token ,()
  __Token_new__ "BLOCK_COMMENT_TEXT" "" one three ,(token)
  printToken token ,()
  )

;; case3: __AST_new__ で作ったノードから、各欄を取り出す
(define case3 ,()
  pos "4" "13" ,(p)
  node1 "Variable" p "x" ,(var)
  __AST_get_kind__ var ,(kind)
  println kind ,()
  __AST_get_pos__ var ,(p)
  __LList_uncons__ __print_exit_error__ p ,(line rest)
  printNumber line ,()
  __AST_get_children__ var ,(children)
  __LList_uncons__ __print_exit_error__ children ,(name rest)
  println name ,()
  __type_name__ rest ,(type)
  println type ,()
  __AST_new__ "Undefined" __NULL__ __NULL__ ,(undef)
  __AST_get_pos__ undef ,(p)
  __type_name__ p ,(type)
  println type ,()
  __AST_get_children__ undef ,(children)
  __type_name__ children ,(type)
  println type ,()
  )

;; case4: __AST_toSexp__。String はエスケープせずに "..." で囲み、Number は引用符なしで書く。
;; 子ノードのないノードは位置だけを書く
(define case4 ,()
  pos "4" "18" ,(p)
  node1 "String" p "s\\\"\\\\" ,(str)
  printAST str ,()
  pos "4" "26" ,(p)
  num "0" ,(zero)
  node1 "L" __NULL__ zero ,(local)
  node2 "Variable" p "x" local ,(var)
  printAST var ,()
  pos "4" "16" ,(p)
  __LList_cons__ "16" __NULL__ ,(children)
  __LList_cons__ "4" children ,(children)
  __LList_cons__ "t.se" children ,(children)
  __AST_new__ "SInfo" p children ,(sinfo)
  printAST sinfo ,()
  pos "4" "27" ,(p)
  __AST_new__ "LCont" p __NULL__ ,(lcont)
  printAST lcont ,()
  pos "4" "18" ,(p)
  node2 "OList" p str var ,(olist)
  printAST olist ,()
  )

;; case5: Program の位置は (line col filename)。
;; 位置のないノード（Module、F、G）と、位置も子ノードもないノード（Undefined）
(define case5 ,()
  pos "1" "1" ,(p)
  __LList_uncons__ __print_exit_error__ p ,(line rest)
  __LList_uncons__ __print_exit_error__ rest ,(col rest)
  __LList_cons__ "t.se" __NULL__ ,(rest)
  __LList_cons__ col rest ,(rest)
  __LList_cons__ line rest ,(p3)
  pos "1" "2" ,(p)
  __AST_new__ "Definition" p __NULL__ ,(def)
  node1 "Program" p3 def ,(program)
  printAST program ,()
  __AST_get_pos__ program ,(p)
  __LList_uncons__ __print_exit_error__ p ,(line rest)
  __LList_uncons__ __print_exit_error__ rest ,(col rest)
  __LList_uncons__ __print_exit_error__ rest ,(file rest)
  println file ,()
  node1 "F" __NULL__ "t.se" ,(files)
  num "0" ,(zero)
  pos "4" "11" ,(p)
  __AST_new__ "Function" p __NULL__ ,(func)
  __LList_cons__ func __NULL__ ,(children)
  __LList_cons__ "f" children ,(children)
  __LList_cons__ zero children ,(children)
  __AST_new__ "G" __NULL__ children ,(gf)
  num "1" ,(one)
  __AST_new__ "Undefined" __NULL__ __NULL__ ,(undef)
  __LList_cons__ undef __NULL__ ,(children)
  __LList_cons__ "g" children ,(children)
  __LList_cons__ one children ,(children)
  __AST_new__ "G" __NULL__ children ,(gg)
  __LList_cons__ gg __NULL__ ,(children)
  __LList_cons__ gf children ,(children)
  __LList_cons__ files children ,(children)
  __AST_new__ "Module" __NULL__ children ,(module)
  printAST module ,()
  )

;; case6: __AST_toSexp__ は String、Number、ノード以外の子ノードでエラーになる
(define case6 ,()
  pos "1" "1" ,(p)
  node1 "Bad" p (,() ) ,(bad)
  printAST bad ,()
  println "not reached" ,()
  )
