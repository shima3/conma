;; Step45：拡張 ConMa の機能 "chan" の代わりの定義（include/core/chan.se。docs/dev/CHAN-PLAN-ja.md）。
;; VProc の切り替わる時期は VM によって違うので、鎖のあいだの順番には左右されない形で確かめる：
;; 書き手ごとの順番（取り出した要素を書き手ごとに分けて出す）、要素の数、すべての鎖が閉じた後に終わること、
;; cancel、$( ) の状態の Ref
(include "util.se")
(include "core/chan.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

;; 読み位置から、すべての鎖が閉じるまで取り出し、要素の LList（取り出した順）を返す
(define drain ,(reader)
  __Cont_get__ ,(return)
  __Chan_take__ reader ,(item found)
  __unless__ found (,() return __NULL__) ,()
  drain reader ,(rest)
  __LList_cons__ item rest)

;; 要素の LList を空白で区切った String
(define join ,(list)
  __Cont_get__ ,(return)
  __is_null__ list ,(condition)
  __if__ condition (,() return "") ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  join tail ,(rest)
  __is_null__ tail ,(last)
  __if__ last (,() return head) ,()
  __String_concat__ head " " ,(s)
  __String_concat__ s rest)

;; 要素のうち、prefix で始まるものだけ（順は変えない）
(define only ,(list prefix)
  __Cont_get__ ,(return)
  __is_null__ list ,(condition)
  __if__ condition (,() return __NULL__) ,()
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  only tail prefix ,(rest)
  num "0" ,(zero)
  __String_find__ __print_exit_error__ head prefix zero ,(pos)
  __is_null__ pos ,(missing)
  __if__ missing (,() return rest) ,()
  __Number_is_zero__ pos ,(first)
  __unless__ first (,() return rest) ,()
  __LList_cons__ head rest)

;; prefix の後に 1 から n までの数を付けた要素を書き、閉じる
(define write_n ,(writer prefix n)
  num "1" ,(one)
  write_from writer prefix one n ,()
  __Chan_close__ writer)

(define write_from ,(writer prefix i n)
  __Cont_get__ ,(return)
  __Number_subtract__ n i ,(d)
  __Number_is_negative__ d ,(done)
  __if__ done return ,()
  __Number_toString__ i ,(s)
  __String_concat__ prefix s ,(item)
  __Chan_put__ (,() println "unexpected cancel") writer item ,()
  num "1" ,(one)
  __Number_add__ i one ,(i)
  write_from writer prefix i n)

;; case1：書き手が 1 つ、cap 2 に 5 個。書いた順に取り出し、閉じたら終わる。__Chan_of__ はそのチャネル
(define case1 ,()
  num "2" ,(cap)
  __Chan_new__ cap __NULL__ ,(chan)
  __Chan_writer__ chan ,(writer)
  __Chan_of__ writer ,(of)
  __Dict_lookup_or__ of "cap" __print_exit_error__ ,(c)
  __Number_toString__ c ,(cs)
  __String_concat__ "cap of the writer's channel: " cs ,(line)
  println line ,()
  num "5" ,(five)
  __VProc_start__ (,() write_n writer "a" five) ,(vp)
  __Chan_reader__ chan ,(reader)
  drain reader ,(items)
  join items ,(s)
  println s ,()
  __VProc_wait__ __print_exit_error__ vp ,()
  ;; 閉じた後に取り出しても、終わったまま
  __Chan_take__ reader ,(item found)
  __if_then_else__ found (,() println "found after the end") (,() println "end"))

;; case2：書き手が 3 つ（cap 1）。書き手ごとの順と、全部の数
(define case2 ,()
  num "1" ,(cap)
  __Chan_new__ cap __NULL__ ,(chan)
  __Chan_writer__ chan ,(wa)
  __Chan_writer__ chan ,(wb)
  __Chan_writer__ chan ,(wc)
  num "4" ,(four)
  num "7" ,(seven)
  num "20" ,(twenty)
  __VProc_start__ (,() write_n wa "a" seven) ,(va)
  __VProc_start__ (,() write_n wb "b" twenty) ,(vb)
  __VProc_start__ (,() write_n wc "c" four) ,(vc)
  __Chan_reader__ chan ,(reader)
  drain reader ,(items)
  __LList_length__ items ,(n)
  __Number_toString__ n ,(ns)
  __String_concat__ "count: " ns ,(line)
  println line ,()
  only items "a" ,(as) join as ,(s) println s ,()
  only items "b" ,(bs) join bs ,(s) println s ,()
  only items "c" ,(cs) join cs ,(s) println s ,()
  __VProc_wait__ __print_exit_error__ va ,()
  __VProc_wait__ __print_exit_error__ vb ,()
  __VProc_wait__ __print_exit_error__ vc)

;; case3：書き手が後から鎖を加える。最初の書き手の VProc が、読み始めた後に 2 つ目の書き手を作り、両方に書いて閉じる。
;; 読み手は、両方が閉じてから終わる（20 個は、16 個ごとに新しい鎖を探すのを越える）
(define case3 ,()
  num "2" ,(cap)
  __Chan_new__ cap __NULL__ ,(chan)
  __Chan_writer__ chan ,(wa)
  num "20" ,(twenty)
  num "3" ,(three)
  num "1" ,(one)
  __VProc_start__ (,()
    write_from wa "a" one three ,()
    __Chan_of__ wa ,(c)
    __Chan_writer__ c ,(wb)
    __VProc_start__ (,() write_n wb "b" twenty) ,(vb)
    num "4" ,(four)
    write_from wa "a" four twenty ,()
    __Chan_close__ wa ,()
    __Chan_close__ wa ,()
    __VProc_wait__ __print_exit_error__ vb) ,(va)
  __Chan_reader__ chan ,(reader)
  drain reader ,(items)
  __LList_length__ items ,(n)
  __Number_toString__ n ,(ns)
  __String_concat__ "count: " ns ,(line)
  println line ,()
  only items "a" ,(as) join as ,(s) println s ,()
  only items "b" ,(bs) join bs ,(s) println s ,()
  __VProc_wait__ __print_exit_error__ va)

;; 止めるまで書き続ける。cancel されたら onCancelled で、書いた数を出して終わる
(define write_forever ,(writer i)
  __Cont_get__ ,(return)
  __Number_toString__ i ,(s)
  __String_concat__ "x" s ,(item)
  __Chan_put__ (,() println "writer: cancelled" ,() return) writer item ,()
  num "1" ,(one)
  __Number_add__ i one ,(i)
  write_forever writer i)

;; case4：読み手が 3 つ取り出して cancel する。待っている書き手が起き、onCancelled を呼ぶ
(define case4 ,()
  num "2" ,(cap)
  __Chan_new__ cap __NULL__ ,(chan)
  __Chan_writer__ chan ,(writer)
  num "1" ,(one)
  __VProc_start__ (,() write_forever writer one ,() __Chan_close__ writer) ,(vp)
  __Chan_reader__ chan ,(reader)
  __Chan_take__ reader ,(x1 f1)
  __Chan_take__ reader ,(x2 f2)
  __Chan_take__ reader ,(x3 f3)
  __String_concat__ x1 " " ,(s) __String_concat__ s x2 ,(s) __String_concat__ s " " ,(s) __String_concat__ s x3 ,(s)
  println s ,()
  __Chan_cancel__ chan ,()
  __VProc_wait__ __print_exit_error__ vp ,()
  println "reader: done")

;; case5：状態の Ref。書き手が一杯で待つと "blocked"、起きると "running"
(define case5 ,()
  __Ref_new__ "running" ,(state)
  num "1" ,(cap)
  __Chan_new__ cap state ,(chan)
  __Chan_writer__ chan ,(writer)
  num "3" ,(three)
  __Ref_get__ state ,(running)
  __VProc_start__ (,() write_n writer "s" three) ,(vp)
  __Ref_wait_change__ state running ,()
  __Ref_get__ state ,(s)
  __String_concat__ "state: " s ,(line)
  println line ,()
  __Chan_reader__ chan ,(reader)
  drain reader ,(items)
  join items ,(s)
  println s ,()
  __VProc_wait__ __print_exit_error__ vp ,()
  __Ref_get__ state ,(s)
  __String_concat__ "state: " s ,(line)
  println line)

;; case6：書かずに閉じた書き手と、書き手のないチャネル。どちらもすぐ終わる
(define case6 ,()
  num "4" ,(cap)
  __Chan_new__ cap __NULL__ ,(chan)
  __Chan_writer__ chan ,(writer)
  __Chan_close__ writer ,()
  __Chan_reader__ chan ,(reader)
  __Chan_take__ reader ,(item found)
  __if_then_else__ found (,() println "found") (,() println "closed: end") ,()
  __Chan_new__ cap __NULL__ ,(empty)
  __Chan_reader__ empty ,(reader)
  __Chan_take__ reader ,(item found)
  __if_then_else__ found (,() println "found") (,() println "no writer: end"))
