;; 値を参照で渡すこと（docs/dev/CONJS-SHELL-PLAN.md の段階 S0。vm/src/prim/jsfn.rs）：VM がホストのオブジェクトを持ち（case1）、
;; ホストが VM の値を、呼び出しを越えて持ち続ける（case2）。wasm 版の VM だけ。ほかの VM は onError（case1.log）。
(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(text)
  __Number_fromString__ (,(e) println e) text)

;; 値の文字列：Number、"String"、(要素 ...)、() は空の LList（null）、{key 値 ...} は Dict、true と false は真偽
(define text_of ,(v)
  __Cont_get__ ,(return)
  __is_null__ v ,(isNull)
  __if__ isNull (,() return "()") ,()
  __type_name__ v ,(t)
  __String_equal__ t "Number" ,(isNum)
  __if__ isNum (,() __Number_toString__ v ,(s) return s) ,()
  __String_equal__ t "String" ,(isStr)
  __if__ isStr (,() __String_concat__ "\"" v ,(s) __String_concat__ s "\"" ,(s) return s) ,()
  __String_equal__ t "LList" ,(isList)
  __if__ isList (,() items_text v "(" ,(s) return s) ,()
  __String_equal__ t "Dict" ,(isDict)
  __if__ isDict (,() dict_text v ,(s) return s) ,()
  __String_equal__ t "Closure" ,(isClosure)
  __if__ isClosure (,() __if_then_else__ v (,() __NULL__ "true") (,() __NULL__ "false") ,(b) return b) ,()
  return t)

;; Dict の文字列：{key 値 ...}（キーは入れた順。どの VM も、その順に並べる）
(define dict_text ,(d)
  __Cont_get__ ,(return)
  __Dict_keys__ d ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  __Ref_new__ __NULL__ ,(self)
  __Ref_set__ self (,(k) __Ref_get__ acc ,(l) __LList_cons__ k l ,(l) __Ref_set__ acc l ,() __Ref_get__ self) ,()
  __Ref_get__ self ,(sink)
  keys sink ,(x)
  __Ref_get__ acc ,(rev)
  entries_text d rev "}" ,(s)
  __String_concat__ "{" s)

(define entries_text ,(d rev acc)
  __Cont_get__ ,(return)
  __is_null__ rev ,(end) __if__ end (,() return acc) ,()
  __LList_uncons__ (,(e) println e) rev ,(k rest)
  __Dict_lookup_or__ d k (,(k) println "no key") ,(v)
  text_of v ,(s)
  __String_concat__ k " " ,(e) __String_concat__ e s ,(e)
  __is_null__ rest ,(first)
  __String_equal__ acc "}" ,(last)
  __if_then_else__ last (,() __NULL__ "") (,() __NULL__ " ") ,(sep)
  __String_concat__ sep acc ,(acc)
  __String_concat__ e acc ,(acc)
  entries_text d rest acc)

(define items_text ,(v acc)
  __LList_uncons__ (,(e) println e) v ,(h rest)
  text_of h ,(s)
  __String_concat__ acc s ,(acc)
  __is_null__ rest ,(end)
  __if_then_else__ end
    (,() __String_concat__ acc ")")
    (,() __String_concat__ acc " " ,(acc) items_text rest acc))

(define fail ,(e) println e)

(define show ,(label v)
  text_of v ,(s) __String_concat__ label s ,(s) println s)

;; 1 つの値を引数にして、関数 name を呼び、値を返す
(define call1 ,(M name x)
  __LList_cons__ x __NULL__ ,(a)
  __JS_fn_call__ fail M name a ,(status v)
  __NULL__ v)

(define call0 ,(M name)
  __JS_fn_call__ fail M name __NULL__ ,(status v)
  __NULL__ v)

(define call2 ,(M name x y)
  __LList_cons__ y __NULL__ ,(a) __LList_cons__ x a ,(a)
  __JS_fn_call__ fail M name a ,(status v)
  __NULL__ v)

;; Box の箱は、参照で VM に渡る（rt.byRef）
(define js_text ,()
  __NULL__ "class Box { constructor(n) { this.n = n } }; rt.byRef(Box.prototype); let store = []; return {" ,(t)
  __String_concat__ t "make(n) { return new Box(n) }, get(b) { return b.n }, inc(b) { b.n++; return b.n }," ,(t)
  __String_concat__ t "same(a, b) { return a === b }, isBox(b) { return b instanceof Box }, holder() { return { box: new Box(9) } }," ,(t)
  __String_concat__ t "count() { return rt.hostObjCount() }," ,(t)
  __String_concat__ t "keepIt(v) { store.push(rt.keep(v)); return store.length }, at(i) { return store[i] }, kept() { return rt.keptCount() }," ,(t)
  __String_concat__ t "change(i) { const d = store[i]; return d instanceof rt.VmKept }," ,(t)
  __String_concat__ t "}")

;; 箱を作って、捨てる
(define throwaway ,(M)
  num "5" ,(n5) call1 M "make" n5 ,(b)
  __NULL__ "dropped")

;; VM がホストのオブジェクトを持つ
(define case1 ,()
  __Cont_get__ ,(return)
  js_text ,(text)
  __JS_fn_compile__ (,(e) println e ,() return) text ,(M)
  num "1" ,(n1) call1 M "make" n1 ,(b)
  __type_name__ b ,(t) show "type: " t ,()
  call1 M "inc" b ,(x) show "inc: " x ,()
  call1 M "inc" b ,(x) show "inc: " x ,()
  call1 M "get" b ,(x) show "get (the same object across calls): " x ,()
  call1 M "isBox" b ,(x) show "instanceof Box: " x ,()
  call2 M "same" b b ,(x) show "same b b: " x ,()
  call1 M "make" n1 ,(c)
  call2 M "same" b c ,(x) show "same b c: " x ,()
  call0 M "count" ,(x) show "objects held: " x ,()
  throwaway M ,(s) show "throwaway: " s ,()
  call0 M "count" ,(x) show "objects held after one was dropped: " x ,()
  call0 M "holder" ,(h)
  __Dict_lookup_or__ h "box" (,(k) __NULL__ "none") ,(inner)
  __type_name__ inner ,(t) show "holder.box: " t ,()
  call1 M "get" inner ,(x) show "holder.box.n: " x ,()
  __NULL__)

;; ホストが VM の値を持ち続ける
(define case2 ,()
  __Cont_get__ ,(return)
  js_text ,(text)
  __JS_fn_compile__ (,(e) println e ,() return) text ,(M)
  __Dict_new__ ,(d) __Dict_put__ d "k" "first" ,()
  call1 M "keepIt" d ,(n) show "kept: " n ,()
  call1 M "keepIt" fail ,(n) show "kept: " n ,()
  call0 M "kept" ,(n) show "kept in the VM: " n ,()
  num "0" ,(n0) call1 M "change" n0 ,(x) show "a VmKept on the host: " x ,()
  call1 M "at" n0 ,(e)
  ;; 返ってきたのは d そのもの：e を変えると d が変わる
  __Dict_put__ e "k" "changed through the kept value" ,()
  __Dict_lookup_or__ d "k" (,(k) __NULL__ "none") ,(x) show "d.k: " x ,()
  num "1" ,(n1) call1 M "at" n1 ,(f)
  f "the kept closure, called" ,()
  __NULL__)
