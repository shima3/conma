;; 高速版 ConMa の機能 "wasm"（consh/SJS-WASM-PLAN-ja.md の段階 1、docs/PRIMITIVES.md の 16）：
;; __Wasm_compile__ onError wat ,(module) と __Wasm_call__ onError module name args fuel ,(status value)。
;; wasm 版の VM（consh/js。Node.js）はホストの WebAssembly で動かす。ネイティブの VM は WAT を組み立ててから onError に
;; 進み（組み立ての誤りはそのメッセージ）、Python の VM は代わりの定義（include/ref/wasm.se）で onError に進む。
;; ConMa の文字列は改行を含められないので、WAT は 1 行ずつの文字列を Cat でつなぐ
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(text)
  __Number_fromString__ __print_exit_error__ text)

;; 数の文字列。-0 は "-0"
(define show_num ,(n)
  __Number_is_negative_zero__ n ,(nz)
  __if_then_else__ nz (,() __NULL__ "-0") (,() __Number_toString__ n))

;; label と、__Wasm_call__ の結果（status と値）か、onError のメッセージを出す
(define try_call ,(label w name args fuel)
  __Cont_get__ ,(return)
  __String_concat__ label ": " ,(head)
  __Wasm_call__ (,(msg) __String_concat__ head msg ,(s) println s ,() return) w name args fuel ,(status value)
  __String_concat__ head status ,(s)
  __String_equal__ status "ok" ,(ok)
  __String_equal__ status "trap" ,(trap)
  __if_then_else__ ok
    (,() show_num value ,(t) Cat3 s " " t)
    (,() __if_then_else__ trap (,() Cat3 s " " value) (,() __NULL__ s)) ,(s)
  println s)

;; wat からモジュールを作って k に渡す。作れなければ、メッセージを出して戻る
(define with_module ,(wat k)
  __Cont_get__ ,(return)
  __Wasm_compile__ (,(msg) println msg ,() return) wat ,(w)
  k w)

;; wat を作れるか。作れなければメッセージを、作れれば "compiled" を出す
(define try_compile ,(label wat)
  __Cont_get__ ,(return)
  __String_concat__ label ": " ,(head)
  __Wasm_compile__ (,(msg) __String_concat__ head msg ,(s) println s ,() return) wat ,(w)
  __String_concat__ head "compiled" ,(s)
  println s)

;; 文字列をつなぐ
(define Cat ,(a b) __String_concat__ a b)
(define Cat3 ,(a b c) __String_concat__ a b ,(ab) __String_concat__ ab c)
(define Cat5 ,(a b c d e) Cat3 a b c ,(abc) Cat3 abc d e)

(define list1 ,(a) __LList_cons__ a __NULL__)
(define list2 ,(a b) __LList_cons__ b __NULL__ ,(t) __LList_cons__ a t)
(define list3 ,(a b c) list2 b c ,(t) __LList_cons__ a t)

(define big_fuel ,() num "1000000000")

;; 数の関数の部品：畳んだ形と平らな形、名前と番号、ラベル、i32 と i64、定数
(define module1 ,()
  Cat5 "(module "
    "(func $fib (export \"fib\") (param $n f64) (result f64) (if (result f64) (f64.lt (local.get $n) (f64.const 2)) (then (local.get $n)) (else (f64.add (call $fib (f64.sub (local.get $n) (f64.const 1))) (call $fib (f64.sub (local.get $n) (f64.const 2))))))) "
    "(func (export \"sum\") (param $n f64) (result f64) (local $i f64) (local $s f64) block $done loop $next local.get $i local.get $n f64.ge br_if $done local.get $i f64.const 1 f64.add local.tee $i local.get $s f64.add local.set $s br $next end end local.get $s) "
    "(func (export \"xor\") (param f64 f64) (result f64) (f64.convert_i32_s (i32.xor (i32.trunc_sat_f64_s (local.get 0)) (i32.trunc_sat_f64_s (local.get 1))))) (func (export \"three\") (param f64 f64 f64) (result f64) (f64.add (f64.mul (local.get 0) (local.get 1)) (local.get 2))) "
    "(func (export \"negzero\") (result f64) (f64.neg (f64.const 0))) (func (export \"neginf\") (result f64) (f64.const -inf)) (func (export \"nan\") (result f64) (f64.const nan)) (func (export \"big\") (result f64) (f64.convert_i64_u (i64.const 0xffffffffffffffff))) (func (export \"tenth\") (result f64) f64.const 0.1 (; a block comment ;) f64.const 1e-1 f64.eq f64.convert_i32_u) ;; a comment\n)")

;; case1: 作って呼ぶ
(define case1 ,()
  module1 ,(wat)
  with_module wat (,(w)
    big_fuel ,(fuel)
    __type_name__ w ,(t) println t ,()
    num "20" ,(n20) list1 n20 ,(a) try_call "fib 20" w "fib" a fuel ,()
    num "100" ,(n100) list1 n100 ,(a) try_call "sum 100" w "sum" a fuel ,()
    num "5" ,(n5) num "3" ,(n3) list2 n5 n3 ,(a) try_call "xor 5 3" w "xor" a fuel ,()
    num "-7.9" ,(m) list2 m n3 ,(a) try_call "xor -7.9 3" w "xor" a fuel ,()
    num "2" ,(n2) num "4" ,(n4) list3 n2 n3 n4 ,(a) try_call "three 2 3 4" w "three" a fuel ,()
    try_call "negzero" w "negzero" __NULL__ fuel ,()
    try_call "neginf" w "neginf" __NULL__ fuel ,()
    try_call "nan" w "nan" __NULL__ fuel ,()
    try_call "big" w "big" __NULL__ fuel ,()
    try_call "tenth" w "tenth" __NULL__ fuel))

;; 燃料が足りるまで、2 倍にしてやり直す（consh/SJS-WASM-PLAN-ja.md の 5.5）。やり直した回数と結果を出す
(define retry ,(w name args fuel count)
  __Wasm_call__ __print_exit_error__ w name args fuel ,(status value)
  __String_equal__ status "fuel" ,(again)
  __if_then_else__ again
    (,() __Number_add__ fuel fuel ,(f) num "1" ,(one) __Number_add__ count one ,(c) retry w name args f c)
    (,() __Number_toString__ count ,(cs) show_num value ,(vs) Cat5 status " " vs " after " cs ,(s) Cat s " times out of fuel" ,(s) println s))

;; case2: 燃料：終わらないループ、足りない燃料、やり直し
(define case2 ,()
  Cat3 "(module (func (export \"spin\") (result f64) loop $l br $l end f64.const 0) " "(func $fib (export \"fib\") (param $n f64) (result f64) (if (result f64) (f64.lt (local.get $n) (f64.const 2)) (then (local.get $n)) (else (f64.add (call $fib (f64.sub (local.get $n) (f64.const 1))) (call $fib (f64.sub (local.get $n) (f64.const 2)))))))" ")" ,(wat)
  with_module wat (,(w)
    num "100000" ,(fuel)
    try_call "spin" w "spin" __NULL__ fuel ,()
    num "25" ,(n25) list1 n25 ,(a)
    num "100" ,(small) try_call "fib 25 with 100" w "fib" a small ,()
    num "0" ,(zero) retry w "fib" a small zero))

;; case3: trap（メッセージは Node.js のもの）
(define case3 ,()
  Cat3 "(module (func (export \"stop\") (result f64) unreachable) " "(func (export \"div\") (param f64 f64) (result f64) (f64.convert_i32_s (i32.div_s (i32.trunc_f64_s (local.get 0)) (i32.trunc_f64_s (local.get 1))))) (func (export \"int\") (param f64) (result f64) (f64.convert_i32_s (i32.trunc_f64_s (local.get 0))))" ")" ,(wat)
  with_module wat (,(w)
    big_fuel ,(fuel)
    try_call "stop" w "stop" __NULL__ fuel ,()
    num "7" ,(n7) num "0" ,(n0) list2 n7 n0 ,(a) try_call "div 7 0" w "div" a fuel ,()
    num "-7" ,(m7) num "2" ,(n2) list2 m7 n2 ,(a) try_call "div -7 2" w "div" a fuel ,()
    num "1e300" ,(huge) list1 huge ,(a) try_call "int 1e300" w "int" a fuel))

;; case4: __Wasm_call__ の誤った引数
(define case4 ,()
  with_module "(module (func (export \"id\") (param f64) (result f64) local.get 0))" (,(w)
    big_fuel ,(fuel)
    num "1" ,(one) list1 one ,(a)
    try_call "not a module" "w" "id" a fuel ,()
    try_call "name" w one a fuel ,()
    try_call "args" w "id" "1" fuel ,()
    list1 "1" ,(sa) try_call "element" w "id" sa fuel ,()
    try_call "fuel string" w "id" a "1" ,()
    num "0" ,(zero) try_call "fuel 0" w "id" a zero ,()
    num "1.5" ,(half) try_call "fuel 1.5" w "id" a half ,()
    num "1e300" ,(huge) try_call "fuel 1e300" w "id" a huge ,()
    try_call "unknown" w "di" a fuel ,()
    try_call "too few" w "id" __NULL__ fuel ,()
    list2 one one ,(b) try_call "too many" w "id" b fuel ,()
    try_call "fuel 1" w "id" a one))

;; case5: アセンブラが受け付けない WAT（ネイティブの VM と wasm 版の VM で同じメッセージ）
(define case5 ,()
  num "1" ,(one)
  try_compile "not a String" one ,()
  try_compile "empty" "" ,()
  try_compile "not a module" "(func)" ,()
  try_compile "two modules" "(module) (module)" ,()
  try_compile "import" "(module (import \"m\" \"f\" (func)))" ,()
  try_compile "memory" "(module (memory 1))" ,()
  try_compile "global" "(module (global $g (mut f64) (f64.const 0)))" ,()
  try_compile "start" "(module (start 0))" ,()
  try_compile "param i32" "(module (func (param i32) (result f64) f64.const 0))" ,()
  try_compile "no result" "(module (func (param f64)))" ,()
  try_compile "two results" "(module (func (result f64) (result f64) f64.const 0))" ,()
  try_compile "result i32" "(module (func (result i32) i32.const 0))" ,()
  try_compile "order" "(module (func (result f64) (param f64) f64.const 0))" ,()
  try_compile "reserved export" "(module (func (export \"__fuel\") (result f64) f64.const 0))" ,()
  try_compile "export twice" "(module (func (export \"f\") (result f64) f64.const 0) (func (export \"f\") (result f64) f64.const 1))" ,()
  try_compile "unknown instruction" "(module (func (result f64) f32.const 0))" ,()
  try_compile "memory instruction" "(module (func (result f64) i32.const 0 f64.load))" ,()
  try_compile "unknown local" "(module (func (param $x f64) (result f64) local.get $y))" ,()
  try_compile "local index" "(module (func (param f64) (result f64) local.get 1))" ,()
  try_compile "unknown label" "(module (func (result f64) block br $out end f64.const 0))" ,()
  try_compile "unknown function" "(module (func (result f64) call $g))" ,()
  try_compile "bad number" "(module (func (result f64) f64.const 0x10))" ,()
  try_compile "i32 range" "(module (func (result f64) i32.const 4294967296 drop f64.const 0))" ,()
  try_compile "no end" "(module (func (result f64) block f64.const 0))" ,()
  try_compile "unclosed" "(module (func (result f64) f64.const 0)" ,()
  try_compile "extra )" "(module))" ,()
  try_compile "string" "(module (func (export \"f) (result f64) f64.const 0))" ,()
  try_compile "fine" "(module (func (export \"f\") (result f64) f64.const 0))")

;; case6: ホストが型を確かめる（メッセージは Node.js のもの）
(define case6 ,()
  try_compile "type" "(module (func (export \"f\") (result f64) i32.const 1))" ,()
  try_compile "stack" "(module (func (export \"f\") (result f64) f64.add))")

;; case7：燃料を使い切ると時間の区切りが終わるので、終わらない関数を呼び続けても、ホストが SIGINT を受け取る
;; （__OS_trap_interrupt__ の Ref が変わる。consh/SJS-WASM-PLAN-ja.md の段階 3）。呼んだ回数は時間で変わるので出さない
(define spin_until ,(w ref fuel)
  __Ref_get__ ref ,(r)
  __Number_is_zero__ r ,(go)
  __if_then_else__ go
    (,() __Wasm_call__ __print_exit_error__ w "spin" __NULL__ fuel ,(status value) spin_until w ref fuel)
    (,() println "interrupted"))

(define case7 ,()
  with_module "(module (func (export \"spin\") (result f64) loop $l br $l end f64.const 0))" (,(w)
    num "0" ,(zero)
    __Ref_new__ zero ,(ref)
    __OS_trap_interrupt__ ref ,()
    num "10000000" ,(fuel)
    __MSeq_new__ ,(cmd)
    __MSeq_append__ __print_exit_error__ cmd "sh" ,()
    __MSeq_append__ __print_exit_error__ cmd "-c" ,()
    __MSeq_append__ __print_exit_error__ cmd "sleep 1; kill -INT $PPID" ,()
    __OS_get_envDict__ ,(env)
    __OS_spawn__ __print_exit_error__ cmd __NULL__ __NULL__ __NULL__ env ,(proc)
    spin_until w ref fuel))

;; case8：モジュールのメモリと __Wasm_call_memory__（consh/SJS-WASM-ARRAY-PLAN-ja.md の段階 A1）。メモリは呼ぶたびに 0 で埋め、
;; __Wasm_call_memory__ の語を先頭から書き、"ok" なら同じ数の語を返す

;; 数の LList を "a b c" の形にする
(define show_list ,(l acc)
  __Cont_get__ ,(return)
  __is_null__ l ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ l ,(x rest)
  show_num x ,(t)
  __String_equal__ acc "" ,(first)
  __if_then_else__ first (,() __NULL__ t) (,() Cat3 acc " " t) ,(acc)
  show_list rest acc)

;; __Wasm_call_memory__ の結果を出す
(define try_memory ,(label w name args memory fuel)
  __Cont_get__ ,(return)
  __String_concat__ label ": " ,(head)
  __Wasm_call_memory__ (,(msg) __String_concat__ head msg ,(s) println s ,() return) w name args memory fuel ,(status value words)
  __String_concat__ head status ,(s)
  __String_equal__ status "ok" ,(ok)
  __String_equal__ status "trap" ,(trap)
  __if_then_else__ ok
    (,() show_num value ,(t) show_list words "" ,(ws) Cat5 s " " t " [" ws ,(s) __String_concat__ s "]")
    (,() __if_then_else__ trap (,() Cat3 s " " value) (,() __NULL__ s)) ,(s)
  println s)

;; n 個の数 1, 2, ... の LList
(define count_list ,(n acc)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(test__) __if__ test__ (,() return acc) ,()
  __LList_cons__ n acc ,(acc)
  num "1" ,(one)
  __Number_subtract__ n one ,(m)
  count_list m acc)

(define module8 ,()
  Cat5 "(module (memory 1) "
    "(func (export \"sum\") (param $n f64) (result f64) (local $i f64) (local $s f64) block $done loop $next local.get $i local.get $n f64.ge br_if $done (local.set $s (f64.add (local.get $s) (f64.load (i32.mul (i32.trunc_f64_u (local.get $i)) (i32.const 8))))) (local.set $i (f64.add (local.get $i) (f64.const 1))) br $next end end local.get $s) "
    "(func (export \"double\") (param $n f64) (result f64) (local $i f64) block $done loop $next local.get $i local.get $n f64.ge br_if $done (f64.store (i32.mul (i32.trunc_f64_u (local.get $i)) (i32.const 8)) (f64.mul (f64.const 2) (f64.load (i32.mul (i32.trunc_f64_u (local.get $i)) (i32.const 8))))) (local.set $i (f64.add (local.get $i) (f64.const 1))) br $next end end f64.const 0) "
    "(func (export \"peek\") (param $a f64) (result f64) (f64.load offset=0 align=8 (i32.trunc_f64_u (local.get $a)))) (func (export \"poke\") (param $a f64) (param $v f64) (result f64) (local.get $a) i32.trunc_f64_u (local.get $v) f64.store offset=8 (f64.const 0)) "
    "(func (export \"pages\") (result f64) (f64.convert_i32_u (memory.size))) (func (export \"grow\") (param $n f64) (result f64) (f64.convert_i32_s (memory.grow (i32.trunc_f64_u (local.get $n))))))")

(define case8 ,()
  module8 ,(wat)
  with_module wat (,(w)
    big_fuel ,(fuel)
    num "3" ,(n3) list1 n3 ,(a3)
    num "1" ,(one) num "2" ,(two) num "1.5" ,(onehalf) num "-0" ,(nz)
    list3 one two onehalf ,(mem)
    try_memory "sum" w "sum" a3 mem fuel ,()
    try_memory "double" w "double" a3 mem fuel ,()
    ;; 前の呼び出しの語は残らない（0 で埋める）
    num "0" ,(zero) list1 zero ,(a0)
    try_call "peek after" w "peek" a0 fuel ,()
    list1 nz ,(memz) try_memory "peek -0" w "peek" a0 memz fuel ,()
    ;; poke は offset=8 で 2 つ目の語に書く
    num "77" ,(v77) list2 zero v77 ,(pa) list2 zero zero ,(two0) try_memory "poke" w "poke" pa two0 fuel ,()
    try_memory "no words" w "pages" __NULL__ __NULL__ fuel ,()
    ;; 1 ページ（8192 語）より多い語は、ホストがメモリを広げて書く
    num "10000" ,(n10000) count_list n10000 __NULL__ ,(big) list1 n10000 ,(a10000)
    __Wasm_call_memory__ __print_exit_error__ w "sum" a10000 big fuel ,(status value words)
    show_num value ,(t) Cat3 "sum 10000: " status " " ,(s) __String_concat__ s t ,(s) println s ,()
    try_call "pages after" w "pages" __NULL__ fuel ,()
    try_call "grow" w "grow" a3 fuel ,()
    ;; メモリの外は trap
    num "1e9" ,(far) list1 far ,(afar) try_call "peek far" w "peek" afar fuel ,()
    ;; 誤った引数
    try_memory "memory string" w "sum" a3 "x" fuel ,()
    list1 "x" ,(sx) try_memory "memory element" w "sum" a3 sx fuel ,()
    with_module "(module (func (export \"f\") (result f64) f64.const 1))" (,(w2)
      try_memory "no memory" w2 "f" __NULL__ __NULL__ fuel)) ,()
  ;; アセンブラが受け付けないメモリ
  try_compile "two memories" "(module (memory 1) (memory 1))" ,()
  try_compile "memory import" "(module (memory (import \"m\" \"m\") 1))" ,()
  try_compile "memory export" "(module (memory (export \"m\") 1))" ,()
  try_compile "memory max" "(module (memory 2 1))" ,()
  try_compile "reserved memory export" "(module (memory 1) (func (export \"__memory\") (result f64) f64.const 0))" ,()
  try_compile "bad align" "(module (memory 1) (func (result f64) i32.const 0 f64.load align=16))" ,()
  try_compile "bad offset" "(module (memory 1) (func (result f64) i32.const 0 f64.load offset=x))" ,()
  try_compile "fine" "(module (memory 0 1) (func (export \"f\") (result f64) (f64.load (i32.const 0))))")


;; case9：アセンブラが止まらなかった WAT と、深すぎる入れ子（REVIEW-ja.md の 2026-11-14（2）の 1 と 6）。コメントを始めない
;; ; は誤り（前は止まらなかった）。リスト、block、folded の命令の入れ子は 10000 段まで（前は、wasm 版の VM がホストの
;; スタックを使い切って落ちた）

;; s を n 回つなぐ（倍々につなぐ）
(define repeat ,(s n)
  __Cont_get__ ,(return)
  __Number_is_zero__ n ,(z) __if__ z (,() return "") ,()
  num "2" ,(two)
  __Number_divide__ __print_exit_error__ n two ,(h)
  __Number_floor__ h ,(half)
  repeat s half ,(r)
  __String_concat__ r r ,(rr)
  __Number_multiply__ half two ,(even)
  __Number_subtract__ n even ,(odd)
  __Number_is_zero__ odd ,(isEven)
  __if_then_else__ isEven (,() __NULL__ rr) (,() __String_concat__ rr s))

;; f64.neg を n 段重ねた folded の命令の関数
(define deep_folded ,(n)
  repeat "(f64.neg " n ,(open)
  repeat ")" n ,(close)
  Cat5 "(module (func (export \"f\") (result f64) " open "(f64.const 1)" close "))")

;; block を n 段重ねた（括弧のない）関数
(define deep_blocks ,(n)
  repeat "block " n ,(open)
  repeat "end " n ,(close)
  Cat5 "(module (func (export \"f\") (result f64) " open "" close "f64.const 1))")

(define case9 ,()
  try_compile "lone ;" "(module ;)" ,()
  try_compile "; in an atom" "(module (func (export \"f\") (result f64) f64.const 1;2))" ,()
  try_compile ";; comment" "(module (func (export \"f\") (result f64) f64.const 1 ;; one\n))" ,()
  num "9990" ,(inside)
  num "10000" ,(limit)
  num "10001" ,(over)
  num "30000" ,(far)
  ;; リストは module と func の分も数えるので、folded の命令は 9990 段まで
  deep_folded inside ,(w) try_compile "folded 9990" w ,()
  deep_folded over ,(w) try_compile "folded 10001" w ,()
  deep_folded far ,(w) try_compile "folded 30000" w ,()
  deep_blocks limit ,(w) try_compile "blocks 10000" w ,()
  deep_blocks over ,(w) try_compile "blocks 10001" w ,()
  repeat "(" far ,(open) Cat "(module " open ,(w) try_compile "lists 30000" w)

;; case10：アセンブラが受け付けていた正しくない WAT と、拒んでいた正しい WAT（REVIEW-ja.md の 2026-11-14（2）の 8）。
;; end と else の後のラベルは、その block のラベル。_ は数字と数字の間だけ。0x の後は 16 進の数字だけ。番号に符号は付けない
(define body ,(code)
  Cat3 "(module (func (export \"f\") (param f64) (result f64) " code "))")

(define case10 ,()
  body "block $a nop end $b f64.const 0" ,(w) try_compile "end $b after block $a" w ,()
  body "block nop end $b f64.const 0" ,(w) try_compile "end $b after block" w ,()
  body "block $a nop end $a f64.const 0" ,(w) try_compile "end $a" w ,()
  body "i32.const 1 if $t nop else $t nop end $t f64.const 0" ,(w) try_compile "else $t" w ,()
  body "i32.const 1 if $t nop else $u nop end f64.const 0" ,(w) try_compile "else $u" w ,()
  body "i32.const 0x-1 drop f64.const 0" ,(w) try_compile "0x-1" w ,()
  body "i32.const -0xff_ff drop f64.const 0" ,(w) try_compile "-0xff_ff" w ,()
  body "local.get +0" ,(w) try_compile "local.get +0" w ,()
  body "local.get 0" ,(w) try_compile "local.get 0" w ,()
  body "i32.const 1__0 drop f64.const 0" ,(w) try_compile "1__0" w ,()
  body "i32.const _1 drop f64.const 0" ,(w) try_compile "_1" w ,()
  body "i32.const 1_ drop f64.const 0" ,(w) try_compile "1_" w ,()
  body "i32.const 1_000 drop f64.const 0" ,(w) try_compile "1_000" w ,()
  body "f64.const 1__5" ,(w) try_compile "f64 1__5" w ,()
  body "f64.const 1_5.2_5" ,(w) try_compile "f64 1_5.2_5" w ,()
  body "block br +0 end f64.const 0" ,(w) try_compile "br +0" w)

;; case11：メモリの max に入らない語は、trap でなく onError（REVIEW-ja.md の 2026-11-14（2）の 8）。(memory 0 1) は 1 ページ、
;; 8192 語まで。max のないメモリは 65536 ページまで

;; __Wasm_call_memory__ の状態と値（語は出さない）
(define try_fit ,(label w memory fuel)
  __Cont_get__ ,(return)
  __String_concat__ label ": " ,(head)
  __Wasm_call_memory__ (,(msg) __String_concat__ head msg ,(s) println s ,() return) w "pages" __NULL__ memory fuel ,(status value words)
  show_num value ,(t)
  Cat3 head status " " ,(s)
  __String_concat__ s t ,(s)
  println s)

(define case11 ,()
  with_module "(module (memory 0 1) (func (export \"pages\") (result f64) (f64.convert_i32_u (memory.size))))" (,(w)
    big_fuel ,(fuel)
    num "8192" ,(n8192) count_list n8192 __NULL__ ,(fits)
    try_fit "8192 words" w fits fuel ,()
    num "8193" ,(n8193) count_list n8193 __NULL__ ,(over)
    try_fit "8193 words" w over fuel) ,()
  with_module "(module (memory 0) (func (export \"pages\") (result f64) (f64.convert_i32_u (memory.size))))" (,(w)
    big_fuel ,(fuel)
    num "8193" ,(n8193) count_list n8193 __NULL__ ,(more)
    try_fit "no max, 8193 words" w more fuel))

;; case12：__Dict_numbers__ と __Dict_put_numbers__（consh/SJS-WASM-ARRAY-PLAN-ja.md の 17。機能 "wasm" だが WebAssembly は使わないので、
;; どの VM でも同じ。Python の VM は include/ref/wasm.se の代わりの定義）
(define case12 ,()
  __Dict_new__ ,(d)
  num "1" ,(n1) num "2.5" ,(n25) num "-0" ,(nz) num "3" ,(n3) num "0" ,(n0) num "2" ,(n2) num "4" ,(n4)
  __Dict_put__ d "0" n1 ,() __Dict_put__ d "1" n25 ,() __Dict_put__ d "2" nz ,() __Dict_put__ d "x" "skip" ,()
  ;; 値を、"2" が先頭になるように積む
  __Dict_numbers__ (,(m) println m ,() __NULL__ __NULL__) d n3 __NULL__ ,(l3) show_list l3 "" ,(s) Cat "numbers 3: " s ,(s) println s ,()
  __LList_cons__ n4 __NULL__ ,(tail) __Dict_numbers__ (,(m) println m ,() __NULL__ __NULL__) d n2 tail ,(l2) show_list l2 "" ,(s) Cat "numbers 2 onto (4): " s ,(s) println s ,()
  __Dict_numbers__ (,(m) println m ,() __NULL__ __NULL__) d n0 __NULL__ ,(l0) show_list l0 "" ,(s) Cat "numbers 0: [" s ,(s) Cat s "]" ,(s) println s ,()
  ;; ない、数でない
  __Dict_numbers__ (,(m) Cat "missing: " m ,(s) println s ,() __NULL__ __NULL__) d n4 __NULL__ ,(r) __nop__ ,()
  __Dict_put__ d "3" "three" ,() __Dict_numbers__ (,(m) Cat "string: " m ,(s) println s ,() __NULL__ __NULL__) d n4 __NULL__ ,(r) __nop__ ,()
  ;; 書く：先頭の 3 つを "0"〜"2" に入れ、残りを返す（新しい Dict ならキーを足す。0 個なら何もしない）
  num "7" ,(n7) num "8" ,(n8) num "9" ,(n9) num "10" ,(n10)
  list3 n8 n9 n10 ,(rest3) __LList_cons__ n7 rest3 ,(ws)
  __Dict_put_numbers__ d n3 ws ,(rest) show_list rest "" ,(s) Cat "rest: " s ,(s) println s ,()
  __Dict_numbers__ (,(m) println m ,() __NULL__ __NULL__) d n3 __NULL__ ,(l3b) show_list l3b "" ,(s) Cat "after put: " s ,(s) println s ,()
  __Dict_new__ ,(e) num "6" ,(n6) __Dict_put_numbers__ e n2 ws ,(rest2) __Dict_numbers__ (,(m) println m ,() __NULL__ __NULL__) e n2 __NULL__ ,(le) show_list le "" ,(s) Cat "new dict: " s ,(s) println s ,()
  __Dict_put_numbers__ e n0 ws ,(same) show_list same "" ,(s) Cat "put 0 keeps: " s ,(s) println s)

;; case13：呼び出しは前の呼び出しの memory.grow と語の数によらない（REVIEW-ja.md の 2026-11-14（2）の 5）。メモリの大きさは、
;; 呼ぶたびに、モジュールの大きさか語に要る大きさ。燃料が切れた後で 2 倍の燃料でやり直しても、同じ結果
(define module13 ,()
  Cat5 "(module (memory 1 2) "
    "(func (export \"grow\") (param $n f64) (result f64) (local $r f64) (local.set $r (f64.convert_i32_s (memory.grow (i32.const 1)))) block $done loop $next local.get $n f64.const 0 f64.le br_if $done (local.set $n (f64.sub (local.get $n) (f64.const 1))) br $next end end local.get $r) "
    "(func (export \"pages\") (result f64) (f64.convert_i32_u (memory.size)))"
    ")" "")

(define case13 ,()
  module13 ,(wat)
  with_module wat (,(w)
    big_fuel ,(fuel)
    num "1000" ,(n) list1 n ,(a)
    try_call "grow" w "grow" a fuel ,()
    try_call "grow again" w "grow" a fuel ,()
    num "10" ,(little)
    try_call "grow, little fuel" w "grow" a little ,()
    try_call "grow, more fuel" w "grow" a fuel ,()
    try_call "pages" w "pages" __NULL__ fuel ,()
    num "9000" ,(n9000) count_list n9000 __NULL__ ,(many)
    try_fit "9000 words" w many fuel ,()
    try_call "pages after" w "pages" __NULL__ fuel))
