;; Step26: VProc の番号、VProc を止める __VProc_kill__、インタプリタの pid、OS のプロセスにシグナルを送る __OS_kill__
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

;; エラーメッセージを標準出力に書いて続ける
(define recover ,(msg)
  println msg)

(define printNumber ,(label n)
  __Number_toString__ n ,(s)
  __println__ label s)

;; case1: 最初の VProc は 1、次に作った VProc は 2
(define case1 ,()
  __VProc_current__ ,(me)
  __VProc_id__ me ,(id)
  printNumber "current: " id ,()
  __VProc_start__ (,() __nop__) ,(child)
  __VProc_id__ child ,(id)
  printNumber "child: " id ,()
  __VProc_wait__ __print_exit_error__ child)

;; case2: Ref が変わるのを待っている VProc を止めると、その VProc を待つ VProc が起きる。止めた VProc は続きを実行しない
(define case2 ,()
  __Ref_new__ "a" ,(ref)
  __VProc_start__ (,()
    __Ref_wait_change__ ref "a" ,()
    println "not reached") ,(child)
  __VProc_start__ (,()
    __VProc_wait__ __print_exit_error__ child ,()
    println "waiter woke up") ,(waiter)
  __VProc_kill__ child ,()
  __VProc_wait__ __print_exit_error__ waiter ,()
  __Ref_set__ ref "b" ,()
  __VProc_kill__ child ,()
  println "end")

;; case3: LazyList を持ったまま止められた VProc の LazyList を評価すると、onError になる
(define case3 ,()
  __Ref_new__ __NULL__ ,(box)
  __VProc_start__ (,()
    __LazyList_hold__ ,(lazyList)
    __Ref_set__ box lazyList ,()
    __Ref_wait_change__ box lazyList ,()
    println "not reached") ,(holder)
  __Ref_wait_change__ box __NULL__ ,()
  __Ref_get__ box ,(lazyList)
  __VProc_start__ (,() claimOnce lazyList) ,(reader)
  __VProc_kill__ holder ,()
  __VProc_wait__ __print_exit_error__ reader ,()
  println "end")

;; LazyList を claim し、onError なら "claim failed" を出して戻る
(define claimOnce ,(lazyList)
  __Cont_get__ ,(return)
  __LazyList_claim__ (,(msg) println "claim failed" ,() return) lazyList ,(thunk cell)
  println "not reached")

;; case4: 自分を止めると、この後は実行しない
(define case4 ,()
  println "before" ,()
  __VProc_current__ ,(me)
  __VProc_kill__ me ,()
  println "not reached")

;; case5: __OS_getpid__ は正の数。__OS_kill__ で sleep に SIGTERM（15）を送ると、終了コードは -15
(define case5 ,()
  __OS_getpid__ ,(pid)
  __Number_is_negative__ pid ,(negative)
  __Number_is_zero__ pid ,(zero)
  __or__ negative zero ,(bad)
  __if_then_else__ (,() __NULL__ bad) (,() println "pid: bad") (,() println "pid: positive") ,()
  __MSeq_new__ ,(cmd)
  __MSeq_append__ __print_exit_error__ cmd "sleep" ,()
  __MSeq_append__ __print_exit_error__ cmd "10" ,()
  __OS_get_envDict__ ,(env)
  __OS_spawn__ __print_exit_error__ cmd __NULL__ __NULL__ __NULL__ env ,(proc)
  __Number_fromString__ __print_exit_error__ "15" ,(sigterm)
  __OS_kill__ __print_exit_error__ proc sigterm ,()
  __OS_wait__ __print_exit_error__ proc ,(code)
  printNumber "exit code: " code ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zeroSig)
  __OS_kill__ recover proc zeroSig ,()
  __OS_kill__ recover "not a process" sigterm ,()
  println "end")
