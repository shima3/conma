;; __Host_call__ onError name args ,(result)（docs/PRIMITIVES.md、docs/dev/PLATFORM-PLAN-ja.md の段階 P2）。

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(text)
  __Number_fromString__ (,(e) println e) text)

;; 値の文字列：Number、"String"、(要素 ...)、() は空の LList（null）
(define text_of ,(v)
  __Cont_get__ ,(return)
  __is_null__ v ,(isNull)
  __if__ isNull (,() return "()") ,()
  __type_name__ v ,(t)
  __String_equal__ t "Number" ,(isNum)
  __if__ isNum (,() __Number_toString__ v ,(s) return s) ,()
  __String_equal__ t "String" ,(isStr)
  __if__ isStr (,() __String_concat__ "\"" v ,(s) __String_concat__ s "\"" ,(s) return s) ,()
  __String_equal__ t "LList" ,(isList)
  __if__ isList (,() items_text v "(" ,(s) return s) ,()
  return t)

(define items_text ,(v acc)
  __LList_uncons__ (,(e) println e) v ,(h rest)
  text_of h ,(s)
  __String_concat__ acc s ,(acc)
  __is_null__ rest ,(end)
  __if_then_else__ end
    (,() __String_concat__ acc ")")
    (,() __String_concat__ acc " " ,(acc) items_text rest acc))

;; label: 結果、または label: error: メッセージ
(define try ,(label name args)
  __Cont_get__ ,(return)
  __Host_call__ (,(e) __String_concat__ label ": error: " ,(m) __String_concat__ m e ,(m) println m ,() return) name args ,(r)
  text_of r ,(s)
  __String_concat__ label ": " ,(m) __String_concat__ m s ,(m)
  println m ,()
  return)

(define feature ,(name)
  __Feature_available__ name ,(b)
  __if_then_else__ b (,() __NULL__ "yes") (,() __NULL__ "no") ,(answer)
  __String_concat__ "feature " name ,(s) __String_concat__ s ": " ,(s) __String_concat__ s answer ,(s)
  println s)

;; どの VM にもあるホストの関数（機能 "test"）と、エラー
(define case1 ,()
  feature "test" ,()
  num "1" ,(n1) num "2" ,(n2) num "3.5" ,(n3) num "-0" ,(nz)
  __LList_cons__ n3 __NULL__ ,(a) __LList_cons__ n2 a ,(a) __LList_cons__ n1 a ,(a)
  try "add 1 2 3.5" "test.add" a ,()
  try "add nothing" "test.add" __NULL__ ,()
  __LList_cons__ n1 __NULL__ ,(inner) __LList_cons__ "b" inner ,(inner)
  __LList_cons__ "" __NULL__ ,(e) __LList_cons__ inner e ,(e) __LList_cons__ nz e ,(e) __LList_cons__ "a" e ,(e)
  try "echo" "test.echo" e ,()
  __LList_cons__ __NULL__ __NULL__ ,(e) try "echo ()" "test.echo" e ,()
  __LList_cons__ "x" __NULL__ ,(a) try "add a String" "test.add" a ,()
  try "fail" "test.fail" __NULL__ ,()
  try "unknown" "test.none" __NULL__ ,()
  __Dict_new__ ,(d) __LList_cons__ d __NULL__ ,(a) try "a Dict" "test.echo" a ,()
  try "not a list" "test.echo" n1 ,()
  try "a Number name" n1 __NULL__ ,()
  __NULL__)

;; ホストの JavaScript の関数（wasm 版の VM で CONMA_HOST=host.js。ほかの VM には、その関数がない）
(define case2 ,()
  feature "demo" ,()
  num "1" ,(n1) num "2" ,(n2) num "3" ,(n3)
  __LList_cons__ n3 __NULL__ ,(a) __LList_cons__ n2 a ,(a) __LList_cons__ n1 a ,(a)
  try "sum3" "demo.sum3" a ,()
  num "-0" ,(nz) num "1e308" ,(big) __Number_multiply__ big big ,(inf) __Number_subtract__ inf inf ,(nan)
  __Number_subtract__ nz inf ,(ninf)
  __LList_cons__ "é\t\"q\"" __NULL__ ,(a) __LList_cons__ ninf a ,(a) __LList_cons__ nan a ,(a)
  __LList_cons__ inf a ,(a) __LList_cons__ nz a ,(a) __LList_cons__ __NULL__ a ,(a)
  try "echo" "demo.echo" a ,()
  try "types" "demo.types" a ,()
  try "throw" "demo.throw" __NULL__ ,()
  try "boolean" "demo.bool" __NULL__ ,()
  try "promise" "demo.promise" __NULL__ ,()
  __NULL__)
