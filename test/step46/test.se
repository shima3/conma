;; Step46：文字列の位置と長さ（docs/dev/STRING-INDEX-PLAN-ja.md の S3）。Rust 版の VM は、実行時に作った文字列に
;; 「すべて ASCII か」と文字数を覚え、つなぐ、一部を取るときに受け継ぐ。結果とエラーが、覚える前と同じこと
;; （Python 版の VM と同じこと）を、境目の値で確かめる：空の文字列、ASCII と ASCII でないもの、そのつなぎ、
;; ASCII でない文字列の ASCII の一部、範囲の外（エラーの長さ）、find、find_any、strip_suffix、fromCode。
;; case2：ASCII でない文字列で、最後に求めた位置から次の位置を求めるようにした（STRING-INDEX-PLAN-ja.md の 7）。
;; 同じ文字列の位置を、前へ、少し後ろへ、頭に近い所へ、終わりへ、範囲の外へと動かし、1 文字ずつ前から後ろへ、
;; 後ろから前へ読んでも、結果とエラーが Python 版の VM と同じこと
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

(define show_len ,(label s)
  __String_length__ s ,(n)
  __Number_toString__ n ,(t)
  __String_concat__ label ": length " ,(l)
  __String_concat__ l t ,(l)
  println l)

(define show_sub ,(label s i j)
  num i ,(i) num j ,(j)
  __String_substring__ (,(msg) __String_concat__ "error: " msg) s i j ,(r)
  __String_concat__ label ": [" ,(l)
  __String_concat__ l r ,(l)
  __String_concat__ l "]" ,(l)
  println l)

(define show_find ,(label s p i)
  num i ,(i)
  __String_find__ (,(msg) __String_concat__ "error: " msg) s p i ,(r)
  __type_name__ r ,(type)
  __String_equal__ type "Number" ,(isNum)
  __if_then_else__ isNum (,() __Number_toString__ r) (,() __is_null__ r ,(none) __if_then_else__ none (,() __NULL__ "null") (,() __NULL__ r)) ,(t)
  __String_concat__ label ": " ,(l)
  __String_concat__ l t ,(l)
  println l)

(define show_any ,(label s cs i)
  num i ,(i)
  __String_find_any__ (,(msg) __String_concat__ "error: " msg) s cs i ,(r)
  __type_name__ r ,(type)
  __String_equal__ type "Number" ,(isNum)
  __if_then_else__ isNum (,() __Number_toString__ r) (,() __is_null__ r ,(none) __if_then_else__ none (,() __NULL__ "null") (,() __NULL__ r)) ,(t)
  __String_concat__ label ": " ,(l)
  __String_concat__ l t ,(l)
  println l)

;; 実行時に作った文字列（プログラムに書いた文字列とは別の値）
(define made ,(s)
  __String_concat__ s "" ,(r)
  __NULL__ r)

(define case1 ,()
  made "" ,(e)
  show_len "empty" e ,()
  show_sub "empty 0 0" e "0" "0" ,()
  show_sub "empty 0 1" e "0" "1" ,()
  show_find "empty find" e "" "0" ,()
  made "hello world" ,(a)
  show_len "ascii" a ,()
  show_sub "ascii 6 11" a "6" "11" ,()
  show_sub "ascii 11 11" a "11" "11" ,()
  show_sub "ascii 5 12" a "5" "12" ,()
  show_sub "ascii 3 2" a "3" "2" ,()
  show_sub "ascii -1 2" a "-1" "2" ,()
  show_find "ascii find o 5" a "o" "5" ,()
  show_find "ascii find z 0" a "z" "0" ,()
  show_find "ascii find 12" a "o" "12" ,()
  show_any "ascii any wd 0" a "wd" "0" ,()
  made "日本語のtext" ,(j)
  show_len "japanese" j ,()
  show_sub "japanese 2 5" j "2" "5" ,()
  show_sub "japanese 4 8" j "4" "8" ,()
  show_sub "japanese 4 9" j "4" "9" ,()
  show_find "japanese find t 0" j "t" "0" ,()
  show_find "japanese find x 5" j "x" "5" ,()
  show_any "japanese any 語x 0" j "語x" "0" ,()
  ;; ASCII でない文字列の ASCII の一部
  num "4" ,(four) num "8" ,(eight)
  __String_substring__ __print_exit_error__ j four eight ,(part)
  show_len "japanese part" part ,()
  show_sub "japanese part 1 3" part "1" "3" ,()
  ;; つなぎ：ASCII + ASCII、ASCII + ASCII でない、ASCII でない + ASCII でない
  __String_concat__ a "!" ,(aa)
  show_len "ascii+ascii" aa ,()
  show_sub "ascii+ascii 10 12" aa "10" "12" ,()
  __String_concat__ a j ,(aj)
  show_len "ascii+japanese" aj ,()
  show_sub "ascii+japanese 10 14" aj "10" "14" ,()
  show_find "ascii+japanese find t 0" aj "t" "0" ,()
  __String_concat__ j j ,(jj)
  show_len "japanese+japanese" jj ,()
  show_sub "japanese+japanese 7 10" jj "7" "10" ,()
  ;; 長さを求めてから（覚えてから）つなぐ
  __String_length__ j ,(n)
  __String_concat__ j a ,(ja)
  show_len "japanese+ascii" ja ,()
  show_find "japanese+ascii find world 0" ja "world" "0" ,()
  ;; strip_suffix と fromCode
  __String_strip_suffix__ a "world" ,(stripped)
  show_len "strip ascii" stripped ,()
  __String_strip_suffix__ j "text" ,(js)
  show_len "strip japanese" js ,()
  show_sub "strip japanese 1 3" js "1" "3" ,()
  num "12354" ,(c1) num "65" ,(c2)
  __String_fromCode__ __print_exit_error__ c1 ,(hira)
  __String_fromCode__ __print_exit_error__ c2 ,(big)
  __String_concat__ big hira ,(two)
  show_len "fromCode A+あ" two ,()
  show_sub "fromCode A+あ 1 2" two "1" "2")

;; s の i 文字目から 1 文字ずつ、step（1 か -1）ずつ動いて読み、つないだもの（i が範囲を出たら終わり）
(define walk ,(s i step acc)
  __String_length__ s ,(n)
  __Number_is_negative__ i ,(before)
  __Number_subtract__ i n ,(d)
  __Number_is_negative__ d ,(inside)
  __not__ inside ,(after)
  __or__ before after ,(out)
  __if_then_else__ out
    (,() __NULL__ acc)
    (,()
      num "1" ,(one)
      __Number_add__ i one ,(next)
      __String_substring__ __print_exit_error__ s i next ,(c)
      __String_concat__ acc c ,(acc)
      __Number_add__ i step ,(i)
      walk s i step acc))

(define case2 ,()
  made "ab日本cd語ef、ghいろは" ,(m)
  show_len "mixed" m ,()
  show_sub "mixed 3 4" m "3" "4" ,()
  show_sub "mixed 6 9" m "6" "9" ,()
  show_sub "mixed 5 6" m "5" "6" ,()
  show_sub "mixed 0 2" m "0" "2" ,()
  show_sub "mixed 13 15" m "13" "15" ,()
  show_sub "mixed 15 15" m "15" "15" ,()
  show_sub "mixed 1 3" m "1" "3" ,()
  show_sub "mixed 15 16" m "15" "16" ,()
  show_sub "mixed 14 15" m "14" "15" ,()
  show_sub "mixed 2 16" m "2" "16" ,()
  show_sub "mixed 8 12" m "8" "12" ,()
  show_find "mixed find g 3" m "g" "3" ,()
  show_find "mixed find 語 0" m "語" "0" ,()
  show_find "mixed find 日 4" m "日" "4" ,()
  show_any "mixed any ろf 11" m "ろf" "11" ,()
  show_any "mixed any 本い 1" m "本い" "1" ,()
  show_any "mixed any x 15" m "x" "15" ,()
  show_any "mixed any x 16" m "x" "16" ,()
  show_sub "mixed 0 15" m "0" "15" ,()
  num "0" ,(zero) num "1" ,(one) num "14" ,(last) num "-1" ,(back)
  walk m zero one "" ,(forward)
  __String_concat__ "forward: " forward ,(l) println l ,()
  walk m last back "" ,(backward)
  __String_concat__ "backward: " backward ,(l) println l)
