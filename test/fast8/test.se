;; 数の定数の畳み込み（edd5945。Rust VM の module::const_fold）と、変数の多い連鎖のフレーム（9d465dc。module::frame_chain）。
;; `__Number_fromString__ onError "数" ,(x) ...` の x を、LCont の中の関数式にも入れて畳み込むが、その中に、フレームに
;; まとめた連鎖があれば畳み込まない（フレームの先の変数は、フレームを 1 つの節として数えるので）。
;; どの VM でも、畳み込んでもしなくても、同じ値を読み（REVIEW-ja.md の 2026-11-14 の 1）、onError も読む（2）。長すぎる数字は畳み込まない（3）
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define run ,(f) f)

;; case1: フレームの変数を読まない連鎖の中で、畳み込む変数を読む
(define case1 ,()
  __Number_fromString__ __print_exit_error__ "3" ,(x)
  run (,()
    __NULL__ "a" "b" "c" "d" "e" "f" "g" "h" ,(a b c d e f g h)
    __Number_toString__ x) ,(s)
  println s)

;; case2: 畳み込む変数の外の変数も、フレームの先から読む
(define case2 ,()
  __NULL__ "outer" ,(y)
  __Number_fromString__ __print_exit_error__ "4.5" ,(x)
  run (,()
    __NULL__ "a" "b" "c" "d" "e" "f" "g" "h" ,(a b c d e f g h)
    __Number_toString__ x ,(s)
    __String_concat__ y " " ,(t)
    __String_concat__ t s) ,(s)
  println s)

;; case3: フレームのない関数式の中には畳み込む（値は同じ）
(define case3 ,()
  __Number_fromString__ __print_exit_error__ "7" ,(x)
  run (,()
    __NULL__ "a" ,(a)
    __Number_toString__ x) ,(s)
  println s)

;; case4: 畳み込む所でも onError を読む。定義のない大域の名前なら、畳み込まないときと同じく、そこで止まる
(define case4 ,()
  __Number_fromString__ noSuchGlobal "1" ,(x)
  __Number_toString__ x ,(s)
  println s)

;; case5: f64 にすると無限大になる長い数字は畳み込まず、プリミティブが onError を呼ぶ（変換版のコードも同じ）
(define case5 ,()
  __Cont_get__ ,(return)
  __Number_fromString__ (,(msg) println "out of range" ,() return __NULL__) "" ,(x)
  __Number_toString__ x ,(s)
  println s)

;; case6: いろいろな書き方の数を、その場に書いた文字列から畳み込む（REVIEW-ja.md の 2026-11-14 の 6 で、テストがないとされたもの）。
;; -0 は -0 のまま、指数、小数点だけの書き方、0 になる小さすぎる数（-1e-400 は -0）。範囲の外と、数でない文字列は
;; 畳み込まず、プリミティブが onError を呼ぶ（onError の返す値は、LCont に渡る）
(define show ,(label n)
  __Number_toString__ n ,(s)
  __Number_is_negative_zero__ n ,(nz)
  nz " (-0)" "" ,(t)
  __String_concat__ label ": " ,(line)
  __String_concat__ line s ,(line)
  __String_concat__ line t ,(line)
  println line)

(define fallback ,(msg)
  println msg ,()
  __Number_fromString__ __print_exit_error__ "-1")

(define case6 ,()
  __Number_fromString__ fallback "-0" ,(a) show "-0" a ,()
  __Number_fromString__ fallback "-0.0" ,(a) show "-0.0" a ,()
  __Number_fromString__ fallback "0" ,(a) show "0" a ,()
  __Number_fromString__ fallback "+5" ,(a) show "+5" a ,()
  __Number_fromString__ fallback "1e3" ,(a) show "1e3" a ,()
  __Number_fromString__ fallback "-2.5E-3" ,(a) show "-2.5E-3" a ,()
  __Number_fromString__ fallback ".5" ,(a) show ".5" a ,()
  __Number_fromString__ fallback "5." ,(a) show "5." a ,()
  __Number_fromString__ fallback "-.25" ,(a) show "-.25" a ,()
  __Number_fromString__ fallback "1e+2" ,(a) show "1e+2" a ,()
  __Number_fromString__ fallback "1e-400" ,(a) show "1e-400" a ,()
  __Number_fromString__ fallback "-1e-400" ,(a) show "-1e-400" a ,()
  __Number_fromString__ fallback "1e400" ,(a) show "1e400" a ,()
  __Number_fromString__ fallback "1e" ,(a) show "1e" a ,()
  __Number_fromString__ fallback "." ,(a) show "." a ,()
  __Number_fromString__ fallback "" ,(a) show "empty" a ,()
  __Number_fromString__ fallback " 1" ,(a) show " 1" a)
