;; Step20: LazyList（include/util.se）
(include "util.se")

(define println ,(str)
  __OS_print__ str ,()
  __OS_print__ "\n" ,()
  )

(define num ,(str)
  __Number_fromString__ __print_exit_error__ str)

(define printBoolean ,(b)
  __if_then_else__ b (,() println "true") (,() println "false"))

;; LazyList の要素をすべて1行ずつ出力し、最後に (end) を出力する
(define printAll ,(lazyList)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() println "(end)" ,() return) lazyList ,(head tail)
  println head ,()
  printAll tail)

;; LazyList の最初の count 個の要素を1行ずつ出力する
(define printFirst ,(count lazyList)
  __Cont_get__ ,(return)
  __if_then_else__ (,() __Number_is_zero__ count) return (,()
    __LazyList_uncons__ (,() println "(end)" ,() return) lazyList ,(head tail)
    println head ,()
    num "1" ,(one)
    __Number_subtract__ count one ,(count)
    printFirst count tail))

;; n から1ずつ増える数の無限の LazyList。要素を評価するたびに eval n を出力する
(define from ,(n)
  __LazyList_new__ (,()
    __Number_toString__ n ,(str)
    __println__ "eval " str ,()
    num "1" ,(one)
    __Number_add__ n one ,(next)
    from next ,(rest)
    __LazyList_cons__ str rest))

;; xs の後に ys を続けた LazyList。xs が空になったら、サンクは ys をそのまま返す
(define append ,(xs ys)
  __LazyList_new__ (,()
    __Cont_get__ ,(return)
    __LazyList_uncons__ (,() return ys) xs ,(head tail)
    append tail ys ,(rest)
    __LazyList_cons__ head rest))

(define makeFromArgs , args
  __LazyList_fromSeq__ args)

;; case1: __LazyList_empty__、__LazyList_cons__、__LazyList_is_empty__、__LazyList_uncons__。
;; 空なら onEmpty が __LazyList_uncons__ の継続で呼ばれる。2回たどっても同じ要素
(define case1 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_is_empty__ empty ,(b)
  printBoolean b ,()
  __LazyList_cons__ "b" empty ,(lb)
  __LazyList_cons__ "a" lb ,(lab)
  __LazyList_is_empty__ lab ,(b)
  printBoolean b ,()
  __LazyList_uncons__ (,() __NULL__ "none" "-") empty ,(head tail)
  println head ,()
  __LazyList_uncons__ (,() __NULL__ "none" "-") lab ,(head tail)
  println head ,()
  printAll lab ,()
  printAll lab ,()
  __type_name__ lab ,(type)
  println type)

;; case2: サンクは最初に評価されるときに1度だけ実行される（メモ化）
(define case2 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_new__ (,()
    println "eval c" ,()
    __LazyList_cons__ "c" empty) ,(lc)
  __LazyList_new__ (,()
    println "eval b" ,()
    __LazyList_cons__ "b" lc) ,(lbc)
  println "created" ,()
  __LazyList_uncons__ __nop__ lbc ,(head tail)
  println head ,()
  printAll lbc ,()
  printAll lbc ,()
  __LazyList_is_empty__ tail ,(b)
  printBoolean b)

;; case3: 無限の LazyList は、たどった分だけ評価される。自分自身を tail に持つ循環した LazyList
(define case3 ,()
  num "1" ,(one)
  from one ,(nums)
  println "created" ,()
  num "3" ,(three)
  printFirst three nums ,()
  num "5" ,(five)
  printFirst five nums ,()
  __Ref_new__ __NULL__ ,(box)
  __LazyList_new__ (,()
    println "eval ones" ,()
    __Ref_get__ box ,(self)
    __LazyList_cons__ "1" self) ,(ones)
  __Ref_set__ box ones ,()
  printFirst three ones)

;; case4: サンクが評価されていない LazyList を返すと、それも評価する。
;; append で、空になった xs の後に ys の LazyList をそのまま続ける
(define case4 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_new__ (,()
    println "eval outer" ,()
    __LazyList_new__ (,()
      println "eval inner" ,()
      __LazyList_cons__ "x" empty)) ,(nested)
  printAll nested ,()
  printAll nested ,()
  __LazyList_cons__ "y" empty ,(ly)
  __LazyList_cons__ "1" ly ,(xs)
  __LazyList_new__ (,()
    println "eval ys" ,()
    __LazyList_cons__ "2" empty) ,(ys)
  append xs ys ,(xys)
  printAll xys ,()
  printAll xys ,()
  num "1" ,(one)
  from one ,(nums)
  append nums empty ,(numsAgain)
  num "2" ,(two)
  printFirst two numsAgain)

;; case5: __LazyList_fromSeq__ は、たどったときに Seq の要素を1つずつ取り出す。
;; 要素をまとめて渡す Seq、1つずつ渡す Seq、空の Seq、可変長引数の Seq。
;; __LazyList_toSeq__ の Seq は何度でも適用できる
(define case5 ,()
  __LazyList_fromSeq__ (,(sink)
    println "gen 1" ,()
    sink "1" ,(sink)
    println "gen 2" ,()
    sink "2" "3") ,(l123)
  println "created" ,()
  __LazyList_uncons__ __nop__ l123 ,(head tail)
  println head ,()
  printAll l123 ,()
  printAll l123 ,()
  __LazyList_fromSeq__ (,(sink) __NULL__ sink) ,(none)
  printAll none ,()
  makeFromArgs "p" "q" ,(pq)
  printAll pq ,()
  __LazyList_toSeq__ l123 ,(seq)
  __Seq_print__ seq ,()
  println "" ,()
  __Seq_print__ seq ,()
  println "" ,()
  __LazyList_toSeq__ none ,(seq)
  __Seq_print__ seq ,()
  println "|")

;; case6: 標準入力の行の LazyList。2回たどっても、標準入力は1度しか読まない
(define case6 ,()
  __OS_get_stdin__ ,(stream)
  __LazyList_fromSeq__ (,(sink) __Stream_lines__ stream sink) ,(lines)
  __LazyList_uncons__ __nop__ lines ,(first rest)
  __OS_print__ first ,()
  println "--" ,()
  __LazyList_toSeq__ lines ,(seq)
  __Seq_print__ seq ,()
  println "" ,()
  println "--" ,()
  __Seq_print__ seq ,()
  println "")

;; case7: 評価中の自分自身を評価しようとする LazyList はエラーで終える
(define case7 ,()
  __Ref_new__ __NULL__ ,(box)
  __LazyList_new__ (,()
    __Ref_get__ box ,(self)
    __LazyList_uncons__ __nop__ self ,(head tail)
    __LazyList_cons__ "x" tail) ,(bad)
  __Ref_set__ box bad ,()
  println "force" ,()
  __LazyList_is_empty__ bad ,(b)
  println "not reached")

;; ── 複数の VProc ──
;; 子 VProc は child.se から起動する。親は子を待ってから出力するので、
;; 出力は VProc の切り替えの順序によらない。サンクの出力は、評価する VProc によらず1度だけ

(define errSink ,(str)
  __OS_print_error__ str ,()
  errSink)

;; 子が out に渡した値を ref に入れる Sink
(define refSink ,(ref)
  __NULL__ (,(value)
    __Ref_set__ ref value ,()
    refSink ref))

;; entry を child.se から起動し、args に lazyList を渡す。子が out に渡した値は ref に入る
(define spawnChild ,(entry lazyList ref)
  refSink ref ,(out)
  __VProc_spawn__ __print_exit_error__ entry "child.se" errSink (,(sink) sink lazyList) __NULL__ out)

;; ref の値を出力する。null なら "(null)"
(define printRef ,(ref)
  __Ref_get__ ref ,(value)
  __if_then_else__ (,() __is_null__ value)
    (,() println "(null)")
    (,() println value))

;; n 回繰り返してから戻る
(define delay ,(n)
  __Number_is_zero__ n ,(zero)
  __unless__ zero
  (,()
    num "1" ,(one)
    __Number_subtract__ n one ,(m)
    delay m))

;; 評価に時間のかかるセルの LazyList。評価すると eval head を出力する
(define slowCons ,(head tail)
  __LazyList_new__ (,()
    num "30" ,(n)
    delay n ,()
    __println__ "eval " head ,()
    __LazyList_cons__ head tail))

;; __LazyList_claim__ の結果（thunk と cell の型）か、onError のメッセージを出力する
(define tryClaim ,(lazyList)
  __Cont_get__ ,(return)
  __LazyList_claim__ (,(msg) println msg ,() return) lazyList ,(thunk cell)
  __type_name__ thunk ,(thunkType)
  __type_name__ cell ,(cellType)
  __println__ thunkType " " cellType)

;; case8: 2つの VProc が同じ LazyList をたどる。後から評価しようとした VProc は、
;; 先の VProc が評価し終えるまで待つ。サンクはそれぞれ1度しか実行されない
(define case8 ,()
  __LazyList_empty__ ,(empty)
  slowCons "c" empty ,(lc)
  slowCons "b" lc ,(lbc)
  slowCons "a" lbc ,(labc)
  __Ref_new__ __NULL__ ,(ref1)
  __Ref_new__ __NULL__ ,(ref2)
  spawnChild "childWalk" labc ref1 ,(child1)
  spawnChild "childWalk" labc ref2 ,(child2)
  __VProc_wait__ __print_exit_error__ child1 ,()
  __VProc_wait__ __print_exit_error__ child2 ,()
  printRef ref1 ,()
  printRef ref2)

;; case9: __LazyList_claim__ はサンクを返して印を置く。claim した tryClaim から戻ると評価を抜けたことになるので、
;; もう1度 claim するとサンクをまた返す。__LazyList_publish__ の後はセルを返す。LazyList でない値は onError
(define case9 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_new__ (,() __LazyList_cons__ "x" empty) ,(lx)
  tryClaim lx ,()
  tryClaim lx ,()
  __LazyList_cons__ "x" empty ,(cellOwner)
  __Ref_get__ cellOwner ,(cell)
  __LazyList_publish__ lx cell ,()
  tryClaim lx ,()
  tryClaim empty ,()
  tryClaim "abc" ,()
  __Ref_new__ "abc" ,(ref)
  tryClaim ref)

;; case10: 評価中の VProc が評価せずに実行時エラーで終わると、待っていた VProc にも、
;; 後から評価する VProc にも onError
(define case10 ,()
  __LazyList_new__ (,()
    num "30" ,(n)
    delay n ,()
    undefinedFunction) ,(bad)
  __Ref_new__ __NULL__ ,(ref1)
  __Ref_new__ __NULL__ ,(ref2)
  spawnChild "childWalk" bad ref1 ,(child1)
  spawnChild "childClaim" bad ref2 ,(child2)
  __VProc_wait__ __print_exit_error__ child1 ,()
  __VProc_wait__ __print_exit_error__ child2 ,()
  printRef ref1 ,()
  printRef ref2 ,()
  tryClaim bad)

;; case11: 2つの VProc が、互いに相手の LazyList に依存する LazyList を評価すると、デッドロック（exit code 2）
(define case11 ,()
  __Ref_new__ __NULL__ ,(box1)
  __Ref_new__ __NULL__ ,(box2)
  __LazyList_new__ (,()
    num "30" ,(n)
    delay n ,()
    __Ref_get__ box2 ,(other)
    __LazyList_is_empty__ other ,(b)
    __LazyList_empty__) ,(l1)
  __LazyList_new__ (,()
    num "30" ,(n)
    delay n ,()
    __Ref_get__ box1 ,(other)
    __LazyList_is_empty__ other ,(b)
    __LazyList_empty__) ,(l2)
  __Ref_set__ box1 l1 ,()
  __Ref_set__ box2 l2 ,()
  __Ref_new__ __NULL__ ,(ref1)
  __Ref_new__ __NULL__ ,(ref2)
  spawnChild "childWalk" l1 ref1 ,(child1)
  spawnChild "childWalk" l2 ref2 ,(child2)
  __VProc_wait__ __print_exit_error__ child1 ,()
  println "not reached")

;; case12: claim していない LazyList の __LazyList_publish__ は VProc をエラーで終える
(define case12 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_publish__ empty __NULL__ ,()
  println "not reached")

;; case13: null でも LList でもないセルの __LazyList_publish__ は VProc をエラーで終える
(define case13 ,()
  __LazyList_empty__ ,(empty)
  __LazyList_new__ (,() __NULL__ empty) ,(lazyList)
  __LazyList_claim__ __print_exit_error__ lazyList ,(thunk cell)
  __LazyList_publish__ lazyList "abc" ,()
  println "not reached")

;; ── パイプ ──

;; case14: __LazyList_pipe__ の sink に書いた値が、書いた順に要素になり、close で終わる。
;; 値をまとめて書いてもよい。close する前に、書いた分だけたどれる。何度たどっても同じ要素
(define case14 ,()
  num "3" ,(three)
  __LazyList_pipe__ three __nop__ ,(lazyList sink close cancel)
  println "created" ,()
  sink "a" ,(sink)
  sink "b" "c" ,(sink)
  printFirst three lazyList ,()
  close ,()
  printAll lazyList ,()
  printAll lazyList)

;; case15: close した後に sink に書くと、VProc をエラーで終える
(define case15 ,()
  num "1" ,(one)
  __LazyList_pipe__ one __nop__ ,(lazyList sink close cancel)
  close ,()
  printAll lazyList ,()
  sink "x" ,(sink)
  println "not reached")

;; しばらく動いてから value を sink に書く
(define writeSlowly ,(sink value)
  num "30" ,(n)
  delay n ,()
  __println__ "write " value ,()
  sink value)

;; case16: 子 VProc がパイプの LazyList をたどる。値がまだ書かれていなければ、書かれるまで待つ
(define case16 ,()
  num "1" ,(one)
  __LazyList_pipe__ one __nop__ ,(lazyList sink close cancel)
  __Ref_new__ __NULL__ ,(ref)
  spawnChild "childWalk" lazyList ref ,(child)
  writeSlowly sink "a" ,(sink)
  writeSlowly sink "b" ,(sink)
  writeSlowly sink "c" ,(sink)
  close ,()
  __VProc_wait__ __print_exit_error__ child ,()
  printRef ref)

;; ref の値が null でなくなるまで待ち、その値を返す
(define waitRef ,(ref)
  __Ref_get__ ref ,(value)
  __if_then_else__ (,() __is_null__ value)
    (,()
      num "1" ,(one)
      delay one ,()
      waitRef ref)
    (,() __NULL__ value))

;; case17: パイプを作った子 VProc が close せずに終わると、末尾を待っていた VProc には onError。
;; 末尾の LazyList のサンクは、子 VProc がまだ値を書いていない LazyList を返す
(define case17 ,()
  __Ref_new__ __NULL__ ,(ref)
  spawnChild "childPipe" __NULL__ ref ,(child)
  waitRef ref ,(lazyList)
  __LazyList_uncons__ __nop__ lazyList ,(head tail)
  println head ,()
  __LazyList_claim__ __print_exit_error__ tail ,(thunk cell)
  thunk ,(inner)
  tryClaim inner)

;; ── 評価を抜けたサンク ──

;; kref に自分の継続を入れてから xs を評価し、最初の要素を返す。サンクが継続で抜けると、その値を返す
(define forceOrEscape ,(kref xs)
  __Cont_get__ ,(k)
  __Ref_set__ kref k ,()
  __LazyList_uncons__ __nop__ xs ,(head tail)
  __NULL__ head)

;; 最初に実行されたときだけ、kref の継続で "escaped" を返して評価を抜けるサンクの LazyList。
;; delay は、抜ける前と、"x" のセルを返す前に繰り返す回数
(define escapeOnce ,(kref delayCount)
  __Ref_new__ __TRUE__ ,(once)
  __LazyList_empty__ ,(empty)
  __LazyList_new__ (,()
    println "eval" ,()
    num delayCount ,(n)
    delay n ,()
    __Ref_get__ once ,(first)
    __Ref_set__ once __FALSE__ ,()
    __if_then_else__ first
      (,()
        __Ref_get__ kref ,(k)
        k "escaped")
      (,() __LazyList_cons__ "x" empty)))

;; case18: サンクの途中で継続によって評価を抜けた LazyList は、同じ VProc が次に評価すると、
;; サンクをもう一度実行する（自分自身に依存するとはみなさない）。その後はメモ化される
(define case18 ,()
  __Ref_new__ __NULL__ ,(kref)
  escapeOnce kref "0" ,(xs)
  forceOrEscape kref xs ,(r)
  println r ,()
  forceOrEscape kref xs ,(r)
  println r ,()
  forceOrEscape kref xs ,(r)
  println r)

;; case19: 評価中の VProc がサンクを継続で抜けると、待っていた子 VProc が起きて、サンクをもう一度実行する
(define case19 ,()
  __Ref_new__ __NULL__ ,(kref)
  escapeOnce kref "30" ,(xs)
  __Ref_new__ __NULL__ ,(ref)
  spawnChild "childWalk" xs ref ,(child)
  forceOrEscape kref xs ,(r)
  __VProc_wait__ __print_exit_error__ child ,()
  println r ,()
  printRef ref)

;; ── パイプの容量と cancel ──

;; entry を child.se から起動し、args に lazyList と cancel を渡す。子が out に渡した値は ref に入る
(define spawnChild2 ,(entry lazyList cancel ref)
  refSink ref ,(out)
  __VProc_spawn__ __print_exit_error__ entry "child.se" errSink (,(sink) sink lazyList cancel) __NULL__ out)

;; 1行を1回の __OS_print__ で出力する（ほかの VProc の出力と行の途中で混ざらないように）
(define printLine ,(prefix str)
  __String_concat__ prefix str ,(line)
  __String_concat__ line "\n" ,(line)
  __OS_print__ line)

;; n から始まる数を sink に書き続ける。書けたら wrote n を出力する
(define writeFrom ,(sink n)
  __Number_toString__ n ,(str)
  sink str ,(sink)
  printLine "wrote " str ,()
  num "1" ,(one)
  __Number_add__ n one ,(n)
  writeFrom sink n)

;; 1 から 5 を sink に書き、close する。書けたら wrote n を出力する
(define writeFive ,(sink close)
  num "1" ,(one)
  num "6" ,(six)
  writeRange sink one six ,()
  close)

(define writeRange ,(sink n end)
  __Number_subtract__ end n ,(left)
  __Number_is_zero__ left ,(done)
  __unless__ done (,()
    __Number_toString__ n ,(str)
    sink str ,(sink)
    printLine "wrote " str ,()
    num "1" ,(one)
    __Number_add__ n one ,(n)
    writeRange sink n end))

;; case20: capacity 1 のパイプ。書き手は、子 VProc がまだ求めていない要素を 1 つまでしか先に書かない
;; （wrote n は、read n-2 より後に出力される）
(define case20 ,()
  num "1" ,(one)
  __LazyList_pipe__ one __nop__ ,(lazyList sink close cancel)
  __Ref_new__ __NULL__ ,(ref)
  spawnChild "childSlowRead" lazyList ref ,(child)
  writeFive sink close ,()
  __VProc_wait__ __print_exit_error__ child ,()
  printRef ref)

;; case21: 子 VProc が 2 つ読んでから cancel すると、書き手の次の sink が LazyList を終わらせて onClosed を呼ぶ。
;; LazyList には、それまでに書いた要素が残り、そこで終わる
(define case21 ,()
  __Ref_new__ __NULL__ ,(ref)
  __Ref_new__ __NULL__ ,(listRef)
  writeUntilClosed ref listRef ,(child)
  println "closed" ,()
  __VProc_wait__ __print_exit_error__ child ,()
  printRef ref ,()
  __Ref_get__ listRef ,(lazyList)
  printAll lazyList)

;; パイプを作って子 VProc に読ませ、cancel されるまで書き続ける。onClosed で子 VProc を返す
(define writeUntilClosed ,(ref listRef)
  __Cont_get__ ,(return)
  __Ref_new__ __NULL__ ,(childRef)
  num "1" ,(one)
  __LazyList_pipe__ one (,() __Ref_get__ childRef ,(child) return child) ,(lazyList sink close cancel)
  __Ref_set__ listRef lazyList ,()
  spawnChild2 "childCancel" lazyList cancel ref ,(child)
  __Ref_set__ childRef child ,()
  writeFrom sink one)

;; case22: 読み手のいないパイプに capacity を超えて書くと、書き手は待ち続ける（デッドロック、exit code 2）
(define case22 ,()
  num "1" ,(one)
  __LazyList_pipe__ one __nop__ ,(lazyList sink close cancel)
  writeFrom sink one ,()
  println "not reached")

;; case23: __Ref_wait_change__ は、値が既に違えばすぐに戻り、同じなら、子 VProc が値を変えるまで待つ
(define case23 ,()
  __Ref_new__ "a" ,(r)
  __Ref_wait_change__ r "b" ,()
  println "returned at once" ,()
  __Ref_get__ r ,(value)
  __Ref_new__ __NULL__ ,(ref)
  spawnChild "childSet" r ref ,(child)
  __Ref_wait_change__ r value ,()
  __Ref_get__ r ,(value)
  println value ,()
  __VProc_wait__ __print_exit_error__ child ,()
  printRef ref)
