;; Step20: test.se から子 VProc として起動するプログラム。
;; 各関数は __VProc_spawn__ の entryPoint で、err args in out を受け取る
(include "util.se")

;; n 回繰り返してから戻る
(define delay ,(n)
  __Number_is_zero__ n ,(zero)
  __unless__ zero
  (,()
    __Number_fromString__ __print_exit_error__ "1" ,(one)
    __Number_subtract__ n one ,(m)
    delay m))

;; args の LazyList をたどり、要素を連結した String を out に渡す
(define childWalk ,(err args in out)
  args (,(lazyList)
    __LazyList_toSeq__ lazyList ,(seq)
    __Ref_new__ "" ,(acc)
    seq (,(value) concatSink acc value) ,(sink)
    __Ref_get__ acc ,(str)
    out str))

(define concatSink ,(acc value)
  __Ref_get__ acc ,(str)
  __String_concat__ str value ,(str)
  __Ref_set__ acc str ,()
  __NULL__ (,(value) concatSink acc value))

;; しばらく動いてから、args の LazyList を __LazyList_claim__ で評価しようとし、
;; onError のメッセージか、得たセルの種類を out に渡す
(define childClaim ,(err args in out)
  args (,(lazyList)
    __Cont_get__ ,(return)
    __Number_fromString__ __print_exit_error__ "10" ,(n)
    delay n ,()
    __LazyList_claim__ (,(msg) out msg ,(sink) return) lazyList ,(thunk cell)
    __type_name__ cell ,(type)
    out type))

;; パイプを作り、その LazyList を out に渡す。"x" を書き、しばらく動いてから close せずに終わる
(define childPipe ,(err args in out)
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  __LazyList_pipe__ one __nop__ ,(lazyList sink close cancel)
  out lazyList ,(outSink)
  sink "x" ,(sink)
  __Number_fromString__ __print_exit_error__ "30" ,(n)
  delay n)

;; args の LazyList の要素を、1つずつしばらく動いてから read v と出力し、要素を連結した String を out に渡す
(define childSlowRead ,(err args in out)
  args (,(lazyList)
    slowRead lazyList "" ,(str)
    out str))

(define slowRead ,(lazyList acc)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return acc) lazyList ,(head tail)
  __Number_fromString__ __print_exit_error__ "60" ,(n)
  delay n ,()
  __String_concat__ "read " head ,(line)
  __String_concat__ line "\n" ,(line)
  __OS_print__ line ,()
  __String_concat__ acc head ,(acc)
  slowRead tail acc)

;; args の LazyList の要素を 2 つ読んでから cancel し、2 つを連結した String を out に渡す
(define childCancel ,(err args in out)
  args (,(lazyList cancel)
    __LazyList_uncons__ __print_exit_error__ lazyList ,(first rest)
    __LazyList_uncons__ __print_exit_error__ rest ,(second rest)
    __String_concat__ "read " first ,(line)
    __String_concat__ line second ,(line)
    __String_concat__ line "\n" ,(line)
    __OS_print__ line ,()
    cancel ,()
    __String_concat__ first second ,(str)
    out str))

;; しばらく動いてから、args の Ref の値を "changed" にし、"done" を out に渡す
(define childSet ,(err args in out)
  args (,(ref)
    __Number_fromString__ __print_exit_error__ "30" ,(n)
    delay n ,()
    __Ref_set__ ref "changed" ,()
    out "done"))
