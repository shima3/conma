;; Step33: LazyList を評価している VProc を止めるとき、評価を終えるまで待つ __VProc_kill__、fd を複製する __OS_dup__、
;; インタプリタが Python の例外で終わらないこと、__OS_trap_interrupt__ の Ref だけを待つときに Deadlock にしないこと
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

;; case1: VProc A が LazyList を評価している途中で止める。A は評価を終えてから止まり、その値は読める。
;; A が評価の後に進むはずの処理（"after the evaluation"）は実行されない。
;; __Ref_wait_change__ は同じオブジェクトかどうかで比べるので、Ref に入れた文字列 wait そのものを渡す
;; （文字列のリテラルを 2 回書くと別のオブジェクトになり、A は待たずに評価を進め、止める前に出力することがある）
(define case1 ,()
  __NULL__ "wait" ,(wait)
  __Ref_new__ wait ,(gate)
  __LazyList_new__ (,()
    __Ref_wait_change__ gate wait ,()
    println "evaluating" ,()
    __LazyList_empty__ ,(empty)
    __LazyList_cons__ "value" empty) ,(list)
  __VProc_start__ (,()
    __LazyList_uncons__ (,() println "empty") list ,(head rest)
    println "after the evaluation") ,(a)
  __VProc_start__ (,() __nop__) ,(other)
  __VProc_wait__ __print_exit_error__ other ,()
  __VProc_kill__ a ,()
  println "killed while evaluating" ,()
  __Ref_set__ gate "go" ,()
  __VProc_wait__ __print_exit_error__ a ,()
  __LazyList_uncons__ (,() println "empty") list ,(head rest)
  __String_concat__ "read: " head ,(line)
  println line)

;; case2: dup した Stream は、元の Stream を閉じても書ける。ファイルは環境変数 STEP33_DIR（test.sh の一時ディレクトリ）に作る
(define case2 ,()
  __OS_get_envDict__ ,(env)
  __Dict_lookup_or__ env "STEP33_DIR" (,(key) __NULL__ "/tmp") ,(dir)
  __String_concat__ dir "/step33.dup.txt" ,(path)
  __OS_open__ __print_exit_error__ path "w" ,(file)
  __OS_dup__ __print_exit_error__ file ,(copy)
  __OS_close__ __print_exit_error__ file ,()
  __OS_write__ __print_exit_error__ copy "written through the dup\n" ,()
  __OS_close__ __print_exit_error__ copy ,()
  __OS_open__ __print_exit_error__ path "r" ,(in)
  __LazyList_lines__ in ,(lines)
  __LazyList_uncons__ (,() println "no line") lines ,(line rest)
  __OS_print__ line ,()
  dupError file ,()
  dupError "not a stream")

(define dupError ,(x)
  __Cont_get__ ,(return)
  __OS_dup__ (,(msg) println msg ,() return) x ,(s)
  println "not reached")

;; case3: 無限大のシグナル番号と、深い入れ子の S 式と、最後が \ の文字列で、Python の例外にならない
(define case3 ,()
  __Cont_get__ ,(return)
  num "1e300" ,(big)
  __Number_multiply__ big big ,(inf)
  __MSeq_new__ ,(cmd)
  __MSeq_append__ __print_exit_error__ cmd "true" ,()
  __OS_get_envDict__ ,(env)
  __OS_spawn__ __print_exit_error__ cmd __NULL__ __NULL__ __NULL__ env ,(proc)
  __Number_divide__ __print_exit_error__ inf inf ,(nan)
  killError proc inf ,()
  killError proc nan ,()
  __OS_wait__ __print_exit_error__ proc ,(code)
  num "5000" ,(levels)
  deep "x" levels ,(text)
  __Sexp_read__ (,(msg) println msg ,() return) text ,(v)
  println "read 5000 levels" ,()
  sexpError "\"abc\\")

(define killError ,(proc sig)
  __Cont_get__ ,(return)
  __OS_kill__ (,(msg) println msg ,() return) proc sig ,()
  println "not reached")

(define sexpError ,(text)
  __Cont_get__ ,(return)
  __Sexp_read__ (,(msg) println msg ,() return) text ,(v)
  println "not reached")

;; n 段の ( ... ) で x を囲んだ String
(define deep ,(x n)
  __Cont_get__ ,(return)
  __if__ (,() __Number_is_zero__ n) (,() return x) ,()
  __String_concat__ "(" x ,(x)
  __String_concat__ x ")" ,(x)
  num "1" ,(one)
  __Number_subtract__ n one ,(n)
  deep x n)

;; case4: __OS_trap_interrupt__ の Ref だけを待っていても Deadlock にならず、SIGINT で起きる
(define case4 ,()
  num "0" ,(zero)
  __Ref_new__ zero ,(ref)
  __OS_trap_interrupt__ ref ,()
  __MSeq_new__ ,(cmd)
  __MSeq_append__ __print_exit_error__ cmd "sh" ,()
  __MSeq_append__ __print_exit_error__ cmd "-c" ,()
  __MSeq_append__ __print_exit_error__ cmd "sleep 1; kill -INT $PPID" ,()
  __OS_get_envDict__ ,(env)
  __OS_spawn__ __print_exit_error__ cmd __NULL__ __NULL__ __NULL__ env ,(proc)
  __Ref_wait_change__ ref zero ,()
  println "woke up by SIGINT")
