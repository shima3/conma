;; __JS_fn_compile__ と __JS_fn_call__（docs/dev/CONJS-HOST-PLAN.md の段階 H2。vm/src/prim/jsfn.rs）：ホストの JavaScript の関数を、
;; VM の値を写して呼び、変えたものを書き戻す。wasm 版の VM だけが JavaScript を持つ。ほかの VM は onError（case1.log）。
(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(text)
  __Number_fromString__ (,(e) println e) text)

;; 値の文字列：Number、"String"、(要素 ...)、() は空の LList（null）、{key 値 ...} は Dict、true と false は真偽
(define text_of ,(v)
  __Cont_get__ ,(return)
  __is_null__ v ,(isNull)
  __if__ isNull (,() return "()") ,()
  __type_name__ v ,(t)
  __String_equal__ t "Number" ,(isNum)
  __if__ isNum (,() __Number_toString__ v ,(s) return s) ,()
  __String_equal__ t "String" ,(isStr)
  __if__ isStr (,() __String_concat__ "\"" v ,(s) __String_concat__ s "\"" ,(s) return s) ,()
  __String_equal__ t "LList" ,(isList)
  __if__ isList (,() items_text v "(" ,(s) return s) ,()
  __String_equal__ t "Dict" ,(isDict)
  __if__ isDict (,() dict_text v ,(s) return s) ,()
  __String_equal__ t "Closure" ,(isClosure)
  __if__ isClosure (,() __if_then_else__ v (,() __NULL__ "true") (,() __NULL__ "false") ,(b) return b) ,()
  return t)

;; Dict の文字列：{key 値 ...}（キーは入れた順。どの VM も、その順に並べる）
(define dict_text ,(d)
  __Cont_get__ ,(return)
  __Dict_keys__ d ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  __Ref_new__ __NULL__ ,(self)
  __Ref_set__ self (,(k) __Ref_get__ acc ,(l) __LList_cons__ k l ,(l) __Ref_set__ acc l ,() __Ref_get__ self) ,()
  __Ref_get__ self ,(sink)
  keys sink ,(x)
  __Ref_get__ acc ,(rev)
  entries_text d rev "}" ,(s)
  __String_concat__ "{" s)

(define entries_text ,(d rev acc)
  __Cont_get__ ,(return)
  __is_null__ rev ,(end) __if__ end (,() return acc) ,()
  __LList_uncons__ (,(e) println e) rev ,(k rest)
  __Dict_lookup_or__ d k (,(k) println "no key") ,(v)
  text_of v ,(s)
  __String_concat__ k " " ,(e) __String_concat__ e s ,(e)
  __is_null__ rest ,(first)
  __String_equal__ acc "}" ,(last)
  __if_then_else__ last (,() __NULL__ "") (,() __NULL__ " ") ,(sep)
  __String_concat__ sep acc ,(acc)
  __String_concat__ e acc ,(acc)
  entries_text d rest acc)

(define items_text ,(v acc)
  __LList_uncons__ (,(e) println e) v ,(h rest)
  text_of h ,(s)
  __String_concat__ acc s ,(acc)
  __is_null__ rest ,(end)
  __if_then_else__ end
    (,() __String_concat__ acc ")")
    (,() __String_concat__ acc " " ,(acc) items_text rest acc))

;; ホストの関数（rt は vm/wasm/conma.js の jsfnRuntime）
(define js_text ,()
  __NULL__ "return {" ,(t)
  __String_concat__ t "sum(...xs) { return xs.reduce((s, x) => s + x, 0) }," ,(t)
  __String_concat__ t "make() { return { a: 1, b: [true, 'two', null], c: rt.ref(3), d: rt.dict({ k: 'v' }) } }," ,(t)
  __String_concat__ t "mutate(d) { d.x = d.x * 10; d.added = 'new'; delete d.gone; return d }," ,(t)
  __String_concat__ t "alias(a, b) { return a === b }," ,(t)
  __String_concat__ t "cycle(o) { o.n = o.self === o ? 'kept' : 'lost'; return o.self.self === o }," ,(t)
  __String_concat__ t "bump(r) { r.value = r.value + 1; return r.value }," ,(t)
  __String_concat__ t "call(h, x) { return rt.callVm(h, x) + 1 }," ,(t)
  __String_concat__ t "numbers(a, b, c) { return [a, b, c, 1 / a, -0, Object.is(b, -0)] }," ,(t)
  __String_concat__ t "throws() { throw new Error('boom') }," ,(t)
  __String_concat__ t "escapes() { throw new rt.Escape('cannot do this here') }," ,(t)
  __String_concat__ t "bad() { return () => 1 }," ,(t)
  __String_concat__ t "sjsArray(arr, x) { const n = arr.length.value; arr.items[String(n)] = x; arr.length.value = n + 1; return n }," ,(t)
  __String_concat__ t "}")

(define twice ,(x)
  num "2" ,(two)
  __Number_multiply__ x two)

;; label: status value、または label: error: メッセージ
(define jcall ,(label module name args)
  __Cont_get__ ,(return)
  __JS_fn_call__ (,(e) __String_concat__ label ": error: " ,(m) __String_concat__ m e ,(m) println m ,() return) module name args ,(status v)
  text_of v ,(s)
  __String_concat__ label ": " ,(m) __String_concat__ m status ,(m) __String_concat__ m " " ,(m) __String_concat__ m s ,(m)
  println m ,()
  return)

;; label 型の名前、または エラー
(define jcompile ,(label text)
  __Cont_get__ ,(return)
  __JS_fn_compile__ (,(e) __String_concat__ label e ,(m) println m ,() return) text ,(module)
  __type_name__ module ,(t) __String_concat__ label t ,(m) println m ,()
  return)

(define show ,(label v)
  text_of v ,(s) __String_concat__ label s ,(s) println s)

(define case1 ,()
  __Cont_get__ ,(return)
  js_text ,(text)
  __JS_fn_compile__ (,(e) println e ,() return) text ,(M)
  println "compiled" ,()
  num "1" ,(n1) num "2" ,(n2) num "3.5" ,(n3)
  __LList_cons__ n3 __NULL__ ,(a) __LList_cons__ n2 a ,(a) __LList_cons__ n1 a ,(a)
  jcall "sum" M "sum" a ,()
  jcall "make" M "make" __NULL__ ,()
  __Dict_new__ ,(d) __Dict_put__ d "x" n3 ,() __Dict_put__ d "gone" n1 ,() __Dict_put__ d "keep" "k" ,()
  __LList_cons__ d __NULL__ ,(a) jcall "mutate" M "mutate" a ,()
  show "after mutate: " d ,()
  __LList_cons__ d __NULL__ ,(a) __LList_cons__ d a ,(a) jcall "alias" M "alias" a ,()
  __Dict_new__ ,(e) __LList_cons__ e __NULL__ ,(a) __LList_cons__ d a ,(a) jcall "not alias" M "alias" a ,()
  __Dict_new__ ,(c) __Dict_put__ c "self" c ,()
  __LList_cons__ c __NULL__ ,(a) jcall "cycle" M "cycle" a ,()
  __Dict_lookup_or__ c "n" (,(k) __NULL__ "none") ,(n) show "after cycle: n " n ,()
  __Ref_new__ n2 ,(r) __LList_cons__ r __NULL__ ,(a) jcall "bump" M "bump" a ,()
  __Ref_get__ r ,(rv) show "after bump: " rv ,()
  num "20" ,(n20) __LList_cons__ n20 __NULL__ ,(a) __LList_cons__ twice a ,(a) jcall "call" M "call" a ,()
  num "-0" ,(nz) num "1e308" ,(big) __Number_multiply__ big big ,(inf) __Number_subtract__ inf inf ,(nan)
  __LList_cons__ nan __NULL__ ,(a) __LList_cons__ nz a ,(a) __LList_cons__ inf a ,(a) jcall "numbers" M "numbers" a ,()
  jcall "throws" M "throws" __NULL__ ,()
  jcall "escapes" M "escapes" __NULL__ ,()
  jcall "bad" M "bad" __NULL__ ,()
  jcall "unknown" M "nothing" __NULL__ ,()
  jcall "not a list" M "sum" n1 ,()
  ;; 配列の形の Dict（SJS の配列：items と length の Ref）に、JavaScript で 1 つ足す
  __Dict_new__ ,(arr) __Dict_new__ ,(items) __Dict_put__ items "0" "a" ,() __Ref_new__ n1 ,(len)
  __Dict_put__ arr "t" "array" ,() __Dict_put__ arr "items" items ,() __Dict_put__ arr "length" len ,()
  __LList_cons__ "b" __NULL__ ,(a) __LList_cons__ arr a ,(a) jcall "sjsArray" M "sjsArray" a ,()
  __Ref_get__ len ,(lv) show "after sjsArray: length " lv ,() show "after sjsArray: items " items ,()
  jcompile "a syntax error: " "return 1 +" ,()
  jcompile "not an object: " "return 5" ,()
  jcompile "another module: " "return {}" ,()
  __NULL__)
