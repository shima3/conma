;; Step4: CFrame&CChain
(include "util.se")

(define LList_print1 ,(list)
  __unless__ (,() __LList_is_empty__ list)
  (,()
    __LList_uncons__ __print_exit_error__ list ,(first rest)
    __OS_print__ first ,()
    __OS_print__ "\n" ,()
    LList_print1 rest))

(define case1 ,()
  __LList_cons__ "A" __NULL__ ,(list)
  __LList_cons__ "B" list ,(list)
  __LList_cons__ "C" list ,(list)
  LList_print1 list ,()
  )

(define CChain_print ,(cc)
  __unless__ (,() __LList_is_empty__ cc)
  (,()
    __LList_uncons__ __print_exit_error__ cc ,(first rest)
    __CFrame_get_SInfo__ first ,(si)
    __OS_print__ si ,()
    __OS_print__ "\n" ,()
    CChain_print rest))

(define case2sub ,()
  __CChain_get__ ,(cc)
  CChain_print cc ,()
  )

(define case2 ,()
  case2sub ,()
  __OS_print__ "end\n" ,()
  )

(define LList_print2 ,(list)
  __Cont_get__ ,(return)
  __LList_uncons__ (,(msg)
                     return) list ,(first rest)
  __OS_print__ first ,()
  __OS_print__ "\n" ,()
  LList_print2 rest)

(define case3 ,()
  __LList_cons__ "A" __NULL__ ,(list)
  __LList_cons__ "B" list ,(list)
  __LList_cons__ "C" list ,(list)
  LList_print2 list ,()
  __OS_print__ "end\n" ,()
  )

;; 呼び出し元の CFrame を取り出して SInfo を表示し、元に戻してから返る
(define peek_caller ,()
  __CChain_pop_CFrame__ ,(cf)
  __CFrame_get_SInfo__ cf ,(si)
  println si ,()
  __CChain_push_CFrame__ cf ,()
  )

;; case4: __CChain_pop_CFrame__ と __CChain_push_CFrame__。
;; 取り出した CFrame を戻せば呼び出し元に正常に戻る。CChain が空なら null が渡される
(define case4 ,()
  __CChain_pop_CFrame__ ,(cf)
  __is_null__ cf ,(empty)
  __if_then_else__ empty
    (,() println "empty CChain gives null")
    (,() println "empty CChain gives a CFrame") ,()
  peek_caller ,()
  println "returned" ,()
  )

;; case5: __CFrame_new__ で作った CFrame を積むと、関数の終了時にその Closure が実行される。
;; SInfo は __CFrame_get_SInfo__ でそのまま取り出せる
(define case5 ,()
  __CFrame_new__ (,() println "pushed frame runs") "custom.se:12:5" ,(cf)
  __CFrame_get_SInfo__ cf ,(si)
  println si ,()
  __CFrame_new__ (,() println "never") __NULL__ ,(cf2)
  __CFrame_get_SInfo__ cf2 ,(si2)
  println si2 ,()
  __CChain_push_CFrame__ cf ,()
  __CChain_get__ ,(cc)
  CChain_print cc ,()
  )

;; 呼び出し元の LCont を取り出し、値を渡して呼び出す
(define return_hello ,()
  __CChain_pop_LCont__ ,(lc)
  lc "hello")

;; case6: __CChain_pop_LCont__ で呼び出し元の LCont を取り出して値を返す
(define case6 ,()
  return_hello ,(greeting)
  println greeting ,()
  )

;; 保存した CChain に置き換えて、途中の呼び出しを飛ばして戻る。
;; list の要素数だけ再帰してから戻る
(define deep ,(saved list)
  __if_then_else__ (,() __LList_is_empty__ list)
    (,()
      println "escape" ,()
      __CChain_set__ saved ,()
      )
    (,()
      __LList_uncons__ __print_exit_error__ list ,(first rest)
      deep saved rest ,()
      println "not reached" ,()
      ) ,()
  )

;; 呼び出し元の LCont を含む CChain を保存してから deep を呼ぶ
(define run_deep ,(list)
  __CChain_get__ ,(saved)
  deep saved list)

;; case7: __CChain_set__ で保存しておいた CChain に戻す。
;; case7 の先頭で取得した CChain には case7 自身の LCont が含まれないので、
;; それに戻すと case7 の残りも飛ばされる
(define case7 ,()
  __LList_cons__ "c" __NULL__ ,(list)
  __LList_cons__ "b" list ,(list)
  __LList_cons__ "a" list ,(list)
  run_deep list ,()
  println "back in case7" ,()
  __CChain_get__ ,(saved)
  deep saved list ,()
  println "not reached (case7)" ,()
  )

;; case8: CFrame でない値を渡すとエラー終了する
(define case8 ,()
  __CFrame_get_SInfo__ "abc" ,(si)
  println "not reached" ,()
  )

(define __Cont_get2__ ,()
  __CChain_pop_LCont__ ,(lc)
  __CChain_get__ ,(cc)
  lc (, args
       __CChain_set__ cc ,()
       __unless__ (,() __is_null__ cc)
       (,() __CChain_pop_LCont__ ,(lc)
         args lc)))

(define case9sub ,()
  __Cont_get2__ ,(ret)
  ret "12" "34")

(define case9 ,()
  __Cont_get2__ ,(ret)
  case9sub ,(x y)
  println x ", " y ,()
  ret)

(define case10sub ,()
  println "case10sub" ,()
  __Cont_get2__ ,(ret)
  println "case10sub 2" ,()
  ret)

(define case10 ,()
  __Cont_get2__ ,(ret)
  println "case10 2" ,()
  case10sub ,()
  println "case10 3" ,()
  ret)
