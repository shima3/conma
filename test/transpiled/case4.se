;; case4：拡張 ConMa の機能 "array" のプリミティブ（docs/dev/ARRAY-PLAN-ja.md の A4）を、変換したコードから使う。
;; test/step47（と fast12）の 5 つのケースを順に動かす。変換したコードは、__Array_length__、__Array_get__、__Array_set__、
;; __Array_push__ を直接呼び、ほかは OList を通して呼ぶ。ログは step47 の 5 つのログを（終了コードの行を除いて）つないだもの
(include "util.se")

(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(s)
  __Number_fromString__ __print_exit_error__ s)

;; onError：メッセージを出して、"error" を返す
(define report ,(msg)
  __String_concat__ "onError: " msg ,(line)
  println line ,()
  __NULL__ "error")

;; __Array_set__ の onError：メッセージを出して、値を返さずに戻る
(define report0 ,(msg)
  __String_concat__ "onError: " msg ,(line)
  println line)

;; 配列の長さと、要素を空白で区切った String（要素は String か Number）
(define show ,(array)
  __Array_length__ array ,(n)
  num "0" ,(zero)
  show_from array zero n "" ,(items)
  __Number_toString__ n ,(ns)
  __String_concat__ "[" ns ,(s)
  __String_concat__ s "]" ,(s)
  __String_concat__ s items ,(s)
  println s)

(define show_from ,(array i n acc)
  __Cont_get__ ,(return)
  __Number_subtract__ i n ,(d)
  __Number_is_zero__ d ,(end)
  __if__ end (,() return acc) ,()
  __Array_get__ __print_exit_error__ array i ,(v)
  __type_name__ v ,(type)
  __String_equal__ type "Number" ,(isNumber)
  __if_then_else__ isNumber (,() __Number_toString__ v) (,() __NULL__ v) ,(text)
  __String_concat__ acc " " ,(acc)
  __String_concat__ acc text ,(acc)
  num "1" ,(one)
  __Number_add__ i one ,(i)
  show_from array i n acc)

;; case1：作る、足す、読む、書く、取り除く、長さ。空の配列から取り除くと onError
(define case1 ,()
  __Array_new__ ,(a)
  show a ,()
  __Array_push__ a "x" ,()
  __Array_push__ a "y" ,()
  num "3" ,(three)
  __Array_push__ a three ,()
  show a ,()
  num "1" ,(one)
  __Array_set__ __print_exit_error__ a one "Y" ,()
  show a ,()
  __Array_get__ __print_exit_error__ a one ,(v)
  println v ,()
  __Array_pop__ __print_exit_error__ a ,(v)
  __Number_toString__ v ,(s)
  __String_concat__ "popped " s ,(s)
  println s ,()
  show a ,()
  __Array_pop__ __print_exit_error__ a ,(v)
  println v ,()
  __Array_pop__ __print_exit_error__ a ,(v)
  println v ,()
  show a ,()
  __Array_pop__ report a ,(v)
  println v ,()
  __Array_push__ a "again" ,()
  show a)

;; case2：添字の誤り。範囲の外（-1、長さ）、整数でない、数でない、無限大。-0 は 0
(define case2 ,()
  __Array_new__ ,(a)
  __Array_push__ a "p" ,()
  __Array_push__ a "q" ,()
  num "-1" ,(m1)
  __Array_get__ report a m1 ,(v) println v ,()
  num "2" ,(two)
  __Array_get__ report a two ,(v) println v ,()
  num "0.5" ,(half)
  __Array_get__ report a half ,(v) println v ,()
  __Array_get__ report a "0" ,(v) println v ,()
  num "0" ,(zero)
  num "1e308" ,(big)
  __Number_multiply__ big big ,(inf)
  __Array_get__ report a inf ,(v) println v ,()
  __Number_subtract__ zero inf ,(minf)
  __Array_get__ report a minf ,(v) println v ,()
  __Number_subtract__ inf inf ,(nan)
  __Array_get__ report a nan ,(v) println v ,()
  __Array_set__ report0 a two "r" ,() show a ,()
  __Array_set__ report0 a half "r" ,() show a ,()
  __Array_set__ report0 a "1" "r" ,() show a ,()
  num "-0" ,(mzero)
  __Array_get__ report a mzero ,(v) println v ,()
  __Array_set__ report0 a mzero "P" ,() show a ,()
  __Array_get__ report a zero ,(v) println v)

;; case3：配列でない値（String、Dict、null）を onError を取るプリミティブに渡すと、"not an Array" で onError
(define case3 ,()
  num "0" ,(zero)
  __Array_get__ report "text" zero ,(v) println v ,()
  __Dict_new__ ,(d)
  __Array_set__ report0 d zero "x" ,() println "set: returned" ,()
  __Array_pop__ report __NULL__ ,(v) println v)

;; case4：同じ配列を 2 か所から持つと、書き換えはどちらからも見える。配列の中の配列、自分を含む配列、
;; null と関数の要素。Dict のキーにすると、配列ごとに別のキー
(define case4 ,()
  __Array_new__ ,(a)
  __NULL__ a ,(b)
  __Array_push__ a "shared" ,()
  show b ,()
  __Array_new__ ,(inner)
  __Array_push__ inner "in" ,()
  __Array_push__ a inner ,()
  num "1" ,(one)
  __Array_get__ __print_exit_error__ b one ,(got)
  __Array_push__ got "more" ,()
  show inner ,()
  __Array_push__ a a ,()
  num "2" ,(two)
  __Array_get__ __print_exit_error__ a two ,(self)
  __Array_length__ self ,(n)
  __Number_toString__ n ,(s)
  __String_concat__ "self length " s ,(s)
  println s ,()
  __Array_push__ a __NULL__ ,()
  num "3" ,(three)
  __Array_get__ __print_exit_error__ a three ,(v)
  __is_null__ v ,(isNull)
  __if_then_else__ isNull (,() println "null element") (,() println "not null") ,()
  __Array_push__ a println ,()
  num "4" ,(four)
  __Array_get__ __print_exit_error__ a four ,(f)
  f "called from the array" ,()
  __Dict_new__ ,(d)
  __Array_new__ ,(c)
  __Dict_put__ d a "a" ,()
  __Dict_put__ d c "c" ,()
  __Dict_lookup_or__ d b (,(k) __NULL__ "missing") ,(x)
  println x ,()
  __Dict_lookup_or__ d c (,(k) __NULL__ "missing") ,(x)
  println x ,()
  __Array_new__ ,(e)
  __Dict_lookup_or__ d e (,(k) __NULL__ "missing") ,(x)
  println x)

;; case5：たくさんの要素（1 万個）を足して、足し合わせ、すべて取り除く
(define case5 ,()
  __Array_new__ ,(a)
  num "0" ,(zero)
  num "10000" ,(n)
  fill a zero n ,()
  __Array_length__ a ,(len)
  __Number_toString__ len ,(s)
  println s ,()
  sum a zero len zero ,(total)
  __Number_toString__ total ,(s)
  println s ,()
  drain a zero ,(count)
  __Number_toString__ count ,(s)
  println s ,()
  show a)

(define fill ,(a i n)
  __Cont_get__ ,(return)
  __Number_subtract__ i n ,(d)
  __Number_is_zero__ d ,(end)
  __if__ end return ,()
  __Array_push__ a i ,()
  num "1" ,(one)
  __Number_add__ i one ,(i)
  fill a i n)

(define sum ,(a i n acc)
  __Cont_get__ ,(return)
  __Number_subtract__ i n ,(d)
  __Number_is_zero__ d ,(end)
  __if__ end (,() return acc) ,()
  __Array_get__ __print_exit_error__ a i ,(v)
  __Number_add__ acc v ,(acc)
  num "1" ,(one)
  __Number_add__ i one ,(i)
  sum a i n acc)

(define drain ,(a count)
  __Cont_get__ ,(return)
  __Array_length__ a ,(n)
  __Number_is_zero__ n ,(empty)
  __if__ empty (,() return count) ,()
  __Array_pop__ __print_exit_error__ a ,(v)
  num "1" ,(one)
  __Number_add__ count one ,(count)
  drain a count)

(define main ,(args)
  case1 ,()
  case2 ,()
  case3 ,()
  case4 ,()
  case5)
