;; Step16: 型名と実パス
;; test.sh が work/ に sub/ と、親ディレクトリを指すシンボリックリンク up を作る
(include "util.se")

(define println ,(str)
  __OS_print__ str ,()
  __OS_print__ "\n" ,()
  )

;; エラーメッセージを標準出力に書き、値を返さずに LCont に戻る
(define recover ,(msg)
  println msg ,()
  )

;; 何もしない Sink
(define nullSink ,(value)
  nullSink)

;; label と value の型名を出力する
(define printType ,(label value)
  __type_name__ value ,(name)
  __OS_print__ label ,()
  __OS_print__ ": " ,()
  println name)

;; path の実パスを出力する
(define printReal ,(path)
  __Cont_get__ ,(return)
  __OS_realpath__ (,(msg) recover msg ,() return) path ,(real)
  println real)

;; case1: null、String、Number
;; 空の LList は null。実行時に作った String もリテラルと同じ "String"
(define case1 ,()
  printType "__NULL__" __NULL__ ,()
  __LList_cons__ "a" __NULL__ ,(list)
  __LList_uncons__ __print_exit_error__ list ,(head tail)
  printType "empty LList" tail ,()
  printType "String literal" "abc" ,()
  printType "empty String" "" ,()
  __String_concat__ "ab" "c" ,(s1)
  printType "String_concat" s1 ,()
  __Number_fromString__ __print_exit_error__ "42" ,(n)
  printType "Number" n ,()
  __Number_toString__ n ,(s2)
  printType "Number_toString" s2 ,()
  __OS_getcwd__ ,(s3)
  printType "OS_getcwd" s3 ,()
  )

;; case2: Closure。プリミティブ、Boolean、Seq、Sink も "Closure"
(define case2 ,()
  printType "FuncExp" (,(x) x) ,()
  printType "defined function" println ,()
  printType "primitive" __OS_print__ ,()
  printType "__TRUE__" __TRUE__ ,()
  __String_equal__ "a" "b" ,(bool)
  printType "Boolean" bool ,()
  __Dict_new__ ,(dict)
  __Dict_keys__ dict ,(seq)
  printType "Seq" seq ,()
  printType "Sink" nullSink ,()
  )

;; case3: Ref、CFrame、LList、CChain、MSeq、Dict、VProc
;; 空の CChain は null、CFrame を積んだ CChain は CFrame の LList なので "LList"
(define case3 ,()
  __Ref_new__ "x" ,(ref)
  printType "Ref" ref ,()
  __CFrame_new__ (,() ) __NULL__ ,(cf)
  printType "CFrame" cf ,()
  __LList_cons__ "a" __NULL__ ,(list)
  printType "LList" list ,()
  __CChain_get__ ,(cc)
  printType "empty CChain" cc ,()
  __CChain_push_CFrame__ cf ,()
  __CChain_get__ ,(cc2)
  printType "CChain" cc2 ,()
  __CChain_pop_CFrame__ ,(cf2)
  __MSeq_new__ ,(mseq)
  printType "MSeq" mseq ,()
  __Dict_new__ ,(dict)
  printType "Dict" dict ,()
  __VProc_current__ ,(vp)
  printType "VProc" vp ,()
  )

;; case4: OSProc と Stream。入力用も出力用も "Stream"
(define case4 ,()
  __OS_get_stdin__ ,(stdinStream)
  printType "stdin" stdinStream ,()
  __OS_get_stdout__ ,(stdoutStream)
  printType "stdout" stdoutStream ,()
  __OS_pipe__ ,(in out)
  printType "pipe input" in ,()
  printType "pipe output" out ,()
  __OS_open__ __print_exit_error__ "test.se" "r" ,(file)
  printType "file" file ,()
  __OS_close__ __print_exit_error__ file ,()
  printType "closed file" file ,()
  __MSeq_new__ ,(cmd)
  __MSeq_append__ __print_exit_error__ cmd "/usr/bin/true" ,()
  __Dict_new__ ,(env)
  __OS_spawn__ __print_exit_error__ cmd __NULL__ __NULL__ __NULL__ env ,(proc)
  printType "OSProc" proc ,()
  __OS_wait__ __print_exit_error__ proc ,(status)
  )

;; case5: 絶対パスと相対パス。相対パスは __OS_chdir__ の後は移動先が基準になる
(define case5 ,()
  printReal "/" ,()
  __OS_getcwd__ ,(cwd)
  printReal cwd ,()
  printReal "test.se" ,()
  printReal "." ,()
  __OS_chdir__ __print_exit_error__ "work" ,()
  printReal "." ,()
  printReal "sub" ,()
  printReal "../test.se" ,()
  __OS_chdir__ __print_exit_error__ ".." ,()
  printReal "work" ,()
  )

;; case6: ".."、"." とシンボリックリンクを含むパスを正規化する
(define case6 ,()
  printReal "work/sub/../sub/./" ,()
  printReal "work/sub/../../test.se" ,()
  printReal "work/up" ,()
  printReal "work/up/test.se" ,()
  printReal "work/up/work/up/work/sub" ,()
  __OS_getcwd__ ,(cwd)
  __String_concat__ cwd "/work/up/work/../test.se" ,(abs)
  printReal abs ,()
  )

;; case7: 存在しないパス、ファイルの下のパス、空のパス、String 以外の引数は onError
(define case7 ,()
  printReal "none" ,()
  printReal "work/none/.." ,()
  printReal "test.se/x" ,()
  printReal "" ,()
  __Number_fromString__ __print_exit_error__ "1" ,(one)
  printReal one ,()
  printReal "test.se" ,()
  )
