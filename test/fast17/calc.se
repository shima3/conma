;; 言語キットだけで作った小さな電卓の言語 calc の変換器（docs/dev/PLATFORM-PLAN-ja.md の 4.3 節、段階 P4。test/fast17）。
;; キットの部品（include/lang の lex.se、parse.se、code.se）が、SJS の名前を使わずに言語を作れることを確かめる。
;;   文：let 名前 = 式;  と  print 式;   式：数、文字列（print だけ）、名前、( 式 )、- 式、+ - * /（* と / が強い）
;;   コメントは // から行の終わりまで
;; main の引数のファイルを読み、ConMa のソースを標準出力に出す。作ったソースは calc_rt.se を include する。
;; 知らない名前などのエラーは、「行:桁: メッセージ」を Kit_lex_error で出して、終了ステータス 2 で終える
(include "util.se")
(include "lang/lex.se")
(include "lang/parse.se")
(include "lang/code.se")

(define main ,(args)
  __Seq_get__ (,() __print_exit_error__ "usage: calc.se <file.calc>\n") args ,(path rest)
  __OS_open__ (,(msg) __String_concat__ msg "\n" ,(m) __print_exit_error__ m) path "r" ,(stream)
  __LazyList_lines__ stream ,(lines)
  Calc_join lines "" ,(text)
  __OS_close__ __print_exit_error__ stream ,()
  Calc_translate text path ,(source)
  __OS_print__ source)

(define Calc_join ,(lines acc)
  __Cont_get__ ,(return)
  __LazyList_uncons__ (,() return acc) lines ,(line rest)
  __String_concat__ acc line ,(acc)
  Calc_join rest acc)

(define Calc_num ,(text)
  __Number_fromString__ __print_exit_error__ text)

;; 「行:桁: msg」のエラー
(define Calc_error ,(line col msg)
  Kit_code_cat5 line ":" col ": " msg ,(m)
  Kit_lex_error m)

(define Calc_error_at ,(node msg)
  Kit_parse_get node "line" ,(line)
  Kit_parse_get node "col" ,(col)
  Calc_error line col msg)

;; ── 字句 ──

(define Calc_lex ,(text)
  Kit_lex_start text ,(chars)
  Calc_num "1" ,(one)
  Calc_lex_loop chars __NULL__ __FALSE__ one)

(define Calc_lex_loop ,(chars acc nl line)
  __Cont_get__ ,(return)
  __is_null__ chars ,(test__) __if__ test__
    (,()
      Kit_lex_tok "eof" "" __TRUE__ line "1" ,(eof)
      __LList_cons__ eof acc ,(acc)
      Kit_lex_reverse acc ,(toks)
      return toks) ,()
  __LList_uncons__ __print_exit_error__ chars ,(c rest)
  Kit_lex_peek rest ,(d)
  __NULL__ (,(kind text rest)
    Kit_lex_col chars line ,(col)
    Kit_lex_tok kind text nl line col ,(tok)
    __LList_cons__ tok acc ,(acc)
    Calc_lex_loop rest acc __FALSE__ line ,(t)
    return t) ,(emit)
  Calc_num "1" ,(one)
  __String_equal__ c "\n" ,(test__) __if__ test__ (,() __Number_add__ line one ,(l) Calc_lex_loop rest acc __TRUE__ l ,(t) return t) ,()
  Kit_lex_in c " \t\r" ,(test__) __if__ test__ (,() Calc_lex_loop rest acc nl line ,(t) return t) ,()
  __String_equal__ c "/" ,(slash)
  __String_equal__ d "/" ,(slash2)
  __and__ slash slash2 ,(test__) __if__ test__ (,() Kit_lex_skip_line rest ,(rest) Calc_lex_loop rest acc nl line ,(t) return t) ,()
  Kit_lex_is_digit c ,(test__) __if__ test__ (,() Kit_lex_number chars "" "" ,(text rest) emit "num" text rest) ,()
  __String_equal__ c "\"" ,(test__) __if__ test__ (,() Kit_lex_string rest c "" ,(text rest) emit "str" text rest) ,()
  Kit_lex_is_ident_start c "" ,(test__) __if__ test__ (,() Kit_lex_ident chars "" "" ,(text rest) emit "id" text rest) ,()
  Kit_lex_punct chars "+-*/()=;" "" ,(text rest)
  __is_null__ text ,(test__) __if__ test__
    (,()
      Kit_lex_col chars line ,(col)
      __Number_toString__ line ,(ls)
      __String_concat__ "unexpected character: " c ,(m)
      Calc_error ls col m) ,()
  emit "punct" text rest)

;; ── 構文 ──

;; 文の LList（順に）
(define Calc_program ,(p acc)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  __String_equal__ kind "eof" ,(test__) __if__ test__ (,() Kit_lex_reverse acc ,(l) return l) ,()
  Calc_statement p ,(s)
  __LList_cons__ s acc ,(acc)
  Calc_program p acc)

(define Calc_statement ,(p)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_parse_eat p "let" ,(isLet)
  __if__ isLet
    (,()
      Kit_parse_next p ,(nameTok)
      Kit_lex_tok_kind nameTok ,(kind)
      __String_equal__ kind "id" ,(ok)
      __unless__ ok (,() Kit_parse_describe nameTok ,(d) __String_concat__ "expected a name but found " d ,(m) Kit_lex_tok_line nameTok ,(l) Kit_lex_tok_col nameTok ,(c) Calc_error l c m) ,()
      Kit_lex_tok_text nameTok ,(name)
      Kit_parse_expect p "=" ,()
      Calc_expr p ,(e)
      Kit_parse_expect p ";" ,()
      Kit_parse_node "let" ,(n)
      __Dict_put__ n "name" name ,()
      __Dict_put__ n "expr" e ,()
      Kit_parse_at n tok ,()
      return n) ,()
  Kit_parse_eat p "print" ,(isPrint)
  __unless__ isPrint (,() Kit_parse_fail p) ,()
  Calc_expr p ,(e)
  Kit_parse_expect p ";" ,()
  Kit_parse_node "print" ,(n)
  __Dict_put__ n "expr" e ,()
  Kit_parse_at n tok ,()
  __NULL__ n)

(define Calc_expr ,(p)
  Calc_num "0" ,(zero)
  Kit_parse_binary p zero Calc_operand Calc_prec)

(define Calc_prec ,(op)
  __Cont_get__ ,(return)
  Kit_lex_in_words op "+ -" ,(test__) __if__ test__ (,() Calc_num "1" ,(n) return n) ,()
  Kit_lex_in_words op "* /" ,(test__) __if__ test__ (,() Calc_num "2" ,(n) return n) ,()
  __NULL__ __NULL__)

(define Calc_operand ,(p)
  __Cont_get__ ,(return)
  Kit_parse_peek p ,(tok)
  Kit_lex_tok_kind tok ,(kind)
  Kit_lex_tok_text tok ,(text)
  __NULL__ (,(t key)
    Kit_parse_next p ,(x)
    Kit_parse_node t ,(n)
    __Dict_put__ n key text ,()
    Kit_parse_at n tok ,()
    return n) ,(leaf)
  __String_equal__ kind "num" ,(test__) __if__ test__ (,() leaf "num" "text") ,()
  __String_equal__ kind "str" ,(test__) __if__ test__ (,() leaf "str" "value") ,()
  __String_equal__ kind "id" ,(test__) __if__ test__ (,() leaf "id" "name") ,()
  Kit_parse_eat p "(" ,(test__) __if__ test__ (,() Calc_expr p ,(e) Kit_parse_expect p ")" ,() return e) ,()
  Kit_parse_eat p "-" ,(test__) __if__ test__
    (,() Calc_operand p ,(a) Kit_parse_node "neg" ,(n) __Dict_put__ n "arg" a ,() Kit_parse_at n tok ,() return n) ,()
  Kit_parse_fail p)

;; ── ConMa のソースを作る ──

(define Calc_translate ,(text path)
  Calc_lex text ,(toks)
  Kit_parse_new toks ,(p)
  Calc_program p __NULL__ ,(stmts)
  Kit_code_state path "calc" ,(g)
  __Dict_new__ ,(top)
  __LList_cons__ top __NULL__ ,(scope)
  Calc_stmts g scope stmts "" ,(code)
  Kit_code_replace_marks code "" ,(code)
  __String_join_lines__
    ";; calc を変換したもの（test/fast17/calc.se）"
    "(include \"calc_rt.se\")"
    "(define main ,()" ,(head)
  Kit_code_cat5 head "\n  " code "__nop__)" "\n")

(define Calc_stmts ,(g scope stmts acc)
  __Cont_get__ ,(return)
  __is_null__ stmts ,(test__) __if__ test__ (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ stmts ,(s rest)
  Calc_stmt g scope s ,(code)
  __String_concat__ acc code ,(acc)
  Calc_stmts g scope rest acc)

(define Calc_stmt ,(g scope s)
  __Cont_get__ ,(return)
  Kit_parse_get s "t" ,(t)
  Kit_parse_get s "expr" ,(e)
  Calc_value g scope e ,(code v)
  __String_equal__ t "print" ,(test__) __if__ test__
    (,() Kit_code_cat4 code "Calc_print " v " ,() " ,(c) return c) ,()
  ;; let：新しい ConMa の変数に束縛し、名前を置く（同じ名前の let は、後のものが前を隠す）
  Kit_parse_get s "name" ,(name)
  Kit_code_temp g "v" ,(t1)
  Kit_code_cat3 t1 "_" name ,(var)
  __LList_uncons__ __print_exit_error__ scope ,(dict rest)
  Kit_code_cat5 code "__NULL__ " v " ,(" var ,(c)
  __String_concat__ c ") " ,(c)
  __Dict_put__ dict name var ,()
  __NULL__ c)

;; 式の値を求める手順と、その値を表す被演算子
(define Calc_value ,(g scope e)
  __Cont_get__ ,(return)
  Kit_parse_get e "t" ,(t)
  __String_equal__ t "num" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "text" ,(text)
      Kit_code_quote text ,(q)
      Kit_code_temp g "n" ,(v)
      Kit_code_cat5 "__Number_fromString__ __print_exit_error__ " q " ,(" v ") " ,(c)
      return c v) ,()
  __String_equal__ t "str" ,(test__) __if__ test__
    (,() Kit_parse_get e "value" ,(s) Kit_code_quote s ,(q) return "" q) ,()
  __String_equal__ t "id" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "name" ,(name)
      Kit_code_lookup scope name ,(var c)
      __is_null__ var ,(test__) __if__ test__ (,() __String_concat__ "unknown name: " name ,(m) Calc_error_at e m) ,()
      return "" var) ,()
  __String_equal__ t "neg" ,(test__) __if__ test__
    (,()
      Kit_parse_get e "arg" ,(a)
      Calc_value g scope a ,(code v)
      Kit_code_temp g "n" ,(r)
      Kit_code_cat5 code "Calc_neg " v " ,(" r ,(c)
      __String_concat__ c ") " ,(c)
      return c r) ,()
  ;; binary：/ は 0 で割るエラーの位置を出すので、印（\t）を置き、演算子の位置の SInfo を入れる
  Kit_parse_get e "op" ,(op)
  Kit_parse_get e "left" ,(l)
  Kit_parse_get e "right" ,(rt)
  Calc_value g scope l ,(lc lv)
  Calc_value g scope rt ,(rc rv)
  __String_concat__ lc rc ,(code)
  __NULL__ (,(prim)
    Kit_code_temp g "n" ,(r)
    Kit_code_cat5 code prim " " lv " " ,(c)
    Kit_code_cat5 c rv " ,(" r ") " ,(c)
    return c r) ,(apply)
  __String_equal__ op "+" ,(test__) __if__ test__ (,() apply "__Number_add__") ,()
  __String_equal__ op "-" ,(test__) __if__ test__ (,() apply "__Number_subtract__") ,()
  __String_equal__ op "*" ,(test__) __if__ test__ (,() apply "__Number_multiply__") ,()
  Kit_code_temp g "n" ,(r)
  Kit_code_cat5 "\tCalc_div " lv " " rv " ,(" ,(c)
  Kit_code_cat3 c r ") " ,(c)
  Kit_code_sinfo_fill g e c ,(c)
  __String_concat__ code c ,(c)
  __NULL__ c r)
