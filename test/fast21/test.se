;; __JS_fn_call__ と __JS_fn_resume__ の続き（docs/dev/CONJS-HOST-PLAN.md の段階 H2b。vm/src/prim/jsfn.rs）：ホストの JavaScript の
;; ジェネレータが yield で VM に戻り、VM が __JS_fn_resume__ で続ける。その間に VM が変えた Dict を、ホストは続けた後に見る。
;; 呼び返し（rt.callVm）に渡したオブジェクトは、呼び返しの中でも同じ Dict。wasm 版の VM だけ。ほかの VM は onError（case1.log）。
(define println ,(str)
  __String_concat__ str "\n" ,(line)
  __OS_print__ line)

(define num ,(text)
  __Number_fromString__ (,(e) println e) text)

;; 値の文字列：Number、"String"、(要素 ...)、() は空の LList（null）、{key 値 ...} は Dict、true と false は真偽
(define text_of ,(v)
  __Cont_get__ ,(return)
  __is_null__ v ,(isNull)
  __if__ isNull (,() return "()") ,()
  __type_name__ v ,(t)
  __String_equal__ t "Number" ,(isNum)
  __if__ isNum (,() __Number_toString__ v ,(s) return s) ,()
  __String_equal__ t "String" ,(isStr)
  __if__ isStr (,() __String_concat__ "\"" v ,(s) __String_concat__ s "\"" ,(s) return s) ,()
  __String_equal__ t "LList" ,(isList)
  __if__ isList (,() items_text v "(" ,(s) return s) ,()
  __String_equal__ t "Dict" ,(isDict)
  __if__ isDict (,() dict_text v ,(s) return s) ,()
  __String_equal__ t "Closure" ,(isClosure)
  __if__ isClosure (,() __if_then_else__ v (,() __NULL__ "true") (,() __NULL__ "false") ,(b) return b) ,()
  return t)

;; Dict の文字列：{key 値 ...}（キーは入れた順。どの VM も、その順に並べる）
(define dict_text ,(d)
  __Cont_get__ ,(return)
  __Dict_keys__ d ,(keys)
  __Ref_new__ __NULL__ ,(acc)
  __Ref_new__ __NULL__ ,(self)
  __Ref_set__ self (,(k) __Ref_get__ acc ,(l) __LList_cons__ k l ,(l) __Ref_set__ acc l ,() __Ref_get__ self) ,()
  __Ref_get__ self ,(sink)
  keys sink ,(x)
  __Ref_get__ acc ,(rev)
  entries_text d rev "}" ,(s)
  __String_concat__ "{" s)

(define entries_text ,(d rev acc)
  __Cont_get__ ,(return)
  __is_null__ rev ,(end) __if__ end (,() return acc) ,()
  __LList_uncons__ (,(e) println e) rev ,(k rest)
  __Dict_lookup_or__ d k (,(k) println "no key") ,(v)
  text_of v ,(s)
  __String_concat__ k " " ,(e) __String_concat__ e s ,(e)
  __is_null__ rest ,(first)
  __String_equal__ acc "}" ,(last)
  __if_then_else__ last (,() __NULL__ "") (,() __NULL__ " ") ,(sep)
  __String_concat__ sep acc ,(acc)
  __String_concat__ e acc ,(acc)
  entries_text d rest acc)

(define items_text ,(v acc)
  __LList_uncons__ (,(e) println e) v ,(h rest)
  text_of h ,(s)
  __String_concat__ acc s ,(acc)
  __is_null__ rest ,(end)
  __if_then_else__ end
    (,() __String_concat__ acc ")")
    (,() __String_concat__ acc " " ,(acc) items_text rest acc))

(define js_text ,()
  __NULL__ "return {" ,(t)
  __String_concat__ t "*sum(n) { let t = 0; for (let i = 0; i < n; i++) t += yield i; return t }," ,(t)
  __String_concat__ t "*watch(d) { d.a = 1; const inner = d.inner; const got = yield 'first'; return [d.a, d.b, got, inner === d.inner, inner.k] }," ,(t)
  __String_concat__ t "*catcher() { try { yield 'wait' } catch (e) { return `caught ${e}` } }," ,(t)
  __String_concat__ t "*made() { const o = { n: 1 }; yield o; return o.n }," ,(t)
  __String_concat__ t "withCb(h, d) { d.x = 1; const r = rt.callVm(h, d); return [r, d.y, d.z === d] }," ,(t)
  __String_concat__ t "}")

;; 呼び返される：d.x を読み、d.y に d.x + 1 を、d.z に d 自身を入れる
(define cbset ,(d)
  __Dict_lookup_or__ d "x" (,(k) num "0") ,(x)
  num "1" ,(one) __Number_add__ x one ,(y)
  __Dict_put__ d "y" y ,()
  __Dict_put__ d "z" d ,()
  __NULL__ x)

(define say ,(label status v)
  text_of v ,(s)
  __String_concat__ label ": " ,(m) __String_concat__ m status ,(m) __String_concat__ m " " ,(m) __String_concat__ m s ,(m)
  println m)

(define fail ,(e) println e)

;; sum：yield ごとに、出した値の 10 倍で続ける
(define drive ,(M status v)
  __Cont_get__ ,(return)
  say "sum" status v ,()
  __String_equal__ status "yield" ,(y) __unless__ y (,() return) ,()
  __LList_uncons__ fail v ,(g rest) __LList_uncons__ fail rest ,(req rest)
  num "10" ,(ten) __Number_multiply__ req ten ,(reply)
  __JS_fn_resume__ fail g "next" reply ,(status v)
  drive M status v)

(define case1 ,()
  __Cont_get__ ,(return)
  js_text ,(text)
  __JS_fn_compile__ (,(e) println e ,() return) text ,(M)
  num "3" ,(n3) __LList_cons__ n3 __NULL__ ,(a)
  __JS_fn_call__ fail M "sum" a ,(status v)
  drive M status v ,()
  ;; watch：yield の間に、VM が d を変える
  __Dict_new__ ,(d) __Dict_new__ ,(inner) __Dict_put__ inner "k" "kept" ,() __Dict_put__ d "inner" inner ,()
  __LList_cons__ d __NULL__ ,(a)
  __JS_fn_call__ fail M "watch" a ,(status v)
  say "watch" status v ,()
  show "d at the yield: " d ,()
  num "5" ,(n5) num "2" ,(n2) __Dict_put__ d "a" n5 ,() __Dict_put__ d "b" n2 ,() __Dict_put__ inner "k" "changed" ,()
  __LList_uncons__ fail v ,(g rest)
  __JS_fn_resume__ fail g "next" "reply" ,(status v)
  say "watch" status v ,()
  ;; catcher：yield に例外を投げる
  __JS_fn_call__ fail M "catcher" __NULL__ ,(status v)
  say "catcher" status v ,()
  __LList_uncons__ fail v ,(g rest)
  __JS_fn_resume__ fail g "throw" "boom" ,(status v)
  say "catcher" status v ,()
  ;; made：yield で出したオブジェクトを VM が変える
  __JS_fn_call__ fail M "made" __NULL__ ,(status v)
  __LList_uncons__ fail v ,(g rest) __LList_uncons__ fail rest ,(o rest)
  show "made at the yield: " o ,()
  num "7" ,(n7) __Dict_put__ o "n" n7 ,()
  __JS_fn_resume__ fail g "next" __NULL__ ,(status v)
  say "made" status v ,()
  ;; 終わったジェネレータは、もう続けられない
  __JS_fn_resume__ (,(e) println e ,() return) g "next" __NULL__ ,(status v)
  println "not reached")

(define show ,(label v)
  text_of v ,(s) __String_concat__ label s ,(s) println s)

;; 呼び返しに渡した d は、呼び返しの中でも同じ Dict
(define case2 ,()
  __Cont_get__ ,(return)
  js_text ,(text)
  __JS_fn_compile__ (,(e) println e ,() return) text ,(M)
  __Dict_new__ ,(d)
  __LList_cons__ d __NULL__ ,(a) __LList_cons__ cbset a ,(a)
  __JS_fn_call__ fail M "withCb" a ,(status v)
  say "withCb" status v ,()
  __Dict_lookup_or__ d "x" (,(k) __NULL__ "none") ,(x) show "d.x: " x ,()
  __Dict_lookup_or__ d "y" (,(k) __NULL__ "none") ,(y) show "d.y: " y ,()
  __Dict_lookup_or__ d "z" (,(k) __NULL__ "none") ,(z) __type_name__ z ,(t) show "d.z: " t ,()
  __NULL__)
