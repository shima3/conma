;; Step36: __Dict_copy__、__LList_append__、__LList_length__、__String_find_any__、__String_strip_suffix__ の組み込み
;; test.sh は、組み込みを使う test.se と、ConMa 版（data.se）を使う conma.se の両方で
;; 各 case を実行し、同じログになることを確かめる
(include "util.se")

(define print ,(s)
  __OS_print__ s ,()
  __OS_print__ "\n")

(define print_number ,(label n)
  __Number_toString__ n ,(s)
  __String_concat__ label s ,(s)
  print s)

;; 位置（null なら "null"）を出力する
(define print_pos ,(label pos)
  __if_then_else__ (,() __is_null__ pos)
    (,() __String_concat__ label "null" ,(s) print s)
    (,() print_number label pos))

;; Dict のキーと値を "k=v" の並びで出力する。キーの Seq に、文字列を伸ばす Sink を渡す
(define print_dict ,(label d)
  __Dict_keys__ d ,(keys)
  __Ref_new__ label ,(text)
  dict_sink d text ,(sink)
  keys sink ,(sink)
  __Ref_get__ text ,(s)
  print s)

(define dict_sink ,(d text)
  __NULL__ (,(k)
    __Dict_lookup_or__ d k __print_exit_error__ ,(v)
    __Ref_get__ text ,(acc)
    __String_concat__ acc " " ,(acc)
    __String_concat__ acc k ,(acc)
    __String_concat__ acc "=" ,(acc)
    __String_concat__ acc v ,(acc)
    __Ref_set__ text acc ,()
    dict_sink d text))

;; String の LList を "(a b c)" の形で出力する
(define print_list ,(label list)
  list_text list "" ,(s)
  __String_concat__ label "(" ,(t)
  __String_concat__ t s ,(t)
  __String_concat__ t ")" ,(t)
  print t)

(define list_text ,(list acc)
  __Cont_get__ ,(return)
  __if__ (,() __is_null__ list) (,() return acc) ,()
  __LList_uncons__ __print_exit_error__ list ,(head rest)
  __if_then_else__ (,() __String_equal__ acc "")
    (,() __NULL__ head)
    (,() __String_concat__ acc " " ,(s) __String_concat__ s head) ,(acc)
  list_text rest acc)

;; case1: __Dict_copy__ は同じ順のキーと値を持つ別の Dict を作る。片方を変えても、もう片方は変わらない
(define case1 ,()
  __Dict_new__ ,(a)
  __Dict_put__ a "x" "1" ,()
  __Dict_put__ a "y" "2" ,()
  __Dict_put__ a "z" "3" ,()
  __Dict_copy__ a ,(b)
  __Dict_put__ b "w" "4" ,()
  __Dict_put__ a "x" "10" ,()
  __Dict_remove__ a "y" ,()
  print_dict "a:" a ,()
  print_dict "b:" b ,()
  __Dict_lookup_or__ b "y" (,(k) __NULL__ "missing") ,(v)
  __String_concat__ "b y: " v ,(s)
  print s ,()
  __Dict_new__ ,(e)
  __Dict_copy__ e ,(f)
  __Dict_put__ f "k" "v" ,()
  print_dict "e:" e ,()
  print_dict "f:" f)

;; case2: __LList_append__ と __LList_length__
(define case2 ,()
  __LList_cons__ "c" __NULL__ ,(c)
  __LList_cons__ "b" c ,(bc)
  __LList_cons__ "a" bc ,(abc)
  __LList_cons__ "d" __NULL__ ,(d)
  __LList_append__ abc d ,(abcd)
  print_list "abc+d: " abcd ,()
  __LList_append__ __NULL__ d ,(l)
  print_list "()+d: " l ,()
  __LList_append__ abc __NULL__ ,(l)
  print_list "abc+(): " l ,()
  __LList_append__ __NULL__ __NULL__ ,(l)
  print_list "()+(): " l ,()
  print_list "abc: " abc ,()
  __LList_length__ abcd ,(n)
  print_number "length abcd: " n ,()
  __LList_length__ __NULL__ ,(n)
  print_number "length (): " n)

;; case3: __String_find_any__
(define case3 ,()
  __Number_fromString__ __print_exit_error__ "0" ,(zero)
  __Number_fromString__ __print_exit_error__ "2" ,(two)
  __Number_fromString__ __print_exit_error__ "5" ,(five)
  __String_find_any__ __print_exit_error__ "a*b?c[" "?*[" zero ,(p)
  print_pos "from 0: " p ,()
  __String_find_any__ __print_exit_error__ "a*b?c[" "?*[" two ,(p)
  print_pos "from 2: " p ,()
  __String_find_any__ __print_exit_error__ "a*b?c[" "[" zero ,(p)
  print_pos "[: " p ,()
  __String_find_any__ __print_exit_error__ "abc" "?*[" zero ,(p)
  print_pos "none: " p ,()
  __String_find_any__ __print_exit_error__ "abc" "" zero ,(p)
  print_pos "no chars: " p ,()
  __String_find_any__ __print_exit_error__ "a*b?c" "*?" five ,(p)
  print_pos "at the end: " p ,()
  __String_find_any__ __print_exit_error__ "" "*" zero ,(p)
  print_pos "empty: " p ,()
  __String_find_any__ __print_exit_error__ "日本*語" "*" zero ,(p)
  print_pos "after non-ASCII: " p)

;; case4: __String_strip_suffix__
(define case4 ,()
  __String_strip_suffix__ "line\n" "\n" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "line" "\n" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "line\r\n" "\n" ,(s)
  __String_strip_suffix__ s "\r" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "abc" "" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "c" "abc" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "abc" "abc" ,(s)
  __String_concat__ s "|" ,(s)
  print s ,()
  __String_strip_suffix__ "" "" ,(s)
  __String_concat__ s "|" ,(s)
  print s)
